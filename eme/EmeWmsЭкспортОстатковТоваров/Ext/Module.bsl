// Возвращает код основной единицы измерения
Функция ПолучитьКодОсновнойЕдиницы(СтрокаТаблицыЗначений)

	Если СтрокаТаблицыЗначений.НоменклатураЕдиницаИзмеренияКод <> "" Тогда
		возврат СтрокаТаблицыЗначений.НоменклатураЕдиницаИзмеренияКод;
	Иначе
		МеждународноеСокращение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТаблицыЗначений.НоменклатураЕдиницаИзмерения,
		 																								"МеждународноеСокращение");
		Если МеждународноеСокращение="шт" Тогда
			возврат "796";
		ИначеЕсли МеждународноеСокращение="кг" Тогда
			возврат "166";
		ИначеЕсли МеждународноеСокращение="г" Тогда
			возврат "163";
		ИначеЕсли МеждународноеСокращение="паллет" Тогда
			возврат "001";
		ИначеЕсли МеждународноеСокращение="упак" Тогда
			возврат "778";
		ИначеЕсли МеждународноеСокращение="м" Тогда
			возврат "006";
		ИначеЕсли МеждународноеСокращение="л" Тогда
			возврат "112";
		ИначеЕсли МеждународноеСокращение="набор" Тогда
			возврат "704";
		ИначеЕсли МеждународноеСокращение="пог.м" Тогда
			возврат "018";
		ИначеЕсли МеждународноеСокращение="компл" Тогда
			возврат "839";
		Иначе
			возврат "796";
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

// Возвращает тип документа по EME по ссылке
Функция ПолучитьТипДокументаПоEME(ТипЗнчДокумента, КоличествоПрихода)  
	
	Если ТипЗнчДокумента = Тип("ДокументСсылка.ПриходныйОрдерНаТовары") Тогда
		Возврат "Оприходование";
	КонецЕсли;                  

	Если ТипЗнчДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Возврат "Автоматическое списание по уходу";
	КонецЕсли;
	                                               
	Если ТипЗнчДокумента = Тип("ДокументСсылка.СписаниеТоваров") Тогда
		Возврат "Списание";
	КонецЕсли;                  
	
	Если ТипЗнчДокумента = Тип("ДокументСсылка.ОприходованиеТоваров") Тогда
		Возврат "Оприходование";
	КонецЕсли;                  

	Если ТипЗнчДокумента = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		Если КоличествоПрихода > 0.0 Тогда
			Возврат "Приход";
		Иначе
			Возврат "Списание";
		КонецЕсли;
	КонецЕсли;                  

	Если ТипЗнчДокумента = Тип("ДокументСсылка.ИнвентаризацияТоваровНаСкладе") Тогда
		Если КоличествоПрихода > 0.0 Тогда
			Возврат "Инвентаризация - оприходование";
		Иначе
			Возврат "Инвентаризация - списание";
		КонецЕсли;
	КонецЕсли;                  
	
	Возврат неопределено;                                     
КонецФункции

// Возвращает тип документа по сообщениям ASN и ORDERS
Функция ПолучитьТипДокументаПо1C(ДокументСсылка, ТипЗнчДокумента) 

	Если ТипЗнчДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Возврат Метаданные.Документы.РеализацияТоваровУслуг.Имя;
	КонецЕсли;

	Если ТипЗнчДокумента = Тип("ДокументСсылка.ОприходованиеТоваров") Тогда
		// Делается на основании пересчета
		Если ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ИнвентаризацияТоваровНаСкладе")) Тогда 
			Возврат Метаданные.Документы.ИнвентаризацияТоваровНаСкладе.Имя;
		Иначе
			Возврат Метаданные.Документы.ОприходованиеТоваров.Имя;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнчДокумента = Тип("ДокументСсылка.СписаниеТоваров") Тогда
		// Делается на основании пересчета
		Если ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ИнвентаризацияТоваровНаСкладе")) Тогда
			Возврат Метаданные.Документы.ИнвентаризацияТоваровНаСкладе.Имя;
		Иначе
			Возврат Метаданные.Документы.СписаниеТоваров.Имя;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнчДокумента = Тип("ДокументСсылка.ИнвентаризацияТоваровНаСкладе") Тогда
		Возврат Метаданные.Документы.ИнвентаризацияТоваровНаСкладе.Имя;
	КонецЕсли;
	
	Если ТипЗнчДокумента = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя") Тогда
		Возврат Метаданные.Документы.ВозвратТоваровОтПокупателя.Имя;
	КонецЕсли;
	
	Если ТипЗнчДокумента = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		Возврат Метаданные.Документы.ПеремещениеТоваров.Имя;
	КонецЕсли;                  
	
	Если ТипЗнчДокумента = Тип("ДокументСсылка.ПриходныйОрдерНаТовары") Тогда
		Возврат Метаданные.Документы.ПриходныйОрдерНаТовары.Имя;
	КонецЕсли;                  
	
	Возврат Неопределено;                                     
КонецФункции

// В ордерной схеме: выгружаются непосредственно приходные и расходные ордера на товары
Функция ПолучитьНомер1СДокумента(ДокументСсылка, ТипЗнчДокумента, ДокументНомер, ДокументДата)
	
	Возврат СокрЛП(ДокументНомер)+"/"+Формат(Год(ДокументДата),"ЧГ=4");
КонецФункции

// Возвращает номер EME по ссылке на документ не ордерная схема
Функция ПолучитьНомерEMEДокумента(ДокументСсылка, ТипЗнчДокумента)
	
	Если ТипЗнчДокумента = Тип("ДокументСсылка.ПриходныйОрдерНаТовары") Тогда
		Возврат НомерEMEДокументаПриходныйОрдерНаТовары(ДокументСсылка);
	КонецЕсли;
	
	Если ТипЗнчДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Возврат НомерEMEДокументаРеализацияТоваровУслуг(ДокументСсылка);
	КонецЕсли;
	
	Если ТипЗнчДокумента = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		Возврат НомерEMEДокументаПеремещениеТоваров(ДокументСсылка);
	КонецЕсли;                  
	
	Если ТипЗнчДокумента = Тип("ДокументСсылка.ОприходованиеТоваров") Тогда
		Возврат НомерEMEДокументаОприходованиеТоваров(ДокументСсылка);
	КонецЕсли;                  
	
	Если ТипЗнчДокумента = Тип("ДокументСсылка.СписаниеТоваров") Тогда
		Возврат НомерEMEДокументаСписаниеТоваров(ДокументСсылка);
	КонецЕсли;                  
	
	// При некоторых настройках проводки по складам создает сам документ пересчета
	Если ТипЗнчДокумента = Тип("ДокументСсылка.ИнвентаризацияТоваровНаСкладе") Тогда
		Возврат НомерEMEДокументаИнвентаризацияТоваров(ДокументСсылка);
	КонецЕсли;                  
	
	Возврат неопределено;
КонецФункции

// Возвращает номер EME по ссылке на документ
Функция НомерEMEДокументаПриходныйОрдерНаТовары(ДокументСсылка)
	Перем НаборЗаписей;
	
	НаборЗаписей = РегистрыСведений.EmeWmsОтметкиОбИмпортеПриходныхОрдеровНаТовары.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Ссылка.Установить(ДокументСсылка);
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл
		Возврат СокрЛП(Запись.ID);
	КонецЦикла;
	
	возврат Неопределено;  
КонецФункции

