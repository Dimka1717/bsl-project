// Создает в регистре отметку об импорте документа Оприходования излишков с ID прихода EME
Процедура СоздатьОтметкуОбИмпортеОприходованияИзлишковТоваров(Документ, ИдЕМЕ)
	НаборЗаписей = РегистрыСведений.EmeWmsОтметкиОбИмпортеОприходованийТоваров.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Ссылка.Установить(Документ.Ссылка);
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл
		Запись.ДатаИмпорта = ТекущаяДата();
		НаборЗаписей.Записать();
		Возврат;
	КонецЦикла;
	
  	НоваяЗапись = РегистрыСведений.EmeWmsОтметкиОбИмпортеОприходованийТоваров.СоздатьМенеджерЗаписи();
	НоваяЗапись.ID 			= ИдЕМЕ;
	НоваяЗапись.Ссылка 		= Документ.Ссылка;
	НоваяЗапись.ДатаИмпорта = ТекущаяДата();
    НоваяЗапись.Записать(); 
КонецПроцедуры

