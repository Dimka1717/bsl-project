// Модуль для УТ10.3 Импорт receipt без asn с ордерной схемой 

// 	$Приход товаров без ASN
//	Оператор EME.WMS (руч.) создает документ прихода без ASN
//	После закрытия документа прихода EME.WMS (авт.) экспортирует сообщение RECEIPT.
//	1C (авт.) импортирует сообщение RECEIPT и создает документ Оприходование излишков товаров.
//	В случае прихода как возврата от клиента, создается документ Возврат товаров от клиента.
//	В комментарии документов заносится информация о документе WMS, на основании которого документ создан.
// 	Если в маппинге определен склад брака для товара в статусе В, для такого товара создается документ перемещения на склад брака.
//	Документы проводится.

#Область ПрограммныйИнтерфейс  

// Импорт прихода без ASN (сообщение receipt) в документы 1С
Процедура Импортировать(ERPData, Трассировка, ТемаСообщения) Экспорт
	// Принимать только сообщение для закрытого документа.
	Если ERPData.header.doc_status <> "Обработка завершена" Тогда
		Возврат;
	КонецЕсли;  
	
	// Принимать только закрывающий receipt
	Если ERPData.header.is_partly = 1 Тогда 
		Возврат;
	КонецЕсли;  
	
	// Это приход без ASN
	Если ЗначениеЗаполнено(ERPData.header.asn_id) Тогда 
		Возврат;
	КонецЕсли;
	
	// Идентификатор документа WMS для регистров контроля
	ИдЕМЕ = ERPData.header.receipt_id;
	// Номер документа WMS для комментариев
	НомерЕМЕ = ERPData.header.receipt_reg_no;
	
	ЭтоВозврат = ?(ERPData.header.is_return = 1, Истина, Ложь);
	Если ЭтоВозврат Тогда
		КонтрагентСсылка = EmeWmsУтилиты.ПолучитьСсылкуНаКонтрагента(ERPData.header.supplier_id);
		Если КонтрагентСсылка.Пустая() Тогда
			EmeWmsERPEngine.ErrorHeader(ERPData, "CUSBAD");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	//	Соберем в карту количества товаров с сериями
	КодЗоны 		= Неопределено;
	КодЗоныБрака 	= Неопределено;
	КартаТоваров 	= Новый Соответствие;
	КартаБрака 		= Новый Соответствие;
	ПолучитьКоличестваТоваровСБраком(ERPData, КодЗоны, КодЗоныБрака, КартаТоваров, КартаБрака);
	
	// Получим склад по коду EME
	КодСклада 		= ERPData.header.whs_to_code;
	КодОрганизации 	= ERPData.header.vendor_to_code;
	СкладСсылка 	= EmeWmsУтилиты.ПолучитьСсылкуНаСкладПоКодуEME(КодСклада, КодЗоны, КодОрганизации, "N");
	Если СкладСсылка.Пустая() Тогда
		EmeWmsERPEngine.ErrorHeader(ERPData, "WTOBAD");
		Возврат;
	КонецЕсли;
	
	// Получим организацию по коду EME
	ОрганизацияСсылка = EmeWmsУтилиты.ПолучитьСсылкуНаОрганизациюПоКодуEME(КодОрганизации);
	Если ОрганизацияСсылка.Пустая() Тогда
		EmeWmsERPEngine.ErrorHeader(ERPData, "VNDBAD");
		Возврат;
	КонецЕсли;
	
	//	Если были ошибки
	Если EmeWmsERPEngine.HasErrors(ERPData) Тогда
		Возврат;
	КонецЕсли;
	
	//*** Проверки сделали, пишем в базу данных 1C ***
	
	// Если приход по возврату от клиента (по инициативе WMS)
	Если ЭтоВозврат Тогда
		// Создается правильно только на основании реализации, реализацию ищем по ID
		РеализацияСсылка = EmeWmsУтилиты.ПолучитьСсылкуНаРеализациюТоваровУслуг(ERPData.header.order_id);
		Если РеализацияСсылка.Пустая() Тогда
			EmeWmsERPEngine.WarningHeader(ERPData, "NOTPST", "В 1С Не создана Реализация, провести Возврат от клиента нельзя");
			Возврат;
		КонецЕсли;

		// Создадим документ Возврат товаров от клиента на основании Реализации товаров
		//ВозвратТоваровСсылка = СоздатьИзменитьДокументВозвратТоваровОтКлиента(КартаТоваров, РеализацияСсылка, СкладСсылка, ИдЕМЕ, НомерЕМЕ, ERPData);
		//СоздатьОтметкуОбИмпортеВозвратаТоваровОтКлиента(ВозвратТоваровСсылка, ИдЕМЕ);
	Иначе                              
		// На основании ордера созданим документ оприходования излишков товаров
		ОприходованиеСсылка = СоздатьИзменитьДокументОприходованияИзлишковТоваров(КартаТоваров, СкладСсылка, ОрганизацияСсылка, ИдЕМЕ, НомерЕМЕ, ERPData);
		
		// Если в маппинге определен склад брака для товара в статусе В, создадим перемещение на склад брака
		Если КартаБрака.Количество() > 0 Тогда
			СкладБрака = EmeWmsУтилиты.ПолучитьСсылкуНаСкладПоКодуEME(КодСклада, КодЗоны, КодОрганизации, "B");
			Если ЗначениеЗаполнено(СкладБрака) Тогда
				ПеремещениеСсылка = СоздатьИзменитьДокументПеремещенияНаСкладБрака(ERPData, ИдЕМЕ, НомерЕМЕ, ОприходованиеСсылка, КартаБрака, СкладБрака);
				Тема = "Создан документ перемещения на склад брака на основании прихода EME";
				Текст = "На основании " + ОприходованиеСсылка + Символы.ПС + " и документа прихода EME " + НомерЕМЕ + Символы.ПС + 
						" создан документ перемещения на склад брака " + ПеремещениеСсылка;
				EmeWmsУтилиты.ДобавитьНапоминаниеИнтеграции(Текст, ПеремещениеСсылка);
			КонецЕсли;
		КонецЕсли;
		
		Трассировка = Трассировка + ОприходованиеСсылка + Символы.ПС;
		ТемаСообщения = "Создан документ Приходный ордер на товары по приходу EME " + НомерЕМЕ;
	КонецЕсли;

	EmeWmsERPEngine.Success(ERPData);
КонецПроцедуры

// Функция ПолучитьИмяСообщения возвращает имя сообщения
Функция ПолучитьИмяСообщения() Экспорт
	Возврат "receipt";
КонецФункции

// Функция ПолучитьМетаданные возвращает метаданные сообщения
Функция ПолучитьМетаданные() Экспорт
	Возврат Метаданные.Документы.ОприходованиеТоваров;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция возвращает договор контрагента
Функция ПолучитьДоговорКонтрагента(Контрагент)
	Перем Запрос, Выборка, Результат;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "Выбрать
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка,
	|	ДоговорыКонтрагентов.Статус КАК Статус
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Контрагент = &Контрагент";
	Запрос.УстановитьПараметр("Контрагент", Контрагент.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	Если Выборка.Следующий() Тогда
		Если Выборка.Статус = Перечисления.СтатусыДоговоровКонтрагентов.Действует Тогда
			Результат = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Собирает в карту товаров (с сериями) принятые по Receipt товары
// В карте товаров - всё принятое, в карте брака - только брак
Процедура ПолучитьКоличестваТоваровСБраком(ERPData, КодЗоны, КодЗоныБрака, КартаТоваров, КартаБрака)
	
	//	Использование серий в интеграции
	ИспользоватьСерии = Константы.EmeWmsИспользоватьСерии.Получить();	

	//КлючиТоваров 		= Новый Соответствие;
	СерийныеНомера 		= Новый Соответствие;
	
	// Заполнить карту серийных номеров товара (строка номеров по номеру строки)
	EmeWmsERPEngine.SelectChild(ERPData, "numbers");
	Пока EmeWmsERPEngine.NextChildLine(ERPData) Цикл   
		
		// Номер серии: WMS "-" = 1С "Неизвестная серия"	
		СерийныйНомер = ?(ERPData.numbers.serial_no <> "-", ERPData.numbers.serial_no, "Неизвестная серия");																

		КлючСтроки = ERPData.numbers.receipt_line_id;
		СтрокаНомеров = СерийныеНомера.Получить(КлючСтроки);
		СерийныеНомера.Вставить(КлючСтроки, ?(СтрокаНомеров = неопределено, СерийныйНомер, СтрокаНомеров + "," + СерийныйНомер));
	КонецЦикла;	

	// Весь товар в сообщении
	EmeWmsERPEngine.SelectChild(ERPData, "lines");
	Пока EmeWmsERPEngine.NextChildLine(ERPData) Цикл
		//	Проверим товар
		УИДТовара = ERPData.lines.goods_id;
		УИДЕдиницы = ERPData.lines.pack_id;
		Если УИДТовара = "" Тогда
			EmeWmsERPEngine.ErrorChild(ERPData, "GDSNUL");
			Продолжить
		КонецЕсли;
		
		ТоварСсылка = EmeWmsУтилиты.ПолучитьСсылкуНаТовар(УИДТовара);
		Если ТоварСсылка.Пустая() Тогда
			EmeWmsERPEngine.ErrorChild(ERPData, "GDSBAD");
			Продолжить
		КонецЕсли;
		
		ЕдиницаИзмерения = EmeWmsУтилиты.ПолучитьСсылкуНаЕдиницуИзмерения(УИДЕдиницы);
		Если ЕдиницаИзмерения.Пустая() Тогда
			EmeWmsERPEngine.ErrorChild(ERPData, "PCKBAD");
			Продолжить
		КонецЕсли;
		
		РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТоварСсылка, "ВестиУчетПоСериям, ВестиУчетПоХарактеристикам"); 

		Если Не ИспользоватьСерии Тогда
			РеквизитыНоменклатуры.ВестиУчетПоСериям = Ложь;
		КонецЕсли;

		СерияНоменклатуры 		   	= Неопределено;
		ХарактеристикаНоменклатуры 	= Неопределено;
		
		Если РеквизитыНоменклатуры.ВестиУчетПоСериям Тогда   
			СерийныйНомер 	 = ERPData.lines.lot_no;
			ДатаГодности  	 = ERPData.lines.bbd;
			ДатаПроизводства = ERPData.lines.prd; 
			
			// Серии, если их нет при приходе без ASN - создавать.
			СерияНоменклатуры = EmeWmsУтилиты.ПолучитьСериюПоНаименованию(ERPData.lines.lot_no, ТоварСсылка, Истина);
		ИначеЕсли РеквизитыНоменклатуры.ВестиУчетПоХарактеристикам Тогда
			ХарактеристикаНоменклатуры = EmeWmsУтилиты.ПолучитьХарактеристикуПоНаименованию(ERPData.lines.lot_no, ТоварСсылка);
		КонецЕсли;
				
		КодЗоны 			= ERPData.lines.zone_to_code;
		КлючТовара 			= EmeWmsУтилиты.СоздатьКлючТовара(ТоварСсылка, СерияНоменклатуры, ХарактеристикаНоменклатуры);
		КоличествоВБазовой  = EmeWmsУтилиты.ПересчетВДругуюЕдиницу(ERPData.lines.receipt_qty, 
																   ЕдиницаИзмерения, 
																   EmeWmsУтилиты.ПолучитьБазовуюЕдиницуИзмерения(ТоварСсылка));
		
		КоличествоПоКарте 	= ?(КартаТоваров.Получить(КлючТовара) = Неопределено, 0.0, КартаТоваров.Получить(КлючТовара));		
		КартаТоваров.Вставить(КлючТовара, КоличествоПоКарте + КоличествоВБазовой);                                      
		
		// Добавим количество в карту брака
		Если EmeWmsСтатусы.ИспользоватьКакСтатус(ERPData.lines.stock_status) = "B" Тогда 
			КодЗоныБрака = ERPData.lines.zone_to_code;
			КоличествоПоКарте = ?(КартаБрака.Получить(КлючТовара) = Неопределено, 0.0, КартаБрака.Получить(КлючТовара));
			КартаБрака.Вставить(КлючТовара, КоличествоПоКарте + КоличествоВБазовой);
		КонецЕсли; 
		
		// Это для привязки серийных номеров к товару
		//КлючиТоваров.Вставить(ERPData.lines.id, ТоварСсылка); 		
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(КодЗоныБрака) ИЛИ КодЗоны = КодЗоныБрака Тогда
		КодЗоныБрака = "BRAK"; // По умолчанию, если в строках не заполнено
	КонецЕсли;
КонецПроцедуры

// Функция возвращает соглашение для контрагента
Функция ПолучитьСоглашениеКонтрагента(Контрагент)
	Перем Запрос, Выборка, Результат;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "Выбрать
	|	Соглашения.Ссылка КАК Ссылка,
	|	Соглашения.Статус КАК Статус
	|ИЗ
	|	Справочник.СоглашенияСКлиентами КАК Соглашения
	|ГДЕ
	|	Соглашения.Контрагент = &Контрагент";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Справочники.СоглашенияСКлиентами.ПустаяСсылка();
	Если Выборка.Следующий() Тогда
		Если Выборка.Статус = Перечисления.СтатусыСоглашенийСКлиентами.Действует Тогда
			Результат = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ПоискСсылокНаОбъектыПоКодуEME

// Функция возвращает ссылку на документ Оприходования излишков товаров по ИД EME
Функция НайтиДокументОприходованияИзлишковТоваров(ИдЕМЕ)
	
	Запрос = Новый Запрос();
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Оприходование.Ссылка КАК Ссылка
		|ИЗ
		|	РегистрСведений.EmeWmsОтметкиОбИмпортеОприходованийТоваров КАК Оприходование
		|ГДЕ
		|	Оприходование.ID = &ИдЕМЕ";
	
	Запрос.УстановитьПараметр("ИдЕМЕ", ИдЕМЕ);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();

		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.ОприходованиеТоваров.ПустаяСсылка();

КонецФункции

// Функция возвращает ссылку на Возврат товаров от клиента по ИД EME
Функция НайтиДокументВозвратТоваровОтКлиента(ИдЕМЕ)
	
	Запрос = Новый Запрос();
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВозвратТоваров.Ссылка КАК Ссылка
		|ИЗ
		|	
		|РегистрСведений.EmeWmsОтметкиОбИмпортеВозвратовТоваровОтКлиента КАК ВозвратТоваров
		|ГДЕ
		|	ВозвратТоваров.ID = &ИдЕМЕ";
	
	Запрос.УстановитьПараметр("ИдЕМЕ", ИдЕМЕ);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Запрос.УстановитьПараметр("ИдЕМЕ", ИдЕМЕ);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();

		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.ВозвратТоваровОтКлиента.ПустаяСсылка();

КонецФункции

// Функция возвращает ссылку на документ Перемещение товаров по ИД EME
