	Запрос.УстановитьПараметр("ИдЕМЕ", ИдЕМЕ);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();

		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.ПеремещениеТоваров.ПустаяСсылка();

КонецФункции

#КонецОбласти

#Область СозданиеДокументов

// Создает новый или корректирует найденный по ID EME документ Возврата товаров от клиента (на основании реализации)
Функция СоздатьИзменитьДокументВозвратТоваровОтКлиента(КартаТоваров, РеализацияСсылка, СкладСсылка, ИдЕМЕ, НомерЕМЕ, ERPData)
	ВозвратТоваровСсылка = НайтиДокументВозвратТоваровОтКлиента(ИдЕМЕ);
	Если ВозвратТоваровСсылка.Пустая() Тогда
		ВозвратТоваров = Документы.ВозвратТоваровОтКлиента.СоздатьДокумент();
		ВозвратТоваров.Дата = ТекущаяДата();
		// #IBS 16.11.2023
		ВозвратТоваров.Склад = СкладСсылка;
		ВозвратТоваров.Заполнить(РеализацияСсылка);        
		ВозвратТоваров.Комментарий = "Создан автоматом на основании документа прихода EME: " +
			НомерЕМЕ + " (" + ИдЕМЕ + ")" + " (" + ERPData.header.comment + ")";
		ВозвратТоваров.Записать();
	Иначе
		ВозвратТоваров = ВозвратТоваровСсылка.ПолучитьОбъект();
		ВозвратТоваров.Склад = СкладСсылка;
		ВозвратТоваров.Комментарий = "Изменен на основании документа прихода EME: " +
			НомерЕМЕ + " (" + ИдЕМЕ + ")" + " (" + ERPData.header.comment + ")";
	КонецЕсли; 

	EmeWmsУтилиты.СкорректироватьТЧДокумента(ВозвратТоваров.Товары, КартаТоваров, Истина);      
	//ПересчитатьУпаковкиДокумента(ВозвратТоваров);
	EmeWmsДрайвер.ЗаполнитьСтатусыУказанияСерий(ВозвратТоваров, Документы.ВозвратТоваровОтКлиента); 
	EmeWmsДрайвер.ЗаполнитьЦеныПоВидуЦен(ВозвратТоваров); 
	
	ВозвратТоваров.Записать(РежимЗаписиДокумента.Запись);
	EmeWmsПроведениеДокументов.ПометитьДокументКПроведению(ВозвратТоваров.Ссылка);

	Возврат ВозвратТоваров.Ссылка;
КонецФункции

// Создает новый или корректирует найденный по ID EME документ Оприходования излищков товаров
Функция СоздатьИзменитьДокументОприходованияИзлишковТоваров(КартаТоваров, СкладСсылка, ОрганизацияСсылка, ИдЕМЕ, НомерЕМЕ, ERPData)
	
	ОприходованиеСсылка = НайтиДокументОприходованияИзлишковТоваров(ИдЕМЕ);
	Если ОприходованиеСсылка.Пустая() Тогда
		Оприходование 			      = Документы.ОприходованиеТоваров.СоздатьДокумент();
		Оприходование.Дата 		      = ТекущаяДата();
		Оприходование.Склад 	      = СкладСсылка;
		Оприходование.Организация     = ОрганизацияСсылка;
		Оприходование.Подразделение   = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СкладСсылка, "Подразделение");
		Оприходование.ОтражатьВУправленческомУчете = Истина;
		Оприходование.ОтражатьВБухгалтерскомУчете  = Истина;
		//Оприходование.КоррСчет   	  = ПланыСчетов.Хозрасчетный.ПрочиеДоходы;  
    	//Оприходование.Субконто1		  = Справочники.ПрочиеДоходыИРасходы.НайтиПоКоду("0360"); //Меркурий
		//Оприходование.КоррСчетНУ 	  = ПланыСчетов.Налоговый.ВнереализационныеДоходы;
		Оприходование.Комментарий     = "Создан на основании документа прихода EME: " +
			НомерЕМЕ + " (" + ИдЕМЕ + ")" + " (" + ERPData.header.comment + ")"; 		
		//Оприходование.СтатьяДоходов = ПланыВидовХарактеристик.СтатьиДоходов.НайтиПоНаименованию("Внереализационные доходы");
		//Оприходование.АналитикаДоходов = ОрганизацияСсылка;
	Иначе
		Оприходование = ОприходованиеСсылка.ПолучитьОбъект();
		Оприходование.Комментарий = "Документ скорректирован на основании документа прихода EME: " +
			НомерЕМЕ + " (" + ИдЕМЕ + ")" + " (" + ERPData.header.comment + ")";
	КонецЕсли;

	//	Корерктировка табличной части
	// EmeWmsУтилиты.СкорректироватьТабличнуюЧасть(Оприходование, КартаТоваров, Истина);
	EmeWmsУтилиты.СкорректироватьТЧДокумента(Оприходование.Товары, КартаТоваров, Истина);

	//	Валюта регламентированного учета
	мВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	мВалютаУпрУчета    		= глЗначениеПеременной("ВалютаУправленческогоУчета");
	СтруктураКурса     		= МодульВалютногоУчета.ПолучитьКурсВалюты(мВалютаУпрУчета, Оприходование.Дата);
	мКурсУпрУчета      		= СтруктураКурса.Курс;
	мКратностьУпрУчета 		= СтруктураКурса.Кратность;
	мТекущийСтатусПартии 	= Перечисления.СтатусыПартийТоваров.Купленный;
	Качество 		   		= Справочники.Качество.Новый;
	СпособЗаполненияЦен 	= Перечисления.СпособыЗаполненияЦен.ПоЦенамНоменклатуры;
	УчитыватьНДС 		    = Оприходование.ОтражатьВБухгалтерскомУчете;

	// 	Установим цены в документе по виду цены
	ТипЦен = Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("Плановая цена"); 
	Оприходование.ТипЦен = ТипЦен; 
	ВалютаЦены			 = ТипЦен.ВалютаЦены;
	ЦенаВключаетНДС		 = ТипЦен.ЦенаВключаетНДС;
	
	// Если есть цена и тип цен, но нет валюты, тогда в качестве валюты документа возьмем валюту регламентированного учета.
	ВалютаДокумента    = мВалютаРегламентированногоУчета;
	КурсДокумента      = 1;
	КратностьДокумента = 1;

	//	Рассчитываем реквизиты табличной части.
	Для каждого СтрокаТовара из Оприходование.Товары Цикл
		СтрокаТовара.Качество = Качество;

		Цена = Ценообразование.ПолучитьЦенуНоменклатуры(СтрокаТовара.Номенклатура, СтрокаТовара.ХарактеристикаНоменклатуры,
										ТипЦен, Оприходование.Дата, СтрокаТовара.ЕдиницаИзмерения,
										ВалютаДокумента, КурсДокумента, КратностьДокумента, , Неопределено, Неопределено);

		//	Пересчитаем цену в валюту документа.
		Цена = Ценообразование.ПересчитатьЦенуПриИзмененииВалюты(Цена, ВалютаЦены, мВалютаУпрУчета, мКурсУпрУчета, мКратностьУпрУчета, Оприходование.Дата);

		//	В документе цена со всеми налогами
		СуммаВключаетНДС = Истина;

		//	Получим ставки из справочника.
		СтавкаНДС = УчетНДС.ПолучитьСтавкуНДС(СтрокаТовара.Номенклатура.СтавкаНДС);

		СтрокаТовара.Цена = Ценообразование.ПересчитатьЦенуПриИзмененииФлаговНалогов(Цена,
		                                                 СпособЗаполненияЦен,
		                                                 ЦенаВключаетНДС,
		                                                 УчитыватьНДС,
		                                                 СуммаВключаетНДС,
		                                                 СтавкаНДС);

		// 	Отладка: Установим цена = 1 руб., при нулевой цене документ не проводится
		Если СтрокаТовара.Цена = 0 Тогда			
			СтрокаТовара.Цена = 1;			
		КонецЕсли;   
		
		//	Рассчитываем реквизиты табличной части.
		ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуМестТабЧасти(СтрокаТовара, Оприходование, Ложь);
		СтрокаТовара.Коэффициент = СтрокаТовара.ЕдиницаИзмерения.Коэффициент;
		
		ОбработкаТабличныхЧастей.ЗаполнитьПроцентРозничнойНаценкиТабЧасти(СтрокаТовара, Оприходование);
		ОбработкаТабличныхЧастей.РассчитатьРозничнуюЦенуТабЧасти(СтрокаТовара, Оприходование, мВалютаРегламентированногоУчета);
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаТовара, Оприходование);
		
		СтрокаТовара.СуммаРегл    = МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(СтрокаТовара.Сумма, мВалютаУпрУчета, 
													 мВалютаРегламентированногоУчета, мКурсУпрУчета, 1, мКратностьУпрУчета, 1);
								
		Если НЕ ЗначениеЗаполнено(СтрокаТовара.Качество) Тогда
			ОбработкаТабличныхЧастей.ЗаполнитьКачествоНоменклатурыТабЧасти(СтрокаТовара, Оприходование);
		КонецЕсли;
	КонецЦикла;	
	
	Оприходование.Записать(РежимЗаписиДокумента.Запись);
	
	СоздатьОтметкуОбИмпортеОприходованияИзлишковТоваров(Оприходование.Ссылка, ИдЕМЕ);
	EmeWmsПроведениеДокументов.ПометитьДокументКПроведению(Оприходование.Ссылка);         
	
	Возврат Оприходование.Ссылка;
КонецФункции

// Функция создает документ перемещения на склад брака по карте товаров брака, возвращает ссылку на документ перемещения
Функция СоздатьИзменитьДокументПеремещенияНаСкладБрака(ERPData, ИдЕМЕ, НомерЕМЕ, Распоряжение, КартаБрака, СкладБрака)
	Перем Документ, ТаблицаРазличий;
	
	ДокументСсылка = НайтиДокументПеремещенияТоваров(ИдЕМЕ);
	Если ДокументСсылка.Пустая() Тогда
		Документ = Документы.ПеремещениеТоваров.СоздатьДокумент();
		Документ.Заполнить(Распоряжение);
		Документ.Дата = ТекущаяДата();
		Документ.Организация = Распоряжение.Организация;
		Документ.СкладОтправитель = Распоряжение.Склад;
		Документ.СкладПолучатель =  СкладБрака;
		Документ.ОтражатьВБухгалтерскомУчете = Истина;
		Документ.ОтражатьВУправленческомУчете = Истина;
		Документ.ВидОперации = Перечисления.ВидыОперацийПеремещениеТоваров.ТоварыПродукция;
		
		Документ.Комментарий = "Создан на основании документа прихода EME: " +
			НомерЕМЕ + " (" + ИдЕМЕ + ")" + " (" + ERPData.header.comment + ")";
	Иначе
		Документ = ДокументСсылка.ПолучитьОбъект();
		Документ.Комментарий = "Изменен на основании документа прихода EME: " +
			НомерЕМЕ + " (" + ИдЕМЕ + ")" + " (" + ERPData.header.comment + ")";
	КонецЕсли;
		
	EmeWmsУтилиты.СкорректироватьТЧДокумента(Документ.Товары, КартаБрака, Истина);		
	ПересчитатьУпаковкиДокумента(Документ);
	// EmeWmsДрайвер.ЗаполнитьСтатусыУказанияСерий(Документ, Документы.ПеремещениеТоваров);

	Документ.Записать(РежимЗаписиДокумента.Запись);
	СоздатьОтметкуОбИмпортеПеремещенияТоваров(Документ, ИдЕМЕ);
	// #IBS 04.04.2023 Новый механизм проведения
	EmeWmsПроведениеДокументов.ПометитьДокументКПроведению(Документ.Ссылка, 1);
	
	Возврат Документ.Ссылка;
КонецФункции

// Пересчитывает количества упаковок товара в ТЧ Товары
Процедура ПересчитатьУпаковкиДокумента(Документ)
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковок");
	Для Каждого СтрокаТовара Из Документ.Товары Цикл
		СтрокаТовара.Коэффициент = СтрокаТовара.ЕдиницаИзмерения.Коэффициент;
		ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(СтрокаТовара, Документ);
	КонецЦикла;
КонецПроцедуры    

#КонецОбласти

