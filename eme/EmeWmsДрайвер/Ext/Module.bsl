#Область ЛокальныеСлужебныеПроцедурыИФункции

// Функция возвращает ссылку на драйвер актуальной конфигурации, или неопределено
Функция ПолучитьДрайвер()  
	
	МетаданныеИмя	 = Метаданные.Имя;
	МетаданныеВерсия = Лев(Метаданные.Версия, 4);
	
	Если МетаданныеИмя = "УправлениеПредприятием" И МетаданныеВерсия = "2.5." Тогда
		Возврат EmeWmsДрайверERP25;	
	ИначеЕсли МетаданныеИмя = "УправлениеТорговлей" И МетаданныеВерсия = "11.4" Тогда
		Возврат EmeWmsДрайверУТ114;	
	ИначеЕсли МетаданныеИмя = "КомплекснаяАвтоматизация" И Лев(МетаданныеВерсия,3) = "1.1" Тогда
		Возврат EmeWmsДрайверКА1_1;
	Иначе
		Возврат Неопределено;
	КонецЕсли;   
	
КонецФункции  

#КонецОбласти  

 #Область ЭкспортныеСлужебныеПроцедурыИФункции

// Функция возвращает выборку с группами номенклатурами контрагента
Функция ПолучитьГруппыНоменклатурКонтрагента(ПартнерСсылка) Экспорт 
	
	Драйвер = ПолучитьДрайвер();
	Если Драйвер <> Неопределено Тогда
		Возврат Драйвер.ПолучитьГруппыНоменклатурКонтрагента(ПартнерСсылка);
	Иначе       
		Возврат Неопределено;
	КонецЕсли;		
	
КонецФункции

// Функция возвращает тип штрихкода для маркированных товаров
Функция ПолучитьТипШтрихкодаМаркированногоТовара() Экспорт
	Если Метаданные.Перечисления.ТипыШтрихкодов.ЗначенияПеречисления.Найти("GS1_DataMatrix") <> Неопределено Тогда
		Возврат Перечисления.ТипыШтрихкодов.GS1_DataMatrix;
	ИначеЕсли Метаданные.Перечисления.ТипыШтрихкодов.ЗначенияПеречисления.Найти("GS1_128") <> Неопределено Тогда
		Возврат Перечисления.ТипыШтрихкодов.GS1_128;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

