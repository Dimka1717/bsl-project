// #COA 01.12.2023 Создать или изменить документ пересортица товаров
Процедура СоздатьИзменитьДокументПересортицаТоваров(Параметры)
	
	ПересортицаТоваровСсылка = НайтиДокументПересортицаТоваров(Параметры.ИдЕМЕ);
	Если ПересортицаТоваровСсылка.Пустая() Тогда
		Пересортица 				  = Документы.ПересортицаТоваров.СоздатьДокумент();
		Пересортица.Дата 			  = ТекущаяДата();
		Пересортица.Склад 			  = Параметры.СкладСсылка;
		Пересортица.Организация 	  = Параметры.ОрганизацияСсылка; 
		Пересортица.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПересортицаТоваров;
		Пересортица.Подразделение 	  = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.СкладСсылка, "Подразделение");
		Пересортица.Комментарий 	  = "Документ создан на основании документа изменения характеристик EME: " +
			Параметры.НомерЕМЕ + " (" + Параметры.ИдЕМЕ + ")" + " (" + Параметры.ERPData.header.comment + ")";
		Пересортица.СтатьяДоходов 	  = ПланыВидовХарактеристик.СтатьиДоходов.НайтиПоНаименованию("Излишки товарно-материальных ценностей");
		Пересортица.АналитикаДоходов  = Пересортица.Подразделение;
		Пересортица.СтатьяРасходов 	  = ПланыВидовХарактеристик.СтатьиРасходов.НайтиПоНаименованию("Инвентаризация Пересорт Принимаемый");
		Пересортица.АналитикаРасходов = Пересортица.Подразделение; 
		
		// Вид деятельности	
		EmeWmsДрайвер.ЗаполнитьВидДеятельностиНДС(Пересортица);
	Иначе
		Пересортица = ПересортицаТоваровСсылка.ПолучитьОбъект();
		Пересортица.Комментарий = "Документ скорректирован на основании документа изменения характеристик EME: " +
			Параметры.НомерЕМЕ + " (" + Параметры.ИдЕМЕ + ")" + " (" + Параметры.ERPData.header.comment + ")";
	КонецЕсли;
	
	Если НЕ Параметры.ИспользоватьОрдернуюСхему Тогда
		Пересортица.ПересчетТоваров = Параметры.ПересчетТоваровСсылка; 
	КонецЕсли;

	Пересортица.Товары.Очистить();
	Для каждого Строка из Параметры.ТаблицаПересорта Цикл
		НоваяСтрока = Пересортица.Товары.Добавить();  
		
		НоваяСтрока.Номенклатура 			  = Строка.ТоварСписания;
		НоваяСтрока.Серия 					  = Строка.СерияСписания;
		НоваяСтрока.Характеристика 			  = Строка.ХарактеристикаСписания;
		НоваяСтрока.Количество 				  = Строка.КоличествоСписания;    
		// Если учет по ГТД. В приниципе, надо заполнять также ссылку на ГТД
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрока.Номенклатура, "ВестиУчетПоГТД") Тогда
			НоваяСтрока.КоличествоПоРНПТ	  = Строка.КоличествоСписания;    
		КонецЕсли;
		
		НоваяСтрока.НоменклатураОприходование = Строка.ТоварОприходования;
		НоваяСтрока.СерияОприходование 		  = Строка.СерияОприходования;
		НоваяСтрока.ХарактеристикаОприходование = Строка.ХарактеристикаОприходования;
	КонецЦикла;
	
	Пересортица.ВидЦены = Неопределено;
	Пересортица.ПриходоватьТоварыПоСебестоимостиСписания = Истина;
	
	// Цены в документе по виду цены
	//Пересортица.ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию("Прайс-лист");
	//EmeWmsДрайвер.ЗаполнитьЦеныПоВидуЦен(Пересортица);
	
	// Отладка: Установим цена = 1 руб., при нулевой цене документ не проводится
	//Для каждого Строка из Пересортица.Товары Цикл
	//	Если Строка.Цена = 0 Тогда
	//		Строка.Цена = 1;
	//	КонецЕсли;
	//КонецЦикла;
	
	// Валюта
	Пересортица.Валюта  = EmeWmsДрайвер.ПолучитьВалютуУправленческогоУчета(Пересортица.ВидЦены);
	
	EmeWmsДрайвер.ЗаполнитьСтатусыУказанияСерий(Пересортица, Документы.ПересортицаТоваров);	
	
	Пересортица.Записать(РежимЗаписиДокумента.Запись);
	
	СоздатьОтметкуОбИмпортеДокументаПересортицаТоваров(Пересортица.Ссылка, Параметры.ИдЕМЕ);
	EmeWmsПроведениеДокументов.ПометитьДокументКПроведению(Пересортица.Ссылка);
	
КонецПроцедуры

// Функция возвращает ссылку на Приходный ордер по ИД EME
Функция НайтиПриходныйОрдерНаТовары(ИдЕМЕ)
	Перем Запрос, док1;
	
	Запрос = Новый Запрос();
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПриходныйОрдер.Ссылка КАК Ссылка
		|ИЗ
		|	
		|РегистрСведений.EmeWmsОтметкиОбИмпортеПриходныхОрдеровНаТовары КАК ПриходныйОрдер
		|ГДЕ
		|	ПриходныйОрдер.ID = &ИдЕМЕ";
	Запрос.УстановитьПараметр("ИдЕМЕ", ИдЕМЕ);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			док1 = Выборка.Ссылка.ПолучитьОбъект();
			Если НЕ док1.ПометкаУдаления Тогда
				Возврат Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Документы.ПриходныйОрдерНаТовары.ПустаяСсылка();

КонецФункции

