//	$Номенклатура
//	Выгрузка данных о номенклатурах
//	- В 1C при записи номенклатура помечается к экспорту.
//	- 1С (авт.) экспортирует сообщение GOODS.
//	- EME.WMS (авт.) импортирует сообщение GOODS.
//	- EME.WMS (руч.) изменяет ВГХ товаров.

#Область ПрограммныйИнтерфейс  

//	Процедура Экспортировать экспортирует один товар (новая, нужна отладка)
Процедура Экспортировать(ERPData, Товар) Экспорт
	
	КодыЕдиниц = Новый Массив;    
	РеквизитыТовара = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Товар, 
			"ВидНоменклатуры,Артикул,Код,Наименование,НаименованиеПолное,Родитель,БазоваяЕдиницаИзмерения,
			|ЦеноваяГруппа,Услуга,Весовой,ВесовойКоэффициентВхождения,ОсновнойПоставщик,ВестиПартионныйУчетПоСериям,
			|ВестиУчетПоСериям, ВестиСерийныеНомера, ЕдиницаХраненияОстатков");
	
	Если Не ЗначениеЗаполнено(РеквизитыТовара.ЕдиницаХраненияОстатков) Тогда
		Возврат;		
	КонецЕсли;
	
	//	Услуги, работы не эскпортировать в WMS
	РеквизитыВидаНоменкатуры = Новый Структура("Наименование, ТипНоменклатуры");
	Если ЗначениеЗаполнено(РеквизитыТовара.ВидНоменклатуры) Тогда
		РеквизитыВидаНоменкатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыТовара.ВидНоменклатуры, 
																				"Наименование, ТипНоменклатуры");
	КонецЕсли;

	Если РеквизитыТовара.Услуга 
		ИЛИ РеквизитыВидаНоменкатуры.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга") Тогда
		Возврат;
	КонецЕсли;
	
	//	Заголовок товарной единицы
	EmeWmsERPEngine.AppendHeaderLine(ERPData);
	ERPData.header.goods_id		= Товар.УникальныйИдентификатор();
	Если Константы.EmeWmsСоздаватьУникальныеСообщения.Получить() Тогда
		ERPData.header.id	  	= Новый УникальныйИдентификатор;
	Иначе
		ERPData.header.id	  	= ERPData.header.goods_id;		
	КонецЕсли;

	АртикулТовара 	= СокрЛП(РеквизитыТовара.Артикул);
	КодТовара 		= СокрЛП(РеквизитыТовара.Код);      
	
	//	Postgres на линукс плохо реагирует на символ бэкслеш \, заменяю на нижнее подчеркивание. 
	//	Есть один такой товар (Reciprocating Compressor / Поршневой Компрессор\), дает ошибку выполнения запроса записи в базу sql.
	НаименованиеТовара = СтрЗаменить(Лев(РеквизитыТовара.Наименование, 255), "\", "_");
	НаименованиеПолное = СтрЗаменить(Лев(РеквизитыТовара.НаименованиеПолное, 255), "\", "_");

	ERPData.header.goods_code		= КодТовара;
	//	В этом проекте не типовое решение. В артикул будем выгружать только артикул. Если пусто - тогда выгружать код в скобках
	// ERPData.header.article          = СокрЛП(Товар.Код) + ?(ЗначениеЗаполнено(СокрЛП(Товар.Артикул)), "(" + СокрЛП(Товар.Артикул)+ ")", ""); 
	ERPData.header.article          = ?(ЗначениеЗаполнено(АртикулТовара), АртикулТовара, "(" + КодТовара + ")"); 
	ERPData.header.name				= НаименованиеТовара;
	ERPData.header.full_name		= НаименованиеПолное;
	ERPData.header.classifier		= ПолучитьПолныйПутьГруппыНоменклатуры(Товар, Ложь);
	Если ERPData.header.classifier = "" Тогда
		ERPData.header.classifier = "Прочее";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РеквизитыТовара.Родитель) Тогда
		ERPData.header.classifier_id = РеквизитыТовара.Родитель.УникальныйИдентификатор();
		
		//	В поле производитель выгружается наименование группы номенклатуры
		РеквизитыГруппы = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыТовара.Родитель, "Код, Наименование");
		ERPData.header.producer_id 	 = ERPData.header.classifier_id;
		ERPData.header.producer_code = РеквизитыГруппы.Код;
		ERPData.header.producer_name = РеквизитыГруппы.Наименование;		
	КонецЕсли; 
	
	// Товар с марками ЧЗ               
	//Если ERPData.header.Владелец().Колонки.Найти("is_use_true_sign") <> Неопределено Тогда
	//	ERPData.header.is_use_true_sign	= ?(ЗначениеЗаполнено(РеквизитыТовара.Ссылка_медидиан), 1, 0);
	//КонецЕсли;
	Если ERPData.header.Владелец().Колонки.Найти("is_use_true_sign") <> Неопределено Тогда //09122025
		Если ЗначениеЗаполнено(Товар.КодТНВЭД) Тогда
			ERPData.header.is_use_true_sign = ?(Товар.КодТНВЭД.МаркированныйТовар,1,0);
		КонецЕсли;
	КОнецЕсли;
	Если ЗначениеЗаполнено(Товар.НомерГТД) Тогда
		//	ERPData.header.is_gtd_used = 1;
	КонецЕсли;
	
	// #IBS 11.03.2025 основная единица с ВГХ выделена жирным шрифтом - это ссылка на единицу хранения остатков.
	ОсновнаяЕдиница = РеквизитыТовара.ЕдиницаХраненияОстатков;
	
	ERPData.header.code_status	= "STD"; 
	//	Срок годности по умолчанию 7999
	ERPData.header.shelf_life	= 7999;
	ERPData.header.stackability = 1;  
	
	//	Простейшее определения типа номенклатуры WMS по типу номенклатуры 1С и наимнованию вида номенклатуры (настроить под справочник клиента).
	// Тип продукта (1 - 'Готовая продукция', 2 - 'Полуфабрикат', 3 - 'Упаковка', 4 - 'Сырье', '5 - Рекламная продукция',
	// 6 - 'Service&Material', 7 - 'Trade assets', 8 - 'Rework', 9 - 'Составной', 10 - 'Тара')
	//Если ТипНоменклатуры = Перечисления.ТипыНоменклатуры.МногооборотнаяТара Тогда
	//	ERPData.header.product_type = 10;  
	//Иначе
	Если РеквизитыВидаНоменкатуры.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Набор") Тогда
		ERPData.header.product_type = 9;  
	ИначеЕсли Найти(НРег(РеквизитыВидаНоменкатуры.Наименование), "материал") Тогда
		ERPData.header.product_type = 4;  
	ИначеЕсли Найти(НРег(РеквизитыВидаНоменкатуры.Наименование), "полуфабрикат") Тогда
		ERPData.header.product_type = 2;  
	Иначе
		ERPData.header.product_type = 0;  
	КонецЕсли;		
	
	//Если Не РеквизитыТовара.ОсновнойПоставщик.Пустая() Тогда
	//	ERPData.header.producer_id 	 = РеквизитыТовара.ОсновнойПоставщик.УникальныйИдентификатор();
	//	ERPData.header.producer_code = РеквизитыТовара.ОсновнойПоставщик.Код;
	//	ERPData.header.producer_name = РеквизитыТовара.ОсновнойПоставщик.Наименование;
	//КонецЕсли;
	
	//	Запись признака использования серийных номеров номенклатуры
	Если РеквизитыТовара.ВестиСерийныеНомера Тогда
		ERPData.header.is_use_serial_no = 1;
	Иначе
		ERPData.header.is_use_serial_no = 0;
	КонецЕсли;
	
	//	Учетная ЕИ (по-умолчанию при вводе в документы)
	Если Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыТовара.ЕдиницаХраненияОстатков, "ПометкаУдаления") Тогда
		ERPData.header.stock_pack_id = РеквизитыТовара.ЕдиницаХраненияОстатков.УникальныйИдентификатор(); 
	КонецЕсли;
	
	// Упаковки товара
	EmeWmsERPEngine.SelectChild(ERPData, "packs");
	
	КодОсновнойЕдиницы 	= ПолучитьКодЕдиницыИзмерения(ОсновнаяЕдиница.ЕдиницаПоКлассификатору);
	
	EmeWmsERPEngine.AppendChildLine(ERPData);
	ERPData.packs.id 		= ОсновнаяЕдиница.УникальныйИдентификатор();
	ERPData.packs.pack_code = ОсновнаяЕдиница.Наименование;
		
	ERPData.packs.contains_id 	= "";
	ERPData.packs.contains_code = "";
	ERPData.packs.factor 		= 1;
	ERPData.packs.is_sscc 		= 1;
	
	ERPData.packs.mu_code 	= КодОсновнойЕдиницы;
	Если Нрег(СокрЛП(ОсновнаяЕдиница.Наименование)) = "кг" Тогда
		ERPData.packs.precision = 3; // точность для килограммов 3 знака после запятой. 
	КонецЕсли;
	ERPData.packs.mu_name 	= ОсновнаяЕдиница.Наименование;
	
	//	ВГХ
	ERPData.packs.brutto 	= ОсновнаяЕдиница.Вес; // вес в кг
	ERPData.packs.netto 	= ERPData.packs.brutto;
	ERPData.packs.volume 	= ОсновнаяЕдиница.Объем * 1000000; // Из м^3 в см^3

	ERPData.packs.width 	= ?(ОсновнаяЕдиница.Ширина > 0.0, ОсновнаяЕдиница.Ширина * 0.1, 0.01); // из миллиметров в сантиметры;
	ERPData.packs.length 	= ?(ОсновнаяЕдиница.Длина > 0.0, ОсновнаяЕдиница.Длина * 0.1, 0.01); 
	ERPData.packs.height 	= ?(ОсновнаяЕдиница.Высота > 0.0, ОсновнаяЕдиница.Высота * 0.1, 0.01); 
		
	Выборка = Справочники.ЕдиницыИзмерения.Выбрать(,Товар);
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ПометкаУдаления Тогда
			Продолжить
		КонецЕсли;
		
		// Не должно быть две минимальных упаковки
		Если ОсновнаяЕдиница.Коэффициент = Выборка.Коэффициент Тогда
			Продолжить
		КонецЕсли;
		
		КодЕдиницыИзмерения = ПолучитьКодЕдиницыИзмерения(Выборка.ЕдиницаПоКлассификатору);
		
		EmeWmsERPEngine.AppendChildLine(ERPData);
		ERPData.packs.id 		= Выборка.Ссылка.УникальныйИдентификатор();
		ERPData.packs.pack_code = Выборка.Наименование;
		Ссылка1 = ПолучитьВложеннуюУпаковку(Товар, Выборка.Ссылка);
		
		Если Ссылка1 = Неопределено ИЛИ Ссылка1.Наименование = ОсновнаяЕдиница.Наименование Тогда  // Если вложение - основная единица измерения
			ERPData.packs.contains_id 	= ОсновнаяЕдиница.УникальныйИдентификатор();
			ERPData.packs.contains_code = ОсновнаяЕдиница.Наименование;
			ERPData.packs.factor 		= Выборка.Коэффициент; // Если упаковка состоит из единиц по классификатору
		Иначе
			ERPData.packs.contains_id 	= Ссылка1.УникальныйИдентификатор();
			ERPData.packs.contains_code = Ссылка1.Наименование;
			ERPData.packs.factor 		= Выборка.Коэффициент;
		КонецЕсли;
		
		ЕдиницаПоКлассификаторуНаименование = СокрЛП(Нрег(Выборка.ЕдиницаПоКлассификатору.Наименование));
		Если ЕдиницаПоКлассификаторуНаименование = "паллет"
			ИЛИ ЕдиницаПоКлассификаторуНаименование = "пл" Тогда	// Определение числа слоев
			ERPData.packs.layers = 1; // Число слоев
		КонецЕсли;
		
		ERPData.packs.is_sscc = 1;
		ERPData.packs.mu_code = КодЕдиницыИзмерения;
		ERPData.packs.mu_name = Выборка.ЕдиницаПоКлассификатору.Наименование;
		
		Если Нрег(СокрЛП(Выборка.ЕдиницаПоКлассификатору.Наименование)) = "кг" Тогда
			ERPData.packs.precision = 3; // точность для килограммов 3 знака после запятой. 
		КонецЕсли;
		
		// ВГХ
		ERPData.packs.brutto 	= ?(Выборка.Вес > 0, Выборка.Вес, 0.01);
		ERPData.packs.netto 	= ERPData.packs.brutto;
		ERPData.packs.volume 	= Выборка.Объем * 1000000; // Из м^3 в см^3

		ERPData.packs.width 	= Выборка.Ширина * 0.1; 
		ERPData.packs.length 	= Выборка.Длина * 0.1; 
		ERPData.packs.height 	= Выборка.Высота * 0.1; 
	КонецЦикла;
			
	// Типовая схема экспорта ШК
	МассивШтрихкодов = ПолучитьШтрихкодыНоменклатуры(Товар);
	
	EmeWmsERPEngine.SelectChild(ERPData, "bar_codes");  
	НомерШК = 0;
	Для Каждого Запись Из МассивШтрихкодов Цикл 
		
		НомерШК = НомерШК + 1;
		EmeWmsERPEngine.AppendChildLine(ERPData);
		ERPData.bar_codes.id				= НомерШК;
		// Это нужно для того, чтобы при дублях единицы (штука) перенести ШК на основную ед.
		Если ОсновнаяЕдиница.Коэффициент 	= Запись.Упаковка.Коэффициент Тогда
			ERPData.bar_codes.pack_id 		= ОсновнаяЕдиница.УникальныйИдентификатор();
			ERPData.bar_codes.pack_code 	= ОсновнаяЕдиница.Наименование;
		Иначе
			ERPData.bar_codes.pack_id 		= Запись.Упаковка.УникальныйИдентификатор();
			ERPData.bar_codes.pack_code 	= Запись.Упаковка.Наименование;
		КонецЕсли;
		ERPData.bar_codes.bar_code			= Запись.ШтрихКод;
		ERPData.bar_codes.bar_code_type 	= Запись.ТипШтрихКода;	
		
	КонецЦикла;    
	
	//Комплектация номенклатуры		
	//Запрос = Новый Запрос;
	//Запрос.Текст = 
	//	"ВЫБРАТЬ
	//	|	Комплектующие.Номенклатура КАК Номенклатура,
	//	|	Комплектующие.Количество КАК Количество,
	//	|	Комплектующие.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	//	|ИЗ
	//	|	РегистрСведений.КомплектующиеНоменклатуры КАК Комплектующие
	//	|ГДЕ
	//	|	Комплектующие.Номенклатура = &ТоварСсылка";
	//Запрос.УстановитьПараметр("ТоварСсылка", Товар.Ссылка);
	//
	//РезультатЗапросаКомплектующих = Запрос.Выполнить();

	//Если Не РезультатЗапросаКомплектующих.Пустой() Тогда

	//	EmeWmsERPEngine.SelectChild(ERPData, "kit_items");
	//	ЕстьКомплектация = ложь;
	//	НомерВарианта = 0;
	//	НомерСтроки = 0;

	//	ТЧКомп = РезультатЗапросаКомплектующих.Выгрузить();
	//	НомерВарианта = НомерВарианта + 1;
	//		
	//	Для каждого стр1 из ТЧКомп Цикл  
	//		// Есть в комплектации пустые данные
	//		Если ЗначениеЗаполнено(стр1.Номенклатура) И стр1.Количество > 0.0 Тогда
	//			// Чтобы не было рекурсии, такие данные не импортируются в WMS
	//			Если стр1.Номенклатура <> Товар.Ссылка Тогда
	//				EmeWmsERPEngine.AppendChildLine(ERPData);
	//					НомерСтроки = НомерСтроки + 1;
	//				
	//					ERPData.kit_items.id			= Строка(НомерСтроки);
	//					ERPData.kit_items.variant_no	= НомерВарианта;
	//					ERPData.kit_items.goods_id    	= стр1.Номенклатура.УникальныйИдентификатор();
	//		   			ERPData.kit_items.goods_code    = СокрЛП(стр1.Номенклатура.Код);
	//					
	//					ERPData.kit_items.quantity 		= стр1.Количество;
	//		     		ERPData.kit_items.pack_id   	= стр1.ЕдиницаИзмерения.УникальныйИдентификатор();
	//		      		ERPData.kit_items.pack_code 	= стр1.ЕдиницаИзмерения.Наименование;
	//					
