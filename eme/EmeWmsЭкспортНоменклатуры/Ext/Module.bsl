#Область ЭкспортныеСлужебныеПроцедурыИФункции

//	Функция ПолучитьИмяСообщения возвращает имя сообщения
Функция ПолучитьИмяСообщения() Экспорт
	Возврат "goods";
КонецФункции

//	Функция ПолучитьМетаданные возвращает метаданные сообщения
Функция ПолучитьМетаданные() Экспорт
	Возврат Метаданные.Справочники.Номенклатура;
КонецФункции

//	Функция ПолучитьВыборкуСсылок возвращает выборку ссылок для экспорта
Функция ПолучитьВыборкуСсылок() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	EmeWmsПометкиКЭкспортуНоменклатуры.Номенклатура КАК Ссылка
		|ИЗ
		|	РегистрСведений.EmeWmsПометкиКЭкспортуНоменклатуры КАК EmeWmsПометкиКЭкспортуНоменклатуры
		|ГДЕ
		|	EmeWmsПометкиКЭкспортуНоменклатуры.КЭкспорту";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выбрать();
КонецФункции

//	Функция РазрешенКЭкспорту возвращает Истина, если товар разрешен к экспорту
Функция РазрешенКЭкспорту(Товар) Экспорт
	Если Товар.Ссылка.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Товар.ЭтоГруппа Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Товар.ВидНоменклатуры) Тогда
		ОтменитьЭкспорт(Товар);
		Возврат Ложь;
	КонецЕсли;
	
	// Без основной единицы-упаковки не выгружать
	Если Не ЗначениеЗаполнено(Товар.ЕдиницаХраненияОстатков) Тогда
		ОтменитьЭкспорт(Товар);
		Возврат Ложь;
	КонецЕсли;
	
	//	Услуги и работы не выгружать
	ТипНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Товар.ВидНоменклатуры, "ТипНоменклатуры");
	Если ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга Тогда
		ОтменитьЭкспорт(Товар);
		Возврат Ложь;
	КонецЕсли;
	
	// Поиск родительской группы, разрешенной к экспорту
	ГруппаСсылка = Товар.Родитель;   
	Если ГруппаСсылка <> Справочники.Номенклатура.ПустаяСсылка() Тогда 
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	EmeWmsПометкиКЭкспортуНоменклатуры.РазрешенКЭкспорту КАК РазрешенКЭкспорту
			|ИЗ
			|	РегистрСведений.EmeWmsПометкиКЭкспортуНоменклатуры КАК EmeWmsПометкиКЭкспортуНоменклатуры
			|ГДЕ
			|	EmeWmsПометкиКЭкспортуНоменклатуры.Номенклатура = &ТоварСсылка";
		Запрос.УстановитьПараметр("ТоварСсылка", ГруппаСсылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.РазрешенКЭкспорту Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	Иначе            
		// Товары без группы не нужны
		ОтменитьЭкспорт(Товар);		
		Возврат Ложь;
	КонецЕсли;
	
	ОтменитьЭкспорт(Товар);	
	Возврат Ложь;
КонецФункции

//	Устанавливает признак РазрешенКЭкспорту в ложь регистре сведений
Процедура ЗапретитьЭкспорт(Товар) Экспорт
	
	НаборЗаписей = РегистрыСведений.EmeWmsПометкиКЭкспортуНоменклатуры.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Номенклатура.Установить(Товар.Ссылка);
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл 
		Запись.РазрешенКЭкспорту = Ложь;
		НаборЗаписей.Записать();
		Возврат;
	КонецЦикла;
КонецПроцедуры
	
//	Устанавливает признак РазрешенКЭкспорту в истину в регистре сведений
Процедура РазрешитьЭкспорт(Товар) Экспорт
	Перем Запрос, Выборка, Результат;

	НаборЗаписей = РегистрыСведений.EmeWmsПометкиКЭкспортуНоменклатуры.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Номенклатура.Установить(Товар.Ссылка);
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл
		//Если Запись.РазрешенКЭкспорту Тогда
		//	Возврат;
		//Иначе
			Запись.РазрешенКЭкспорту = Истина;
			Запись.КЭкспорту = Истина;
			НаборЗаписей.Записать();
			Возврат;
		//КонецЕсли;
	КонецЦикла;
	
  	НоваяЗапись = РегистрыСведений.EmeWmsПометкиКЭкспортуНоменклатуры.СоздатьМенеджерЗаписи();
	НоваяЗапись.Номенклатура = Товар.Ссылка;
	НоваяЗапись.РазрешенКЭкспорту = Истина;
	НоваяЗапись.КЭкспорту = Истина;
    НоваяЗапись.Записать(); 
	
КонецПроцедуры

//	Устанавливает признак РазрешенКЭкспорту для товара (ссылка) и родительских элементов
Процедура РазрешитьЭкспортСГруппами(Товар) Экспорт

	Товар1 = Товар.Ссылка;
	Пока Товар1 <> Справочники.Номенклатура.ПустаяСсылка() Цикл
		Если Товар1.ЭтоГруппа Тогда
			EmeWmsЭкспортГруппНоменклатуры.РазрешитьЭкспорт(Товар1);
		Иначе
			РазрешитьЭкспорт(Товар1);
		КонецЕсли;
		Товар1 = Товар1.Родитель;
	КонецЦикла;
КонецПроцедуры

