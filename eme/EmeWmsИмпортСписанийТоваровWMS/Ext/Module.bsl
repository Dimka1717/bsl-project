//  $Списание товаров (по инициативе WMS)
// 	Импорт сообщений OFFWRITE:
//	- Оператор EME.WMS (руч.) создает и оформляет документ списания товаров (опционально списание с оприходованием), закрывает его.
//	- После закрытия документа списания EME.WMS (авт.) экспортирует сообщение OFFWRITE.
//	- 1C (авт.) импортирует сообщение OFFWRITE. 
//	Если это списание без оприходования,
// 	- 1C (авт.) Создает документ Списание товаров, проводит его.
//	В комментарий документа записывается номер документа списания WMS.
//	Если это списание с оприходованием и причина списания - пересорт,
//	- 1C (авт.) создает документ Пересортица товаров, проводит его.
//	В комментарий документа записывается номер документа списания WMS.
//	Если это списание с оприходованием и причина списания не пересорт,
//	- 1C (авт.) создает документ Порча товаров, проводит его.
//	В комментарий документа записывается номер документа списания WMS.   

#Область ПрограммныйИнтерфейс

//	Функция ПолучитьИмяСообщения возвращает имя сообщения
Функция ПолучитьИмяСообщения() Экспорт
	Возврат "offwrite";
КонецФункции

//	Функция ПолучитьМетаданные возвращает метаданные сообщения
Функция ПолучитьМетаданные() Экспорт
	Возврат Метаданные.Документы.СписаниеТоваров;
КонецФункции

// Импортирует offwrite в разные документы: списание товаров, оприходование товаров, СС_документ_пересорт?
Процедура Импортировать(ERPData, Трассировка, ТемаСообщения) Экспорт
	// Это списание по инициативе 1С, не обрабатываем
	Если ЗначениеЗаполнено(ERPData.header.erp_doc_type) Тогда
		Возврат;
	КонецЕсли;

	// Номер документа EME для комментариев
	НомерЕМЕ = ERPData.header.offwrite_reg_no;
	
	//	Соберем товары и количества
	ТаблицаСкладов = РазметитьТаблицуСкладов();
	ПолучитьКоличестваТоваров(ERPData, ТаблицаСкладов);	
	// Если не было списания по складам WMS
	Если ТаблицаСкладов.Количество() = 0 Тогда
		EmeWmsERPEngine.ErrorHeader(ERPData, "LNSNUL");
		ERPData.header.error_more = НСтр("ru='Списание не импортировано, нулевое количество строк'");
		Возврат;
	КонецЕсли;
	
	КодОрганизации = ERPData.header.vendor_code;
	// Получим Организацию по коду EME
	ОрганизацияСсылка = EmeWmsУтилиты.ПолучитьСсылкуНаОрганизациюПоКодуEME(КодОрганизации);
	Если ОрганизацияСсылка.Пустая() Тогда
		EmeWmsERPEngine.ErrorHeader(ERPData, "VNDBAD");
		Возврат;
	КонецЕсли;

	//	Если были ошибки
	Если EmeWmsERPEngine.HasErrors(ERPData) Тогда
		Возврат;
	КонецЕсли;

	// Если несколько складов (основной и неликвид), для каждого создадим свои документы
	Для каждого СтрокаСкладов из ТаблицаСкладов Цикл
		// Идентификатор док-та EME для записи в регистры импорта (декорированный статусом товара, может быть два ордера на сообщение).
		ИдЕМЕ 	 = ERPData.header.offwrite_id + "/" + СтрокаСкладов.СтатусТовара;
	    СкладСсылка = СтрокаСкладов.Склад;
		КартаТоваровСписания = СтрокаСкладов.КартаТоваровСписания;
		КартаТоваровОприходования = СтрокаСкладов.КартаТоваровОприходования;
		ТаблицаПересорта = СтрокаСкладов.ТаблицаПересорта;
		
		Параметры = Новый Структура;
		Параметры.Вставить("ERPData", 					ERPData);    
		Параметры.Вставить("ИдЕМЕ", 					ИдЕМЕ);
		Параметры.Вставить("НомерЕМЕ", 					НомерЕМЕ);
		Параметры.Вставить("ОрганизацияСсылка", 		ОрганизацияСсылка);
		Параметры.Вставить("СкладСсылка", 				СтрокаСкладов.Склад);
		Параметры.Вставить("ПересчетТоваровСсылка", 	Неопределено);
		Параметры.Вставить("ИспользоватьОрдернуюСхему", Ложь);
		Параметры.Вставить("ИмпортироватьМаркиЧЗ", 		Константы.EmeWmsИмпортироватьМаркиЧЗ.Получить());

		//*** Проверки сделали, пишем в базу данных 1C ***
		
		// Для строк без оприходования создадим документы на отражение недостач
		Если КартаТоваровСписания.Количество() > 0 Тогда  
			
			Параметры.Вставить("КартаТоваровСписания", КартаТоваровСписания);
			СоздатьИзменитьДокументСписанияНедостачТоваров(Параметры);
			
			//Если Параметры.ИмпортироватьМаркиЧЗ Тогда
			//	СоздатьИзменитьДокументВыводИзОборотаИСМП(Параметры);	
			//КонецЕсли;		
		КонецЕсли;   

		// Для строк без списания создадим документы на отражение излишков
		Если КартаТоваровОприходования.Количество() > 0 Тогда
			
			Параметры.Вставить("КартаТоваровОприходования", КартаТоваровОприходования);
			
			СоздатьИзменитьДокументОприходованияТоваров(Параметры);
		КонецЕсли;   

	КонецЦикла;
	
	EmeWmsERPEngine.Success(ERPData);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//	Процедура ОтменитьЭкспорт отменяет экспорт документа.
Процедура ОтменитьЭкспортСписанияТоваров(Документ)
	НаборЗаписей = РегистрыСведений.EmeWmsПометкиКЭкспортуСписанийТоваров.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.СписаниеТоваров.Установить(Документ.Ссылка);
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл
		Запись.КЭкспорту = Ложь;
		НаборЗаписей.Записать();
		Возврат;
	КонецЦикла;
	
КонецПроцедуры

//	Получить список складов с картами товаров для списания, оприходования и пересорта
// 	Карта товаров: ключ = UID товара + UID серии + UID характеристики, значение = количество в ед.хранения
Процедура ПолучитьКоличестваТоваров(ERPData, ТаблицаСкладов)	

	//	Использование серий в интеграции
	ИспользоватьСерии = Константы.EmeWmsИспользоватьСерии.Получить();	
	
	КлючиТоваров = Новый Соответствие();
	КодСклада = ERPData.header.whs_code;
	КодОрганизации = ERPData.header.vendor_code;
	
	// Весь товар в сообщении
	EmeWmsERPEngine.SelectChild(ERPData, "lines");
	Пока EmeWmsERPEngine.NextChildLine(ERPData) Цикл
		КодЗоны = ERPData.lines.zone_code;
		СтатусТовара = ERPData.lines.stock_status;
		СкладСсылка = EmeWmsУтилиты.ПолучитьСсылкуНаСкладПоКодуEME(КодСклада, КодЗоны, КодОрганизации, СтатусТовара);
		Если СкладСсылка.Пустая() Тогда
			EmeWmsERPEngine.ErrorHeader(ERPData, "WHSBAD");
			Возврат;
		КонецЕсли;
		
		// Теперь найдем склад в таблице складов
		КартаТоваровСписания = Неопределено;
		Для Каждого СтрокаСкладов из ТаблицаСкладов Цикл
			Если СтрокаСкладов.Склад = СкладСсылка Тогда
				КартаТоваровСписания = СтрокаСкладов.КартаТоваровСписания;
				КартаТоваровОприходования = СтрокаСкладов.КартаТоваровОприходования;
				ТаблицаПересорта = СтрокаСкладов.ТаблицаПересорта;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		// Если нет такой, создадим строку складов
		Если КартаТоваровСписания = Неопределено Тогда     
			КартаТоваровСписания = Новый Соответствие;                                                                           
			КартаТоваровОприходования = Новый Соответствие;                                                                           
			ТаблицаПересорта = РазметитьТаблицуПересорта();
			
			СтрокаСкладов = ТаблицаСкладов.Добавить();
			СтрокаСкладов.Склад = СкладСсылка;
			СтрокаСкладов.СтатусТовара = СтатусТовара;
			СтрокаСкладов.КартаТоваровСписания = КартаТоваровСписания;                                                                           
			СтрокаСкладов.КартаТоваровОприходования = КартаТоваровОприходования;                                                                           
			СтрокаСкладов.ТаблицаПересорта = ТаблицаПересорта; 
		Иначе			
		КонецЕсли;
		
		Если ERPData.lines.quantity > 0.0 Тогда //	Выберем строки со спиcанием
			УИДТовара = ERPData.lines.goods_id;
			УИДЕдиницы = ERPData.lines.pack_id;
			Если УИДТовара = "" Тогда
				EmeWmsERPEngine.ErrorChild(ERPData, "GDSNUL");
				Продолжить
			КонецЕсли;
		
			ТоварСсылка = EmeWmsУтилиты.ПолучитьСсылкуНаТовар(УИДТовара);
			Если ТоварСсылка.Пустая() Тогда
				EmeWmsERPEngine.ErrorChild(ERPData, "GDSBAD");
				Продолжить
			КонецЕсли;
		
			ЕдиницаИзмерения = EmeWmsУтилиты.ПолучитьСсылкуНаЕдиницуИзмерения(УИДЕдиницы);
			Если ЕдиницаИзмерения.Пустая() Тогда
				EmeWmsERPEngine.ErrorChild(ERPData, "PCKBAD");
				Продолжить
			КонецЕсли;
		
			РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТоварСсылка, "ВестиУчетПоСериям, ВестиУчетПоХарактеристикам"); 
			
			Если Не ИспользоватьСерии Тогда
				РеквизитыНоменклатуры.ВестиУчетПоСериям = Ложь;
			КонецЕсли;

			СерияНоменклатуры 		   	= Неопределено;
			ХарактеристикаНоменклатуры 	= Неопределено;
			
			Если РеквизитыНоменклатуры.ВестиУчетПоСериям Тогда   
				// Серии, если их нет при списании - создавать.
				СерияНоменклатуры = EmeWmsУтилиты.ПолучитьСериюПоНаименованию(ERPData.lines.lot_no, ТоварСсылка, Истина);
			ИначеЕсли РеквизитыНоменклатуры.ВестиУчетПоХарактеристикам Тогда
				ХарактеристикаНоменклатуры = EmeWmsУтилиты.ПолучитьХарактеристикуПоНаименованию(ERPData.lines.lot_no, ТоварСсылка);
			КонецЕсли;
			
			КлючиТоваров.Вставить(ERPData.lines.id, ТоварСсылка);
			КодЗоны = ERPData.lines.zone_code;
			КлючТовара = EmeWmsУтилиты.СоздатьКлючТовара(ТоварСсылка, СерияНоменклатуры, ХарактеристикаНоменклатуры);
			КоличествоВБазовой = EmeWmsУтилиты.ПересчетВДругуюЕдиницу(ERPData.lines.quantity, ЕдиницаИзмерения, ТоварСсылка.ЕдиницаХраненияОстатков);
			КоличествоПоКарте = ?(КартаТоваровСписания.Получить(КлючТовара) = неопределено, 0.0, КартаТоваровСписания.Получить(КлючТовара));
			КартаТоваровСписания.Вставить(КлючТовара, КоличествоПоКарте + КоличествоВБазовой);
			
		КонецЕсли;
		
		Если ERPData.lines.new_quantity > 0.0 Тогда //	Выберем строки с оприходованием
			УИДТовара = ERPData.lines.new_goods_id;
			УИДЕдиницы = ERPData.lines.new_pack_id;
			Если УИДТовара = "" Тогда
				EmeWmsERPEngine.ErrorChild(ERPData, "GDSNUL");
				Продолжить
			КонецЕсли;
		
			ТоварСсылка = EmeWmsУтилиты.ПолучитьСсылкуНаТовар(УИДТовара);
			Если ТоварСсылка.Пустая() Тогда
				EmeWmsERPEngine.ErrorChild(ERPData, "GDSBAD");
				Продолжить
			КонецЕсли;
		
			ЕдиницаИзмерения = EmeWmsУтилиты.ПолучитьСсылкуНаЕдиницуИзмерения(УИДЕдиницы);
			Если ЕдиницаИзмерения.Пустая() Тогда
				EmeWmsERPEngine.ErrorChild(ERPData, "PCKBAD");
				Продолжить
			КонецЕсли;
		
			РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТоварСсылка, "ВестиУчетПоСериям, ВестиУчетПоХарактеристикам"); 

			Если Не ИспользоватьСерии Тогда
				РеквизитыНоменклатуры.ВестиУчетПоСериям = Ложь;
			КонецЕсли;

			СерияНоменклатуры 		   	= Неопределено;
			ХарактеристикаНоменклатуры 	= Неопределено;
			
			Если РеквизитыНоменклатуры.ВестиУчетПоСериям Тогда   
				// Серии, если их нет при списании - создавать.
				СерияНоменклатуры = EmeWmsУтилиты.ПолучитьСериюПоНаименованию(ERPData.lines.new_lot_no, ТоварСсылка, Истина);
			ИначеЕсли РеквизитыНоменклатуры.ВестиУчетПоХарактеристикам Тогда
				ХарактеристикаНоменклатуры = EmeWmsУтилиты.ПолучитьХарактеристикуПоНаименованию(ERPData.lines.new_lot_no, ТоварСсылка);
			КонецЕсли;

			КлючиТоваров.Вставить(ERPData.lines.id, ТоварСсылка);
			КодЗоны = ERPData.lines.zone_code;
			КлючТовара = EmeWmsУтилиты.СоздатьКлючТовара(ТоварСсылка, СерияНоменклатуры, ХарактеристикаНоменклатуры);
			КоличествоВБазовой = EmeWmsУтилиты.ПересчетВДругуюЕдиницу(ERPData.lines.new_quantity, ЕдиницаИзмерения, ТоварСсылка.ЕдиницаХраненияОстатков);
			КоличествоПоКарте = ?(КартаТоваровОприходования.Получить(КлючТовара) = неопределено, 0.0, КартаТоваровОприходования.Получить(КлючТовара));
			КартаТоваровОприходования.Вставить(КлючТовара, КоличествоПоКарте + КоличествоВБазовой);
			
		КонецЕсли;   
	КонецЦикла;
	
КонецПроцедуры

//	Получить коэф. пересчета (сколько упак 2 содержится в упак 1)
Функция ПолучитьКоэффициентПересчетаЕдиниц(Упаковка1, Упаковка2)
	Если Упаковка1 <> Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка() И
		Упаковка2 <> Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка() Тогда
		Если Упаковка1.Числитель <> 0 И Упаковка2.Числитель <> 0 Тогда
			КоэффициентПересчета = Упаковка1.Числитель / Упаковка2.Числитель;
		Иначе
			КоэффициентПересчета = 1;
		КонецЕсли;
	Иначе 
		КоэффициентПересчета = 1;
	КонецЕсли;
	
	Возврат КоэффициентПересчета;
КонецФункции

//	Заполняет таблицу пересчета
Функция ПолучитьТаблицуПересчета(ТаблицаПересчета, КартаТоваровСписания, КартаТоваровОприходования, ТаблицаПересорта) 
	Перем ТоварСсылка, СерияСсылка, ХарактеристикаСсылка;
	
	Для каждого Строка Из КартаТоваровСписания Цикл    
		EmeWmsУтилиты.РазобратьКлючНаСсылки(Строка.Ключ, ТоварСсылка, СерияСсылка, ХарактеристикаСсылка);
		
		СтрокаПересчета 				= ТаблицаПересчета.Добавить();
		СтрокаПересчета.Номенклатура 	= ТоварСсылка;
		СтрокаПересчета.Характеристика 	= ХарактеристикаСсылка;
		СтрокаПересчета.Серия 			= СерияСсылка;
		СтрокаПересчета.Упаковка 		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТоварСсылка, "ЕдиницаИзмерения");
		СтрокаПересчета.КоличествоСтарое= Строка.Значение;
		СтрокаПересчета.КоличествоНовое = 0.0;		
	КонецЦикла;
	
	Для каждого Строка Из КартаТоваровОприходования Цикл    
		EmeWmsУтилиты.РазобратьКлючНаСсылки(Строка.Ключ, ТоварСсылка, СерияСсылка, ХарактеристикаСсылка);
		
		СтрокаПересчета 				= ТаблицаПересчета.Добавить();
		СтрокаПересчета.Номенклатура 	= ТоварСсылка;
		СтрокаПересчета.Характеристика 	= ХарактеристикаСсылка;
		СтрокаПересчета.Серия 			= СерияСсылка;
		СтрокаПересчета.Упаковка 		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТоварСсылка, "ЕдиницаИзмерения");
		СтрокаПересчета.КоличествоСтарое= 0.0;
		СтрокаПересчета.КоличествоНовое = Строка.Значение;		
	КонецЦикла;
	
	Для каждого Строка Из ТаблицаПересорта Цикл    
		СтрокаПересчета 				= ТаблицаПересчета.Добавить();
		СтрокаПересчета.Номенклатура 	= Строка.ТоварСписания;
		СтрокаПересчета.Характеристика 	= Строка.ХарактеристикаСписания;
		СтрокаПересчета.Серия 			= Строка.СерияСписания;
		СтрокаПересчета.Упаковка 		= Строка.ЕдиницаИзмеренияСписания;
		СтрокаПересчета.КоличествоСтарое= Строка.КоличествоСписания;
		СтрокаПересчета.КоличествоНовое = 0.0;	
		
		СтрокаПересчета 				= ТаблицаПересчета.Добавить();
		СтрокаПересчета.Номенклатура 	= Строка.ТоварОприходования;
		СтрокаПересчета.Характеристика 	= Строка.ХарактеристикаОприходования;
		СтрокаПересчета.Серия 			= Строка.СерияОприходования;
		СтрокаПересчета.Упаковка 		= Строка.ЕдиницаИзмеренияОприходования;
		СтрокаПересчета.КоличествоСтарое= 0.0;
		СтрокаПересчета.КоличествоНовое = Строка.КоличествоОприходования;			
	КонецЦикла;
	
	ТаблицаПересчета.Свернуть("Номенклатура,Характеристика,Серия,Упаковка", "КоличествоСтарое,КоличествоНовое");
	ТаблицаПересчета.Сортировать("Номенклатура,Характеристика,Серия");
	
КонецФункции

//	Получить серию товара по номеру или создать новую
Функция ПолучитьСериюПоНомеру(СерийныйНомер, Товар, ВидНоменклатуры)
	Если НЕ ЗначениеЗаполнено(СерийныйНомер) Тогда
		Возврат Справочники.СерииНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	
	СерияСсылка = Справочники.СерииНоменклатуры.НайтиПоРеквизиту("Номер", СерийныйНомер,, ВидНоменклатуры);
	Если СерияСсылка.Пустая() Тогда
		Серия = Справочники.СерииНоменклатуры.СоздатьЭлемент();
		Серия.ВидНоменклатуры 	= ВидНоменклатуры;
		Серия.Наименование 		= СерийныйНомер;
		Серия.Номер 			= СерийныйНомер;
		Серия.Записать();
		СерияСсылка = Серия.Ссылка;
	КонецЕсли;
	
	Возврат СерияСсылка;
КонецФункции

