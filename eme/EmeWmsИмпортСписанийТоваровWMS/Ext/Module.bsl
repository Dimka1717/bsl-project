//	Создать или изменить документ списания недостач товаров
Процедура СоздатьИзменитьДокументСписанияНедостачТоваров(Параметры)  
	
	СписаниеСсылка = НайтиДокументСписанияТоваров(Параметры.ИдЕМЕ);
	Если СписаниеСсылка.Пустая() Тогда
		Списание = Документы.СписаниеТоваров.СоздатьДокумент();
		Списание.Дата 			   = ТекущаяДата();
		Списание.Склад 			   = Параметры.СкладСсылка;
		Списание.Организация 	   = Параметры.ОрганизацияСсылка;
		Списание.Подразделение 	   = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.СкладСсылка, "Подразделение");
		Списание.Комментарий 	   = "Создан на основании документа списания EME: " +
			Параметры.НомерЕМЕ + " (" + Параметры.ERPData.header.comment + ")";
		Списание.ОтражатьВБухгалтерскомУчете = Истина;
		Списание.ОтражатьВУправленческомУчете = Истина;
		
		// Вид деятельности	
		//EmeWmsДрайвер.ЗаполнитьВидДеятельностиНДС(Списание);
	Иначе
		Списание = СписаниеСсылка.ПолучитьОбъект();
		Списание.Комментарий = "Документ скорректирован на основании документа списания EME: " +
			Параметры.НомерЕМЕ + " (" + Параметры.ERPData.header.comment + ")";
	КонецЕсли;    
	
	EmeWmsУтилиты.СкорректироватьТабличнуюЧасть(Списание, Параметры.КартаТоваровСписания, Истина);	  
	EmeWmsДрайвер.ЗаполнитьСтатусыУказанияСерий(Списание, Документы.СписаниеТоваров);
	
	//	Валюта регламентированного учета
	мВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	мВалютаУпрУчета    		= глЗначениеПеременной("ВалютаУправленческогоУчета");
	СтруктураКурса     		= МодульВалютногоУчета.ПолучитьКурсВалюты(мВалютаУпрУчета, Списание.Дата);
	мКурсУпрУчета      		= СтруктураКурса.Курс;
	мКратностьУпрУчета 		= СтруктураКурса.Кратность;
	мТекущийСтатусПартии 	= Перечисления.СтатусыПартийТоваров.Купленный;
	Качество 		   		= Справочники.Качество.Новый;
	СпособЗаполненияЦен 	= Перечисления.СпособыЗаполненияЦен.ПоЦенамНоменклатуры;
	УчитыватьНДС 		    = Списание.ОтражатьВБухгалтерскомУчете;

	// 	Установим цены в документе по виду цены
	ТипЦен = Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("Плановая цена"); 
	ВалютаЦены			 = ТипЦен.ВалютаЦены;
	ЦенаВключаетНДС		 = ТипЦен.ЦенаВключаетНДС;
	
	// Если есть цена и тип цен, но нет валюты, тогда в качестве валюты документа возьмем валюту регламентированного учета.
	ВалютаДокумента    = мВалютаРегламентированногоУчета;
	КурсДокумента      = 1;
	КратностьДокумента = 1;

	//	Рассчитываем реквизиты табличной части.
	Для каждого СтрокаТовара из Списание.Товары Цикл
		СтрокаТовара.Качество = Качество;

		Цена = Ценообразование.ПолучитьЦенуНоменклатуры(СтрокаТовара.Номенклатура, СтрокаТовара.ХарактеристикаНоменклатуры,
										ТипЦен, Списание.Дата, СтрокаТовара.ЕдиницаИзмерения,
										ВалютаДокумента, КурсДокумента, КратностьДокумента, , Неопределено, Неопределено);

		//	Пересчитаем цену в валюту документа.
		Цена = Ценообразование.ПересчитатьЦенуПриИзмененииВалюты(Цена, ВалютаЦены, мВалютаУпрУчета, мКурсУпрУчета, мКратностьУпрУчета, Списание.Дата);

		//	В документе цена со всеми налогами
		СуммаВключаетНДС = Истина;

		//	Получим ставки из справочника.
		СтавкаНДС = УчетНДС.ПолучитьСтавкуНДС(СтрокаТовара.Номенклатура.СтавкаНДС);

		СтрокаТовара.Цена = Ценообразование.ПересчитатьЦенуПриИзмененииФлаговНалогов(Цена,
		                                                 СпособЗаполненияЦен,
		                                                 ЦенаВключаетНДС,
		                                                 УчитыватьНДС,
		                                                 СуммаВключаетНДС,
		                                                 СтавкаНДС);

		// 	Отладка: Установим цена = 1 руб., при нулевой цене документ не проводится
		Если СтрокаТовара.Цена = 0 Тогда			
			СтрокаТовара.Цена = 1;			
		КонецЕсли;   
		
		//	Рассчитываем реквизиты табличной части.
		ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуМестТабЧасти(СтрокаТовара, Списание, Ложь);
		СтрокаТовара.Коэффициент = СтрокаТовара.ЕдиницаИзмерения.Коэффициент;
		
		ОбработкаТабличныхЧастей.ЗаполнитьПроцентРозничнойНаценкиТабЧасти(СтрокаТовара, Списание);
		ОбработкаТабличныхЧастей.РассчитатьРозничнуюЦенуТабЧасти(СтрокаТовара, Списание, мВалютаРегламентированногоУчета);
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаТовара, Списание);
		
		СтрокаТовара.Сумма	   = МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(СтрокаТовара.Сумма, мВалютаУпрУчета, 
													 мВалютаРегламентированногоУчета, мКурсУпрУчета, 1, мКратностьУпрУчета, 1);
								
		Если НЕ ЗначениеЗаполнено(СтрокаТовара.Качество) Тогда
			ОбработкаТабличныхЧастей.ЗаполнитьКачествоНоменклатурыТабЧасти(СтрокаТовара, Списание);
		КонецЕсли;
	КонецЦикла;	
	
	Списание.Записать(РежимЗаписиДокумента.Запись);  

	Если Параметры.ИмпортироватьМаркиЧЗ Тогда
		//	Добавляем марки в ТЧ ШтрихкодыУпаковок документа списание товаров
		ПараметрыМарок = Новый Структура;
		ПараметрыМарок.Вставить("ERPData",		Параметры.ERPData);
		ПараметрыМарок.Вставить("ЗаказОбъект",	Списание);
		ПолучитьТаблицуМарокСписанных(ПараметрыМарок);
		
		Списание.ШтрихкодыУпаковок.Очистить(); 
		ДобавитьМаркиВТЧШтрихкодыУпаковок(Списание.ШтрихкодыУпаковок, ПараметрыМарок.ТаблицаМарок);
		Списание.Записать(РежимЗаписиДокумента.Запись); 
	КонецЕсли;        	
	
	ОтменитьЭкспортСписанияТоваров(Списание.Ссылка);
	СоздатьОтметкуОбИмпортеДокументаСписанияТоваров(Списание.Ссылка, Параметры.ИдЕМЕ);
	EmeWmsПроведениеДокументов.ПометитьДокументКПроведению(Списание.Ссылка);  
	
КонецПроцедуры

// Создает новый или корректирует найденный по ID EME документ Оприходования излищков товаров
Функция СоздатьИзменитьДокументОприходованияТоваров(Параметры)
	
	ОприходованиеСсылка = НайтиДокументОприходованияТоваров(Параметры.ИдЕМЕ);
	Если ОприходованиеСсылка.Пустая() Тогда
		Оприходование 			      = Документы.ОприходованиеТоваров.СоздатьДокумент();
		Оприходование.Дата 		      = ТекущаяДата();
		Оприходование.Склад 	      = Параметры.СкладСсылка;
		Оприходование.Организация     = Параметры.ОрганизацияСсылка;
		Оприходование.Подразделение   = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.СкладСсылка, "Подразделение");
		Оприходование.ОтражатьВУправленческомУчете = Истина;
		Оприходование.ОтражатьВБухгалтерскомУчете  = Истина;
		Оприходование.ВидОперации	  = Перечисления.ВидыОперацийОприходованиеТоваров.ОприходованиеТоваров;
		Оприходование.Излишек		  = 1;
		Оприходование.КоррСчет   	  = ПланыСчетов.Хозрасчетный.ПрочиеДоходы;  
    	Оприходование.Субконто1		  = Справочники.ПрочиеДоходыИРасходы.НайтиПоКоду("0360"); //Меркурий
		Оприходование.КоррСчетНУ 	  = ПланыСчетов.Налоговый.ВнереализационныеДоходы;
		Оприходование.Комментарий     = "Создан на основании документа списания/оприходования EME: " +
			Параметры.НомерЕМЕ + " (" + Параметры.ИдЕМЕ + ")" + " (" + Параметры.ERPData.header.comment + ")"; 		
		//Оприходование.СтатьяДоходов = ПланыВидовХарактеристик.СтатьиДоходов.НайтиПоНаименованию("Внереализационные доходы");
		//Оприходование.АналитикаДоходов = ОрганизацияСсылка;
	Иначе
		Оприходование = ОприходованиеСсылка.ПолучитьОбъект();
		Оприходование.Комментарий = "Документ скорректирован на основании документа списания/оприходования EME: " +
			Параметры.НомерЕМЕ + " (" + Параметры.ИдЕМЕ + ")" + " (" + Параметры.ERPData.header.comment + ")";
	КонецЕсли;

	//	Корерктировка табличной части
	EmeWmsУтилиты.СкорректироватьТабличнуюЧасть(Оприходование, Параметры.КартаТоваровОприходования, Истина);

	//	Валюта регламентированного учета
	мВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	мВалютаУпрУчета    		= глЗначениеПеременной("ВалютаУправленческогоУчета");
	СтруктураКурса     		= МодульВалютногоУчета.ПолучитьКурсВалюты(мВалютаУпрУчета, Оприходование.Дата);
	мКурсУпрУчета      		= СтруктураКурса.Курс;
	мКратностьУпрУчета 		= СтруктураКурса.Кратность;
	мТекущийСтатусПартии 	= Перечисления.СтатусыПартийТоваров.Купленный;
	Качество 		   		= Справочники.Качество.Новый;
	СпособЗаполненияЦен 	= Перечисления.СпособыЗаполненияЦен.ПоЦенамНоменклатуры;
	УчитыватьНДС 		    = Оприходование.ОтражатьВБухгалтерскомУчете;

	// 	Установим цены в документе по виду цены
	ТипЦен = Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("Плановая цена"); 
	Оприходование.ТипЦен = ТипЦен; 
	ВалютаЦены			 = ТипЦен.ВалютаЦены;
	ЦенаВключаетНДС		 = ТипЦен.ЦенаВключаетНДС;
	
	// Если есть цена и тип цен, но нет валюты, тогда в качестве валюты документа возьмем валюту регламентированного учета.
	ВалютаДокумента    = мВалютаРегламентированногоУчета;
	КурсДокумента      = 1;
	КратностьДокумента = 1;

	//	Рассчитываем реквизиты табличной части.
	Для каждого СтрокаТовара из Оприходование.Товары Цикл
		СтрокаТовара.Качество = Качество;

		Цена = Ценообразование.ПолучитьЦенуНоменклатуры(СтрокаТовара.Номенклатура, СтрокаТовара.ХарактеристикаНоменклатуры,
										ТипЦен, Оприходование.Дата, СтрокаТовара.ЕдиницаИзмерения,
										ВалютаДокумента, КурсДокумента, КратностьДокумента, , Неопределено, Неопределено);

		//	Пересчитаем цену в валюту документа.
		Цена = Ценообразование.ПересчитатьЦенуПриИзмененииВалюты(Цена, ВалютаЦены, мВалютаУпрУчета, мКурсУпрУчета, мКратностьУпрУчета, Оприходование.Дата);

		//	В документе цена со всеми налогами
		СуммаВключаетНДС = Истина;

		//	Получим ставки из справочника.
		СтавкаНДС = УчетНДС.ПолучитьСтавкуНДС(СтрокаТовара.Номенклатура.СтавкаНДС);

		СтрокаТовара.Цена = Ценообразование.ПересчитатьЦенуПриИзмененииФлаговНалогов(Цена,
		                                                 СпособЗаполненияЦен,
		                                                 ЦенаВключаетНДС,
		                                                 УчитыватьНДС,
		                                                 СуммаВключаетНДС,
		                                                 СтавкаНДС);

		// 	Отладка: Установим цена = 1 руб., при нулевой цене документ не проводится
		Если СтрокаТовара.Цена = 0 Тогда			
			СтрокаТовара.Цена = 1;			
		КонецЕсли;   
		
		//	Рассчитываем реквизиты табличной части.
		ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуМестТабЧасти(СтрокаТовара, Оприходование, Ложь);
		СтрокаТовара.Коэффициент = СтрокаТовара.ЕдиницаИзмерения.Коэффициент;
		
		ОбработкаТабличныхЧастей.ЗаполнитьПроцентРозничнойНаценкиТабЧасти(СтрокаТовара, Оприходование);
		ОбработкаТабличныхЧастей.РассчитатьРозничнуюЦенуТабЧасти(СтрокаТовара, Оприходование, мВалютаРегламентированногоУчета);
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаТовара, Оприходование);
		
		СтрокаТовара.СуммаРегл    = МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(СтрокаТовара.Сумма, мВалютаУпрУчета, 
													 мВалютаРегламентированногоУчета, мКурсУпрУчета, 1, мКратностьУпрУчета, 1);
								
		СтрокаТовара.СуммаНУ 	  = СтрокаТовара.СуммаРегл;
		СтрокаТовара.СуммаВР 	  = 0;
		СтрокаТовара.СуммаПР 	  = 0;
		СтрокаТовара.СтатусПартии = мТекущийСтатусПартии;

		Если НЕ ЗначениеЗаполнено(СтрокаТовара.Качество) Тогда
			ОбработкаТабличныхЧастей.ЗаполнитьКачествоНоменклатурыТабЧасти(СтрокаТовара, Оприходование);
		КонецЕсли;
	КонецЦикла;	
	
	Оприходование.Записать(РежимЗаписиДокумента.Запись);
	
	СоздатьОтметкуОбИмпортеДокументаОприходованияИзлишковТоваров(Оприходование.Ссылка, Параметры.ИдЕМЕ);
	EmeWmsПроведениеДокументов.ПометитьДокументКПроведению(Оприходование.Ссылка);         
	
	Возврат Оприходование.Ссылка;
КонецФункции


//	Создать или изменить документ пересортица товаров
Процедура СоздатьИзменитьДокументПересортицаТоваров(Параметры)
	
	ПересортицаТоваровСсылка = НайтиДокументПересортицаТоваров(Параметры.ИдЕМЕ);
	Если ПересортицаТоваровСсылка.Пустая() Тогда
		РеквизитыДокумента = Новый Структура;
		РеквизитыДокумента.Вставить("Дата", 				 ТекущаяДата());
		РеквизитыДокумента.Вставить("Склад", 				 Параметры.СкладСсылка);
		РеквизитыДокумента.Вставить("Организация", 			 Параметры.ОрганизацияСсылка);
		РеквизитыДокумента.Вставить("ХозяйственнаяОперация", Перечисления.ХозяйственныеОперации.ПересортицаТоваров);
		РеквизитыДокумента.Вставить("Подразделение", 
										ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.СкладСсылка,"Подразделение"));
		РеквизитыДокумента.Вставить("СтатьяДоходов",  ПланыВидовХарактеристик.СтатьиДоходов.НайтиПоНаименованию("Излишки"));
		//РеквизитыДокумента.Вставить("АналитикаДоходов", Пересортица.Подразделение);
		РеквизитыДокумента.Вставить("СтатьяРасходов", ПланыВидовХарактеристик.СтатьиРасходов.НайтиПоНаименованию("АкТ Списания"));
		//РеквизитыДокумента.Вставить("АналитикаРасходов", Пересортица.Подразделение);
		РеквизитыДокумента.Вставить("ПриходоватьТоварыПоСебестоимостиСписания", Истина);

		РеквизитыДокумента.Вставить("Комментарий", "Создан на основании документа списания EME " + Параметры.НомерЕМЕ);
		
		Пересортица = Документы.ПересортицаТоваров.СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(Пересортица, РеквизитыДокумента);
		
		// Вид деятельности	
		EmeWmsДрайвер.ЗаполнитьВидДеятельностиНДС(Пересортица);
	Иначе
		Пересортица = ПересортицаТоваровСсылка.ПолучитьОбъект();
		
		Комментарий = НСтр("ru='Документ скорректирован на основании Ордера на отражение пересортицы по списанию EME: %1 (%2)'");				
		Пересортица.Комментарий = "Скорректирован на основании документа EME " + Параметры.НомерЕМЕ;
		
		Пересортица.Товары.Очистить();		
	КонецЕсли;
	
	Если НЕ Параметры.ИспользоватьОрдернуюСхему Тогда
		Пересортица.ПересчетТоваров = Параметры.ПересчетТоваровСсылка; 
	КонецЕсли;

	Для каждого Строка из Параметры.ТаблицаПересорта Цикл
		НоваяСтрока = Пересортица.Товары.Добавить();  
		
		НоваяСтрока.Номенклатура 			  = Строка.ТоварСписания;
		НоваяСтрока.Серия 					  = Строка.СерияСписания;
		НоваяСтрока.Характеристика 			  = Строка.ХарактеристикаСписания;
		НоваяСтрока.Количество 				  = Строка.КоличествоСписания;
		
		НоваяСтрока.НоменклатураОприходование = Строка.ТоварОприходования;
		НоваяСтрока.СерияОприходование 		  = Строка.СерияОприходования;
		НоваяСтрока.ХарактеристикаОприходование = Строка.ХарактеристикаОприходования;
	КонецЦикла;
		
	// Цены в документе по виду цены
	Пересортица.ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию("!Закупочные");
	// Валюта
	Пересортица.Валюта  = EmeWmsДрайвер.ПолучитьВалютуУправленческогоУчета(Пересортица.ВидЦены);
	EmeWmsДрайвер.ЗаполнитьЦеныПоВидуЦен(Пересортица);
	
	// Отладка: Установим цена = 1 руб., при нулевой цене документ не проводится
	Для каждого Строка из Пересортица.Товары Цикл
		Если Строка.Цена = 0 Тогда
			Строка.Цена = 1;
		КонецЕсли;
	КонецЦикла;
		
	EmeWmsДрайвер.ЗаполнитьСтатусыУказанияСерий(Пересортица, Документы.ПересортицаТоваров);	
	
	Пересортица.Записать(РежимЗаписиДокумента.Запись);
	
	СоздатьОтметкуОбИмпортеДокументаПересортицаТоваров(Пересортица.Ссылка, Параметры.ИдЕМЕ);
	EmeWmsПроведениеДокументов.ПометитьДокументКПроведению(Пересортица.Ссылка);
	
КонецПроцедуры

#КонецОбласти

#Область СозданиеОтметокОбИмпорте

//	Создает в регистре пометку об импорте документа Вывод из оборота ИС МП с номером в EME
Процедура СоздатьОтметкуОбИмпортеДокументаВыводИзОборотаИСМП(Документ, ИдЕМЕ)
	
	НаборЗаписей = РегистрыСведений.EmeWmsОтметкиОбИмпортеВыводИзОборотаИСМП.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Ссылка.Установить(Документ.Ссылка);
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл
		Запись.ДатаИмпорта = ТекущаяДата();
		НаборЗаписей.Записать();
		Возврат;
	КонецЦикла;
	
  	НоваяЗапись = РегистрыСведений.EmeWmsОтметкиОбИмпортеВыводИзОборотаИСМП.СоздатьМенеджерЗаписи();
	НоваяЗапись.ID = ИдЕМЕ;
	НоваяЗапись.Ссылка = Документ.Ссылка;
	НоваяЗапись.ДатаИмпорта = ТекущаяДата();
    НоваяЗапись.Записать();   
	
 КонецПроцедуры

