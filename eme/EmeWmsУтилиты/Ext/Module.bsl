		// Создаем новую Серию
		Серия = Справочники.СерииНоменклатуры.СоздатьЭлемент();
		Серия.Владелец			= ТоварСсылка;
		Серия.Наименование 		= СерийныйНомер;
		Серия.СерийныйНомер 	= СерийныйНомер;
		Серия.СрокГодности		= ДатаГодности;
		Серия.Записать();
		
		Возврат Серия.Ссылка;   		
	КонецЕсли;	

	Возврат Справочники.СерииНоменклатуры.ПустаяСсылка();

КонецФункции   

// #IBS 21.03.2025 Ширяев Получить серию товара по наименованию или создать новую
// Серия подчинена номенклатуре в УТ10.3
Функция ПолучитьСериюПоНаименованию(НаименованиеСерии, ТоварСсылка, СоздаватьСерии = Ложь) Экспорт   

	Если НЕ ЗначениеЗаполнено(НаименованиеСерии) Тогда
		Возврат Справочники.СерииНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	
	// Поиск Серии по Номеру серии и Дате производства
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СерииНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|ГДЕ
	|	СерииНоменклатуры.Наименование = &Наименование И
	|	СерииНоменклатуры.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Наименование",	НаименованиеСерии);
	Запрос.УстановитьПараметр("Владелец", 		ТоварСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();	
	Если НЕ РезультатЗапроса.Пустой() Тогда		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий(); 
		
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Если СоздаватьСерии Тогда 
		// Создаем новую Серию
		Серия = Справочники.СерииНоменклатуры.СоздатьЭлемент();
		Серия.Владелец			= ТоварСсылка;
		Серия.Наименование 		= НаименованиеСерии;
		Серия.Записать();
		
		Возврат Серия.Ссылка;   		
	КонецЕсли;	

	Возврат Справочники.СерииНоменклатуры.ПустаяСсылка();

КонецФункции   


