//	#IBS 07.02.2024 Функция возвращает код EME по ссылке на склад
Функция ПолучитьКодСкладаEMEПоСсылке(СкладСсылка, ОрганизацияСсылка = Неопределено, СтатусТовара = Неопределено) Экспорт
	Перем Запрос, Выборка;

	Запрос = Новый Запрос();
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Склады.КодСкладаEME КАК КодСклада
		|ИЗ
		|	РегистрСведений.EmeWmsМаппингСкладов КАК Склады
		|ГДЕ
		|	Склады.Склад = &СкладСсылка И
		|	Склады.Сторона1С И
		|	((НЕ Склады.ИспользоватьОрганизации) ИЛИ Склады.Организация = &ОрганизацияСсылка ИЛИ &ПустаяОрганизация) И
		|	((НЕ Склады.ИспользоватьСтатусы) ИЛИ Склады.СтоковыйСтатус = &СтатусТовара ИЛИ &ПустойСтатус)";
	
	Запрос.УстановитьПараметр("СкладСсылка", СкладСсылка);
	Запрос.УстановитьПараметр("ОрганизацияСсылка", ОрганизацияСсылка);
	Запрос.УстановитьПараметр("ПустаяОрганизация", ?(ЗначениеЗаполнено(ОрганизацияСсылка), Ложь, Истина));
	Запрос.УстановитьПараметр("СтатусТовара", СтатусТовара);
	Запрос.УстановитьПараметр("ПустойСтатус", ?(ЗначениеЗаполнено(СтатусТовара), Ложь, Истина));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.КодСклада) Тогда
			Возврат Выборка.КодСклада;
		Иначе
			Возврат неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат неопределено;
КонецФункции

