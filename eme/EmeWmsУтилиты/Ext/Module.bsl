//	Фукнция ПолучитьСерию возвращает ссылку на серию, при необходимости создает её
Функция ПолучитьСерию(ТоварСсылка, ГТДСсылка, СтранаСсылка) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Серия.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СерииНоменклатуры КАК Серия
		|ГДЕ
		|	Серия.Владелец = &ТоварСсылка И
		|	Серия.НомерГТД = &ГТДСсылка И
		|	НЕ Серия.ПометкаУдаления";
	Запрос.УстановитьПараметр("ТоварСсылка", ТоварСсылка);
	Запрос.УстановитьПараметр("ГТДСсылка", ГТДСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Серия = Справочники.СерииНоменклатуры.СоздатьЭлемент();
	Серия.Владелец = ТоварСсылка;
	Серия.НомерГТД = ГТДСсылка;
	Серия.СтранаПроисхождения = СтранаСсылка;
	Серия.Записать();
	Серия.Наименование = Серия.СформироватьНаименование();
	Серия.Записать();
	
	Возврат Серия.Ссылка;
	
КонецФункции

// Получить ссылку на серию номенклатур по номеру серии
