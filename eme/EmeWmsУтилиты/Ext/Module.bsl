		|	Склады.СкладБрака КАК СкладБрака
		|ИЗ
		|	РегистрСведений.EmeWmsМаппингСкладов КАК Склады
		|ГДЕ
		|	Склады.Склад = &СкладСсылка И
		|	Склады.Сторона1С";
	
	Запрос.УстановитьПараметр("СкладСсылка", СкладСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СкладБрака;
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

//	#IBS 07.04.2025 Функция возвращает таблицу серий из документа для номенклатуры и количества (в базовых, из ТЧ Товары)
Функция ПолучитьПодборкуСерийИзДокумента(Документ, НоменклатураСсылка, Количество) Экспорт

	ТаблицаСерий = Новый ТаблицаЗначений;
	ТаблицаСерий.Колонки.Добавить("СерияСсылка");
	ТаблицаСерий.Колонки.Добавить("Количество");
	
	КоличествоОстаток = Количество;
	Для каждого СтрокаТовара из Документ.Товары Цикл
		Если СтрокаТовара.Номенклатура = НоменклатураСсылка Тогда
			Если КоличествоОстаток > 0.0 Тогда
				Если КоличествоОстаток <= СтрокаТовара.Количество Тогда
					СтрокаСерий = ТаблицаСерий.Добавить();
					СтрокаСерий.СерияСсылка = СтрокаТовара.СерияНоменклатуры;
					СтрокаСерий.Количество = КоличествоОстаток;
					Прервать;
				Иначе
					СтрокаСерий = ТаблицаСерий.Добавить();
					СтрокаСерий.СерияСсылка = СтрокаТовара.СерияНоменклатуры;
					СтрокаСерий.Количество = СтрокаТовара.Количество;
					КоличествоОстаток = КоличествоОстаток - СтрокаТовара.Количество;
				КонецЕсли;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;     
	// Если нераспределенное количество по сериями, записать пустое значение
	Если КоличествоОстаток > 0.0 Тогда
		СтрокаСерий = ТаблицаСерий.Добавить();
		СтрокаСерий.СерияСсылка = Неопределено;
		СтрокаСерий.Количество = СтрокаТовара.Количество;
	КонецЕсли;

	ТаблицаСерий.Свернуть.Добавить("СерияСсылка", "Количество");
	
	Возврат ТаблицаСерий;
КонецФункции

//	#IBS 07.04.2025 Процедура заполняет ссылки на серии товара по документу-основанию
Процедура ЗаполнитьСерииТоваровПоДокументуОснованию(ТЧТовары, ДокументОснование) Экспорт

	// Построим общую карту использования серий
	КартаНоменклатур = Новый Соответствие;
	Для каждого СтрокаТовара из ДокументОснование.Товары Цикл
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТовара.Номенклатура, "ВестиУчетПоСериям") Тогда
			ТаблицаСерий = КартаНоменклатур.Получить(СтрокаТовара.Номенклатура);
			Если ТаблицаСерий = Неопределено Тогда
				ТаблицаСерий = Новый ТаблицаЗначений;
				ТаблицаСерий.Колонки.Добавить("СерияСсылка");
				ТаблицаСерий.Колонки.Добавить("Количество");
			КонецЕсли;
			СтрокаСерий = ТаблицаСерий.Добавить();
			СтрокаСерий.СерияСсылка = СтрокаТовара.СерияНоменклатуры;
			СтрокаСерий.Количество = СтрокаТовара.Количество;
		КонецЕсли;
	КонецЦикла;
	
	// Запишем серии в заполняемый документ
	Для каждого СтрокаТовара из ТЧТовары Цикл
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТовара.Номенклатура, "ВестиУчетПоСериям") Тогда
			ТаблицаСерий = КартаНоменклатур.Получить(СтрокаТовара.Номенклатура);
			// Подберем серию (из минимально подходящей по количеству)
			СтрокаСерийПодобранная = Неопределено;
			КоличествоПодобранное = 1000000000;
			Если ТаблицаСерий <> Неопределено Тогда
				Для каждого СтрокаСерий Из ТаблицаСерий Цикл
					Если СтрокаСерий.Количество >= СтрокаТовара.Количество И КоличествоПодобранное > СтрокаСерий.Количество Тогда
						КоличествоПодобранное = СтрокаСерий.Количество;
						СтрокаСерийПодобранная = СтрокаСерий;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			// Запишем подобранную серия
			Если СтрокаСерийПодобранная <> Неопределено Тогда
				СтрокаТовара.СерияНоменклатуры = СтрокаСерийПодобранная.СерияСсылка;
				СтрокаСерийПодобранная.Количество = СтрокаСерийПодобранная.Количество - СтрокаТовара.Количество;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
	
//	#IBS 07.02.2024 Функция возращает ссылку на склад по кодам EME, статус по умолчанию - N
Функция ПолучитьСсылкуНаСкладПоКодуEME(КодСклада, КодЗоны = Неопределено, КодОрганизации = Неопределено, КодСтатуса = "N") Экспорт
	Перем Запрос, Выборка;
	
	Запрос = Новый Запрос();
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Склады.Склад КАК Ссылка
		|ИЗ
		|	РегистрСведений.EmeWmsМаппингСкладов КАК Склады
		|ГДЕ                                  
		| 	Склады.СторонаWMS И 
		|	(Склады.КодСкладаEME = &КодСклада) И
		|	(Склады.КодЗоны = &КодЗоны ИЛИ Склады.ИспользоватьЗоны = ЛОЖЬ) И
		|	(Склады.КодОрганизации = &КодОрганизации ИЛИ Склады.ИспользоватьОрганизации = ЛОЖЬ) И
		|	(Склады.СтоковыйСтатус = &КодСтатуса ИЛИ Склады.ИспользоватьСтатусы = ЛОЖЬ)";
	
	Запрос.УстановитьПараметр("КодСклада", КодСклада);
	Запрос.УстановитьПараметр("КодЗоны", КодЗоны);
	Запрос.УстановитьПараметр("КодОрганизации", КодОрганизации);
	Запрос.УстановитьПараметр("КодСтатуса", КодСтатуса);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Склады.ПустаяСсылка();
КонецФункции

