//	Функция ПолучитьБазовуюЕдиницуИзмерения возращает базовую единицу измерения номенклатуры
Функция ПолучитьБазовуюЕдиницуИзмерения(Знач Номенклатура) Экспорт
	
	Выборка = Справочники.ЕдиницыИзмерения.Выбрать(,Номенклатура);
	Пока Выборка.Следующий() Цикл
		Если Выборка.ПометкаУдаления Тогда
			Продолжить
		КонецЕсли;
		Если Выборка.ЕдиницаПоКлассификатору = Номенклатура.БазоваяЕдиницаИзмерения И Выборка.Коэффициент = 1 Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли
	КонецЦикла;
	
	Выборка = Справочники.ЕдиницыИзмерения.Выбрать(,Номенклатура);
	Пока Выборка.Следующий() Цикл
		Если Выборка.ПометкаУдаления Тогда
			Продолжить
		КонецЕсли;
		Если Выборка.Коэффициент = 1 Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли
	КонецЦикла;
	
	Возврат Справочники.ЕдиницыИзмерения.ПустаяСсылка();
	
КонецФункции

//	Функция ПолучитьСсылкуНаТовар возращает ссылку на товар по его УИД
Функция ПолучитьСсылкуНаТовар(СтрокаУИДТовара) Экспорт
	
	Попытка
		УИД = Новый УникальныйИдентификатор(СтрокаУИДТовара);
		Ссылка = Справочники.Номенклатура.ПолучитьСсылку(УИД);
		Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
			Возврат Справочники.Номенклатура.ПустаяСсылка();
		Иначе
			Возврат Ссылка;
		КонецЕсли
	Исключение
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецПопытки
	
КонецФункции

