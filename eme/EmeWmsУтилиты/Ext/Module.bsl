		Если СписокРассылки = "" Тогда
			Возврат
		КонецЕсли;
		
		МногострочнаяСтрока = СтрЗаменить(СписокРассылки, ";", Символы.ПС);
		Для Счетчик = 1 По СтрЧислоСтрок(МногострочнаяСтрока) Цикл
   			Письмо.Получатели.Добавить(СтрПолучитьСтроку(МногострочнаяСтрока, Счетчик));
		КонецЦикла;

		//	Отправим почтовое сообщение
		Соединение = Новый ИнтернетПочта;
		Попытка
			Профиль = УправлениеЭлектроннойПочтой.ПолучитьИнтернетПочтовыйПрофиль(УчетнаяЗапись);
			
			ПротоколПолученияПочты = ПротоколИнтернетПочты.POP3;
			Если ИспользоватьIMAPПриОтправкеПисем(Профиль) Тогда
				ПротоколПолученияПочты = ПротоколИнтернетПочты.IMAP;
			КонецЕсли;

			ОбрабатыватьТекстСообщения = ОбработкаТекстаИнтернетПочтовогоСообщения.НеОбрабатывать;
			Соединение.Подключиться(Профиль, ПротоколПолученияПочты);
			Сообщить("Подключено");
			Соединение.Послать(Письмо, ОбрабатыватьТекстСообщения, ПротоколИнтернетПочты.SMTP);
			Сообщить("Письма отправлены");
		Исключение
			Сообщить("Не удалось подключиться к серверу");
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
	    
		Соединение.Отключиться();
	    Сообщить("Соединение завершено");
	КонецЕсли
	
КонецПроцедуры

