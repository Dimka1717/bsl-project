//	Сравнение количеств по товарам с сериями в ТЧ товаров с картой товаров
Функция ПроверитьТоварыНаСоответствие(Документ, КартаТоваров) Экспорт
	
	ИспользоватьСерии = Константы.EmeWmsИспользоватьСерии.Получить();
	
    QtyMap = КопироватьСоответствие(КартаТоваров);

    // Расчет разностей по количествам товаров
    Для Каждого СтрДок Из Документ.Товары Цикл
        ТоварСсылка 			= СтрДок.Номенклатура;
		СерияСсылка 			= ?(ИспользоватьСерии, СтрДок.СерияНоменклатуры, Неопределено);
		ХарактеристикаСсылка 	= СтрДок.ХарактеристикаНоменклатуры;
		КлючТовара 				= СоздатьКлючТовара(ТоварСсылка, СерияСсылка, ХарактеристикаСсылка);

		КоличествоДокумента = ПересчетВДругуюЕдиницу(СтрДок.Количество, 
													 СтрДок.ЕдиницаИзмерения, 
													 EmeWmsУтилиты.ПолучитьБазовуюЕдиницуИзмерения(СтрДок.Номенклатура));
			
        Если QtyMap.Получить(КлючТовара) <> Неопределено Тогда
            QtyMap.Вставить(КлючТовара, QtyMap.Получить(КлючТовара) - КоличествоДокумента);
        Иначе
            Если (КоличестваТовараНеРавны(КоличествоДокумента, 0.0)) Тогда
                Возврат Ложь;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    // Проверка на разности количеств товаров
	Для каждого Элемент1 из QtyMap цикл
        Если (КоличестваТовараНеРавны(Элемент1.Значение, 0.0)) Тогда
            Возврат ложь;
        КонецЕсли;
    КонецЦикла;

    Возврат Истина;
КонецФункции

// #IBS 27.04.2023 Сравнить товары в таблице и ТЧ документа по количествам без серий возвращает истина, если ОК
Функция ПроверитьТоварыНаСоответствиеБезСерий(Документ, ТаблицаТоваров) Экспорт
	QtyMap = Новый Соответствие;
	Для каждого СтрокаТовара из ТаблицаТоваров Цикл
		Количество1 = ?(QtyMap.Получить(СтрокаТовара.Номенклатура) = Неопределено, 0.0, QtyMap.Получить(СтрокаТовара.Номенклатура));
		QtyMap.Вставить(СтрокаТовара.Номенклатура, Количество1 + СтрокаТовара.Количество);
	КонецЦикла;
		
	// Расчет разностей по количествам товаров
	Для каждого СтрДок из Документ.Товары цикл
		КлючТовара = СтрДок.Номенклатура;
		Если СтрДок.Упаковка.Пустая() Тогда
			КоличествоДокумента = СтрДок.КоличествоУпаковок;
		Иначе
			КоличествоДокумента = ПересчетВДругуюЕдиницу(СтрДок.КоличествоУпаковок, СтрДок.Упаковка, СтрДок.Номенклатура.ЕдиницаИзмерения);
		КонецЕсли;
        Если QtyMap.Получить(СтрДок.Номенклатура) <> Неопределено Тогда
            // Количество в единицах строки документа приводим к базовой ЕИ
            QtyMap.Вставить(КлючТовара, QtyMap.Получить(КлючТовара) - КоличествоДокумента);
        Иначе
            Если (КоличестваТовараНеРавны(КоличествоДокумента, 0.0)) Тогда
                Возврат Ложь;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    // Проверка на разности количеств товаров
	Для каждого Элемент1 из QtyMap цикл
        Если (КоличестваТовараНеРавны(Элемент1.Значение, 0.0)) Тогда
            Возврат ложь;
        КонецЕсли;
    КонецЦикла;
	
	Возврат Истина;
КонецФункции

// #IBS 15.12.2021 Проверка на неравенство количеств товара с погрешностью
Функция КоличестваТовараНеРавны(Значение1, Значение2)
	Разность = Значение1 - Значение2;
	Если Макс(-Разность, Разность) > 0.000001 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции	

// #IBS 27.04.2023 Создать ключ по товару, серии  и характеристике
Функция СоздатьКлючТовара(ТоварСсылка, СерияСсылка, ХарактеристикаСсылка) Экспорт
	Если ТоварСсылка = Неопределено Тогда
		КлючТовара = "NULL#";
	Иначе		                                    
		Если ТоварСсылка.Пустая() Тогда
			КлючТовара = "NULL#";
		Иначе
			КлючТовара = "" + ТоварСсылка.УникальныйИдентификатор()+"#";
		КонецЕсли;	
	КонецЕсли;	
	
	Если СерияСсылка = Неопределено Тогда
		КлючТовара = КлючТовара + "NULL#";
	Иначе
		Если СерияСсылка.Пустая() Тогда
			КлючТовара = КлючТовара + "NULL#";
		Иначе
			КлючТовара = КлючТовара + СерияСсылка.УникальныйИдентификатор()+"#";
		КонецЕсли;		
	КонецЕсли;		
	
	Если ХарактеристикаСсылка = Неопределено Тогда
		КлючТовара = КлючТовара + "NULL#";
	Иначе
		Если ХарактеристикаСсылка.Пустая() Тогда
			КлючТовара = КлючТовара + "NULL#";
		Иначе
			КлючТовара = КлючТовара + ХарактеристикаСсылка.УникальныйИдентификатор()+"#";
		КонецЕсли;		
	КонецЕсли;		

	Возврат КлючТовара;
КонецФункции	

// #IBS 19.02.2025 Получить карту товаров документа, свернутую по товарам, сериям и характеристикам (для КА1.1)
Функция ПолучитьКартуТоваровДокумента(Документ) Экспорт
	КартаТоваров 	  = Новый Соответствие;
	//ИспользоватьСерии = Константы.EmeWmsИспользоватьСерии.Получить();
	
	Для Каждого СтрокаТЧ из Документ.Товары Цикл
		ТоварСсылка			= СтрокаТЧ.Номенклатура;
		ТоварСерия 			= Неопределено;
		ТоварХарактеристика = Неопределено;
		
		РеквизитыТовара = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТоварСсылка, "ВестиУчетПоСериям, ВестиУчетПоХарактеристикам");
		Если РеквизитыТовара.ВестиУчетПоСериям Тогда
			ТоварСерия = СтрокаТЧ.СерияНоменклатуры;
		ИначеЕсли РеквизитыТовара.ВестиУчетПоХарактеристикам Тогда
			ТоварХарактеристика = СтрокаТЧ.ХарактеристикаНоменклатуры;
		КонецЕсли;                                          
		
		КлючТовара = EmeWmsУтилиты.СоздатьКлючТовара(СтрокаТЧ.Номенклатура, ТоварСерия, ТоварХарактеристика);
		КоличествоПоКарте = ?(КартаТоваров.Получить(КлючТовара) = неопределено, 0.0, КартаТоваров.Получить(КлючТовара));
		КоличествоДокумента = СтрокаТЧ.Количество;
		КартаТоваров.Вставить(КлючТовара, КоличествоПоКарте + КоличествоДокумента);
	КонецЦикла;
	
	Возврат КартаТоваров;
КонецФункции

// #IBS 27.04.2023 Получить карту товаров табличной части документа, свернутую по товарам и сериям (количество плюсом или минусом)
Функция ПолучитьКартуТоваровТЧДокумента(ТЧДокумента, ИнверсияЗнака) Экспорт
	КартаТоваров = Новый Соответствие;
	
	Для Каждого СтрокаТЧ из ТЧДокумента Цикл
		КлючТовара = EmeWmsУтилиты.СоздатьКлючТовара(СтрокаТЧ.Номенклатура, СтрокаТЧ.Серия, СтрокаТЧ.Характеристика);
		КоличествоПоКарте = ?(КартаТоваров.Получить(КлючТовара) = неопределено, 0.0, КартаТоваров.Получить(КлючТовара));
		Если СтрокаТЧ.Упаковка.Пустая() Тогда
			КоличествоДокумента = СтрокаТЧ.КоличествоУпаковок;
		Иначе
			КоличествоДокумента = ПересчетВДругуюЕдиницу(СтрокаТЧ.КоличествоУпаковок, СтрокаТЧ.Упаковка, СтрокаТЧ.Номенклатура.ЕдиницаИзмерения);
		КонецЕсли;
		КартаТоваров.Вставить(КлючТовара, КоличествоПоКарте + ?(ИнверсияЗнака, -КоличествоДокумента, КоличествоДокумента));
	КонецЦикла;
	
	Возврат КартаТоваров;
КонецФункции

// #IBS 28.04.2023 Получить карту товаров табличной части документа, свернутую по товарам и сериям
Функция ПолучитьКартуТоваровИзТЧДокумента(ТЧДокумента) Экспорт
	КартаТоваров = Новый Соответствие;
	
	Для Каждого СтрокаТЧ из ТЧДокумента Цикл
		КлючТовара = EmeWmsУтилиты.СоздатьКлючТовара(СтрокаТЧ.Номенклатура, СтрокаТЧ.Серия, СтрокаТЧ.Характеристика);
		КоличествоПоКарте = ?(КартаТоваров.Получить(КлючТовара) = неопределено, 0.0, КартаТоваров.Получить(КлючТовара));
		Если СтрокаТЧ.Упаковка.Пустая() Тогда
			КоличествоДокумента = СтрокаТЧ.КоличествоУпаковок;
		Иначе
			КоличествоДокумента = ПересчетВДругуюЕдиницу(СтрокаТЧ.КоличествоУпаковок, СтрокаТЧ.Упаковка, СтрокаТЧ.Номенклатура.ЕдиницаИзмерения);
		КонецЕсли;
		КартаТоваров.Вставить(КлючТовара, КоличествоПоКарте + КоличествоДокумента);
	КонецЦикла;
	
	Возврат КартаТоваров;
КонецФункции

// #IBS 28.04.2023 Сравнение количеств по товарам с сериями в ТЧ документа с картой товаров
Функция ПроверитьТоварыНаСоответствиеТЧДокумента(ТЧДокумента, КартаТоваров) Экспорт

    QtyMap = КопироватьСоответствие(КартаТоваров);

    // Расчет разностей по количествам товаров
    Для каждого СтрДок из ТЧДокумента цикл
        ТоварСсылка = 	СтрДок.Номенклатура;
		СерияСсылка = 	СтрДок.Серия;
		ХарактеристикаСсылка = 	СтрДок.Серия;
		КлючТовара = СоздатьКлючТовара(ТоварСсылка, СерияСсылка, ХарактеристикаСсылка);
		Если СтрДок.Упаковка.Пустая() Тогда
			КоличествоДокумента = СтрДок.КоличествоУпаковок;
		Иначе
			КоличествоДокумента = ПересчетВДругуюЕдиницу(СтрДок.КоличествоУпаковок, СтрДок.Упаковка, СтрДок.Номенклатура.ЕдиницаИзмерения);
		КонецЕсли;
		
        Если QtyMap.Получить(КлючТовара) <> Неопределено Тогда
            QtyMap.Вставить(КлючТовара, QtyMap.Получить(КлючТовара) - КоличествоДокумента);
        Иначе
            Если (КоличестваТовараНеРавны(КоличествоДокумента, 0.0)) Тогда
                Возврат Ложь;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    // Проверка на разности количеств товаров
	Для каждого Элемент1 из QtyMap цикл
        Если (КоличестваТовараНеРавны(Элемент1.Значение, 0.0)) Тогда
            Возврат ложь;
        КонецЕсли;
    КонецЦикла;

    Возврат Истина;
КонецФункции

// #IBS 19.10.2023 Сравнение количеств по товарам с сериями в ТЧ отгружаемые товары с картой товаров только по строкам действием Отгрузить
Функция ПроверитьТоварыНаСоответствиеТЧОтгружаемыеТовары(ТЧДокумента, КартаТоваров) Экспорт

