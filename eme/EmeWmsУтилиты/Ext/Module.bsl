// #IBS 22.12.2021 Получить остатки товара на складе из регистра
Функция ПолучитьОстаткиНаСкладе(Склад, ВремяДок, Номенклатура, Характеристика, Серия)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	| ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	| ТоварыНаСкладахОстатки.Характеристика КАК Характеристика,
	| ТоварыНаСкладахОстатки.Серия КАК Серия,
	| СУММА(ЕСТЬNULL(ТоварыНаСкладахОстатки.ВНаличииОстаток, 0)) КАК КоличествоОстаток
	|ИЗ
	| РегистрНакопления.ТоварыНаСкладах.Остатки(&ВремяДока, Склад = &Склад) КАК ТоварыНаСкладахОстатки
	|ГДЕ
	| ТоварыНаСкладахОстатки.Номенклатура = &Номенклатура
	| И ТоварыНаСкладахОстатки.Характеристика = &Характеристика
	| И ТоварыНаСкладахОстатки.Серия = &Серия
	|
	|СГРУППИРОВАТЬ ПО
	| ТоварыНаСкладахОстатки.Номенклатура,
	| ТоварыНаСкладахОстатки.Характеристика,
	| ТоварыНаСкладахОстатки.Серия";

	Запрос.УстановитьПараметр("ВремяДока", ВремяДок);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Запрос.УстановитьПараметр("Серия", Серия);

	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.КоличествоОстаток;
	КонецЦикла;
	
	Возврат 0.0;
	
КонецФункции

// #IBS 17.02.2022 Получить описание различий в списке товаров из документа и из сообщения WMS
// Колонки таблицы: Номенклатура, Серия, КоличествоПоERP, КоличествоПоWMS
Функция ПолучитьОписаниеРазличий(Документ, ТаблицаРазличий) Экспорт
	
	Текст = "Между данными о товарах в документе "+Строка(Документ.Ссылка)+Символы.ПС+
			" и данными по принятым (отгруженным) товарам в EME.WMS имеются следующие различия:"+Символы.ПС+Символы.ПС;
	
	Для каждого стр1 из ТаблицаРазличий цикл
		Текст = Текст + "Для товара " + стр1.Номенклатура.Наименование + " код " + СокрЛП(стр1.Номенклатура.Код) + " Серия " + стр1.Серия + Символы.ПС +
		"Количество по 1С  " + Строка(стр1.КоличествоПоERP) + " " + стр1.ЕдиницаИзмерения.Наименование + Символы.ПС +
		"Количество по WMS " + Строка(стр1.КоличествоПоWMS) + " " + стр1.ЕдиницаИзмерения.Наименование + Символы.ПС + Символы.ПС;
	КонецЦикла;			
	
	Текст = Текст + Символ(13)+"Документ скорректирован.";
	
	Возврат Текст;
	
КонецФункции  

// #IBS 31.03.2023 Получить краткое описание различий в списке товаров из документа и WMS
// Колонки таблицы: Номенклатура, Серия, КоличествоПоERP, КоличествоПоWMS
