// #IBS Новая процедура, простым обходом справочника
Процедура ПометитьВсюНоменклатуруКЭкспорту2() Экспорт
	Перем Счетчик1, Счетчик2, Запрос, Выборка;
	
	Сообщить("Начинаем пометку номенклатуры к экспорту");
	Счетчик1 = 0;
	Счетчик2 = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.ЭтоГруппа КАК ЭтоГруппа
        |ИЗ
        |	Справочник.Номенклатура КАК Номенклатура
        |ГДЕ
		|	НЕ Номенклатура.ПометкаУдаления";
	
	Отбор = новый Структура;
	Отбор.Вставить("ПометкаУдаления", ложь);
	Отбор.Вставить("ЭтоГруппа", истина);
	
	Выборка = Справочники.Номенклатура.ВыбратьИерархически(,,Отбор);
	
	Пока Выборка.Следующий() цикл
		Если НЕ Выборка.ЭтоГруппа Тогда
			Если Не EmeWmsЭкспортНоменклатуры.ПомеченКЭкспорту(Выборка.Ссылка) Тогда
				EmeWmsЭкспортНоменклатуры.ПометитьКЭкспорту(Выборка.Ссылка.ПолучитьОбъект());
				Счетчик2 = Счетчик2 + 1;
				Если Счетчик2%10 = 0 Тогда
					Сообщить("Помечаем к экспорту "+Строка(Счетчик2));
				КонецЕсли
			КонецЕсли
		Иначе
			Если Не EmeWmsЭкспортГруппНоменклатуры.ПомеченКЭкспорту(Выборка.Ссылка) Тогда
				EmeWmsЭкспортГруппНоменклатуры.ПометитьКЭкспорту(Выборка.Ссылка.ПолучитьОбъект());
				Счетчик1 = Счетчик1 + 1;
				Если Счетчик1%10 = 0 Тогда
					Сообщить("Помечаем к экспорту "+Строка(Счетчик1));
				КонецЕсли
			КонецЕсли
		КонецЕсли;
	КонецЦикла;
	Сообщить("Завершили пометку групп номенклатуры к экспорту (" + Счетчик1 + "шт)");
	Сообщить("Завершили пометку номенклатуры к экспорту (" + Счетчик2 + "шт)");
	
КонецПроцедуры

