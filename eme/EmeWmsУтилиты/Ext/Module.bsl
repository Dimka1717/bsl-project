//	Выгрузить остатки товаров в ячейках в csv файл
Функция ОстаткиВЯчейках(Знач ДатаОстатков) Экспорт
	
	ТекДок = Новый ТекстовыйДокумент;
	ТекДок.ДобавитьСтроку("whs_code;cell_no;goods_id;goods_code;lot_id;lot_no;producer_id;producer_code;producer_name;producer_inn;producer_kpp;ipmporter_id;ipmporter_code;importer_name;ipmporter_inn;ipmporter_kpp;country_code;bbd;prd;gtd_reg_no;gtd_line_no;form_a_no;form_b_no;сapacity;alc_volume;quantity;mu_code;pallet_sscc;box_sscc;pdf417;data_matrix;true_sign");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТоварыВЯчейках_ЛАОстаткиИОбороты.Номенклатура КАК Номенклатура,
		|	ТоварыВЯчейках_ЛАОстаткиИОбороты.Номенклатура.Код КАК НоменклатураКод,
		|	ТоварыВЯчейках_ЛАОстаткиИОбороты.Ячейка КАК Ячейка,
		|	ТоварыВЯчейках_ЛАОстаткиИОбороты.Номенклатура.ЕдиницаХраненияОстатков КАК ЕдиницаИзмерения,
		|	ТоварыВЯчейках_ЛАОстаткиИОбороты.КоличествоКонечныйОстаток КАК КонечныйОстаток,
		|	ТоварыВЯчейках_ЛАОстаткиИОбороты.Номенклатура.ЕдиницаХраненияОстатков.ЕдиницаПоКлассификатору.Код КАК ЕдиницаПоКлассификаторуКод
		|ИЗ
		|	РегистрНакопления.ТоварыВЯчейках_ЛА.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Авто, ДвиженияИГраницыПериода, Склад = &Склад) КАК ТоварыВЯчейках_ЛАОстаткиИОбороты
		|ГДЕ
		|	ТоварыВЯчейках_ЛАОстаткиИОбороты.КоличествоКонечныйОстаток > 0";
	
	Запрос.УстановитьПараметр("НачалоПериода", КонецДня(ДатаОстатков));
