Процедура УдалитьСтарыеПометкиКЭкспорту() Экспорт
	
	СписокРеквизитов = Новый ТаблицаЗначений;
	ПолучитьСписокРеквизитовСПометками(СписокРеквизитов);
	НетПометокДляУдаления = Истина;
	Для Каждого Реквизит Из СписокРеквизитов Цикл
		Счетчик = 0;
		Выборка = Реквизит.Реквизит.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.Дата < ДобавитьМесяц(ТекущаяДата(), -1) Тогда
				Выборка.ПолучитьМенеджерЗаписи().Удалить();
				Счетчик = Счетчик + 1;
			КонецЕсли;
		КонецЦикла;
		Если Счетчик <> 0 Тогда
			НетПометокДляУдаления = Ложь;
			Сообщить("Удалено в " + Реквизит.Реквизит + " " + Счетчик + "шт.");
		КонецЕсли
	КонецЦикла;
	Если НетПометокДляУдаления Тогда
		Сообщить("Нет пометок для удаления");
	КонецЕсли
	
КонецПроцедуры

Процедура СтрессТестЭкспортаОстатков() Экспорт
	
	ERPData = Новый Структура;
	EmeWmsERPEngine.Create(ERPData);
	
	// #IBS 01.03.2024 Получить текст файла из регистра настроек
	ERPData.ERPEngine = EmeWmsУтилиты.ПолучитьСодержимоеФайлаНастроек();
	Если ERPData.ERPEngine = Неопределено Или ERPData.ERPEngine = "" Тогда
		Возврат;
	КонецЕсли;
	
	НачалоСтрессТеста = ТекущаяДата();
	Сообщить(НачалоСтрессТеста);
	ВсегоРегистров = 10000;

	Ошибка = EmeWmsERPEngine.Connect(ERPData);
	Если Ошибка <> "" Тогда
		Сообщить(Ошибка);
		ЗаписьЖурналаРегистрации("Экспорт в EME.WMS",,,,"Подключение к SQL базе данных: " + Ошибка);
		Возврат;
	КонецЕсли;
	
	EmeWmsERPEngine.BeginExport(ERPData, "erp", "wms", "remains");
	Попытка
		EmeWmsERPEngine.AppendHeaderLine(ERPData);
		ERPData.header.id			= "TEST" + "." + Формат(ТекущаяДата(), "ДФ=гггг-ММ-дд");
		ERPData.header.whs_code		= "TEST";
		ERPData.header.formed_at	= Формат(КонецДня(ТекущаяДата()), "ДФ=ггггММддЧЧммсс");
		ERPData.header.is_manually	= Истина;
		
		Выборка = Справочники.Номенклатура.Выбрать();
		Выборка.Следующий();
		Номенклатура = Выборка.Ссылка;

		//	Строки по остаткам.
		EmeWmsERPEngine.SelectChild(ERPData, "registers");
		Для Счетчик = 1 По ВсегоРегистров Цикл
			EmeWmsERPEngine.AppendChildLine(ERPData);
			ERPData.registers.id 			= Счетчик;
			ERPData.registers.goods_id		= Номенклатура.УникальныйИдентификатор();
			ERPData.registers.goods_code	= СокрЛП(Номенклатура.Код);
			ERPData.registers.remains_qty	= 1.;
			ERPData.registers.mu_code 		= СокрЛП(EmeWmsУтилиты.ПолучитьБазовуюЕдиницуИзмерения(Номенклатура).ЕдиницаПоКлассификатору.Код);
			ERPData.registers.lot_no		= "-";
			ERPData.registers.vendor_code	= "ORG";
			Если НЕ Выборка.Следующий() Тогда 
				Прервать;
			КонецЕсли;
		КонецЦикла;		

		EmeWmsERPEngine.CommitExport(ERPData);
		
		КонецСтрессТеста = ТекущаяДата();
		Сообщить(КонецСтрессТеста);
		Период = КонецСтрессТеста - НачалоСтрессТеста;
		Сообщить("Остатки проэкспортированы за " + Период + "сек на " + ВсегоРегистров + " регистров");
		
	Исключение
		EmeWmsERPEngine.RollbackExport(ERPData);
		ВызватьИсключение(ОписаниеОшибки());
	КонецПопытки;
	
	EmeWmsERPEngine.Disconnect(ERPData);
	
КонецПроцедуры

