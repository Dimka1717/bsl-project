// #IBS 19.02.2025 Получить или создать характеристику товара по наименованию (для случая подчиненных товару)
Функция ПолучитьХарактеристикуПоНаименованию(ХарактеристикаНаименование, Товар, СоздаватьНовую = ложь) Экспорт
	Если Товар.ВестиУчетПоХарактеристикам Тогда
		ХарактеристикаСсылка = Справочники.ХарактеристикиНоменклатуры.НайтиПоНаименованию(ХарактеристикаНаименование,,, Товар.Ссылка);
		Если СоздаватьНовую И ХарактеристикаСсылка.Пустая() И ХарактеристикаНаименование <> "-" Тогда
			НоваяХарактеристика = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
			НоваяХарактеристика.Владелец = Товар;
			НоваяХарактеристика.Наименование = ХарактеристикаНаименование;
			НоваяХарактеристика.НаименованиеПолное = ХарактеристикаНаименование;
			НоваяХарактеристика.Активная = Истина;
			НоваяХарактеристика.Записать();
			ХарактеристикаСсылка = НоваяХарактеристика.Ссылка;
		КонецЕсли;
	Иначе
		ХарактеристикаСсылка = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ХарактеристикаСсылка;
КонецФункции

// #IBS 03.10.2023 Преобразовать ШК марки ЧЗ в вид без скобок
// например "(01)04670042690437(21).fdTiA;VjC.Y5" в "010467004269043721.fdTiA;VjC.Y5"
// Префикс 01 + 14 символов GTIN + 21 + 13 символов уникальный серийный номер. Криптохвост в WMS не нужен
// Если (01) и (21) нет на месте, код не меняется.
Функция КодМаркиВЗначениеБезСкобок(СтрокаКода) Экспорт
	Если Лев(СтрокаКода, 4) <> "(01)" ИЛИ Сред(СтрокаКода, 19, 4) <> "(21)" Тогда
		Возврат СтрокаКода;
	КонецЕсли;
	
	// Составим строку с идентификаторами без скобок
	Возврат "01" + Сред(СтрокаКода, 5, 14) + "21" + Сред(СтрокаКода, 23, 13);
КонецФункции

// #IBS 06.02.2025 Преобразовать ШК марки короба в вид без префикса (00)
// например "(00)046100639901265873" в "046100639901265873"
// Длиной 18 символов - в соответствии с форматом кода SSCC для WMS
// Если (00) нет на месте, код не меняется.
Функция КодМаркиКоробаВЗначениеБезСкобок(СтрокаКода) Экспорт
	Если Лев(СтрокаКода, 4) = "(00)" Тогда
		Возврат Сред(СтрокаКода, 5);
	Иначе
		Возврат СтрокаКода;
	КонецЕсли;
	
КонецФункции

// #IBS 03.10.2023 Преобразовать ШК марки ЧЗ в вид со скобками, 
// например "010467004269043721.fdTiA;VjC.Y5" в "(01)04670042690437(21).fdTiA;VjC.Y5"
//           1234567890123456789                 12345678901234567890123
// Префикс 01 + 14 символов GTIN + 21 + 13 символов уникальный серийный номер. Криптохвост в WMS не нужен
// Если (01) и (21) нет на месте, код не меняется.
Функция КодМаркиВЗначениеСоСкобками(СтрокаКода) Экспорт
	// #IBS 27.02.2025 Клиент просит значение без скобок
	Возврат СтрокаКода;
	
	Если Лев(СтрокаКода, 2) <> "01" ИЛИ Сред(СтрокаКода, 17, 2) <> "21" Тогда
		Возврат СтрокаКода;
	КонецЕсли;
	
	// Составим строку с идентификаторами со скобками
	Возврат "(01)" + Сред(СтрокаКода, 3, 14) + "(21)" + Сред(СтрокаКода, 19, 13);
КонецФункции

