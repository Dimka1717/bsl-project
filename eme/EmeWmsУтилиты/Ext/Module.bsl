//	Функция НоменклатураРазрешенаКОбмену возвращает истину, если номенклатура учитывается на складах: товар, тара или комплект
Функция НоменклатураРазрешенаКОбмену(Номенклатура) Экспорт
	Если Номенклатура = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Номенклатура.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВидНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ВидНоменклатуры");
	ТипНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидНоменклатуры, "ТипНоменклатуры");
	Если ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар	ИЛИ
		ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Комплект ИЛИ
		ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Набор Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат ложь
КонецФункции

//	Фукнция ПолучитьГТД возвращает ссылку на ГТД, при необходимости создает её
Функция ПолучитьГТД(НомерГТД) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НомераГТД.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.НомераГТД КАК НомераГТД
		|ГДЕ
		|	НомераГТД.Код = &НомерГТД И
		|	НЕ НомераГТД.ПометкаУдаления";
	Запрос.УстановитьПараметр("НомерГТД", НомерГТД);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	ГТД = Справочники.НомераГТД.СоздатьЭлемент();
	ГТД.Код = НомерГТД;
	ГТД.Записать();
	
	Возврат ГТД.Ссылка;
	
КонецФункции

//	Фукнция ПолучитьСтрану возвращает ссылку на страну
