// #IBS Ширяев 14.02.2025 Функция возвращает УИД товара в системе Меридиан, иди если нет, его собственный УИД.
Функция УИДМеридиан(ТоварСсылка) Экспорт
	ВнешнийУИД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТоварСсылка, "Ссылка_медидиан");
	Если НЕ ЗначениеЗаполнено(ВнешнийУИД) Тогда
		ВнешнийУИД = ТоварСсылка.УникальныйИдентификатор();
	Иначе                                      
	 	ПозицияКода = Найти(ВнешнийУИД, "?ref=");
		Если ПозицияКода > 0 Тогда
			ВнешнийУИД = Сред(ВнешнийУИД, ПозицияКода + 5);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВнешнийУИД;
КонецФункции

//	Продукция маркируемая для ГИСМ
Функция ПродукцияМаркируемаяДляГИСМ(Знач ТоварСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ТоварСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТоварСсылка, "Ссылка_медидиан")) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;  
	
КонецФункции
