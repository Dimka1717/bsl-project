// #IBS 22.12.2021 Возвращает пустую строку, если остатки достаточны (сравнение со строками скорректированного, но незаписанного документа)
Функция ПроверитьВозможностьПроведенияРеализации(ДокументОбъект) Экспорт
	Перем стр1;
	
	Для каждого стр1 из ДокументОбъект.Товары Цикл
		КоличествоОстаток = ПолучитьОстаткиНаСкладе(ДокументОбъект.Склад, ДокументОбъект.МоментВремени(), 
													стр1.Номенклатура, стр1.Характеристика, стр1.Серия);
		КоличествоНужно = стр1.Количество * стр1.Коэффициент;
		Если КоличествоНужно > КоличествоОстаток Тогда
			Возврат "" + ДокументОбъект.Ссылка + " " + стр1.Номенклатура + ": нужно "+КоличествоНужно + " остаток " + КоличествоОстаток;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
КонецФункции

