    // Расчет разностей по количествам товаров
    Для каждого СтрДок из ТЧДокумента цикл
 		Если СтрДок.Действие = Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.Отгрузить Тогда
	       	ТоварСсылка = 	СтрДок.Номенклатура;
			СерияСсылка = 	СтрДок.Серия;
			ХарактеристикаСсылка = 	СтрДок.Серия;
			КлючТовара = СоздатьКлючТовара(ТоварСсылка, СерияСсылка, ХарактеристикаСсылка);
			Если СтрДок.Упаковка.Пустая() Тогда
				КоличествоДокумента = СтрДок.КоличествоУпаковок;
			Иначе
				КоличествоДокумента = ПересчетВДругуюЕдиницу(СтрДок.КоличествоУпаковок, СтрДок.Упаковка, СтрДок.Номенклатура.ЕдиницаИзмерения);
			КонецЕсли;
			
	        Если QtyMap.Получить(КлючТовара) <> Неопределено Тогда
	            QtyMap.Вставить(КлючТовара, QtyMap.Получить(КлючТовара) - КоличествоДокумента);
	        Иначе
	            Если (КоличестваТовараНеРавны(КоличествоДокумента, 0.0)) Тогда
	                Возврат Ложь;
	            КонецЕсли;
	        КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    // Проверка на разности количеств товаров
	Для каждого Элемент1 из QtyMap цикл
        Если (КоличестваТовараНеРавны(Элемент1.Значение, 0.0)) Тогда
            Возврат ложь;
        КонецЕсли;
    КонецЦикла;

    Возврат Истина;
КонецФункции

// #IBS 11.05.2023 Получить таблицу различий количеств товара по двух картам
Функция ПолучитьТаблицуРазличий(КартаТоваровДокумента, КартаТоваров) Экспорт
	ТаблицаРазличий = Новый ТаблицаЗначений;
	ТаблицаРазличий.Колонки.Добавить("Номенклатура");
	ТаблицаРазличий.Колонки.Добавить("Серия");
	ТаблицаРазличий.Колонки.Добавить("Характеристика");
	ТаблицаРазличий.Колонки.Добавить("ЕдиницаИзмерения");
	ТаблицаРазличий.Колонки.Добавить("КоличествоПоERP");
	ТаблицаРазличий.Колонки.Добавить("КоличествоПоWMS");
	ТоварСсылка 			= Неопределено;
	СерияСсылка 			= Неопределено;
	ХарактеристикаСсылка 	= Неопределено;

	Для Каждого Элемент1 Из КартаТоваровДокумента Цикл
		КоличествоПоWMS = КартаТоваров.Получить(Элемент1.Ключ);
		РазобратьКлючНаСсылки(Элемент1.Ключ, ТоварСсылка, СерияСсылка, ХарактеристикаСсылка);
		
		Если КоличествоПоWMS <> Неопределено Тогда
			Если Элемент1.Значение <> КоличествоПоWMS Тогда
				Строка = ТаблицаРазличий.Добавить();  
				Строка.Номенклатура 	= ТоварСсылка;
				Строка.Серия 			= СерияСсылка;
				Строка.Характеристика 	= ХарактеристикаСсылка;
				Строка.ЕдиницаИзмерения = Строка.Номенклатура.БазоваяЕдиницаИзмерения;
				Строка.КоличествоПоERP 	= Элемент1.Значение;
				Строка.КоличествоПоWMS 	= КоличествоПоWMS;
			КонецЕсли;
		Иначе
			Строка = ТаблицаРазличий.Добавить();  
			Строка.Номенклатура 		= ТоварСсылка;
			Строка.Серия 				= СерияСсылка;
			Строка.Характеристика 		= ХарактеристикаСсылка;
			Строка.ЕдиницаИзмерения 	= Строка.Номенклатура.БазоваяЕдиницаИзмерения;
			Строка.КоличествоПоERP 		= Элемент1.Значение;
			Строка.КоличествоПоWMS 		= 0.0;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Элемент1 Из КартаТоваров Цикл
		КоличествоПоERP = КартаТоваровДокумента.Получить(Элемент1.Ключ);
		Если КоличествоПоERP = Неопределено Тогда
			РазобратьКлючНаСсылки(Элемент1.Ключ, ТоварСсылка, СерияСсылка, ХарактеристикаСсылка);
			Строка 						= ТаблицаРазличий.Добавить();
			Строка.Номенклатура 		= ТоварСсылка;
			Строка.Серия 				= СерияСсылка;
			Строка.Характеристика 		= ХарактеристикаСсылка;
			Строка.ЕдиницаИзмерения 	= Строка.Номенклатура.БазоваяЕдиницаИзмерения;
			Строка.КоличествоПоERP 		= 0.0;
			Строка.КоличествоПоWMS 		= Элемент1.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаРазличий;
КонецФункции

// #IBS 15.12.2021 ДополнитьСтрокуПробелами
Функция ДополнитьСтрокуПробелами(Строка, ПолнаяДлина)
	Счетчик1 = ПолнаяДлина - СтрДлина(Строка);
	Пока Счетчик1 > 0 Цикл
		Строка = Строка + Символы.НПП;		
		Счетчик1 = Счетчик1 - 1;
	КонецЦикла;
	
	Возврат Строка;
КонецФункции	

// #IBS 19.02.2025 Пересчет количеств товара из одной единицы в другую (для КА1.1)
Функция ПересчетВДругуюЕдиницу(Количество, Единица1, Единица2) Экспорт
	Если Единица1.Пустая() ИЛИ Единица2.Пустая() Тогда
		Возврат неопределено; // Ошибка
	КонецЕсли; 
	
	Если Единица1 = Единица2 Тогда
		Возврат Количество;
	КонецЕсли;
	
	// #IBS 19.02.2025 Если ссылка на классификатор - то это пересчет в базовую или из базовой (код 868, 796), берем коэффициент 1
	Если ТипЗнч(Единица1) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		Коэффициент1 = 1.0;
	Иначе
		Коэффициент1 = Единица1.Коэффициент; 
	КонецЕсли;
	
	Если ТипЗнч(Единица2) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		Коэффициент2 = 1.0;
	Иначе
    	Коэффициент2 = Единица2.Коэффициент;
	КонецЕсли;

    Если Коэффициент2 <> 0.0 Тогда
        Возврат (Количество * Коэффициент1) / Коэффициент2;
    Иначе
        Возврат Количество; // #IBS 18.10.2023 есть кривые единицы штук, чтобы не было ошибки исключения
    КонецЕсли;
КонецФункции

// #IBS 01.02.2024 Пересчет количеств товара из Единицыв1 в базовую Единицу2
Функция ПересчетВБазовуюЕдиницу(Количество, Единица1, Единица2) Экспорт
	Если Единица1.Пустая() ИЛИ Единица2.Пустая() Тогда
		Возврат неопределено; // Ошибка
	КонецЕсли; 
	
	// Если единица не меняется, количество тоже.
	Если Единица1 = Единица2 Тогда
		Возврат Количество;
	КонецЕсли;
	
   	Коэффициент1 = ?(Единица1.Знаменатель = 0, Единица1.Числитель, Единица1.Числитель/Единица1.Знаменатель);

	// Для базовой по умолчанию коэффициент = 1
	Коэффициент2 = 1.0;

    Если Коэффициент2 <> 0.0 Тогда
        Возврат (Количество * Коэффициент1) / Коэффициент2;
    Иначе
        Возврат Количество; // На случай кривизны без коэффициента
    КонецЕсли;
КонецФункции

Функция КопироватьСоответствие(Карта1) Экспорт
    Карта2 = Новый Соответствие;
	Для каждого Элемент1 из Карта1 цикл
    	Карта2.Вставить(Элемент1.Ключ, Элемент1.Значение);
	КонецЦикла;

	Возврат Карта2;
КонецФункции

//	Изменить количества в строках документа сообразно карте количеств товаров
//	Карта товаров имеет составной ключ UID товара + UID серии
Процедура СкорректироватьТабличнуюЧасть(Документ, КартаТоваров, УдалятьСтроки = Истина) Экспорт
             
    QtyMap 				= КопироватьСоответствие(КартаТоваров);
	КартаЦен 			= Новый Соответствие;
	КартаУдалений 		= Новый Соответствие;
	ТабЧасть 			= Документ.Метаданные().ТабличныеЧасти.Найти("Товары");
    ЕстьУпаковки 		= ТабЧасть <> Неопределено И ТабЧасть.Реквизиты.Найти("ЕдиницаИзмеренияМест") <> Неопределено;  
	ЕстьСумма	 		= ТабЧасть <> Неопределено И ТабЧасть.Реквизиты.Найти("Сумма") <> Неопределено;
	ЕстьСуммаНДС 		= ТабЧасть <> Неопределено И ТабЧасть.Реквизиты.Найти("СуммаНДС") <> Неопределено;	
	ТоварСсылка 		= Неопределено;
	СерияСсылка 		= Неопределено;
	ХарактеристикаСсылка = Неопределено;
	ТипЗнчДокумент		= ТипЗнч(Документ);
	НеИзменятьКоличество = Ложь;
	
	Если ТипЗнчДокумент = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		Если ЗначениеЗаполнено(Документ.Контрагент) Тогда
			НеИзменятьКоличество = Документ.Контрагент.НеУдалятьКратность;
		КонецЕсли;
	КонецЕсли;    
	
	//	Использование серий в интеграции
	ИспользоватьСерии = Константы.EmeWmsИспользоватьСерии.Получить();	
	
    // Если карта пустая - во все строки кол-во ноль, иначе методы MAP дают ошибку
	Если QtyMap.Количество() = 0 Тогда 
		Для Каждого СтрокаТовара Из Документ.Товары Цикл 
			Если НеИзменятьКоличество Тогда
				СтрокаТовара.EmeWmsКорректировка = Истина;
			Иначе			
	            СтрокаТовара.Количество = 0.0;
			КонецЕсли;
		КонецЦикла;
    Иначе
        // Минимальное кол-во записываем в строку документа и вычитаем из карты.
        Для Каждого СтрокаТовара Из Документ.Товары Цикл
            ТоварСсылка			 = СтрокаТовара.Номенклатура;
			СерияСсылка			 = ?(ИспользоватьСерии, СтрокаТовара.СерияНоменклатуры, Неопределено);
			ХарактеристикаСсылка = СтрокаТовара.ХарактеристикаНоменклатуры;
			// + #COA Чепиков 21.02.2025 количество с учетом коэффициента в строке документа
			//КартаЦен.Вставить(СтрокаТовара.Номенклатура, ПолучитьЦенуСтроки(ТипЗнчДокумент, СтрокаТовара));
			Коэффициент 		 = ?(СтрокаТовара.Коэффициент > 0, СтрокаТовара.Коэффициент, 1);			
			КартаЦен.Вставить(СтрокаТовара.Номенклатура, ПолучитьЦенуСтроки(ТипЗнчДокумент, СтрокаТовара)/Коэффициент);			
			// - 						
			КлючТовара			 = СоздатьКлючТовара(ТоварСсылка, СерияСсылка, ХарактеристикаСсылка);
			Если QtyMap.Получить(КлючТовара) <> Неопределено Тогда
				// +
                //МинКол = Мин(СтрокаТовара.Количество, QtyMap.Получить(КлючТовара));
				КолвоЕИ = Цел(QtyMap.Получить(КлючТовара)/Коэффициент);				
                МинКол = Мин(СтрокаТовара.Количество, КолвоЕИ);        				
				// -
                НовоеКоличество = МинКол;
				Если СтрокаТовара.Количество <> НовоеКоличество Тогда
					Если НеИзменятьКоличество Тогда
						СтрокаТовара.EmeWmsКорректировка = Истина;
					Иначе
                		СтрокаТовара.Количество = НовоеКоличество;
					КонецЕсли;
					// +
					//Если ЕстьУпаковки Тогда
					//	Если СтрокаТовара.ЕдиницаИзмеренияМест.Пустая() Тогда
					//		КоличествоУпаковок = СтрокаТовара.Количество;
					//	Иначе
					//		КоличествоУпаковок = ПересчетВДругуюЕдиницу(СтрокаТовара.Количество, 
					//													СтрокаТовара.ЕдиницаИзмерения,
					//													СтрокаТовара.ЕдиницаИзмеренияМест);
					//	КонецЕсли;
					//	СтрокаТовара.КоличествоМест = КоличествоУпаковок;
					//КонецЕсли;
					ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(СтрокаТовара, Документ);					
					// - 
					ПриИзмененииКоличестваТовары(СтрокаТовара, Документ, ЕстьУпаковки, ЕстьСумма, ЕстьСуммаНДС);
				КонецЕсли;
				// +
                //QtyMap.Вставить(КлючТовара, QtyMap.Получить(КлючТовара) - МинКол);
                QtyMap.Вставить(КлючТовара, QtyMap.Получить(КлючТовара) - МинКол*Коэффициент);				
				// -
			Иначе   
				Если НеИзменятьКоличество Тогда
					СтрокаТовара.EmeWmsКорректировка = Истина;					
				Иначе				
	                СтрокаТовара.Количество = 0.0;
				КонецЕсли;
				ПриИзмененииКоличестваТовары(СтрокаТовара, Документ, ЕстьУпаковки, ЕстьСумма, ЕстьСуммаНДС);
			КонецЕсли;
			Если СтрокаТовара.Количество = 0.0 Тогда 
				КартаУдалений.Вставить(СтрокаТовара, СтрокаТовара);
            КонецЕсли;
        КонецЦикла;

        // Добавляем остаточные количества из карты в строку документа. Обнуляем кол-во в карте.
        Для Каждого СтрокаТовара Из Документ.Товары Цикл
            ТоварСсылка 		 = СтрокаТовара.Номенклатура;
			СерияСсылка 		 = ?(ИспользоватьСерии, СтрокаТовара.СерияНоменклатуры, Неопределено);
			ХарактеристикаСсылка = СтрокаТовара.ХарактеристикаНоменклатуры;
			КлючТовара 			 = СоздатьКлючТовара(ТоварСсылка, СерияСсылка, ХарактеристикаСсылка);
            КоличествоПоКарте 	 = ?(QtyMap.Получить(КлючТовара) = Неопределено, 0.0, QtyMap.Получить(КлючТовара));
			// +
			//Если КоличествоПоКарте > 0.0000001 Тогда
			//    НовоеКоличество = КоличествоПоКарте;
			Коэффициент 		 = ?(СтрокаТовара.Коэффициент > 0, СтрокаТовара.Коэффициент, 1);			
			КолвоЕИ 			 = Цел(КоличествоПоКарте/Коэффициент); 
			Если КолвоЕИ > 0.0000001 Тогда				
                НовоеКоличество = КолвоЕИ;
			// -			           
				Если НеИзменятьКоличество Тогда
					СтрокаТовара.EmeWmsКорректировка = Истина;
				Иначе				
	                СтрокаТовара.Количество = СтрокаТовара.Количество + НовоеКоличество;
				КонецЕсли;
			
				// +
				//Если ЕстьУпаковки Тогда
				//	Если СтрокаТовара.ЕдиницаИзмеренияМест.Пустая() Тогда
				//		КоличествоУпаковок = СтрокаТовара.Количество;
				//	Иначе
				//		КоличествоУпаковок = ПересчетВДругуюЕдиницу(СтрокаТовара.Количество, 
				//													СтрокаТовара.ЕдиницаИзмерения,
				//													СтрокаТовара.ЕдиницаИзмеренияМест);
				//	КонецЕсли;
				//   	СтрокаТовара.КоличествоМест = КоличествоУпаковок;
				//КонецЕсли;
				ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(СтрокаТовара, Документ);				
				// -
				ПриИзмененииКоличестваТовары(СтрокаТовара, Документ, ЕстьУпаковки, ЕстьСумма, ЕстьСуммаНДС);
				// +
				//QtyMap.Вставить(КлючТовара, 0.0);
                QtyMap.Вставить(КлючТовара, КоличествоПоКарте - НовоеКоличество*Коэффициент);				
				// -
            КонецЕсли;
		КонецЦикла;
		
		Если НеИзменятьКоличество Тогда		
			Возврат;
		КонецЕсли;
		
        // Бежим по карте. Для ненулевых кол-во добавляем новые строки.
		ТЧТовары = Документ.Товары;
        Для Каждого Элемент1 Из QtyMap Цикл
            КоличествоПоКарте= Элемент1.Значение;
			РазобратьКлючНаСсылки(Элемент1.Ключ, ТоварСсылка, СерияСсылка, ХарактеристикаСсылка);
            Если (НЕ ТоварСсылка.Пустая()) И (КоличествоПоКарте > 0.0000001) Тогда
                // Добавить новую строку для товара, которого не было в документе
				СтрокаТовара = ТЧТовары.Добавить();
				СтрокаТовара.Номенклатура 				= ТоварСсылка;
				// +
				СтрокаТовара.ЕдиницаИзмерения 			= ПолучитьБазовуюЕдиницуИзмерения(ТоварСсылка);
				СтрокаТовара.Коэффициент 				= СтрокаТовара.ЕдиницаИзмерения.Коэффициент;
				// -
				ПриИзмененииНоменклатурыСтрокиТЧ(СтрокаТовара, Документ); // Вызывать только до записи серий и количеств!
                СтрокаТовара.СерияНоменклатуры 			= СерияСсылка;
                СтрокаТовара.ХарактеристикаНоменклатуры = ХарактеристикаСсылка;
                СтрокаТовара.Количество 				= КоличествоПоКарте;
				// +
				//Если ЕстьУпаковки Тогда
				//	Если СтрокаТовара.ЕдиницаИзмеренияМест.Пустая() Тогда
				//		КоличествоУпаковок = СтрокаТовара.Количество;
				//	Иначе
				//		КоличествоУпаковок = ПересчетВДругуюЕдиницу(СтрокаТовара.Количество, 
				//													СтрокаТовара.ЕдиницаИзмерения,
				//													СтрокаТовара.ЕдиницаИзмеренияМест);
				//	КонецЕсли;
				//   	СтрокаТовара.КоличествоМест = КоличествоУпаковок;
				//КонецЕсли;
				//СтрокаТовара.ЕдиницаИзмеренияМест 		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТоварСсылка, "ЕдиницаИзмеренияМест");
				ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(СтрокаТовара, Документ);									
				// -
				УстановитьЦенуСтроки(Документ, СтрокаТовара, КартаЦен.Получить(ТоварСсылка));
				ПриИзмененииКоличестваТовары(СтрокаТовара, Документ, ЕстьУпаковки, ЕстьСумма, ЕстьСуммаНДС);
            КонецЕсли;
		КонецЦикла;
		
		// Корректно удалить строки с количеством ноль
		Если УдалятьСтроки Тогда
			Для каждого Элемент1 из КартаУдалений Цикл
				Документ.Товары.Удалить(Элемент1.Значение);
			КонецЦикла;		
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// #IBS 19.02.2025 Изменить количества в строках ТЧ документа сообразно карте количеств товаров (для КА1.1)
// Карта товаров имеет составной ключ UID товара + UID серии + UID характеристики
Процедура СкорректироватьТЧДокумента(ТЧДокумента, КартаТоваров, УдалятьСтроки = Истина, ЕстьУпаковки = Истина) Экспорт
             
	//	Использование серий в интеграции
	ИспользоватьСерии 	 = Константы.EmeWmsИспользоватьСерии.Получить();	
	
	QtyMap = КопироватьСоответствие(КартаТоваров);
	КартаУдалений 		 = Новый Соответствие; 
	ТоварСсылка 		 = Неопределено;
	СерияСсылка 		 = Неопределено;
	ХарактеристикаСсылка = Неопределено;
	
    // Если карта пустая - во все строки кол-во ноль, иначе методы MAP дают ошибку
    Если QtyMap.Количество() = 0 Тогда
        Для каждого СтрокаТовара из ТЧДокумента Цикл 
            СтрокаТовара.Количество = 0.0; 
        КонецЦикла;
    Иначе
        // Минимальное кол-во записываем в строку документа и вычитаем из карты.
        Для каждого СтрокаТовара из ТЧДокумента цикл
            ТоварСсылка = СтрокаТовара.Номенклатура;
			СерияСсылка = ?(ИспользоватьСерии, СтрокаТовара.СерияНоменклатуры, Неопределено);
			ХарактеристикаСсылка = 	СтрокаТовара.ХарактеристикаНоменклатуры;
			КлючТовара = СоздатьКлючТовара(ТоварСсылка, СерияСсылка, ХарактеристикаСсылка);
            Если QtyMap.Получить(КлючТовара) <> неопределено Тогда
                МинКол = Мин(СтрокаТовара.Количество, QtyMap.Получить(КлючТовара));
                НовоеКоличество = МинКол;
				Если СтрокаТовара.Количество <> НовоеКоличество Тогда
                	СтрокаТовара.Количество = НовоеКоличество;
					Если ЕстьУпаковки Тогда
						Если СтрокаТовара.ЕдиницаИзмеренияМест.Пустая() Тогда
							КоличествоУпаковок = СтрокаТовара.Количество;
						Иначе
							КоличествоУпаковок = ПересчетВДругуюЕдиницу(СтрокаТовара.Количество, СтрокаТовара.ЕдиницаИзмерения, СтрокаТовара.ЕдиницаИзмеренияМест);
						КонецЕсли;
	                	СтрокаТовара.КоличествоМест = КоличествоУпаковок;
					КонецЕсли;
				КонецЕсли;
                QtyMap.Вставить(КлючТовара, QtyMap.Получить(КлючТовара) - МинКол);
            Иначе
                СтрокаТовара.Количество = 0.0;
			КонецЕсли;
			Если СтрокаТовара.Количество = 0.0 Тогда 
				КартаУдалений.Вставить(СтрокаТовара, СтрокаТовара);
            КонецЕсли;
        КонецЦикла;

        // Добавляем остаточные количества из карты в строку документа. Обнуляем кол-во в карте.
        Для каждого СтрокаТовара из ТЧДокумента цикл
            ТоварСсылка = СтрокаТовара.Номенклатура;
			СерияСсылка = ?(ИспользоватьСерии, СтрокаТовара.СерияНоменклатуры, Неопределено);
			ХарактеристикаСсылка = 	СтрокаТовара.ХарактеристикаНоменклатуры;
			КлючТовара = СоздатьКлючТовара(ТоварСсылка, СерияСсылка, ХарактеристикаСсылка);
            КоличествоПоКарте = ?(QtyMap.Получить(КлючТовара) = неопределено, 0.0, QtyMap.Получить(КлючТовара));
            Если КоличествоПоКарте > 0.0000001 Тогда
                НовоеКоличество = КоличествоПоКарте;
                СтрокаТовара.Количество = СтрокаТовара.Количество + НовоеКоличество;
				Если ЕстьУпаковки Тогда
					Если СтрокаТовара.ЕдиницаИзмеренияМест.Пустая() Тогда
						КоличествоУпаковок = СтрокаТовара.Количество;
					Иначе
						КоличествоУпаковок = ПересчетВДругуюЕдиницу(СтрокаТовара.Количество, СтрокаТовара.ЕдиницаИзмерения, СтрокаТовара.ЕдиницаИзмеренияМест);
					КонецЕсли;
	               	СтрокаТовара.КоличествоМест = КоличествоУпаковок;
				КонецЕсли;
                QtyMap.Вставить(КлючТовара, 0.0);
            КонецЕсли;
		КонецЦикла;

        // Бежим по карте. Для ненулевых кол-во добавляем новые строки.
        Для каждого Элемент1 из QtyMap Цикл
            КоличествоПоКарте= Элемент1.Значение;    
			РазобратьКлючНаСсылки(Элемент1.Ключ, ТоварСсылка, СерияСсылка, ХарактеристикаСсылка);
            Если (НЕ ТоварСсылка.Пустая()) И (КоличествоПоКарте > 0.0000001) Тогда
                // Добавить новую строку для товара, которого не было в документе
				СтрокаТовара = ТЧДокумента.Добавить();
				СтрокаТовара.Номенклатура = ТоварСсылка;
                СтрокаТовара.СерияНоменклатуры = СерияСсылка;
                СтрокаТовара.ХарактеристикаНоменклатуры = ХарактеристикаСсылка;
                СтрокаТовара.Количество = КоличествоПоКарте;
                СтрокаТовара.ЕдиницаИзмерения = ТоварСсылка.ЕдиницаХраненияОстатков;
				Если ЕстьУпаковки Тогда
					Если СтрокаТовара.ЕдиницаИзмеренияМест.Пустая() Тогда
						КоличествоУпаковок = СтрокаТовара.Количество;
					Иначе
						КоличествоУпаковок = ПересчетВДругуюЕдиницу(СтрокаТовара.Количество, СтрокаТовара.ЕдиницаИзмерения, СтрокаТовара.ЕдиницаИзмеренияМест);
					КонецЕсли;
	               	СтрокаТовара.КоличествоМест = КоличествоУпаковок;
				КонецЕсли;
            КонецЕсли;
		КонецЦикла;
		
		// Корректно удалить строки с количеством ноль
		Если УдалятьСтроки Тогда
			Для каждого Элемент1 из КартаУдалений Цикл
				ТЧДокумента.Удалить(Элемент1.Значение);
			КонецЦикла;		
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// #IBS Ширяев 25.04.2024 Заполнить поле КоличествоФакт по строкам ТЧ по EmeWmsУИДСтроки из карты количеств
//	Возвращает нераспределенный остаток (ошибка) или неопределено
Функция ЗаполнитьКоличестваФактПоСтрокамТЧ(ТЧТовары, КартаСтрок) Экспорт
	Для каждого СтрокаТЧ из ТЧТовары Цикл
		КлючСтроки = СтрокаТЧ.EmeWmsУИДСтроки;
		СтрокаТЧ.КоличествоФакт = ?(КартаСтрок.Получить(КлючСтроки) = неопределено, 0.0, КартаСтрок.Получить(КлючСтроки));
		КартаСтрок.Вставить(КлючСтроки, 0.0);
	КонецЦикла;
	
	// Проверки остатка распределения
	ОписаниеОшибки = Неопределено;
    Для каждого Элемент1 из КартаСтрок Цикл
		Если Элемент1.Значение > 0.0 Тогда
			ОписаниеОшибки = "Нераспределено количество " + Элемент1.Значение + " для строки c УИД = " + Элемент1.Ключ;
			прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат ОписаниеОшибки;
КонецФункции
	
// #IBS 21.03.2025 Декомпозиция ключа товара на ссылки
Процедура РазобратьКлючНаСсылки(Ключ, ТоварСсылка, СерияСсылка, ХарактеристикаСсылка) Экспорт
	МассивКлючей = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(Ключ, "#");  
	ТоварСсылка = ПолучитьСсылкуНаТовар(МассивКлючей[0]);
	СерияСсылка = ПолучитьСсылкуНаСериюНоменклатур(МассивКлючей[1]);
	ХарактеристикаСсылка = 	ПолучитьСсылкуНаХарактеристикуНоменклатур(МассивКлючей[2]);
КонецПроцедуры

// #IBS 038.05.2023 Изменить количества в строках ТЧ Отгружаемые товары расходного ордера без удаления строк, с изменением статуса, по карте количеств товаров
// Карта товаров имеет составной ключ UID товара + UID серии
Процедура СкорректироватьТЧОтгружаемыеТовары(ТЧДокумента, КартаТоваров, УдалятьСтроки = Истина, ЕстьУпаковки = Истина) Экспорт
             
    QtyMap = КопироватьСоответствие(КартаТоваров);
	КартаУдалений = Новый Соответствие; 
	ТаблицаДобавлений = Новый ТаблицаЗначений;
	РазметитьТаблицуДобавлений(ТаблицаДобавлений);
    // Если карта пустая - во все строки кол-во ноль, иначе методы MAP дают ошибку
    Если QtyMap.Количество() = 0 Тогда
		Для каждого СтрокаТовара из ТЧДокумента Цикл   
			СтрокаДобавлений = ТаблицаДобавлений.Добавить();
			СкопироватьСтрокуДобавлений(СтрокаДобавлений, СтрокаТовара);
			СтрокаДобавлений.Действие = Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.НеОтгружать;
			// В ТЧ отгружаемые товары поставить на всех строках действие НеОтгружать
            // СтрокаТовара.Количество = 0.0;
			СтрокаТовара.Действие = Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.НеОтгружать;
        КонецЦикла;
    Иначе
        // Минимальное кол-во записываем в строку документа и вычитаем из карты.
		Для каждого СтрокаТовара из ТЧДокумента цикл
			// #IBS 03.05.2023 по умолчанию для всех строк действие Отрузить
			СтрокаТовара.Действие = Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.Отгрузить;
            ТоварСсылка = СтрокаТовара.Номенклатура;
			СерияСсылка = 	СтрокаТовара.Серия;
			ХарактеристикаСсылка = 	СтрокаТовара.Характеристика;
			КлючТовара = СоздатьКлючТовара(ТоварСсылка, СерияСсылка, ХарактеристикаСсылка);
            Если QtyMap.Получить(КлючТовара) <> неопределено Тогда
                МинКол = Мин(СтрокаТовара.Количество, QtyMap.Получить(КлючТовара));
                НовоеКоличество = МинКол;     
				
				// #IBS 03.05.2023 Делить строку
				Если СтрокаТовара.Количество > НовоеКоличество Тогда
					СтрокаДобавлений = ТаблицаДобавлений.Добавить();
					СкопироватьСтрокуДобавлений(СтрокаДобавлений, СтрокаТовара);
					СтрокаДобавлений.Количество = СтрокаТовара.Количество - НовоеКоличество;
					Если СтрокаДобавлений.Упаковка.Пустая() Тогда
						КоличествоУпаковок = СтрокаДобавлений.Количество;
					Иначе
						КоличествоУпаковок = ПересчетВДругуюЕдиницу(СтрокаДобавлений.Количество, СтрокаДобавлений.Номенклатура.ЕдиницаИзмерения, СтрокаДобавлений.Упаковка);
					КонецЕсли;
                	СтрокаДобавлений.КоличествоУпаковок = КоличествоУпаковок;
				КонецЕсли;          
				
				Если СтрокаТовара.Количество <> НовоеКоличество Тогда
                	СтрокаТовара.Количество = НовоеКоличество;
					Если ЕстьУпаковки Тогда
						Если СтрокаТовара.Упаковка.Пустая() Тогда
							КоличествоУпаковок = СтрокаТовара.Количество;
						Иначе
							КоличествоУпаковок = ПересчетВДругуюЕдиницу(СтрокаТовара.Количество, СтрокаТовара.Номенклатура.ЕдиницаИзмерения, СтрокаТовара.Упаковка);
						КонецЕсли;
	                	СтрокаТовара.КоличествоУпаковок = КоличествоУпаковок;
					КонецЕсли;
				КонецЕсли;
                QtyMap.Вставить(КлючТовара, QtyMap.Получить(КлючТовара) - МинКол);
            Иначе
				СтрокаДобавлений = ТаблицаДобавлений.Добавить();
				СкопироватьСтрокуДобавлений(СтрокаДобавлений, СтрокаТовара);
				СтрокаДобавлений.Действие = Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.НеОтгружать;
                СтрокаТовара.Количество = 0.0;
			КонецЕсли;
			Если СтрокаТовара.Количество = 0.0 Тогда 
				КартаУдалений.Вставить(СтрокаТовара, СтрокаТовара);
            КонецЕсли;
        КонецЦикла;

        // Добавляем остаточные количества из карты в строку документа. Обнуляем кол-во в карте.
        Для каждого СтрокаТовара из ТЧДокумента цикл
            ТоварСсылка = СтрокаТовара.Номенклатура;
			СерияСсылка = 	СтрокаТовара.Серия;
			ХарактеристикаСсылка = 	СтрокаТовара.Характеристика;
			КлючТовара = СоздатьКлючТовара(ТоварСсылка, СерияСсылка, ХарактеристикаСсылка);
            КоличествоПоКарте = ?(QtyMap.Получить(КлючТовара) = неопределено, 0.0, QtyMap.Получить(КлючТовара));
            Если КоличествоПоКарте > 0.0000001 Тогда
                НовоеКоличество = КоличествоПоКарте;
                СтрокаТовара.Количество = СтрокаТовара.Количество + НовоеКоличество;
				Если ЕстьУпаковки Тогда
					Если СтрокаТовара.Упаковка.Пустая() Тогда
						КоличествоУпаковок = СтрокаТовара.Количество;
					Иначе
						КоличествоУпаковок = ПересчетВДругуюЕдиницу(СтрокаТовара.Количество, СтрокаТовара.Номенклатура.ЕдиницаИзмерения, СтрокаТовара.Упаковка);
					КонецЕсли;
	               	СтрокаТовара.КоличествоУпаковок = КоличествоУпаковок;
				КонецЕсли;
                QtyMap.Вставить(КлючТовара, 0.0);
            КонецЕсли;
		КонецЦикла;

        // Бежим по карте. Для ненулевых кол-во добавляем новые строки.
        Для каждого Элемент1 из QtyMap Цикл
            КоличествоПоКарте= Элемент1.Значение;
			РазобратьКлючНаСсылки(Элемент1.Ключ, ТоварСсылка, СерияСсылка, ХарактеристикаСсылка);
            Если (НЕ ТоварСсылка.Пустая()) И (КоличествоПоКарте > 0.0000001) Тогда
                // Добавить новую строку для товара, которого не было в документе
				СтрокаТовара = ТЧДокумента.Добавить();
				СтрокаТовара.Номенклатура = ТоварСсылка;
                СтрокаТовара.Серия = СерияСсылка;
                СтрокаТовара.Характеристика = ХарактеристикаСсылка;
                СтрокаТовара.Количество = КоличествоПоКарте;                                      
				// #IBS 03.05.2023 
				СтрокаТовара.Действие = Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.Отгрузить;
				Если ЕстьУпаковки Тогда
					Если СтрокаТовара.Упаковка.Пустая() Тогда
						КоличествоУпаковок = СтрокаТовара.Количество;
					Иначе
						КоличествоУпаковок = ПересчетВДругуюЕдиницу(СтрокаТовара.Количество, СтрокаТовара.Номенклатура.ЕдиницаИзмерения, СтрокаТовара.Упаковка);
					КонецЕсли;
	               	СтрокаТовара.КоличествоУпаковок = КоличествоУпаковок;
				КонецЕсли;
            КонецЕсли;
		КонецЦикла;
		
		// Корректно удалить строки с количеством ноль
		Если УдалятьСтроки Тогда
			Для каждого Элемент1 из КартаУдалений Цикл
				ТЧДокумента.Удалить(Элемент1.Значение);
			КонецЦикла;		
		КонецЕсли;
		
		// #IBS 03.05.2023 добавить строки со статусом НеОтгружать
		Для каждого СтрокаДобавлений из ТаблицаДобавлений Цикл  
			СтрокаТовара = ТЧДокумента.Добавить();
			СкопироватьСтрокуДобавлений(СтрокаТовара, СтрокаДобавлений);
		КонецЦикла;		
	КонецЕсли;
КонецПроцедуры

Процедура РазметитьТаблицуДобавлений(ТаблицаДобавлений)
	ТаблицаДобавлений.Колонки.Добавить("Номенклатура");
	ТаблицаДобавлений.Колонки.Добавить("Характеристика");
	ТаблицаДобавлений.Колонки.Добавить("Назначение");
	ТаблицаДобавлений.Колонки.Добавить("Серия");
	ТаблицаДобавлений.Колонки.Добавить("СтатусУказанияСерий");
	ТаблицаДобавлений.Колонки.Добавить("Упаковка");
	ТаблицаДобавлений.Колонки.Добавить("Количество");
	ТаблицаДобавлений.Колонки.Добавить("КоличествоУпаковок");
	ТаблицаДобавлений.Колонки.Добавить("Действие");
КонецПроцедуры 

Процедура СкопироватьСтрокуДобавлений(СтрокаДобавлений, СтрокаТЧ)
	СтрокаДобавлений.Номенклатура = СтрокаТЧ.Номенклатура;
	СтрокаДобавлений.Характеристика = СтрокаТЧ.Характеристика;
