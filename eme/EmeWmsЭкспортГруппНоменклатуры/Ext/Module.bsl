//	$Номенклатура
//	Выгрузка данных о группах номенклатуры
//	- В 1C при записи группа номенклатуры помечается к экспорту.
//	- 1С (авт.) экспортирует сообщение CLASSIFIER.
//	- EME.WMS (авт.) импортирует сообщение CLASSIFIER.
//	- EME.WMS (руч.) создает или изменяет группу товаров.

#Область ПрограммныйИнтерфейс  

//	Процедура Экспортировать экспортирует один элемент группы
Процедура Экспортировать(ERPData, Товар) Экспорт
	
	EmeWmsERPEngine.AppendHeaderLine(ERPData);
	ERPData.header.classifier_id = Товар.УникальныйИдентификатор();
	Если Константы.EmeWmsСоздаватьУникальныеСообщения.Получить() Тогда
		ERPData.header.id	= Новый УникальныйИдентификатор;
	Иначе
		ERPData.header.id	= ERPData.header.classifier_id;		
	КонецЕсли;
	
	ERPData.header.parent_id		= ?(ЗначениеЗаполнено(Товар.Родитель), Товар.Родитель.УникальныйИдентификатор(),"");
	ERPData.header.code				= СокрЛП(Товар.Код);
	ERPData.header.name				= Товар.Наименование;
	ERPData.header.classifier		= ПолучитьПолныйПуть(Товар, Ложь);
	ERPData.header.error_code		= ""; 	
	ERPData.header.error_more		= ""; 	

КонецПроцедуры

