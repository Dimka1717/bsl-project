Функция ПолучитьИмяСообщения() Экспорт
	Возврат "classifier";
КонецФункции

//	Функция ПолучитьМетаданные возвращает метаданные сообщения
Функция ПолучитьМетаданные() Экспорт
	Возврат Метаданные.Справочники.Номенклатура;
КонецФункции

#КонецОбласти  

#Область ЭкспортныеСлужебныеПроцедурыИФункции  

//	Функция ПолучитьВыборкуСсылок возвращает выборку ссылок для экспорта
Функция ПолучитьВыборкуСсылок() Экспорт
    Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	EmeWmsПометкиКЭкспортуНоменклатуры.Номенклатура КАК Ссылка
		|ИЗ
		|	РегистрСведений.EmeWmsПометкиКЭкспортуНоменклатуры КАК EmeWmsПометкиКЭкспортуНоменклатуры
		|ГДЕ
		|	EmeWmsПометкиКЭкспортуНоменклатуры.КЭкспорту";
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выбрать();
КонецФункции

//	Функция РазрешенКЭкспорту возвращает Истина, если это группа, не помеченная к удалению и не услуги
Функция РазрешенКЭкспорту(Товар) Экспорт
	
	Если Товар.ПометкаУдаления Тогда
		РазрешенЭкспорт = ПроверитьПодчиненныеТовары(Товар);
		
		Если Не РазрешенЭкспорт Тогда
			ОтменитьЭкспорт(Товар);				
		КонецЕсли;
		
		Возврат РазрешенЭкспорт;
	КонецЕсли;

	Если НЕ Товар.ЭтоГруппа Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;
	
КонецФункции

//	#IBS 2021 24.05.2021 Функция РазрешенКЭкспорту возвращает Истина, если товар разрешен к экспорту
Функция ТоварыГруппыРазрешеныКЭкспорту(ТоварСсылка) Экспорт
	
	НаборЗаписей = РегистрыСведений.EmeWmsПометкиКЭкспортуНоменклатуры.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Номенклатура.Установить(ТоварСсылка);
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл
		Возврат Запись.РазрешенКЭкспорту;
	КонецЦикла;
	
	Возврат ложь;
	
КонецФункции      

//	#IBS Ширяев 12.03.2025 Функция проверяет, есть ли в группе материальный товар (УТ10.3)
//	Не услуга и не работа - это не хранится на складе WMS
Функция ВГруппеЕстьМатериальныйТовар(ГруппаСсылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка
        |ИЗ
        |	Справочник.Номенклатура КАК Номенклатура
        |ГДЕ Номенклатура.Ссылка В ИЕРАРХИИ(&Группа)
		|И (НЕ Номенклатура.ЭтоГруппа)
		|И (НЕ Номенклатура.ПометкаУдаления)";
		
	Запрос.УстановитьПараметр("Группа", ГруппаСсылка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл  
		ТоварСсылка = Выборка.Ссылка;
		ВидНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.Ссылка, "ВидНоменклатуры");
		ТипНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидНоменклатуры, "ТипНоменклатуры");
		Если ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Услуга Тогда
			Возврат Истина;
		КонецЕсли;           
		
		Если Не ТоварСсылка.Услуга Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ложь;
	
КонецФункции      

// #IBS 12.03.2025 Установить флаг разрешения товаров группы
Процедура РазрешитьЭкспортТоваровГруппы(Товар, Разрешить) Экспорт
	Перем Запрос, Счетчик;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "Выбрать
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В ИЕРАРХИИ(&ГруппаТовара)";
	Запрос.УстановитьПараметр("ГруппаТовара", Товар.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Разрешить Тогда
			Если НЕ ТоварРазрешенКЭкспорту(Выборка.Ссылка) Тогда
				РазрешитьЭкспорт(Выборка.Ссылка);	
			КонецЕсли;
		Иначе
			Если ТоварРазрешенКЭкспорту(Выборка.Ссылка) Тогда
				ЗапретитьЭкспорт(Выборка.Ссылка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	// Также группы родительской иерарархии разрешить
	Товар1 = Товар.Родитель;
	Пока Товар1 <> Справочники.Номенклатура.ПустаяСсылка() Цикл
		Если Разрешить Тогда     
			Если НЕ ТоварРазрешенКЭкспорту(Товар1) Тогда
				РазрешитьЭкспорт(Товар1);
			КонецЕсли;
		КонецЕсли;
		Товар1 = Товар1.Родитель;
	КонецЦикла;
	
КонецПроцедуры

// 	#IBS 10.11.2021 Разрешает экспорт товара и всей иерархии классификатора
Процедура РазрешитьЭкспортТовараСРодителями(ТоварСсылка) Экспорт
	Перем Ссылка1;
	
	Если ТоварСсылка = неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Ссылка1 = ТоварСсылка;
	Пока НЕ Ссылка1.Пустая() Цикл
		РазрешитьЭкспорт(Ссылка1);		
		Ссылка1 = Ссылка1.Родитель;
	КонецЦикла
		
КонецПроцедуры
 
// #IBS 12.03.2025 Разрешить экспорт группы номенклатур
Процедура РазрешитьЭкспорт(Товар) Экспорт

	НаборЗаписей = РегистрыСведений.EmeWmsПометкиКЭкспортуНоменклатуры.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Номенклатура.Установить(Товар.Ссылка);
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл
		Запись.КЭкспорту = Истина;
		Запись.РазрешенКЭкспорту = Истина;
		НаборЗаписей.Записать();
		Возврат;
	КонецЦикла;
	
  	НоваяЗапись = РегистрыСведений.EmeWmsПометкиКЭкспортуНоменклатуры.СоздатьМенеджерЗаписи();
	НоваяЗапись.Номенклатура = Товар.Ссылка;
	НоваяЗапись.КЭкспорту = Истина;
	НоваяЗапись.РазрешенКЭкспорту = Истина;
    НоваяЗапись.Записать(); 
	
КонецПроцедуры

// #IBS 03.03.2023 Запретить экспорт группы (номенклатуры)
Процедура ЗапретитьЭкспорт(Товар) Экспорт

	НаборЗаписей = РегистрыСведений.EmeWmsПометкиКЭкспортуНоменклатуры.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Номенклатура.Установить(Товар.Ссылка);
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл
		Если Запись.РазрешенКЭкспорту Тогда
			Запись.КЭкспорту = Ложь;
			Запись.РазрешенКЭкспорту = Ложь;
			НаборЗаписей.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

