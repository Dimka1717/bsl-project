// #IBS 27.11.2023 Проверить, есть ли подчиненные товары, не помеченные на удаление
Функция ЕстьПодчиненныеТовары(ГруппаСсылка)
	Номенклатура = Справочники.Номенклатура;
	Отбор = Новый Структура("ПометкаУдаления");
	Отбор.ПометкаУдаления = Ложь;
	Выборка = Номенклатура.Выбрать(ГруппаСсылка,,Отбор);
	Пока Выборка.Следующий()  Цикл
		Если НЕ Выборка.ЭтоГруппа Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;	
	
	Возврат Ложь;
КонецФункции      

