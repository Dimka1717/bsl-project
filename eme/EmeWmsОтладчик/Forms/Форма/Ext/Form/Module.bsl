&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//	СООБЩЕНИЯ
	ТаблицаЗаголовковСообщений = Новый ТаблицаЗначений;
	ТаблицаЗаголовковСообщений.Колонки.Добавить("id");
	ТаблицаЗаголовковСообщений.Колонки.Добавить("what_to_do");
	ТаблицаЗаголовковСообщений.Колонки.Добавить("state");
	ТаблицаЗаголовковСообщений.Колонки.Добавить("created_at");
	ТаблицаЗаголовковСообщений.Колонки.Добавить("processed_at");
	ТаблицаЗаголовковСообщений.Колонки.Добавить("error_code");
	ТаблицаЗаголовковСообщений.Колонки.Добавить("total_childs");
	СоздатьТаблицуЗаголовковСообщений(ТаблицаЗаголовковСообщений);

	ТаблицаСтрокСообщения = Новый ТаблицаЗначений;
	ТаблицаСтрокСообщения.Колонки.Добавить("id");
	ТаблицаСтрокСообщения.Колонки.Добавить("header_id");
	ТаблицаСтрокСообщения.Колонки.Добавить("error_code");
	СоздатьТаблицуСтрокСообщения("childs", ТаблицаСтрокСообщения);
	
	//	НАСТРОЙКИ
	Настройки.EmeWmsПутьДоERPEngine = Константы.EmeWmsПутьДоERPEngine.Получить();
	Настройки.EmeWmsДатаЗапускаИнтеграции 				= Константы.EmeWmsДатаЗапускаИнтеграции.Получить();
	Настройки.EmeWmsУчетнаяЗаписьЭлектроннойПочты = Константы.EmeWmsУчетнаяЗаписьЭлектроннойПочты.Получить();
	Настройки.EmeWmsСписокРассылкиДиагностики = Константы.EmeWmsСписокРассылкиДиагностики.Получить();
	Настройки.EmeWmsСписокРассылкиДокументов = Константы.EmeWmsСписокРассылкиДокументов.Получить();
	Настройки.EmeWmsПользовательДляОповещений1 = Константы.EmeWmsПользовательДляОповещений1.Получить();
	Настройки.EmeWmsПользовательДляОповещений2 = Константы.EmeWmsПользовательДляОповещений2.Получить();
	Настройки.EmeWmsЭкспортироватьМаркиЧЗ = Константы.EmeWmsЭкспортироватьМаркиЧЗ.Получить();
	Настройки.EmeWmsОбменВключен = Константы.EmeWmsОбменВключен.Получить();
	Настройки.EmeWmsПометкаВключена = Константы.EmeWmsПометкаВключена.Получить();
	Настройки.EmeWmsИмпортироватьМаркиЧЗ = Константы.EmeWmsИмпортироватьМаркиЧЗ.Получить();
	Настройки.EmeWmsИспользоватьСерии = Константы.EmeWmsИспользоватьСерии.Получить();
	Настройки.EmeWmsФормироватьОрдераПриИнвентаризации = Константы.EmeWmsФормироватьОрдераПриИнвентаризации.Получить();
	Настройки.EmeWmsСоздаватьУникальныеСообщения = Константы.EmeWmsСоздаватьУникальныеСообщения.Получить();
	Настройки.EmeWmsЕдиницаИзмеренияДлины = Константы.EmeWmsЕдиницаИзмеренияДлины.Получить();
	Настройки.EmeWmsЕдиницаИзмеренияВеса = Константы.EmeWmsЕдиницаИзмеренияВеса.Получить();
	Настройки.EmeWmsЕдиницаИзмеренияОбъема = Константы.EmeWmsЕдиницаИзмеренияОбъема.Получить();
	ЭтаФорма.Элементы.СохранитьНастройки.Доступность = Ложь;
	ЭкспортОстатковНаДату = ТекущаяДата();
	
	//	УТИЛИТЫ
	СписокУтилитТаблица = Новый ТаблицаЗначений;
	EmeWmsУтилиты.ПолучитьСписокУтилит(СписокУтилитТаблица);
	СписокУтилит.Загрузить(СписокУтилитТаблица);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	Если ЭтаФорма.Элементы.СохранитьНастройки.Доступность Тогда
		Выбор = Вопрос("Сохранить настройки?", РежимДиалогаВопрос.ДаНетОтмена);
		Если Выбор = КодВозвратаДиалога.Да Тогда
			СохранитьВсеНастройки();
		ИначеЕсли Выбор = КодВозвратаДиалога.Отмена Тогда
			Отказ = Истина;
		КонецЕсли
	КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтруктуруСообщений(Команда)
	Текст = Новый ЧтениеТекста(Настройки.EmeWmsПутьДоERPEngine);

	СтрокаИсходная = ПолучитьСодержимоеФайлаНастроекНаСервере();
	Если Текст.ПрочитатьСтроку() <> СтрокаИсходная Тогда
		СтрокаНовая = Текст.Прочитать();
		УстановитьСтруктуруСообщенийНаСервере(СтрокаНовая);	
		СодержимоеФайлаНастроек = СтрокаНовая;
		ПоказатьПредупреждение(,НСтр("ru='Установлены настройки сообщений из файла'") + Настройки.EmeWmsПутьДоERPEngine);
		ЭтаФорма.Элементы.СохранитьНастройки.Доступность = Истина;
	Иначе
		ПоказатьПредупреждение(,НСтр("ru='Настройки сообщений не изменились.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСтруктуруСообщенийНаСервере(СтрокаНовая)
	EmeWmsУтилиты.СохранитьСодержимоеФайлаНастроек(СтрокаНовая);	
КонецПроцедуры

&НаСервере
Функция ПолучитьСодержимоеФайлаНастроекНаСервере()
	Возврат EmeWmsУтилиты.ПолучитьСодержимоеФайлаНастроек();	
КонецФункции

&НаКлиенте
Процедура СодержимоеФайлаНастроекНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = ложь;
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(СодержимоеФайлаНастроек);

	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);

	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку(Новый ПараметрыЗаписиXML(, , Истина, Истина));//содержится явное указание 1С отформатировать XML при записи

	ЗаписьDOM = Новый ЗаписьDOM;
	ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
	ИсходныйТекстXML= ЗаписьXML.Закрыть();	
	
	ТекстовыйДокумент = новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ИсходныйТекстXML);
	ТекстовыйДокумент.Показать("Файл настроек ERPEngine.xml");
	// Вставить содержимое обработчика.
КонецПроцедуры

//	СООБЩЕНИЯ

//	Команда "Обновить"
&НаСервере
Процедура ОбновитьДеревоСообщенийНаСервере()
	
	//	Получим статистику по сообщениям
	СтатистикаСообщений = Новый ТаблицаЗначений;
	
	ERPData = Новый Структура;
	EmeWmsERPEngine.Create(ERPData);
	
	// #IBS 01.03.2024 Получить текст файла из регистра настроек
	ERPData.ERPEngine = EmeWmsУтилиты.ПолучитьСодержимоеФайлаНастроек();
	Если ERPData.ERPEngine = Неопределено Или ERPData.ERPEngine = "" Тогда
		Возврат;
	КонецЕсли;
	
	Ошибка = EmeWmsERPEngine.Connect(ERPData);
	Если Ошибка <> "" Тогда
		Сообщить(Ошибка);
		Возврат;
	КонецЕсли;
	
	EmeWmsERPEngine.GetStatistics(ERPData, СтатистикаСообщений);
	EmeWmsERPEngine.Disconnect(ERPData);
	
	//	Заполняем дерево сообщений
	ВсеСообщения = ДеревоСообщений.ПолучитьЭлементы();
	ВсеСообщения.Очистить();
	
	ВеткаОткудаКуда = ВсеСообщения.Добавить();
	ВеткаОткудаКуда.Сообщение = "Сообщения 1C->EME";
	ВеткаОткудаКуда.Картинка = Новый Картинка(РеквизитФормыВЗначение("Объект").ПолучитьМакет("Картинка1С"));
	ДобавитьТипыСообщений(ВеткаОткудаКуда, "erp", "wms", СтатистикаСообщений);
	
	ВеткаОткудаКуда = ВсеСообщения.Добавить();
	ВеткаОткудаКуда.Сообщение = "Сообщения EME->1C";
	ВеткаОткудаКуда.Картинка = Новый Картинка(РеквизитФормыВЗначение("Объект").ПолучитьМакет("КартинкаEME"));
	ДобавитьТипыСообщений(ВеткаОткудаКуда, "wms", "erp", СтатистикаСообщений);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДеревоСообщений(Команда)
	Состояние("Обновляем дерево сообщений...");
	ОбновитьДеревоСообщенийНаСервере();
	РаскрытьДеревоСообщений();
КонецПроцедуры

