//	УТИЛИТЫ
&НаСервере
Процедура ВыполнитьУтилитуНаСервере(ИмяУтилиты)
	Выполнить("EmeWmsУтилиты." + ИмяУтилиты + "()");
КонецПроцедуры

&НаКлиенте
Процедура СписокУтилитВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) 

	ПараметрыВопроса = Новый Структура;
	ПараметрыВопроса.Вставить("Команда", "ВыполнитьУтилиту");
	ПараметрыВопроса.Вставить("ИмяУтилиты", СписокУтилит.НайтиПоИдентификатору(ВыбраннаяСтрока).Утилита);
	
	Если Вопрос(НСтр("ru = 'Выполнить утилиту " + ПараметрыВопроса.ИмяУтилиты + "?'"), 
			РежимДиалогаВопрос.ДаНетОтмена) = КодВозвратаДиалога.Да Тогда
		ВыполнитьУтилитуНаСервере(ПараметрыВопроса.ИмяУтилиты);			
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	Перем Команда;
	
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
	
	Если НЕ Параметры.Свойство("Команда", Команда) Тогда
		Возврат;
	КонецЕсли;
	
	Если 	  Команда = "ВыполнитьУтилиту" Тогда
		
		ВыполнитьУтилитуНаСервере(Параметры.ИмяУтилиты); 

		//Состояние(НСтр("ru = 'Выполняется утилита... '"), , Параметры.ИмяУтилиты, БиблиотекаКартинок.ДлительнаяОперация48);
		//НастроитьПараметрыПодключенияАвтоматически(Параметры.ИмяУтилиты);	
		
	ИначеЕсли Команда = "ОткатитьВыделенныеСообщения" Тогда
		
		ВыделенныеСтроки = ЭтаФорма.Элементы.ЗаголовкиСообщений.ВыделенныеСтроки;
		
		Состояние("Экспортируем сообщения...");
		ОткатитьВыделенныеСообщенияНаСервере(ВыделенныеСтроки);
		ОбновитьДеревоСообщенийНаСервере();
		РаскрытьДеревоСообщений();
		
	КонецЕсли;

КонецПроцедуры

