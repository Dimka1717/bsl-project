//	Оформление формы
&НаСервере
Процедура ОформитьФорму()
	
	ЖирныйШрифт = Новый Шрифт(,,Истина);

	ЭтаФорма.УсловноеОформление.Элементы.Очистить();
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДеревоСообщений");
	
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоСообщений.Имя");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = СообщениеИмя;
	
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоСообщений.Откуда");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = СообщениеОткуда;
	
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоСообщений.Куда");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = СообщениеКуда;
	
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоСообщений.Статус");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = СообщениеСтатус;
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", ЖирныйШрифт);	
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ЗаголовкиСообщений");
	
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЗаголовкиСообщений.id");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = СообщениеИдентификатор;
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", ЖирныйШрифт);	
	
КонецПроцедуры

//	Дерево сообщений
&НаСервере
Процедура ДобавитьТипыСообщений(ВеткаОткудаКуда, Откуда, Куда, СтатистикаСообщений)
	
	СообщенияНовые = ВеткаОткудаКуда.ПолучитьЭлементы().Добавить();
	СообщенияНовые.Сообщение = "Новые";
	ДобавитьСообщения(СообщенияНовые, Откуда, Куда, "NEW", СтатистикаСообщений, "КартинкаНовые");
	
	СообщенияВОжидании = ВеткаОткудаКуда.ПолучитьЭлементы().Добавить();
	СообщенияВОжидании.Сообщение = "В ожидании";
	ДобавитьСообщения(СообщенияВОжидании, Откуда, Куда, "WRN", СтатистикаСообщений, "КартинкаНовые");
	
	СообщенияСОшибками = ВеткаОткудаКуда.ПолучитьЭлементы().Добавить();
	СообщенияСОшибками.Сообщение = "С ошибками";
	ДобавитьСообщения(СообщенияСОшибками, Откуда, Куда, "ERR", СтатистикаСообщений, "КартинкаСОшибками");
	
	СообщенияОбработанные = ВеткаОткудаКуда.ПолучитьЭлементы().Добавить();
	СообщенияОбработанные.Сообщение = "Обработанные";
	ДобавитьСообщения(СообщенияОбработанные, Откуда, Куда, "OK", СтатистикаСообщений, "КартинкаОбработанные");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСообщения(ТипСообщения, Откуда, Куда, Статус, СтатистикаСообщений, ИмяКартинки)
	
	ТипСообщения.Картинка = Новый Картинка(РеквизитФормыВЗначение("Объект").ПолучитьМакет("КартинкаПапка"));
	Для Каждого СтатистикаСообщения Из СтатистикаСообщений Цикл
		Если Откуда = СтатистикаСообщения.Source И
			Куда = СтатистикаСообщения.Target И
			Статус = СтатистикаСообщения.State Тогда
			
			Сообщение = ТипСообщения.ПолучитьЭлементы().Добавить();
			Сообщение.Сообщение = СтатистикаСообщения.Name + " (" + СтатистикаСообщения.Count + ")";
			Сообщение.Откуда = Откуда;
			Сообщение.Куда = Куда;
			Сообщение.Имя = СтатистикаСообщения.Name;
			Сообщение.Статус = Статус;
			Сообщение.Картинка = Новый Картинка(РеквизитФормыВЗначение("Объект").ПолучитьМакет(ИмяКартинки));
			
		КонецЕсли
	КонецЦикла
	
КонецПроцедуры

&НаКлиенте
Процедура РаскрытьДеревоСообщений()
	ВеткиОткудаКуда = ДеревоСообщений.ПолучитьЭлементы();
	Для Каждого ВеткаОткудаКуда Из ВеткиОткудаКуда Цикл
		ЭтаФорма.Элементы.ДеревоСообщений.Развернуть(ВеткаОткудаКуда.ПолучитьИдентификатор(),Истина);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ДеревоСообщенийВыборНаСервере()
	
	//	Получим заголовки сообщений
	ТаблицаЗаголовковСообщений = Новый ТаблицаЗначений;
	
	ERPData = Новый Структура;
	EmeWmsERPEngine.Create(ERPData);
	
	//ERPData.Config = Настройки.EmeWmsПутьДоERPEngine;
	//Если ERPData.Config = Неопределено Или ERPData.Config = "" Тогда
	//	Возврат
	//КонецЕсли;
	// #IBS 01.03.2024 Получить текст файла из регистра настроек
	ERPData.ERPEngine = EmeWmsУтилиты.ПолучитьСодержимоеФайлаНастроек();
	Если ERPData.ERPEngine = Неопределено Или ERPData.ERPEngine = "" Тогда
		Возврат;
	КонецЕсли;
	
	Ошибка = EmeWmsERPEngine.Connect(ERPData);
	Если Ошибка <> "" Тогда
		Сообщить(Ошибка);
		Возврат;
	КонецЕсли;
	
	EmeWmsERPEngine.GetHeaders(ERPData, СообщениеОткуда, СообщениеКуда, СообщениеИмя, СообщениеСтатус, ТаблицаЗаголовковСообщений);
	EmeWmsERPEngine.Disconnect(ERPData);
	
	СоздатьТаблицуЗаголовковСообщений(ТаблицаЗаголовковСообщений);
	СоздатьТаблицыСтрокСообщений(ТаблицаЗаголовковСообщений[0]);
	
	ОформитьФорму();

КонецПроцедуры

&НаКлиенте
Процедура ДеревоСообщенийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Состояние("Обновляем заголовки сообщений...");
	Сообщение = ДеревоСообщений.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Сообщение.Имя <> "" Тогда
		СообщениеОткуда = Сообщение.Откуда;
		СообщениеКуда = Сообщение.Куда;
		СообщениеИмя = Сообщение.Имя;
		СообщениеСтатус = Сообщение.Статус;
		ДеревоСообщенийВыборНаСервере();
	КонецЕсли
КонецПроцедуры

//	Таблица заголовков сообщений
&НаСервере
Процедура СоздатьТаблицуЗаголовковСообщений(ТаблицаЗаголовковСообщений)
	
	МассивТипаТЗ = Новый Массив;
	МассивТипаТЗ.Добавить(Тип("ТаблицаЗначений"));
	ОписаниеТипаТЗ = Новый ОписаниеТипов(МассивТипаТЗ);
	
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ЗаголовкиСообщений", ОписаниеТипаТЗ));
	
	Для Каждого Колонка Из ТаблицаЗаголовковСообщений.Колонки Цикл
		МассивРеквизитов.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "ЗаголовкиСообщений"));
	КонецЦикла;
	
	МассивРеквизитовДляУдаления = Новый Массив();
	Для Каждого РеквизитФормы Из ЭтаФорма.ПолучитьРеквизиты() Цикл
		Если РеквизитФормы.Имя = "ЗаголовкиСообщений" Тогда
			МассивРеквизитовДляУдаления.Добавить(РеквизитФормы.Имя);
			Прервать
		КонецЕсли
	КонецЦикла;
	
	ИзменитьРеквизиты(МассивРеквизитов, МассивРеквизитовДляУдаления);

	Пока Элементы.ГруппаЗаголовковСообщений.ПодчиненныеЭлементы.Количество() <> 0 Цикл
		Для Каждого ЭлементГруппы Из Элементы.ГруппаЗаголовковСообщений.ПодчиненныеЭлементы Цикл
			Элементы.Удалить(ЭлементГруппы);
		КонецЦикла;
	КонецЦикла;

	ТаблицаФормыЗаголовковСообщений = Элементы.Добавить("ЗаголовкиСообщений", Тип("ТаблицаФормы"), Элементы.ГруппаЗаголовковСообщений);
	ТаблицаФормыЗаголовковСообщений.ПутьКДанным = "ЗаголовкиСообщений";
	ТаблицаФормыЗаголовковСообщений.Отображение = ОтображениеТаблицы.Список;
	ТаблицаФормыЗаголовковСообщений.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
	ТаблицаФормыЗаголовковСообщений.ТолькоПросмотр = Истина;
	ТаблицаФормыЗаголовковСообщений.УстановитьДействие("Выбор", "ЗаголовкиСообщенийВыбор");

	Для Каждого Колонка Из ТаблицаЗаголовковСообщений.Колонки Цикл
		НовыйЭлемент = Элементы.Добавить("header_" + Колонка.Имя, Тип("ПолеФормы"), ТаблицаФормыЗаголовковСообщений);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "ЗаголовкиСообщений." + Колонка.Имя;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ТаблицаЗаголовковСообщений, "ЗаголовкиСообщений");
	
КонецПроцедуры

&НаСервере
Процедура ЗаголовкиСообщенийВыборНаСервере(ВыбраннаяСтрока)
	Сообщение = ЭтаФорма.ЗаголовкиСообщений.НайтиПоИдентификатору(ВыбраннаяСтрока);
	СоздатьТаблицыСтрокСообщений(Сообщение);
	ОформитьФорму();
КонецПроцедуры

&НаКлиенте
Процедура ЗаголовкиСообщенийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Состояние("Обновляем строки сообщения...");
	ЗаголовкиСообщенийВыборНаСервере(ВыбраннаяСтрока);
КонецПроцедуры

//	Таблицы строк сообщения
&НаСервере
Процедура СоздатьТаблицуСтрокСообщения(ИмяДочернейТаблицы, ТаблицаСтрокСообщения)
	
	СтраницаСтрокСообщения = Элементы.Добавить("Страница_" + ИмяДочернейТаблицы, Тип("ГруппаФормы"), Элементы.ГруппаСтрокСообщения);
 	СтраницаСтрокСообщения.Вид = ВидГруппыФормы.Страница;
   	СтраницаСтрокСообщения.Заголовок = ИмяДочернейТаблицы;
	
	МассивТипаТЗ = Новый Массив;
	МассивТипаТЗ.Добавить(Тип("ТаблицаЗначений"));
	ОписаниеТипаТЗ = Новый ОписаниеТипов(МассивТипаТЗ);
	
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить(Новый РеквизитФормы("СтрокиСообщения_" + ИмяДочернейТаблицы, ОписаниеТипаТЗ));
	
	Для Каждого Колонка Из ТаблицаСтрокСообщения.Колонки Цикл
		МассивРеквизитов.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "СтрокиСообщения_" + ИмяДочернейТаблицы));
	КонецЦикла;
	
	ИзменитьРеквизиты(МассивРеквизитов);
	
	ТаблицаФормыСтрокСообщения = Элементы.Добавить("Таблица_" + ИмяДочернейТаблицы, Тип("ТаблицаФормы"), СтраницаСтрокСообщения);
	ТаблицаФормыСтрокСообщения.ПутьКДанным = "СтрокиСообщения_" + ИмяДочернейТаблицы;
	ТаблицаФормыСтрокСообщения.Отображение = ОтображениеТаблицы.Список;
	ТаблицаФормыСтрокСообщения.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
	ТаблицаФормыСтрокСообщения.ТолькоПросмотр = Истина;
	Для Каждого Колонка Из ТаблицаСтрокСообщения.Колонки Цикл
		НовыйЭлемент = Элементы.Добавить(ИмяДочернейТаблицы + "_" + Колонка.Имя, Тип("ПолеФормы"), ТаблицаФормыСтрокСообщения);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "СтрокиСообщения_" + ИмяДочернейТаблицы + "." + Колонка.Имя;
	КонецЦикла;

	ЗначениеВРеквизитФормы(ТаблицаСтрокСообщения, "СтрокиСообщения_" + ИмяДочернейТаблицы);

КонецПроцедуры

&НаСервере
Процедура СоздатьТаблицыСтрокСообщений(Сообщение)

	СообщениеИдентификатор = Сообщение.id;
	
	МассивИменДочернихТаблиц = Новый Массив;
	ERPData = Новый Структура;
	EmeWmsERPEngine.Create(ERPData);
	
	//ERPData.Config = Настройки.EmeWmsПутьДоERPEngine;
	//Если ERPData.Config = Неопределено Или ERPData.Config = "" Тогда
	//	Возврат
	//КонецЕсли;
	// #IBS 01.03.2024 Получить текст файла из регистра настроек
	ERPData.ERPEngine = EmeWmsУтилиты.ПолучитьСодержимоеФайлаНастроек();
	Если ERPData.ERPEngine = Неопределено Или ERPData.ERPEngine = "" Тогда
		Возврат;
	КонецЕсли;
	
	Ошибка = EmeWmsERPEngine.Connect(ERPData);
	Если Ошибка <> "" Тогда
		Сообщить(Ошибка);
		Возврат;
	КонецЕсли;
	
	EmeWmsERPEngine.GetChilds(ERPData, СообщениеОткуда, СообщениеКуда, СообщениеИмя, МассивИменДочернихТаблиц);
	
	Пока Элементы.ГруппаСтрокСообщения.ПодчиненныеЭлементы.Количество() <> 0 Цикл
		Для Каждого ЭлементГруппы Из Элементы.ГруппаСтрокСообщения.ПодчиненныеЭлементы Цикл
			Элементы.Удалить(ЭлементГруппы);
		КонецЦикла;
	КонецЦикла;
	
	МассивРеквизитовДляУдаления = Новый Массив();
	Для Каждого РеквизитФормы Из ЭтаФорма.ПолучитьРеквизиты() Цикл
		Если Найти(РеквизитФормы.Имя, "СтрокиСообщения_") > 0 Тогда
			МассивРеквизитовДляУдаления.Добавить(РеквизитФормы.Имя);
		КонецЕсли
	КонецЦикла;
	ИзменитьРеквизиты(, МассивРеквизитовДляУдаления);
	
	Для Каждого ИмяДочернейТаблицы Из МассивИменДочернихТаблиц Цикл
		
		ТаблицаСтрокСообщения = Новый ТаблицаЗначений;
		EmeWmsERPEngine.GetChildLines(ERPData, СообщениеОткуда, СообщениеКуда, СообщениеИмя, ИмяДочернейТаблицы, СообщениеИдентификатор, ТаблицаСтрокСообщения);
		
		СоздатьТаблицуСтрокСообщения(ИмяДочернейТаблицы, ТаблицаСтрокСообщения);

	КонецЦикла;
	
	EmeWmsERPEngine.Disconnect(ERPData);
	
КонецПроцедуры

//	НАСТРОЙКИ
&НаСервере
Процедура СохранитьВсеНастройки()
	Константы.EmeWmsПутьДоERPEngine.Установить(Настройки.EmeWmsПутьДоERPEngine);
