	Константы.EmeWmsСписокРассылкиДокументов.Установить(Настройки.EmeWmsСписокРассылкиДокументов);
	Константы.EmeWmsПользовательДляОповещений1.Установить(Настройки.EmeWmsПользовательДляОповещений1);
	Константы.EmeWmsПользовательДляОповещений2.Установить(Настройки.EmeWmsПользовательДляОповещений2);
	Константы.EmeWmsЭкспортироватьМаркиЧЗ.Установить(Настройки.EmeWmsЭкспортироватьМаркиЧЗ);
	Константы.EmeWmsИмпортироватьМаркиЧЗ.Установить(Настройки.EmeWmsИмпортироватьМаркиЧЗ);
	Константы.EmeWmsИспользоватьСерии.Установить(Настройки.EmeWmsИспользоватьСерии);
	Константы.EmeWmsОбменВключен.Установить(Настройки.EmeWmsОбменВключен);
	Константы.EmeWmsПометкаВключена.Установить(Настройки.EmeWmsПометкаВключена);
	Константы.EmeWmsФормироватьОрдераПриИнвентаризации.Установить(Настройки.EmeWmsФормироватьОрдераПриИнвентаризации);
	Константы.EmeWmsСоздаватьУникальныеСообщения.Установить(Настройки.EmeWmsСоздаватьУникальныеСообщения);
	Константы.EmeWmsЕдиницаИзмеренияДлины.Установить(Настройки.EmeWmsЕдиницаИзмеренияДлины);
	Константы.EmeWmsЕдиницаИзмеренияВеса.Установить(Настройки.EmeWmsЕдиницаИзмеренияВеса);
	Константы.EmeWmsЕдиницаИзмеренияОбъема.Установить(Настройки.EmeWmsЕдиницаИзмеренияОбъема);	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)
	СохранитьВсеНастройки();
	ЭтаФорма.Элементы.СохранитьНастройки.Доступность = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПутьДоERPEngineНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	// Создать новый диалог для открытия файлов.
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	// Какие типы файлов будут предложены для выбора.
	ДиалогВыбораФайла.Фильтр = "Описатель (ERPEngine.xml)|ERPEngine.xml";
	ДиалогВыбораФайла.Заголовок = "Выберите файл";                                         
	
	// В диалоге будет открыт предварительный просмотр файлов
	ДиалогВыбораФайла.ПредварительныйПросмотр = Истина;
	
	// При открытии диалога сначала для выбора будут предложены файлы
	// первого типа, из типов, перечисленных в свойстве "Фильтр".
	ДиалогВыбораФайла.ИндексФильтра = 0;
	
	Если Настройки.EmeWmsПутьДоERPEngine <> "" Тогда
		ДиалогВыбораФайла.ПолноеИмяФайла = Настройки.EmeWmsПутьДоERPEngine;
	КонецЕсли;

	// Открыть диалог выбора файла.
	Если ДиалогВыбораФайла.Выбрать() Тогда
		// Действия, выполняемые тогда, когда файл выбран.
		Если Настройки.EmeWmsПутьДоERPEngine <> ДиалогВыбораФайла.ПолноеИмяФайла Тогда
	   		Настройки.EmeWmsПутьДоERPEngine = ДиалогВыбораФайла.ПолноеИмяФайла;
			ЭтаФорма.Элементы.СохранитьНастройки.Доступность = Истина;
		КонецЕсли
   	КонецЕсли;
   
КонецПроцедуры

&НаКлиенте
Процедура ПутьДоERPEngineИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	ЭтаФорма.Элементы.СохранитьНастройки.Доступность = Истина;
КонецПроцедуры

