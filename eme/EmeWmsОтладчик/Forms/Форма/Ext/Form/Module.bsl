//	Команда "Откатить"
&НаСервере
Процедура ОткатитьВыделенныеСообщенияНаСервере(ВыделенныеСтроки)
	
	ИдентификаторыСообщений = Новый Массив;
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		ИдентификаторыСообщений.Добавить(ЭтаФорма.ЗаголовкиСообщений.НайтиПоИдентификатору(ВыделеннаяСтрока).id);
	КонецЦикла;
	
	ERPData = Новый Структура;
	EmeWmsERPEngine.Create(ERPData);
	
	// #IBS 01.03.2024 Получить текст файла из регистра настроек
	ERPData.ERPEngine = EmeWmsУтилиты.ПолучитьСодержимоеФайлаНастроек();
	Если ERPData.ERPEngine = Неопределено Или ERPData.ERPEngine = "" Тогда
		Возврат;
	КонецЕсли;
	
	Ошибка = EmeWmsERPEngine.Connect(ERPData);
	Если Ошибка <> "" Тогда
		Сообщить(Ошибка);
		Возврат;
	КонецЕсли;
	
	Ошибка = EmeWmsERPEngine.UndoImport(ERPData, СообщениеОткуда, СообщениеКуда, СообщениеИмя, ИдентификаторыСообщений);
	EmeWmsERPEngine.Disconnect(ERPData);
	
	Если Ошибка <> "" Тогда
		Сообщить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткатитьВыделенныеСообщения(Команда) 
	
	ВыделенныеСтроки = ЭтаФорма.Элементы.ЗаголовкиСообщений.ВыделенныеСтроки;
	
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Вопрос(НСтр("ru = 'Откатить выделенные сообщения " + СообщениеИмя + " (" 
	                           + ВыделенныеСтроки.Количество() + "шт) на статус Новые?'"), 
			РежимДиалогаВопрос.ДаНетОтмена) = КодВозвратаДиалога.Да Тогда
			
		ОткатитьВыделенныеСообщенияНаСервере(ВыделенныеСтроки);
	КонецЕсли;
КонецПроцедуры

