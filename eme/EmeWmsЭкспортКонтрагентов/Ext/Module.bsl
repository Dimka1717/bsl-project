#Область ПрограммныйИнтерфейс  

//	Процедура Экспортировать экспортирует одного Контрагента.
Процедура Экспортировать(ERPData, Контрагент) Экспорт   
	
	РеквизитыКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, "Код, Наименование, Покупатель, Поставщик, ИНН, КПП, ОсновнойМенеджерПокупателя");
	
	//	Заголовок Clients
	EmeWmsERPEngine.AppendHeaderLine(ERPData);
	ERPData.header.id				= Контрагент.УникальныйИдентификатор();
	ERPData.header.code				= СокрЛП(РеквизитыКонтрагента.Код); // ibs в интерфейсе ERP этот код есть
	ERPData.header.name				= РеквизитыКонтрагента.Наименование;
		
	АдресДоставки 	 		= УправлениеКонтактнойИнформацией.ПолучитьАдресИзКонтактнойИнформации(Контрагент,"Фактический");
	ERPData.header.ADDRESS 	= АдресДоставки;
	ERPData.header.INN 		= РеквизитыКонтрагента.ИНН;
	ERPData.header.KPP 		= РеквизитыКонтрагента.КПП;
	ERPData.header.FP_OUT_CODE = ""; // Код стратегии подборки, надо выяснить, чем заполнять.
	ERPData.header.PHONE 	= УправлениеКонтактнойИнформацией.ПолучитьТелефонИзКонтактнойИнформации(Контрагент);
		
	ERPData.header.POSTAL_CODE = Лев(АдресДоставки,6); // Упрощенный вариант
	
	Если РеквизитыКонтрагента.Покупатель и РеквизитыКонтрагента.Поставщик Тогда
		ERPData.header.TYPE		= "CUS; SPL";
	ИначеЕсли РеквизитыКонтрагента.Поставщик Тогда
		ERPData.header.TYPE		= "SPL";
	Иначе
		ERPData.header.TYPE		= "CUS";
	КонецЕсли;
	
	//	Вид контактной информации: Почта для возвратов поставщикам
	ВидыКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.НайтиПоКоду("000000060");
	Если ЗначениеЗаполнено(ВидыКонтактнойИнформации) Тогда
		ERPData.header.EMAIL	= ОбщийМодуль_ЛА.ПолучитьEmailПоВиду(Контрагент, ВидыКонтактнойИнформации);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РеквизитыКонтрагента.ОсновнойМенеджерПокупателя) Тогда
		ERPData.header.manager_email = LA_ОбщийМодуль.СлужебныйАДресЭлектроннойПочтыПользователя(РеквизитыКонтрагента.ОсновнойМенеджерПокупателя);
	КонецЕсли;
	
КонецПроцедуры

