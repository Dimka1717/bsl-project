//#Область СлужебныйПрограммныйИнтерфейс

// Создает форму МодульКлиента обработки Контур.Маркировка
// 
// Возвращаемое значение:
//  ФормаКлиентскогоПриложения - форма модуля клиента маркировки;
//
Функция МодульКонтурМаркировкаКлиент() Экспорт
	
	ПараметрыФормы = ВзаимодействиеКонтурМаркировкаВызовСервера.ПараметрыСозданияМодуляКлиента();
	ИдентификаторСеанса = Строка(ПараметрыФормы.ИдентификаторСеанса);
	ПутьКФормеМодуляКлиента = ПараметрыФормы.ПутьКФормеМодуляКлиента;
	
	Возврат ВзаимодействиеКонтурМаркировкаКлиентПовтИсп.МодульКонтурМаркировкаКлиент(ПутьКФормеМодуляКлиента, ИдентификаторСеанса);
	
КонецФункции

//#КонецОбласти

// #Область УстаревшиеМетоды

// Устарела. следует использовать ОткрытьФормуДокументаУчетаПоДокументу1С
//
Процедура ОткрытьФормуДокументаУчетаПоДокументу(Документ1С) Экспорт
	
	ДокументУчета = ВзаимодействиеКонтурМаркировкаВызовСервера.НайтиДокументУчетаПоДокументу1С(Документ1С);
	
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		ДокументУчета = ВзаимодействиеКонтурМаркировкаВызовСервера.СоздатьДокументУчетаПоДокументу1С(Документ1С);
	КонецЕсли;
	
	МодульКонтурМаркировкаКлиент().ОткрытьФормуДокументаУчета(ДокументУчета);
	
КонецПроцедуры

// #КонецОбласти
