// Открывает форму настройки подписания
//
// Параметры:
//  Организация    - СправочникСсылка.КонтурМаркировка_Организации - организация;
//  Пользователь   - СправочникСсылка.КонтурМаркировка_Пользователи - пользователь;
//  Сертификат     - СправочникСсылка.КонтурМаркировка_Сертификаты - сертификат;
//
Процедура ОткрытьФормуНастройкиПодписания(Организация, Пользователь) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Организация);
	ПараметрыФормы.Вставить("Пользователь", Пользователь);
	
	МодульКонтурМаркировкаКлиент().ОткрытьФормуНастройкиПодписания(ПараметрыФормы);
	
КонецПроцедуры

