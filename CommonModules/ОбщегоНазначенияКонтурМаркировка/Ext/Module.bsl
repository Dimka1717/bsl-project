// #Область ФайловаяСистема

// Проверяет, что файл есть на диске
//
// Параметры:
//  ПутьКФайлу - Строка - путь к файлу;
// 
// Возвращаемое значение:
//  Булево - Истина, если файл существует;
//
Функция ФайлСуществует(ПутьКФайлу) Экспорт
	
	Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Файл = НовыйФайл(ПутьКФайлу);
	
	Возврат Файл.Существует();
	
КонецФункции

// Формирует путь на диске с разделителем, используемым в операционной системе
//
// Параметры:
//  Часть1 - Строка - часть пути №1;
//  Часть2 - Строка - часть пути №2;
//  Часть3 - Строка - (необязательный) часть пути №3;
//  Часть4 - Строка - (необязательный) часть пути №4;
// 
// Возвращаемое значение:
//  Строка - путь на диске
//
Функция ОбъединитьПути(Часть1, Часть2, Часть3 = "", Часть4 = "") Экспорт
	
	ЧастиПути = Новый Массив;
	ЧастиПути.Добавить(Часть1);
	ЧастиПути.Добавить(Часть2);
	ЧастиПути.Добавить(Часть3);
	ЧастиПути.Добавить(Часть4);
	
	Разделитель = РазделительПути();
	
	Результат = "";
	
	Для Каждого Элемент Из ЧастиПути Цикл
		
		Если Не ЗначениеЗаполнено(Элемент) Тогда
			Прервать;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Результат) Тогда
			Результат = Элемент;
			Продолжить;
		КонецЕсли;
		
		Если Прав(Результат, 1) <> Разделитель Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		
		Результат = Результат + Элемент;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Удаляет часть пути к файлу на диске, начиная с конца
//
// Параметры:
//  ПутьКФайлу - Строка - путь к файлу на диске;
//  УдаляемаяЧасть - Строка - часть пути, которую нужно удалить;
// 
// Возвращаемое значение:
//  Строка - путь к файлу без удаленной части
//
Функция УдалитьЧастьПути(ПутьКФайлу, УдаляемаяЧасть) Экспорт
	
	Разделитель = РазделительПути();
	ЧастиПути = РазделитьСтроку(ПутьКФайлу, Разделитель, Истина);
	
	Для Сч = -ЧастиПути.ВГраница() По 0 Цикл
		Если НРег(ЧастиПути[-Сч]) = НРег(УдаляемаяЧасть) Тогда
			ЧастиПути.Удалить(-Сч);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СоединитьСтроку(ЧастиПути, Разделитель);
	
КонецФункции

// Определяет путь на диске к каталогу внешней обработки
//
// Параметры:
//  ОбъектОбработки - ВнешняяОбработка - внешняя обработка
// 
// Возвращаемое значение:
//  Строка - путь к каталогу внешней обработки
//
Функция КаталогОбработки(ОбъектОбработки) Экспорт
	
	ПутьКФайлу = ПутьКФайлуОбработки(ОбъектОбработки);
	Если Не ЗначениеЗаполнено(ПутьКФайлу)
		Или ЭтоАдресИзВременногоХранилища(ПутьКФайлу) Тогда
		Возврат "";
	КонецЕсли;
	
	Файл = НовыйФайл(ПутьКФайлу);
	
	Возврат Файл.Путь;
	
КонецФункции

// Безопасно читает путь к файлу внешней обработки
//
// Параметры:
//  ОбъектОбработки - ВнешняяОбработка - внешняя обработка
// 
// Возвращаемое значение:
//  Строка - путь к каталогу внешней обработки
//
Функция ПутьКФайлуОбработки(ОбъектОбработки) Экспорт
	
	Возврат СвойствоОбъекта(ОбъектОбработки, "ИспользуемоеИмяФайла", "");
	
КонецФункции

// Читает из файла дату последнего изменения
//
// Параметры:
//  ПутьКФайлу - Строка - путь к файлу на диске
// 
// Возвращаемое значение:
//  Дата - дата изменения файла
//
Функция ДатаИзмененияФайла(ПутьКФайлу) Экспорт
	
	Результат = '00010101';
	
	Если ФайлСуществует(ПутьКФайлу) Тогда
		Результат = НовыйФайл(ПутьКФайлу).ПолучитьВремяИзменения();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет что путь к файлу ведет во временный каталог
//
// Параметры:
//  ПутьКФайлу - Строка - путь к файлу или каталогу
// 
// Возвращаемое значение:
//  Булево - Истина, если файл во временном каталоге
//
Функция ЭтоКаталогВременныхФайлов(ПутьКФайлу) Экспорт
	
	// BSLLS:FileSystemAccess-off
	Возврат (Найти(ПутьКФайлу, КаталогВременныхФайлов()) = 1);
	// BSLLS:FileSystemAccess-on
	
КонецФункции

// Определяет что строка является адресом из временного хранилища
//
// Параметры:
//  Строка - Строка - строка адреса
// 
// Возвращаемое значение:
//  Булево - Истина, если строка является адресом из временного хранилища
//
Функция ЭтоАдресИзВременногоХранилища(Знач Строка) Экспорт
	
	Если ТипЗнч(Строка) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НачалоАдреса = "e1cibtempstorage";
	Строка = СтрЗаменить(Строка, "/", "");
	Строка = СтрЗаменить(Строка, "\", "");
	
	Результат = (Найти(Строка, НачалоАдреса) = 1);
	
	Возврат Результат;
	
КонецФункции

// Удаляет файл в синхронном режиме,
// для совместимости со стартыми версиями платформы
//
// Параметры:
//  ПутьКФайлу - Строка - путь к файлу
//
Процедура УдалитьФайл(ПутьКФайлу) Экспорт
	
	// BSLLS:UsingSynchronousCalls-off
	// BSLLS:FileSystemAccess-off
	УдалитьФайлы(ПутьКФайлу);
	// BSLLS:FileSystemAccess-on
	// BSLLS:UsingSynchronousCalls-on
	
КонецПроцедуры

