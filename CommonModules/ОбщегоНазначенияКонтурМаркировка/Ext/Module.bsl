// #Область СлужебныйПрограммныйИнтерфейс

// Формирует ссылку по уникальному идентификатору и полному имени объекта
//
// Параметры:
//  Идентификатор - УникальныйИдентификатор - уникальный идентификатор объекта;
//  ПолноеИмя - Строка - полное имя объекта метаданных, пример: "Справочник.Организации";
// 
// Возвращаемое значение:
//  СправочникСсылка, ДокументСсылка - ссылка на объект;
//
Функция СсылкаПоИдентификатору(Идентификатор, ПолноеИмя) Экспорт
	
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Менеджер = МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
	Если Менеджер = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(Идентификатор) = Тип("ДвоичныеДанные") Тогда
		// Такое может быть в обработке представления в обычных формах
		УникальныйИдентификатор = УникальныйИдентификаторИзДвоичныхДанных(Идентификатор);
	Иначе
		УникальныйИдентификатор = Идентификатор;
	КонецЕсли;
	
	Возврат Менеджер.ПолучитьСсылку(УникальныйИдентификатор);
	
КонецФункции

// Создает новый уникальный идентификатор с меткой времени,
// используется для оптимизации вставки в кластерный индекс
// 
// Возвращаемое значение:
//  УникальныйИдентификатор
//
Функция НовыйУникальныйИдентификаторПервойВерсии() Экспорт
	
	Возврат Справочники.КонтурМаркировка_Файлы.ПолучитьСсылку().УникальныйИдентификатор();
	
КонецФункции

// Возвращает менеджер объекта по полному имени объекта метаданных
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных, пример: "Справочник.Организации";
//
// Возвращаемое значение:
//  СправочникМенеджер, ДокументМенеджер, Перечисление, ПланВидовХарактеристик - менеджер объекта;
//
Функция МенеджерОбъектаПоПолномуИмени(ПолноеИмя) Экспорт
	
