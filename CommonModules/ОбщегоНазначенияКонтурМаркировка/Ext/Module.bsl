// Создает объект внешней обработки без предупреждения об опасных действиях
//
// Параметры:
//  ДанныеФайла - Строка, ДвоичныеДанные - путь к файлу или двоичные данные внешней обработки;
//
// Возвращаемое значение:
//  ВнешняяОбработка - объект внешней обработки
//
Функция СоздатьВнешнююОбработкуБезПредупреждений(ДанныеФайла) Экспорт
	
	Если Не ЗначениеЗаполнено(ДанныеФайла) Тогда
		ВызватьИсключение НСтр(
		"ru = 'Не удалось создать внешнюю обработку, не указаны данные файла'");
	КонецЕсли;
	
	Если ТипЗнч(ДанныеФайла) = Тип("Строка") Тогда
		Возврат ВнешниеОбработки_СоздатьИзФайла(ДанныеФайла);
	Иначе
		Возврат ВнешниеОбработки_СоздатьИзДвоичныхДанных(ДанныеФайла);
	КонецЕсли;
	
КонецФункции

// Подключает внешнюю обработку в метаданные сеанса без предупреждения об опасных действиях
//
// Параметры:
//  ДанныеОбработки - Строка, ДвоичныеДанные - адрес во временном хранилище или двоичные данные обработки;
//  ИмяОбработки   - Строка - (необязательный) имя обработки, с которым она будет подключена;
//
// Возвращаемое значение:
//  Строка - имя подключенной внешней обработки
//
Функция ПодключитьВнешнююОбработкуБезПредупреждений(ДанныеОбработки, ИмяОбработки = Неопределено) Экспорт
	
	БезопасныйРежим = Ложь;
	
	Если ТипЗнч(ДанныеОбработки) = Тип("ДвоичныеДанные") Тогда
		АдресОбработки = ПоместитьВоВременноеХранилище(ДанныеОбработки);
	Иначе
		АдресОбработки = ДанныеОбработки;
	КонецЕсли;
	
	Если ОбщегоНазначенияКонтурМаркировкаПовтИсп.ЕстьЗащитаОтОпасныхДействий() Тогда
		
		ЗащитаБезПредупреждений = ОбщегоНазначенияКонтурМаркировкаПовтИсп.ОписаниеЗащитыБезПредупреждений();
		
		Результат = ВнешниеОбработки.Подключить(АдресОбработки, ИмяОбработки, БезопасныйРежим, ЗащитаБезПредупреждений);
		
	Иначе
		
		Результат = ВнешниеОбработки.Подключить(АдресОбработки, ИмяОбработки, БезопасныйРежим);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Создает по имени заранее подключенную внешнюю обработку
//
// Параметры:
//  ИмяОбработки - Строка - имя, по которому обработка была подключена в метаданные сеанса
//
// Возвращаемое значение:
//  ВнешняяОбработка - объект созданной внешней обработки
//
Функция СоздатьВнешнююОбработкуПоИмени(ИмяОбработки) Экспорт
	
