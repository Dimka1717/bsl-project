// Преобразует двоичные данные уникального идентификатора в значение
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - двоичные данные уникального идентификатора
// 
// Возвращаемое значение:
//  УникальныйИдентификатор - значение уникального идентификатора
//
Функция УникальныйИдентификаторИзДвоичныхДанных(ДвоичныеДанные)
	
	ОбратныйИД = СтрЗаменить(Строка(ДвоичныеДанные), " ", "");
	
	ПрямойИД = Сред(ОбратныйИД, 25, 8) + "-"
	+ Сред(ОбратныйИД, 21, 4) + "-"
	+ Сред(ОбратныйИД, 17, 4) + "-"
	+ Сред(ОбратныйИД, 1, 4) + "-"
	+ Сред(ОбратныйИД, 5, 12);
	
	Возврат Новый УникальныйИдентификатор(ПрямойИД);
	
КонецФункции

