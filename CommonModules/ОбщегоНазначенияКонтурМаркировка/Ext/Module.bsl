
#Если Сервер Или ТолстыйКлиентУправляемоеПриложение Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Признак "Клиент (управляемое приложение)" и инструкция препроцессора установлены
// для поддержки толстого клиента в управляемом приложении в режиме клиент-сервер
// Смотрите п.2 в статье ИТС https://its.1c.ru/db/v8std#content:680:hdoc

// #Область ПрограммныйИнтерфейс

// Безопасно читает свойство объекта, даже если объект не определен
//
// Параметры:
//  Объект - Произвольное - любой объект;
//  ИмяПоля - Строка - имя поля;
//  ЗначениеПоУмолчанию - Произвольный - (необязательный) возвращается,
//            если у объекта нет такого поля или значение Неопределено;
// 
// Возвращаемое значение:
//  Произвольное - значение поля
//
Функция СвойствоОбъекта(Объект, ИмяПоля, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Попытка
		
		Результат = Объект[ИмяПоля];
		
		Если Результат = Неопределено Тогда
			Результат = ЗначениеПоУмолчанию;
		КонецЕсли;
		
	Исключение
		Результат = ЗначениеПоУмолчанию;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// #Область СтроковыеФункции

// Разделяет строку на части по указанному разделителю
//
// Параметры:
//  Строка - Строка - разделяемый текст;
//  Разделитель - Строка - (необязательный) значение разделителя;
//  ВключатьПустые - Булево - Истина, если пустые части нужно включить в результат;
// 
// Возвращаемое значение:
//  Массив - содержит части текста
//
Функция РазделитьСтроку(Знач Строка, Разделитель = ",", ВключатьПустые = Ложь) Экспорт
	
	ДлинаРазделителя = СтрДлина(Разделитель);
	
	Если ДлинаРазделителя = 1
		И Не ВерсияПлатформыНиже("8.3.6")
		И Не ВерсияРежимаСовместимостиНиже("8.3.6") Тогда
		
		Результат = Вычислить("СтрРазделить(Строка, Разделитель, ВключатьПустые)");
		
		Для Сч = 0 По Результат.ВГРаница() Цикл
			Результат[Сч] = СокрЛП(Результат[Сч]);
		КонецЦикла;
		
		Возврат Результат;
		
	КонецЕсли;
	
	Результат = Новый Массив;
	
	Пока Истина Цикл
		
		Поз = Найти(Строка, Разделитель);
		
		Если Поз = 0 Тогда
			ЧастьСтроки = СокрЛП(Строка);
			Строка = "";
		Иначе
			ЧастьСтроки = СокрЛП(Лев(Строка, Поз - 1));
			Строка = Сред(Строка, Поз + ДлинаРазделителя);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЧастьСтроки) Или ВключатьПустые Тогда
			Результат.Добавить(ЧастьСтроки);
		КонецЕсли;
		
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Соединяет части в одну строку с указанным разделителем
// По аналогии с методом платформы СтрСоединить
// 
// Параметры:
//  ЧастиСтроки - Массив - части строки;
//  Разделитель - Строка - (необязательный) разделитель строк;
//
// Возвращаемое значение:
//  Строка - строка состоящая из всех частей
//
Функция СоединитьСтроку(ЧастиСтроки, Разделитель = "") Экспорт
	
	Если Не ВерсияПлатформыНиже("8.3.6")
		И Не ВерсияРежимаСовместимостиНиже("8.3.6") Тогда
		Результат = Вычислить("СтрСоединить(ЧастиСтроки, Разделитель)");
		Возврат Результат;
	КонецЕсли;
	
	Результат = "";
	ТекРазделитель = "";
	
	Если ЗначениеЗаполнено(ЧастиСтроки) Тогда
		Для Каждого ЧастьСтроки Из ЧастиСтроки Цикл
			Если ЗначениеЗаполнено(ЧастьСтроки) Тогда
				Результат = Результат + ТекРазделитель + ЧастьСтроки;
				ТекРазделитель = Разделитель;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Подставляет в строку до 5 параметров
//
// Параметры:
//  ШаблонСтроки - Строка - шаблон с маркерами подстановки: "%1..%5";
//  Параметр1 - Строка - параметр №1;
//  Параметр2 - Строка - (необязательный) параметр №2;
//  Параметр3 - Строка - (необязательный) параметр №3;
//  Параметр4 - Строка - (необязательный) параметр №4;
//  Параметр5 - Строка - (необязательный) параметр №5;
//
// Возвращаемое значение:
//   Строка - строка шаблона с подставленными параметрами
//
Функция ПараметрыВСтроку(ШаблонСтроки, Параметр1
	, Параметр2 = Неопределено
	, Параметр3 = Неопределено
	, Параметр4 = Неопределено
	, Параметр5 = Неопределено) Экспорт
	
	ЕстьПараметрыСПроцентом =
	Найти(Параметр1, "%") > 0
	Или Найти(Параметр2, "%") > 0
	Или Найти(Параметр3, "%") > 0
	Или Найти(Параметр4, "%") > 0
	Или Найти(Параметр5, "%") > 0;
	
	Если ЕстьПараметрыСПроцентом Тогда
		Возврат ПараметрыСПроцентомВСтроку(ШаблонСтроки
		, Параметр1, Параметр2, Параметр3, Параметр4, Параметр5);
	КонецЕсли;
	
	Результат = СтрЗаменить(ШаблонСтроки, "%1", Параметр1);
	Результат = СтрЗаменить(Результат	, "%2", Параметр2);
	Результат = СтрЗаменить(Результат	, "%3", Параметр3);
	Результат = СтрЗаменить(Результат	, "%4", Параметр4);
	Результат = СтрЗаменить(Результат	, "%5", Параметр5);
	
	Возврат Результат;
	
КонецФункции

