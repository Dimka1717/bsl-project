// #Область ПодключениеВнешнейОбработки

// Создает внешнюю обработку из файла на диске
//
// Параметры:
//  ПутьКФайлу - Строка - путь к файлу обработки
//
// Возвращаемое значение:
//  ОбработкаОбъект - объект созданной внешней обработки
//
Функция ВнешниеОбработки_СоздатьИзФайла(ПутьКФайлу)
	
	БезопасныйРежим = Ложь;
	
	Если Не ВерсияПлатформыНиже("8.3.11")
		И ОбщегоНазначенияКонтурМаркировкаПовтИсп.ЕстьЗащитаОтОпасныхДействий() Тогда
		
		ЗащитаБезПредупреждений = ОбщегоНазначенияКонтурМаркировкаПовтИсп.ОписаниеЗащитыБезПредупреждений();
		
		Результат = ВнешниеОбработки.Создать(ПутьКФайлу, БезопасныйРежим, ЗащитаБезПредупреждений);
		
	ИначеЕсли Не ВерсияПлатформыНиже("8.3") Тогда
		
		Результат = ВнешниеОбработки.Создать(ПутьКФайлу, БезопасныйРежим);
		
	Иначе
		
		Результат = ВнешниеОбработки.Создать(ПутьКФайлу);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Создает внешнюю обработку из двоичных данных
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - двоичные данные обработки
//
// Возвращаемое значение:
//  ОбработкаОбъект - объект созданной внешней обработки
//
Функция ВнешниеОбработки_СоздатьИзДвоичныхДанных(ДвоичныеДанные)
	
	Если ОбщегоНазначенияКонтурМаркировкаПовтИсп.ЭтоОбычноеПриложение() Тогда
		
		ИмяВремФайла = ПолучитьИмяВременногоФайла("epf");
		ДвоичныеДанные.Записать(ИмяВремФайла);
		Результат = ВнешниеОбработки_СоздатьИзФайла(ИмяВремФайла);
		
		УдалитьФайл(ИмяВремФайла);
		
	Иначе
		
		АдресОбработки = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		ИмяОбработки = ПодключитьВнешнююОбработкуБезПредупреждений(АдресОбработки);
		Результат = СоздатьВнешнююОбработкуПоИмени(ИмяОбработки);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

