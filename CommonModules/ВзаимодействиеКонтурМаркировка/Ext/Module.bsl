// Выполняет команду обработки без использования БСП,
// используется для вызова в фоновом задании
//
// Параметры:
//  ПараметрыКоманды - Структура - обязательно содержит:
//   * ИдентификаторКоманды - идентификатор команды;
//  ОписаниеОбработки - Структура - (необязательный) содержит:
//   * ПутьКФайлу - Строка - путь к файлу обработки;
//   * ДвоичныеДанные - ДвоичныеДанные - двоичные данные обработки;
//  АдресРезультата - Строка - (необязательный) адрес из временного хранилища,
//                                              куда нужно поместить результат;
//
Процедура ВыполнитьЗадание(ПараметрыКоманды, ОписаниеОбработки = Неопределено, АдресРезультата = "") Экспорт
	
	Если ОписаниеОбработки = Неопределено Тогда
		
		Модуль = МодульКонтурМаркировка();
		
	Иначе
		
		ПутьКФайлу = ОписаниеОбработки.ПутьКФайлу;
		ИмяОбработки = ОписаниеОбработки.ИмяОбработки;
		ДвоичныеДанные = ОписаниеОбработки.ДвоичныеДанные;
		
		Если ОбщегоНазначенияКонтурМаркировка.ФайлСуществует(ПутьКФайлу) Тогда
			
			Модуль = ОбщегоНазначенияКонтурМаркировка.СоздатьВнешнююОбработкуБезПредупреждений(ПутьКФайлу);
			
		ИначеЕсли ЗначениеЗаполнено(ИмяОбработки)
			И Метаданные.Обработки.Найти(ИмяОбработки) <> Неопределено Тогда
			
			Модуль = ОбщегоНазначенияКонтурМаркировка.СоздатьОбработкуИзКонфигурации(ИмяОбработки);
			
		ИначеЕсли ЗначениеЗаполнено(ДвоичныеДанные) Тогда
			
			Модуль = ОбщегоНазначенияКонтурМаркировка.СоздатьВнешнююОбработкуБезПредупреждений(ДвоичныеДанные);
			
		Иначе
			
			ТекстОшибки = НСтр("ru = 'Не удалось подключить внешнюю обработку при выполнении фонового заданиия '") + ИмяОбработки;
			
			ВызватьИсключение ТекстОшибки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ПараметрыКоманды.Свойство("РезультатВыполнения") Тогда
		ПараметрыКоманды.Вставить("РезультатВыполнения", Новый Структура);
	КонецЕсли;
	
	Модуль.ВыполнитьКоманду(ПараметрыКоманды.ИдентификаторКоманды, ПараметрыКоманды);
	
	Если ЗначениеЗаполнено(АдресРезультата) Тогда
		ПоместитьВоВременноеХранилище(ПараметрыКоманды.РезультатВыполнения, АдресРезультата);
	КонецЕсли;
	
КонецПроцедуры

// Вызыват одноименное событие ПМ
//
// Параметры:
//  ДопПараметры - Произвольный - дополнительные параметры, которые можно передать в ПМ
//
Процедура ВыполнитьРегламентныеДействия(ДопПараметры = Неопределено) Экспорт
	
	Модуль = МодульКонтурМаркировка();
	Команды = Модуль.Перечисление_КомандыОбработки();
	ИдентификаторКоманды = Команды.ВыполнитьРегламентныеДействия;
	
	Модуль.ВыполнитьКоманду(ИдентификаторКоманды, ДопПараметры);
	
КонецПроцедуры

// Создает объект обработки Контур.Маркировка
//
// Параметры:
//  ОтключитьИнициализацию - Булево - (необязательный) Ложь, если инициализацию модуля выполнять не нужно;
// 
// Возвращаемое значение:
//  ОбработкаОбъект - модуль маркировки
//
Функция МодульКонтурМаркировка(ОтключитьИнициализацию = Ложь) Экспорт
	
	ИдентификаторСеанса = ПараметрыСессии_Прочитать("ИдентификаторСеанса");
	Если Не ЗначениеЗаполнено(ИдентификаторСеанса) И Не ОтключитьИнициализацию Тогда
		ИдентификаторСеанса = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	Результат = ВзаимодействиеКонтурМаркировкаПовтИсп.МодульКонтурМаркировка(Строка(ИдентификаторСеанса));
	
	Если Не ОтключитьИнициализацию
		И Не Результат.МодульИнициализирован(ИдентификаторСеанса) Тогда
		Результат.Инициализировать(ИдентификаторСеанса);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

