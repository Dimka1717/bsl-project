&НаКлиенте
Функция Команда_ФайлСертификата(ОтпечатокСертификата)
	
	cert = Новый_certificate(ОтпечатокСертификата);
	properties = Новый Структура("content", Новый_content("base64"));
	
	Результат = Команда_cert_parse(cert, properties);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Команда_ДанныеСертификата(ОтпечатокСертификата)
	
	cert = Новый_certificate(ОтпечатокСертификата);
	properties = Новый_certificateProperties();
	
	Результат = Команда_cert_parse(cert, properties);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Команда_ЕстьЗакрытыйКлючСертификата(ОтпечатокСертификата)
	
	ПараметрыПоиска = ПараметрыПоискаСертификатов();
	ПараметрыПоиска.ТолькоПервый = Истина;
	ПараметрыПоиска.ЕстьЗакрытыйКлюч = Истина;
	ПараметрыПоиска.Отпечаток = ОтпечатокСертификата;
	
	filter = Новый_cert_filter(ПараметрыПоиска);
	properties = Новый Структура("hash", Истина);
	
	Результат = Команда_cert_search(filter, properties);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Команда_ПодписатьДанные(Данные, ОтпечатокСертификата, ПрисоединитьПодпись)
	
	source = Новый_MultiContent("base64", Данные);
	sink = Новый_content("base64");
	cert = Новый_certificate(ОтпечатокСертификата);
	
	РезультатДвоичныеДанные = ТипЗнч(Данные[0]) = Тип("ДвоичныеДанные");
	
	Результат = Команда_crypto_batch_sign(source, sink, cert, ПрисоединитьПодпись, РезультатДвоичныеДанные);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Команда_РасшифроватьКонтент(Контент)
	
	source = Новый_content("base64", Контент);
	sink = Новый_content("base64");
	
	РезультатДвоичныеДанные = ТипЗнч(Контент) = Тип("ДвоичныеДанные");
	
	Результат = Команда_crypto_decrypt(source, sink, РезультатДвоичныеДанные);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Команда_ХешСуммаСтроки(Строка, ТипХешФункции)
	
	data = Новый_content("string", Строка);
	sink = Новый_content("base64");
	
	Результат = Команда_crypto_hash(data, sink, ТипХешФункции);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Команда_ХешСуммыСтрок(МассивСтрок, ТипХешФункции)
	
	source = Новый_MultiContent("string", МассивСтрок);
	sink = Новый_content("base64");
	
	Результат = Команда_crypto_batch_hash(source, ТипХешФункции);
	Результат.sinks.Добавить(sink);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Команда_НайтиСовпаденияПоШаблону(Строка, Шаблон)
	
	Результат = Команда_stringSearch(Строка, Шаблон);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Команда_КартинкиШтрихкодов(ПараметрыКартинки, Штрихкоды)
	
	source = Новый_MultiContent("string", Штрихкоды);
	
	Результат = Команда_barcode_batch_write(source);
	
	Результат.barcode = ТипШтрихкодаВТерминахПлагина(ПараметрыКартинки.ТипШтрихкода);
	Результат.rotate = ПараметрыКартинки.УголПоворота;
	
	Если ПараметрыКартинки.УголПоворота = 0
		Или ПараметрыКартинки.УголПоворота = 180 Тогда
		Результат.width = ПараметрыКартинки.Ширина;
		Результат.height = ПараметрыКартинки.Высота;
	Иначе
		Результат.width = ПараметрыКартинки.Высота;
		Результат.height = ПараметрыКартинки.Ширина;
	КонецЕсли;
	
	Результат.quiet_zone = ПараметрыКартинки.ДобавитьОтступ;
	Результат.fit = ПараметрыКартинки.ПодогнатьРазмер;
	
	//Если ПараметрыКартинки.ОтображатьТекст Тогда
	//	font = Новый_font();
	//	font.name = ПараметрыКартинки.Шрифт;
	//	font.size = ПараметрыКартинки.РазмерШрифта;
	//	Результат.Вставить("font", font);
	//КонецЕсли;
	
	imgContent = Новый_imgContent(ПараметрыКартинки.ФорматИзображения);
	Результат.render_to.Добавить(imgContent);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Новый_ОписаниеСертификата(certificate_info)
	
	Результат = Новый Структура;
	
	hash			 = certificate_info["hash"];
	serialNumber	 = certificate_info["serialNumber"];
	issuer			 = certificate_info["issuer"];
	subject			 = certificate_info["subject"];
	content			 = certificate_info["content"];
	validFrom		 = certificate_info["validFrom"];
	validTo			 = certificate_info["validTo"];
	hasPrivateKey	 = certificate_info["hasPrivateKey"];
	extensions		 = certificate_info["extensions"];
	keyAlgorithm	 = certificate_info["keyAlgorithm"];
	
	Результат.Вставить("ДатаНачала");
	Результат.Вставить("ДатаОкончания");
	Результат.Вставить("ДвоичныеДанные");
	Результат.Вставить("ЕстьЗакрытыйКлюч");
	Результат.Вставить("Отпечаток", hash["data"]);
	
	Если issuer <> Неопределено Тогда
		
		Издатель = Новый Соответствие;
		Издатель.Вставить("CN", issuer["CN"]);
		
		Результат.Вставить("Издатель", Издатель);
		
	КонецЕсли;
	
	Если subject <> Неопределено Тогда
		
		Субъект = Новый Соответствие;
		Субъект.Вставить("_1_2_840_113549_1_9_2", subject["_1_2_840_113549_1_9_2"]);
		Субъект.Вставить("CN", subject["CN"]);
		Субъект.Вставить("G", subject["G"]);
		Субъект.Вставить("O", subject["O"]);
		Субъект.Вставить("SN", subject["SN"]);
		Субъект.Вставить("T", subject["T"]);
		Субъект.Вставить("ИНН", subject["ИНН"]);
		Субъект.Вставить("ИННЮЛ", subject["ИННЮЛ"]);
		Субъект.Вставить("ОГРН", subject["ОГРН"]);
		Субъект.Вставить("ОГРНИП", subject["ОГРНИП"]);
		
		Результат.Вставить("Субъект", Субъект);
		
	КонецЕсли;
	
	Если validFrom <> Неопределено Тогда
		Результат.ДатаНачала = ДатаИзСтрокиXML(validFrom);
	КонецЕсли;
	
	Если validTo <> Неопределено Тогда
		Результат.ДатаОкончания = ДатаИзСтрокиXML(validTo);
	КонецЕсли;
	
	Если hasPrivateKey <> Неопределено Тогда
		Результат.ЕстьЗакрытыйКлюч = БулевоИзСтрокиJSON(hasPrivateKey);
	КонецЕсли;
	
	Если content <> Неопределено Тогда
		Результат.ДвоичныеДанные = Base64Значение(content["data"]);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // КомандыМодуля

// #Область КомандыВТерминахПлагина

&НаКлиенте
Функция Команда_cert_search(filter, properties = Неопределено)
	
	Результат = Новый_command("cert.search");
	Результат.Вставить("filter", filter);
	
	Если ЗначениеЗаполнено(properties) Тогда
		Результат.Вставить("properties", properties);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Команда_cert_parse(cert, properties)
	
	Результат = Новый_command("cert.parse");
	
	Результат.Вставить("cert", cert);
	
	Если ЗначениеЗаполнено(properties) Тогда
		Результат.Вставить("properties", properties);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Команда_crypto_batch_sign(source, sink, cert, attached, РезультатДвоичныеДанные)
	
	Результат = Новый_command("crypto.batch.sign", РезультатДвоичныеДанные);
	Результат.Вставить("source", source);
	Результат.Вставить("sinks", ЗначениеВМассиве(sink));
	Результат.Вставить("certs", ЗначениеВМассиве(cert));
	Результат.Вставить("attached", attached);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Команда_crypto_decrypt(source, sink, РезультатДвоичныеДанные)
	
	Результат = Новый_command("crypto.decrypt", РезультатДвоичныеДанные);
	Результат.Вставить("source", source);
	Результат.Вставить("sink", sink);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Команда_crypto_hash(data, sink, hash_type)
	
	Результат = Новый_command("crypto.hash");
	Результат.Вставить("data", data);
	Результат.Вставить("sink", sink);
	Результат.Вставить("hash_type", hash_type);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Команда_crypto_batch_hash(source, hash_type)
	
	Результат = Новый_command("crypto.batch.hash");
	Результат.Вставить("source", source);
	Результат.Вставить("sinks", Новый Массив);
	Результат.Вставить("hash_type", hash_type);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Команда_barcode_batch_write(source)
	
	Результат = Новый_command("barcode.batch.write", Истина);
	Результат.Вставить("barcode"	, "");
	Результат.Вставить("width"		, 0);
	Результат.Вставить("height"		, 0);
	Результат.Вставить("rotate"		, 0);
	Результат.Вставить("quiet_zone"	, Ложь);
	Результат.Вставить("fit"		, Ложь);
	Результат.Вставить("render_to"	, Новый Массив);
	Результат.Вставить("source"		, source);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Команда_stringSearch(string, regex)
	
	Результат = Новый_command("string.search");
	Результат.Вставить("string", string);
	Результат.Вставить("regex", regex);
	Результат.Вставить("submatches", Ложь);
	Результат.Вставить("details", Ложь);
	
	Возврат Результат;
	
КонецФункции

