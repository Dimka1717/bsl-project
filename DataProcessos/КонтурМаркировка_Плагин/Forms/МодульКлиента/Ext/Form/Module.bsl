&НаКлиенте
Функция ОбъектКонтурПлагина()
	
	Попытка
		Результат = СоздатьОбъектКонтурПлагина();
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	
	Если Результат = Неопределено Тогда
		ПодключитьКомпонентуКонтурПлагина();
		Результат = СоздатьОбъектКонтурПлагина();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СоздатьОбъектКонтурПлагина()
	
	Результат = Новый("AddIn." + ИмяКомпонентыКонтурПлагина() + ".Kontur.1C.Plugin.SA");
	
	Результат.Type = "json";
	
	ПроверитьВерсиюКонтурПлагина(Результат);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПодключитьКомпонентуКонтурПлагина()
	
	КомпонентаПодключена = ПодключитьКомпонентуИзМакета(ИмяКомпонентыКонтурПлагина(), ПутьКМакетуКонтурПлагина());
	
	Если Не КомпонентаПодключена Тогда
		ВызватьИсключение НСтр(
		"ru = 'Не удалось подключить внешнюю компоненту Контур.Плагина'");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ИмяКомпонентыКонтурПлагина()
	
	Возврат "KonturPluginMark" + "_" + СтрЗаменить(ВерсияПлагина(), ".", "_");
	
КонецФункции

&НаКлиенте
Функция ПутьКМакетуКонтурПлагина()
	
	Возврат ПутьКМакетамОбработки() + "KonturPlugin_zip";
	
КонецФункции

&НаКлиенте
Процедура ПроверитьВерсиюКонтурПлагина(ОбъектПлагина)
	
	ТребуемаяВерсия = ВерсияПлагина();
	ТекущаяВерсия = ОбъектПлагина.Version;
	
	Если СравнитьВерсии(ТекущаяВерсия, ТребуемаяВерсия) <> 0 Тогда
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Некорректная версия подключенного Контур.Плагина
		|Требуемая версия: %1
		|Текущая версия: %2'")
		, ТребуемаяВерсия
		, ТекущаяВерсия);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
КонецПроцедуры

