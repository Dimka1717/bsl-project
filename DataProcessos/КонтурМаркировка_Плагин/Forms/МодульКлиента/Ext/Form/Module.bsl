// Расчитывает хеш-суммы строк
//
// Параметры:
//  Строки - Массив - строки, по которым нужно посчитать хеш-сумму;
//  ТипХешФункции - Строка - см. Перечисление_ТипыХешФункций();
//
// Возвращаемое значение:
//  Массив из Строка - хеш-суммы в base64, в том же порядке что и массив строк
//
&НаКлиенте
Функция ХешСуммыСтрок(Строки, ТипХешФункции) Экспорт
	
	Плагин = ОбъектКонтурПлагина();
	ВсегоСтрок = Строки.Количество();
	Результат = Новый Массив;
	МассивЗадач = Новый Массив;
	ПорцияСтрок = Новый Массив;
	МаксимумЗадач = 15; // Предохранитель перегрузки
	РазмерПорции = 15; // Органичитель расхода памяти
	
	Для Сч = 1 По ВсегоСтрок Цикл
		
		ПорцияСтрок.Добавить(Строки[Сч - 1]);
		
		Если Сч % РазмерПорции = 0 Или Сч = ВсегоСтрок Тогда
			
			Команда = Команда_ХешСуммыСтрок(ПорцияСтрок, ТипХешФункции);
			МассивЗадач.Добавить(НачатьАсинхроннуюЗадачу(Команда, Плагин));
			ПорцияСтрок.Очистить();
			
			Если МассивЗадач.Количество() = МаксимумЗадач
				Или АсинхроннаяЗадачаВыполнена(МассивЗадач[0], Плагин) Тогда
				Ответ = РезультатАсинхроннойЗадачи(МассивЗадач[0], Плагин);
				ДополнитьМассив(Результат, РазобратьКоллекциюОтветов(Ответ, "hashes"));
				МассивЗадач.Удалить(0);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого ИдентификаторЗадачи Из МассивЗадач Цикл
		Ответ = РезультатАсинхроннойЗадачи(ИдентификаторЗадачи, Плагин);
		ДополнитьМассив(Результат, РазобратьКоллекциюОтветов(Ответ, "hashes"));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Ищет в строке совпадения по шаблону с регулярными выражениями
//
// Параметры:
//  Строка - Строка - строка, в которой нужно найти совпадения;
//  Шаблон - Строка - шаблон с регулярными выражениями;
// 
