&НаКлиенте
Функция ТипШтрихкодаВТерминахПлагина(ТипШтрихкода)
	
	DataMatrix = ПредопределенноеЗначение("Перечисление.КонтурМаркировка_ТипыШтрихкодов.GS1_DataMatrix");
	Code128 = ПредопределенноеЗначение("Перечисление.КонтурМаркировка_ТипыШтрихкодов.Code128");
	GS1_128 = ПредопределенноеЗначение("Перечисление.КонтурМаркировка_ТипыШтрихкодов.GS1_128");
	EAN13 = ПредопределенноеЗначение("Перечисление.КонтурМаркировка_ТипыШтрихкодов.EAN13");
	SSCC = ПредопределенноеЗначение("Перечисление.КонтурМаркировка_ТипыШтрихкодов.SSCC");
	
	Если ТипШтрихкода = DataMatrix Тогда
		Результат = "GS1_DataMatrix";
	ИначеЕсли ТипШтрихкода = GS1_128 Или ТипШтрихкода = SSCC Тогда
		Результат = "GS1_Code128";
	ИначеЕсли ТипШтрихкода = Code128 Тогда
		Результат = "Code128";
	ИначеЕсли ТипШтрихкода = EAN13 Тогда
		Результат = "EAN13";
	Иначе
		ТекстОшибки = НСтр("ru = 'Не удалось определить тип штрихкода в терминах плагина: %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ТипШтрихкода);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

