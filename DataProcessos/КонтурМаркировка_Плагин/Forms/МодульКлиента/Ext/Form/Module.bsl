// Подписывает данные указанным сертификатом
//
// Параметры:
//  Данные - Массив - ДвоичныеДанные файлов или строки в формате base64, которые нужно подписать;
//  ОтпечатокСертификата - Строка - отпечаток сертификата, которым нужно подписать;
//  ПрисоединитьПодпись - Булево - Истина, если контент и подпись должны быть в одном файле;
//
// Возвращаемое значение:
//  Массив из ДвоичныеДанные - подписи, в том же порядке что и массив файлов
//  Массив из Строка - подписи, в том же порядке что и массив файлов (base64)
//
&НаКлиенте
Функция ПодписатьДанные(Данные, ОтпечатокСертификата, ПрисоединитьПодпись = Ложь) Экспорт
	
	РазмерПорции = 20;
	ПорцияДанных = Новый Массив;
	ВсегоДанных = Данные.Количество();
	Результат = Новый Массив;
	Плагин = ОбъектКонтурПлагина();
	
	Для Сч = 1 По ВсегоДанных Цикл
		
		ПорцияДанных.Добавить(Данные[Сч - 1]);
		
		Если Сч % РазмерПорции = 0 Или Сч = ВсегоДанных Тогда
			Команда = Команда_ПодписатьДанные(ПорцияДанных, ОтпечатокСертификата, ПрисоединитьПодпись);
			Ответ = ВыполнитьКоманду(Команда, Плагин);
			Подписи = РазобратьКоллекциюОтветов(Ответ, "signatures");
			ДополнитьМассив(Результат, Подписи);
			ПорцияДанных.Очистить();
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Выполняет расшифровку контента
