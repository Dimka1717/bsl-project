// Формирует картинки штрихкодов
//
// Параметры:
//  Штрихкоды - Массив - содержит значения штрихкодов;
//  ПараметрыКартинки - Структура - см. ПараметрыКартинкиШтрихкода();
//  ТолькоЧерезПлагин - Булево - (необязательный) Истина, если использовать компоненту 1С нельзя;
// 
// Возвращаемое значение:
//  Массив - содержит двоичные данные картинок штрихкодов,
//      в том же порядке что и входящий массив штрихкодов
//
&НаКлиенте
Функция КартинкиШтрихкодов(Штрихкоды, ПараметрыКартинки, ТолькоЧерезПлагин = Ложь) Экспорт
	
	ПроверитьКорректностьУглаПоворотаШтрихкодов(ПараметрыКартинки);
	
	// Пока QR не поддерживается в КонтурПлагине
	Если ПараметрыКартинки.ТипШтрихкода = ПредопределенноеЗначение("Перечисление.КонтурМаркировка_ТипыШтрихкодов.QR") Тогда
		Возврат КартинкиШтрихкодовЧерезКомпоненту(Штрихкоды, ПараметрыКартинки);
	КонецЕсли;
	
	// Пока GS1-DataBar Expanded Stacked не поддерживается в КонтурПлагине
	Если ПараметрыКартинки.ТипШтрихкода = ПредопределенноеЗначение("Перечисление.КонтурМаркировка_ТипыШтрихкодов.GS1_DataBarExpandedStacked") Тогда
		Возврат КартинкиШтрихкодовЧерезКомпоненту(Штрихкоды, ПараметрыКартинки);
	КонецЕсли;
	
	Если Не ТолькоЧерезПлагин
		И Не ПечататьШтрихкодовЧерезПлагинДоступна() Тогда
		Возврат КартинкиШтрихкодовЧерезКомпоненту(Штрихкоды, ПараметрыКартинки);
	КонецЕсли;
	
	Плагин = ОбъектКонтурПлагина();
	ВсегоШтрихкодов = Штрихкоды.Количество();
	Результат = Новый Массив;
	МассивЗадач = Новый Массив;
	ПорцияШтрихкодов = Новый Массив;
	МаксимумЗадач = 25; // Предохранитель перегрузки
	РазмерПорции = 4; // Органичитель расхода памяти
	
	Для Сч = 1 По ВсегоШтрихкодов Цикл
		
		ПорцияШтрихкодов.Добавить(Штрихкоды[Сч - 1]);
		
		Если Сч % РазмерПорции = 0 Или Сч = ВсегоШтрихкодов Тогда
			
			Команда = Команда_КартинкиШтрихкодов(ПараметрыКартинки, ПорцияШтрихкодов);
			МассивЗадач.Добавить(НачатьАсинхроннуюЗадачу(Команда, Плагин));
			ПорцияШтрихкодов.Очистить();
			
			Если МассивЗадач.Количество() = МаксимумЗадач
				Или АсинхроннаяЗадачаВыполнена(МассивЗадач[0], Плагин) Тогда
				Ответ = РезультатАсинхроннойЗадачи(МассивЗадач[0], Плагин);
				ДополнитьМассив(Результат, РазобратьКоллекциюОтветов(Ответ, "barcodes"));
				МассивЗадач.Удалить(0);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого ИдентификаторЗадачи Из МассивЗадач Цикл
		Ответ = РезультатАсинхроннойЗадачи(ИдентификаторЗадачи, Плагин);
		ДополнитьМассив(Результат, РазобратьКоллекциюОтветов(Ответ, "barcodes"));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Проверяет что через Конутр.Плагин для 1С можно сформировать картинки штрихкодов
// 
// Возвращаемое значение:
//  Булево - Истина, если картинки штрихкодов сформировать получиться
//
&НаКлиенте
Функция ПечататьШтрихкодовЧерезПлагинДоступна() Экспорт
	
	КлючКэш = "ПечататьШтрихкодовЧерезПлагинДоступна";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	DataMatrix = ПредопределенноеЗначение("Перечисление.КонтурМаркировка_ТипыШтрихкодов.GS1_DataMatrix");
	ПараметрыКартинки = ПараметрыКартинкиШтрихкода(DataMatrix);
	ПараметрыКартинки.Ширина = 100;
	ПараметрыКартинки.Высота = 100;
	
	МассивШтрихкодов = ЗначениеВМассиве("0104602443313288215UwoL&");
	Команда = Команда_КартинкиШтрихкодов(ПараметрыКартинки, МассивШтрихкодов);
	
	Попытка
		Плагин = ОбъектКонтурПлагина();
		Ответ = ВыполнитьКоманду(Команда, Плагин);
		МассивКартинок = РазобратьКоллекциюОтветов(Ответ, "barcodes");
		Результат = ЗначениеЗаполнено(МассивКартинок[0]);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Результат = Ложь;
	КонецПопытки;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

// Параметры поиска сертификатов на компьютере
//
// Возвращаемое значение:
//  Структура:
//   Отпечаток             - Строка - (необязательный) отпечаток сертификата;
//   СерийныйНомер         - Строка - (необязательный) серийный номер сертификата;
//   ЕстьЗакрытыйКлюч      - Булево - (необязательный) проверять наличие закрытого ключа;
//   ТолькоПервый          - Булево - (необязательный) возвращать первый найденный сертификат;
//   РасположениеХранилища - Строка - (необязательный) см. Перечисление_РасположениеХранилищСертификатов();
//   ТипХранилища          - Строка - (необязательный) см. Перечисление_ТипыХранилищСертификатов();
&НаКлиенте
Функция ПараметрыПоискаСертификатов() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Отпечаток");
	Результат.Вставить("СерийныйНомер");
	Результат.Вставить("ЕстьЗакрытыйКлюч");
	Результат.Вставить("ТолькоПервый", Ложь);
	
	Результат.Вставить("ТипХранилища", Перечисление_ТипыХранилищСертификатов().ПерсональныеСертификаты);
	Результат.Вставить("РасположениеХранилища", Перечисление_РасположениеХранилищСертификатов().ТекущийПользователь);
	
	Возврат Результат;
	
КонецФункции

// Контракт описания параметров для печати штрихкодов
//
// Параметры:
//  ТипШтрихкода - Перечисления.КонтурМаркировка_ТипыШтрихкодов - тип штрихкодов
// 
// Возвращаемое значение:
//  Структура - содержит свойства:
//   * ТипШтрихкода      - Перечисления.КонтурМаркировка_ТипыШтрихкодов - тип штрихкодов;
//   * ФорматИзображения - Строка - см. Перечисление_ФорматыИзображений();
//   * Ширина            - Число  - ширина картинки в пикселях;
//   * Высота            - Число  - высота картинки в пикселях;
//   * ПодогнатьРазмер   - Булево - Истина, если нужно подгонять размер до ближайшего с точными пропорциями;
//   * УголПоворота      - Число  - угол поворота картинки в градусах,
//                         допустимые значения: 0, 90, 180, 270;
//   * ДобавитьОтступ    - Булево - Истина, если нужно добавить отступ вокруг штрихкода;
//
&НаКлиенте
Функция ПараметрыКартинкиШтрихкода(ТипШтрихкода) Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("ТипШтрихкода", ТипШтрихкода);
	Результат.Вставить("Ширина", 0);
	Результат.Вставить("Высота", 0);
	Результат.Вставить("ПодогнатьРазмер", Ложь);
	Результат.Вставить("УголПоворота", 0);
	//Результат.Вставить("РазмерШрифта", 0);
	Результат.Вставить("ДобавитьОтступ", Ложь);
	//Результат.Вставить("ОтображатьТекст", Ложь);
	//Результат.Вставить("Шрифт");
	
	Результат.Вставить("ФорматИзображения", Перечисление_ФорматыИзображений().PNG);
	
	Возврат Результат;
	
КонецФункции

