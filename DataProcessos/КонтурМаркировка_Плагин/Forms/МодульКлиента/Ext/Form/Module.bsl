&НаКлиенте
Функция ПодключитьКомпонентуИзМакета(ИмяКомпоненты, ПутьКМакету)
	
	КомпонентаПодключена = ПодключитьКомпоненту(ПутьКМакету, ИмяКомпоненты);
	
	#Если Не Сервер Тогда
		Если Не КомпонентаПодключена Тогда
			УстановитьВнешнююКомпоненту(ПутьКМакету);
			КомпонентаПодключена = ПодключитьКомпоненту(ПутьКМакету, ИмяКомпоненты);
		КонецЕсли;
	#КонецЕсли
	
	Возврат КомпонентаПодключена;
	
КонецФункции

&НаКлиенте
Функция ВыполнитьКоманду(Команда, Плагин)
	
	СтрокаЗапроса = ЗначениеВСтрокуJSON(Команда);
	СтрокаОтвета = Плагин.Send(СтрокаЗапроса);
	Результат = ЗначениеИзСтрокиJSON(СтрокаОтвета, Истина);
	
	ПроверитьОтвет(Результат, СтрокаОтвета);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция НачатьАсинхроннуюЗадачу(Команда, Плагин)
	
	ИдентификаторЗадачи = Строка(Новый УникальныйИдентификатор);
	Запрос = ЗначениеВСтрокуJSON(Команда);
	Ответ = Плагин.Send_Async(ИдентификаторЗадачи, Запрос);
	
	Возврат ИдентификаторЗадачи;
	
КонецФункции

&НаКлиенте
Функция РезультатАсинхроннойЗадачи(ИдентификаторЗадачи, Плагин)
	
	Ответ = Плагин.GetResult(ИдентификаторЗадачи);
	Плагин.DeleteResult(ИдентификаторЗадачи);
	
	Результат = ЗначениеИзСтрокиJSON(Ответ, Истина);
	
	ПроверитьОтвет(Результат, Ответ);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция АсинхроннаяЗадачаВыполнена(ИдентификаторЗадачи, Плагин)
	
	Возврат Плагин.HasResult(ИдентификаторЗадачи);
	
КонецФункции

&НаКлиенте
Процедура ПроверитьОтвет(Ответ, СтрокаОтвета)
	
	Если ЗначениеЗаполнено(Ответ["error"]) Тогда
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Ошибка Kontur.1C.Plugin
		|%1'"), СтрокаОтвета);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКорректностьУглаПоворотаШтрихкодов(ОписаниеШтрихкодов)
	
	КратностьУглаПоворота = 90;
	
	Если ОписаниеШтрихкодов.УголПоворота % КратностьУглаПоворота <> 0 Тогда
		
		ТекстОшибки = НСтр(
		"ru = 'Некорректный угол поворота картинки штрихкода: %1
		|Допустимые значения: 0, 90, 180, 270'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ОписаниеШтрихкодов.УголПоворота);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
КонецПроцедуры

