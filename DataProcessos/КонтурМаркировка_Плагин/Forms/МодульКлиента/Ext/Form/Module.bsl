// Считывает данные из строки json
//
// Параметры:
//  Строка                 - Строка - строка json, которую нужно прочитать;
//  ПрочитатьВСоответствие - Булево - Истина, если json нужно прочитать в соответствие;
// 
// Возвращаемое значение:
//  Массив       - если текст json начинается с массива;
//  Структура    - если текст json начинается с пары ключ-значение;
//  Соответствие - если текст json начинается с пары ключ-значение и ПрочитатьВСоответствие = Истина;
//
&НаКлиенте
Функция ЗначениеИзСтрокиJSON(Строка, ПрочитатьВСоответствие = Ложь) Экспорт
	
	Если ЭтоВебКлиент() Или ВерсияПлатформыНиже("8.3.6") Тогда
		Результат = ПарсерJSONДля82_Прочитать(Строка, ПрочитатьВСоответствие);
	Иначе
		Результат = ПарсерJSON_Прочитать(Строка, ПрочитатьВСоответствие);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Записывает значение в строку json
//
// Параметры:
//  Значение - Произвольный - значение, которое надо записать в json
// 
// Возвращаемое значение:
//  Строка - строка в формате json
//
&НаКлиенте
Функция ЗначениеВСтрокуJSON(Значение) Экспорт
	
	Если ЭтоВебКлиент() Или ВерсияПлатформыНиже("8.3.6") Тогда
		Результат = ПарсерJSONДля82_Записать(Значение);
	Иначе
		Результат = ПарсерJSON_Записать(Значение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти

// #Область Парсер83

&НаКлиенте
Функция ПарсерJSON_Прочитать(Строка, ПрочитатьВСоответствие = Ложь)
	
	Результат = Неопределено;
	
	#Если Не ВебКлиент Тогда
	
	Чтение = Новый("ЧтениеJSON");
	Чтение.УстановитьСтроку(Строка);
	
	Попытка
		Результат = Вычислить("ПрочитатьJSON(Чтение, ПрочитатьВСоответствие)");
		ЧерезВременныйФайл = Ложь;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ЧерезВременныйФайл = Истина;
	КонецПопытки;
	
	Чтение.Закрыть();
	
	Если ЧерезВременныйФайл Тогда
		
		ИмяВремФайла = ПолучитьИмяВременногоФайла();
		ТД = Новый ТекстовыйДокумент;
		ТД.УстановитьТекст(Строка);
		ТД.Записать(ИмяВремФайла);
		ТД = Неопределено;
		Чтение = Новый("ЧтениеJSON");
		Чтение.ОткрытьФайл(ИмяВремФайла);
		
		Попытка
			Результат = Вычислить("ПрочитатьJSON(Чтение, ПрочитатьВСоответствие)");
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
		КонецПопытки;
		
		Чтение.Закрыть();
		
		УдалитьФайлы(ИмяВремФайла);
		
	КонецЕсли;
	
	#КонецЕсли
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПарсерJSON_Записать(Значение)
	
	ПараметрыКонструктора = Новый Массив;
	ПараметрыКонструктора.Добавить(Вычислить("ПереносСтрокJSON.Нет"));
	ПараметрыЗаписи = Новый("ПараметрыЗаписиJSON", ПараметрыКонструктора);
	
	Запись = Новый("ЗаписьJSON");
	Запись.УстановитьСтроку(ПараметрыЗаписи);
	
	Выполнить("ЗаписатьJSON(Запись, Значение)");
	
	Результат = Запись.Закрыть();
	
	Возврат Результат;
	
КонецФункции

