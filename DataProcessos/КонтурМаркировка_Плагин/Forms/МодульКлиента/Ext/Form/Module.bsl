	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ВосстановитьТекстыJSON(МассивЭлеменов)
	
	Кавычки = Кавычки();
	
	Для Сч = -МассивЭлеменов.ВГраница() По 0 Цикл
		
		Индекс = -Сч;
		Элемент = СокрЛП(МассивЭлеменов[Индекс]);
		
		ЕстьКавычкиСлева = (Лев(Элемент, 1) = Кавычки) И СтрДлина(Элемент) > 1;
		ЕстьКавычкиСправа = (Прав(Элемент, 1) = Кавычки);
		
		Если ЕстьКавычкиСлева И ЕстьКавычкиСправа Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЕстьКавычкиСлева И Не ЕстьКавычкиСправа Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЕстьКавычкиСлева И ЕстьКавычкиСправа Тогда
			ПредИндекс = Индекс - 1;
			МассивЭлеменов[ПредИндекс] = МассивЭлеменов[ПредИндекс] + Элемент;
			МассивЭлеменов.Удалить(Индекс);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Увеличивает номер текущей позиции в параметрах чтения json
// и записывает значение элемента расположенного в этой позиции в поле Элемент
//
// Параметры:
//  ПараметрыЧтения - Структура - см. ПараметрыЧтенияJSON();
// 
// Возвращаемое значение:
//  Булево - Истина, если следующий элемент получить удалось;
//
&НаКлиенте
Функция СледующийЭлементJSON(ПараметрыЧтения)
	
	Если ПараметрыЧтения.Позиция < ПараметрыЧтения.РазмерМассива Тогда
		ПараметрыЧтения.Позиция = ПараметрыЧтения.Позиция + 1;
		ПараметрыЧтения.Элемент = ПараметрыЧтения.МассивЭлеменов[ПараметрыЧтения.Позиция];
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция РазделитьСтрокуJSON(Строка)
	
	#Если Сервер Или ТолстыйКлиентОбычноеПриложение Тогда
		
		Стр = Символы.ПС + Строка + Символы.ПС;
		Стр = СтрЗаменить(Стр, """", """""");
		Стр = СтрЗаменить(Стр, Символы.ПС, """}," + Символы.ПС + "{""S"",""");
		
		Стр = "{""#"",51e7a0d2-530b-11d4-b98a-008048da3034,
		|{" + Формат(СтрЧислоСтрок(Стр) + 1, "ЧГ=0") + ",
		|"
		+ "{""S"","""
		+ Стр
		+ """}
		|}
		|}";
		
		Результат = ЗначениеИзСтрокиВнутр(Стр);
		Результат.Удалить(0);
		Результат.Удалить(Результат.ВГраница());
		
	#Иначе
		
		ВключатьПустые = Истина;
		Разделитель = Символы.ПС;
		Результат = РазделитьСтроку(Строка, Разделитель, ВключатьПустые);
		
	#КонецЕсли
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция РазбитьСтрокуПоСлужебнымСимволамJSON(Знач Строка)
	
	СлужебныеСимволы = "{}[]:,";
	Для Сч = 1 По СтрДлина(СлужебныеСимволы) Цикл
		ТекСимвол = Сред(СлужебныеСимволы, Сч, 1);
		Строка = СтрЗаменить(Строка, ТекСимвол, Символы.ПС + ТекСимвол + Символы.ПС);
	КонецЦикла;
	
	Возврат Строка;
	
КонецФункции

&НаКлиенте
Функция ЭкранироватьСимволыJSON(Знач Строка)
	
	Строка = СтрЗаменить(Строка, "\", "\\");
	Строка = СтрЗаменить(Строка, """", "\""");
	
	Возврат Строка;
	
КонецФункции

&НаКлиенте
Функция ЗаменитьЭкранированныеСимволыJSON(Знач Строка)
	
	Строка = СтрЗаменить(Строка, "\\", "<&sl>");
	Строка = СтрЗаменить(Строка, "\""", "<&qt>");
	
	Возврат Строка;
	
КонецФункции

&НаКлиенте
Функция ВосстановитьЭкранированныеСимволыJSON(Знач Строка)
	
	Строка = СтрЗаменить(Строка, "<&sl>", "\");
	Строка = СтрЗаменить(Строка, "<&qt>", Кавычки());
	
	Возврат Строка;
	
КонецФункции

&НаКлиенте
Функция ЗаменитьНедопустимыеСимволыJSON(Знач Строка)
	
	СимволBackspace = Символ(8);
	СимволРазделителяGS = Символ(29);
	
	Строка = СтрЗаменить(Строка, Символы.ПФ, "\f");
	Строка = СтрЗаменить(Строка, Символы.ПС, "\n");
	Строка = СтрЗаменить(Строка, Символы.ВК, "\r");
	Строка = СтрЗаменить(Строка, Символы.ВТаб, "\t");
	Строка = СтрЗаменить(Строка, СимволBackspace, "\b");
	Строка = СтрЗаменить(Строка, СимволРазделителяGS, "\u001D");
	
	Возврат Строка;
	
КонецФункции

&НаКлиенте
Функция ВосстановитьНедопустимыеСимволыJSON(Знач Строка)
	
	СимволBackspace = Символ(8);
	СимволРазделителяGS = Символ(29);
	
	Строка = СтрЗаменить(Строка, "\f", Символы.ПФ);
	Строка = СтрЗаменить(Строка, "\n", Символы.ПС);
	Строка = СтрЗаменить(Строка, "\r", Символы.ВК);
	Строка = СтрЗаменить(Строка, "\t", Символы.ВТаб);
	Строка = СтрЗаменить(Строка, "\b", СимволBackspace);
	Строка = СтрЗаменить(Строка, "\u001d", СимволРазделителяGS);
	Строка = СтрЗаменить(Строка, "\u001D", СимволРазделителяGS);
	
	Возврат Строка;
	
КонецФункции

&НаКлиенте
Функция ЭтоРазделительJSON(Строка)
	
	Результат = Строка = "," Или Строка = ":";
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция БулевоИзСтрокиJSON(Строка)
	
	Если НРег(Строка) = "true" Тогда
		Результат = Истина;
	ИначеЕсли НРег(Строка) = "false" Тогда
		Результат = Ложь;
	Иначе
		ВызватьИсключение ПараметрыВСтроку(
		НСтр("ru = 'Не удалось преобразовать json строку в булево: %1'"), Строка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

