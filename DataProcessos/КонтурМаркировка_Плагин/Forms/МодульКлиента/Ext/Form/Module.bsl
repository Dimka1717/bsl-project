// Дополняет массив значениями из другого массива
//
// Параметры:
//  МассивПриемник - Массив - массив, в который необходимо добавить значения;
//  МассивИсточник - Массив - массив, из которого нужно взять значения;
//  ТолькоНовыеЗначения - Булево - (необязательный) Истина, если в приемник
//                   нужно добавить только те значения, которых там еще нет;
//
&НаКлиенте
Процедура ДополнитьМассив(МассивПриемник, МассивИсточник, ТолькоНовыеЗначения = Ложь)
	
	Если ТолькоНовыеЗначения Тогда
		
		ЗначенияПриемника = Новый Соответствие;
		
		Для Каждого Значение Из МассивПриемник Цикл
			ЗначенияПриемника.Вставить(Значение, Истина);
		КонецЦикла;
		
		Для Каждого Значение Из МассивИсточник Цикл
			
			Если ЗначенияПриемника[Значение] = Неопределено Тогда
				
				МассивПриемник.Добавить(Значение);
				
				ЗначенияПриемника.Вставить(Значение, Истина);
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого Значение Из МассивИсточник Цикл
			МассивПриемник.Добавить(Значение);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Получает дату из строки по формату ISO 8601
//
// Параметры:
//  Строка - Строка - дата в формате ISO 8601
// 
// Возвращаемое значение:
//  Дата
//
&НаКлиенте
Функция ДатаИзСтрокиXML(Строка)
	
	Если Не ЗначениеЗаполнено(Строка) Тогда
		Возврат '00010101';
	КонецЕсли;
	
	#Если ВебКлиент Тогда
		Результат = ДатаИзСтрокиXMLНаСервере(Строка);
	#Иначе
		Результат = XMLЗначение(Тип("Дата"), Строка);
	#КонецЕсли
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДатаИзСтрокиXMLНаСервере(Строка)
	
	Возврат XMLЗначение(Тип("Дата"), Строка);
	
КонецФункции

// Сравнить две строки версий
//
// Параметры
//  СтрокаВерсии1 - Строка - номер версии в формате РР.{П|ПП}.ЗЗ.СС
//  СтрокаВерсии2 - Строка - второй сравниваемый номер версии
//
// Возвращаемое значение:
//   Число - больше 0, если СтрокаВерсии1 > СтрокаВерсии2; 0, если версии равны.
//
&НаКлиенте
Функция СравнитьВерсии(СтрокаВерсии1, СтрокаВерсии2)
	
	// Для составных номеров версий берем только первую часть.
	Строка1 = Сред(СтрокаВерсии1, 1, Найти(СтрокаВерсии1, "/") - 1);
	Строка2 = Сред(СтрокаВерсии2, 1, Найти(СтрокаВерсии2, "/") - 1);
	
	ОписаниеЧисла = Новый ОписаниеТипов("Число");
	
	Результат = 0;
	
	Пока ЗначениеЗаполнено(Строка1)
		Или ЗначениеЗаполнено(Строка2) Цикл
		
		Поз = Найти(Строка1, ".");
		Если Поз = 0 Тогда
			Подстрока1 = СокрЛП(Строка1);
			Строка1 = "";
		Иначе
			Подстрока1 = СокрЛП(Лев(Строка1, Поз - 1));
			Строка1 = Сред(Строка1, Поз + 1);
		КонецЕсли;
		
		Поз = Найти(Строка2, ".");
		Если Поз = 0 Тогда
			Подстрока2 = СокрЛП(Строка2);
			Строка2 = "";
		Иначе
			Подстрока2 = СокрЛП(Лев(Строка2, Поз - 1));
			Строка2 = Сред(Строка2, Поз + 1);
		КонецЕсли;
		
		НомерВерсии1 = ОписаниеЧисла.ПривестиЗначение(Подстрока1);
		НомерВерсии2 = ОписаниеЧисла.ПривестиЗначение(Подстрока2);
		
		Результат = НомерВерсии1 - НомерВерсии2;
		
		Если Результат <> 0 Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Сравнивает указанную версию с версией платформы
//
// Параметры:
//  Версия - Строка - версия, с которой нужно сравнить версию платформы;
// 
// Возвращаемое значение:
//  Булево - Истина, если версия платформы ниже указанной
//
&НаКлиенте
Функция ВерсияПлатформыНиже(Версия)
	
	КлючКэш = "ВерсияПлатформыНиже: " + Версия;
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = (СравнитьВерсии(ВерсияПлатформы(), Версия) < 0);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ВерсияПлатформы()
	
	Возврат ИнформацияОСистеме().ВерсияПриложения;
	
КонецФункции

&НаКлиенте
Функция ИнформацияОСистеме()
	
	// BSLLS:UseSystemInformation-off
	Возврат Новый СистемнаяИнформация;
	// BSLLS:UseSystemInformation-on
	
КонецФункции

&НаКлиенте
Функция ПодключитьКомпоненту(ПутьКМакету, ИмяКомпоненты)
	
	ТипКомпоненты = ТипВнешнейКомпоненты.Native;
	
	Если ВерсияПлатформыНиже("8.3.21") Тогда
		Результат = ПодключитьВнешнююКомпоненту(ПутьКМакету, ИмяКомпоненты, ТипКомпоненты);
	Иначе
		Результат = Вычислить("ПодключитьВнешнююКомпоненту(ПутьКМакету, ИмяКомпоненты, ТипКомпоненты,
		|ТипПодключенияВнешнейКомпоненты.НеИзолированно)");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура НачатьУстановкуКомпоненты(ПутьКМакету)
	
	#Если Не Сервер Тогда
		Если ВерсияПлатформыНиже("8.3.3") Тогда
			УстановитьВнешнююКомпоненту(ПутьКМакету);
		Иначе
			Выполнить("НачатьУстановкуВнешнейКомпоненты(, ПутьКМакету)");
		КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры

