&НаКлиенте
Функция БулевоXML(Значение)
	
	Результат = Формат(Значение, "БЛ=false; БИ=true");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЧислоXML(Значение)
	
	Результат = Формат(Значение, "ЧРД=.; ЧН=0; ЧГ=0");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЛокальнаяДатаXML(Значение)
	
