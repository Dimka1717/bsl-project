// Проверяет что плагин загружен и отвечает
//
&НаКлиенте
Функция ПроверитьПлагин() Экспорт
	
	Плагин = ОбъектКонтурПлагина();
	Команда = Команда_ПроверкаПлагина();
	Ответ = ВыполнитьКоманду(Команда, Плагин);
	
	Результат = (Ответ["pong"] = "true");
	
	Возврат Результат;
	
КонецФункции

// Устанавливает и подключает плагин в асинхронном режиме если нужно
//
&НаКлиенте
Процедура ПодключитьПлагин() Экспорт
	
	Попытка
		Плагин = СоздатьОбъектКонтурПлагина();
	Исключение
		Плагин = Неопределено;
	КонецПопытки;
	
	Если Плагин <> Неопределено Тогда
		Возврат; // Плагин уже подключен
	КонецЕсли;
	
	ПутьКМакету = ПутьКМакетуКонтурПлагина();
	ИмяКомпоненты = ИмяКомпонентыКонтурПлагина();
	КомпонентаПодключена = ПодключитьКомпоненту(ПутьКМакету, ИмяКомпоненты);
	
	Если Не КомпонентаПодключена Тогда
		НачатьУстановкуКомпоненты(ПутьКМакету);
	КонецЕсли;
	
КонецПроцедуры

