// #Область РазборОтветовОтПлагина

&НаКлиенте
Функция РазобратьОтвет(Ответ)
	
	Результат = Ответ["data"];
	
	Если ЗначениеЗаполнено(Результат)
		И НужноВернутьДвоичныеДанные(Ответ) Тогда
		Результат = Base64Значение(Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция РазобратьКоллекциюОтветов(Ответ, ИмяКоллекции, ПолеЗначения = "data")
	
	Результат = Новый Массив;
	Коллекция = Ответ[ИмяКоллекции];
	ВернутьДвоичныеДанные = НужноВернутьДвоичныеДанные(Ответ);
	
	Если ЗначениеЗаполнено(Коллекция) Тогда
		
		Для каждого Элемент Из ЗначениеВМассиве(Коллекция) Цикл
			
			Значение = Элемент[ПолеЗначения];
			
			Если ВернутьДвоичныеДанные И ЗначениеЗаполнено(Значение) Тогда
				Значение = Base64Значение(Значение);
			КонецЕсли;
			
			Результат.Добавить(Значение);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция РазобратьОтвет_СписокСертификатов(Ответ)
	
	certs = Ответ["certs"];
	Если Не ЗначениеЗаполнено(certs) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Результат = Новый Массив;
	Для Каждого Элемент Из ЗначениеВМассиве(certs) Цикл
		Результат.Добавить(Новый_ОписаниеСертификата(Элемент));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // РазборОтветовПлагина

// #Область Контракты

&НаКлиенте
Функция Новый_command(type, РезультатДвоичныеДанные = Ложь)
	
	custom_data = Новый Структура;
	custom_data.Вставить("command_type", type);
	
	Если РезультатДвоичныеДанные Тогда
		custom_data.Вставить("ResultBinaryData", Истина);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("type", type);
	Результат.Вставить("custom_data", custom_data);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Новый_content(ТипКонтента, Данные = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("type", ТипКонтента);
	
	Если ЗначениеЗаполнено(Данные) Тогда
		Если ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
			Результат.Вставить("data", Base64Строка(Данные));
		Иначе
			Результат.Вставить("data", Данные);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Новый_MultiContent(ТипКонтента, МассивЗначений)
	
	contents = Новый Массив;
	Для каждого Значение Из МассивЗначений Цикл
		Если ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
			contents.Добавить(Новый Структура("data", Base64Строка(Значение)));
		Иначе
			contents.Добавить(Новый Структура("data", Значение));
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("type", ТипКонтента);
	Результат.Вставить("contents", contents);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Новый_cert_filter(ПараметрыПоиска)
	
	Результат = Новый Структура;
	
	Если ПараметрыПоиска.Отпечаток <> Неопределено Тогда
		Результат.Вставить("hash", Новый_content("hex", ПараметрыПоиска.Отпечаток));
	КонецЕсли;
	
	Если ПараметрыПоиска.СерийныйНомер <> Неопределено Тогда
		Результат.Вставить("serialNumber", Новый_content("hex", ПараметрыПоиска.СерийныйНомер));
	КонецЕсли;
	
	Если ПараметрыПоиска.ЕстьЗакрытыйКлюч <> Неопределено Тогда
		Результат.Вставить("hasPrivateKey", ПараметрыПоиска.ЕстьЗакрытыйКлюч);
	КонецЕсли;
	
	Если ПараметрыПоиска.ТолькоПервый <> Неопределено Тогда
		Результат.Вставить("firstOnly", ПараметрыПоиска.ТолькоПервый);
	КонецЕсли;
	
	Результат.Вставить("store", Новый_cert_store(ПараметрыПоиска));
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Новый_cert_store(ПараметрыФильтра)
	
	Результат = Новый Структура;
	
	Если ТипЗнч(ПараметрыФильтра) = Тип("Структура") Тогда
		
		Если ПараметрыФильтра.Свойство("ТипХранилища") Тогда
			Результат.Вставить("storeName", Новый_cert_storeName(ПараметрыФильтра.ТипХранилища));
		КонецЕсли;
		
		Если ПараметрыФильтра.Свойство("РасположениеХранилища") Тогда
			Результат.Вставить("storeLocation", Новый_cert_storeLocation(ПараметрыФильтра.РасположениеХранилища));
		КонецЕсли;
		
	КонецЕсли;
	
	Результат.Вставить("storeType", "cryptoApi");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Новый_cert_storeName(ТипХранилища)
	
	ТипыХранилищ = Перечисление_ТипыХранилищСертификатов();
	
	Если ТипХранилища = ТипыХранилищ.КорневыеСертификаты Тогда
		Результат = "Root";
	ИначеЕсли ТипХранилища = ТипыХранилищ.ПерсональныеСертификаты Тогда
		Результат = "My";
	ИначеЕсли ТипХранилища = ТипыХранилищ.СертификатыПолучателей Тогда
		Результат = "AddressBook";
	ИначеЕсли ТипХранилища = ТипыХранилищ.СертификатыУдостоверяющихЦентров Тогда
		Результат = "CA";
	Иначе
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный тип хранилища сертификатов: %1'"), ТипХранилища);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Новый_cert_storeLocation(РасположениеХранилища)
	
	РасположениеХранилищ = Перечисление_РасположениеХранилищСертификатов();
	
	Если РасположениеХранилища = РасположениеХранилищ.ЛокальныйКомпьютер Тогда
		Результат = "machine";
	ИначеЕсли РасположениеХранилища = РасположениеХранилищ.ТекущийПользователь Тогда
		Результат = "user";
	Иначе
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестное расположение хранилища сертификатов: %1'"), РасположениеХранилища);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Новый_certificate(Сертификат)
	
	Результат = Новый Структура;
	
	СертификатТип = ТипЗнч(Сертификат);
	
	Если СертификатТип = Тип("Строка") Тогда // Отпечаток сертификата
		
		ТипыХранилищ = Перечисление_ТипыХранилищСертификатов();
		РасположениеХранилищ = Перечисление_РасположениеХранилищСертификатов();
		
		Результат.Вставить("hash", Новый_content("hex", Сертификат));
		Результат.Вставить("storeName", Новый_cert_storeName(ТипыХранилищ.ПерсональныеСертификаты));
		Результат.Вставить("storeLocation", Новый_cert_storeLocation(РасположениеХранилищ.ТекущийПользователь));
		
	ИначеЕсли СертификатТип = Тип("ДвоичныеДанные") Тогда // Файл сертификата
		
		Результат.Вставить("content", Новый_content("base64", Сертификат));
		
	ИначеЕсли СертификатТип = Тип("Структура") Тогда // Параметры поиска сертификата
		
		Если Не Сертификат.Свойство("Отпечаток") Тогда
			ВызватьИсключение НСтр("ru = 'Не указан отпечаток сертификата, который нужно найти'");
		КонецЕсли;
		
		Результат.Вставить("hash", Новый_content("hex", Сертификат.Отпечаток));
		
		Если Сертификат.Свойство("ТипХранилища") Тогда
			Результат.Вставить("storeName", Новый_cert_storeName(Сертификат.ТипХранилища));
		КонецЕсли;
		Если Сертификат.Свойство("РасположениеХранилища") Тогда
			Результат.Вставить("storeLocation", Новый_cert_storeLocation(Сертификат.РасположениеХранилища));
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

