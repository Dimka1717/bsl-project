Функция ПредставлениеСортировкиЭтикеток(ПараметрыСортировки) Экспорт
	
	Результат = "";
	
	Если НЕ ЗначениеЗаполнено(ПараметрыСортировки.ПолеСортировкиЭтикеток1) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ШаблонПредставленияНастройки = НСтр("ru='%1 %2'");
	
	ВсегоПараметров = КоличествоПараметровСортировкиЭтикеток();
	СтрокиСортировки = Новый Массив;
	
	Для Сч = 1 По ВсегоПараметров Цикл
		
		Поле = ПараметрыСортировки["ПолеСортировкиЭтикеток" + Сч];
		Направление = ПараметрыСортировки["НаправлениеСортировкиЭтикеток" + Сч];
		
		Если ЗначениеЗаполнено(Поле) Тогда
			
			ПредставлениеНастройки = ПараметрыВСтроку(ШаблонПредставленияНастройки
			, Поле
			, НРег(Направление));
			
			СтрокиСортировки.Добавить(ПредставлениеНастройки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СоединитьСтроку(СтрокиСортировки, ", ");
	
КонецФункции

