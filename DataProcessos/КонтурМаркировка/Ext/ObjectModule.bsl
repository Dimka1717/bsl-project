Процедура ПерейтиНаВерсию_3_7_ЗаполнитьПричинуВозвратаВОборот()
	
	ИмяРеквизитаПричинаВозврата = "ПричинаВозвратаВОборот";
	ИмяРеквизитаПричинаВывода = "ПричинаВыводаИзОборота";
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	ТипыОперацийВозврата = Новый Массив;
	ТипыОперацийВозврата.Добавить(ТипыОпераций.ВозвратВОборот);
	ТипыОперацийВозврата.Добавить(ТипыОпераций.ВозвратВОборотНаТСД);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Операции.Ссылка КАК Объект,
	|	ПричинаВывода.Значение КАК ПричинаВывода
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Операции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ПричинаВывода
	|		ПО Операции.Ссылка = ПричинаВывода.Объект
	|			И (ПричинаВывода.ИмяРеквизита = &ИмяРеквизитаПричинаВывода)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ПричинаВозврата
	|		ПО Операции.Ссылка = ПричинаВозврата.Объект
	|			И (ПричинаВозврата.ИмяРеквизита = &ИмяРеквизитаПричинаВозврата)
	|ГДЕ
	|	Операции.ТипОперации В(&ТипыОперацийВозврата)
	|	И ПричинаВозврата.Объект ЕСТЬ NULL");
	
	Запрос.УстановитьПараметр("ИмяРеквизитаПричинаВозврата", ИмяРеквизитаПричинаВозврата);
	Запрос.УстановитьПараметр("ИмяРеквизитаПричинаВывода", ИмяРеквизитаПричинаВывода);
	Запрос.УстановитьПараметр("ТипыОперацийВозврата", ТипыОперацийВозврата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МенеджерЗаписи = РегистрыСведений.КонтурМаркировка_ДопРеквизиты.СоздатьМенеджерЗаписи();
		
		МенеджерЗаписи.Объект = Выборка.Объект;
		МенеджерЗаписи.ИмяРеквизита = ИмяРеквизитаПричинаВозврата;
		МенеджерЗаписи.Значение = ПричинаВозвратаВОборотПоПричинеВывода(Выборка.ПричинаВывода);
		
		МенеджерЗаписи.Записать();
		
	КонецЦикла;

КонецПроцедуры

