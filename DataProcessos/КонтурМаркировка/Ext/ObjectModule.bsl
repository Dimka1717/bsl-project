//
// Параметры:
//  Настройки - Структура - настройки модуля
//
Процедура НастройкиМодуля_Записать(Настройки) Экспорт
	
	МодульЯдро().НастройкиМодуля_Записать(Настройки);
	
	Кэш_Очистить();
	
