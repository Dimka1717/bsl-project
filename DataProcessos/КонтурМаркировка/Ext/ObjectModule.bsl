// Формирует описание сертификата по данным из плагина
//
// Параметры:
//  ДанныеСертификата -  - см. Плагин_ДанныеСертификата();
// 
// Возвращаемое значение:
//  Структура - см. Новый_Сертификат()
//
Функция ОписаниеСертификатаПоДаннымИзПлагина(ДанныеСертификата) Экспорт
	
	СубъектСертификата = ДанныеСертификата.Субъект;
	
	Результат = Новый_Сертификат();
	Результат.ОтпечатокСертификата = ДанныеСертификата.Отпечаток;
	Результат.ФИО                  = ФИОСертификата(СубъектСертификата);
	Результат.ДатаВыдачи           = ДанныеСертификата.ДатаНачала;
	Результат.ДатаОкончания        = ДанныеСертификата.ДатаОкончания;
	Результат.Издатель             = ДанныеСертификата.Издатель["CN"];
	Результат.ИНН                  = ИННСертификата(СубъектСертификата);
	Результат.КПП                  = КППСертификата(СубъектСертификата);
	Результат.Должность            = СвойствоСтруктуры(СубъектСертификата, "T", "");
	Результат.ВидСертификата       = ВидСертификата(СубъектСертификата);
	Результат.НаименованиеОрганизации = СвойствоСтруктуры(СубъектСертификата, "O", "");
	
	Если Результат.ВидСертификата = Перечисление_ВидыСертификатов().НаФизЛицо Тогда
		Результат.НаименованиеОрганизации = Результат.ФИО;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОбъектСодержитНедопустимыеСимволыXML(Значение)
	
	Результат = Ложь;
	
	Если ЭтоСтруктура(Значение) Или ЭтоСоответствие(Значение) Тогда
		
		Для Каждого КлючЗначение Из Значение Цикл
			Если ОбъектСодержитНедопустимыеСимволыXML(КлючЗначение.Значение) Тогда
				Результат = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ЭтоМассив(Значение) Тогда
		
		Для Каждого Элемент Из Значение Цикл
			Если ОбъектСодержитНедопустимыеСимволыXML(Элемент) Тогда
				Результат = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		
		Результат = НайтиНедопустимыеСимволыXML(Значение) > 0;
		
	Иначе
		
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИННСертификата(СубъектСертификата)
	
	Если СубъектСертификата["ИННЮЛ"] <> Неопределено Тогда
		Результат = СубъектСертификата["ИННЮЛ"];
	ИначеЕсли СубъектСертификата["ИНН"] <> Неопределено Тогда
		Результат = СубъектСертификата["ИНН"];
	Иначе
		Результат = "";
	КонецЕсли;
	
	Если Лев(Результат, 2) = "00" Тогда 
		Результат = Сред(Результат, 3);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КППСертификата(СубъектСертификата)
	
	Результат = "";
	
	НеструктурированноеИмя = СвойствоСтруктуры(СубъектСертификата, "_1_2_840_113549_1_9_2");
	
	Если ЗначениеЗаполнено(НеструктурированноеИмя) Тогда
		
		ЭлементыЗначения = РазделитьСтроку(НеструктурированноеИмя, "-");
		
		Если ЭлементыЗначения.Количество() > 1 Тогда
			Результат = ЭлементыЗначения[1];
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВидСертификата(СубъектСертификата)
	
	ВидыСертификатов = Перечисление_ВидыСертификатов();
	
	ИННЮЛ	= СвойствоСтруктуры(СубъектСертификата, "ИННЮЛ");
	ИНН		= СвойствоСтруктуры(СубъектСертификата, "ИНН");
	ОГРН	= СвойствоСтруктуры(СубъектСертификата, "ОГРН");
	ОГРНИП	= СвойствоСтруктуры(СубъектСертификата, "ОГРНИП");
	Фамилия	= СвойствоСтруктуры(СубъектСертификата, "SN");
	ИмяОтчество	= СвойствоСтруктуры(СубъектСертификата, "G");
	
	Если Лев(ИНН, 2) = "00" Тогда
		ИНН = Сред(ИНН, 3);
	КонецЕсли;
	
	ПустойИННЮЛ		= "0000000000";
	ПустойИННФЛ		= "000000000000";
	ПустойОГРН		= "0000000000000";
	ПустойОГРНИП	= "000000000000000";
	
	ДлинаИННЮЛ	= СтрДлина(ПустойИННЮЛ);
	ДлинаИННФЛ	= СтрДлина(ПустойИННФЛ);
	ДлинаОГРН	= СтрДлина(ПустойОГРН);
	ДлинаОГРНИП	= СтрДлина(ПустойОГРНИП);
	
	ПрефиксНерезидента = "9909";
	
	Резидент		= Лев(ИННЮЛ,СтрДлина(ПрефиксНерезидента)) <> ПрефиксНерезидента
					И Лев(ИНН,	СтрДлина(ПрефиксНерезидента)) <> ПрефиксНерезидента;
					
	ЗаполненИННЮЛ	= СтрДлина(ИННЮЛ) = ДлинаИННЮЛ
					И ИННЮЛ <> ПустойИННЮЛ;
					
	ЗаполненИНН		= СтрДлина(ИНН) = ДлинаИННФЛ
					И ИНН <> ПустойИННФЛ;
					
	ЗаполненИНН_ЮЛ	= СтрДлина(ИНН) = ДлинаИННЮЛ
					И ИНН <> ПустойИННЮЛ;
					
	ЗаполненОГРНИП	= СтрДлина(ОГРНИП) = ДлинаОГРНИП
					И ОГРНИП <> ПустойОГРНИП;
					
	ЗаполненОГРН	= СтрДлина(ОГРН) = ДлинаОГРН
					И ОГРН <> ПустойОГРН;
					
	ЗаполненОГРН	= (Резидент И ЗаполненОГРН
					ИЛИ НЕ Резидент И НЕ ЗаполненОГРН)
					И НЕ ЗначениеЗаполнено(ОГРНИП);
					
	ЗаполненоФИО	= ЗначениеЗаполнено(Фамилия)
					ИЛИ ЗначениеЗаполнено(ИмяОтчество);
					
	Если 	ЗаполненИННЮЛ 
			И ЗаполненОГРН Тогда
	
			Результат = ВидыСертификатов.НаОрганизацию;
			
	ИначеЕсли НЕ ЗаполненИННЮЛ 
			И ЗаполненИНН_ЮЛ 
			И ЗаполненОГРН Тогда
	
			Результат = ВидыСертификатов.НаОрганизацию;
	
	ИначеЕсли НЕ ЗаполненИННЮЛ
			И ЗаполненИНН
		    И ЗаполненОГРНИП
            И НЕ ЗаполненОГРН Тогда
	
		Результат = ВидыСертификатов.НаОрганизацию;
	
	ИначеЕсли ЗаполненИННЮЛ
			И НЕ ЗаполненоФИО Тогда
	
		Результат = ВидыСертификатов.НаОрганизацию;
		
	ИначеЕсли НЕ ЗаполненИННЮЛ
			И ЗаполненИНН
			И НЕ ЗаполненОГРНИП
			И НЕ ЗаполненОГРН Тогда
	
		Результат = ВидыСертификатов.НаФизЛицо;
	
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ФИОСертификата(СубъектСертификата)
	
	Если СубъектСертификата["SN"] <> Неопределено И СубъектСертификата["G"] <> Неопределено Тогда
		Результат = СубъектСертификата["SN"] + " " + СубъектСертификата["G"];
	Иначе
		Результат = СубъектСертификата["CN"];
	КонецЕсли;
	
	Возврат Результат;
	
