//  Строка - см. функцию Перечисление_СтатусыДокументовУчета()
//
Функция ОсновнойСтатусДокументаУчета(ДокументУчета) Экспорт
	
	Возврат ДокументУчета_ОсновнойСтатус(ДокументУчета);
	
