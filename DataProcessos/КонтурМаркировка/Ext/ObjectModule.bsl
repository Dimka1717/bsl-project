	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	
	Для Каждого Стр Из Товары Цикл
		Если Стр.Товар.ТипКодаМаркировки = ТипыКодовМаркировки.ЕдиницаТовара Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция НомерДокументаСертификацииСоответствуетФормату(НомерСертификата, ВидСертификата)
	
	ВидыДокументовСертификации = Перечисление_ВидыДокументовОбязательнойСертификации();
	
	ШаблонСертификатаРФ = "^(ЕАЭС |РОСС |ТС |ВП )?RU С-[a-zA-Z]{2}\.[а-яА-Я0-9]{4}\.[АВ]\.[0-9]{5}\/[0-9]{2}$";
	ШаблонДекларацииРФ = "^(ЕАЭС N |РОСС |ТС N |ВП )?RU Д-[a-zA-Z]{2}\.[а-яА-Я0-9]{4}\.[АВ]\.[0-9]{5}\/[0-9]{2}$";
	ШаблонСвидРегистрации = "^(?:RU|BY|KZ|AM|KG).[0-9]{2}\.[а-яА-Я0-9]{2}\.[0-9]{2}\.[0-9]{3}\.(?:Е|е|R|r|E|e)\.[0-9]{6}\.[0-9]{2}\.[0-9]{2}$";
	ШаблонИмпортногоСертификатаИлиДекларации = "^(?:ЕАЭС|ТС) (N |№ )?(?:RU|BY|KZ|AM|KG).{5,30}$";
	
	Если ВидСертификата = ВидыДокументовСертификации.СвидетельствоГосРегистрации Тогда
		Шаблон = ШаблонСвидРегистрации;
	Иначе
		Если ЭтоНомерИмпортногоСертификатаИлиДекларации(НомерСертификата) Тогда
			Шаблон = ШаблонИмпортногоСертификатаИлиДекларации;
		Иначе
			Если ВидСертификата = ВидыДокументовСертификации.СертификатСоответствия Тогда
				Шаблон = ШаблонСертификатаРФ;
			Иначе
				Шаблон = ШаблонДекларацииРФ;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЗначениеЗаполнено(Плагин_НайтиСовпаденияПоШаблону(НомерСертификата, Шаблон));
	
КонецФункции

Функция ЭтоНомерИмпортногоСертификатаИлиДекларации(НомерСертификата)
	
	ШаблонНачалаНомераРФ = "^(ЕАЭС |ТС |ЕАЭС N |ТС N |РОСС |ВП )?RU \D-\D\D\.";
	
	Возврат Не ЗначениеЗаполнено(Плагин_НайтиСовпаденияПоШаблону(НомерСертификата, ШаблонНачалаНомераРФ));
	
КонецФункции

Функция Операция_ТоварыВАгрегатахТребуютВСД(Операция, КлючСтрокиОперации) Экспорт
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	КодыОпераций_ВТ_Прочитать(Операция, МенеджерВТ, КлючСтрокиОперации);
	ТаблицаКодов_ВТ_ЗаменитьТранспортныеУпаковкиНаВложенныеКоды(МенеджерВТ);
	ТаблицаКодов_ВТ_ЗаменитьАТКНаВложенныеКоды(МенеджерВТ);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИнформацияОКодах.Товар КАК Товар
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО ТаблицаКодов.КлючКода = СвязиКлючейКодов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (СвязиКлючейКодов.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	ИнформацияОКодах.Товар.ПодлежитВетеринарномуКонтролю");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Результат = Не Запрос.Выполнить().Пустой();
	МенеджерВТ.Закрыть();
	
	Возврат Результат;
	
КонецФункции

