// Разбирает номер декларации на части
//
// Параметры:
//  НомерДекларации - Строка - номер декларации;
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//   * КодТаможни - Строка - код таможни;
//   * ДатаДекларации - Дата - дата декларации;
//   * ПорядковыйНомер - Строка - порядковый номер декларации;
//
Функция СтруктураТаможеннойДекларации(НомерДекларации) Экспорт
	
	ЧастиНомера = РазделитьСтроку(НомерДекларации, "/");
	
	Результат = Новый Структура;
	Результат.Вставить("КодТаможни");
	Результат.Вставить("ДатаДекларации");
	Результат.Вставить("ПорядковыйНомер");
	
	ДопустимоеКоличествоЧастей = 3;
	Если ЧастиНомера.Количество() <> ДопустимоеКоличествоЧастей Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.КодТаможни = ЧастиНомера[0];
	Результат.ДатаДекларации = ДатаТаможеннойДекларацииИзСтроки(ЧастиНомера[1]);
	Результат.ПорядковыйНомер = ЧастиНомера[2];
	
	Возврат Результат;
	
КонецФункции

// Преобразует дату таможенной декларации из строки в дату
//
// Параметры:
//  ДатаДекларацииСтрокой - Строка - строка формата ддммгг;
// 
// Возвращаемое значение:
//  Дата - дата таможенной декларации;
//
Функция ДатаТаможеннойДекларацииИзСтроки(ДатаДекларацииСтрокой)
	
	Результат = '00010101';
	
	НеобходимаяДлинаСтроки = 6;
	Если СтрДлина(ДатаДекларацииСтрокой) <> НеобходимаяДлинаСтроки
		Или Не ВСтрокеТолькоЦифры(ДатаДекларацииСтрокой) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПозицияДня = 1;
	ДлинаДня = 2;
	День = Число(Сред(ДатаДекларацииСтрокой, ПозицияДня, ДлинаДня));
	
	ПозицияМесяца = 3;
	ДлинаМесяца = 2;
	Месяц = Число(Сред(ДатаДекларацииСтрокой, ПозицияМесяца, ДлинаМесяца));
	
	ПозицияГода = 5;
	ДлинаГода = 2;
	Год = Число(Сред(ДатаДекларацииСтрокой, ПозицияГода, ДлинаГода));

	НачалоВека = 2000;
	Результат = Дата(НачалоВека + Год, Месяц, День);
	
	Возврат Результат;
	
КонецФункции

