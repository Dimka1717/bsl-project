Функция КонтурПлагины_НайтиПлагин(ИдентификаторПлагина, ВызыватьИсключение = Истина)
	
	Результат = Неопределено;
	
	ИмяСправочника = КонтурПлагины_ИмяСправочника();
	МассивСсылок = ДопСправочник_НайтиПоДопРеквизиту(ИмяСправочника, "Идентификатор", ИдентификаторПлагина);
	Если ЗначениеЗаполнено(МассивСсылок) Тогда
		Результат = МассивСсылок[0];
	Иначе
		
		Если ВызыватьИсключение Тогда
			ТекстОшибки = НСтр("ru = 'Не удалось найти плагин по идентификатору %1'");
			ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ИдентификаторПлагина);
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КонтурПлагины_НастройкиПлагина(ИдентификаторПлагина)
	
	Результат = Неопределено;
	
	Плагин = КонтурПлагины_НайтиПлагин(ИдентификаторПлагина);
	ТипФайла = Перечисление_ТипыФайлов().ФайлНастроекПлагина;
	ФайлПлагина = Файл_Найти(Плагин, ТипФайла);
	Если ЗначениеЗаполнено(ФайлПлагина) Тогда
		Результат = Файл_Прочитать(ФайлПлагина).ДанныеФайла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

