	Результат.Добавить(ОписаниеМодуляЯдро());
	Результат.Добавить(ОписаниеМодуляКонтурПлагины());
	
	Возврат Результат;
	
КонецФункции

Функция ДвоичныеДанныеМодуляЯдро()
	
