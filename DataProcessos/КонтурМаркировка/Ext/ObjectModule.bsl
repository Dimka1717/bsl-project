Процедура ОбновитьМодуль()
	
	КонтекстОбновления = КонтекстОбновления();
	РасположениеМодуля = КонтекстОбновления.РасположениеМодуля;
	ВариантыРасположения = Перечисление_ВариантыРасположенияОбработки();
	
	ВозможноВыполнитьАвтообновление = КонтекстОбновления.ОбновлятьАвтоматически
	И КонтекстОбновления.РазрешеноАвтообновление;
	
	Если Не ВозможноВыполнитьАвтообновление Тогда
		Возврат;
	КонецЕсли;
	
	// Фиксируем старую версию модуля заранее,
	// чтобы избежать ошибки записи в расширении после обновления подсистемы
	СтараяВерсияМодуля_Записать(КонтекстОбновления.ТекущаяВерсияМодуля);
	
	Если РасположениеМодуля = ВариантыРасположения.ВСправочнике Тогда
		
		ОбновитьМодульВСправочнике(КонтекстОбновления);
		
	ИначеЕсли РасположениеМодуля = ВариантыРасположения.ВРасширении Тогда
		
		ОбновитьРасширениеКонфигурации(КонтекстОбновления);
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Не удалось обновить модуль!
		|Некорректное расположение модуля: %1'"), РасположениеМодуля);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
КонецПроцедуры

// Получает новую версию модуля из сервиса обновлений
// и записывает его файл на диске
//
// Параметры:
//  ОписаниеОбновления - Структура - см. функцию Новый_КонтекстОбновленияМодуля();
//
Процедура ОбновитьМодульНаДискеНаСервере(КонтекстОбновления) Экспорт
	
	СсылкаНаФайл = КонтекстОбновления.АдресОбновления;
	ПутьКФайлу =КонтекстОбновления.ИнормацияОФайлеНаДиске.ПутьКФайлу;
	
	ФайлНовойВерсии = СкачатьФайлИзИнтернета(СсылкаНаФайл);
	
	ФайлНовойВерсии.Записать(ПутьКФайлу);
	
КонецПроцедуры

// Получает новую версию модуля из сервиса обновлений
// и обновляет его в справочнике внешних обработок
//
// Параметры:
//  КонтекстОбновления - Структура - см. функцию Новый_КонтекстОбновленияМодуля();
//
Процедура ОбновитьМодульВСправочнике(КонтекстОбновления) Экспорт
	
	НоваяВерсия = КонтекстОбновления.НоваяВерсияМодуля;
	ОписаниеОбработки = КонтекстОбновления.ИнформацияОДополнительнойОбработке;
	
	Попытка
		ДвоичныеДанные = СкачатьФайлИзИнтернета(КонтекстОбновления.АдресОбновления);
		ЗаписатьФайлВСправочникВнешнихОбработок(ОписаниеОбработки, ДвоичныеДанные, НоваяВерсия);
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Обновление модуля в справочнике дополнительных обработок'");
		ТекстСообщения = НСтр("ru = 'Не удалось обновить модуль в справочнике дополнительных обработок'");
		
		ДопИнформация = Новый_КонтекстОбновленияДанныеПоОшибке();
		ЗаполнитьЗначенияСвойств(ДопИнформация, КонтекстОбновления);
		ДопИнформация.СсылкаНаСправочник = ОписаниеОбработки.Ссылка;
		ДопИнформация.ИмяПоляХранилища = ОписаниеОбработки.ИмяПоляХранилища;
		ДопИнформация.ИмяПоляВерсии = ОписаниеОбработки.ИмяПоляВерсии;
		
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация, ТекстСообщения);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

// Получает новую версию расширения модуля из сервиса обновлений
// и обновляет его в в расширениях конфигурации
//
// Параметры:
//  КонтекстОбновления - Структура - см. функцию Новый_КонтекстОбновленияМодуля();
//
Процедура ОбновитьРасширениеКонфигурации(КонтекстОбновления) Экспорт
	
	Попытка
		ФайлНовойВерсии = СкачатьФайлИзИнтернета(КонтекстОбновления.АдресОбновления);
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Обновление расширения Контур.Маркировка'");
		ТекстСообщения = НСтр("ru = 'Не удалось обновить расширение Контур.Маркировка'");
		
		ДопИнформация = Новый_КонтекстОбновленияДанныеПоОшибке();
		ЗаполнитьЗначенияСвойств(ДопИнформация, КонтекстОбновления);
		
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация, ТекстСообщения);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	РасширениеКонфигурации = РасширениеКонфигурацииКонтурМаркировка();
	
	РезультатПроверки = РасширениеКонфигурации.ПроверитьВозможностьПрименения(ФайлНовойВерсии, Ложь);
	Если РезультатПроверки.Количество() >  0 Тогда
		
		ИнформацияОПроблеме = РезультатПроверки[0];
		ШаблонОшибки = НСтр("ru = 'Ошибка проверки новой версии расширения: %1'");
		ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, ИнформацияОПроблеме.Описание);
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	РасширениеКонфигурации.Записать(ФайлНовойВерсии);
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Получает менеджер расширения конфигурации Контур.Маркировка
//  Вариант через метаданные объекта выдает ошибку при попытке обновить расширение:
// 
// Возвращаемое значение:
//  РасширениеКонфигурации - если установлено расширение КонтурМаркировка;
//  Неопределено - расширение КонтурМаркировка не установлено;
//
Функция РасширениеКонфигурацииКонтурМаркировка()
	
	Результат = Неопределено;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Имя", ИмяМодуля());
	
	МенеджерРасширений = Вычислить("РасширенияКонфигурации");
	
	РасширениеКонтурМаркировка = МенеджерРасширений.Получить(Отбор);
	Если РасширениеКонтурМаркировка.Количество() > 0 Тогда
		Результат = РасширениеКонтурМаркировка[0];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Записывает новый файл в справочник внешних обработок
//
// Параметры:
//  ОписаниеОбработки - Структура      - см. функцию Новый_ОписаниеВнешнейОбработки();
//  ДвоичныеДанные    - ДвоичныеДанные - файл обработки;
//  ВерсияОбработки   - Строка         - версия обработки;
//
Процедура ЗаписатьФайлВСправочникВнешнихОбработок(ОписаниеОбработки, ДвоичныеДанные, ВерсияОбработки)
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	СведенияОбОбработке = СведенияОВнешнейОбработкеИзФайла(ДвоичныеДанные);
	
	Если ЗначениеЗаполнено(ОписаниеОбработки.Ссылка) Тогда
		ОбработкаОбъект = ОписаниеОбработки.Ссылка.ПолучитьОбъект();
	Иначе
		ОбработкаОбъект = Справочники[ИмяСправочникаВнешнихОбработок()].СоздатьЭлемент();
	КонецЕсли;
	
	ОбработкаОбъект[ОписаниеОбработки.ИмяПоляВерсии] = ВерсияОбработки;
	ОбработкаОбъект.Наименование = СведенияОбОбработке.Наименование;
	ОбработкаОбъект[ОписаниеОбработки.ИмяПоляХранилища] = Новый ХранилищеЗначения(ДвоичныеДанные);
	
	Если ЗначениеЗаполнено(ОписаниеОбработки.ВидОбработки)
		И ЗначениеЗаполнено(ОписаниеОбработки.ИмяПоляВидОбработки) Тогда
		ОбработкаОбъект[ОписаниеОбработки.ИмяПоляВидОбработки] = ОписаниеОбработки.ВидОбработки;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОбработки.ИмяОбъекта)
		И ЗначениеЗаполнено(ОписаниеОбработки.ИмяПоляИмяОбъекта) Тогда
		ОбработкаОбъект[ОписаниеОбработки.ИмяПоляИмяОбъекта] = ОписаниеОбработки.ИмяОбъекта;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОбработки.Публикация)
		И ЗначениеЗаполнено(ОписаниеОбработки.ИмяПоляПубликация) Тогда
		ОбработкаОбъект[ОписаниеОбработки.ИмяПоляПубликация] = ОписаниеОбработки.Публикация;
	КонецЕсли;
	
	ОбновитьКомандыОбработкиВСправочнике(ОбработкаОбъект, СведенияОбОбработке);
	
	ОбработкаОбъект.ОбменДанными.Загрузка = Истина;
	ОбработкаОбъект.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ОбновитьКомандыОбработкиВСправочнике(ОбработкаОбъект, СведенияОбОбработке)
	
	Если ОбработкаОбъект.Метаданные().ТабличныеЧасти.Найти("Команды") = Неопределено
		Или Не ЕстьНеобходимыеМетаданные("Перечисления.СпособыВызоваДополнительныхОбработок") Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаРегЗаданий = ОбработкаОбъект.Команды.Выгрузить(, "Идентификатор, РегламентноеЗаданиеGUID");
	
	ОбработкаОбъект.Команды.Очистить();
	
	Для Каждого ОписаниеКоманды Из СведенияОбОбработке.Команды Цикл
		Команда = ОбработкаОбъект.Команды.Добавить();
		ЗаполнитьЗначенияСвойств(Команда, ОписаниеКоманды);
		Команда.ВариантЗапуска = Перечисления.СпособыВызоваДополнительныхОбработок[ОписаниеКоманды.Использование];
	КонецЦикла;
	
	Для Каждого Стр Из ТаблицаРегЗаданий Цикл
		
		Если ЭтоСтрокаПустогоИдентификатора(Стр.РегламентноеЗаданиеGUID) Тогда
			Продолжить;
		КонецЕсли;
		
		Команда = ОбработкаОбъект.Команды.Найти(Стр.Идентификатор, "Идентификатор");
		
		Если Команда <> Неопределено Тогда
			Команда.РегламентноеЗаданиеGUID = Стр.РегламентноеЗаданиеGUID;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СведенияОВнешнейОбработкеИзФайла(ДвоичныеДанные)
	
	ИмяОбработки = "КонтурМаркировкаВременнаяОбработкаДляПолученияСведений";
	
	МодульОбщегоНазначения().ПодключитьВнешнююОбработкуБезПредупреждений(ДвоичныеДанные, ИмяОбработки);
	
	ВнешняяОбработка = МодульОбщегоНазначения().СоздатьВнешнююОбработкуПоИмени(ИмяОбработки);
	
	Возврат ВнешняяОбработка.СведенияОВнешнейОбработке();
	
КонецФункции

Процедура ПроверитьВозможностьУведомленияПользователяОНовойВерсии(КонтекстОбновления)
	
	МаксКоличество = 3;
	КоличествоУведомленй = КоличествоУведомленйОНовойВерсии(КонтекстОбновления.НоваяВерсияМодуля);
	КонтекстОбновления.НельзяПоказыватьУведомлениеОНовойВерсии = (КоличествоУведомленй >= МаксКоличество);
	
