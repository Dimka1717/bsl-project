// Возвращаемое значение:
//  СправочникСсылка - пустая ссылка
//
Функция ПолучитьПустуюСсылкуТипа(ИмяТипа) Экспорт
	
	ТипРезультата = Тип(ИмяТипа);
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(ТипРезультата);
	
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	
	Результат = ОписаниеТипов.ПривестиЗначение(Неопределено);
	
	Возврат Результат;
	
