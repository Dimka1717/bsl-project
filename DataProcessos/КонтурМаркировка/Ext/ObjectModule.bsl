// Добавляет на форму дополнительные кнопки по настройкам из ПМ
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, на которую нужно добавить кнопки;
//  НастройкиДопКнопок - Массив - содержит структуры см. Новый_НастройкаДопКнопки();
//  ГруппаКнопок - ГруппаКнопок - подменю доп действий, в которое нужно добавить кнопки;
//  Действие - Строка - имя метода, который нужно вызвать при нажатии кнопки;
//
Процедура ДобавитьНаФормуДополнительныеКнопки(Форма, НастройкиДопКнопок, ГруппаКнопок, Действие) Экспорт
	
	ПрефиксДопКнопки = ПрефиксДополнительнойКнопки();
	
	Для каждого Настройка Из НастройкиДопКнопок Цикл
		
		ИмяКнопки = ПрефиксДопКнопки + Настройка.ИмяКнопки;
		
		Кнопка = Форма.Элементы.Найти(ИмяКнопки);
		Если Кнопка <> Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		КомандаКнопки = Форма.Команды.Добавить(ИмяКнопки);
		КомандаКнопки.Действие = Действие;
		КомандаКнопки.Заголовок = Настройка.Заголовок;
		
		Кнопка = Форма.Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), ГруппаКнопок);
		Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		Кнопка.ИмяКоманды = ИмяКнопки;
		Кнопка.Видимость = Истина;
		
	КонецЦикла;

КонецПроцедуры

// Получает из ПМ массив с настройками дополнительных кнопок
// 
// Возвращаемое значение:
//  Массив - содержит структуры, см. Новый_НастройкаДопКнопки()
//
Функция НастройкиДополнительныхКнопок(Размещение = Неопределено
	, ТипДокумента = Неопределено
	, ТипОперации = Неопределено) Экспорт
	
	ПараметрыПМ = Новый Структура("НастройкиДопКнопок", Новый Массив);
	ПМ_ОбработатьСобытие_ПриНастройкеДополнительныхКнопок(ПараметрыПМ);
	
	НастройкиДопКнопок = ПараметрыПМ.НастройкиДопКнопок;
	Если Не ЗначениеЗаполнено(НастройкиДопКнопок) Тогда
		Возврат НастройкиДопКнопок;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Размещение) Тогда
		Отбор = Новый Структура("Размещение", Размещение);
		НастройкиДопКнопок = МассивСтруктур_НайтиСтроки(НастройкиДопКнопок, Отбор);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипОперации) Тогда
		Отбор = Новый Структура("ТипОперации", ТипОперации);
		НастройкиДопКнопок = МассивСтруктур_НайтиСтроки(НастройкиДопКнопок, Отбор);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипДокумента) Тогда
		Отбор = Новый Структура("ТипДокумента", ТипДокумента);
		НастройкиДопКнопок = МассивСтруктур_НайтиСтроки(НастройкиДопКнопок, Отбор);
	КонецЕсли;
	
	Возврат НастройкиДопКнопок;
	
КонецФункции

