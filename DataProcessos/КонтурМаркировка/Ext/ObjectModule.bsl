Процедура КонтурПлагины_ПриУдаленииПлагина(ПараметрыСобытия)
	
	Плагин = КонтурПлагины_НайтиПлагин(ПараметрыСобытия.Идентификатор);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Файлы_Удалить(Файлы_Найти(Плагин, Перечисление_ТипыФайлов().ФайлПлагина));
		Файлы_Удалить(Файлы_Найти(Плагин, Перечисление_ТипыФайлов().ФайлНастроекПлагина));
		
		ОбъектПлагина = Плагин.ПолучитьОбъект();
		ОбъектПлагина.ОбменДанными.Загрузка = Истина;
		ОбъектПлагина.Удалить();
		
		ПараметрыСобытия.Результат.Успешно = Истина;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Удаление плагина'");
		ШаблонСтроки = НСтр("ru = 'Не удалось удалить плагин с идентификатором: %1'");
		ТекстСообщения = ПараметрыВСтроку(ШаблонСтроки, ПараметрыСобытия.Идентификатор);
		
		ОбработатьОшибку(Действие, Ошибка,, ТекстСообщения);
		
		ПараметрыСобытия.Результат.Успешно = Ложь;
		
	КонецПопытки;
	
КонецПроцедуры

