// Создает и обновляет товары по данным сервиса на основании переданного массива GTIN
//
// Параметры:
//  МассивGTIN - Массив - содержит строки GTIN;
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
// 
// Возвращаемое значение:
//  Структура - содержит количество созданных и обновленных товаров;
//
Функция ОтчетПоВиртуальномуСкладу_ПолучитьИнформациюИзСервиса(МассивGTIN, Организация)
	
	Возврат МодульЯдро().ОтчетПоВиртуальномуСкладу_ПолучитьИнформациюИзСервиса(МассивGTIN, Организация);
	
КонецФункции

Процедура ОтчетПоВиртуальномуСкладу_Сформировать(КонтекстФормирования, ТабличныйДокумент) Экспорт
	
	СхемаСКД = ПолучитьМакет("МакетСКДОтчетаОВиртуальныхОстатках");
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаСКД));
	
	ВидыПродукцииОСУ = Новый СписокЗначений;
	ВидыПродукцииОСУ.ЗагрузитьЗначения(МодульЯдро().ДопустимыеВидыПродукцииДляОСУ());
	
	НастройкиОтчета = СхемаСКД.НастройкиПоУмолчанию;
	ПараметрВидыПродукцииОСУ = Новый ПараметрКомпоновкиДанных("ВидыПродукцииОСУ");
	ЗначениеПараметраВидыПродукцииОСУ = НастройкиОтчета.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрВидыПродукцииОСУ);
	ЗначениеПараметраВидыПродукцииОСУ.Значение = ВидыПродукцииОСУ;
	
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиОтчета);
	
	СписокТоваров = КонтекстФормирования.СписокТоваров;
	Если СписокТоваров.Количество() > 0 Тогда
		СКД_УстановитьОтбор(КомпоновщикНастроек,
							"Товар",
							ВидСравненияКомпоновкиДанных.ВСписке,
							СписокТоваров);
	КонецЕсли;
	
	МассивGTIN = ОтчетПоВиртуальномуСкладу_МассивGTIN(СхемаСКД, КомпоновщикНастроек);
	
	Если МассивGTIN.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаДанныхСервиса = ОтчетПоВиртуальномуСкладу_ПолучитьИнформациюИзСервиса(МассивGTIN, КонтекстФормирования.Организация);
	
	ОтчетПоВиртуальномуСкладу_ВывестиТабличныйДокумент(СхемаСКД, КомпоновщикНастроек, ТаблицаДанныхСервиса, ТабличныйДокумент);
	
	// Метрики
	
	ФормаИнициатор = КонтекстФормирования.ФормаИнициатор;
	
	Функциональность = Перечисление_ФункциональностьМодуля();
	
	Если ФормаИнициатор = "Форма_Товар" Тогда
		СтекМетрик_ДобавитьФункциональность(Функциональность.ФормированиеОтчетаПоВиртуальномуСкладуИзКарточкиТовара,
											КонтекстФормирования.Организация);
	КонецЕсли;
	
	Если ФормаИнициатор = "Форма_ДокументУчета" Тогда
		СтекМетрик_ДобавитьФункциональность(Функциональность.ФормированиеОтчетаПоВиртуальномуСкладуИзДокументаУчета,
											КонтекстФормирования.Организация);
	КонецЕсли;
	
	Если ФормаИнициатор = "ФормаМодуля" Тогда
		СтекМетрик_ДобавитьФункциональность(Функциональность.ФормированиеОтчетаПоВиртуальномуСкладуИзМенюОтчеты,
											КонтекстФормирования.Организация);
	КонецЕсли;
	
	Если ФормаИнициатор = "Форма_Товары_Список" Тогда
		СтекМетрик_ДобавитьФункциональность(Функциональность.ФормированиеОтчетаПоВиртуальномуСкладуИзСпискаТоваров,
											КонтекстФормирования.Организация);
	КонецЕсли;
	
	
КонецПроцедуры

Функция ОтчетПоВиртуальномуСкладу_МассивGTIN(СхемаСКД, КомпоновщикНастроек)
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(СхемаСКД,
										КомпоновщикНастроек.ПолучитьНастройки(),,,
										Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ТаблицаДанныхСервиса = Новый_ТаблицаДанныхСервисаПоВиртуальномуОстатку();
	ИсточникДанных = Новый Структура("ДанныеСервиса", ТаблицаДанныхСервиса);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(Макет, ИсточникДанных);
	
	ПодходящиеGTIN = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ПодходящиеGTIN);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Возврат ПодходящиеGTIN.ВыгрузитьКолонку("GTIN");
	
КонецФункции

Процедура ОтчетПоВиртуальномуСкладу_ВывестиТабличныйДокумент(СхемаСКД, КомпоновщикНастроек, ТаблицаДанныхСервиса, ТабличныйДокумент)
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(СхемаСКД, КомпоновщикНастроек.ПолучитьНастройки());
	
	ИсточникДанных = Новый Структура("ДанныеСервиса", ТаблицаДанныхСервиса);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(Макет, ИсточникДанных);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабличныйДокумент);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
КонецПроцедуры

Процедура СКД_УстановитьОтбор(КомпоновщикНастроекДанныхОтчета, ИмяПоляКомпоновки, ВидСравнения, ПравоеЗначение)
	
	ЭлементыОтбораКомпоновщика = КомпоновщикНастроекДанныхОтчета.Настройки.Отбор.Элементы;
	
	Для Индекс = - (ЭлементыОтбораКомпоновщика.Количество() - 1) По 0 Цикл
		Если ЭлементыОтбораКомпоновщика[-Индекс].ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоляКомпоновки) Тогда
			ЭлементыОтбораКомпоновщика.Удалить(ЭлементыОтбораКомпоновщика[-Индекс]);
		КонецЕсли;
	КонецЦикла;
	
	НоменклатураОтбор = ЭлементыОтбораКомпоновщика.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НоменклатураОтбор.ВидСравнения = ВидСравнения;
	НоменклатураОтбор.Использование = Истина;
	НоменклатураОтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоляКомпоновки);
	НоменклатураОтбор.ПравоеЗначение = ПравоеЗначение;

КонецПроцедуры

