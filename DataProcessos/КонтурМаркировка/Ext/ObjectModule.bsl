Функция РегламентноеЗадание(ОписаниеЗадания, СоздатьЗадание = Ложь)
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	Отбор = Новый Структура;
	Отбор.Вставить("Ключ", ОписаниеЗадания.Ключ);
	МассивЗаданий = РегламентныеЗадания.ПолучитьРегламентныеЗадания(Отбор);
	
	Результат = ЗначениеИзМассива(МассивЗаданий, 0);
	
	Если Результат = Неопределено И СоздатьЗадание Тогда
		
		МетаданныеЗадания = МетаданныеРегламентногоЗадания(ОписаниеЗадания);
		
		Результат = РегламентныеЗадания.СоздатьРегламентноеЗадание(МетаданныеЗадания);
		Результат.Наименование = ОписаниеЗадания.Наименование;
		Результат.Ключ = ОписаниеЗадания.Ключ;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

