Процедура ЗапуститьРегламентноеЗаданиеВТекущемСеансе(ОписаниеЗадания)
	
	ПараметрыКоманды = Новый_ПараметрыКомандыОбработки();
	ПараметрыКоманды.ИдентификаторКоманды = ОписаниеЗадания.Команда;
	
	НаименованиеЗадания = ОписаниеЗадания.Наименование;
	ПараметрыМетода = ПараметрыВыполненияРегламентныхЗаданий(ПараметрыКоманды);
	ИмяМетода = МетодВыполненияРегламентногоЗадания(ОписаниеЗадания);

	ПараметрыСтрока = "";
	Если ПараметрыМетода <> Неопределено И ПараметрыМетода.Количество() > 0 Тогда
		Для Индекс = 0 По ПараметрыМетода.ВГраница() Цикл 
			ПараметрыСтрока = ПараметрыСтрока + "ПараметрыМетода[" + Индекс + "],";
		КонецЦикла;
		ПараметрыСтрока = Сред(ПараметрыСтрока, 1, СтрДлина(ПараметрыСтрока) - 1);
	КонецЕсли;
	
	Выполнить ИмяМетода + "(" + ПараметрыСтрока + ")";
	
КонецПроцедуры

