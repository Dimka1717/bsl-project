Функция Новый_ВидАгрегата() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ссылка");
	Результат.Вставить("Наименование");
	Результат.Вставить("Организация");
	Результат.Вставить("ТипКода");
	Результат.Вставить("ТипАгрегата");
	Результат.Вставить("КодТипаАгрегата");
	Результат.Вставить("Префикс");
	Результат.Вставить("ТипШтрихкода");
	
	Возврат Результат;
	
КонецФункции

Функция ВидАгрегата_Прочитать(ВидАгрегата) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка,
	|	Т.Наименование КАК Наименование,
	|	Т.Организация КАК Организация,
	|	Т.ТипКода КАК ТипКода,
	|	Т.ТипАгрегата КАК ТипАгрегата,
	|	Т.КодТипаАгрегата КАК КодТипаАгрегата,
	|	Т.Префикс КАК Префикс
	|ИЗ
	|	Справочник.КонтурМаркировка_ВидыАгрегатов КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка", ВидАгрегата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый_ВидАгрегата();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, ВидАгрегата);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ВидАгрегата_Записать(ОписаниеВидаАгрегата) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Если ЗначениеЗаполнено(ОписаниеВидаАгрегата.Ссылка) Тогда
			
			Если ОбъектВПроцессеОбновления(ОписаниеВидаАгрегата.Ссылка) Тогда
				ВызватьИсключение_ОбъектВПроцессеОбновления(ОписаниеВидаАгрегата.Ссылка);
			КонецЕсли;
			
			ВидАгрегата = ОписаниеВидаАгрегата.Ссылка;
			ОбъектВидаАгрегата = ВидАгрегата.ПолучитьОбъект();
			
		Иначе
			ОбъектВидаАгрегата = Справочники.КонтурМаркировка_ВидыАгрегатов.СоздатьЭлемент();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ОбъектВидаАгрегата, ОписаниеВидаАгрегата , , "Ссылка");
		
		ОбъектВидаАгрегата.Записать();
		ОписаниеВидаАгрегата.Ссылка = ОбъектВидаАгрегата.Ссылка;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция ВидыАгрегатов_ВсеСсылки(Организация = Неопределено) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_ВидыАгрегатов КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|	И &Организация";
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Организация", "Т.Организация = &Организация");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Организация", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", Организация);
	Результат = МассивИзРезультатаЗапроса(Запрос);
	
	Возврат Результат;
	
КонецФункции

