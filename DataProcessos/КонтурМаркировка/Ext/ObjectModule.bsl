Функция ИнформацияОНастройкахМодуля()
	
	НастройкиМодуля = НастройкиМодуля();
	
	Результат = Новый Структура;
	Результат.Вставить("ПодключаемыйМодуль", 
						Формат(НастройкиМодуля.ПМ_Использовать
						, "БЛ=Отсутствует; БИ=Подключен"));
	Результат.Вставить("ИдентификаторЭкземпляраМодуля", НастройкиМодуля.ИдентификаторЭкземпляраМодуля);
	Результат.Вставить("РазрешитьПодписьНаСервере",     НастройкиМодуля.РазрешитьПодписьНаСервере);
	Результат.Вставить("Прокси_Использовать",           НастройкиМодуля.Прокси_Использовать);
	
	Возврат Результат;
	
КонецФункции

Функция ИнформацияОПлагинах()
	
