	ТипыОпераций = Перечисление_ТипыОпераций();
	СпособыВыпускаТоваров = Перечисление_СпособыВыпускаТоваров();
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	
	ТипОперации = ОписаниеОперации.ТипОперации;
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	
	Если ТипОперации <> ТипыОпераций.ПечатьКодов Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ОперацияОснование) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Результат = Ложь;
	ТипОперацииОснования = ЗначениеРеквизитаОбъекта_Марк(ОперацияОснование, "ТипОперации");
	Если ТипОперацииОснования = ТипыОпераций.ЗаказКодов Тогда
		ОписаниеОперацииОснования = Операция_ПрочитатьОперацию(ОперацияОснование);
		ДопРеквизитыОснования = ОписаниеОперацииОснования.ДопРеквизиты;
		Если Не ДопРеквизитыОснования.ТипКодаМаркировки = ТипыКодовМаркировки.Набор
			И Не ДопРеквизитыОснования.СпособВыпускаТоваров = СпособыВыпускаТоваров.Перемаркировка Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура Операция_ПечатьКодов_ЗаполнитьШаблоныЭтикеток(ОписаниеОперации) Экспорт
	
	Настройки = НастройкиМодуля();
	ТипыЭтикеток = Перечисления.КонтурМаркировка_ТипыЭтикеток;
	ТипыЭтикетокВОперации = Операция_ПечатьКодов_ТипыЭтикеток(ОписаниеОперации.Ссылка);
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	
	Если МассивСодержитЗначение(ТипыЭтикетокВОперации, ТипыЭтикеток.Товарная) Тогда
		
		ДопРеквизиты.ЕстьТоварныеЭтикетки = Истина;
		
		Если Не ЗначениеЗаполнено(ДопРеквизиты.ШаблонТоварнойЭтикетки) Тогда
			ДопРеквизиты.ШаблонТоварнойЭтикетки = Настройки.ШаблонТоварнойЭтикеткиПоУмолчанию;
		КонецЕсли;
		ДопРеквизиты.ПечататьТоварныеЭтикетки = ЗначениеЗаполнено(ДопРеквизиты.ШаблонТоварнойЭтикетки);
		
	Иначе
		ДопРеквизиты.ЕстьТоварныеЭтикетки = Ложь;
		ДопРеквизиты.ПечататьТоварныеЭтикетки = Ложь;
		ДопРеквизиты.ШаблонТоварнойЭтикетки = Неопределено;
	КонецЕсли;
	
	Если МассивСодержитЗначение(ТипыЭтикетокВОперации, ТипыЭтикеток.Групповая) Тогда
		
		ДопРеквизиты.ЕстьГрупповыеЭтикетки = Истина;
		
		Если Не ЗначениеЗаполнено(ДопРеквизиты.ШаблонГрупповойЭтикетки) Тогда
			ДопРеквизиты.ШаблонГрупповойЭтикетки = Настройки.ШаблонГрупповойЭтикеткиПоУмолчанию;
		КонецЕсли;
		ДопРеквизиты.ПечататьГрупповыеЭтикетки = ЗначениеЗаполнено(ДопРеквизиты.ШаблонГрупповойЭтикетки);
		
	Иначе
		ДопРеквизиты.ЕстьГрупповыеЭтикетки = Ложь;
		ДопРеквизиты.ПечататьГрупповыеЭтикетки = Ложь;
		ДопРеквизиты.ШаблонГрупповойЭтикетки = Неопределено;
	КонецЕсли;
	
	Если МассивСодержитЗначение(ТипыЭтикетокВОперации, ТипыЭтикеток.Транспортная) Тогда
		
		ДопРеквизиты.ЕстьТранспортныеЭтикетки = Истина;
		
		Если Не ЗначениеЗаполнено(ДопРеквизиты.ШаблонТранспортнойЭтикетки) Тогда
			ДопРеквизиты.ШаблонТранспортнойЭтикетки = Настройки.ШаблонТранспортнойЭтикеткиПоУмолчанию;
		КонецЕсли;
		ДопРеквизиты.ПечататьТранспортныеЭтикетки = ЗначениеЗаполнено(ДопРеквизиты.ШаблонТранспортнойЭтикетки);
		
	Иначе
		ДопРеквизиты.ЕстьТранспортныеЭтикетки = Ложь;
		ДопРеквизиты.ПечататьТранспортныеЭтикетки = Ложь;
		ДопРеквизиты.ШаблонТранспортнойЭтикетки = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

// #Область Заполнение

// Заполняет операцию и таблицу кодов для нее
//
// Параметры:
//  ОписаниеОперации  - Структура - см. Новый_Операция();
//  ТаблицаКодов - Таблица значений - талица кодов операции, см. функцию Новый_ТаблицаКодов();
//
Процедура Операция_Заполнить(ОписаниеОперации, ТаблицаКодов = Неопределено)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	
	Операция_ЗаполнитьШапку(ОписаниеОперации);
	Операция_ЗаполнитьТипКодаМаркировки(ОписаниеОперации);
	Операция_ЗаполнитьТЧ(ОписаниеОперации, ТаблицаКодов);
	Операция_ЗаполнитьВидПродукции(ОписаниеОперации, ТаблицаКодов);
	Операция_ЗаполнитьТипСрокаГодности(ОписаниеОперации);
	Операция_ЗаполнитьСостояниеКодов(ОписаниеОперации);
	
	Операция_ЗаполнитьПричинуВыводаИзОборота(ОписаниеОперации);
	Операция_ЗаполнитьСпособВыпускаТоваровНаОстатки(ОписаниеОперации);
	Операция_ЗаполнитьТипОтгрузки(ОписаниеОперации);
	Операция_ЗаполнитьГруппуТНВЭД(ОписаниеОперации);
	
	Операция_ЗаполнитьЗначенияПоУмолчанию(ОписаниеОперации);
	Операция_ЗаполнитьТЧЗначениямиПоУмолчанию(ОписаниеОперации);
	
	Операция_ЗаполнитьПроизводительИСобственникТовараИНН(ОписаниеОперации);
	Операция_ЗаполнитьДатуПроизводства(ОписаниеОперации);
	Операция_ЗаполнитьАльтернативныеСрокиГодности(ОписаниеОперации);
	
	Операция_ЗаполнитьИзНастроекЗаполнения(ОписаниеОперации);
	
	ПМ_ОбработатьСобытие_ПриЗаполненииОперации(ОписаниеОперации, ТаблицаКодов);
	
	Операция_СгруппироватьСтрокиТоваров(ОписаниеОперации, ТаблицаКодов);
	
КонецПроцедуры

Процедура Операция_СгруппироватьСтрокиТоваров(ОписаниеОперации, ТаблицаКодов) Экспорт
	
	Если Не НастройкиМодуля().ГруппироватьСтрокиТоваровОпераций
		Или Не Операция_ПоддерживаетГруппировкуСтрокТоваров(ОписаниеОперации.ТипОперации) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		Если ЗначениеЗаполнено(Стр.АльтернативныеСрокиГодности) Тогда
			Стр.АльтернативныеСрокиГодности = ЗначениеВСтрокуВнутр(Стр.АльтернативныеСрокиГодности);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаГруппировки = ОписаниеОперации.Товары.Скопировать();
	
	КолонкиСуммирования = Новый Массив;
	КолонкиСуммирования.Добавить(ТаблицаГруппировки.Колонки.Количество.Имя);
	КолонкиСуммирования.Добавить(ТаблицаГруппировки.Колонки.КоличествоУпаковок.Имя);
	КолонкиСуммирования.Добавить(ТаблицаГруппировки.Колонки.КоличествоУпаковокВложенногоТовара.Имя);
	
	КолонкиИсключения = Новый Массив;
	КолонкиИсключения.Добавить(ТаблицаГруппировки.Колонки.НомерСтроки.Имя);
	КолонкиИсключения.Добавить(ТаблицаГруппировки.Колонки.КлючСтрокиДокумента.Имя);
	КолонкиИсключения.Добавить(ТаблицаГруппировки.Колонки.КлючСтрокиОперации.Имя);
	
	ТаблицаЗначений_СвернутьПоВсемКолонкам(ТаблицаГруппировки
	, СоединитьСтроку(КолонкиСуммирования, ", ")
	, СоединитьСтроку(КолонкиИсключения, ", "));
	
	Отбор = Новый Структура();
	Для Каждого Колонка Из ТаблицаГруппировки.Колонки Цикл
		Если МассивСодержитЗначение(КолонкиСуммирования, Колонка.Имя)
			Или МассивСодержитЗначение(КолонкиИсключения, Колонка.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Отбор.Вставить(Колонка.Имя);
	КонецЦикла;
	
	Индекс = ТаблицаКодов.Индексы.Добавить("КлючСтрокиОперации");
	
	Для Каждого Стр Из ТаблицаГруппировки Цикл
		Стр.КлючСтрокиОперации = Новый УникальныйИдентификатор;
		Стр.КлючСтрокиДокумента = ПустойУникальныйИдентификатор();
		ЗаполнитьЗначенияСвойств(Отбор, Стр);
		СтрокиТоваровОперации = ОписаниеОперации.Товары.НайтиСтроки(Отбор);
		Для Каждого СтрокаТовара Из СтрокиТоваровОперации Цикл
			СтрокиКодов = ТаблицаКодов.НайтиСтроки(Новый Структура("КлючСтрокиОперации", СтрокаТовара.КлючСтрокиОперации));
			Для Каждого СтрокаКода Из СтрокиКодов Цикл
				СтрокаКода.КлючСтрокиОперации = Стр.КлючСтрокиОперации;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаКодов.Индексы.Удалить(Индекс);
	
	Для Каждого Стр Из ТаблицаГруппировки Цикл
		Если ЗначениеЗаполнено(Стр.АльтернативныеСрокиГодности) Тогда
			Стр.АльтернативныеСрокиГодности = ЗначениеИзСтрокиВнутр(Стр.АльтернативныеСрокиГодности);
		КонецЕсли;
	КонецЦикла;
	
	ОписаниеОперации.Товары = ТаблицаГруппировки;
	
КонецПроцедуры

// Заполняет шапку операции необходимыми данными
// в зависимости от её типа наличии документа учета
//
// Параметры:
//  ОписаниеОперации - Структура - см. Новый_Операция()
//
Процедура Операция_ЗаполнитьШапку(ОписаниеОперации)
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ДокументУчета) Тогда
		Операция_ЗаполнитьШапку_ПоДокументуУчета(ОписаниеОперации);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ОперацияОснование) Тогда
		Операция_ЗаполнитьШапку_ПоОснованию(ОписаниеОперации);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьШапку_ПоДокументуУчета(ОписаниеОперации)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ТипОперации = ОписаниеОперации.ТипОперации;
	ОписаниеДокумента = ДокументУчета_ПрочитатьДокумент(ОписаниеОперации.ДокументУчета);
	
	ОписаниеОперации.Организация = ОписаниеДокумента.Организация;
	ОписаниеОперации.Склад = ОписаниеДокумента.Склад;
	
	Если ТипОперации = ТипыОпераций.СообщениеОбОтгрузке
		Или ТипОперации = ТипыОпераций.ОтчетОВыбытииНаТСД
		Или ТипОперации = ТипыОпераций.ПодборКодовНаТСД
		Или ТипОперации = ТипыОпераций.ПодборТоваровИКодовНаТСД Тогда
		
		ОписаниеОперации.ДопРеквизиты.НомерДокумента = ОписаниеДокумента.Номер;
		ОписаниеОперации.ДопРеквизиты.ДатаДокумента = ОписаниеДокумента.Дата;
		
		Если ЗначениеЗаполнено(ОписаниеДокумента.ДопРеквизиты.Контрагент1С) Тогда
			
			РеквизитыКонтрагента = Интеграция_РеквизитыКонтрагента1С(ОписаниеДокумента.ДопРеквизиты.Контрагент1С);
			
			Если ОписаниеОперации.ТипОперации = ТипыОпераций.СообщениеОбОтгрузке Тогда
				ОписаниеОперации.ДопРеквизиты.ИННПолучателя = РеквизитыКонтрагента.ИНН;
			Иначе
				ОписаниеОперации.ДопРеквизиты.КонтрагентНаименование = РеквизитыКонтрагента.Представление;
				ОписаниеОперации.ДопРеквизиты.КонтрагентИНН = РеквизитыКонтрагента.ИНН;
				ОписаниеОперации.ДопРеквизиты.КонтрагентКПП = РеквизитыКонтрагента.КПП;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.Ссылка) Тогда
		Операция_ЗаполнитьПризнакОСУ(ОписаниеОперации, ОписаниеДокумента);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьШапку_ПоОснованию(ОписаниеОперации)
	
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	РеквизитыОснования = ЗначенияРеквизитовОбъекта_Марк(ОперацияОснование, "Организация, Склад, ВидПродукции, ТипОперации");
	ЗаполнитьЗначенияСвойств(ОписаниеОперации, РеквизитыОснования, "Организация, Склад, ВидПродукции");
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ТипОперации = ОписаниеОперации.ТипОперации;
	ТипОперацииОснования = РеквизитыОснования.ТипОперации;
	
	Если ТипОперацииОснования = ТипыОпераций.УведомлениеОСостоянииКодов Тогда
		
		Если ТипОперации = ТипыОпераций.ВыводИзОборота Тогда
			Операция_ВыводИзОборота_ЗаполнитьШапку_ПоУведомлениюОбЭкспорте(ОписаниеОперации);
		КонецЕсли;
		
		Если ТипОперации = ТипыОпераций.УведомлениеОСостоянииКодов Тогда
			Операция_УведомлениеОСостоянииКодов_ЗаполнитьШапку_ПоУведомлениюОбЭкспорте(ОписаниеОперации);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПерезаполнитьТаблицыОперации(ОписаниеОперации, ТаблицаКодов) Экспорт
	
	Операция_ЗаполнитьТЧ(ОписаниеОперации, ТаблицаКодов);
	Операция_ЗаполнитьТЧЗначениямиПоУмолчанию(ОписаниеОперации);
	Операция_ЗаполнитьАльтернативныеСрокиГодности(ОписаниеОперации);
	
	ПМ_ОбработатьСобытие_ПриИзмененииОперации(ОписаниеОперации, ТаблицаКодов);
	
	Операция_СгруппироватьСтрокиТоваров(ОписаниеОперации, ТаблицаКодов);
	
КонецПроцедуры

// Заполняет в операции товары и таблицу кодов
//
// Параметры:
//  ОписаниеОперации - Структура - см. Новый_Операция();
//  ТаблицаКодов - ТаблицаЗначений - см. Новый_ТаблицаКодов();
//
Процедура Операция_ЗаполнитьТЧ(ОписаниеОперации, ТаблицаКодов) Экспорт
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ТипОперации = ОписаниеОперации.ТипОперации;
	
	Если ТипОперации = ТипыОпераций.Перемаркировка Тогда
		
		Операция_ЗаполнитьТЧ_Перемаркировка(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.НаполнениеНаборовНаТСД Тогда
		
		Операция_ЗаполнитьТЧ_НаполнениеНаборовНаТСД(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.АгрегацияКодов
		Или ТипОперации = ТипыОпераций.ОтчетОВыбытииНаТСД
		Или ТипОперации = ТипыОпераций.ПодборКодовНаТСД
		Или ТипОперации = ТипыОпераций.ВозвратВОборотНаТСД Тогда
		
		Операция_ЗаполнитьТЧ_ПоДокументу(ОписаниеОперации);
		
	ИначеЕсли ТипОперации = ТипыОпераций.ВводВОборот Тогда
		
		Операция_ЗаполнитьТЧ_ВводВОборот(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.ОтчетОНанесении Тогда
		
		Операция_ЗаполнитьТЧ_ОтчетОНанесении(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.ОтчетОНанесенииНаТСД Тогда
		
		Операция_ЗаполнитьТЧ_ОтчетОНанесенииНаТСД(ОписаниеОперации)
		
	ИначеЕсли ТипОперации = ТипыОпераций.ЗаказКодов Тогда
		
		Операция_ЗаполнитьТЧ_ЗаказКодов(ОписаниеОперации);
		
	ИначеЕсли ТипОперации = ТипыОпераций.ПодборТоваровИКодовНаТСД Тогда
		
		Операция_ЗаполнитьТЧ_ПодборТоваровИКодовНаТСД(ОписаниеОперации);
		
	ИначеЕсли ТипОперации = ТипыОпераций.РегистрацияАгрегатов Тогда
		
		Операция_ЗаполнитьТЧ_РегистрацияКИТУ(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.РасформированиеАгрегатов Тогда
		
		Операция_ЗаполнитьТЧ_РасформированиеКИТУ(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.СообщениеОбОтгрузке Тогда
		
		Если ОписаниеОперации.ДопРеквизиты.ОбъемноСортовойУчет Тогда
			Операция_ЗаполнитьТЧ_ОперацииПоОСУ(ОписаниеОперации);
		Иначе
			Операция_ЗаполнитьТЧ_СообщениеОбОтгрузке(ОписаниеОперации, ТаблицаКодов);
		КонецЕсли;
		
	ИначеЕсли ТипОперации = ТипыОпераций.ВыводИзОборота Тогда
		
		Если ОписаниеОперации.ДопРеквизиты.ОбъемноСортовойУчет Тогда
			Операция_ЗаполнитьТЧ_ОперацииПоОСУ(ОписаниеОперации);
		Иначе
			Операция_ЗаполнитьТЧ_ВыводИзОборота(ОписаниеОперации, ТаблицаКодов);
		КонецЕсли;
		
	ИначеЕсли ТипОперации = ТипыОпераций.ОтчетОВыбытии Тогда
		
		Операция_ЗаполнитьТЧ_ОтчетОВыбытии(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.НаполнениеКИГУ Тогда
		
		Операция_ЗаполнитьТЧ_НаполнениеКИГу(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.РегистрацияКИГУ Тогда
		
		Операция_ЗаполнитьТЧ_РегистрацияКИГу(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.ВозвратВОборот Тогда
		
		Операция_ЗаполнитьТЧ_ВозвратВОборот(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ОписаниеОперации.ТипОперации = ТипыОпераций.ФормированиеАТК Тогда
		
		Операция_ЗаполнитьТЧ_ФормированиеАТК(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ОписаниеОперации.ТипОперации = ТипыОпераций.РасформированиеАТК Тогда
		
		Операция_ЗаполнитьТЧ_РасформированиеАТК(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ОписаниеОперации.ТипОперации = ТипыОпераций.РегистрацияНаборов Тогда
		
		Операция_ЗаполнитьТЧ_РегистрацияНаборов(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ОписаниеОперации.ТипОперации = ТипыОпераций.КорректировкаСведенийОКодах Тогда
		
		Операция_ЗаполнитьТЧ_КорректировкаСведенийОКодах(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.РасформированиеНаборов Тогда
		
		Операция_ЗаполнитьТЧ_РасформированиеНаборов(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.УведомлениеОСостоянииКодов Тогда
		
		Операция_ЗаполнитьТЧ_УведомлениеОСостоянииКодов(ОписаниеОперации, ТаблицаКодов);
		
	Иначе
		// Операция без товаров и кодов
	КонецЕсли;
	
	Операция_ЗаполнитьТЧ_ЗаполнитьКлючиСтрок(ОписаниеОперации);
	Операция_ЗаполнитьТЧ_ЗаполнитьНомераСтрок(ОписаниеОперации);
	Операция_ЗаполнитьТЧ_ЗаполнитьАналитикуНоменклатуры(ОписаниеОперации);
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_УведомлениеОСостоянииКодов(ОписаниеОперации, ТаблицаКодов)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	Если Не ЗначениеЗаполнено(ДокументУчета)
		И Не ЗначениеЗаполнено(ОперацияОснование)
		И Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ТипОперации = ОписаниеОперации.ТипОперации;
	Организация = ОписаниеОперации.Организация;
	ПодходящиеСтатусыКодов = Операция_УведомлениеОСостоянииКодов_ПодходящиеСтатусыКодов();
	ДопустимоеКоличествоКодовВСтроке = Операция_ДопустимоеКоличествоКодов(ТипОперации);
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(ОперацияОснование) Тогда
		КодыОпераций_ВТ_Прочитать(ОперацияОснование, МенеджерВТ);
	Иначе
		Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
			ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
			ТаблицаКодов = Новый_ТаблицаКодов();
		Иначе
			КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ);
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	ТаблицаКодов_ВТ_УдалитьКодыДругихСтатусов(МенеджерВТ, ПодходящиеСтатусыКодов);
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		ВидПродукции = ТаблицаКодов_ВТ_ПервыйВидПродукции(МенеджерВТ);
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.Товар КАК Товар,
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	Т.ВидПродукции = &ВидПродукции");
	Запрос.УстановитьПараметр("ВидПродукции", ВидПродукции);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Выборка = Запрос.Выполнить().Выбрать();
	МенеджерВТ.Закрыть();
	
	Пока Выборка.Следующий() Цикл
		
		СтрТовара = Неопределено;
		Для каждого Стр Из ОписаниеОперации.Товары Цикл
			Если Стр.Товар = Выборка.Товар
				И Стр.КлючНоменклатуры1С = Выборка.КлючНоменклатуры1С
				И Стр.КлючСтрокиДокумента = Выборка.КлючСтрокиДокумента
				И Стр.КоличествоУпаковок < ДопустимоеКоличествоКодовВСтроке Тогда
				СтрТовара = Стр;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрТовара = Неопределено Тогда
			СтрТовара = ОписаниеОперации.Товары.Добавить();
			СтрТовара.КлючСтрокиОперации = Новый УникальныйИдентификатор;
			СтрТовара.КлючСтрокиДокумента = Выборка.КлючСтрокиДокумента;
			СтрТовара.КлючНоменклатуры1С = Выборка.КлючНоменклатуры1С;
			СтрТовара.Товар = Выборка.Товар;
		КонецЕсли;
		
		СтрТовара.КоличествоУпаковок = СтрТовара.КоличествоУпаковок + 1;
		
		СтрКода = ТаблицаКодов.Добавить();
		СтрКода.КлючКода = Выборка.КлючКода;
		СтрКода.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
		СтрКода.КлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ВыводИзОборота(ОписаниеОперации, ТаблицаКодов)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	Организация = ОписаниеОперации.Организация;
	ПричинаВыводаИзОборота = ОписаниеОперации.ДопРеквизиты.ПричинаВыводаИзОборота;
	ЕстьИННПолучателя = ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.ИННПолучателя);
	ЗаполнитьЦену = ПричинаВыводаИзОборотаТребуетУказатьЦену(ПричинаВыводаИзОборота, ЕстьИННПолучателя);
	ПодходящиеСтатусы = Операция_ВыводИзОборота_ПодходящиеСтатусыКодов();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
		ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
		ТаблицаКодов = Новый_ТаблицаКодов();
	Иначе
		КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ);
	КонецЕсли;
	ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОперации, Операция, ДокументУчета);
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		ВидПродукции = ТаблицаКодов_ВТ_ПервыйВидПродукции(МенеджерВТ);
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТаблицаКодов.КлючКода КАК КлючКода,
	|	ТаблицаКодов.Товар КАК Товар,
	|	ТаблицаКодов.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	ЕСТЬNULL(ТоварыДокумента.Цена, 0) КАК Цена,
	|	ЕСТЬNULL(ТоварыДокумента.КлючСтрокиДокумента, &ПустойКлюч) КАК КлючСтрокиДокумента
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО ТаблицаКодов.КлючКода = КодыДокументов.КлючКода
	|			И (КодыДокументов.ДокументУчета = &ДокументУчета)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ПО (КодыДокументов.КлючСтрокиДокумента = ТоварыДокумента.КлючСтрокиДокумента)
	|			И (ТоварыДокумента.Ссылка = &ДокументУчета)
	|ГДЕ
	|	ТаблицаКодов.ВидПродукции = &ВидПродукции
	|	И ТаблицаКодов.Статус В(&ПодходящиеСтатусы)");
	Запрос.УстановитьПараметр("ВидПродукции", ВидПродукции);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("ПодходящиеСтатусы", ПодходящиеСтатусы);
	Запрос.УстановитьПараметр("ПустойКлюч", ПустойУникальныйИдентификатор());
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	МенеджерВТ.Закрыть();
	
	ПоляТоваров = "Товар, КлючНоменклатуры1С, КлючСтрокиДокумента";
	Если ЗаполнитьЦену Тогда
		ПоляТоваров = ПоляТоваров + ", Цена";
	КонецЕсли;
	Операция_ЗаполнитьТаблицуТоваров(ОписаниеОперации.Товары, ТаблицаЗапроса, ПоляТоваров);
	
	Отбор = Новый Структура(ПоляТоваров);
	ОписаниеОперации.Товары.Индексы.Добавить(ПоляТоваров);
	Для каждого СтрЗапроса Из ТаблицаЗапроса Цикл
		ЗаполнитьЗначенияСвойств(Отбор, СтрЗапроса);
		СтрТовара = ОписаниеОперации.Товары.НайтиСтроки(Отбор)[0];
		СтрКода = ТаблицаКодов.Добавить();
		СтрКода.КлючКода = СтрЗапроса.КлючКода;
		СтрКода.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ОперацииПоОСУ(ОписаниеОперации)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ВидПродукции) Тогда
		ВидыПродукции = ЗначениеВМассиве(ОписаниеОперации.ВидПродукции);
	ИначеЕсли ТипОперации = ТипыОпераций.ВыводИзОборота Тогда
		ВидыПродукции = ДопустимыеВидыПродукцииДляВыводаИзОборотаОСУ();
	ИначеЕсли ТипОперации = ТипыОпераций.СообщениеОбОтгрузке Тогда
		ВидыПродукции = ДопустимыеВидыПродукцииДляСообщенияОбОтгрузкеПоОСУ();
	Иначе
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТоварыОпераций.Товар КАК Товар,
	|	ТоварыОпераций.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	СУММА(ТоварыОпераций.КоличествоУпаковок) КАК КоличествоУпаковок
	|ПОМЕСТИТЬ ТоварыДругихОпераций
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Операции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции.Товары КАК ТоварыОпераций
	|		ПО Операции.Ссылка = ТоварыОпераций.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ОбъемноСортовойУчет
	|		ПО Операции.Ссылка = ОбъемноСортовойУчет.Объект
	|			И (ОбъемноСортовойУчет.ИмяРеквизита = &ОбъемноСортовойУчет)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК ОсновнойСтатус
	|		ПО Операции.Ссылка = ОсновнойСтатус.Операция
	|			И (ОсновнойСтатус.ТипСтатуса = &ОсновнойСтатус)
	|ГДЕ
	|	Операции.Ссылка <> &ТекущаяОперация
	|	И Операции.ТипОперации = &ТипОперации
	|	И Операции.ДокументУчета = &ДокументУчета
	|	И ОсновнойСтатус.Статус <> &ОперацияОтменена
	|	И ОбъемноСортовойУчет.Значение = ИСТИНА
	|	И ТоварыОпераций.Товар.ВидПродукции В(&ВидыПродукцииПоОСУ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыОпераций.Товар,
	|	ТоварыОпераций.КлючНоменклатуры1С
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Товар,
	|	КлючНоменклатуры1С
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыМаркировки.Товар КАК Товар,
	|	ТоварыМаркировки.НомерПартии Как НомерПартии,
	|	ТоварыДокумента.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	ТоварыДокумента.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	СУММА(ТоварыМаркировки.КоличествоУпаковок) - МАКСИМУМ(ЕСТЬNULL(ТоварыДругихОпераций.КоличествоУпаковок, 0)) КАК КоличествоУпаковок
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыМаркировки КАК ТоварыМаркировки
	|		ПО ТоварыДокумента.КлючСтрокиДокумента = ТоварыМаркировки.КлючСтрокиДокумента
	|			И (ТоварыМаркировки.Ссылка = &ДокументУчета)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТоварыДругихОпераций КАК ТоварыДругихОпераций
	|		ПО ТоварыДокумента.КлючНоменклатуры1С = ТоварыДругихОпераций.КлючНоменклатуры1С
	|			И (ТоварыМаркировки.Товар = ТоварыДругихОпераций.Товар)
	|ГДЕ
	|	ТоварыДокумента.Ссылка = &ДокументУчета
	|	И ТоварыДокумента.НеПодлежитМаркировке = ЛОЖЬ
	|	И ТоварыМаркировки.Товар.ВидПродукции В(&ВидыПродукцииПоОСУ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыМаркировки.Товар,
	|	ТоварыДокумента.КлючНоменклатуры1С,
	|	ТоварыДокумента.КлючСтрокиДокумента,
	|	ТоварыМаркировки.НомерПартии
	|
	|ИМЕЮЩИЕ
	|	СУММА(ТоварыМаркировки.КоличествоУпаковок) - МАКСИМУМ(ЕСТЬNULL(ТоварыДругихОпераций.КоличествоУпаковок, 0)) > 0");
	Запрос.УстановитьПараметр("ТипОперации", ТипОперации);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("ТекущаяОперация", Операция);
	Запрос.УстановитьПараметр("ОсновнойСтатус", "ОсновнойСтатус");
	Запрос.УстановитьПараметр("ОбъемноСортовойУчет", "ОбъемноСортовойУчет");
	Запрос.УстановитьПараметр("ОперацияОтменена", Перечисление_СтатусыОпераций().ОперацияОтменена);
	Запрос.УстановитьПараметр("ВидыПродукцииПоОСУ", ВидыПродукции);
	
	ОписаниеОперации.Товары.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрТовара = ОписаниеОперации.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрТовара, Выборка);
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ПоДокументу(ОписаниеОперации)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеДокумента = ДокументУчета_ПрочитатьДокумент(ДокументУчета);
	
	ОписаниеОперации.Товары.Очистить();
	Для каждого СтрТов Из ОписаниеДокумента.ТоварыМаркировки Цикл
		
		Если СтрТов.КоличествоУпаковок = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрДок = ОписаниеДокумента.ТоварыДокумента.Найти(СтрТов.КлючСтрокиДокумента, "КлючСтрокиДокумента");
		Если СтрДок = Неопределено
			Или СтрДок.НеПодлежитМаркировке Тогда
			Продолжить;
		КонецЕсли;
		
		Стр = ОписаниеОперации.Товары.Добавить();
		Стр.Товар = СтрТов.Товар;
		Стр.КлючНоменклатуры1С = СтрДок.КлючНоменклатуры1С;
		Стр.КоличествоУпаковок = СтрТов.КоличествоУпаковок;
		Стр.КлючСтрокиДокумента = СтрТов.КлючСтрокиДокумента;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ПодборТоваровИКодовНаТСД(ОписаниеОперации)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеДокумента = ДокументУчета_ПрочитатьДокумент(ДокументУчета);
	ТоварыДокумента = ОписаниеДокумента.ТоварыДокумента;
	
	ОписаниеОперации.Товары.Очистить();
	Для Каждого СтрДок Из ТоварыДокумента Цикл
		
		Если СтрДок.КоличествоУпаковок = 0
			Или СтрДок.НеПодлежитМаркировке Тогда
			Продолжить;
		КонецЕсли;
		
		Стр = ОписаниеОперации.Товары.Добавить();
		Стр.КоличествоУпаковок = СтрДок.КоличествоУпаковок;
		Стр.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента;
		Стр.КлючНоменклатуры1С = СтрДок.КлючНоменклатуры1С;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ЗаказКодов(ОписаниеОперации)
	
	// BSLLS:CognitiveComplexity-off
	// BSLLS:CyclomaticComplexity-off
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	СпособыВыпуска = Перечисление_СпособыВыпускаТоваров();
	ФичаФлаги = Перечисление_ФичаФлаги();

	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ТипКодаМаркировки = ОписаниеОперации.ДопРеквизиты.ТипКодаМаркировки;
	СпособВыпускаТоваров = ОписаниеОперации.ДопРеквизиты.СпособВыпускаТоваров;
	
	ТребуемыеКоды = ДокументУчета_ТребуемыеКоды(ДокументУчета);
	ТребуемыеКоды.Свернуть("Товар, КлючНоменклатуры1С, НовыйКлючСтрокиДокумента", "КоличествоКодовТребуется");
	
	РазрешеныОстаткиЛегпромППРФ883 = ФичаФлагВключен(ФичаФлаги.ОстаткиЗаказКодовЛегпромППРФ883);
	РазрешеныОстаткиМедИзделияППРФ744 = ФичаФлагВключен(ФичаФлаги.ОстаткиМедИзделияППРФ744);
	РазрешеныОстаткиМедИзделияППРФ860 = ФичаФлагВключен(ФичаФлаги.ОстаткиМедИзделияППРФ860);
	РазрешеныОстаткиАнтисептики = ФичаФлагВключен(ФичаФлаги.ОстаткиЗаказКодовАнтисептики);
	РазрешеныОстаткиАвтоЖидкости = ФичаФлагВключен(ФичаФлаги.ОстаткиАвтоЖидкости);
	
	ОписаниеОперации.Товары.Очистить();
	Для каждого СтрТреб Из ТребуемыеКоды Цикл
		
		Товар = СтрТреб.Товар;
		
		Если ЗначениеЗаполнено(ВидПродукции) И ЗначениеЗаполнено(Товар) Тогда
			
			Если Товар.ВидПродукции <> ВидПродукции Тогда
				Продолжить;
			КонецЕсли;
			
			Если СпособВыпускаТоваров = СпособыВыпуска.Остатки Тогда
				// BSLLS:EmptyCodeBlock-off
				Если РазрешеныОстаткиЛегпромППРФ883 И ЭтоТоварЛегпромаППРФ883(Товар) Тогда
					// Можно заказывать
				ИначеЕсли РазрешеныОстаткиМедИзделияППРФ744 И ЭтоТоварМедИзделийППРФ744(Товар) Тогда
					// Можно заказывать
				ИначеЕсли РазрешеныОстаткиМедИзделияППРФ860 И ЭтоТоварМедИзделийППРФ860(Товар) Тогда
					// Можно заказывать
				ИначеЕсли РазрешеныОстаткиАнтисептики И ЭтоТоварАнтисептиков(Товар) Тогда
					// Можно заказывать
				ИначеЕсли РазрешеныОстаткиАвтоЖидкости И ЭтоТоварМаселИАвтомобильныхЖидкостей(Товар) Тогда
					// Можно заказывать
				Иначе
					Продолжить;
				КонецЕсли;
				// BSLLS:EmptyCodeBlock-on
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Товар)
			И ЗначениеЗаполнено(ТипКодаМаркировки)
			И Товар.ТипКодаМаркировки <> ТипКодаМаркировки Тогда
			Продолжить;
		КонецЕсли;
		
		СтрТовара = ОписаниеОперации.Товары.Добавить();
		СтрТовара.Товар = Товар;
		СтрТовара.КлючНоменклатуры1С = СтрТреб.КлючНоменклатуры1С;
		СтрТовара.КоличествоУпаковок = СтрТреб.КоличествоКодовТребуется;
		СтрТовара.КлючСтрокиДокумента = СтрТреб.НовыйКлючСтрокиДокумента;
		
		Если СпособВыпускаТоваров = СпособыВыпуска.Перемаркировка Тогда
			СтрТовара.КодТНВЭД = СтрТовара.Товар.КодТНВЭД;
		КонецЕсли;
		
	КонецЦикла;
	
	// BSLLS:CyclomaticComplexity-on
	// BSLLS:CognitiveComplexity-on
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ВводВОборот(ОписаниеОперации, ТаблицаКодов)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	Организация = ОписаниеОперации.Организация;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	СпособВводаВОборот = ОписаниеОперации.ДопРеквизиты.СпособВводаВОборот;
	ПодходящиеСтатусы = Операция_ВводВОборот_ПодходящиеСтатусыКодов();
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	
	Настройки = НастройкиМодуля();
	Если Не ЗначениеЗаполнено(СпособВводаВОборот) Тогда
		СпособВводаВОборот = Настройки.СпособВводаВОборотПоУмолчанию;
	КонецЕсли;
	
	СпособыВвода = Перечисление_СпособыВводаВОборот();
	ВидыПродукции = Перечисление_ВидыПродукции();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(ОперацияОснование) Тогда
		КодыОпераций_ВТ_Прочитать(ОперацияОснование, МенеджерВТ);
	Иначе
		Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
			ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
			ТаблицаКодов = Новый_ТаблицаКодов();
		Иначе
			КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ);
		КонецЕсли;
	КонецЕсли;
	
	Если Настройки.ВводитьВОборотВложенныеКодыАгрегатов Тогда
		ТаблицаКодов_ВТ_ЗаменитьТранспортныеУпаковкиНаВложенныеКоды(МенеджерВТ);
	КонецЕсли;
	ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОперации, Операция, ДокументУчета);
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	ТаблицаКодов_ВТ_ДобавитьКоличествоВложенныхКодов(МенеджерВТ);
	
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		ВидПродукции = ТаблицаКодов_ВТ_ВводВОборот_ПервыйВидПродукции(МенеджерВТ, ПодходящиеСтатусы);
	КонецЕсли;
	
	ПодходящиеТовары = Операция_ЗаполнитьТЧ_ВводВОборот_ПодходящиеТовары(МенеджерВТ, ВидПродукции, СпособВводаВОборот, ПодходящиеСтатусы);
	ТипУпаковки = ТаблицаКодов_ВТ_ПервыйТипУпаковки(МенеджерВТ, ПодходящиеТовары, ПодходящиеСтатусы);
	ОбщиеТипыУпаковок = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаКодов.КлючКода КАК КлючКода,
	|	ТаблицаКодов.Товар КАК Товар,
	|	ТаблицаКодов.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	ТаблицаКодов.ИдентификаторВСД КАК ИдентификаторВСД,
	|	ТаблицаКодов.ДатаПроизводства КАК ДатаПроизводства,
	|	ТаблицаКодов.ОбщийТипУпаковки КАК ОбщийТипУпаковки,
	|	ТаблицаКодов.КоличествоВложенныхКодов КАК КоличествоВложенныхКодов,
	|	ТаблицаКодов.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|ГДЕ
	|	ТаблицаКодов.ТипУпаковки = &ТипУпаковки
	|	И ТаблицаКодов.ВидПродукции = &ВидПродукции
	|	И ТаблицаКодов.Статус В(&ПодходящиеСтатусы)
	|	И &УсловиеТовары
	|	И &УсловиеАТК";
	
	Если ЗначениеЗаполнено(ПодходящиеТовары) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеТовары", "ТаблицаКодов.Товар В (&ПодходящиеТовары)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеТовары", "ИСТИНА");
	КонецЕсли;
	
	Если СпособВводаВОборот = СпособыВвода.ИмпортФТС Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеАТК", "ИСТИНА");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеАТК", "ТаблицаКодов.ОбщийТипУпаковки <> &АТК");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ТипУпаковки", ТипУпаковки);
	Запрос.УстановитьПараметр("ВидПродукции", ВидПродукции);
	Запрос.УстановитьПараметр("ПодходящиеТовары", ПодходящиеТовары);
	Запрос.УстановитьПараметр("ПодходящиеСтатусы", ПодходящиеСтатусы);
	Запрос.УстановитьПараметр("АТК", ОбщиеТипыУпаковок.АТК);
	
	Выборка = Запрос.Выполнить().Выбрать();
	МенеджерВТ.Закрыть();
	
	ОписаниеОперации.Товары.Очистить();
	ОписаниеОперации.Товары.Колонки.Добавить("КоличествоВложенныхКодов", ОписаниеТипа_Число());
	
	ОтборТовары = Новый Структура("Товар, КлючНоменклатуры1С, ИдентификаторВСД, ДатаПроизводства, КлючСтрокиДокумента");
	ДопустимоеКоличествоКодовВСтроке = Операция_ДопустимоеКоличествоКодов(ТипОперации);
	
	Пока Выборка.Следующий() Цикл
		
		СтрТов = Неопределено;
		ЗаполнитьЗначенияСвойств(ОтборТовары, Выборка);
		Для Каждого Стр Из ОписаниеОперации.Товары.НайтиСтроки(ОтборТовары) Цикл
			КоличествоКодовВВыборке = 1;
			КоличествоКодовВСтроке = Стр.КоличествоУпаковок;
			Если Выборка.ОбщийТипУпаковки = ОбщиеТипыУпаковок.Набор Тогда
				КоличествоКодовВВыборке = КоличествоКодовВВыборке + Выборка.КоличествоВложенныхКодов;
				КоличествоКодовВСтроке = КоличествоКодовВСтроке + Стр.КоличествоВложенныхКодов;
			КонецЕсли;
			Если (КоличествоКодовВСтроке + КоличествоКодовВВыборке) <= ДопустимоеКоличествоКодовВСтроке Тогда
				СтрТов = Стр;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрТов = Неопределено Тогда
			СтрТов = ОписаниеОперации.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрТов, ОтборТовары);
			СтрТов.КлючСтрокиОперации = Новый УникальныйИдентификатор;
		КонецЕсли;
		
		СтрТов.КоличествоУпаковок = СтрТов.КоличествоУпаковок + 1;
		СтрТов.КоличествоВложенныхКодов = СтрТов.КоличествоВложенныхКодов + Выборка.КоличествоВложенныхКодов;
		
		СтрКода = ТаблицаКодов.Добавить();
		СтрКода.КлючКода = Выборка.КлючКода;
		СтрКода.КлючСтрокиОперации = СтрТов.КлючСтрокиОперации;
		СтрКода.КлючСтрокиДокумента = СтрТов.КлючСтрокиДокумента;
		
	КонецЦикла;
	
	ОписаниеОперации.Товары.Колонки.Удалить("КоличествоВложенныхКодов");
	
КонецПроцедуры

Функция Операция_ЗаполнитьТЧ_ВводВОборот_ПодходящиеТовары(МенеджерВТ, ВидПродукции, СпособВводаВОборот, ПодходящиеСтатусы)
	
	Результат = Новый Массив;
	
	Операция_ВводВОборот_ДобавитьПодходящиеТовары_Легпром(Результат, МенеджерВТ, ВидПродукции, СпособВводаВОборот, ПодходящиеСтатусы);
	Операция_ВводВОборот_ДобавитьПодходящиеТовары_Бакалея(Результат, МенеджерВТ, ВидПродукции, СпособВводаВОборот, ПодходящиеСтатусы);
	Операция_ВводВОборот_ДобавитьПодходящиеТовары_Косметика(Результат, МенеджерВТ, ВидПродукции, СпособВводаВОборот, ПодходящиеСтатусы);
	Операция_ВводВОборот_ДобавитьПодходящиеТовары_МедИзделия(Результат, МенеджерВТ, ВидПродукции, СпособВводаВОборот, ПодходящиеСтатусы);
	
	Возврат Результат;
	
КонецФункции

Процедура Операция_ВводВОборот_ДобавитьПодходящиеТовары_Легпром(ПодходящиеТовары, МенеджерВТ, ВидПродукции, СпособВводаВОборот, ПодходящиеСтатусы)
	
	Если ВидПродукции <> Перечисление_ВидыПродукции().Легпром Тогда
		Возврат;
	КонецЕсли;
	
	СпособыВвода = Перечисление_СпособыВводаВОборот();
	ФичаФлаги = Перечисление_ФичаФлаги();
	
	Если СпособВводаВОборот = СпособыВвода.Остатки Тогда
		Если ФичаФлагВключен(ФичаФлаги.ОстаткиВводВОборотЛегпромППРФ883) Тогда
			ДополнитьМассив(ПодходящиеТовары, ТаблицаКодов_ВТ_ТоварыЛегпромППРФ883(МенеджерВТ, ПодходящиеСтатусы));
		КонецЕсли;
	КонецЕсли;
	
	Если СпособВводаВОборот = СпособыВвода.Импорт Тогда
		Если ФичаФлагВключен(ФичаФлаги.ИмпортЛегпромППРФ883) Тогда
			ДополнитьМассив(ПодходящиеТовары, ТаблицаКодов_ВТ_ТоварыЛегпромППРФ883(МенеджерВТ, ПодходящиеСтатусы));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ВводВОборот_ДобавитьПодходящиеТовары_МедИзделия(ПодходящиеТовары, МенеджерВТ, ВидПродукции, СпособВводаВОборот, ПодходящиеСтатусы)
	
