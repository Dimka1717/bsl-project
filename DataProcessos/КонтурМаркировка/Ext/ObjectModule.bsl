Процедура Операция_ПроверитьДокументСертификации(ОписаниеОперации, ОшибкиЗаполнения)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ВидыСведений = Перечисление_ВидыКорректируемыхСведений();
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	
	Товары = ОписаниеОперации.Товары;
	ТипОперации = ОписаниеОперации.ТипОперации;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	СпособВводаВОборот = ДопРеквизиты.СпособВводаВОборот;
	ПричинаВозвратаВОборот = ДопРеквизиты.ПричинаВозвратаВОборот;
	ВидКорректируемыхСведений = ДопРеквизиты.ВидКорректируемыхСведений;
	
	ЕстьАгрегаты = КодыОпераций_ЕстьАгрегаты(ОписаниеОперации.Ссылка);
	СпособВводаТребуетРД = СпособВводаВОборотТребуетДокументСертификации(СпособВводаВОборот, ВидПродукции);
	ВидПродукцииТребуетРД = ВидПродукцииТребуетДокументСертификации(ВидПродукции);
	
	Для Каждого Стр Из Товары Цикл
		
		Товар = Стр.Товар;
		ВидСертификата = Стр.ВидДокументаСертификации;
		ДатаСертификата = Стр.ДатаДокументаСертификации;
		НомерСертификата = Стр.НомерДокументаСертификации;
		
		Если ТипОперации = ТипыОпераций.ВводВОборот Тогда
			
			ТребуетсяЗаполнитьРД = ВидПродукцииТребуетРД
			И СпособВводаТребуетРД
			И Не Товар_ОтсутствуютТребованияРД(Товар)
			И Товар.ТипКодаМаркировки <> ТипыКодовМаркировки.ГрупповаяУпаковка;
			
		ИначеЕсли ТипОперации = ТипыОпераций.КорректировкаСведенийОКодах Тогда
			
			ТребуетсяЗаполнитьРД = (ВидКорректируемыхСведений = ВидыСведений.РазрешительныйДокумент);
			
		Иначе
			
			ТребуетсяЗаполнитьРД = Ложь;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ВидСертификата) Тогда
			
			Если ТребуетсяЗаполнитьРД Тогда
				Ошибка = Новый_ОшибкаЗаполнения();
				Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить вид разрешительного документа'");
				Ошибка.ИмяПоля = "ВидДокументаСертификации";
				Ошибка.ИмяТаблицы = "Товары";
				Ошибка.НомерСтроки = Стр.НомерСтроки;
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
		Если Не ВидПродукцииДопускаетВидДокументаСертификации(ВидСертификата, ВидПродукции) Тогда
			Ошибка = Новый_ОшибкаЗаполнения();
			Ошибка.ТекстОшибки = НСтр("ru = 'Указан некорректный вид разрешительного документа'");
			Ошибка.ИмяПоля = "ВидДокументаСертификации";
			Ошибка.ИмяТаблицы = "Товары";
			Ошибка.НомерСтроки = Стр.НомерСтроки;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НомерСертификата) Тогда
			
			Ошибка = Новый_ОшибкаЗаполнения();
			Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить номер разрешительного документа'");
			Ошибка.ИмяПоля = "НомерДокументаСертификации";
			Ошибка.ИмяТаблицы = "Товары";
			Ошибка.НомерСтроки = Стр.НомерСтроки;
			ОшибкиЗаполнения.Добавить(Ошибка);
			
		Иначе
			
			Если Не НомерДокументаСертификацииСоответствуетФормату(НомерСертификата, ВидСертификата) Тогда
				Ошибка = Новый_ОшибкаЗаполнения();
				Ошибка.ТекстОшибки = НСтр("ru = 'Некорректный номер разрешительного документа'");
				Ошибка.ИмяПоля = "НомерДокументаСертификации";
				Ошибка.ИмяТаблицы = "Товары";
				Ошибка.НомерСтроки = Стр.НомерСтроки;
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДатаСертификата) Тогда
			Ошибка = Новый_ОшибкаЗаполнения();
			Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить дату разрешительного документа'");
			Ошибка.ИмяПоля = "ДатаДокументаСертификации";
			Ошибка.ИмяТаблицы = "Товары";
			Ошибка.НомерСтроки = Стр.НомерСтроки;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

