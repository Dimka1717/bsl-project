	МодульЯдро().Операция_РаспознатьКоды(Операция, ТаблицаКодов);
	
КонецПроцедуры

Процедура Операция_ВернутьКодыНаТСД(Операция, Комментарий) Экспорт
	
	МодульЯдро().Операция_ВернутьКодыНаТСД(Операция, Комментарий);
	
КонецПроцедуры

Процедура Операция_НазначитьНаДругоеУстройство(Операция) Экспорт
	
	МодульЯдро().Операция_НазначитьНаДругоеУстройство(Операция);
	
КонецПроцедуры

Процедура Операция_ЗаполнитьГрупповыеУпаковки(Операция, ДокументУчета) Экспорт
	
	ГрупповаяУпаковка = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ГрупповаяУпаковка;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыОпераций_Заблокировать(Операция);
		
		ТаблицаКодов = КодыОпераций_Прочитать(Операция);
		ТаблицаКодов_ПрочитатьИнформациюОКодах(ТаблицаКодов);
		
		Отбор = Новый Структура("КлючАгрегата, Товар, КлючСтрокиОперации");
		Отбор.КлючАгрегата = ПустойУникальныйИдентификатор();
		
		Индекс = ТаблицаКодов.Индексы.Добавить("КлючАгрегата, Товар, КлючСтрокиОперации");
		КэшТоваров = Новый Соответствие;
		
		Для каждого СтрАгрегата Из ТаблицаКодов Цикл
			Если СтрАгрегата.ОбщийТипУпаковки = ГрупповаяУпаковка Тогда
				
				ОписаниеТовара = Товар_Прочитать(СтрАгрегата.Товар, КэшТоваров);
				Отбор.Товар = ОписаниеТовара.ВложенныйТовар;
				Отбор.КлючСтрокиОперации = СтрАгрегата.КлючСтрокиОперации;
				
				ВложенныеСтроки = ТаблицаКодов.НайтиСтроки(Отбор);
				Для Сч = 1 По Мин(ВложенныеСтроки.Количество(), ОписаниеТовара.КоличествоВложений) Цикл
					Стр = ВложенныеСтроки[Сч - 1];
					Стр.КлючАгрегата = СтрАгрегата.КлючКода;
					Стр.УдалитьИзДокумента = Истина;
				КонецЦикла;
				
			КонецЕсли;
		КонецЦикла;
		ТаблицаКодов.Индексы.Удалить(Индекс);
		
		ТаблицаКодов_ПометитьНаУдалениеИзОперацииДругиеТипыУпаковок(ТаблицаКодов, ГрупповаяУпаковка);
		
		ТаблицаКодов_ЗаписатьИнформациюОКодах(ТаблицаКодов);
		КодыОпераций_Записать(ТаблицаКодов, Операция);
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, Ложь);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура Операция_СоздатьИЗаполнитьТранспортныеУпаковки(ДеревоУпаковок, Операция) Экспорт
	
	ТранспортнаяУпаковка = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка;
	ДокументУчета = ЗначениеРеквизитаОбъекта_Марк(Операция, "ДокументУчета");
	
	ТаблицаКодов = КодыОпераций_ТаблицаКодов(Операция);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	Индекс = ТаблицаКодов.Индексы.Добавить("КлючАгрегата, Товар, КлючНоменклатуры1С");
	ТаблицаКодов_ДобавитьКлючиТранспортныхУпаковокПоДеревуАгрегатов(ТаблицаКодов, ДеревоУпаковок.Строки);
	ТаблицаКодов.Индексы.Удалить(Индекс);
	
	ТаблицаКодов_ПометитьНаУдалениеИзОперацииДругиеТипыУпаковок(ТаблицаКодов, ТранспортнаяУпаковка);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		ТаблицаКодов_ЗаполнитьКодыНовыхТранспортныхУпаковок(ТаблицаКодов);
		ТаблицаКодов_УточнитьДанныеАгрегатов(ТаблицаКодов);
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
		КодыОпераций_Записать(ТаблицаКодов, Операция);
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			ТаблицаКодов_ПометитьНаУдалениеИзДокументаКодыВАгрегатах(ТаблицаКодов);
			КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, Ложь);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция Операция_ТребуемыеКоды(ОписаниеОперации)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	
	Результат = Новый_ТребуемыеКоды();
	Для каждого СтрТовара Из ОписаниеОперации.Товары Цикл
		
		СтрТреб = Результат.Добавить();
		СтрТреб.Товар = СтрТовара.Товар;
		СтрТреб.КлючНоменклатуры1С = СтрТовара.КлючНоменклатуры1С;
		СтрТреб.КлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
		СтрТреб.НовыйКлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
		СтрТреб.НовыйКлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
		СтрТреб.КоличествоКодовТребуется = СтрТовара.КоличествоУпаковок;
		
		Если ТипОперации = ТипыОпераций.АгрегацияКодов Тогда
			СтрТреб.ОбщийТипУпаковки = ОбщийТипУпаковкиПоТипуКодаМаркировки(СтрТовара.Товар.ТипКодаМаркировки);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрТовара.ВложенныйТовар) Тогда
			СтрТреб = Результат.Добавить();
			СтрТреб.Товар = СтрТовара.ВложенныйТовар;
			СтрТреб.КлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
			СтрТреб.НовыйКлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
			СтрТреб.НовыйКлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
			СтрТреб.КоличествоКодовТребуется = СтрТовара.КоличествоУпаковокВложенногоТовара;
		КонецЕсли;
		
	КонецЦикла;
	
	ПоляТоваров = "Товар, КлючНоменклатуры1С, КлючСтрокиОперации, КлючСтрокиДокумента";
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	ТаблицаКодов.Колонки.Добавить("КоличествоКодов", ОписаниеТипа_Число());
	ТаблицаКодов.ЗаполнитьЗначения(1, "КоличествоКодов");
	ТаблицаКодов.Свернуть(ПоляТоваров, "КоличествоКодов");
	
	Отбор = Новый Структура(ПоляТоваров);
	Для Сч = -(Результат.Количество() - 1) По 0 Цикл
		СтрТреб = Результат[-Сч];
		ЗаполнитьЗначенияСвойств(Отбор, СтрТреб);
		Отбор.КлючСтрокиОперации = СтрТреб.НовыйКлючСтрокиОперации;
		СтрКодов = ТаблицаЗначений_НайтиСтроку(ТаблицаКодов, Отбор);
		Если СтрКодов <> Неопределено Тогда
			СтрТреб.КоличествоКодовПодобрано = Мин(СтрТреб.КоличествоКодовТребуется, СтрКодов.КоличествоКодов);
			СтрТреб.КоличествоКодовТребуется = СтрТреб.КоличествоКодовТребуется - СтрТреб.КоличествоКодовПодобрано;
			СтрКодов.КоличествоКодов = СтрКодов.КоличествоКодов - СтрТреб.КоличествоКодовПодобрано;
			Если СтрТреб.КоличествоКодовТребуется = 0 Тогда
				Результат.Удалить(-Сч);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ТипОперации = ТипыОпераций.ПечатьКодов Тогда
		Результат.ЗаполнитьЗначения(Истина, "ДляНанесения");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Операция_ДопустимоеКоличествоКодов(ТипОперации)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	// BSLLS:MagicNumber-off
	
	Варианты = Новый Соответствие;
	Варианты.Вставить(ТипыОпераций.ЗаказКодов					, 2000000);
	Варианты.Вставить(ТипыОпераций.ВводВОборот					, 40000);
	Варианты.Вставить(ТипыОпераций.ОтчетОНанесении				, 30000);
	Варианты.Вставить(ТипыОпераций.КорректировкаСведенийОКодах	, 30000);
	Варианты.Вставить(ТипыОпераций.Перемаркировка				, 30000);
	Варианты.Вставить(ТипыОпераций.НаполнениеКИГУ				, 30000);
	Варианты.Вставить(ТипыОпераций.РегистрацияКИГУ				, 30000);
	Варианты.Вставить(ТипыОпераций.РегистрацияНаборов			, 30000);
	Варианты.Вставить(ТипыОпераций.УведомлениеОСостоянииКодов	, 30000);
	Варианты.Вставить(ТипыОпераций.ФормированиеАТК				, 100000);
	
	// BSLLS:MagicNumber-on
	
	Возврат ЗначениеСоответствия(Варианты, ТипОперации, 0);
	
КонецФункции

Функция Операция_Существует(Операция)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Т
	|ГДЕ
	|	Т.Ссылка = &Операция");
	Запрос.УстановитьПараметр("Операция", Операция);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

