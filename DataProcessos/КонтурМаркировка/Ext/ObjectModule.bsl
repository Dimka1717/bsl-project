КонецФункции

Функция МенеджерИнтеграции_СемействоТекущейКонфигурации()
	
	ДанныеКонфигурации = ИмяИВерсияТекущейКонфигурации();
	СемействаКонфигураций = Перечисление_СемействаКонфигураций();
	
	Результат = Неопределено;
	Если ЭтоСемействоКонфигурацийERP(ДанныеКонфигурации) Тогда
		Результат = СемействаКонфигураций.ERP;
	ИначеЕсли Найти(ДанныеКонфигурации.Имя, "БухгалтерияПредприятия") > 0
		И СравнитьВерсии(ДанныеКонфигурации.НомерРедакции, "3") = 0 Тогда
		Результат = СемействаКонфигураций.БП30;
	ИначеЕсли Найти(ДанныеКонфигурации.Имя, "УправлениеНебольшойФирмой") > 0 Тогда
		Результат = СемействаКонфигураций.УНФ;
	Иначе
		Результат = СемействаКонфигураций.УПП; // Все неподходящие будем считать УПП, по аналогии с ДиаДок
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоСемействоКонфигурацийERP(ДанныеКонфигурации)
	
	Возврат (Найти(ДанныеКонфигурации.Имя, "УправлениеТорговлей") > 0
		И СравнитьВерсии(ДанныеКонфигурации.НомерРедакции, "11") = 0)
		Или Найти(ДанныеКонфигурации.Имя, "УправлениеПредприятием") > 0
		Или Найти(ДанныеКонфигурации.Имя, "КомплекснаяАвтоматизация") > 0;
	
КонецФункции

Процедура ЗаполнитьНастройкиДокументаУчетаДляТекущейКонфигурации() Экспорт
	
	СемействаКонфигураций = Перечисление_СемействаКонфигураций();
	СемействоКонфигураций = МенеджерИнтеграции_СемействоТекущейКонфигурации();
	ИменаДокументов = ДокументыТекущейКонфигурации1С(СемействоКонфигураций);
	ДокументыМеждуОрганизациями1С = ДокументыДвиженияТоваровМеждуОрганизациями1С();
	
	ИменаДокументовКорректировки = Новый Массив;
	ДополнитьМассив(ИменаДокументовКорректировки, Интеграция_ИменаДокументовВозврата1С());
	ДополнитьМассив(ИменаДокументовКорректировки, Интеграция_ИменаДокументовКорректировки1С());
	
	Для Каждого ИмяДокумента Из ИменаДокументов Цикл
		
		МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
		Если МетаданныеДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ВызыватьИсключение = Ложь;
		НастройкиДокумента = НастройкиДокументовУчета_НайтиПоТипуДокумента(ИмяДокумента, ВызыватьИсключение);
		Если ЗначениеЗаполнено(НастройкиДокумента) Тогда
			Продолжить;
		КонецЕсли;
		
		НастройкиДокумента = Новый_НастройкиДокументаУчета();
		
		НастройкиДокумента.ТипДокумента = ИмяДокумента;
		НастройкиДокумента.Наименование = МетаданныеДокумента.Синоним;
		
		НастройкиДокумента.ПолеОрганизация = "Организация";
		НастройкиДокумента.ПолеНоменклатура = "Номенклатура";
		НастройкиДокумента.ПолеЦена = "Цена";
		НастройкиДокумента.ПолеКомментарий = "Комментарий";
		
		Если ДокументыМеждуОрганизациями1С.Найти(ИмяДокумента) = Неопределено Тогда
			НастройкиДокумента.ПолеКонтрагент = "Контрагент";
		Иначе
			НастройкиДокумента.ПолеКонтрагент = "ОрганизацияПолучатель";
		КонецЕсли;
		
		Если СемействоКонфигураций = СемействаКонфигураций.УНФ Тогда
			ЗаполнитьНастройкиДокументаУчета_УНФ(НастройкиДокумента);
		ИначеЕсли СемействоКонфигураций = СемействаКонфигураций.ERP Тогда
			ЗаполнитьНастройкиДокументаУчета_ERP(НастройкиДокумента, ИмяДокумента);
		ИначеЕсли СемействоКонфигураций = СемействаКонфигураций.БП30 Тогда
			ЗаполнитьНастройкиДокументаУчетаДля_БП30(НастройкиДокумента);
		КонецЕсли;
		
		МассивРолей = Новый Массив;
		Если МассивСодержитЗначение(ИменаДокументовКорректировки, ИмяДокумента) Тогда
			МассивРолей.Добавить(Перечисление_РолиДокументовУчета().КорректировкаОтгрузки);
		Иначе
			МассивРолей.Добавить(Перечисление_РолиДокументовУчета().Отгрузка);
		КонецЕсли;
		
		НастройкиДокумента.РолиДокумента = МассивРолей;
		
		НастройкиДокументаУчета_Записать(НастройкиДокумента);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьНастройкиДокументаУчетаДля_БП30(НастройкиДокумента)
	
	НастройкиДокумента.ТабличнаяЧасть = "Товары";
	НастройкиДокумента.ПолеСумма = "СуммаДокумента";
	НастройкиДокумента.ПолеСклад = "Склад";
	НастройкиДокумента.ПолеКоличество = "Количество";
	
КонецПроцедуры

Процедура ЗаполнитьНастройкиДокументаУчета_ERP(НастройкиДокумента, ИмяДокумента)
	
	НастройкиДокумента.ТабличнаяЧасть = "Товары";
	Если Не ИмяДокумента = "АктОРасхожденияхПослеОтгрузки" Тогда
		НастройкиДокумента.ПолеСклад = "Склад";
		НастройкиДокумента.ПолеСумма = "СуммаДокумента";
	КонецЕсли;
	НастройкиДокумента.ПолеХарактеристика = "Характеристика";
	НастройкиДокумента.ПолеУпаковка = "Упаковка";
	НастройкиДокумента.ПолеСерия = "Серия";
	НастройкиДокумента.ПолеКоличество = "КоличествоУпаковок";
	
КонецПроцедуры

Процедура ЗаполнитьНастройкиДокументаУчета_УНФ(НастройкиДокумента)
	
	НастройкиДокумента.ТабличнаяЧасть = "Запасы";
	НастройкиДокумента.ПолеСумма = "СуммаДокумента";
