Функция КодыОпераций_ВТ_Прочитать(Операция, МенеджерВТ, КлючСтрокиОперации = Неопределено)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.КлючСтрокиОперации КАК КлючСтрокиОперации,
	|	Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыОпераций КАК Т
	|ГДЕ
	|	Т.Операция = &Операция
	|	И &КлючСтрокиОперации
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода";
	
	Если КлючСтрокиОперации = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиОперации", "ИСТИНА");
	Иначе
		ТекстУсловия = "Т.КлючСтрокиОперации = &КлючСтрокиОперации";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиОперации", ТекстУсловия);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Операция", Операция);
	Запрос.УстановитьПараметр("КлючСтрокиОперации", КлючСтрокиОперации);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат ЗначениеЗаполнено(Выборка.Количество);
	
КонецФункции

