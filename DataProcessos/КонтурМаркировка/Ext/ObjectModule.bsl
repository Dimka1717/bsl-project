			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрСвед, , "ПереданоКИ, Передан");
			НоваяСтрока.КоличествоКИ = ТребуетсяКИ;
			
			СтрСвед.ПереданоКИ = СтрСвед.ПереданоКИ + ТребуетсяКИ;
			СтрСвед.Передан = (СтрСвед.ПереданоКИ = СтрСвед.КоличествоКИ);
			
			СтрАгр.ПереданоКИ = СтрАгр.ПереданоКИ + ТребуетсяКИ;
			СтрАгр.ВсеКодыПереданы = (СтрАгр.ПереданоКИ = СтрАгр.КоличествоКИ);
			
