Процедура ПерейтиНаВерсию_3_5_ДобавитьПоляТоваровДляОбновления()
	
	ПараметрыОбновления = ПараметрыОбновленияСправочниковПриОбмене();
	ВидыПродукции = Перечисление_ВидыПродукции();
	
	ИменаПолей = СвойствоСтруктуры(ПараметрыОбновления, "ИменаПолейТоваровДляОбновления", Новый Массив);
	ИменаПолей.Добавить("ХарактеристикаСрокаИспользования");
	
	ВидыПродукцииДляОбновления = СвойствоСтруктуры(ПараметрыОбновления, "ВидыПродукцииТоваровДляОбновления", Новый Массив);
	ВидыПродукцииДляОбновления.Добавить(ВидыПродукции.МедицинскиеИзделия);
	ВидыПродукцииДляОбновления.Добавить(ВидыПродукции.Игрушки);
	
	ПараметрыОбновления.Вставить("ИменаПолейТоваровДляОбновления", ИменаПолей);
	ПараметрыОбновления.Вставить("ВидыПродукцииТоваровДляОбновления", ВидыПродукцииДляОбновления);
	
	ПараметрыОбновленияСправочниковПриОбмене_Записать(ПараметрыОбновления);
	
КонецПроцедуры

Процедура ПерейтиНаВерсию_3_5_КонвертироватьДанныеРедактораКодов()
	
	ТипФайла = "Коды редактора";
	ТипТаблица = Тип("ТаблицаЗначений");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Файл
	|ИЗ
	|	Справочник.КонтурМаркировка_Файлы КАК Т
	|ГДЕ
	|	Т.ТипФайла = &ТипФайла");
	Запрос.УстановитьПараметр("ТипФайла", ТипФайла);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОписаниеФайла = Файл_Прочитать(Выборка.Файл);
		Если ЗначениеЗаполнено(ОписаниеФайла)
			И ТипЗнч(ОписаниеФайла.ДанныеФайла) = ТипТаблица Тогда
			ДанныеРедактора = Новый_ДанныеРедактораКодов();
			ДанныеРедактора.ТаблицаКодов = ОписаниеФайла.ДанныеФайла;
			РедакторКодов_ЗаписатьФайл(ОписаниеФайла.ВладелецФайла, ДанныеРедактора);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

