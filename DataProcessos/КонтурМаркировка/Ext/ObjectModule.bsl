// Находит склад маркировки по складу из учетной системы,
// но только если он сопоставлен один к одному
//
// Параметры:
//  Склад1С - СправочникСсылка - склад 1С;
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация маркировки;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Склады - склад маркировки
//
Функция Склад_НайтиПоСкладу1С(Склад1С, Организация) Экспорт
	
	Если Не ЗначениеЗаполнено(Склад1С) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Склады КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|	И Т.Организация = &Организация
	|	И Т.КлючСклада1С = &КлючСклада1С
	|	И Т.ТипКлючаСклада1С = &ТипКлючаСклада1С");
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("КлючСклада1С", КлючОбъекта1С(Склад1С));
	Запрос.УстановитьПараметр("ТипКлючаСклада1С", ТипКлючаОбъекта1С(Склад1С));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		Результат = Выборка.Ссылка;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

