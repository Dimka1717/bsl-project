Функция КонтурПлагин_Прочитать(Плагин)
	
	Результат = Новый_ОписаниеПлагина();
	
	ЭлементДопСправочника = ДопСправочник_Прочитать(Плагин);
	ЗаполнитьЗначенияСвойств(Результат, ЭлементДопСправочника.ДопРеквизиты);
	Результат.Ссылка = Плагин;
	
	Возврат Результат;
	
КонецФункции

Процедура КонтурПлагин_Записать(ОписаниеПлагина)
	
	Если ЗначениеЗаполнено(ОписаниеПлагина.Ссылка) Тогда
		ЭлементДопСправочника = ДопСправочник_Прочитать(ОписаниеПлагина.Ссылка);
	Иначе
		ИмяСправочника = КонтурПлагины_ИмяСправочника();
		ЭлементДопСправочника = Новый_ЭлементДопСправочника(ИмяСправочника);
		ЭлементДопСправочника.Наименование = ОписаниеПлагина.Представление;
	КонецЕсли;
	
	ДопРеквизиты = ЭлементДопСправочника.ДопРеквизиты;
	ДопРеквизиты.Очистить();
	ДопРеквизиты.Вставить("Идентификатор", ОписаниеПлагина.Идентификатор);
	ДопРеквизиты.Вставить("Версия",        ОписаниеПлагина.Версия);
	ДопРеквизиты.Вставить("Включен",       ОписаниеПлагина.Включен);
	ДопРеквизиты.Вставить("Представление", ОписаниеПлагина.Представление);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ДопСправочник_Записать(ЭлементДопСправочника);
		
		Если ЗначениеЗаполнено(ОписаниеПлагина.ДвоичныеДанные) Тогда
			
			ОписаниеФайла = Новый_ОписаниеФайла();
			ОписаниеФайла.ДанныеФайла = ОписаниеПлагина.ДвоичныеДанные;
			ОписаниеФайла.ИмяФайла = ПараметрыВСтроку("%1.epf", ЭлементДопСправочника.Наименование);
			ОписаниеФайла.ТипФайла = Перечисление_ТипыФайлов().ФайлПлагина;
			ОписаниеФайла.ВладелецФайла = ЭлементДопСправочника.Ссылка;
			ОписаниеФайла.Идентификатор = ОписаниеПлагина.Идентификатор;
			
			Файл_Записать(ОписаниеФайла);
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Запись плагина'");
		ШаблонСтроки = НСтр("ru = 'Не удалось записать плагин с идентификатором: %1'");
		ТекстСообщения = ПараметрыВСтроку(ШаблонСтроки, ОписаниеПлагина.Идентификатор);
		
		ОбработатьОшибку(Действие, Ошибка,, ТекстСообщения);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

