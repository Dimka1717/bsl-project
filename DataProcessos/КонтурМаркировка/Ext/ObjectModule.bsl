// Устарела. Следует использовать Новый_ТаблицаКодов()
//
// Для совместимости с ВСО 1.1.17 и ПМ до версии 2.16 (включительно)
// Описание кода маркировки для добавления в документ
// 
// Возвращаемое значение:
//  Структура - содержит свойства:
//   * GTIN - Строка - (необязательный) код товара;
//   * СерийныйНомер - Строка - (необязательный) серийный номер товара;
//   * НормализованныйКодМаркировки - Строка - нормализованный код маркировки;
//   * КодМаркировки - Строка - код маркировки или агрегата;
//   * ТипУпаковки   - ПеречислениеСсылка.КонтурМаркировка_ТипыУпаковок - (необязательный) тип упаковки;
//   * ВидУпаковки   - ПеречислениеСсылка.КонтурМаркировка_ВидыУпаковок - (необязательный) вид упаковки;
//   * ТипШтрихкода  - ПеречислениеСсылка.КонтурМаркировка_ТипыШтрихкодов - (необязательный) тип штрихкода;
//   * ВидПродукции  - ПеречислениеСсылка.КонтурМаркировка_ВидыПродукции - вид продукции;
//   * КлючСтрокиТоваров - Строка - ключ строки товаров документа 1С;
//   * ВложенныеКоды - Массив - содержит структуры, см. Новый_ОписаниеНовогоКодаМаркировки();
//   * ДанныеСервиса - Структура - см. Новый_ДанныеИзСервисаДляНовогоКода();
//   * ОписаниеОшибки - Строка - описание ошибки при действиях с кодом;
//   * АналитикаНоменклатуры - Структура - содержит:
//      ** Номенклатура   - СправочникСсылка - номенклатура 1С;
//      ** Характеристика - СправочникСсылка - характеристика номенклатуры;
//      ** Упаковка       - СправочникСсылка - упаковка;
//      ** Серия          - СправочникСсылка - серия;
//   * ДопСведения - Структура - содержит:
//      ** ПолныйКод        - Строка - код маркировки с криптохвостом
//      ** ДатаСрокаГодности - Дата   - дата окончания срока годности;
//      ** ИдентификаторВСД - Строка - идентификатор ВСД;
//      ** Объем            - Число  - объем;
//
Функция Новый_ОписаниеНовогоКодаМаркировки(КодМаркировки = Неопределено, ВидПродукции = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("GTIN");
	Результат.Вставить("СерийныйНомер");
	Результат.Вставить("КодМаркировки", КодМаркировки);
	Результат.Вставить("НормализованныйКодМаркировки");
	Результат.Вставить("ТипУпаковки");
	Результат.Вставить("ОбщийТипУпаковки");
	Результат.Вставить("ВидУпаковки");
	Результат.Вставить("ТипШтрихкода");
	Результат.Вставить("ВидПродукции", ВидПродукции);
	Результат.Вставить("КлючНоменклатуры1С");
	Результат.Вставить("Товар");
	Результат.Вставить("КодРазобран", Ложь);
	Результат.Вставить("АналитикаНоменклатуры", Новый_АналитикаНоменклатуры1С());
	Результат.Вставить("ДопСведения", Новый_ДопСведенияКода_2_19());
	Результат.Вставить("ДанныеСервиса", Новый_ДанныеИзСервисаДляНовогоКода());
	Результат.Вставить("ВложенныеКоды", Новый Массив);
	Результат.Вставить("ОписаниеОшибки");
	Результат.Вставить("КлючСтрокиТоваров");
	Результат.Вставить("КлючСтроки");
	Результат.Вставить("ДляВнутреннегоУчета");
	
	Возврат Результат;
	
КонецФункции

