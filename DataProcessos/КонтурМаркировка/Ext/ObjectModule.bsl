// Получает список сервис-провайдеров организации из сервиса.
//
// Параметры:
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
//  ТоварнаяГруппа - Строка - товарная группа;
// 
// Возвращаемое значение:
//  Массив из Структура - список сервис-провайдеров организации:
//   * id - Строка - Идентификатор;
//   * providerName - Строка - Наименование;
//   * name - Строка - Наименование площадки;
//   * taxIdentificationNumber - Строка - Идентификатор экспортера;
//   * country - Строка - Страна;
//   * address - Строка - Адрес площадки;
//   * contactPerson - Строка - Контактное лицо;
//   * email - Строка - Электронный адрес;
//   * role - Строка - Роль;
//   * productGroups - Массив из Строка - Товарные группы
//
Функция Маркировка_СписокСервисПровайдеров(Организация, ТоварнаяГруппа)
	
	Результат = Мок_Маркировка_СписокСервисПровайдеров(Организация, ТоварнаяГруппа);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИдентификаторОрганизации = ЗначениеРеквизитаОбъекта_Марк(Организация, "Идентификатор");
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	Маркировка_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	Маркировка_ДобавитьТокен(Запрос, Организация);
	
	Запрос.ПутьНаСервере = "/api/v1/organizations/{organizationId}/service-providers";
	Запрос.Параметры.Вставить("organizationId", ИдентификаторОрганизации);
	Запрос.Параметры.Вставить("productGroup", ТоварнаяГруппа);
	
	ТоварнаяГруппаНедоступна = 424;
	Запрос.ДопустимыеКодыОтвета.Добавить(ТоварнаяГруппаНедоступна);
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	ОбработатьОшибкуHTTP(Ответ, Запрос);
	
	Результат = Неопределено;
	Если Ответ.КодОтвета <> ТоварнаяГруппаНедоступна Тогда
		Результат = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

