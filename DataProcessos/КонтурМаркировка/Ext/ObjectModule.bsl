// Получает таблицу кодов маркировки по документу 1С
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С;
//  ЗаменитьGS - Булево - Истина, если необходимо заменить разделитель GS1 на строку \u001d
// 
// Возвращаемое значение:
//  ТаблицаЗначений - см. Новый_ТаблицаКодов()
//
Функция ТаблицаКодовДокумента(Документ1С, ЗаменитьGS = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ1С) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен документ 1С'");
	КонецЕсли;
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С, Истина);
	ТаблицаКодов = КодыДокументов_Прочитать(ДокументУчета);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	ПолныеКоды_Прочитать(ТаблицаКодов);
	
	Если ЗаменитьGS Тогда
		ТаблицаКодов_ЗаменитьРазделителиGS1(ТаблицаКодов);
	КонецЕсли;
	
	Возврат ТаблицаКодов;
	
КонецФункции

// Проверяет наличие в модуле настройки документа
//
// Параметры:
//  Документ1С - ДокументСсылка - документ, который нужно проверить
// 
// Возвращаемое значение:
//  Булево - Истина, если настройка есть
//
Функция ДокументДопустимВМаркировке(Документ1С) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ1С) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан документ для определения допустимости в маркировке'");
	КонецЕсли;
	
	НастройкаДокумента = НастройкиДокументовУчета_НайтиПоТипуДокумента(Документ1С.Метаданные().Имя, Ложь);
	
	Возврат ЗначениеЗаполнено(НастройкаДокумента);
	
КонецФункции

// Определяет наличие маркируемого товара в документе
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С;
// 
// Возвращаемое значение:
//  Булево - Истина, если в документе есть хотябы один маркируемый товар;
//
Функция ДокументСодержитМаркируемыйТовар(Документ1С) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ1С) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан документ для определения наличия маркируемого товара'");
	КонецЕсли;
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С);
	
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		ОписаниеДокумента = ДокументУчета_ПрочитатьДокумент(ДокументУчета);
	Иначе
		ОписаниеДокумента = Новый_ДокументУчета();
		ДокументУчета_Заполнить(ОписаниеДокумента, Документ1С);
	КонецЕсли;
	
	Возврат (ОписаниеДокумента.ТоварыДокумента.Найти(Ложь, "НеПодлежитМаркировке") <> Неопределено);
	
КонецФункции

// Проверяет в документе статус кодов "Выпущен" и наличие полных кодов
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С
// 
// Возвращаемое значение:
//  Булево - Истина, если по документу можно сформировать отчет о нанесении
//
Функция МожноСформироватьОтчетОНанесенииПоДокументу(Документ1С) Экспорт
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С);
	Если ДокументУчета = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК Т
	|ГДЕ
	|	Т.ДокументУчета = &ДокументУчета");
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	ТаблицаКодов_ВТ_ЗаменитьТранспортныеУпаковкиНаВложенныеКоды(МенеджерВТ);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТабКодов.КлючКода КАК КлючКода
	|ИЗ
	|	ТаблицаКодов КАК ТабКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ТабКодов.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючей
	|		ПО ТабКодов.КлючКода = СвязиКлючей.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|		ПО (СвязиКлючей.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода)
	|ГДЕ
	|	КодыМаркировки.ФайлСПолнымКодом <> &ПустойФайл
	|	И СтатусыКодов.Статус = &Выпущен");
	Запрос.УстановитьПараметр("ПустойФайл", Справочники.КонтурМаркировка_Файлы.ПустаяСсылка());
	Запрос.УстановитьПараметр("Выпущен", Перечисление_СтатусыКодов().Выпущен);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// Находит или создает документ учета по документу 1С и заполняет его свободными кодами из заказов
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С
//
Процедура ПодобратьКодыИзСвободногоОстаткаВДокумент(Документ1С) Экспорт
	
	ДокументУчета = ДокументУчета_Создать(Документ1С, Истина);
	ДокументУчета_ПодобратьНовыеКодыИзЗаказов(ДокументУчета);
	
КонецПроцедуры

// Устанавливает дату печати кодов и основной статус операций печати по документу
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С
//
Процедура ОтметитьНапечатанныеКодыПоДокументу(Документ1С) Экспорт
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С, Истина);
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ТаблицаКодов = КодыДокументов_Прочитать(ДокументУчета);
		ТаблицаКодов_ПрочитатьИнформациюОКодах(ТаблицаКодов);
		
		ДатаПечати = ТекущаяДата();
		Для каждого Стр Из ТаблицаКодов Цикл
			Если Не ЗначениеЗаполнено(Стр.ДатаПечати) Тогда
				Стр.ДатаПечати = ДатаПечати;
			КонецЕсли;
		КонецЦикла;
		
		ТаблицаКодов_ЗаписатьИнформациюОКодах(ТаблицаКодов);
		
		Для Каждого Операция Из Операция_НайтиОперации(ТипыОпераций.ПечатьКодов, ДокументУчета) Цикл
			ОсновнойСтатус = Операция_ОсновнойСтатус(Операция);
			Если ОсновнойСтатус <> СтатусыОпераций.КодыНапечатаны Тогда
				ОсновнойСтатус = СтатусыОпераций.КодыНапечатаны;
				СтатусыОперации_ЗаписатьОсновнойСтатус(Операция, ОсновнойСтатус);
			КонецЕсли;
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Получает статусы кодов маркировки по документу 1С из сервиса Контур.Маркировка
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С
// 
// Возвращаемое значение:
//  Булево - Истина, если обновился статус хотя-бы у одного кода
//
Функция ОбновитьСтатусыКодовДокумента(Документ1С) Экспорт
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С);
	
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		ВызватьИсключение НСтр("ru = 'Не найден документ учета'");
	КонецЕсли;
	
	Результат = ДокументУчета_ОбновитьСтатусыКодов(ДокументУчета);
	
	Возврат Результат;
	
КонецФункции

// Завершает работу с документом.
// У связанного с документом 1С документа учета устанавливает следующие значения:
//  ДокументУчета.Статусы.ОсновнойСтатус = Завершен
//  ДокументУчета.Статусы.ТребуемоеДействие = РаботаЗавершена
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С
//
Процедура ЗавершитьРаботуСДокументом(Документ1С) Экспорт
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С, Истина);
	
	СтатусыДокумента = Новый_ДокументУчета_Статусы();
	СтатусыДокумента.ОсновнойСтатус = Перечисление_СтатусыДокументовУчета().Завершен;
	СтатусыДокумента.ТребуемоеДействие = Перечисление_ТребуемыеДействияДокументовУчета().РаботаЗавершена;
	
	СтатусыДокументаУчета_Записать(ДокументУчета, СтатусыДокумента);
	
КонецПроцедуры

// Проверяет наличие в документе учета завершенных операций вывода кодов из оборота
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С
// 
// Возвращаемое значение:
//  Булево - Истина, если операции с выводом из оборота в документе учета есть
//
Функция ДокументСодержитВыводаИзОборота(Документ1С) Экспорт
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С, Истина);
	
	ПодходящиеТипы = Новый Массив;
	ПодходящиеТипы.Добавить(ТипыОпераций.ВыводИзОборота);
	ПодходящиеТипы.Добавить(ТипыОпераций.СообщениеОбОтгрузке);
	
	СписокОпераций = ДокументУчета_СписокОпераций(ДокументУчета, ПодходящиеТипы, СтатусыОпераций.ОперацияЗавершена);
	
	Результат = ЗначениеЗаполнено(СписокОпераций);
	
	Возврат Результат;
	
КонецФункции

// Проверяет наличие организации маркировки, соответствующей организации документа
//
// Параметры:
//  Документ1С - ДокументСсылка - документ, который нужно проверить
// 
// Возвращаемое значение:
//  Булево - Истина, если организация есть
//
Функция ОрганизацияДокументаЗарегистрированаВМаркировке(Документ1С)
	
	РеквизитыДокумента1С = ДокументУчета_РеквизитыДокумента1С(Документ1С);
	Организация = Организация_НайтиПоОрганизации1С(РеквизитыДокумента1С.Организация);
	
	Возврат ЗначениеЗаполнено(Организация);
	
КонецФункции

// #КонецОбласти // ДокументУчета

