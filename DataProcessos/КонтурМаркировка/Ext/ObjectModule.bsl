КонецПроцедуры

Процедура ПерейтиНаВерсию_3_13_ОбновитьСвязиКлючейКодов()
	
	ЗапросНоваяПорция = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КодыМаркировки.ПорцияЗаписей КАК НоваяПорция
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО КодыМаркировки.КлючКода = СвязиКлючейКодов.КлючКода
	|			И КодыМаркировки.ПорцияЗаписей <> СвязиКлючейКодов.ПорцияЗаписей
	|ГДЕ
	|	НЕ КодыМаркировки.ПорцияЗаписей В (&ОбработанныеПорции)");
	
	ЗапросСтараяПорция = Новый Запрос(
	"ВЫБРАТЬ
	|	КодыМаркировки.КлючКода КАК КлючКода,
	|	СвязиКлючейКодов.ПорцияЗаписей КАК СтараяПорция
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО КодыМаркировки.КлючКода = СвязиКлючейКодов.КлючКода
	|			И (СвязиКлючейКодов.ПорцияЗаписей <> &НоваяПорция)
	|ГДЕ
	|	КодыМаркировки.ПорцияЗаписей = &НоваяПорция
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтараяПорция УБЫВ
	|ИТОГИ ПО
	|	СтараяПорция");
	
	ОбработанныеПорции = Новый Массив;
	
	Пока Истина Цикл
		
		ЗапросНоваяПорция.УстановитьПараметр("ОбработанныеПорции", ОбработанныеПорции);
		
		// BSLLS:CreateQueryInCycle-off
		ВыборкаНоваяПорция = ЗапросНоваяПорция.Выполнить().Выбрать();
		// BSLLS:CreateQueryInCycle-on
		
		Если Не ВыборкаНоваяПорция.Следующий() Тогда
			Прервать;
		КонецЕсли;
		
		НоваяПорция = ВыборкаНоваяПорция.НоваяПорция;
		
		НачатьТранзакцию(РежимУправленияБлокировкой());
		
		Попытка
			
			НовыйНабор = РегистрыСведений.КонтурМаркировка_СвязиКлючейКодов.СоздатьНаборЗаписей();
			НовыйНабор.Отбор.ПорцияЗаписей.Установить(НоваяПорция);
			НовыйНабор.Прочитать();
			ТаблицаНовогоНабора = НовыйНабор.Выгрузить();
			ТаблицаНовогоНабора.Индексы.Добавить("КлючКода");
			
			ЗапросСтараяПорция.УстановитьПараметр("НоваяПорция", НоваяПорция);
			
			// BSLLS:CreateQueryInCycle-off
			ВыборкаСтараяПорция = ЗапросСтараяПорция.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			// BSLLS:CreateQueryInCycle-on
			
			Пока ВыборкаСтараяПорция.Следующий() Цикл
				
				СтарыйНабор = РегистрыСведений.КонтурМаркировка_СвязиКлючейКодов.СоздатьНаборЗаписей();
				СтарыйНабор.Отбор.ПорцияЗаписей.Установить(ВыборкаСтараяПорция.СтараяПорция);
				СтарыйНабор.Прочитать();
				ТаблицаСтарогоНабора = СтарыйНабор.Выгрузить();
				ТаблицаСтарогоНабора.Индексы.Добавить("КлючКода");
				
				Выборка = ВыборкаСтараяПорция.Выбрать();
				Пока Выборка.Следующий() Цикл
					
					СтараяСтр = ТаблицаСтарогоНабора.Найти(Выборка.КлючКода, "КлючКода");
					Если СтараяСтр = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					Если ТаблицаНовогоНабора.Найти(Выборка.КлючКода, "КлючКода") = Неопределено Тогда
						НоваяСтр = ТаблицаНовогоНабора.Добавить();
						НоваяСтр.ПорцияЗаписей = НоваяПорция;
						ЗаполнитьЗначенияСвойств(НоваяСтр, СтараяСтр, , "ПорцияЗаписей");
					КонецЕсли;
					
					ТаблицаСтарогоНабора.Удалить(СтараяСтр);
					
				КонецЦикла;
				
				СтарыйНабор.Загрузить(ТаблицаСтарогоНабора);
				СтарыйНабор.ОбменДанными.Загрузка = Истина;
				СтарыйНабор.Записать();
				
			КонецЦикла;
			
			НовыйНабор.Загрузить(ТаблицаНовогоНабора);
			НовыйНабор.ОбменДанными.Загрузка = Истина;
			НовыйНабор.Записать();
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		
		ОбработанныеПорции.Добавить(НоваяПорция);
		
	КонецЦикла;
	
КонецПроцедуры

