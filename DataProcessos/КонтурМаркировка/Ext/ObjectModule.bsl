Функция КонтурИнтеграция_ВсеКомандыДокументов1С() Экспорт
	
	КлючКэш = "ВсеКомандыДокументов1С";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействияДокументовУчета();
	
	Результат = Новый СписокЗначений;
	Результат.Добавить(ТребуемыеДействия.НачатьРаботу         , "Начать маркировку");
	Результат.Добавить(ТребуемыеДействия.ПодобратьТовары      , "Заполнить товары маркировки");
	Результат.Добавить(ТребуемыеДействия.НаполнитьКодами      , "Наполнить кодами маркировки");
	Результат.Добавить(ТребуемыеДействия.ЗаполнитьНаТСД       , "Наполнить кодами маркировки на ТСД");
	Результат.Добавить(ТребуемыеДействия.НапечататьЭтикетки   , "Напечатать этикетки с маркировкой");
	Результат.Добавить(ТребуемыеДействия.ОтчитатьсяОНанесении , "Отчитаться о нанесении маркировки");
	Результат.Добавить(ТребуемыеДействия.ВвестиВОборот        , "Ввести в оборот коды маркировки");
	Результат.Добавить(ТребуемыеДействия.ИсправитьОшибку      , "Исправить ошибки маркировки");
	Результат.Добавить(ТребуемыеДействия.ЗавершитьРаботу      , "Завершить маркировку");
	Результат.Добавить(ТребуемыеДействия.РаботаЗавершена      , "Маркировка завершена");
	
	Для каждого Элемент Из ТребуемыеДействия Цикл
		Если Результат.НайтиПоЗначению(Элемент.Значение) = Неопределено Тогда
			Результат.Добавить(Элемент.Значение, "Продолжить маркировку");
		КонецЕсли;
	КонецЦикла;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

