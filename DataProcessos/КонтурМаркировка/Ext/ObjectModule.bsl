	|	КодыДокументов.КлючКода,
	|	ИнформацияОКодах.ОбщийТипУпаковки,
	|	ИнформацияОКодах.НомерПартии,
	|	ТоварыАгрегатов.Товар,
	|	ТоварыАгрегатов.КлючНоменклатуры1С";
	
	Если ВключатьВыбывшиеКоды Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ФильтрВыбывшихКодов", "ИСТИНА");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ФильтрВыбывшихКодов", "НЕ СтатусыКодов.Статус В (&СтатусыКодовВыбыл)");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ВключатьВыбывшиеКоды", ВключатьВыбывшиеКоды);
	Запрос.УстановитьПараметр("СтатусыКодовВыбыл", СведенияОМаркировке_СтатусыКодовВыбыл());
	Запрос.УстановитьПараметр("Транспортная", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
