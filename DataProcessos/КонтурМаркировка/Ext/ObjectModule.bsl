// Возвращает структуру, содержащую значения реквизитов прочитанные из информационной базы
// по ссылке на объект.
// 
//  Если доступа к одному из реквизитов нет, возникнет исключение прав доступа.
//  Если необходимо зачитать реквизит независимо от прав текущего пользователя,
//  то следует использовать предварительный переход в привилегированный режим.
// 
// Параметры:
//  Ссылка    - Ссылка на объект - элемент справочника, документ, ...
//
//  Реквизиты - Строка - имена реквизитов, перечисленные через запятую, в формате
//              требований к свойствам структуры.
//              Например, "Код, Наименование, Родитель".
//            - Структура, ФиксированнаяСтруктура - в качестве ключа передается
//              псевдоним поля для возвращаемой структуры с результатом, а в качестве
//              значения (опционально) фактическое имя поля в таблице.
//              Если значение не определено, то имя поля берется из ключа.
//            - Массив, ФиксированныйМассив - имена реквизитов в формате требований
//              к свойствам структуры.
//
// Возвращаемое значение:
//  Структура - содержит имена (ключи) и значения затребованных реквизитов.
//              Если строка затребованных реквизитов пуста, то возвращается пустая структура
//
Функция ЗначенияРеквизитовОбъекта_Марк(Ссылка, Реквизиты) Экспорт
	
	Возврат МодульЯдро().ЗначенияРеквизитовОбъекта_Марк(Ссылка, Реквизиты);
	
КонецФункции

// Возвращает значение реквизита объекта прочитанного из базы через запрос
// 
// Параметры:
//  Ссылка - ЛюбаяСсылка - ссылка на объект;
//  ИмяРеквизита - Строка - имя реквизита;
// 
// Возвращаемое значение:
//  Произвольный - значение реквизита;
//  Неопределено - если ссылка пустая;
//
Функция ЗначениеРеквизитаОбъекта_Марк(Ссылка, ИмяРеквизита) Экспорт
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		СтруктураРеквизита = ЗначенияРеквизитовОбъекта_Марк(Ссылка, ИмяРеквизита);
		Если ЗначениеЗаполнено(СтруктураРеквизита) Тогда
			Результат = СтруктураРеквизита[ИмяРеквизита];
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение свойства из регистра доп сведений
// 
// Параметры:
//  Ссылка - ЛюбаяСсылка - ссылка на объект;
//  ИмяСвойства - Строка - имя свойства;
//  ЗначениеПоУмолчанию - Произвольный - значение по умолчанию, если доп сведений нет;
// 
// Возвращаемое значение:
//  Произвольный - значение доп сведения;
//  Неопределено - если таких доп сведений нет;
//
Функция ЗначениеДопСвойстваОбъекта(Ссылка, ИмяСвойства, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	ЕстьДопСвойства = ЕстьНеобходимыеМетаданные("РегистрыСведений.ЗначенияСвойствОбъектов")
	И ЕстьНеобходимыеМетаданные("ПланыВидовХарактеристик.СвойстваОбъектов");
	
	ЕстьДопСведения = ЕстьНеобходимыеМетаданные("РегистрыСведений.ДополнительныеСведения")
	И ЕстьНеобходимыеМетаданные("ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения");
	
	Если ЕстьДопСвойства Тогда
		ИмяТаблицы = "ЗначенияСвойствОбъектов";
		Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(ИмяСвойства);
	ИначеЕсли ЕстьДопСведения Тогда
		ИмяТаблицы = "ДополнительныеСведения";
		Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию(ИмяСвойства);
	Иначе
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Не обнаружены метаданные для чтения доп. свойств объекта: %1'"), Ссылка);
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Значение
	|ИЗ
	|	РегистрСведений." + ИмяТаблицы + " КАК Т
	|ГДЕ
	|	Т.Объект = &Объект
	|	И Т.Свойство = &Свойство");
	
	Запрос.УстановитьПараметр("Объект"	, Ссылка);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	
	Результат = ПолучитьРезультатЗапроса(Запрос, "Значение", ЗначениеПоУмолчанию);
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение из таб части дополнительных реквизитов
// 
// Параметры:
//  Ссылка - ЛюбаяСсылка - ссылка на объект;
//  ИмяДопРеквизита - Строка - имя доп реквизита;
//  ЗначениеПоУмолчанию - Произвольный - значение по умолчанию, если доп реквизита нет;
// 
// Возвращаемое значение:
//  Произвольный - значение доп реквизита;
//  Неопределено - если такого доп реквизита нет;
//
Функция ЗначениеДопРеквизитаОбъекта(Ссылка, ИмяДопРеквизита, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	ПолноеИмя = Ссылка.Метаданные().ПолноеИмя();
	ИмяТабЧасти = "ДополнительныеРеквизиты";
	
	ЕстьДопРеквизиты = ЕстьНеобходимыеМетаданные(ПолноеИмя + ".ТабличныеЧасти." + ИмяТабЧасти)
	И ЕстьНеобходимыеМетаданные("ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения");
	
	Если Не ЕстьДопРеквизиты Тогда
		ТекстОшибки = НСтр("ru = 'Не обнаружены метаданные для чтения доп реквизитов объекта: %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, Ссылка);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию(ИмяДопРеквизита);
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Значение КАК Значение
	|ИЗ
	|	ТабЧасть КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка
	|	И Т.Свойство = &Свойство";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТабЧасть", ПолноеИмя + "." + ИмяТабЧасти);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	
	Результат = ПолучитьРезультатЗапроса(Запрос, "Значение", ЗначениеПоУмолчанию);
	
	Возврат Результат;
	
КонецФункции

