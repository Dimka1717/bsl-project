Функция ТипыОперацийСВыгрузкойКодов() Экспорт
	
	КлючКэш = "ТипыОперацийСВыгрузкойКодов";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	Результат = Новый Массив;
	Результат.Добавить(ТипыОпераций.ПечатьКодов);
	Результат.Добавить(ТипыОпераций.СообщениеОбОтгрузке);
	
	Результат = Новый ФиксированныйМассив(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
