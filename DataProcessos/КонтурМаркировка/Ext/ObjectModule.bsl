Процедура ТаблицаКодов_ЗаменитьРазделителиGS1(ТаблицаКодов)
	
	Эквивалент = ЭквивалентРазделителяGS1();
	РазделительGS1 = РазделительGS1();
	
	Для каждого Стр Из ТаблицаКодов Цикл
		Стр.ПолныйКод = СтрЗаменить(Стр.ПолныйКод, РазделительGS1, Эквивалент);
		Стр.КодМаркировки = СтрЗаменить(Стр.КодМаркировки, РазделительGS1, Эквивалент);
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_ЗаменитьНаПредставлениеРазделителиGS1(ТаблицаКодов) Экспорт
	
	РазделительGS1 = РазделительGS1();
	Представление = МодульЯдро().ПредставлениеСимволаGS1();
	
	ЕстьКолонкаПолныйКод = ТаблицаКодов.Колонки.Найти("ПолныйКод") <> Неопределено;
	ЕстьКолонкаКодАгрегата = ТаблицаКодов.Колонки.Найти("КодАгрегата") <> Неопределено;
	ЕстьКолонкаКодМаркировки = ТаблицаКодов.Колонки.Найти("КодМаркировки") <> Неопределено;
	ЕстьКолонкаИсходныйКодМаркировки = ТаблицаКодов.Колонки.Найти("ИсходныйКодМаркировки") <> Неопределено;
	
	ЕстьКолонкаСКодом = ЕстьКолонкаПолныйКод 
	Или ЕстьКолонкаКодАгрегата 
	Или ЕстьКолонкаКодМаркировки 
	Или ЕстьКолонкаИсходныйКодМаркировки;
	
	Если Не ЕстьКолонкаСКодом Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Стр Из ТаблицаКодов Цикл
		
		Если ЕстьКолонкаПолныйКод Тогда
			Стр.ПолныйКод = СтрЗаменить(Стр.ПолныйКод, РазделительGS1, Представление);
		КонецЕсли;
		
		Если ЕстьКолонкаКодМаркировки Тогда
			Стр.КодМаркировки = СтрЗаменить(Стр.КодМаркировки, РазделительGS1, Представление);
		КонецЕсли;
		
		Если ЕстьКолонкаИсходныйКодМаркировки Тогда
			Стр.ИсходныйКодМаркировки = СтрЗаменить(Стр.ИсходныйКодМаркировки, РазделительGS1, Представление);
		КонецЕсли;
		
		Если ЕстьКолонкаКодАгрегата Тогда
			Стр.КодАгрегата = СтрЗаменить(Стр.КодАгрегата, РазделительGS1, Представление);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

