Процедура ВосстановитьНастройкуОтбораСКД(НаименованиеОтбора, КомпоновщикНастроек) Экспорт
	
	СохраненныйТекст = ХранилищеНастроекДанныхФорм.Загрузить(СписокДокументов_КлючНастроекСКД(), НаименованиеОтбора);
	
	Если ЗначениеЗаполнено(СохраненныйТекст) Тогда
		
		Попытка
			ЧтениеXML = Новый ЧтениеXML; 
			ЧтениеXML.УстановитьСтроку(СохраненныйТекст); 
			СохраненнаяНастройка = СериализаторXDTO.ПрочитатьXML(ЧтениеXML, Тип("НастройкиКомпоновкиДанных"));
			КомпоновщикНастроек.ЗагрузитьНастройки(СохраненнаяНастройка);
		Исключение
			Текст = НСтр("ru = 'Не удалось восстановить настройки по причине: 
								|%1'");
			ОбработатьОшибку(НСтр("ru = 'Восстановление настройки отбора СКД'"),
											ПараметрыВСтроку(Текст, ОписаниеОшибки()));
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СохранитьОтборСпискаДокументов(НаименованиеНовогоОтбора, КомпоновщикНастроек) Экспорт
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML,
								КомпоновщикНастроек.Настройки,
								"Settings",
								"http://v8.1c.ru/8.1/data-composition-system/settings");
	
	Текст = ЗаписьXML.Закрыть();
	
	ХранилищеНастроекДанныхФорм.Сохранить(СписокДокументов_КлючНастроекСКД(), НаименованиеНовогоОтбора, Текст);
	
