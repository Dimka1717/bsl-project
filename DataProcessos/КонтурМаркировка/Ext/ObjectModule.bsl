// Устарела. Следует использовать ДобавитьНовыеКодыВДокумент()
// Добавляет коды в документ
//
// Параметры:
//  Документ - ДокументСсылка, СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ 1С или документ учета;
//  ОписанияИлиТаблицаКодов  - ТаблицаЗначений, Массив, Структура - см. функцию ТаблицаНовыхКодов(),
//                                      поддерживает устаревший контракт см. функцию ОписаниеКодаМаркировки();
//  УдалитьСтарыеКоды        - Булево - (необязательный) Истина, если из документа нужно удалить старые коды;
//  ЗаполнитьТоварыДокумента - Булево - (необязательный) Истина, если товары документа нужно перезаполнить номенклатурой кодов;
//  ЗаполнитьТоварыАгрегатов - Булево - (необязательный) Истина, если нужно заполнить товары агрегатов,
//                                      если не указан используются настройки модуля;
//
Процедура ДобавитьКодыВДокумент(Документ, ОписанияИлиТаблицаКодов
	, Знач УдалитьСтарыеКоды = Ложь
	, Знач ЗаполнитьТоварыДокумента = Ложь
	, Знач ЗаполнитьТоварыАгрегатов = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен документ 1С'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписанияИлиТаблицаКодов) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнена коллекция кодов'");
	КонецЕсли;
	
	Если ЗаполнитьТоварыАгрегатов = Неопределено Тогда
		ЗаполнитьТоварыАгрегатов = НастройкиМодуля().ЗаполнятьТоварыАгрегатов;
	КонецЕсли;
	
	Если ТипЗнч(ОписанияИлиТаблицаКодов) = Тип("ТаблицаЗначений") Тогда
		ТаблицаКодов = ОписанияИлиТаблицаКодов;
		ВосстановитьТаблицуКодовДляСовместимостиМодуль(ТаблицаКодов);
	Иначе
		ТаблицаКодов = ТаблицаКодовИзОписанийКодов(ОписанияИлиТаблицаКодов);
	КонецЕсли;
	
	ПараметрыЗагрузки = Новый_ПараметрыЗагрузкиНовыхКодовВДокумент();
	ПараметрыЗагрузки.УдалитьСтарыеКоды = УдалитьСтарыеКоды;
	ПараметрыЗагрузки.ЗаполнитьТоварыДокумента = ЗаполнитьТоварыДокумента;
	ПараметрыЗагрузки.ЗаполнитьТоварыАгрегатов = ЗаполнитьТоварыАгрегатов;
	ПараметрыЗагрузки.УдалитьИзДокументаКодыВАгрегатах = ТаблицаКодов_ЕстьКодыАгрегатов(ТаблицаКодов);
	
	ДобавитьНовыеКодыВДокумент(Документ, ТаблицаКодов, ПараметрыЗагрузки);
	
КонецПроцедуры

// Устарела. Следует использовать ЗаполнитьСведенияОМаркировке()
// Возвращает таблицу упаковок и кодов маркировки с номенклатурой
// (характеристикой, серией), которая в них входит
//
// Параметры:
//   * Документы1С - Массив - содержит документы, по которым нужно заполнить таблицу;
//  ОшибкиЗаполнения - Массив - исходящий параметр, ошибки выполнения функции, содержит структуры с полями:
//   * ТекстОшибки        - Строка           - описание ошибки;
//   * ВладелецКодов      - ДокументСсылка   - документ-владелец штрихкодов, в котором возникла ошибка;
//   * ДокументМаркировки - СправочникСсылка - документ Контур.Маркировки, с которым связан документ-владелец;
//  ПроверитьЗавершениеРаботыСКодами - Булево - Истина, если нужно проверить, что работа с кодами завершена;
// 
// Возвращаемое значение:
//  ТаблицаЗначений - таблица упаковок с товарными данными:
//   * Ссылка            - ДокументСсылка - документ-владелец штрихкода;
//   * Номенклатура      - СправочникСсылка - содержимое;
//   * Характеристика    - СправочникСсылка - содержимое;
//   * Серия             - СправочникСсылка - содержимое;
//   * ЗначениеШтрихкода - Строка - код маркировки для заполнения документа ЭДО;
//   * Мультитоварная    - Булево - признак мультитоварной упаковки;
//   * ВидПродукции      - Перечислениессылка.КонтурМаркировка_ВидыПродукции - вид продукции;
//   * ВидУпаковки       - ПеречислениеСсылка.КонтурМаркировка_ВидыУпаковок - вид упаковки;
//
Функция РазвернутаяТаблицаУпаковок(Документы1С, ОшибкиЗаполнения = Неопределено
	, ПроверитьЗавершениеРаботыСКодами = Истина) Экспорт
	
	МассивДокументов1С = ЗначениеВМассиве(Документы1С);
	
	СтандартнаяОбработка = Истина;
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("Документы1С", МассивДокументов1С);
	ПараметрыПМ.Вставить("ОшибкиЗаполнения", Новый Массив);
	ПараметрыПМ.Вставить("РазвернутаяТаблицаУпаковок", Новый_РазвернутаяТаблицаУпаковок());
	ПараметрыПМ.Вставить("ПроверитьЗавершениеРаботыСКодами", ПроверитьЗавершениеРаботыСКодами);
	ПМ_ОбработатьСобытие_ПриЗаполненииРазвернутойТаблицыУпаковок(ПараметрыПМ, СтандартнаяОбработка);
	
	Результат = ПараметрыПМ.РазвернутаяТаблицаУпаковок;
	ОшибкиЗаполнения = ПараметрыПМ.ОшибкиЗаполнения;
	ПроверитьЗавершениеРаботыСКодами = ПараметрыПМ.ПроверитьЗавершениеРаботыСКодами;
	
	МассивДокументовУчета = РазвернутаяТаблицаУпаковок_МассивДокументовУчета(МассивДокументов1С, ОшибкиЗаполнения);
	Если Не ЗначениеЗаполнено(МассивДокументовУчета) Тогда
		Возврат Новый_РазвернутаяТаблицаУпаковок();
	КонецЕсли;
	
	СведенияОМаркировкеБылиПереданы = ДокументыУчета_ПереданыСведенияОМаркировке(МассивДокументовУчета);
	
	Если Не СтандартнаяОбработка Тогда
		Если Не СведенияОМаркировкеБылиПереданы И ЗначениеЗаполнено(Результат) Тогда
			Метрика_Функциональность_РазвернутаяТаблицаУпаковокЧерезПМ(МассивДокументов1С);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	Для каждого ДокументУчета Из МассивДокументовУчета Цикл
		ДокументУчета_ИзвлечьКодыИзАрхива(ДокументУчета);
	КонецЦикла;
	
	Результат.Колонки.Добавить("ОбъемноСортовойУчет", ОписаниеТипа_Булево());
	Результат.Колонки.Добавить("КоличествоУпаковок", ОписаниеТипа_Число());
	Результат.Колонки.Добавить("GTIN", ОписаниеТипа_Строка());
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ДокументыУчета.КлючДокумента1С КАК КлючДокумента1С,
	|	ДокументыУчета.ТипКлючаДокумента1С КАК ТипКлючаДокумента1С,
	|	ДокументыУчета.Ссылка КАК ДокументУчета,
	|	КодыДокументов.КлючКода КАК КлючКода,
	|	ИнформацияОКодах.ВидПродукции КАК ВидПродукции,
	|	КодыМаркировки.КодМаркировки КАК КодМаркировки,
	|	ИнформацияОКодах.ТипУпаковки КАК ТипУпаковки,
	|	ИнформацияОКодах.ОбщийТипУпаковки КАК ОбщийТипУпаковки,
	|	ТЧ_ТоварыДокумента.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	ИнформацияОКодах.Товар КАК Товар,
	|	1 КАК КоличествоУпаковок,
	|	ТЧ_ТоварыДокумента.Количество КАК КоличествоТоваров,
	|	&ПУ КАК ОтражениеВЭДО,
	|	ИнформацияОКодах.ДляВнутреннегоУчета КАК ДляВнутреннегоУчета,
	|	ТЧ_ТоварыДокумента.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета КАК ДокументыУчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО ДокументыУчета.Ссылка = КодыДокументов.ДокументУчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТЧ_ТоварыДокумента
	|		ПО ДокументыУчета.Ссылка = ТЧ_ТоварыДокумента.Ссылка
	|			И (КодыДокументов.КлючСтрокиДокумента = ТЧ_ТоварыДокумента.КлючСтрокиДокумента)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО (КодыДокументов.КлючКода = КодыМаркировки.КлючКода)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючей
	|		ПО (КодыДокументов.КлючКода = СвязиКлючей.КлючКода)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (СвязиКлючей.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|		ПО (СвязиКлючей.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода)
	|ГДЕ
	|	ДокументыУчета.Ссылка В(&МассивДокументовУчета)
	|	И НЕ ЕСТЬNULL(СтатусыКодов.Статус, """") В (&СтатусыКодовВыбыл)
	|	И ТЧ_ТоварыДокумента.НеПодлежитМаркировке = ЛОЖЬ
	|	И ТЧ_ТоварыДокумента.ОтражениеВЭДО = &ПУ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДокументыУчета.КлючДокумента1С,
	|	ДокументыУчета.ТипКлючаДокумента1С,
	|	ДокументыУчета.Ссылка,
	|	НЕОПРЕДЕЛЕНО,
	|	ИнформацияОКодах.ВидПродукции,
	|	НЕОПРЕДЕЛЕНО,
	|	НЕОПРЕДЕЛЕНО,
	|	НЕОПРЕДЕЛЕНО,
	|	ТЧ_ТоварыДокумента.КлючНоменклатуры1С,
	|	ИнформацияОКодах.Товар,
	|	1,
	|	ТЧ_ТоварыДокумента.Количество,
	|	&ОСУ,
	|	ИнформацияОКодах.ДляВнутреннегоУчета,
	|	ТЧ_ТоварыДокумента.НомерСтроки
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета КАК ДокументыУчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО ДокументыУчета.Ссылка = КодыДокументов.ДокументУчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТЧ_ТоварыДокумента
	|		ПО ДокументыУчета.Ссылка = ТЧ_ТоварыДокумента.Ссылка
	|			И (КодыДокументов.КлючСтрокиДокумента = ТЧ_ТоварыДокумента.КлючСтрокиДокумента)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО (КодыДокументов.КлючКода = КодыМаркировки.КлючКода)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючей
	|		ПО (КодыДокументов.КлючКода = СвязиКлючей.КлючКода)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (СвязиКлючей.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|		ПО (СвязиКлючей.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода)
	|ГДЕ
	|	ДокументыУчета.Ссылка В(&МассивДокументовУчета)
	|	И НЕ ЕСТЬNULL(СтатусыКодов.Статус, """") В (&СтатусыКодовВыбыл)
	|	И ТЧ_ТоварыДокумента.НеПодлежитМаркировке = ЛОЖЬ
	|	И ТЧ_ТоварыДокумента.ОтражениеВЭДО = &ОСУ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДокументыУчета.КлючДокумента1С,
	|	ДокументыУчета.ТипКлючаДокумента1С,
	|	ДокументыУчета.Ссылка,
	|	НЕОПРЕДЕЛЕНО,
	|	ЕСТЬNULL(ТЧ_ТоварыМаркировки.Товар.ВидПродукции, НЕОПРЕДЕЛЕНО),
	|	НЕОПРЕДЕЛЕНО,
	|	НЕОПРЕДЕЛЕНО,
	|	НЕОПРЕДЕЛЕНО,
	|	ТЧ_ТоварыДокумента.КлючНоменклатуры1С,
	|	ЕСТЬNULL(ТЧ_ТоварыМаркировки.Товар, НЕОПРЕДЕЛЕНО),
	|	ЕСТЬNULL(ТЧ_ТоварыМаркировки.КоличествоУпаковок, 0),
	|	ТЧ_ТоварыДокумента.Количество,
	|	ТЧ_ТоварыДокумента.ОтражениеВЭДО,
	|	ЛОЖЬ,
	|	ТЧ_ТоварыДокумента.НомерСтроки
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета КАК ДокументыУчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТЧ_ТоварыДокумента
	|		ПО ДокументыУчета.Ссылка = ТЧ_ТоварыДокумента.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыМаркировки КАК ТЧ_ТоварыМаркировки
	|		ПО ДокументыУчета.Ссылка = ТЧ_ТоварыМаркировки.Ссылка
	|			И (ТЧ_ТоварыДокумента.КлючСтрокиДокумента = ТЧ_ТоварыМаркировки.КлючСтрокиДокумента)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО ДокументыУчета.Ссылка = КодыДокументов.ДокументУчета
	|			И (ТЧ_ТоварыДокумента.КлючСтрокиДокумента = КодыДокументов.КлючСтрокиДокумента)
	|ГДЕ
	|	ДокументыУчета.Ссылка В(&МассивДокументовУчета)
	|	И КодыДокументов.ДокументУчета ЕСТЬ NULL
	|	И ТЧ_ТоварыДокумента.НеПодлежитМаркировке = ЛОЖЬ
	|	И ТЧ_ТоварыДокумента.ОтражениеВЭДО <> &НеОтражать
	|
	|УПОРЯДОЧИТЬ ПО
	|	КлючДокумента1С
	|ИТОГИ
	|	СУММА(КоличествоУпаковок)
	|ПО
	|	ДокументУчета,
	|	НомерСтроки");
	
	ОбщиеТипыУпаковок = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок;
	ПравилаОтраженияВЭДО = Перечисления.КонтурМаркировка_ПравилаОтраженияВЭДО;
	СтатусыДокументовУчета = Перечисление_СтатусыДокументовУчета();
	
	СтатусыКодов = Перечисление_СтатусыКодов();
	
	СтатусыКодовВыбыл = Новый Массив;
	СтатусыКодовВыбыл.Добавить(СтатусыКодов.Списан);
	СтатусыКодовВыбыл.Добавить(СтатусыКодов.ВыбылИзОборота);
	
	Запрос.УстановитьПараметр("ПУ", ПравилаОтраженияВЭДО.ПУ);
	Запрос.УстановитьПараметр("ОСУ", ПравилаОтраженияВЭДО.ОСУ);
	Запрос.УстановитьПараметр("НеОтражать", ПравилаОтраженияВЭДО.НеОтражать);
	Запрос.УстановитьПараметр("СтатусыКодовВыбыл", СтатусыКодовВыбыл);
	Запрос.УстановитьПараметр("МассивДокументовУчета", МассивДокументовУчета);
	
	Ошибки = Новый Структура;
	Ошибки.Вставить("КодыОтсутствуют", Новый Соответствие);
	Ошибки.Вставить("ДокументНеЗавершен", Новый Соответствие);
	Ошибки.Вставить("КодыНеСопоставлены", Новый Соответствие);
	Ошибки.Вставить("ТоварыНеСопоставлены", Новый Соответствие);
	Ошибки.Вставить("НеУказаноКоличествоУпаковок", Новый Соответствие);
	Ошибки.Вставить("НетИнформацииИзГИСМТ", Новый Соответствие);
	Ошибки.Вставить("НеРазрешенОСУ", Новый Соответствие);
	
	МультитоварнаяУпаковка = Перечисления.КонтурМаркировка_ТипыУпаковок.МультитоварнаяУпаковка;
	ЕстьКодыДляВнутреннегоУчета = Ложь;
	КэшТоваров = Новый Соответствие;
	КэшКлючейНоменклатуры1С = Новый Соответствие;
	
	ВыборкаПоДокументуУчета = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоДокументуУчета.Следующий() Цикл
		
		ДокументУчета = ВыборкаПоДокументуУчета.ДокументУчета;
		СтатусДокумента = ДокументУчета_ОсновнойСтатус(ДокументУчета);
		
		ВыборкаПоНомеруСтроки = ВыборкаПоДокументуУчета.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоНомеруСтроки.Следующий() Цикл
			
			ВсегоУпаковокПоСтроке = ВыборкаПоНомеруСтроки.КоличествоУпаковок;
			
			Выборка = ВыборкаПоНомеруСтроки.Выбрать();
			Пока Выборка.Следующий() Цикл
				
				ОбъемноСортовойУчет = (Выборка.ОтражениеВЭДО = ПравилаОтраженияВЭДО.ОСУ);
				
				GTIN = Неопределено;
				ОшибкаГИСМТ = Неопределено;
				Если ЗначениеЗаполнено(Выборка.Товар) Тогда
					ОписаниеТовара = Товар_Прочитать(Выборка.Товар, КэшТоваров);
					ОшибкаГИСМТ = ОписаниеТовара.ДопРеквизиты.ОшибкаГИСМТ;
					GTIN = ОписаниеТовара.GTIN;
				КонецЕсли;
				
				ДеталиОшибки = Новый Структура;
				ДеталиОшибки.Вставить("GTIN", GTIN);
				ДеталиОшибки.Вставить("НомерСтроки", Выборка.НомерСтроки);
				ДеталиОшибки.Вставить("ДокументУчета", ДокументУчета);
				
				Документ1С = МодульОбщегоНазначения().СсылкаПоИдентификатору(
				Выборка.КлючДокумента1С, Выборка.ТипКлючаДокумента1С);
				
				Если Не ОбъемноСортовойУчет
					И Не ЗначениеЗаполнено(Выборка.КодМаркировки) Тогда
					Ошибки.КодыОтсутствуют.Вставить(Документ1С, ДокументУчета);
					Продолжить;
				КонецЕсли;
				
				Если ПроверитьЗавершениеРаботыСКодами
					И СтатусДокумента <> СтатусыДокументовУчета.Завершен Тогда
					Ошибки.ДокументНеЗавершен.Вставить(Документ1С, ДокументУчета);
					Продолжить;
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(Выборка.Товар)
					И Выборка.ОбщийТипУпаковки <> ОбщиеТипыУпаковок.ТранспортнаяУпаковка Тогда
					Ошибки.ТоварыНеСопоставлены.Вставить(Документ1С, ДокументУчета);
					Продолжить;
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(Выборка.КлючНоменклатуры1С) Тогда
					Ошибки.КодыНеСопоставлены.Вставить(Документ1С, ДокументУчета);
					Продолжить;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Выборка.КоличествоТоваров)
					И Не ЗначениеЗаполнено(Выборка.КоличествоУпаковок) Тогда
					Если Выборка.КоличествоТоваров <> ВсегоУпаковокПоСтроке Тогда
						МассивОшибок = ЗначениеСоответствия(Ошибки.НеУказаноКоличествоУпаковок, Документ1С, Новый Массив);
						МассивОшибок.Добавить(ДеталиОшибки);
						Ошибки.НеУказаноКоличествоУпаковок.Вставить(Документ1С, МассивОшибок);
					КонецЕсли;
					Продолжить;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ОшибкаГИСМТ) Тогда
					МассивОшибок = ЗначениеСоответствия(Ошибки.НетИнформацииИзГИСМТ, Документ1С, Новый Массив);
					МассивОшибок.Добавить(ДеталиОшибки);
					Ошибки.НетИнформацииИзГИСМТ.Вставить(Документ1С, МассивОшибок);
					Продолжить;
				КонецЕсли;
				
				Если ОбъемноСортовойУчет
					И Не ВидПродукцииДопускаетОСУ(Выборка.ВидПродукции) Тогда
					МассивОшибок = ЗначениеСоответствия(Ошибки.НеРазрешенОСУ, Документ1С, Новый Массив);
					МассивОшибок.Добавить(ДеталиОшибки);
					Ошибки.НеРазрешенОСУ.Вставить(Документ1С, МассивОшибок);
					Продолжить;
				КонецЕсли;
				
				Если Не ОбъемноСортовойУчет
					И Выборка.ДляВнутреннегоУчета Тогда
					ЕстьКодыДляВнутреннегоУчета = Истина;
					Продолжить;
				КонецЕсли;
				
				Если Не ОбъемноСортовойУчет
					И Выборка.ОбщийТипУпаковки = ОбщиеТипыУпаковок.АТК Тогда
					Продолжить;
				КонецЕсли;
				
				Если ОбъемноСортовойУчет Тогда
					ВидУпаковки = Перечисления.КонтурМаркировка_ВидыУпаковок.ОбъемноСортовойУчет;
				Иначе
					ВидУпаковки = ВидУпаковкиПоОбщемуТипуУпаковки(Выборка.ОбщийТипУпаковки);
				КонецЕсли;
				
				АналитикаНоменклатуры1С = АналитикаНоменклатуры1С(Выборка.КлючНоменклатуры1С, КэшКлючейНоменклатуры1С);
				
				НоваяСтрока = Результат.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
				ЗаполнитьЗначенияСвойств(НоваяСтрока, АналитикаНоменклатуры1С);
				
				НоваяСтрока.GTIN                       = GTIN;
				НоваяСтрока.ЗначениеШтрихкода          = Выборка.КодМаркировки;
				НоваяСтрока.ИспользоватьХарактеристики = ЗначениеЗаполнено(НоваяСтрока.Характеристика);
				НоваяСтрока.ИспользоватьСерии          = ЗначениеЗаполнено(НоваяСтрока.Серия);
				НоваяСтрока.Мультитоварная             = (Выборка.ТипУпаковки = МультитоварнаяУпаковка);
				НоваяСтрока.ВидУпаковки                = ВидУпаковки;
				НоваяСтрока.ОбъемноСортовойУчет        = ОбъемноСортовойУчет;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	КолонкаСуммы = "КоличествоУпаковок";
	КолонкиГруппировки = СоединитьСтроку(ТаблицаЗначений_МассивКолонок(Результат, КолонкаСуммы), ",");
	Результат.Свернуть(КолонкиГруппировки, КолонкаСуммы);
	
	Для каждого Строка Из Результат Цикл
		Если Строка.ОбъемноСортовойУчет Тогда
			Строка.ЗначениеШтрихкода = ШтрихкодОбъемноСортовогоУчета(Строка.GTIN, Строка.КоличествоУпаковок);
		КонецЕсли;
	КонецЦикла;
	
	Результат.Колонки.Удалить("ОбъемноСортовойУчет");
	Результат.Колонки.Удалить("КоличествоУпаковок");
	Результат.Колонки.Удалить("GTIN");
	
	Для каждого Элемент Из Ошибки.КодыОтсутствуют Цикл
		Документ1С = Элемент.Ключ;
		ДокументУчета = Элемент.Значение;
		ШаблонОшибки = НСтр("ru = 'Необходимо наполнить кодами маркировки документ: %1'");
		ОписаниеОшибки = Новый_ОшибкаЗаполненияРазвернутойТаблицыУпаковок(Документ1С, ДокументУчета);
		ОписаниеОшибки.ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, Документ1С);
		ОшибкиЗаполнения.Добавить(ОписаниеОшибки);
	КонецЦикла;
	
	Для каждого Элемент Из Ошибки.КодыНеСопоставлены Цикл
		Документ1С = Элемент.Ключ;
		ДокументУчета = Элемент.Значение;
		ШаблонОшибки = НСтр("ru = 'Необходимо сопоставить коды маркировки с номенклатурой документа: %1'");
		ОписаниеОшибки = Новый_ОшибкаЗаполненияРазвернутойТаблицыУпаковок(Документ1С, ДокументУчета);
		ОписаниеОшибки.ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, Документ1С);
		ОшибкиЗаполнения.Добавить(ОписаниеОшибки);
	КонецЦикла;
	
	Для каждого Элемент Из Ошибки.ТоварыНеСопоставлены Цикл
		Документ1С = Элемент.Ключ;
		ДокументУчета = Элемент.Значение;
		ШаблонОшибки = НСтр("ru = 'Необходимо сопоставить товары маркировки с номенклатурой документа: %1'");
		ОписаниеОшибки = Новый_ОшибкаЗаполненияРазвернутойТаблицыУпаковок(Документ1С, ДокументУчета);
		ОписаниеОшибки.ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, Документ1С);
		ОшибкиЗаполнения.Добавить(ОписаниеОшибки);
	КонецЦикла;
	
	Для каждого Элемент Из Ошибки.ДокументНеЗавершен Цикл
		Документ1С = Элемент.Ключ;
		ДокументУчета = Элемент.Значение;
		ШаблонОшибки = НСтр("ru = 'Необходимо завершить работу с кодами маркировки в документе: %1'");
		ОписаниеОшибки = Новый_ОшибкаЗаполненияРазвернутойТаблицыУпаковок(Документ1С, ДокументУчета);
		ОписаниеОшибки.ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, Документ1С);
		ОшибкиЗаполнения.Добавить(ОписаниеОшибки);
	КонецЦикла;
	
	Для каждого Элемент Из Ошибки.НеУказаноКоличествоУпаковок Цикл
		Документ1С = Элемент.Ключ;
		Для каждого ДеталиОшибки Из Элемент.Значение Цикл
			GTIN = ДеталиОшибки.GTIN;
			НомерСтроки = ДеталиОшибки.НомерСтроки;
			ДокументУчета = ДеталиОшибки.ДокументУчета;
			ШаблонОшибки = НСтр("ru = 'Необходимо указать количество упаковок в строке № %1 GTIN %2 в документе: %3'");
			ОписаниеОшибки = Новый_ОшибкаЗаполненияРазвернутойТаблицыУпаковок(Документ1С, ДокументУчета);
			ОписаниеОшибки.ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, НомерСтроки, GTIN, Документ1С);
			ОшибкиЗаполнения.Добавить(ОписаниеОшибки);
		КонецЦикла;
	КонецЦикла;
	
	Для каждого Элемент Из Ошибки.НетИнформацииИзГИСМТ Цикл
		Документ1С = Элемент.Ключ;
		ШаблонОшибки = ТекстСообщения_ОшибкаГИСМТ();
		ОшибкиПоДокументам = МассивСтруктур_Разбить(Элемент.Значение, "ДокументУчета");
		Для Каждого ОшибкиДокумента Из ОшибкиПоДокументам Цикл
			ДокументУчета = ОшибкиДокумента.Ключ;
			МассивGTIN = МассивСтруктур_Выгрузить(Элемент.Значение, "GTIN");
			СвернутьМассив_Марк(МассивGTIN);
			ОписаниеОшибки = Новый_ОшибкаЗаполненияРазвернутойТаблицыУпаковок(Документ1С, ДокументУчета);
			ОписаниеОшибки.ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, СоединитьСтроку(МассивGTIN, ", "));
			ОшибкиЗаполнения.Добавить(ОписаниеОшибки);
		КонецЦикла;
	КонецЦикла;
	
	Для каждого Элемент Из Ошибки.НеРазрешенОСУ Цикл
		Документ1С = Элемент.Ключ;
		ШаблонОшибки = ТекстСообщения_НеРазрешенОСУ();
		ОшибкиПоДокументам = МассивСтруктур_Разбить(Элемент.Значение, "ДокументУчета");
		Для каждого ОшибкиДокумента Из ОшибкиПоДокументам Цикл
			ДокументУчета = ОшибкиДокумента.Ключ;
			МассивGTIN = МассивСтруктур_Выгрузить(Элемент.Значение, "GTIN");
			СвернутьМассив_Марк(МассивGTIN);
			ОписаниеОшибки = Новый_ОшибкаЗаполненияРазвернутойТаблицыУпаковок(Документ1С, ДокументУчета);
			ОписаниеОшибки.ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, СоединитьСтроку(МассивGTIN, ", "));
			ОшибкиЗаполнения.Добавить(ОписаниеОшибки);
		КонецЦикла;
	КонецЦикла;
	
	ДокументыУчета_ПереданыСведенияОМаркировке_Записать(МассивДокументовУчета);
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(МассивДокументов1С[0]);
	Организация = ЗначениеРеквизитаОбъекта_Марк(ДокументУчета, "Организация");
	
	Если Не СведенияОМаркировкеБылиПереданы И ЗначениеЗаполнено(Результат) Тогда
		Метрика_Функциональность_РазвернутаяТаблицаУпаковок(Организация);
	КонецЕсли;
	
	Если ЕстьКодыДляВнутреннегоУчета Тогда
		Метрика_Функциональность_КодыДляВнутреннегоУчета(Организация);
	КонецЕсли;
	
	Если Не СведенияОМаркировкеБылиПереданы Тогда
		Метрика_РазвернутаяТаблицаУпаковок(МассивДокументов1С, Результат, Ошибки);
	КонецЕсли;
	
	ОтправитьМетрики();
	
	Возврат Результат;
	
КонецФункции

Функция РазвернутаяТаблицаУпаковок_МассивДокументовУчета(МассивДокументов1С, ОшибкиЗаполнения)
	
	Результат = Новый Массив;
	РольОтгрузка = Перечисление_РолиДокументовУчета().Отгрузка;
	СтатусПропущен = Перечисление_СтатусыДокументовУчета().Пропущен;
	СервисЗаполнениеСведенийОМаркировке = Перечисление_СервисыПодписок().ЗаполнениеСведенийОМаркировке;
	
	Для каждого Документ1С Из МассивДокументов1С Цикл
		
		ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С);
		
		Если ДокументУчета_ДоступнаРоль(ДокументУчета, РольОтгрузка)
			И ДокументУчета_ОсновнойСтатус(ДокументУчета) <> СтатусПропущен Тогда
			
			Организация = ЗначениеРеквизитаОбъекта_Марк(ДокументУчета, "Организация");
			
			Если Не СервисДоступенПоТарифу(СервисЗаполнениеСведенийОМаркировке, Тариф(Организация)) Тогда
				ОписаниеОшибки = Новый_ОшибкаЗаполненияРазвернутойТаблицыУпаковок(Документ1С, ДокументУчета);
				ОписаниеОшибки.ТекстОшибки = СведенияОМаркировке_ТекстОшибки_ТарифНеПоддерживаетНаполнение();
				ОшибкиЗаполнения.Добавить(ОписаниеОшибки);
				Метрика_ОграничениеТарифа(Организация, СервисЗаполнениеСведенийОМаркировке);
			Иначе
				Результат.Добавить(ДокументУчета);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

