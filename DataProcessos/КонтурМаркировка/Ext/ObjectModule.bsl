Функция ПроверитьЗначениеНастройкиЗаполненияРеквизита(НастройкаРеквизита
	, ТипДокумента
	, ИдентификаторФормы
	, ТаблицаФормы
	, ИндексСтроки) Экспорт
	
	Результат = Истина;
	
	ПравилаЗаполнения = Перечисление_ПравилаЗаполненияРеквизитов();
	
	Если Найти(ТипДокумента, "КонтурМаркировка_") Тогда
		ИмяТипа = "СправочникСсылка.КонтурМаркировка_ДокументыУчета";
	Иначе
		ИмяТипа = "ДокументСсылка." + ТипДокумента;
	КонецЕсли;
	
	Документ1С = ПолучитьПустуюСсылкуТипа(ИмяТипа);
	
	Если НастройкаРеквизита.ПравилоЗаполнения = ПравилаЗаполнения.РеквизитДокумента1С Тогда
		ТекстОшибки = НСтр("ru = """
		+ "Неверное значение поля."
		+ " Необходимо указать реквизит документа 1С.""", "ru");
		Попытка
			Значение = Документ1С[НастройкаРеквизита.Значение];
		Исключение
			СообщитьОбОшибкеВСтрокеТабЧасти(ТекстОшибки, ИдентификаторФормы, ТаблицаФормы, "Значение", ИндексСтроки);
			Результат = Ложь;
		КонецПопытки;
	ИначеЕсли НастройкаРеквизита.ПравилоЗаполнения = ПравилаЗаполнения.Формула Тогда
		ТекстОшибки = НСтр("ru = """
		+ "Неверная формула."
		+ " Формула должна составляться по правилам написания выражения на встроенном языке 1С:Предприятия.""", "ru");
		Попытка
			Значение = Вычислить(НастройкаРеквизита.Значение);
		Исключение
			СообщитьОбОшибкеВСтрокеТабЧасти(ТекстОшибки, ИдентификаторФормы, ТаблицаФормы, "Значение", ИндексСтроки);
			Результат = Ложь;
		КонецПопытки;
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Читает из доп справочника настройки заполнения операций
//
// Параметры:
//  Настройка - СправочникСсылка.КонтурМаркировка_ДопСправочники - настройка
// 
// Возвращаемое значение:
//  Структура - см. Новый_НастройкиЗаполненияОпераций()
//
Функция НастройкиЗаполненияОпераций_Прочитать(Настройка) Экспорт
	
	Результат = Новый_НастройкиЗаполненияОпераций();
	
	ДанныеИБ = ДопСправочник_Прочитать(Настройка);
	
	ЗаполнитьПоляСтруктуры(Результат, ДанныеИБ);
	ЗаполнитьПоляСтруктуры(Результат, ДанныеИБ.ДопРеквизиты, , "ТаблицаРеквизитов");
	
	Если ДанныеИБ.ДопРеквизиты.Свойство("ТаблицаРеквизитов") Тогда
		
		ТаблицаРеквизитов = Результат.ТаблицаРеквизитов;
		ТаблицаРеквизитовИБ = ДанныеИБ.ДопРеквизиты.ТаблицаРеквизитов;
		
		Для Каждого Строка Из ТаблицаРеквизитов Цикл
			Для Каждого СтрокаИБ Из ТаблицаРеквизитовИБ Цикл
				Если Строка.ТипОперации = СтрокаИБ.ТипОперации
					И Строка.ИмяРеквизита = СтрокаИБ.ИмяРеквизита Тогда
					ЗаполнитьЗначенияСвойств(Строка, СтрокаИБ);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Читает из доп справочника настройки заполнения операций по типу документа
//
// Параметры:
//  ТипДокумента - Строка - имя документа 1С;
// 
// Возвращаемое значение:
//  Структура - см. Новый_НастройкиЗаполненияОпераций()
//
Функция НастройкиЗаполненияОпераций_ПрочитатьПоТипуДокумента(ТипДокумента) Экспорт
	
	ДопСправочник = НастройкиЗаполненияОпераций_НайтиПоТипуДокумента(ТипДокумента);
	
	Если ЗначениеЗаполнено(ДопСправочник) Тогда
		Возврат НастройкиЗаполненияОпераций_Прочитать(ДопСправочник);
	Иначе
		Возврат Новый_НастройкиЗаполненияОпераций();
	КонецЕсли;
	
КонецФункции

// Находит настройки заполнения операций в доп справочниках по типу документа
//
// Параметры:
//  ТипДокумента - Строка - имя документа 1С;
// 
// Возвращаемое значение:
//  Структура - см. Новый_НастройкиЗаполненияОпераций()
//
Функция НастройкиЗаполненияОпераций_НайтиПоТипуДокумента(ТипДокумента) Экспорт
	
	ИмяРеквизита = "ТипДокумента";
	ИмяСправочника = ИмяСправочникаНастройкиЗаполненияОпераций();
	МассивСсылок = ДопСправочник_НайтиПоДопРеквизиту(ИмяСправочника, ИмяРеквизита, ТипДокумента);
	
	Результат = Неопределено;
	Если ЗначениеЗаполнено(МассивСсылок) Тогда
		Результат = МассивСсылок[0];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Записывает в доп справочник настройки заполнения операций
//
// Параметры:
//  ОписаниеНастроек - Структура - см. Новый_НастройкиЗаполненияОпераций()
//
Процедура НастройкиЗаполненияОпераций_Записать(ОписаниеНастроек) Экспорт
	
	ИмяСправочника = ИмяСправочникаНастройкиЗаполненияОпераций();
	ТипДокумента = ОписаниеНастроек.ТипДокумента;
	
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника, "ТипДокумента", ТипДокумента);
	ДанныеИБ.Наименование = ТипДокумента;
	
	ДанныеИБ.ДопРеквизиты.Очистить();
	Для каждого Элемент Из ОписаниеНастроек Цикл
		ДанныеИБ.ДопРеквизиты.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	ДопСправочник_Записать(ДанныеИБ);
	
КонецПроцедуры

