Процедура ДобавитьВКонтекстОбновленияЗависимостиМодуля(КонтекстОбновления, СсылкаНаФайл)
	
	Попытка
		ДанныеФайла = СкачатьФайлИзИнтернета(СсылкаНаФайл);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Получение файла зависимостей'");
		ОбработатьОшибку(Действие, Ошибка);
		Возврат;
	КонецПопытки;
	
	ДанныеФайлаСтрокой = СтрокаИзДвоичныхДанных(ДанныеФайла, КодировкаТекста.UTF8);
	СтрокиФайла = РазделитьСтроку(ДанныеФайлаСтрокой, Символы.ПС);
	
	КонтекстОбновления.Зависимости.Очистить();
	КоличествоКолонок = 2;
	Для Каждого СтрокаФайла Из СтрокиФайла Цикл
		
		ЧастиТекста = РазделитьСтроку(СтрокаФайла, "=");
		Если ЧастиТекста.Количество() <> КоличествоКолонок Тогда
			// строка имеет неверный формат
			Продолжить;
		КонецЕсли;
		
		Ключ = СокрЛП(ЧастиТекста[0]);
		Значение = СокрЛП(ЧастиТекста[1]);
		КонтекстОбновления.Зависимости.Вставить(Ключ, Значение);
		
	КонецЦикла;
	
КонецПроцедуры

