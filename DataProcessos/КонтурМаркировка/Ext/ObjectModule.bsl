Функция ДокументУчета_ИсходныйИсправляемыйДокументУчета(ДокументУчета, КэшРезультатов = Неопределено)
	
	Если КэшРезультатов <> Неопределено Тогда
		Результат = КэшРезультатов[ДокументУчета];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	ВидыКорректировки = Перечисление_ВидыКорректировкиДокумента();
	
	ВидКорректировки = ДокументУчета_ВидКорректировки(ДокументУчета);
	ИсправляемыйДокумент = ДокументУчета_ИсправляемыйДокумент(ДокументУчета);
	ИсправляемыйДокументУчета = ДокументУчета_НайтиПоДокументу1С(ИсправляемыйДокумент);
	ВидКорректировкиИсправляемогоДокумента = ДокументУчета_ВидКорректировки(ИсправляемыйДокументУчета);
	
	Если ВидКорректировки = ВидыКорректировки.Исправление
		И ЗначениеЗаполнено(ВидКорректировкиИсправляемогоДокумента) Тогда
		ИсправляемыйДокумент = ДокументУчета_ИсправляемыйДокумент(ИсправляемыйДокументУчета);
		ИсправляемыйДокументУчета = ДокументУчета_НайтиПоДокументу1С(ИсправляемыйДокумент);
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(ДокументУчета, ИсправляемыйДокументУчета);
	КонецЕсли;
	
	Возврат ИсправляемыйДокументУчета;
	
КонецФункции

