Процедура ОпределитьНастройкиВыполненияРегламентныхЗаданий()
	
	Настройки = Новый_НастройкиВыполненияРегламентныхЗаданий();
	Настройки.ИспользоватьБСП = Не ЕстьНеобходимыеМетаданные("РегламентныеЗадания.КонтурМаркировка_ВыполнениеЗаданий");
	
	Если Настройки.ИспользоватьБСП Тогда
		ИнициализироватьМодульРегламентныеДействия();
		СведенияОбОбработке = МодульРегламентныеДействия_СведенияОбОбработке();
		НаименованиеОбработки = СведенияОбОбработке.Наименование;
		Настройки.ВнешняяОбработка = СсылкаНаДополнительнуюОбработку(НаименованиеОбработки);
	КонецЕсли;
	
	КлючКэш = КлючКэшНастройкиВыполненияРегламентныхЗаданий();
	ПараметрыСессии_Поместить(КлючКэш, Настройки);
	
КонецПроцедуры

Функция НастройкиВыполненияРегламентныхЗаданий()
	
	КлючКэш = КлючКэшНастройкиВыполненияРегламентныхЗаданий();
	Настройки = ПараметрыСессии_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Настройки) Тогда
		Возврат Настройки;
	КонецЕсли;
	
	ОпределитьНастройкиВыполненияРегламентныхЗаданий();
	Настройки = ПараметрыСессии_Прочитать(КлючКэш);
	Возврат Настройки;
	
КонецФункции

