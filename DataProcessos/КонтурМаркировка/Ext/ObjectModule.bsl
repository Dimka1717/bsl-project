Функция ПолноеНаименованиеНоменклатуры1С(Номенклатура)
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяСправочника = Номенклатура.Метаданные().ПолноеИмя();
	
	Если ЕстьНеобходимыеМетаданные(ИмяСправочника + ".Реквизиты.НаименованиеПолное") Тогда
		НаименованиеПолное = ЗначениеРеквизитаОбъекта_Марк(Номенклатура, "НаименованиеПолное");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НаименованиеПолное) Тогда
		Результат = СокрЛП(НаименованиеПолное);
	Иначе
		Результат = СокрЛП(Номенклатура);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

