Процедура ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОпераций
	, ТекущаяОперация = Неопределено
	, ДокументУчета = Неопределено
	, ОперацияОснование = Неопределено)
	
	УчитыватьЗавершенныеОперации = Истина;
	Если ТипОпераций = Перечисление_ТипыОпераций().ФормированиеАТК Тогда
		УчитыватьЗавершенныеОперации = Ложь;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаКодов.КлючКода КАК КлючКода
	|ПОМЕСТИТЬ КодыДругихОпераций
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыДругихОпераций
	|		ПО ТаблицаКодов.КлючКода = КодыДругихОпераций.КлючКода
	|			И (КодыДругихОпераций.Операция <> &ТекущаяОперация)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК СтатусыОпераций
	|		ПО (КодыДругихОпераций.Операция = СтатусыОпераций.Операция)
	|			И (СтатусыОпераций.ТипСтатуса = &ОсновнойСтатус)
	|ГДЕ
	|	КодыДругихОпераций.Операция.ТипОперации = &ТипОпераций
	|	И &ДокументУчета
	|	И &ОперацияОснование
	|	И &УчитыватьЗавершенныеОперации
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаКодов.*
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ КодыДругихОпераций КАК КодыДругихОпераций
	|		ПО ТаблицаКодов.КлючКода = КодыДругихОпераций.КлючКода
	|ГДЕ
	|	КодыДругихОпераций.КлючКода ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаКодов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ КодыДругихОпераций
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.*
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	Результат КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Т.КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Результат";
	
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		Условие = "КодыДругихОпераций.Операция.ДокументУчета = &ДокументУчета";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументУчета", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументУчета", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОперацияОснование) Тогда
		Условие = "КодыДругихОпераций.Операция.ОперацияОснование = &ОперацияОснование";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперацияОснование", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперацияОснование", "ИСТИНА");
	КонецЕсли;
	
	Если УчитыватьЗавершенныеОперации Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УчитыватьЗавершенныеОперации", "ИСТИНА");
	Иначе
		Условие = "НЕ СтатусыОпераций.Статус В (&ЗавершенныеСтатусыОпераций)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УчитыватьЗавершенныеОперации", Условие);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТипОпераций", ТипОпераций);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("ОперацияОснование", ОперацияОснование);
	Запрос.УстановитьПараметр("ТекущаяОперация", ТекущаяОперация);
	Запрос.УстановитьПараметр("ОсновнойСтатус", "ОсновнойСтатус");
	Запрос.УстановитьПараметр("ЗавершенныеСтатусыОпераций", ЗавершенныеСтатусыОпераций());
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ТаблицаКодов_ВТ_УдалитьКодыДругихДокументов(МенеджерВТ, ТипДокументов, ТекущийДокумент)
	
