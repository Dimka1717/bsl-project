	Возврат "НастройкиРабочегоСтола";
	
КонецФункции

Функция Новый_НастройкиРабочегоСтола() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Пользователь");
	
	БлокиРабочегоСтола = Новый Структура;
	
	// Документы учета
