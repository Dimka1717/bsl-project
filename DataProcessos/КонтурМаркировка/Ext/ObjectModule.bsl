// Возвращает виды документов, из которых можно выбрать документ с кодами
//
// Параметры:
//  ДокументУчета - СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ учета;
// 
// Возвращаемое значение:
//  Массив - содержит структуры см. Новый_ОписаниеВидаДокументаДляВыбора();
//
Функция ДокументУчета_ВидыДокументовДляПодбораКодов(ДокументУчета) Экспорт
	
	СтандартнаяОбработка = Истина;
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("Документ1С", ДокументУчета_Документ1С(ДокументУчета));
	ПараметрыПМ.Вставить("ДокументУчета", ДокументУчета);
	ПараметрыПМ.Вставить("ВидыДокументовДляВыбора", Новый Массив);
	ПМ_ОбработатьСобытие_ПриЗаполненииВидовДокументовДляЗагрузкиКодов(ПараметрыПМ, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		Результат = ВсеВидыДокументовДляВыбора();
	Иначе
		Результат = ПараметрыПМ.ВидыДокументовДляВыбора;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

