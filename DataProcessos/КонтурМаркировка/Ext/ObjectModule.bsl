// Проверяет товар на принадлежность к 3 волне легпрома
//
// Параметры:
//  Товар - СправочникСсылка.КонтурМаркировка_Товары - товар маркировки;
// 
// Возвращаемое значение:
//  Булево - Истина, если это легпром 3 волны
//
Функция ЭтоТоварЛегпромаППРФ883(Товар)
	
	Возврат
	Товар.ВидПродукции = Перечисление_ВидыПродукции().Легпром
	И (ЭтоТНВЭДЛегпромППРФ883(Товар.КодТНВЭД)
	Или ЭтоОКПД2ЛегпромППРФ883(Товар_Прочитать(Товар).ДопРеквизиты.ОКПД2));
	
КонецФункции

