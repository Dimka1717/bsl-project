// Возвращает представление номенклатуры 1С для печати
//
// Параметры:
//  Номенклатура   - СправочникСсылка - номенклатура 1С;
//  Характеристика - СправочникСсылка - характеристика номенклатуры 1С;
//  Упаковка       - СправочникСсылка - упаковка номенклатуры 1С;
//  Серия          - СправочникСсылка - серия номенклатуры 1С;
//  КэшРезультатов - Соответствие     - (необязательный) кэш результатов функции;
// 
// Возвращаемое значение:
//  Строка - представление номенклатуры для печати
//
Функция ПредставлениеНоменклатуры1СДляПечати(АналитикаНоменклатуры, КэшРезультатов = Неопределено)
	
	Если КэшРезультатов <> Неопределено Тогда
		КлючКэш = СтрокаИдентификаторовАналитикиНоменклатуры1С(АналитикаНоменклатуры);
		Результат = КэшРезультатов[КлючКэш];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	НаименованиеНоменклатуры = ПолноеНаименованиеНоменклатуры1С(АналитикаНоменклатуры.Номенклатура);
	
	ТекстВСкобках = ПредставлениеНоменклатуры_ТекстВСкобках(
	АналитикаНоменклатуры.Характеристика
	, АналитикаНоменклатуры.Упаковка
	, АналитикаНоменклатуры.Серия
	, Истина);
	
	Если ЗначениеЗаполнено(ТекстВСкобках) Тогда
		Результат = ПараметрыВСтроку("%1 (%2)", НаименованиеНоменклатуры, ТекстВСкобках);
	Иначе
		Результат = НаименованиеНоменклатуры;
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(КлючКэш, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

