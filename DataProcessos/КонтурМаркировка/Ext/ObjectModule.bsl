Процедура ЗаполнитьОписаниеОперацииДляСовместимостиПМ(ОписаниеОперации)
	
	ВерсияПМ = ПМ_ВерсияОбработки();
	Если Не ЗначениеЗаполнено(ВерсияПМ) Тогда
		Возврат;
	КонецЕсли;
	
	Если СравнитьВерсии(ВерсияПМ, "3.0") < 0 Тогда
		
		ОписаниеОперации.Вставить("ИсходныеТовары", ОписаниеОперации.Товары);
		ОписаниеОперации.Вставить("Товары", Новый Массив);
		
		Для Каждого Стр Из ОписаниеОперации.ИсходныеТовары Цикл
			
			СтрПМ = Новый_Операция_СтрокаТовары_2_19();
			ЗаполнитьЗначенияСвойств(СтрПМ, Стр);
			ЗаполнитьЗначенияСвойств(СтрПМ.ДопРеквизиты, Стр);
			
			СтрПМ.КоличествоКодов = Стр.КоличествоУпаковок;
			СтрПМ.КлючСтроки = Строка(Стр.КлючСтрокиОперации);
			СтрПМ.КлючСтрокиТоваров = Строка(Стр.КлючСтрокиДокумента);
			СтрПМ.КлючНоменклатуры1С = АналитикаНоменклатуры1С(Стр.КлючНоменклатуры1С);
			СтрПМ.ДопРеквизиты.КоличествоКодовВложенногоТовара = Стр.КоличествоУпаковокВложенногоТовара;
			
			ОписаниеОперации.Товары.Добавить(СтрПМ);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВосстановитьОписаниеОперацииПослеВызоваПМ(ОписаниеОперации)
	
	Если ОписаниеОперации.Свойство("ИсходныеТовары") Тогда
		
		ИсходныеТовары = ОписаниеОперации.ИсходныеТовары;
		ТоварыПМ = ОписаниеОперации.Товары;
		
		ОписаниеОперации.Удалить("ИсходныеТовары");
		ОписаниеОперации.Вставить("Товары", Новый_Операция_Товары());
		
		Для Каждого СтрПМ Из ТоварыПМ Цикл
			
			Стр = ОписаниеОперации.Товары.Добавить();
			Стр.КлючСтрокиОперации = Новый УникальныйИдентификатор(СтрПМ.КлючСтроки);
			
			Если ЗначениеЗаполнено(Стр.КлючСтрокиОперации) Тогда
				ИсходнаяСтрока = ИсходныеТовары.Найти(Стр.КлючСтрокиОперации, "КлючСтрокиОперации");
				Если ИсходнаяСтрока <> Неопределено Тогда
					ЗаполнитьЗначенияСвойств(Стр, ИсходнаяСтрока);
				КонецЕсли;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(Стр, СтрПМ);
			ЗаполнитьЗначенияСвойств(Стр, СтрПМ.ДопРеквизиты);
			
			Стр.КоличествоУпаковок = СтрПМ.КоличествоКодов;
			Стр.ДатаСрокаГодности = СтрПМ.ДопРеквизиты.СрокГодности;
			Стр.КоличествоУпаковокВложенногоТовара = СтрПМ.ДопРеквизиты.КоличествоКодовВложенногоТовара;
			Стр.КлючСтрокиДокумента = Новый УникальныйИдентификатор(СтрПМ.КлючСтрокиТоваров);
			Стр.КлючНоменклатуры1С = КлючНоменклатуры1С_Подобрать(СтрПМ.КлючНоменклатуры1С);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОписаниеДокументаДляСовместимостиПМ(ОписаниеДокумента)
	
	ВерсияПМ = ПМ_ВерсияОбработки();
	Если Не ЗначениеЗаполнено(ВерсияПМ) Тогда
		Возврат;
	КонецЕсли;
	
	Если СравнитьВерсии(ВерсияПМ, "3.0") < 0 Тогда
		
		ОписаниеДокумента.Вставить("ДокументОснование", ОписаниеДокумента.ДопРеквизиты.ДокументОснование);
		ОписаниеДокумента.ДопРеквизиты.Удалить("ДокументОснование");
		
		ТоварыДокумента = ОписаниеДокумента.ТоварыДокумента;
		ТоварыМаркировки = ОписаниеДокумента.ТоварыМаркировки;
		
		ОписаниеДокумента.Удалить("ТоварыМаркировки");
		ОписаниеДокумента.Вставить("Товары", Новый Массив);
		ОписаниеДокумента.Вставить("ТоварыДокумента", Новый Массив);
		
		Для Каждого Стр Из ТоварыДокумента Цикл
			НоваяСтрока = Новый_ДокументУчета_СтрокаТоварыДокумента_2_19();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
			НоваяСтрока.Количество1С = Стр.Количество;
			НоваяСтрока.Количество = Стр.КоличествоУпаковок;
			НоваяСтрока.КлючСтрокиТоваров = Строка(Стр.КлючСтрокиДокумента);
			НоваяСтрока.КлючНоменклатуры1С = АналитикаНоменклатуры1С(Стр.КлючНоменклатуры1С);
			ОписаниеДокумента.ТоварыДокумента.Добавить(НоваяСтрока);
		КонецЦикла;
		
		Для Каждого Стр Из ТоварыМаркировки Цикл
			НоваяСтрока = Новый_ДокументУчета_СтрокаТовары_2_19();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
			НоваяСтрока.Количество = Стр.КоличествоУпаковок;
			НоваяСтрока.КлючСтрокиТоваров = Строка(Стр.КлючСтрокиДокумента);
			ОписаниеДокумента.Товары.Добавить(НоваяСтрока);
		КонецЦикла;
		
	КонецЕсли;
	
	Если СравнитьВерсии(ВерсияПМ, "2.18") < 0 Тогда
		ПравилаОтраженияВЭДО = Перечисления.КонтурМаркировка_ПравилаОтраженияВЭДО;
		Для каждого Стр Из ОписаниеДокумента.ТоварыДокумента Цикл
			Стр.Вставить("ОбъемноСортовойУчет", (Стр.ОтражениеВЭДО = ПравилаОтраженияВЭДО.ОСУ));
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВосстановитьОписаниеДокументаПослеВызоваПМ(ОписаниеДокумента)
	
	Если ТипЗнч(ОписаниеДокумента.ТоварыДокумента) = Тип("Массив") Тогда
		
		Товары = ОписаниеДокумента.Товары;
		ТоварыДокумента = ОписаниеДокумента.ТоварыДокумента;
		
		ОписаниеДокумента.Вставить("ТоварыДокумента", Новый_ДокументУчета_ТоварыДокумента());
		ОписаниеДокумента.Вставить("ТоварыМаркировки", Новый_ДокументУчета_ТоварыМаркировки());
		ОписаниеДокумента.Удалить("Товары");
		
		Для Каждого Стр Из ТоварыДокумента Цикл
			НоваяСтрока = ОписаниеДокумента.ТоварыДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
			НоваяСтрока.Количество = Стр.Количество1С;
			НоваяСтрока.КоличествоУпаковок = Стр.Количество;
			НоваяСтрока.КлючСтрокиДокумента = Новый УникальныйИдентификатор(Стр.КлючСтрокиТоваров);
			НоваяСтрока.КлючНоменклатуры1С = КлючНоменклатуры1С_Подобрать(Стр.КлючНоменклатуры1С);
		КонецЦикла;
		
		Для Каждого Стр Из Товары Цикл
			НоваяСтрока = ОписаниеДокумента.ТоварыМаркировки.Добавить();
			НоваяСтрока.Товар = Стр.Товар;
			НоваяСтрока.КоличествоУпаковок = Стр.Количество;
			НоваяСтрока.КлючСтрокиДокумента = Новый УникальныйИдентификатор(Стр.КлючСтрокиТоваров);
		КонецЦикла;
		
	КонецЕсли;
	
	Если ОписаниеДокумента.Свойство("ДокументОснование") Тогда
		ОписаниеДокумента.ДопРеквизиты.Вставить("ДокументОснование", ОписаниеДокумента.ДокументОснование);
		ОписаниеДокумента.Удалить("ДокументОснование");
	КонецЕсли;
	
КонецПроцедуры

Процедура ВосстановитьПараметрыЗагрузкиКодовДляСовместимостиПМ(ПараметрыПМ)
	
	Если ПараметрыПМ.Свойство("ПараметрыЗагрузкиКодов") Тогда
