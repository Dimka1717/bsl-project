Процедура Операция_ПроверитьТоварыМедИзделий_Остатки(ОписаниеОперации, ОшибкиЗаполнения)
	
	ФичаФлаги = Перечисление_ФичаФлаги();
	ВидыПродукции = Перечисление_ВидыПродукции();
	РазрешенППРФ744 = ФичаФлагВключен(ФичаФлаги.ОстаткиМедИзделияППРФ744);
	РазрешенППРФ860 = ФичаФлагВключен(ФичаФлаги.ОстаткиМедИзделияППРФ860);
	
	Если РазрешенППРФ744 И РазрешенППРФ860 Тогда
		ТекстОшибки = НСтр("ru = 'Маркировка остатков доступна только для медицинских перчаток из списка расширения ППРФ №860 от 26.06.2024 и товаров из списка расширения ППРФ №744 от 31.05.2024'");
	ИначеЕсли РазрешенППРФ744 Тогда
		ТекстОшибки = НСтр("ru = 'Маркировка остатков доступна только для товаров из списка расширения ППРФ №744 от 31.05.2024'");
	ИначеЕсли РазрешенППРФ860 Тогда
		ТекстОшибки = НСтр("ru = 'Маркировка остатков доступна только для медицинских перчаток из списка расширения ППРФ №860 от 26.06.2024'");
	Иначе
		ТекстОшибки = НСтр("ru = 'Маркировка остатков медицинских изделий запрещена'");
	КонецЕсли;
	
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		
		Если Стр.Товар.ВидПродукции <> ВидыПродукции.МедицинскиеИзделия Тогда
