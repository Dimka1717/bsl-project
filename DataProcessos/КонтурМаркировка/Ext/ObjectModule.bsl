Функция КодыОпераций_ДобавитьИзТабличногоДокумента(Операция, ПараметрыЗагрузки) Экспорт
	
	Организация = ЗначениеРеквизитаОбъекта_Марк(Операция, "Организация");
	ТаблицаКодов = ПолучитьИзВременногоХранилища(ПараметрыЗагрузки.АдресТаблицыКодов);
	ЗагружатьПолныеКоды = ПараметрыЗагрузки.ЗагружатьПолныеКоды;
	УдалитьСтарыеКоды = ПараметрыЗагрузки.УдалитьСтарыеКоды;
	
	Если ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация, Ложь) Тогда
		
		КодыОпераций_ДобавитьНовыеКоды(ТаблицаКодов, Операция, УдалитьСтарыеКоды);
		
	Иначе
		
		ДанныеРедактора = Новый_ДанныеРедактораКодов(ТаблицаКодов);
		ДанныеРедактора.УдалитьСтарыеКоды = УдалитьСтарыеКоды;
		ДанныеРедактора.ЗагружатьПолныеКоды = ЗагружатьПолныеКоды;
		
		РедакторКодов_ЗаписатьФайл(Операция, ДанныеРедактора);
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Функциональность = Перечисление_ФункциональностьМодуля().ЗагрузкаКодовВОперациюИзТабличногоДокумента;
	Метрика_Функциональность_ЗагрузкаКодовВОперацию(Операция, Функциональность);
	
	Возврат Истина;
	
КонецФункции

Процедура КодыОпераций_ДобавитьИзРедактораКодов(Операция) Экспорт
	
	ДанныеРедактора = РедакторКодов_ПолучитьИзФайла(Операция);
	
	ТаблицаКодов = ДанныеРедактора.ТаблицаКодов;
	УдалитьСтарыеКоды = ДанныеРедактора.УдалитьСтарыеКоды;
	ЗагружатьПолныеКоды = ДанныеРедактора.ЗагружатьПолныеКоды;
	
	Если ЗагружатьПолныеКоды Тогда
		Организация = ЗначениеРеквизитаОбъекта_Марк(Операция, "Организация");
		ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация);
	Иначе
		ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	КонецЕсли;
	
	КодыОпераций_ДобавитьНовыеКоды(ТаблицаКодов, Операция, УдалитьСтарыеКоды);
	
	РедакторКодов_УдалитьФайл(Операция);
	
КонецПроцедуры

Функция КодыОпераций_ДобавитьНовыеКоды(ТаблицаКодов, Операция, УдалитьСтарыеКоды)
	
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	
	ТаблицаКодов_ДополнитьИнформациейИБ(ТаблицаКодов);
	
	Если Не ЭтоТрансформацияАТК(ОписаниеОперации.ТипОперации)
		И Не ЭтоТрансформацияАгрегата(ОписаниеОперации.ТипОперации) Тогда
		ТаблицаКодов_УточнитьДанныеАгрегатов(ТаблицаКодов);
		КодыМаркировки_РасформироватьАгрегаты(ТаблицаЗначений_ВыгрузитьКолонку(ТаблицаКодов,"КодАгрегата", Истина));
	КонецЕсли;
	
	ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
	
	Если УдалитьСтарыеКоды Тогда
		ОписаниеОперации.Товары.Очистить();
	КонецЕсли;
	
	Операция_ЗаполнитьТоварыИзТаблицыКодов(ОписаниеОперации, ТаблицаКодов);
	Операция_ЗаполнитьВидПродукции(ОписаниеОперации, ТаблицаКодов);
	Операция_ЗаполнитьАльтернативныеСрокиГодности(ОписаниеОперации);
	Операция_Записать(ОписаниеОперации);
	
	КодыОпераций_Записать(ТаблицаКодов, Операция, УдалитьСтарыеКоды);
	
	Возврат Истина;
	
КонецФункции

Функция КодыОпераций_МаксимальноеКоличествоКодовВКИТУ(Операция) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	МАКСИМУМ(Т.КоличествоКодов) КАК КоличествоКодов
	|ИЗ
	|	(ВЫБРАТЬ
	|		СвязиКлючейКодов.КлючАгрегата КАК КлючАгрегата,
	|		КОЛИЧЕСТВО(*) КАК КоличествоКодов
	|	ИЗ
	|		РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|			ПО КодыОпераций.КлючКода = СвязиКлючейКодов.КлючАгрегата
	|	ГДЕ
	|		КодыОпераций.Операция = &Операция
	|	
	|	СГРУППИРОВАТЬ ПО
	|		СвязиКлючейКодов.КлючАгрегата) КАК Т");
	
	Запрос.УстановитьПараметр("Операция", Операция);
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "КоличествоКодов", 0);
	
КонецФункции

Процедура Операция_ЗаполнитьТоварыИзТаблицыКодов(ОписаниеОперации, ТаблицаКодов)
	
	ДопустимоеКоличествоКодовВСтроке = Операция_ДопустимоеКоличествоКодов(ОписаниеОперации.ТипОперации);
	Для Каждого СтрКода Из ТаблицаКодов Цикл
		
		СтрТовара = Неопределено;
		Для каждого Стр Из ОписаниеОперации.Товары Цикл
			
			Если ЗначениеЗаполнено(ДопустимоеКоличествоКодовВСтроке)
				И Стр.КоличествоУпаковок = ДопустимоеКоличествоКодовВСтроке Тогда
				Продолжить;
			КонецЕсли;
			
			Если Стр.Товар = СтрКода.Товар
				И Стр.КлючНоменклатуры1С = СтрКода.КлючНоменклатуры1С Тогда
				СтрТовара = Стр;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если СтрТовара = Неопределено Тогда
			СтрТовара = ОписаниеОперации.Товары.Добавить();
			СтрТовара.КлючСтрокиОперации = Новый УникальныйИдентификатор;
			СтрТовара.КлючНоменклатуры1С = СтрКода.КлючНоменклатуры1С;
			СтрТовара.Товар = СтрКода.Товар;
		КонецЕсли;
		
		СтрТовара.Количество = СтрТовара.Количество + СтрКода.Количество;
		СтрТовара.КоличествоУпаковок = СтрТовара.КоличествоУпаковок + 1;
		
		СтрКода.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
		
	КонецЦикла;

КонецПроцедуры

Процедура КодыОпераций_УдалитьКоды(Операция, КлючиКодов) Экспорт
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	Для каждого КлючКода Из КлючиКодов Цикл
		ТаблицаКодов.Добавить().КлючКода = КлючКода;
	КонецЦикла;
	ТаблицаКодов.ЗаполнитьЗначения(Истина, "УдалитьИзОперации");
	
	КодыОпераций_Записать(ТаблицаКодов, Операция, Ложь);
	
КонецПроцедуры

