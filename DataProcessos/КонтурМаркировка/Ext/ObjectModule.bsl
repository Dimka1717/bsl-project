//
Процедура УдалитьПризнакНоменклатурыНеПодлежитМаркировке(КоллекцияНоменклатуры) Экспорт
	
	УстановитьПризнакНоменклатурыНеПодлежитМаркировке(КоллекцияНоменклатуры, Ложь);
	
КонецПроцедуры

// Находит подходящие товары по аналитике номенклатуры
//
// Параметры:
//  АналитикаНоменклатуры1С - СправочникСсылка.КонтурМаркировка_КлючиНоменклатуры1С, Структура, СтрокаТаблицыЗначений - содержит поля:
//   * Номенклатура - СправочникСсылка - номенклатура;
//   * Характеристика - СправочникСсылка - характеристика;
//   * Упаковка - СправочникСсылка - упаковка;
//   * Серия - СправочникСсылка - серия;
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
//  КэшРезультатов - Соответствие - (необязательный) кэш результатов функции;
// 
// Возвращаемое значение:
//  Массив - содержит СправочникСсылка.КонтурМаркировка_Товары
//
Функция ПодходящиеТоварыМаркировки(АналитикаНоменклатуры1С, Организация, КэшРезультатов = Неопределено) Экспорт
	
	АналитикаНоменклатурыБезСерии = Новый_АналитикаНоменклатуры1С();
	Если ТипЗнч(АналитикаНоменклатуры1С) = Тип("СправочникСсылка.КонтурМаркировка_КлючиНоменклатуры1С") Тогда
		ЗаполнитьЗначенияСвойств(АналитикаНоменклатурыБезСерии, АналитикаНоменклатуры1С(АналитикаНоменклатуры1С), , "Серия");
	Иначе
		ЗаполнитьЗначенияСвойств(АналитикаНоменклатурыБезСерии, АналитикаНоменклатуры1С, , "Серия");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(АналитикаНоменклатурыБезСерии.Номенклатура) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	КлючНоменклатуры1С = КлючНоменклатуры1С_Подобрать(АналитикаНоменклатурыБезСерии);
	
	Если КэшРезультатов <> Неопределено Тогда
		Результат = КэшРезультатов[КлючНоменклатуры1С];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Результат = Товары_НайтиПоКлючуНоменклатуры1С(КлючНоменклатуры1С, Организация);
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = Товары_НайтиПоШтрихкодуИлиАртикулуНоменклатуры1С(КлючНоменклатуры1С, Организация);
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(КлючНоменклатуры1С, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Находит всю номенклатуру 1С связанную с товаром маркировки
//
// Параметры:
//  Товар - СправочникСсылка.КонтурМаркировка_Товары - товар маркировки;
// 
// Возвращаемое значение:
//  ТаблицаЗначений - содержит колонки:
