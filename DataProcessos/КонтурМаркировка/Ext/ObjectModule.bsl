Функция ДокументУчета_ЕстьТоварыДляОтчетаОНанесении(ДокументУчета) Экспорт
	
	Результат = Ложь;
	
	ВидыПродукцииДляОтчетаОНанесении = ДопустимыеВидыПродукцииДляОтчетаОНанесении();
	
	Для Каждого Стр Из ДокументУчета.ТоварыМаркировки Цикл
		Если МассивСодержитЗначение(ВидыПродукцииДляОтчетаОНанесении, Стр.Товар.ВидПродукции) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_ЕстьТоварыДляОтраженияВЭДО(ДокументУчета) Экспорт
	
	ПравилаОтраженияВЭДО = Перечисление_ПравилаОтраженияВЭДО();
	
	Для Каждого Стр Из ДокументУчета.ТоварыДокумента Цикл
		Если Стр.НеПодлежитМаркировке = Ложь
			И Стр.ОтражениеВЭДО <> ПравилаОтраженияВЭДО.НеОтражать Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ДокументУчета_ЕстьРолиДляСведенийОМаркировке(ДокументУчета) Экспорт
	
	РолиДокументов = Перечисление_РолиДокументовУчета();
	
	ПодходящиеРоли = Новый Массив;
	ПодходящиеРоли.Добавить(РолиДокументов.Отгрузка);
	ПодходящиеРоли.Добавить(РолиДокументов.КорректировкаОтгрузки);
	ПодходящиеРоли.Добавить(РолиДокументов.ВнутреннееПеремещение);
	
	Результат = Ложь;
	Для Каждого Роль Из ПодходящиеРоли Цикл
		Если ДокументУчета_ДоступнаРоль(ДокументУчета, Роль) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументыУчета_ПереданыСведенияОМаркировке(ДокументыУчета)
	
