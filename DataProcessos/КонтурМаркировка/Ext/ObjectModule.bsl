		ОписаниеОшибки.ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, Стр.ПервичныйДокумент);
		ОшибкиЗаполнения.Добавить(ОписаниеОшибки);
	КонецЦикла;
	
	Для Каждого Стр Из ОшибкиМаркировки.НайтиСтроки(Новый Структура("ТипОшибки", ТипыОшибок.ТоварыНеСопоставлены)) Цикл
