Процедура Замер_МаксКодовВДокументе_Поместить(КоличествоКодов)
	
	КлючПараметров = "МаксКодовВДокументе";
	ТекКоличество = ПараметрыСессии_Прочитать(КлючПараметров);
	
	Если Не ЗначениеЗаполнено(ТекКоличество)
		Или КоличествоКодов > ТекКоличество Тогда
		ПараметрыСессии_Поместить(КлючПараметров, КоличествоКодов);
	КонецЕсли;
	
КонецПроцедуры

Функция Замер_МаксКодовВДокументе_Завершить()
	
	КлючПараметров = "МаксКодовВДокументе";
	Результат = ПараметрыСессии_Прочитать(КлючПараметров);
	ПараметрыСессии_Поместить(КлючПараметров, 0);
	
	Возврат Результат;
	
КонецФункции

Функция Замер_МаксКодовВОперации_Завершить()
	
	КлючПараметров = "МаксКодовВОперации";
	Результат = ПараметрыСессии_Прочитать(КлючПараметров);
	ПараметрыСессии_Поместить(КлючПараметров, 0);
	
	Возврат Результат;
	
КонецФункции

