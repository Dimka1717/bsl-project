Функция ВидУпаковкиПоОбщемуТипуУпаковки(ТипУпаковки)
	
	КлючКэш = "ВидУпаковкиПоТипуУпаковкиКодаМаркировки: " + ТипУпаковки;
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидыУпаковок = Перечисления.КонтурМаркировка_ВидыУпаковок;
	ТипыУпаковок = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок;
	
	СоответствиеВидов = Новый Соответствие;
	СоответствиеВидов.Вставить(ТипыУпаковок.ТранспортнаяУпаковка, ВидыУпаковок.Логистическая);
	СоответствиеВидов.Вставить(ТипыУпаковок.ГрупповаяУпаковка, ВидыУпаковок.Групповая);
	СоответствиеВидов.Вставить(ТипыУпаковок.ЕдиницаТовара, ВидыУпаковок.Потребительская);
	СоответствиеВидов.Вставить(ТипыУпаковок.Комплект, ВидыУпаковок.Потребительская);
	СоответствиеВидов.Вставить(ТипыУпаковок.Набор, ВидыУпаковок.Потребительская);
	
	Результат = СоответствиеВидов[ТипУпаковки];
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		ШаблонОшибки = НСтр("ru = 'Не удалось определить вид упаковки по типу упаковки кода маркировки: %1'");
		ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, ТипУпаковки);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ТипЭтикеткиПоОбщемуТипуУпаковки(ОбщийТипУпаковки) Экспорт
	
	КлючКэш = "ТипЭтикеткиПоОбщемуТипуУпаковки: " + ОбщийТипУпаковки;
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипыЭтикеток = Перечисления.КонтурМаркировка_ТипыЭтикеток;
	ТипыУпаковок = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок;
	
	СоответствиеТипов = Новый Соответствие;
	СоответствиеТипов.Вставить(ТипыУпаковок.ТранспортнаяУпаковка, ТипыЭтикеток.Транспортная);
	СоответствиеТипов.Вставить(ТипыУпаковок.ГрупповаяУпаковка, ТипыЭтикеток.Групповая);
	СоответствиеТипов.Вставить(ТипыУпаковок.ЕдиницаТовара, ТипыЭтикеток.Товарная);
	СоответствиеТипов.Вставить(ТипыУпаковок.Комплект, ТипыЭтикеток.Товарная);
	СоответствиеТипов.Вставить(ТипыУпаковок.Набор, ТипыЭтикеток.Товарная);
	
	Результат = СоответствиеТипов[ОбщийТипУпаковки];
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		ШаблонОшибки = НСтр("ru = 'Не удалось определить тип этикетки по общему типу упаковки: %1'");
		ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, ОбщийТипУпаковки);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ШаблонЭтикеткиПоТипуЭтикетки(ШаблоныЭтикеток, ТипЭтикетки)
	
	ТипыЭтикеток = Перечисления.КонтурМаркировка_ТипыЭтикеток;
	
	Если ТипЭтикетки = ТипыЭтикеток.Товарная Тогда
		Результат = ШаблоныЭтикеток.ШаблонТоварнойЭтикетки;
	ИначеЕсли ТипЭтикетки = ТипыЭтикеток.Групповая Тогда
		Результат = ШаблоныЭтикеток.ШаблонГрупповойЭтикетки;
	ИначеЕсли ТипЭтикетки = ТипыЭтикеток.Транспортная Тогда
		Результат = ШаблоныЭтикеток.ШаблонТранспортнойЭтикетки;
	Иначе
		ШаблонОшибки = НСтр("ru = 'Не удалось определить шаблон этикетки по типу этикетки: %1'");
		ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, ТипЭтикетки);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДопустимыеПричиныВозвратаВОборот(ВидПродукции) Экспорт
	
	ПричиныВозврата = Перечисление_ПричиныВозвратаВОборот();
	
	Результат = Новый Массив;
	
	Результат.Добавить(ПричиныВозврата.БезПоследующейРеализации);
	Результат.Добавить(ПричиныВозврата.ОтКонечногоПокупателя);
	
	Если ВидПродукции <> Перечисления.КонтурМаркировка_ВидыПродукции.Пиво Тогда
		Результат.Добавить(ПричиныВозврата.ДистанционныйСпособПродажи);
		Результат.Добавить(ПричиныВозврата.Гостайна);
	КонецЕсли;
	
	Если ВидПродукцииДопускаетПричинуВозвратаРозничнаяРеализация(ВидПродукции) Тогда
		Результат.Добавить(ПричиныВозврата.РозничнаяРеализация);
	КонецЕсли;
	
	Если ВидПродукцииДопускаетПричинуВозвратаВендинг(ВидПродукции) Тогда
		Результат.Добавить(ПричиныВозврата.Вендинг);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВидПродукцииДопускаетПричинуВозвратаРозничнаяРеализация(ВидПродукции)
	
	НеподходящиеВидыПродукции = Новый Массив;
	НеподходящиеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Молоко);
	НеподходящиеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Морепродукты);
	НеподходящиеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Пиво);
	НеподходящиеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.БезалкогольныеНапитки);
	НеподходящиеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Вода);
	
	Результат = (НеподходящиеВидыПродукции.Найти(ВидПродукции) = Неопределено);
	
	Возврат Результат;
	
КонецФункции

Функция ВидПродукцииДопускаетПричинуВозвратаВендинг(ВидПродукции)
	
	ПодходящиеВидыПродукции = Новый Массив;
	ПодходящиеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Антисептики);
	ПодходящиеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Бады);
	ПодходящиеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.МедицинскиеИзделия);
	ПодходящиеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Молоко);
	ПодходящиеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Морепродукты);
	ПодходящиеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.БезалкогольныеНапитки);
	ПодходящиеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Вода);
	
	Результат = (ПодходящиеВидыПродукции.Найти(ВидПродукции) <> Неопределено);
	
	Возврат Результат;
	
