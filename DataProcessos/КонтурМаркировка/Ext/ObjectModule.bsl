// Возвращает общий модуль по его имени
//
// Параметры:
//  ИмяОбщегоМодуля - Строка - имя общего модуля
//
// Возвращаемое значение:
//  ОбщийМодуль - общий модуль
//
Функция ОбщийМодуль(ИмяОбщегоМодуля)
	
	КлючКэш = "ОбщийМодуль: " + ИмяОбщегоМодуля;
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Метаданные.ОбщиеМодули.Найти(ИмяОбщегоМодуля) = Неопределено Тогда
		ВызватьИсключение ПараметрыВСтроку(
		НСтр("ru = 'Общий модуль ""%1"" не найден.'"), ИмяОбщегоМодуля);
	КонецЕсли;
	
	Результат = Вычислить(ИмяОбщегоМодуля);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаЗначений_НайтиЗначение(ТаблицаЗначений, ПараметрыОтбора, ИмяКолонки, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	НайденныеСтроки = ТаблицаЗначений.НайтиСтроки(ПараметрыОтбора);
	
	Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
		Результат = НайденныеСтроки[0][ИмяКолонки];
	Иначе
		Результат = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

