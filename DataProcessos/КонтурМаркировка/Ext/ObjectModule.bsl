Процедура ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ, ИмяТаблицыКодов = "ТаблицаКодов")
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.*
	|ПОМЕСТИТЬ СтараяТаблицаКодов
	|ИЗ
	|	ТаблицаКодов КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Т.КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаКодов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СвязиКлючей.КлючАгрегата,
	|	ТаблицаКодов.*,
	|	ИнформацияОКодах.*,
	|	СтатусыКодов.*,
	|	КодыМаркировки.*
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	СтараяТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ТаблицаКодов.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючей
	|		ПО ТаблицаКодов.КлючКода = СвязиКлючей.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (СвязиКлючей.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|		ПО (СвязиКлючей.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТаблицаКодов.КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ СтараяТаблицаКодов";
	
	Если ИмяТаблицыКодов <> "ТаблицаКодов" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаКодов", ИмяТаблицыКодов);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ТаблицаКодов_ВТ_ДобавитьКлючиВсехВложенныхКодов(МенеджерВТ)
	
