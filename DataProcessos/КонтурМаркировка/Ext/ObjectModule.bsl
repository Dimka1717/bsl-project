// Возвращает доступные форматы файлов для хранения кодов
// 
// Возвращаемое значение:
//  Структура - содержит свойства:
//   * csv  - текстовый файл с разделителями колонок;
//   * xlsx - таблица Excel;
//
Функция Перечисление_ФорматыФайловСКодами() Экспорт
	
	КлючКэш = "ФорматыФайловСКодами";
	
	Результат = Кэш_Прочитать(КлючКэш);
	
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Новый Структура;
	
	Результат.Вставить("csv", "csv");
	Результат.Вставить("xlsx", "xlsx");
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
