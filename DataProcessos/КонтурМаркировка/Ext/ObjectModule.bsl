Функция Печать_ЗначениеДопПараметра(ДопПараметр, СтрокаЭтикетки, ПараметрыПечати)
	
	// Глобальные переменные
	КэшПараметровЭтикеток = ПараметрыПечати.КэшДопПараметровЭтикеток;
	ПараметрыЭтикетки = СтрокаЭтикетки;
	Формула = ДопПараметр.Формула;
	
	ПараметрыЭтикетки = Новый Структура;
	ПараметрыЭтикетки.Вставить("Номенклатура", СтрокаЭтикетки.Номенклатура);
	ПараметрыЭтикетки.Вставить("Характеристика", СтрокаЭтикетки.Характеристика);
	ПараметрыЭтикетки.Вставить("Упаковка", СтрокаЭтикетки.Упаковка);
	ПараметрыЭтикетки.Вставить("Серия", СтрокаЭтикетки.Серия);
	ПараметрыЭтикетки.Вставить("Товар", СтрокаЭтикетки.Товар);
	ПараметрыЭтикетки.Вставить("Документ1С", ПараметрыПечати.Документ1С);
	ПараметрыЭтикетки.Вставить("Организация1С", ПараметрыПечати.Организация1С);
	
	// Для совместимости с 2.4
	Формула = СтрЗаменить(Формула, "Печать_ЗначениеСвойстваОбъекта", "Печать_ЗначениеДопСвойстваОбъекта");
	
	Попытка
		Результат = Вычислить(Формула);
	Исключение
		
		ПараметрыЭтикетки = Неопределено;
		КэшПараметровЭтикеток = Неопределено;
		
		Ошибка = ИнформацияОбОшибке();
		ДопИнформация = Новый Структура;
		ДопИнформация.Вставить("Имя", ДопПараметр.Имя);
		ДопИнформация.Вставить("Формула", ДопПараметр.Формула);
		Действие = НСтр("ru = 'Расчет доп параметра этикетки'");
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
		
		ТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		ШаблонСообщения = НСтр("ru = 'Не удалось расчитать доп параметр этикетки: %1'");
		ТекстСообщения = ПараметрыВСтроку(ШаблонСообщения, ДопПараметр.Имя);
		СообщениеОбОшибке = СоединитьСтроку(НовыйМассив(ТекстСообщения, ТекстОшибки), Символы.ПС);
		ВызватьИсключение СообщениеОбОшибке;
		
	КонецПопытки;
	
	ПараметрыЭтикетки = Неопределено;
	КэшПараметровЭтикеток = Неопределено;
	
	Возврат Результат;
	
КонецФункции

Функция Печать_ЗначениеРеквизитаОбъекта(Объект, ИмяРеквизита)
	
	Результат = КэшПараметровЭтикеток_Прочитать(Объект, ИмяРеквизита);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ЗначениеРеквизитаОбъекта_Марк(Объект, ИмяРеквизита);
	
	КэшПараметровЭтикеток_Поместить(Объект, ИмяРеквизита, Результат);
	
	Возврат Результат;
	
КонецФункции

