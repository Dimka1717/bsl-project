//  СписокЗначений
//
Функция ОбъектыПодсистемыСоСписками() Экспорт
	
	Результат = Новый СписокЗначений;
	
	Если Не ЕстьНеобходимыеМетаданные("Подсистемы.КонтурМаркировка") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Подсистема = Метаданные.Подсистемы.КонтурМаркировка;
	
	Для каждого Элемент Из Подсистема.Состав Цикл
		
		Если Метаданные.Справочники.Содержит(Элемент)
			Или Метаданные.РегистрыСведений.Содержит(Элемент) Тогда
			ИмяОбъекта = Элемент.ПолноеИмя();
			Результат.Добавить(ИмяОбъекта);
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.СортироватьПоЗначению();
	
	Возврат Результат;
	
КонецФункции

Функция МакетОбработки(ИмяМакета) Экспорт
	
	Макеты = ЭтотОбъект.Метаданные().Макеты;
	
	Если Макеты.Найти(ИмяМакета) = Неопределено Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'В составе обработки не найден макет ""%1""'"), ИмяМакета);
	КонецЕсли;
	
	Результат = ЭтотОбъект.ПолучитьМакет(ИмяМакета);
	
	Возврат Результат;
	
КонецФункции

Функция МакетСправочника(ИмяСправочника, ИмяМакета)
	
	СтрокаМетаданных = ПараметрыВСтроку("Справочники.%1", ИмяСправочника);
	Если Не ЕстьНеобходимыеМетаданные(СтрокаМетаданных) Тогда
		ТекстОшибки = НСтр("ru = 'Не найден справочник %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, ИмяСправочника);
	КонецЕсли;
	
	Макеты = Метаданные.Справочники[ИмяСправочника].Макеты;
	
	Если Макеты.Найти(ИмяМакета) = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'В справочнике ""%1"" не найден макет ""%2""'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, ИмяСправочника, ИмяМакета);
	КонецЕсли;
	
	Результат = Справочники[ИмяСправочника].ПолучитьМакет(ИмяМакета);
	
	Возврат Результат;
	
КонецФункции

