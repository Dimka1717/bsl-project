КонецФункции

// Проверяет, что все операции в списке известны
// перед удалением и перезаполнением документа учета
//
// Параметры:
//  СписокОпераций - ТаблицаЗначений - см. ДокументУчета_СписокОпераций()
//
Процедура Операции_ПроверитьЧтоВсеИзвестны(СписокОпераций)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	ИзвестныеТипы = Новый Массив;
	ИзвестныеТипы.Добавить(ТипыОпераций.ЗаказКодов);
	ИзвестныеТипы.Добавить(ТипыОпераций.ВводВОборот);
	ИзвестныеТипы.Добавить(ТипыОпераций.АгрегацияКодов);
	ИзвестныеТипы.Добавить(ТипыОпераций.РегистрацияАгрегатов);
	ИзвестныеТипы.Добавить(ТипыОпераций.РасформированиеАгрегатов);
	ИзвестныеТипы.Добавить(ТипыОпераций.НаполнениеАгрегатовНаТСД);
	ИзвестныеТипы.Добавить(ТипыОпераций.ПечатьКодов);
	ИзвестныеТипы.Добавить(ТипыОпераций.ОтчетОНанесенииНаТСД);
	ИзвестныеТипы.Добавить(ТипыОпераций.ОтчетОНанесении);
	ИзвестныеТипы.Добавить(ТипыОпераций.СверкаНаПриемке);
	ИзвестныеТипы.Добавить(ТипыОпераций.ПодборКодовНаТСД);
	ИзвестныеТипы.Добавить(ТипыОпераций.ПодборТоваровИКодовНаТСД);
	ИзвестныеТипы.Добавить(ТипыОпераций.СообщениеОбОтгрузке);
	ИзвестныеТипы.Добавить(ТипыОпераций.ВыводИзОборота);
	ИзвестныеТипы.Добавить(ТипыОпераций.СвободныйОстаток);
	ИзвестныеТипы.Добавить(ТипыОпераций.РезервДокументаУчета);
	ИзвестныеТипы.Добавить(ТипыОпераций.ОбновлениеСтатусовКодов);
	ИзвестныеТипы.Добавить(ТипыОпераций.РегистрацияОдногоАгрегатаВГИС);
	ИзвестныеТипы.Добавить(ТипыОпераций.РасформированиеАгрегатаВГИС);
	ИзвестныеТипы.Добавить(ТипыОпераций.НаполнениеОдногоАгрегатаНаТСД);
	ИзвестныеТипы.Добавить(ТипыОпераций.РегистрацияСтрокиОтчетаОНанесении);
	ИзвестныеТипы.Добавить(ТипыОпераций.РегистрацияСтрокиВводаВОборот);
	ИзвестныеТипы.Добавить(ТипыОпераций.ОтчетОВыбытииНаТСД);
	ИзвестныеТипы.Добавить(ТипыОпераций.ОтчетОВыбытии);
