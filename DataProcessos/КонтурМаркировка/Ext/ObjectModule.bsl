// Формирует массив структур из таблицы значений
// свойства структур соответствуют колонкам таблицы значений
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - таблица, из которой нужно сформировать массив структур
// 
// Возвращаемое значение:
//  Массив - содержит структуры
//
Функция МассивСтруктурИзТаблицыЗначений(ТаблицаЗначений) Экспорт
	
	Результат = Новый Массив;
	
	Если Не ЗначениеЗаполнено(ТаблицаЗначений) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИменаКолонок = "";
	Разделитель = "";
	Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
		ИменаКолонок = ИменаКолонок + Разделитель + Колонка.Имя;
		Разделитель = ", ";
	КонецЦикла;
	
	Для Каждого Стр Из ТаблицаЗначений Цикл
		
		НовыйЭлемент = Новый Структура(ИменаКолонок);
		ЗаполнитьЗначенияСвойств(НовыйЭлемент, Стр);
		
		Для Каждого Эл Из НовыйЭлемент Цикл
			Если ТипЗнч(Эл.Значение) = Тип("ТаблицаЗначений") Тогда
				НовыйЭлемент[Эл.Ключ] = МассивСтруктурИзТаблицыЗначений(Эл.Значение);
			КонецЕсли;
		КонецЦикла;
		
		Результат.Добавить(НовыйЭлемент);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Формирует таблицу значений из массива структур
// колонки таблицы значений соответствуют свойствам структур
//
// Параметры:
//  МассивСтруктур - Массив - содержит структуры
// 
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция ТаблицаЗначенийИзМассиваСтруктур(МассивСтруктур) Экспорт
	
	Результат = Новый ТаблицаЗначений;
	
	Если Не ЗначениеЗаполнено(МассивСтруктур) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипыКолонок = Новый Соответствие;
	Для Каждого Структура Из МассивСтруктур Цикл
		Для Каждого Эл Из Структура Цикл
			ИмяКолонки = Эл.Ключ;
			ТипКолонки = ТипЗнч(Эл.Значение);
			Если ТипыКолонок[ИмяКолонки] = Неопределено Тогда
				ТипыКолонок.Вставить(ИмяКолонки, Новый Массив);
			КонецЕсли;
			Если ТипыКолонок[ИмяКолонки].Найти(ТипКолонки) = Неопределено Тогда
				ТипыКолонок[ИмяКолонки].Добавить(ТипКолонки);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// Формируем колонки сохраняя их порядок по первой структуре
	Для Каждого Эл Из МассивСтруктур[0] Цикл
		ИмяКолонки = Эл.Ключ;
		ТипКолонки = Новый ОписаниеТипов(ТипыКолонок[ИмяКолонки]);
		Результат.Колонки.Добавить(ИмяКолонки, ТипКолонки);
	КонецЦикла;
	
	// Добавляем колонки, которых небыло в первой структуре
	Для Каждого Эл Из ТипыКолонок Цикл
		ИмяКолонки = Эл.Ключ;
		Если Результат.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
			ТипКолонки = Новый ОписаниеТипов(Эл.Значение);
			Результат.Колонки.Добавить(ИмяКолонки, ТипКолонки);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Структура Из МассивСтруктур Цикл
		Стр = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Структура);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

