Процедура ПМ_ОбработатьСобытие_ПриИзмененииОперации(ОписаниеОперации, ТаблицаКодов) Экспорт
	
	ВерсияПМ = ПМ_ВерсияОбработки();
	
	Если ЗначениеЗаполнено(ВерсияПМ) И СравнитьВерсии(ВерсияПМ, "3.6.4") < 0 Тогда
		ОписаниеОперацииДляПМ = СкопироватьОбъект(ОписаниеОперации);
		ПМ_ОбработатьСобытие_ПриЗаполненииОперации(ОписаниеОперацииДляПМ, ТаблицаКодов);
		ОписаниеОперации.Товары = ОписаниеОперацииДляПМ.Товары;
		Возврат;
	КонецЕсли;
	
	ЗаполнитьОписаниеОперацииДляСовместимостиПМ(ОписаниеОперации);
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Документ1С = ДокументУчета_Документ1С(ДокументУчета);
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("ОписаниеОперации", ОписаниеОперации);
	ПараметрыПМ.Вставить("ТаблицаКодов", ТаблицаКодов);
	ПараметрыПМ.Вставить("ДокументУчета", ДокументУчета);
	ПараметрыПМ.Вставить("Документ1С", Документ1С);
	ПМ_ОбработатьСобытие("ПриИзмененииОперации", ПараметрыПМ);
	
	ТаблицаКодов = ПараметрыПМ.ТаблицаКодов;
	
	ВосстановитьОписаниеОперацииПослеВызоваПМ(ОписаниеОперации);
	
