// Формирует этикетки по указанным шаблонам
//
// Параметры:
//  КодыМаркировки - Массив, Строка - нормализованные коды маркировки;
//  ШаблоныЭтикеток - Структура - см. функцию ШаблоныДляПечатиЭтикеток();
//  Документ1С - ДокументСсылка - (необязательный) документ 1С связанный с кодами;
//  ПечататьВложенныеКоды - Булево - (необязательный) Ложь, если этикетки для вложенных кодов печатать не нужно;
//  ДопПараметрыПечати - Структура - (необязательный) содержит свойства:
//   * ДопПараметрПечати1 - Произвольный - дополнительный параметр этикетки №1;
//   * ДопПараметрПечати2 - Произвольный - дополнительный параметр этикетки №2;
//   * ДопПараметрПечати3 - Произвольный - дополнительный параметр этикетки №3;
// 
// Возвращаемое значение:
//  ТабличныйДокумент - содержит сформированные этикетки
//
Функция СформироватьЭтикетки(КодыМаркировки
	, ШаблоныЭтикеток
	, Документ1С = Неопределено
	, ПечататьВложенныеКоды = Истина
	, ДопПараметрыПечати = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(КодыМаркировки) Тогда
		ВызватьИсключение НСтр("ru = 'Не удалось сформировать этикетки, не указаны коды маркировки'");
	КонецЕсли;
	
	ДокументУчета = Неопределено;
	Если ЗначениеЗаполнено(Документ1С) Тогда
		ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С);
	КонецЕсли;
	
	ТаблицаКодов = ТаблицаКодов_ЗагрузитьКодыМаркировки(КодыМаркировки);
	ТаблицаКодов_ЗаполнитьКлючиКодов(ТаблицаКодов);
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		ТаблицаКодов_ЗаполнитьКлючиСтрокДокумента(ТаблицаКодов, ДокументУчета);
	КонецЕсли;
	
	ПараметрыПечати = Этикетки_ПараметрыПечатиЭтикетокПоДокументу(ДокументУчета, Документ1С);
	ПараметрыПечати.ТаблицаКодов = ТаблицаКодов;
	ПараметрыПечати.ПечататьВложенныеКоды = ПечататьВложенныеКоды;
	ПараметрыПечати.ШаблоныЭтикеток.ШаблонТоварнойЭтикетки = ШаблоныЭтикеток.ШаблонТоварнойЭтикетки;
	ПараметрыПечати.ШаблоныЭтикеток.ШаблонТранспортнойЭтикетки = ШаблоныЭтикеток.ШаблонТранспортнойЭтикетки;
	ПараметрыПечати.ШаблоныЭтикеток.ШаблонГрупповойЭтикетки = ШаблоныЭтикеток.ШаблонГрупповойЭтикетки;
	
	Если ЗначениеЗаполнено(ДопПараметрыПечати) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыПечати, ДопПараметрыПечати);
	КонецЕсли;
	
	Этикетки_ЗаполнитьПараметрыПечатиПоУмолчанию(ПараметрыПечати);
	
	Этикетки_СформироватьТаблицуЭтикеток(ПараметрыПечати);
	Этикетки_СформироватьНастройкиШаблонов(ПараметрыПечати);
	Этикетки_ЗаполнитьПараметрыНоменклатуры1С(ПараметрыПечати);
	Этикетки_СформироватьКартинкиШтрихкодов(ПараметрыПечати);
	Этикетки_ЗаполнитьТабличныйДокумент(ПараметрыПечати);
	Этикетки_ПометитьНапечатанныеКоды(ПараметрыПечати);
	
	Возврат ПараметрыПечати.ТабличныйДокумент;
	
КонецФункции

// Возвращает информацию о количестве кодов на свободных остатках
//
// Параметры:
//  ПараметрыОтбора - Структура - (необязательный) содержит поля:
