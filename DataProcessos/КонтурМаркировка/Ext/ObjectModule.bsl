Функция ПараметрыКаналаТелеграм() Экспорт
	
	АдресСервиса = ИнтернетАдреса().Телеграм;
	ИмяЧата = "@kontur_markirovka";
	ИмяЧатаБезСобачки = Сред(ИмяЧата, 2);
	Ссылка = АдресСервиса + "/" + ИмяЧатаБезСобачки;
	
	Результат = Новый Структура;
	Результат.Вставить("Ссылка", Ссылка);
	Результат.Вставить("ИмяЧата", ИмяЧата);
	
	Возврат Результат;
	
КонецФункции

Функция ИнформацияДляТехПоддержки() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИнформацияОМодуле",           ИнформацияОМодуле());
	Результат.Вставить("ИнформацияОКонфигурации",     ИнформацияОКонфигурации());
	Результат.Вставить("ИнформацияОНастройкахМодуля", ИнформацияОНастройкахМодуля());
	Результат.Вставить("ИнформацияОПлагинах",         ИнформацияОПлагинах());
	Результат.Вставить("ТекстИнформацииОбОшибках",    ТекстИнформацииОбОшибках());
	
	Возврат Результат;
	
КонецФункции

Функция ТекстИнформацииОбОшибках()
	
	БуферОшибок = МодульЯдро().БуферОшибок_Прочитать();
	Если Не ЗначениеЗаполнено(БуферОшибок) Тогда
		Возврат "";
	КонецЕсли;
	
	ШаблонТекста = НСтр(
	"ru = '---------------------- Ошибки -----------------------
	|
	|%1'");
	
	Разделитель = "
	|
	|*****************************************************
	|";
	
	Результат = ПараметрыВСтроку(ШаблонТекста, СоединитьСтроку(БуферОшибок, Разделитель));
	
	Возврат Результат;
	
КонецФункции

Функция ИнформацияОМодуле()
	
	Результат = Новый Структура;
	Результат.Вставить("ВерсияМодуля",       ВерсияОбработки());
	Результат.Вставить("ВерсияПодсистемы",   ВерсияУстановленнойБиблиотеки());
	Результат.Вставить("ВерсияПлагина",      МодульЯдро().Плагин_ВерсияПлагина());
	Результат.Вставить("РасположениеМодуля", РасположениеМодуля());
	Результат.Вставить("ИмяМодуля",          ИмяМодуля());
	Результат.Вставить("МодульДоработан",    Формат(ЗначениеЗаполнено(ОписаниеДоработокМодуля()), "БЛ=Нет; БИ=Да"));
	Результат.Вставить("ЛицензияНаМодуль",   Формат(МодульЯдро().ЕстьЛицензияНаМодуль(), "БЛ=Нет; БИ=Есть"));
	
	Возврат Результат;
	
КонецФункции

