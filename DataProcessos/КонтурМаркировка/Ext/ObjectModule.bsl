КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_РегистрацияНаборов(ОписаниеОперации, ТаблицаКодов)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	Организация = ОписаниеОперации.Организация;
	ВидыПродукции = Перечисление_ВидыПродукции();
	ДопустимоеКоличествоКодовВСтроке = Операция_ДопустимоеКоличествоКодов(ТипОперации);
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
		ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
		ТаблицаКодов = Новый_ТаблицаКодов();
	Иначе
		КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ);
	КонецЕсли;
	
	ТаблицаКодов_ВТ_ЗаменитьТранспортныеУпаковкиНаВложенныеКоды(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОперации, Операция, ДокументУчета);
	ТаблицаКодов_ВТ_ДобавитьКоличествоВложенныхКодов(МенеджерВТ);
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		ВидПродукции = ТаблицаКодов_ВТ_ПервыйВидПродукции(МенеджерВТ);
	КонецЕсли;
	
	Набор = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Набор;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.Товар КАК Товар,
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	Т.Количество КАК Количество,
	|	Т.КоличествоВложенныхКодов КАК КоличествоВложенныхКодов
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	Т.ОбщийТипУпаковки = &Набор
	|	И Т.ВидПродукции = &ВидПродукции";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Набор", Набор);
	Запрос.УстановитьПараметр("ВидПродукции", ВидПродукции);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Выборка = Запрос.Выполнить().Выбрать();
	МенеджерВТ.Закрыть();
	
	ОписаниеОперации.Товары.Очистить();
	Пока Выборка.Следующий() Цикл
		
		КоличествоКИН = 1;
		БудетДобавленоКодов = Выборка.КоличествоВложенныхКодов + КоличествоКИН;
		
		СтрТовара = Неопределено;
		Для каждого Стр Из ОписаниеОперации.Товары Цикл
			КодовВСтроке = Стр.КоличествоУпаковок + Стр.КоличествоУпаковокВложенногоТовара + БудетДобавленоКодов;
			Если Стр.Товар = Выборка.Товар
				И Стр.КлючНоменклатуры1С = Выборка.КлючНоменклатуры1С
				И КодовВСтроке < ДопустимоеКоличествоКодовВСтроке Тогда
				СтрТовара = Стр;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрТовара = Неопределено Тогда
			СтрТовара = ОписаниеОперации.Товары.Добавить();
			СтрТовара.КлючСтрокиОперации = Новый УникальныйИдентификатор;
			СтрТовара.КлючСтрокиДокумента = Выборка.КлючСтрокиДокумента;
			СтрТовара.КлючНоменклатуры1С = Выборка.КлючНоменклатуры1С;
			СтрТовара.Товар = Выборка.Товар;
		КонецЕсли;
		
		СтрТовара.Количество = СтрТовара.Количество + Выборка.Количество;
		СтрТовара.КоличествоУпаковок = СтрТовара.КоличествоУпаковок + КоличествоКИН;
		СтрТовара.КоличествоУпаковокВложенногоТовара =
		СтрТовара.КоличествоУпаковокВложенногоТовара + Выборка.КоличествоВложенныхКодов;
		
		СтрКода = ТаблицаКодов.Добавить();
		СтрКода.КлючКода = Выборка.КлючКода;
		СтрКода.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
		СтрКода.КлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_КорректировкаСведенийОКодах(ОписаниеОперации, ТаблицаКодов)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
		ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
		ТаблицаКодов = Новый_ТаблицаКодов();
	ИначеЕсли ЗначениеЗаполнено(ОперацияОснование) Тогда
		КодыОпераций_ВТ_Прочитать(ОперацияОснование, МенеджерВТ);
	ИначеЕсли ЗначениеЗаполнено(ДокументУчета) Тогда
		КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ);
	Иначе
		Возврат;
	КонецЕсли;
	
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	Организация = ОписаниеОперации.Организация;
	ВидСведений = ОписаниеОперации.ДопРеквизиты.ВидКорректируемыхСведений;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		ВидПродукции = ТаблицаКодов_ВТ_ПервыйВидПродукции(МенеджерВТ);
		ОписаниеОперации.ВидПродукции = ВидПродукции;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВидСведений)
		Или Не ЗначениеЗаполнено(ВидПродукции) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = Операция_ЗаполнитьТЧ_КорректировкаСведенийОКодах_ТекстЗапроса(ВидСведений);
	ПодходящиеСтатусы = Операция_КорректировкаСведенийОКодах_ПодходящиеСтатусыКодов(ВидСведений);
	ПодходящиеТипыУпаковок = Операция_КорректировкаСведенийОКодах_ПодходящиеТипыУпаковок(ВидСведений);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ВидПродукции", ВидПродукции);
	Запрос.УстановитьПараметр("ПодходящиеСтатусы", ПодходящиеСтатусы);
	Запрос.УстановитьПараметр("ПодходящиеТипыУпаковок", ПодходящиеТипыУпаковок);
	Запрос.УстановитьПараметр("СрокГодностиСУсловием", Перечисление_ТипыСроковГодности().СрокГодностиБольше72СУсловием);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Выборка = Запрос.Выполнить().Выбрать();
	МенеджерВТ.Закрыть();
	
	КэшТоваров = Новый Соответствие;
	ОписаниеОперации.Товары.Очистить();
	ДопустимоеКоличествоКодовВСтроке = Операция_ДопустимоеКоличествоКодов(ТипОперации);
	
	Пока Выборка.Следующий() Цикл
		
		СтрТовара = Неопределено;
		Для каждого Стр Из ОписаниеОперации.Товары Цикл
			Если Стр.Товар = Выборка.Товар
				И Стр.КлючНоменклатуры1С = Выборка.КлючНоменклатуры1С
				И Стр.КлючСтрокиДокумента = Выборка.КлючСтрокиДокумента
				И Стр.КоличествоУпаковок < ДопустимоеКоличествоКодовВСтроке Тогда
				СтрТовара = Стр;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрТовара = Неопределено Тогда
			СтрТовара = ОписаниеОперации.Товары.Добавить();
			СтрТовара.КлючСтрокиОперации = Новый УникальныйИдентификатор;
			СтрТовара.КлючСтрокиДокумента = Выборка.КлючСтрокиДокумента;
			СтрТовара.КлючНоменклатуры1С = Выборка.КлючНоменклатуры1С;
			СтрТовара.Товар = Выборка.Товар;
		КонецЕсли;
		
		СтрТовара.КоличествоУпаковок = СтрТовара.КоличествоУпаковок + 1;
		
		СтрКода = ТаблицаКодов.Добавить();
		СтрКода.КлючКода = Выборка.КлючКода;
		СтрКода.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
		СтрКода.КлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
		
	КонецЦикла;
	
КонецПроцедуры

Функция Операция_ЗаполнитьТЧ_КорректировкаСведенийОКодах_ТекстЗапроса(ВидСведений)
	
	Перем ТекстЗапроса;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.Товар КАК Товар,
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	Т.ВидПродукции = &ВидПродукции
	|	И Т.ОбщийТипУпаковки В(&ПодходящиеТипыУпаковок)
	|	И Т.Статус В(&ПодходящиеСтатусы)
	|	И &УсловиеВетКонтроль
	|	И &УсловиеПеременныйВес
	|	И &УсловиеТипСрокаГодности";
	
	Если ВидСведений = Перечисление_ВидыКорректируемыхСведений().ИдентификаторВСД Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеВетКонтроль", "Т.Товар.ПодлежитВетеринарномуКонтролю");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеВетКонтроль", "ИСТИНА");
	КонецЕсли;
	
	Если ВидСведений = Перечисление_ВидыКорректируемыхСведений().ФактическийВес Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПеременныйВес", "Т.Товар.ПеременныйВес");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПеременныйВес", "ИСТИНА");
	КонецЕсли;
	
	Если ВидСведений = Перечисление_ВидыКорректируемыхСведений().ВариативныйСрокГодности Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеТипСрокаГодности", "Т.Товар.ТипСрокаГодности = &СрокГодностиСУсловием");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеТипСрокаГодности", "ИСТИНА");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура Операция_ЗаполнитьТЧ_РасформированиеНаборов(ОписаниеОперации, ТаблицаКодов)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	Организация = ОписаниеОперации.Организация;
	ПодходящиеСтатусы = Операция_РегистрацияАгрегатов_ПодходящиеСтатусыКодов();
	УпаковкаНабор = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Набор;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
		ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
		ТаблицаКодов = Новый_ТаблицаКодов();
	Иначе
		КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ);
	КонецЕсли;
	ТаблицаКодов_ВТ_УдалитьКодыБезВложенныхКодов(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОперации, Операция, ДокументУчета);
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		ВидПродукции = ТаблицаКодов_ВТ_ПервыйВидПродукции(МенеджерВТ);
		ОписаниеОперации.ВидПродукции = ВидПродукции;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	Т.ОбщийТипУпаковки = &УпаковкаНабор
	|	И ВидПродукции = &ВидПродукции");
	Запрос.УстановитьПараметр("УпаковкаНабор", УпаковкаНабор);
	Запрос.УстановитьПараметр("ВидПродукции", ВидПродукции);
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	МенеджерВТ.Закрыть();
	
	Пока Выборка.Следующий() Цикл
		СтрКода = ТаблицаКодов.Добавить();
		СтрКода.КлючКода = Выборка.КлючКода;
		СтрКода.КлючСтрокиОперации = Новый УникальныйИдентификатор;
	КонецЦикла;
	
КонецПроцедуры

Функция Операция_КорректировкаСведенийОКодах_ПодходящиеСтатусыКодов(ВидСведений)
	
	СтатусыКодов = Перечисление_СтатусыКодов();
	ВидыСведений = Перечисление_ВидыКорректируемыхСведений();
	
	Результат = Новый Массив;
	
	Результат.Добавить(""); // Не запрашивали статус в ГИС МТ
	
	ПодходящиеВидыСведений = Новый Массив;
	ПодходящиеВидыСведений.Добавить(ВидыСведений.ДатаПроизводства);
	ПодходящиеВидыСведений.Добавить(ВидыСведений.СрокГодности);
	ПодходящиеВидыСведений.Добавить(ВидыСведений.ВариативныйСрокГодности);
	ПодходящиеВидыСведений.Добавить(ВидыСведений.ФактическийВес);
	ПодходящиеВидыСведений.Добавить(ВидыСведений.ЛицензияНаНедра);
	ПодходящиеВидыСведений.Добавить(ВидыСведений.РазрешительныйДокумент);
	ПодходящиеВидыСведений.Добавить(ВидыСведений.НомерПартии);
	Если ПодходящиеВидыСведений.Найти(ВидСведений) <> Неопределено Тогда
		Результат.Добавить(СтатусыКодов.Нанесен);
		Результат.Добавить(СтатусыКодов.ВведенВОборот);
	КонецЕсли;
	
	Если ВидСведений = ВидыСведений.ИдентификаторВСД Тогда
		Результат.Добавить(СтатусыКодов.ВведенВОборот);
		Результат.Добавить(СтатусыКодов.ВыбылИзОборота);
		Результат.Добавить(СтатусыКодов.Списан);
	КонецЕсли;
	
	Если ВидСведений = ВидыСведений.КодТНВЭД Тогда
		Результат.Добавить(СтатусыКодов.ВведенВОборот);
	КонецЕсли;
	
	Если ВидСведений = ВидыСведений.СпособВыпускаТоваров Тогда
		Результат.Добавить(СтатусыКодов.Выпущен);
		Результат.Добавить(СтатусыКодов.Нанесен);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Операция_КорректировкаСведенийОКодах_ПодходящиеТипыУпаковок(ВидСведений) Экспорт
	
	ОбщиеТипыУпаковок = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок;
	ВидыСведений = Перечисление_ВидыКорректируемыхСведений();
	
	Результат = Новый Массив;
	
	Результат.Добавить(ОбщиеТипыУпаковок.ЕдиницаТовара);
	
	ПодходящиеВидыСведений = Новый Массив;
	ПодходящиеВидыСведений.Добавить(ВидыСведений.ДатаПроизводства);
	ПодходящиеВидыСведений.Добавить(ВидыСведений.СпособВыпускаТоваров);
	ПодходящиеВидыСведений.Добавить(ВидыСведений.РазрешительныйДокумент);
	Если ПодходящиеВидыСведений.Найти(ВидСведений) <> Неопределено Тогда
		Результат.Добавить(ОбщиеТипыУпаковок.Комплект);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура Операция_ЗаполнитьПризнакОСУ(ОписаниеОперации, ОписаниеДокумента)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ТипОперации = ОписаниеОперации.ТипОперации;
	Настройки = НастройкиМодуля();
	
	Если ТипОперации = ТипыОпераций.СообщениеОбОтгрузке
		Или (ТипОперации = ТипыОпераций.ВыводИзОборота И Настройки.ОбъемноСортовойУчетПоУмолчанию) Тогда
		Операция_ЗаполнитьПризнакОСУПоВидуПродукции(ОписаниеОперации);
	Иначе
		ОписаниеОперации.ДопРеквизиты.ОбъемноСортовойУчет = Ложь;
	КонецЕсли;
	
КонецПроцедуры

// Определяет вид продукции по товарам или кодам в операции
//
// Параметры:
//  ОписаниеОперации - Структура - см. Новый_Операция()
//  ТаблицаКодов - ТаблицаЗначений - см. Новый_ТаблицаКодов()
//
Процедура Операция_ЗаполнитьВидПродукции(ОписаниеОперации, ТаблицаКодов)
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ВидПродукции) Тогда
		Возврат;
	КонецЕсли;
	
	ВидПродукцииПоУмолчанию = НастройкиМодуля().ВидПродукцииПоУмолчанию;
	
	Если ЗначениеЗаполнено(ОписаниеОперации.Товары) Тогда
		
		ВидПродукции = ЗначениеРеквизитаОбъекта_Марк(ОписаниеОперации.Товары[0].Товар, "ВидПродукции");
		
		Если ЗначениеЗаполнено(ВидПродукции) Тогда
			МассивТоваров = ТаблицаЗначений_ВыгрузитьКолонку(ОписаниеОперации.Товары, "Товар");
			Если Не Товары_ЕстьДругойВидПродукции(МассивТоваров, ВидПродукции) Тогда
				ОписаниеОперации.ВидПродукции = ВидПродукции;
			КонецЕсли;
		Иначе
			ОписаниеОперации.ВидПродукции = ВидПродукцииПоУмолчанию;
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(ТаблицаКодов) Тогда
		
		ОписаниеОперации.ВидПродукции = КодМаркировки_ВидПродукции(ТаблицаКодов[0].КлючКода);
		
	Иначе
		
		ОписаниеОперации.ВидПродукции = ВидПродукцииПоУмолчанию;
		
	КонецЕсли;
	
КонецПроцедуры

// Определяет тип срока годности по товарам в операции
//
// Параметры:
//  ОписаниеОперации - Структура - см. Новый_Операция()
//
Процедура Операция_ЗаполнитьТипСрокаГодности(ОписаниеОперации)
	
	Если Не ОписаниеОперации.ТипОперации = Перечисление_ТипыОпераций().ОтчетОНанесении
		И Не ОписаниеОперации.ВидПродукции = Перечисление_ВидыПродукции().Молоко Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.ТипСрокаГодности) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОперации.Товары) Тогда
		
		ПервыйТовар = ОписаниеОперации.Товары[0].Товар;
		
		Если Не ЗначениеЗаполнено(ПервыйТовар) Тогда
			Возврат;
		КонецЕсли;
		
		ТипСрокаГодности = ЗначениеРеквизитаОбъекта_Марк(ПервыйТовар, "ТипСрокаГодности");
		
		МассивТоваров = МассивСтруктур_Выгрузить(ОписаниеОперации.Товары, "Товар");
		
		ЕстьДругойТипСрокаГодности = Товары_ЕстьДругойТипСрокаГодности(МассивТоваров, ТипСрокаГодности);
		
		Если Не ЕстьДругойТипСрокаГодности Тогда
			ОписаниеОперации.ДопРеквизиты.ТипСрокаГодности = ТипСрокаГодности;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьСостояниеКодов(ОписаниеОперации)
	
	Если Не ОписаниеОперации.ТипОперации = Перечисление_ТипыОпераций().УведомлениеОСостоянииКодов Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.СостояниеКодов) Тогда
		ОписаниеОперации.ДопРеквизиты.СостояниеКодов = Перечисление_СостоянияКодов().ОтгрузкаНаЭкспорт;
	КонецЕсли;
	
КонецПроцедуры

// Заполняет альтернативные сроки годности по товарам в операции
//
// Параметры:
//  ОписаниеОперации - Структура - см. Новый_Операция()
//
Процедура Операция_ЗаполнитьАльтернативныеСрокиГодности(ОписаниеОперации) Экспорт
	
	ТипыСрокаГодности = Перечисление_ТипыСроковГодности();
	ВидыСведений = Перечисление_ВидыКорректируемыхСведений();
	
	Если Не ЭтоОтчетОНанесении(ОписаниеОперации.ТипОперации)
		И ОписаниеОперации.ТипОперации <> Перечисление_ТипыОпераций().КорректировкаСведенийОКодах Тогда
		Возврат;
	КонецЕсли;
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	
	Если (ОписаниеОперации.ДопРеквизиты.ТипСрокаГодности <> ТипыСрокаГодности.СрокГодностиБольше72СУсловием
		И ОписаниеОперации.ДопРеквизиты.ВидКорректируемыхСведений <> ВидыСведений.ВариативныйСрокГодности)
		Или Не ВидПродукцииДопускаетАльтернативныйСрокГодности(ОписаниеОперации.ВидПродукции) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		
		Если ЗначениеЗаполнено(Стр.ДатаПроизводства) Тогда
			ДатаПроизводства = Стр.ДатаПроизводства;
		Иначе
			ДатаПроизводства = ОписаниеОперации.ДопРеквизиты.ДатаПроизводства;
		КонецЕсли;
		
		Стр.АльтернативныеСрокиГодности = Новый Соответствие;
		
		Для каждого Условие Из Стр.Товар.УсловияХранения Цикл
			
			Если Не Условие.Использовать Тогда
				Продолжить;
			КонецЕсли;
			
			СрокГодности = ПустаяДата();
			Если ЗначениеЗаполнено(ДатаПроизводства) Тогда
				СрокГодности = ДатаПроизводства + Условие.СрокХранения * СекундВСутках();
			КонецЕсли;
			
			Стр.АльтернативныеСрокиГодности.Вставить(Условие.Тип, НачалоДня(СрокГодности));
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьПричинуВыводаИзОборота(ОписаниеОперации)
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	
	Если ОписаниеОперации.ТипОперации <> ТипыОпераций.ВозвратВОборот
		И ОписаниеОперации.ТипОперации <> ТипыОпераций.ВозвратВОборотНаТСД Тогда
		Возврат;
	КонецЕсли;
	
	МассивОпераций = Операция_НайтиОперации(ТипыОпераций.ВыводИзОборота, ОписаниеОперации.ДокументУчета);
	ДопустимыеПричины = ДопустимыеПричиныВозвратаВОборот(ОписаниеОперации.ВидПродукции);
	
	Для каждого Операция Из МассивОпераций Цикл
		
		СтатусОперации = Операция_ОсновнойСтатус(Операция);
		ПричинаВыводаИзОборота = ДопРеквизит_Прочитать(Операция, "ПричинаВыводаИзОборота");
		
		Если СтатусОперации <> СтатусыОпераций.ОперацияЗавершена
			Или ДопустимыеПричины.Найти(ПричинаВыводаИзОборота) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеОперации.ДопРеквизиты.ПричинаВыводаИзОборота = ПричинаВыводаИзОборота;
		
		Прервать;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТипОтгрузки(ОписаниеОперации)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	Если ОписаниеОперации.ТипОперации = ТипыОпераций.СообщениеОбОтгрузке Тогда
		ОписаниеОперации.ДопРеквизиты.ТипОтгрузки = Перечисление_ТипыОтгрузок().ТрансграничнаяТорговля;
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьПризнакОСУПоВидуПродукции(ОписаниеОперации)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	Если ТипОперации = ТипыОпераций.ВыводИзОборота Тогда
		ВидыПродукции = ДопустимыеВидыПродукцииДляВыводаИзОборотаОСУ();
	ИначеЕсли ТипОперации = ТипыОпераций.СообщениеОбОтгрузке Тогда
		ВидыПродукции = ДопустимыеВидыПродукцииДляСообщенияОбОтгрузкеПоОСУ();
	Иначе
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТоварыОпераций.Товар КАК Товар,
	|	ТоварыОпераций.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	СУММА(ТоварыОпераций.КоличествоУпаковок) КАК КоличествоУпаковок
	|ПОМЕСТИТЬ ТоварыДругихОпераций
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Операции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции.Товары КАК ТоварыОпераций
	|		ПО Операции.Ссылка = ТоварыОпераций.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК ОсновнойСтатус
	|		ПО Операции.Ссылка = ОсновнойСтатус.Операция
	|			И (ОсновнойСтатус.ТипСтатуса = &ОсновнойСтатус)
	|ГДЕ
	|	Операции.Ссылка <> &ТекущаяОперация
	|	И Операции.ТипОперации = &ТипОперации
	|	И Операции.ДокументУчета = &ДокументУчета
	|	И ОсновнойСтатус.Статус <> &ОперацияОтменена
	|	И ТоварыОпераций.Товар.ВидПродукции В (&ВидыПродукцииПоОСУ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыОпераций.Товар,
	|	ТоварыОпераций.КлючНоменклатуры1С
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Товар,
	|	КлючНоменклатуры1С
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыМаркировки.Товар КАК Товар,
	|	ТоварыДокумента.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	СУММА(ТоварыМаркировки.КоличествоУпаковок) - МАКСИМУМ(ЕСТЬNULL(ТоварыДругихОпераций.КоличествоУпаковок, 0)) КАК КоличествоУпаковок
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыМаркировки КАК ТоварыМаркировки
	|		ПО ТоварыДокумента.КлючСтрокиДокумента = ТоварыМаркировки.КлючСтрокиДокумента
	|			И (ТоварыМаркировки.Ссылка = &ДокументУчета)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТоварыДругихОпераций КАК ТоварыДругихОпераций
	|		ПО ТоварыДокумента.КлючНоменклатуры1С = ТоварыДругихОпераций.КлючНоменклатуры1С
	|			И (ТоварыМаркировки.Товар = ТоварыДругихОпераций.Товар)
	|ГДЕ
	|	ТоварыДокумента.Ссылка = &ДокументУчета
	|	И ТоварыДокумента.НеПодлежитМаркировке = ЛОЖЬ
	|	И ТоварыМаркировки.Товар.ВидПродукции В (&ВидыПродукцииПоОСУ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыМаркировки.Товар,
	|	ТоварыДокумента.КлючНоменклатуры1С
	|
	|ИМЕЮЩИЕ
	|	СУММА(ТоварыМаркировки.КоличествоУпаковок) - МАКСИМУМ(ЕСТЬNULL(ТоварыДругихОпераций.КоличествоУпаковок, 0)) > 0");
	Запрос.УстановитьПараметр("ТипОперации", ТипОперации);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("ТекущаяОперация", Операция);
	Запрос.УстановитьПараметр("ОсновнойСтатус", "ОсновнойСтатус");
	Запрос.УстановитьПараметр("ОперацияОтменена", Перечисление_СтатусыОпераций().ОперацияОтменена);
	Запрос.УстановитьПараметр("ВидыПродукцииПоОСУ", ВидыПродукции);
	
	ОписаниеОперации.ДопРеквизиты.ОбъемноСортовойУчет = Не Запрос.Выполнить().Пустой();
	
КонецПроцедуры

// Заполняет в заказе кодов способ выпуска товаров, если коды заказываются на остатки
//
// Параметры:
//  Операция - Структура - см. Новый_Операция()
//
Процедура Операция_ЗаполнитьСпособВыпускаТоваровНаОстатки(ОписаниеОперации)
	
	Если ОписаниеОперации.ТипОперации <> Перечисление_ТипыОпераций().ЗаказКодов
		Или ОписаниеОперации.ВидПродукции <> Перечисления.КонтурМаркировка_ВидыПродукции.Парфюмерия Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.Товары) Тогда
		Возврат;
	КонецЕсли;
	
	Товар = ОписаниеОперации.Товары[0].Товар;
	Если Не ЗначениеЗаполнено(Товар)
		Или Не ЭтоКодТовараНаОстатки(Товар.GTIN) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОперации.ДопРеквизиты.СпособВыпускаТоваров = Перечисление_СпособыВыпускаТоваров().Остатки;
	
КонецПроцедуры

// Определяет ИНН производителя и собственника по товарам операции
//
// Параметры:
//  ОписаниеОперации - Структура - см. Новый_Операция()
//
Процедура Операция_ЗаполнитьПроизводительИСобственникТовараИНН(ОписаниеОперации) Экспорт
	
	ТипыУчастниковВводящихВОборот = Перечисление_ТипыУчастниковВводящихВОборот();
	ТипыПроизводственныхЗаказов = Перечисление_ТипыПроизводственныхЗаказов();
	
	ТипПроизводственногоЗаказа = ОписаниеОперации.ДопРеквизиты.ТипПроизводственногоЗаказа;
	Если ТипПроизводственногоЗаказа <> ТипыПроизводственныхЗаказов.КонтрактноеПроизводство
		Или Не ЗначениеЗаполнено(ОписаниеОперации.Товары)
		Или ОписаниеОперации.ТипОперации <> Перечисление_ТипыОпераций().ВводВОборот Тогда
		Возврат;
	КонецЕсли;
	
	ПервыйТовар = ОписаниеОперации.Товары[0].Товар;
	
	Если Не ЗначениеЗаполнено(ПервыйТовар) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.ПроизводительИНН) Тогда
		Если ОписаниеОперации.ДопРеквизиты.ТипУчастникаВводящегоВОборот = ТипыУчастниковВводящихВОборот.Производитель Тогда
			ОписаниеОперации.ДопРеквизиты.ПроизводительИНН = ОписаниеОперации.Организация.ИНН;
		Иначе
			ОписаниеОперации.ДопРеквизиты.ПроизводительИНН = ПервыйТовар.Производитель.ИНН;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.СобственникТовараИНН) Тогда
		Если ОписаниеОперации.ДопРеквизиты.ТипУчастникаВводящегоВОборот = ТипыУчастниковВводящихВОборот.Производитель Тогда
			Если ПервыйТовар.ВладелецКарточкиТовара.ИНН <> ОписаниеОперации.Организация.ИНН Тогда
				ОписаниеОперации.ДопРеквизиты.СобственникТовараИНН = ПервыйТовар.ВладелецКарточкиТовара.ИНН;
			КонецЕсли;
		Иначе
			ОписаниеОперации.ДопРеквизиты.СобственникТовараИНН = ОписаниеОперации.Организация.ИНН;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Заполняет дату производства по дате документа учета
//
// Параметры:
//  ОписаниеОперации - Структура - см. Новый_Операция()
//
Процедура Операция_ЗаполнитьДатуПроизводства(ОписаниеОперации)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СпособыВвода = Перечисление_СпособыВводаВОборот();
	
	Если ОписаниеОперации.ТипОперации <> ТипыОпераций.ВводВОборот
		И Не ЭтоОтчетОНанесении(ОписаниеОперации.ТипОперации) Тогда
		Возврат;
	КонецЕсли;
	
	Если ОписаниеОперации.ТипОперации = ТипыОпераций.ВводВОборот
		И ОписаниеОперации.ДопРеквизиты.СпособВводаВОборот <> СпособыВвода.ПроизводствоРФ Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоОтчетОНанесении(ОписаниеОперации.ТипОперации)
		И Не ВидПродукцииТребуетДатуПроизводстваВОтчетеОНанесении(ОписаниеОперации.ВидПродукции) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.ДатаПроизводства) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Если ЗначениеЗаполнено(Стр.ДатаПроизводства) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ОписаниеОперации.ДопРеквизиты.ДатаПроизводства = ЗначениеРеквизитаОбъекта_Марк(ОписаниеОперации.ДокументУчета, "Дата");
	
КонецПроцедуры

// Заполняет в заказе кодов тип кода маркировки по товарам документа учета
//
// Параметры:
//  ОписаниеОперации - Структура - см. Новый_Операция()
//
Процедура Операция_ЗаполнитьТипКодаМаркировки(ОписаниеОперации)
	
	ТипОперации = ОписаниеОперации.ТипОперации;
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	
	Если ТипОперации <> Перечисление_ТипыОпераций().ЗаказКодов Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДопРеквизиты.ТипКодаМаркировки) Тогда
		Возврат;
	КонецЕсли;
	
	ДопРеквизиты.ТипКодаМаркировки = Перечисления.КонтурМаркировка_ТипыКодовМаркировки.ЕдиницаТовара;
	
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		Для каждого Стр Из ДокументУчета_ТребуемыеКоды(ДокументУчета) Цикл
			Если ЗначениеЗаполнено(Стр.Товар) Тогда
				ДопРеквизиты.ТипКодаМаркировки = Стр.Товар.ТипКодаМаркировки;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Определяет группу ТН ВЭД по товарам в операции
//
// Параметры:
//  ОписаниеОперации - Структура - см. Новый_Операция()
//
Процедура Операция_ЗаполнитьГруппуТНВЭД(ОписаниеОперации)
	
	Если ОписаниеОперации.ТипОперации <> Перечисление_ТипыОпераций().ФормированиеАТК Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.ГруппаТНВЭД) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОперации.Товары) Тогда
		
		ПервыйТовар = ОписаниеОперации.Товары[0].Товар;
		
		Если Не ЗначениеЗаполнено(ПервыйТовар) Тогда
			Возврат;
		КонецЕсли;
		
		ОписаниеОперации.ДопРеквизиты.ГруппаТНВЭД = ДопРеквизит_Прочитать(ПервыйТовар, "ГруппаТНВЭД", "");
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет пустые реквизиты из настроек по умолчанию
//
Процедура Операция_ЗаполнитьЗначенияПоУмолчанию(ОписаниеОперации) Экспорт
	
	Настройки = НастройкиМодуля();
	ТипыОпераций = Перечисление_ТипыОпераций();
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ТипОперации = ОписаниеОперации.ТипОперации;
	ТипыПроизводственныхЗаказов = Перечисление_ТипыПроизводственныхЗаказов();
	
	// Организация
	Если Не ЗначениеЗаполнено(ОписаниеОперации.Организация) Тогда
		ОписаниеОперации.Организация = Настройки.ОрганизацияПоУмолчанию;
	КонецЕсли;
	
	// Склад
	Если Не ЗначениеЗаполнено(ОписаниеОперации.Склад)
		И ЗначениеЗаполнено(Настройки.СкладПоУмолчанию)
		И Настройки.СкладПоУмолчанию.Организация = ОписаниеОперации.Организация Тогда
		ОписаниеОперации.Склад = Настройки.СкладПоУмолчанию;
	КонецЕсли;
	
	// Способ ввода в оборот
	Если ТипОперации = ТипыОпераций.ВводВОборот
		И Не ЗначениеЗаполнено(ДопРеквизиты.СпособВводаВОборот) Тогда
		ДопРеквизиты.СпособВводаВОборот = Настройки.СпособВводаВОборотПоУмолчанию;
	КонецЕсли;
	
	// Способ выпуска товаров
	Если ТипОперации = ТипыОпераций.ЗаказКодов
		И Не ЗначениеЗаполнено(ДопРеквизиты.СпособВыпускаТоваров) Тогда
		ДопРеквизиты.СпособВыпускаТоваров = Настройки.СпособВыпускаТоваровПоУмолчанию;
	КонецЕсли;
	
	// Тип производственного заказа
	Если ТипОперации = ТипыОпераций.ВводВОборот Тогда
		ДопРеквизиты.ТипПроизводственногоЗаказа = Настройки.ТипПроизводственногоЗаказаПоУмолчанию;
	КонецЕсли;
	
	Если ДопРеквизиты.ТипПроизводственногоЗаказа = ТипыПроизводственныхЗаказов.КонтрактноеПроизводство Тогда
		ДопРеквизиты.ТипУчастникаВводящегоВОборот = Настройки.ТипУчастникаВводящегоВОборотПоУмолчанию;
	КонецЕсли;
	
	// Наполнение агрегатов на ТСД
	Если ТипОперации = ТипыОпераций.НаполнениеАгрегатовНаТСД Тогда
		
		ДопРеквизиты.РегистрироватьАгрегатыПослеНаполнения = Настройки.РегистрироватьАгрегатыПослеНаполненияПоУмолчанию;
		
		ДопРеквизиты.ПолучатьПолныеКодыПриНаполненииАгрегатаНаТСД = Настройки.ПолучатьПолныеКодыПриНаполненииАгрегатаНаТСД;
		Если ЗначениеЗаполнено(ОписаниеОперации.ВидПродукции) 
			И Не ВидПродукцииПоддерживаетОтчетОНанесении(ОписаниеОперации.ВидПродукции) Тогда
			ДопРеквизиты.ПолучатьПолныеКодыПриНаполненииАгрегатаНаТСД = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	// Проверка кодов на ТСД
	Если ТипОперации = ТипыОпераций.ПодборКодовНаТСД
		Или ТипОперации = ТипыОпераций.ПодборТоваровИКодовНаТСД
		Или ТипОперации = ТипыОпераций.ОтчетОНанесенииНаТСД
		Или ТипОперации = ТипыОпераций.НаполнениеАгрегатовНаТСД Тогда
		ДопРеквизиты.ПроверятьКодыПриСканировании = Настройки.ПроверятьКодыПриСканированииПоУмолчанию;
	КонецЕсли;
	
	// Площадка
	Если ЭтоОтчетОНанесении(ТипОперации)
		И ВидПродукцииДопускаетПлощадки(ОписаниеОперации.ВидПродукции)
		И Не ЗначениеЗаполнено(ДопРеквизиты.Площадка) Тогда
		Если ЗначениеЗаполнено(ОписаниеОперации.Склад) Тогда
			Площадка = ОписаниеОперации.Склад.Площадка;
			Если Площадка_СодержитВидПродукции(Площадка, ОписаниеОперации.ВидПродукции) Тогда
				ДопРеквизиты.Площадка = ОписаниеОперации.Склад.Площадка;
			КонецЕсли;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ДопРеквизиты.Площадка) Тогда
			ДопРеквизиты.Площадка = Организация_ОсновнаяПлощадка(ОписаниеОперации.Организация);
		КонецЕсли;
	КонецЕсли;
	
	// Тип оплаты кодов
	Если ТипОперации = ТипыОпераций.ЗаказКодов
		И Не ЗначениеЗаполнено(ДопРеквизиты.ТипОплатыКодов)
		И ВидПродукцииТребуетТипОплатыКодов(ОписаниеОперации.ВидПродукции) Тогда
		ДопРеквизиты.ТипОплатыКодов = Настройки.ТипОплатыКодовПоУмолчанию;
	КонецЕсли;
	
	// Тип использования кодов
	Если ЭтоОтчетОНанесении(ТипОперации)
		И Не ЗначениеЗаполнено(ДопРеквизиты.ТипИспользования) Тогда
		ДопРеквизиты.ТипИспользования = Настройки.ТипИспользованияПоУмолчанию;
	КонецЕсли;
	
	// Номинальный объем в кегах
	Если ОписаниеОперации.ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Пиво Тогда
		Если ТипОперации = ТипыОпераций.ОтчетОНанесенииНаТСД Тогда
			ДопРеквизиты.НоминальныйОбъемВКегах = Истина;
		КонецЕсли;
		Если ТипОперации = ТипыОпераций.ОтчетОНанесении Тогда
			ДопРеквизиты.НоминальныйОбъемВКегах = Настройки.НоминальныйОбъемВКегахПоУмолчанию;
		КонецЕсли;
	КонецЕсли;
	
	// Формат кодов
	Если ТипОперации = ТипыОпераций.ЗаказКодов Тогда
		Если ВидПродукцииПоддерживаетУкороченныйФорматКодов(ОписаниеОперации.ВидПродукции) Тогда
			ДопРеквизиты.ФорматКодов = Настройки.ФорматКодовПоУмолчанию;
		КонецЕсли;
	КонецЕсли;
	
	// Параметры сортировки этикеток
	Если ТипОперации = ТипыОпераций.ПечатьКодов Тогда
		
		Для Сч = 1 По КоличествоПараметровСортировкиЭтикеток() Цикл
			
			КлючПолеСортировки = "ПолеСортировкиЭтикеток" + Сч;
			КлючНаправлениеСортировки = "НаправлениеСортировкиЭтикеток" + Сч;
			
			ДопРеквизиты[КлючПолеСортировки] = Настройки[КлючПолеСортировки + "ПоУмолчанию"];
			ДопРеквизиты[КлючНаправлениеСортировки] = Настройки[КлючНаправлениеСортировки + "ПоУмолчанию"];
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧЗначениямиПоУмолчанию(ОписаниеОперации) Экспорт
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ТипОперации = ОписаниеОперации.ТипОперации;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ВидыПродукции = Перечисление_ВидыПродукции();
	СпособВводаВОборот = ДопРеквизиты.СпособВводаВОборот;
	
	// Реквизиты таб. части товаров при вводе в оборот
	Если ТипОперации = ТипыОпераций.ВводВОборот Или ТипОперации = ТипыОпераций.Перемаркировка Тогда
		
		Для каждого Стр Из ОписаниеОперации.Товары Цикл
			
			Товар = Стр.Товар;
			КлючНоменклатуры1С = Стр.КлючНоменклатуры1С;
			
			ЗначенияПоУмолчанию = Неопределено;
			Если ЗначениеЗаполнено(КлючНоменклатуры1С) Тогда
				Номенклатура1С = МодульОбщегоНазначения().СсылкаПоИдентификатору(
				КлючНоменклатуры1С.КлючНоменклатуры, КлючНоменклатуры1С.ТипКлючаНоменклатуры);
				ЗначенияПоУмолчанию = Номенклатура1С_ЗначенияПоУмолчанию(Номенклатура1С);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Товар) Тогда
				
				ОписаниеТовара = Товар_Прочитать(Товар);
				
				Стр.КодТНВЭД = ОписаниеТовара.КодТНВЭД;
				
				Если ВидПродукцииДопускаетДокументСертификации(ОписаниеТовара.ВидПродукции) Тогда
					Стр.ВидДокументаСертификации = ОписаниеТовара.ВидДокументаСертификации;
					Стр.НомерДокументаСертификации = ОписаниеТовара.НомерДокументаСертификации;
					Стр.ДатаДокументаСертификации = ОписаниеТовара.ДатаДокументаСертификации;
				КонецЕсли;
				
				Если ТипОперации = ТипыОпераций.ВводВОборот И ВидПродукцииТребуетЛицензиюНаНедра(ВидПродукции, СпособВводаВОборот) Тогда
					Стр.НомерЛицензииНаНедра = ОписаниеТовара.НомерЛицензииНаНедра;
					Стр.ДатаЛицензииНаНедра = ОписаниеТовара.ДатаЛицензииНаНедра;
					Стр.НомераСкважин = ОписаниеТовара.ДопРеквизиты.НомераСкважин;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЗначенияПоУмолчанию) Тогда
				
				Если Не ЗначениеЗаполнено(Стр.КодТНВЭД) Тогда
					Стр.КодТНВЭД = ЗначенияПоУмолчанию.КодТНВЭД;
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(Стр.НомерДокументаСертификации)
					И (ВидПродукцииДопускаетДокументСертификации(ВидПродукции)) Тогда
					Стр.ВидДокументаСертификации = ЗначенияПоУмолчанию.ВидДокументаСертификации;
					Стр.НомерДокументаСертификации = ЗначенияПоУмолчанию.НомерДокументаСертификации;
					Стр.ДатаДокументаСертификации = ЗначенияПоУмолчанию.ДатаДокументаСертификации;
				КонецЕсли;
				
				Если ТипОперации = ТипыОпераций.ВводВОборот
					И ВидПродукции = ВидыПродукции.Вода Тогда
					Если Не ЗначениеЗаполнено(Стр.НомерЛицензииНаНедра) Тогда
						Стр.НомерЛицензииНаНедра = ЗначенияПоУмолчанию.НомерЛицензииНаНедра;
						Стр.ДатаЛицензииНаНедра = ЗначенияПоУмолчанию.ДатаЛицензииНаНедра;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТипОперации = ТипыОпераций.ОтчетОНанесении
		Или ТипОперации = ТипыОпераций.ОтчетОНанесенииНаТСД Тогда
		
		УказатьСодержаниеСпирта = ВидПродукцииДопускаетУказаниеФактическогоСодержанияСпирта(ВидПродукции);
		УказатьДанныеДокумента = ВидПродукцииДопускаетУказаниеНомераИДатыДокументаВОтчетеОНанесении(ВидПродукции);
		
		Если УказатьДанныеДокумента Тогда
			НомерДокумента = НомерПервичногоДокументаБезЛидирующихНулей(ОписаниеОперации.ДокументУчета.Код);
			ДатаДокумента = ОписаниеОперации.ДокументУчета.Дата;
		КонецЕсли;
		
		Для Каждого Стр Из ОписаниеОперации.Товары Цикл
			
			Если УказатьСодержаниеСпирта Тогда
				
				Товар = Стр.Товар;
				Если ЗначениеЗаполнено(Товар) Тогда
					ОписаниеТовара = Товар_Прочитать(Товар);
					Стр.СодержаниеСпирта = ОписаниеТовара.ДопРеквизиты.ОбъемнаяДоляЭтиловогоСпирта;
				КонецЕсли;
				
			КонецЕсли;
			
			Если УказатьДанныеДокумента Тогда
				Стр.НомерДокумента = НомерДокумента;
				Стр.ДатаДокумента = ДатаДокумента;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ЗаполнитьКлючиСтрок(ОписаниеОперации)
	
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		Если Не ЗначениеЗаполнено(Стр.КлючСтрокиОперации) Тогда
			Стр.КлючСтрокиОперации = Новый УникальныйИдентификатор;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ЗаполнитьНомераСтрок(ОписаниеОперации)
	
	Для Сч = 1 По ОписаниеОперации.Товары.Количество() Цикл
		ОписаниеОперации.Товары[Сч-1].НомерСтроки = Сч;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ЗаполнитьАналитикуНоменклатуры(ОписаниеОперации)
	
	КэшАналитики = Новый Соответствие;
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		АналитикаНоменклатуры = АналитикаНоменклатуры1С(Стр.КлючНоменклатуры1С, КэшАналитики);
		ЗаполнитьЗначенияСвойств(Стр, АналитикаНоменклатуры);
	КонецЦикла;
	
КонецПроцедуры

// Заполняет операцию в соответствии с настройками заполнения операций
//
// Параметры:
//  ОписаниеОперации  - Структура - см. Новый_Операция();
//
Процедура Операция_ЗаполнитьИзНастроекЗаполнения(ОписаниеОперации)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеНастроек = НастройкиЗаполненияОпераций_ПрочитатьПоТипуДокумента(ДокументУчета.ТипДокумента);
	Если Не МассивСодержитЗначение(ОписаниеНастроек.ТипыОпераций, ОписаниеОперации.ТипОперации) Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("ТипОперации", ОписаниеОперации.ТипОперации);
	НастройкиРеквизитов = ОписаниеНастроек.ТаблицаРеквизитов.НайтиСтроки(Отбор);
	Документ1С = ДокументУчета_Документ1С(ДокументУчета);
	
	Операция_ЗаполнитьШапкуИзНастроекЗаполнения(ОписаниеОперации, НастройкиРеквизитов, Документ1С);
	
КонецПроцедуры

Процедура Операция_ЗаполнитьШапкуИзНастроекЗаполнения(ОписаниеОперации, НастройкиРеквизитов, Документ1С, Перезаполнять = Ложь) Экспорт
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ИменаРеквизитов = Перечисление_РеквизитыОперацийДляАвтозаполнения();
	РеквизитыОперации = ОписаниеОперации.ДопРеквизиты;
	ПравилаЗаполнения = Перечисление_ПравилаЗаполненияРеквизитов();
	
	ЗаполнятьПризнакОСУ = Ложь;
	Если ОписаниеОперации.ТипОперации = ТипыОпераций.ВыводИзОборота
		И ВидПродукцииПоддерживаетВыводИзОборотаПоОСУ(ОписаниеОперации.ВидПродукции) Тогда
		ЗаполнятьПризнакОСУ = Истина;
	КонецЕсли;
	
	Для Каждого Настройка Из НастройкиРеквизитов Цикл
		
		ТекущееЗначение = Неопределено;
		
		Если Настройка.ПравилоЗаполнения = ПравилаЗаполнения.НеЗаполнять Тогда
			Продолжить;
		КонецЕсли;
		
		Если Настройка.ИмяРеквизита = ИменаРеквизитов.ОбъемноСортовойУчет И Не ЗаполнятьПризнакОСУ Тогда
			Продолжить;
		КонецЕсли;
		
		Если РеквизитыОперации.Свойство(Настройка.ИмяРеквизита, ТекущееЗначение) Тогда
			ЗначениеУказано = (ТипЗнч(ТекущееЗначение) <> Тип("Булево") И ЗначениеЗаполнено(ТекущееЗначение));
			Если ЗначениеУказано И Не Перезаполнять Тогда
				Продолжить;
			КонецЕсли;
			РеквизитыОперации[Настройка.ИмяРеквизита] = ЗначениеРеквизитаИзНастройкиЗаполнения(Настройка, Документ1С);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ВыводИзОборота_ЗаполнитьШапку_ПоУведомлениюОбЭкспорте(ОписаниеОперации) Экспорт
	
	ПричиныВывода = Перечисление_ПричиныВыводаИзОборота();
	
	ОписаниеОснования = Операция_ПрочитатьОперацию(ОписаниеОперации.ОперацияОснование);
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.ПричинаВыводаИзОборота) Тогда
		Если МассивСодержитЗначение(КодыСтранЕАЭС(), ОписаниеОснования.ДопРеквизиты.КодСтраныПолучателя) Тогда
			ОписаниеОперации.ДопРеквизиты.ПричинаВыводаИзОборота = ПричиныВывода.ЭкспортЕАЭС;
		Иначе
			ОписаниеОперации.ДопРеквизиты.ПричинаВыводаИзОборота = ПричиныВывода.ЭкспортЗаПределыЕАЭС;
		КонецЕсли;
	КонецЕсли;
	
	Если ОписаниеОперации.ДопРеквизиты.ПричинаВыводаИзОборота = ПричиныВывода.ЭкспортЕАЭС Тогда
		ОписаниеОперации.ДопРеквизиты.Площадка = ОписаниеОснования.ДопРеквизиты.Площадка;
		ОписаниеОперации.ДопРеквизиты.ИННПолучателя = ОписаниеОснования.ДопРеквизиты.ИННПолучателя;
		ОписаниеОперации.ДопРеквизиты.КодСтраныПолучателя = ОписаниеОснования.ДопРеквизиты.КодСтраныПолучателя;
	КонецЕсли;
	
	Если ОписаниеОперации.ДопРеквизиты.ПричинаВыводаИзОборота = ПричиныВывода.ЭкспортЗаПределыЕАЭС Тогда
		ОписаниеОперации.ДопРеквизиты.Площадка = ОписаниеОснования.ДопРеквизиты.Площадка;
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_УведомлениеОСостоянииКодов_ЗаполнитьШапку_ПоУведомлениюОбЭкспорте(ОписаниеОперации)
	
	СостоянияКодов = Перечисление_СостоянияКодов();
	ОписаниеОснования = Операция_ПрочитатьОперацию(ОписаниеОперации.ОперацияОснование);
	
	Если ОписаниеОснования.ДопРеквизиты.СостояниеКодов = СостоянияКодов.ОтгрузкаНаЭкспорт Тогда
		ОписаниеОперации.ДопРеквизиты.СостояниеКодов = СостоянияКодов.ОтменаОтгрузкиНаЭкспорт;
	Иначе
		ОписаниеОперации.ДопРеквизиты.СостояниеКодов = СостоянияКодов.ОтгрузкаНаЭкспорт;
	КонецЕсли;
	
КонецПроцедуры

Функция ЗначениеРеквизитаИзНастройкиЗаполнения(НастройкаРеквизита, Документ1С)
	
	Результат = МодульЯдро().ПустоеЗначениеТипаЛок(НастройкаРеквизита.ТипЗначения);
	
	ПравилаЗаполнения = Перечисление_ПравилаЗаполненияРеквизитов();
	
	Если НастройкаРеквизита.ПравилоЗаполнения = ПравилаЗаполнения.ФиксированноеЗначение Тогда
		Результат = НастройкаРеквизита.Значение;
	КонецЕсли;
	
	Попытка
		
		ТекстОшибки = "";
		
		Если НастройкаРеквизита.ПравилоЗаполнения = ПравилаЗаполнения.РеквизитДокумента1С Тогда
			ТекстОшибки = НСтр("ru = 'Не удалось получить значение реквизита ""%1"" документа %2'");
			ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, НастройкаРеквизита.Значение, Документ1С);
			Результат = Документ1С[НастройкаРеквизита.Значение];
		КонецЕсли;
		
		Если НастройкаРеквизита.ПравилоЗаполнения = ПравилаЗаполнения.Формула Тогда
			ТекстОшибки = НСтр("ru = 'Не удалось вычислить значение выражения по формуле ""%1"" документа %2'");
			ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, НастройкаРеквизита.Значение, Документ1С);
			Результат = Вычислить(НастройкаРеквизита.Значение);
		КонецЕсли;
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Получение значения реквизита документа из настройки заполнения операции'");
		ДопИнформация = Новый Структура;
		ДопИнформация.Вставить("Документ1С", Документ1С);
		ДопИнформация.Вставить("ТипОперации", НастройкаРеквизита.ТипОперации);
		ДопИнформация.Вставить("РеквизитОперации", НастройкаРеквизита.ИмяРеквизита);
		ДопИнформация.Вставить("ПравилоЗаполнения", НастройкаРеквизита.ПравилоЗаполнения);
		ДопИнформация.Вставить("ЗначениеЗаполнения", НастройкаРеквизита.Значение);
		
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация, ТекстОшибки);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // Заполнение

// #Область Чтение

// Читает операцию и связанные с ней данные из базы
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция, которую нужно прочитать;
// 
// Возвращаемое значение:
//  Структура - см. Новый_Операция()
//
Функция Операция_ПрочитатьОперацию(Операция) Экспорт
	
	Возврат МодульЯдро().Операция_ПрочитатьОперацию(Операция);
	
КонецФункции

// #КонецОбласти // Чтение

// #Область ВходящийУПД

// Находит контент входящего УПД в файлах по идентификатору документа
// и возвращает его в виде структуры
//
// Параметры:
//  ОписаниеОперации - Структура - см. функцию Новый_Операция();
// 
// Возвращаемое значение:
//  Структура - см. функцию Новый_Операция_ДанныеВходящегоУПД();
//
Функция Операция_ВходящийУПД_РезультатСверки(ОписаниеОперации, ЗаменитьGS = Истина) Экспорт
	
	Результат = Новый_Операция_ДанныеВходящегоУПД();
	
	Операция = ОписаниеОперации.Ссылка;
	ИдентификаторДокумента = ОписаниеОперации.ДопРеквизиты.ИдентификаторДокумента;
	ТипФайла = Перечисление_ТипыФайлов().КонтентВходящегоУПД;
	
	ФайлКонтента = Файл_НайтиПоИдентификатору(Операция, ИдентификаторДокумента, ТипФайла);
	Если Не ЗначениеЗаполнено(ФайлКонтента) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОписаниеФайла = Файл_Прочитать(ФайлКонтента);
	Контент = ОписаниеФайла.ДанныеФайла;
	
	Для каждого position Из Контент.positions Цикл
		
		НоваяСтрока = Новый_Операция_СтрокаТовараВходящегоУПД();
		НоваяСтрока.НомерСтроки = position.number;
		position.Свойство("name", НоваяСтрока.НаименованиеТовара);
		
		Если position.Свойство("vva")
			И ЗначениеЗаполнено(position.vva) Тогда
			
			vva = position.vva;
			vva.Свойство("value", НоваяСтрока.КодОСУ);
			vva.Свойство("isValid", НоваяСтрока.КодОСУВалидный);
			vva.Свойство("gtin", НоваяСтрока.GTIN);
			vva.Свойство("gtinName", НоваяСтрока.НаименованиеТовараНК);
			vva.Свойство("quantity", НоваяСтрока.КоличествоПоОСУ);
			
			ТоварнаяГруппа = Неопределено;
			vva.Свойство("productGroup", ТоварнаяГруппа);
			Если ЗначениеЗаполнено(ТоварнаяГруппа) Тогда
				НоваяСтрока.ВидПродукции = ВидПродукцииПоТоварнойГруппеИзСервиса(ТоварнаяГруппа);
			КонецЕсли;
			
			gtinChecks = Неопределено;
			Если vva.Свойство("gtinChecks", gtinChecks) Тогда
				Операция_ВходящийУПД_РезультатСверки_ЗаполнитьПроверкиGTIN(НоваяСтрока, gtinChecks)
			КонецЕсли;
			
			Если vva.Свойство("codes") Тогда
				Операция_ВходящийУПД_РезультатСверки_ЗаполнитьКоды(НоваяСтрока.КодыМаркировкиПоОСУ, vva.codes, ЗаменитьGS);
			КонецЕсли;
			
		КонецЕсли;
		
		Если position.Свойство("codes") Тогда
			Операция_ВходящийУПД_РезультатСверки_ЗаполнитьКоды(НоваяСтрока.КодыМаркировки, position.codes, ЗаменитьGS);
		КонецЕсли;
		
		Результат.КодыДокумента.Добавить(НоваяСтрока);
		
	КонецЦикла;
	
	Если Контент.Свойство("exceptCodes") Тогда
		Результат.ЛишниеКоды = Контент.exceptCodes;
	КонецЕсли;
	
	Операция_ВходящийУПД_ЗаполнитьИтоги(Результат);
	
	Возврат Результат;
	
КонецФункции

// Заполняет проверки по GTIN в строке товара входящего УПД
//
// Параметры:
//  СтрокаТовара - Структура - см. функцию Новый_Операция_СтрокаТовараВходящегоУПД();
//  gtinChecks - Массив - содержит структуры, см. ApiReconciliationGtinCheck;
//
Процедура Операция_ВходящийУПД_РезультатСверки_ЗаполнитьПроверкиGTIN(СтрокаТовара, gtinChecks)
	
	ИзвестныеПроверки = Новый Соответствие;
	ИзвестныеПроверки.Вставить(НРег("IsRegistered"), "ЗарегистрированВГИСМТ");
	ИзвестныеПроверки.Вставить(НРег("IsVvaAllowed"), "РазрешенаОтгрузкаПоОСУ");
	
	РезультатыПроверки = Новый Соответствие;
	РезультатыПроверки.Вставить(НРег("Error"), Ложь);
	РезультатыПроверки.Вставить(НРег("Success"), Истина);
	
	Для Каждого check Из gtinChecks Цикл
		
		Проверка = ИзвестныеПроверки[НРег(check.checkType)];
		РезультатПроверки = РезультатыПроверки[НРег(check.result)];
		
		Если Не ЗначениеЗаполнено(Проверка) Тогда
			Продолжить;
		КонецЕсли;
		
		Если РезультатПроверки = Неопределено Тогда
			ВызватьИсключение ПараметрыВСтроку(НСтр(
			"ru = 'Неизвестный результат проверки GTIN ""%1"": %2'"), check.checkType, check.result);
		КонецЕсли;
		
		СтрокаТовара[Проверка] = РезультатПроверки;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет массив КодыМаркировки структурами Новый_Операция_СтрокаКодаВходящегоУПД() из контента
//
// Параметры:
//  КодыМаркировки - Массив - будет заполнен кодами из контента;
//  codes - Массив - коды входящего УПД
//
Процедура Операция_ВходящийУПД_РезультатСверки_ЗаполнитьКоды(КодыМаркировки, codes, ЗаменитьGS)
	
	ИзвестныеПроверки = Новый Соответствие;
	ИзвестныеПроверки.Вставить(НРег("SenderCheck"), "ПринадлежитОтправителю");
	ИзвестныеПроверки.Вставить(НРег("StatusCheck"), "ВведенВОборот");
	ИзвестныеПроверки.Вставить(НРег("ScannedCheck"), "Отсканирован");
	ИзвестныеПроверки.Вставить(НРег("tobaccoNormalizedCheck"), "КорректныйФорматКода");
	ИзвестныеПроверки.Вставить(НРег("CertificateStatusesCheck"), "ЕстьДействующийРД");
	
	РезультатыПроверки = Новый Соответствие;
	РезультатыПроверки.Вставить(НРег("Error"), Ложь);
	РезультатыПроверки.Вставить(НРег("Success"), Истина);
	
	Для каждого code Из codes Цикл
		
		СтрКода = Новый_Операция_СтрокаКодаВходящегоУПД();
		
		Если ЗаменитьGS Тогда
			СтрКода.КодМаркировки = ЗаменитьРазделительGS1(code.code);
		Иначе
			СтрКода.КодМаркировки = code.code;
		КонецЕсли;
		
		Если code.Свойство("expirationDate") Тогда
			СтрКода.ДатаСрокаГодности = ДатаИзСтрокиXML(code.expirationDate);
		КонецЕсли;
		
		code.Свойство("productWeight", СтрКода.Вес);
		
		Для каждого check Из code.checks Цикл
			
			Проверка = ИзвестныеПроверки[НРег(check.checkType)];
			РезультатПроверки = РезультатыПроверки[НРег(check.result)];
			
			Если Не ЗначениеЗаполнено(Проверка) Тогда
				Продолжить;
			КонецЕсли;
			
			Если РезультатПроверки = Неопределено Тогда
				ВызватьИсключение ПараметрыВСтроку(НСтр(
				"ru = 'Неизвестный результат проверки кода ""%1"": %2'"), check.checkType, check.result);
			КонецЕсли;
			
			СтрКода[Проверка] = РезультатПроверки;
			
		КонецЦикла;
		
		childCodes = СвойствоСтруктуры(code, "childCodes");
		Если ЗначениеЗаполнено(childCodes) Тогда
			Операция_ВходящийУПД_РезультатСверки_ЗаполнитьКоды(СтрКода.ВложенныеКоды, childCodes, ЗаменитьGS);
		КонецЕсли;
		
		КодыМаркировки.Добавить(СтрКода);
		
	КонецЦикла;
	
	Операция_ВходящийУПД_КодыМаркировки_ЗаполнитьGTIN(КодыМаркировки);
	
КонецПроцедуры

Процедура Операция_ВходящийУПД_КодыМаркировки_ЗаполнитьGTIN(КодыМаркировки)
	
	ДлинаGTIN = 14;
	ГруппаGTIN = "01";
	ГруппаСерийныйНомер = "21";
	ДлинаГруппыВКоде = 2;
	НачалоGTIN = СтрДлина(ГруппаGTIN) + 1;
	ПозицияСерийныйНомер = НачалоGTIN + ДлинаGTIN;
	
	Для каждого СтрКода Из КодыМаркировки Цикл
		Если Лев(СтрКода.КодМаркировки, ДлинаГруппыВКоде) = ГруппаGTIN
			И Сред(СтрКода.КодМаркировки, ПозицияСерийныйНомер, ДлинаГруппыВКоде) = ГруппаСерийныйНомер Тогда
			СтрКода.GTIN = Сред(СтрКода.КодМаркировки, НачалоGTIN, ДлинаGTIN);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Возвращает таблицу кодов маркировки, содержащихся во входящем УПД
//
// Параметры:
//  ОписаниеОперации - Структура - см. функцию Новый_Операция();
// 
// Возвращаемое значение:
//  Таблица значений - см. функцию Новый_ТаблицаКодов();
//
Функция Операция_ВходящийУПД_ТаблицаКодов(ОписаниеОперации)
	
	ЗаменитьGS = Ложь;
	РезультатСверки = Операция_ВходящийУПД_РезультатСверки(ОписаниеОперации, ЗаменитьGS);
	
	Результат = Новый_ТаблицаКодов();
	Для каждого Стр Из РезультатСверки.КодыДокумента Цикл
		Операция_ВходящийУПД_ТаблицаКодов_ДобавитьСтроку(Результат, Стр.КодыМаркировки);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Добавляет в таблицу кодов строку кода из результата сверки входящего УПД
//
// Параметры:
//  ТаблицаКодов - Таблица значений - см. функцию Новый_ТаблицаКодов();
//  КодыВходящегоУПД - Массив из Структура - Новый_Операция_СтрокаКодаВходящегоУПД();
//
Процедура Операция_ВходящийУПД_ТаблицаКодов_ДобавитьСтроку(ТаблицаКодов, КодыВходящегоУПД, КодАгрегата = Неопределено)
	
	Для каждого Эл Из КодыВходящегоУПД Цикл
		
		Если ЗначениеЗаполнено(Эл.ВложенныеКоды) Тогда
			Операция_ВходящийУПД_ТаблицаКодов_ДобавитьСтроку(ТаблицаКодов, Эл.ВложенныеКоды, Эл.КодМаркировки);
		КонецЕсли;
		
		СтрКода = ТаблицаКодов.Найти(Эл.КодМаркировки, "КодМаркировки");
		Если СтрКода = Неопределено Тогда
			СтрКода = ТаблицаКодов.Добавить();
			СтрКода.КодМаркировки = Эл.КодМаркировки;
			СтрКода.КодАгрегата = КодАгрегата;
		Иначе
			Если ЗначениеЗаполнено(КодАгрегата) И Не ЗначениеЗаполнено(СтрКода.КодАгрегата) Тогда
				СтрКода.КодАгрегата = КодАгрегата;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает таблицу кодов объемно-сортового учета, из входящего УПД
//
// Параметры:
//  ОписаниеОперации - Структура - см. функцию Новый_Операция();
// 
// Возвращаемое значение:
//  Таблица значений - см. функцию Новый_ТаблицаКодов();
//
Функция Операция_ВходящийУПД_ТаблицаКодовОСУ(ОписаниеОперации)
	
	РезультатСверки = Операция_ВходящийУПД_РезультатСверки(ОписаниеОперации);
	
	Результат = Новый_ТаблицаКодов();
	Для каждого Стр Из РезультатСверки.КодыДокумента Цикл
		
		Если Не ЗначениеЗаполнено(Стр.КодОСУ) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрКода = Результат.Добавить();
		СтрКода.КодМаркировки = Стр.КодОСУ;
		СтрКода.ВидПродукции = Стр.ВидПродукции;
		СтрКода.GTIN = Стр.GTIN;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура Операция_ВходящийУПД_ЗаполнитьИтоги(ДанныеВходящегоУПД)
	
	ВсегоКодов = 0;
	Отсканировано = 0;
	
	ОбщиеИтоги = ДанныеВходящегоУПД.ОбщиеИтоги;
	
	Для Каждого СтрокаТовара Из ДанныеВходящегоУПД.КодыДокумента Цикл
		
		Если ЗначениеЗаполнено(СтрокаТовара.КодыМаркировки) Тогда
			Итоги = Операция_ВходящийУПД_РассчитатьИтогиПоКодам(СтрокаТовара.КодыМаркировки);
			СтрокаТовара.КоличествоКодов = Итоги.КоличествоКодов;
		Иначе
			Итоги = Операция_ВходящийУПД_РассчитатьИтогиПоКодам(СтрокаТовара.КодыМаркировкиПоОСУ);
			СтрокаТовара.КоличествоКодов = СтрокаТовара.КоличествоПоОСУ;
		КонецЕсли;
		
		СтрокаТовара.Отсканировано = Итоги.Отсканировано;
		СтрокаТовара.КодовСОшибками = Итоги.КодовСОшибками;
		
		Если ЗначениеЗаполнено(Итоги.ВведенВОборот) Тогда
			СтрокаТовара.ВведенВОборот = Итоги.ВведенВОборот;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Итоги.ПринадлежитОтправителю) Тогда
			СтрокаТовара.ПринадлежитОтправителю = Итоги.ПринадлежитОтправителю;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Итоги.ЕстьДействующийРД) Тогда
			СтрокаТовара.ЕстьДействующийРД = Итоги.ЕстьДействующийРД;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Итоги.КоличествоКодов)
			И Итоги.Отсканировано = Итоги.КоличествоКодов Тогда
			СтрокаТовара.Отсканирован = Истина;
		КонецЕсли;
		
		ВсегоКодов = ВсегоКодов + СтрокаТовара.КоличествоКодов;
		Отсканировано = Отсканировано + СтрокаТовара.Отсканировано;
		
		ОбщиеИтоги.КоличествоКодовСОшибками = ОбщиеИтоги.КоличествоКодовСОшибками + СтрокаТовара.КодовСОшибками;
		
		Если ЗначениеЗаполнено(СтрокаТовара.КодОСУ) Тогда
			
			Если СтрокаТовара.КодОСУВалидный = Ложь
				Или СтрокаТовара.ЗарегистрированВГИСМТ = Ложь
				Или СтрокаТовара.РазрешенаОтгрузкаПоОСУ = Ложь Тогда
				ОбщиеИтоги.КоличествоКодовПоОСУСОшибками = ОбщиеИтоги.КоличествоКодовПоОСУСОшибками + 1;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВсегоКодов > 0 Тогда
		ОбщиеИтоги.ПроцентОтсканированных = Цел(Отсканировано * 100 / ВсегоКодов);
	КонецЕсли;
	
КонецПроцедуры

Функция Операция_ВходящийУПД_РассчитатьИтогиПоКодам(КодыВходящегоУПД)
	
	Результат = Новый Структура;
	Результат.Вставить("КоличествоКодов", 0);
	Результат.Вставить("КодовСОшибками", 0);
	Результат.Вставить("КодовПоОСУСОшибками", 0);
	Результат.Вставить("Отсканировано", 0);
	
	Результат.Вставить("ПринадлежитОтправителю");
	Результат.Вставить("ВведенВОборот");
	Результат.Вставить("ЕстьДействующийРД");
	
	Для Каждого СтрокаКода Из КодыВходящегоУПД Цикл
		
		Если ЗначениеЗаполнено(СтрокаКода.ВложенныеКоды) Тогда
			
			ИтогиПоВложеннымКодам = Операция_ВходящийУПД_РассчитатьИтогиПоКодам(СтрокаКода.ВложенныеКоды);
			
			Результат.КоличествоКодов = Результат.КоличествоКодов + ИтогиПоВложеннымКодам.КоличествоКодов;
			Результат.КодовСОшибками = Результат.КодовСОшибками + ИтогиПоВложеннымКодам.КодовСОшибками;
			Результат.Отсканировано = Результат.Отсканировано + ИтогиПоВложеннымКодам.Отсканировано;
			
			Если СтрокаКода.ВведенВОборот = Ложь
				Или ИтогиПоВложеннымКодам.ВведенВОборот = Ложь Тогда
				Результат.ВведенВОборот = Ложь;
			КонецЕсли;
			
			Если СтрокаКода.ПринадлежитОтправителю = Ложь
				Или ИтогиПоВложеннымКодам.ПринадлежитОтправителю = Ложь Тогда
				Результат.ПринадлежитОтправителю = Ложь;
			КонецЕсли;
			
			Если СтрокаКода.ЕстьДействующийРД = Ложь
				Или ИтогиПоВложеннымКодам.ЕстьДействующийРД = Ложь Тогда
				Результат.ЕстьДействующийРД = Ложь;
			КонецЕсли;
			
		Иначе
			
			Результат.КоличествоКодов = Результат.КоличествоКодов + 1;
			
			Если ЗначениеЗаполнено(СтрокаКода.ВведенВОборот) Тогда
				Если ЗначениеЗаполнено(Результат.ВведенВОборот) Тогда
					Результат.ВведенВОборот = Мин(СтрокаКода.ВведенВОборот, Результат.ВведенВОборот);
				Иначе
					Результат.ВведенВОборот = СтрокаКода.ВведенВОборот;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаКода.ПринадлежитОтправителю) Тогда
				Если ЗначениеЗаполнено(Результат.ПринадлежитОтправителю) Тогда
					Результат.ПринадлежитОтправителю = Мин(СтрокаКода.ПринадлежитОтправителю, Результат.ПринадлежитОтправителю);
				Иначе
					Результат.ПринадлежитОтправителю = СтрокаКода.ПринадлежитОтправителю;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаКода.ЕстьДействующийРД) Тогда
				Если ЗначениеЗаполнено(Результат.ЕстьДействующийРД) Тогда
					Результат.ЕстьДействующийРД = Мин(СтрокаКода.ЕстьДействующийРД, Результат.ЕстьДействующийРД);
				Иначе
					Результат.ЕстьДействующийРД = СтрокаКода.ЕстьДействующийРД;
				КонецЕсли;
			КонецЕсли;
			
			Если СтрокаКода.ВведенВОборот = Ложь
				Или СтрокаКода.ЕстьДействующийРД = Ложь
				Или СтрокаКода.КорректныйФорматКода = Ложь
				Или СтрокаКода.ПринадлежитОтправителю = Ложь Тогда
				Результат.КодовСОшибками = Результат.КодовСОшибками + 1;
			КонецЕсли;
			
			Если СтрокаКода.Отсканирован = Истина Тогда
				Результат.Отсканировано = Результат.Отсканировано + 1;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // ВходящийУПД

// #Область ПодборКодовНаТСД

Функция ПодборКодовНаТСД_ПоследниеКонтактныеДанные(ИННКонтрагента) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("КонтактныйТелефон", "");
	Результат.Вставить("АдресДоставки", "");
	
	ОперацииПодбораКодовНаТСД = Новый Массив;
	ОперацииПодбораКодовНаТСД.Добавить(Перечисление_ТипыОпераций().ПодборКодовНаТСД);
	ОперацииПодбораКодовНаТСД.Добавить(Перечисление_ТипыОпераций().ПодборТоваровИКодовНаТСД);
	
	ДнейВГоду = 365;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	АдресаДоставки.Значение КАК АдресДоставки,
	|	КонтактныеТелефоны.Значение КАК КонтактныйТелефон,
	|	Операции.Дата КАК ДатаОперации
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Операции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ИННКонтрагентов
	|		ПО Операции.Ссылка = ИННКонтрагентов.Объект
	|			И (ИННКонтрагентов.ИмяРеквизита = &РеквизитКонтрагентИНН)
	|			И (ИННКонтрагентов.Значение = &ИННКонтрагента)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК АдресаДоставки
	|		ПО Операции.Ссылка = АдресаДоставки.Объект
	|			И (АдресаДоставки.ИмяРеквизита = &РеквизитАдресДоставки)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК КонтактныеТелефоны
	|		ПО Операции.Ссылка = КонтактныеТелефоны.Объект
	|			И (КонтактныеТелефоны.ИмяРеквизита = &РеквизитКонтактныйТелефон)
	|ГДЕ
	|	НЕ Операции.ПометкаУдаления
	|	И Операции.ТипОперации В(&ОперацииПодбораКодовНаТСД)
	|	И Операции.Дата >= &ПоследнийГод
	|	И АдресаДоставки.Значение ЕСТЬ НЕ NULL 
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОперации УБЫВ";
	
	Запрос.УстановитьПараметр("РеквизитКонтрагентИНН", "КонтрагентИНН");
	Запрос.УстановитьПараметр("РеквизитАдресДоставки", "АдресДоставки");
	Запрос.УстановитьПараметр("РеквизитКонтактныйТелефон", "КонтактныйТелефон");
	Запрос.УстановитьПараметр("ИННКонтрагента", ИННКонтрагента);
	Запрос.УстановитьПараметр("ОперацииПодбораКодовНаТСД", ОперацииПодбораКодовНаТСД);
	Запрос.УстановитьПараметр("ПоследнийГод", ТекущаяДатаСеанса() - СекундВСутках() * ДнейВГоду);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.КонтактныйТелефон = Выборка.КонтактныйТелефон;
		Результат.АдресДоставки     = Выборка.АдресДоставки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // ПодборКодовНаТСД

