Функция ОписаниеСведенийОМаркировкеДляМетрики(ДокументыУчета, ОшибкиМаркировки, КоличествоКодов)
	
	ПравилаОтражения = Перечисления.КонтурМаркировка_ПравилаОтраженияВЭДО;
	РолиДокументов = Перечисление_РолиДокументовУчета();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварыДокумента.ОтражениеВЭДО КАК ОтражениеВЭДО,
	|	ТоварыМаркировки.Товар.ВидПродукции КАК ВидПродукции
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыМаркировки КАК ТоварыМаркировки
	|		ПО ТоварыДокумента.Ссылка = ТоварыМаркировки.Ссылка
	|			И ТоварыДокумента.КлючСтрокиДокумента = ТоварыМаркировки.КлючСтрокиДокумента
	|ГДЕ
	|	ТоварыДокумента.Ссылка В(&ДокументыУчета)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.ТипДокумента КАК ТипДокумента
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета КАК Т
	|ГДЕ
	|	Т.Ссылка В(&ДокументыУчета)");
	Запрос.УстановитьПараметр("ДокументыУчета", ДокументыУчета);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	РезультатЗапросаОтражениеВЭДО = РезультатыЗапроса[0];
	ТипыДокументов = МассивИзРезультатаЗапроса(РезультатыЗапроса[1], "ТипДокумента");
	
	ВсеОтраженияВЭДО = Новый Массив;
	ВсеВидыПродукции = Новый Массив;
	ВидыПродукцииПУ = Новый Массив;
	ВидыПродукцииОСУ = Новый Массив;
	ВидыПродукцииНеОтражатьВЭДО = Новый Массив;
	
	Выборка = РезультатЗапросаОтражениеВЭДО.Выбрать();
	Пока Выборка.Следующий() Цикл
		ВсеВидыПродукции.Добавить(Выборка.ВидПродукции);
		ВсеОтраженияВЭДО.Добавить(Выборка.ОтражениеВЭДО);
		Если Выборка.ОтражениеВЭДО = ПравилаОтражения.ПУ Тогда
			ВидыПродукцииПУ.Добавить(Выборка.ВидПродукции);
		КонецЕсли;
		Если Выборка.ОтражениеВЭДО = ПравилаОтражения.ОСУ Тогда
			ВидыПродукцииОСУ.Добавить(Выборка.ВидПродукции);
		КонецЕсли;
		Если Выборка.ОтражениеВЭДО = ПравилаОтражения.НеОтражать Тогда
			ВидыПродукцииНеОтражатьВЭДО.Добавить(Выборка.ВидПродукции);
		КонецЕсли;
	КонецЦикла;
	
	СвернутьМассив_Марк(ВсеВидыПродукции);
	СвернутьМассив_Марк(ВсеОтраженияВЭДО);
	ЕстьТоварноеСоседство = (ВсеВидыПродукции.Количество() > 1);
	ЕстьСмешанноеОтражениеВЭДО = (ВсеОтраженияВЭДО.Количество() > 1);
	
	ЕстьРольОтгрузка = Ложь;
	ЕстьРольПроизводство = Ложь;
	ЕстьРольВнутреннееПеремещение = Ложь;
	ЕстьРольКорректировкаОтгрузки = Ложь;
	
	Для каждого ТипДокумента Из ТипыДокументов Цикл
		Если Не ЕстьРольОтгрузка Тогда
			ЕстьРольОтгрузка = ДокументУчета_ТипуДокументаДоступнаРоль(ТипДокумента, РолиДокументов.Отгрузка);
		КонецЕсли;
		Если Не ЕстьРольПроизводство Тогда
			ЕстьРольПроизводство = ДокументУчета_ТипуДокументаДоступнаРоль(ТипДокумента, РолиДокументов.Производство);
		КонецЕсли;
		Если Не ЕстьРольВнутреннееПеремещение Тогда
			ЕстьРольВнутреннееПеремещение = ДокументУчета_ТипуДокументаДоступнаРоль(ТипДокумента, РолиДокументов.ВнутреннееПеремещение);
		КонецЕсли;
		Если Не ЕстьРольКорректировкаОтгрузки Тогда
			ЕстьРольКорректировкаОтгрузки = ДокументУчета_ТипуДокументаДоступнаРоль(ТипДокумента, РолиДокументов.КорректировкаОтгрузки);
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("КоличествоДокументов", ДокументыУчета.Количество());
	Результат.Вставить("КоличествоКодов", КоличествоКодов);
	Результат.Вставить("ЕстьРольОтгрузка", ЕстьРольОтгрузка);
	Результат.Вставить("ЕстьРольПроизводство", ЕстьРольПроизводство);
	Результат.Вставить("ЕстьРольВнутреннееПеремещение", ЕстьРольВнутреннееПеремещение);
	Результат.Вставить("ЕстьРольКорректировкаОтгрузки", ЕстьРольКорректировкаОтгрузки);
	Результат.Вставить("ЕстьТоварноеСоседство", ЕстьТоварноеСоседство);
	Результат.Вставить("ЕстьСмешанноеОтражениеВЭДО", ЕстьСмешанноеОтражениеВЭДО);
	Результат.Вставить("ЕстьАвтораспределениеАгрегатов", КодыДокументов_ЕстьАгрегатыБезСтрокиДокумента(ДокументыУчета));
	Результат.Вставить("ЕстьМультитоварныеАгрегаты", КодыДокументов_ЕстьМультитоварныеАгрегаты(ДокументыУчета));
	Результат.Вставить("ВидыПродукцииПУ", СоединитьСтроку(ВидыПродукцииПУ, ";"));
	Результат.Вставить("ВидыПродукцииОСУ", СоединитьСтроку(ВидыПродукцииОСУ, ";"));
	Результат.Вставить("ВидыПродукцииНеОтражатьВЭДО", СоединитьСтроку(ВидыПродукцииНеОтражатьВЭДО, ";"));
	Результат.Вставить("ТипДокумента", СоединитьСтроку(ТипыДокументов, ";"));
	
	Если ТипЗнч(ОшибкиМаркировки) = Тип("ТаблицаЗначений") Тогда
		Для Каждого СтрОшибки Из ОшибкиМаркировки Цикл
			Результат.Вставить("ЕстьОшибки" + СтрОшибки.ТипОшибки, Истина);
		КонецЦикла;
	Иначе
		Для Каждого Элемент Из ОшибкиМаркировки Цикл
			Результат.Вставить("ЕстьОшибки" + Элемент.Ключ, ЗначениеЗаполнено(Элемент.Значение));
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеКонтекстаНаСервере()
	
	СисИнфо = ИнформацияОСистеме();
	Настройки = НастройкиМодуля();
	НастройкиПриложения = НастройкиКлиентскогоПриложения();
	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	ОписаниеДоработок = ОписаниеДоработокМодуля();
	ВерсияПодсистемы = ВерсияУстановленнойБиблиотеки();
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторПользователяИБ", ПользовательИБ.УникальныйИдентификатор);
	Результат.Вставить("Процессор", СисИнфо.Процессор);
	Результат.Вставить("ВерсияОС", СисИнфо.ВерсияОС);
	Результат.Вставить("ИмяКомпьютера", ИмяКомпьютера());
	Результат.Вставить("ЧасовойПоясКомпьютера", ЧасовойПояс());
	Результат.Вставить("ЧасовойПоясСеанса", ЧасовойПоясСеанса());
