	Для Каждого Стр Из ОшибкиМаркировки.НайтиСтроки(Новый Структура("ТипОшибки", ТипыОшибок.НеРазрешенОСУ)) Цикл
		ШаблонОшибки = ТекстСообщения_НеРазрешенОСУ();
