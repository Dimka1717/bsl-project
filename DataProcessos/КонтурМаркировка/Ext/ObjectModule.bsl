// Возвращает реквизиты контрагента 1С
//
// Параметры:
//  Контрагент - СправочникСсылка - контрагент 1С
// 
// Возвращаемое значение:
//  Структура - содержит свойства:
//   * Представление - Строка - полное или рабочее наименование контрагента;
//   * ИНН - Строка - ИНН контрагента;
//   * КПП - Строка - КПП контрагента;
//
Функция Интеграция_РеквизитыКонтрагента1С(Контрагент1С)
	
	Результат = Новый Структура("Представление, ИНН, КПП");
	
	Если Не ЗначениеЗаполнено(Контрагент1С) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяСправочника = Контрагент1С.Метаданные().ПолноеИмя();
	
	РеквизитыКонтрагента = Новый Структура;
	
	Если ЕстьНеобходимыеМетаданные(ИмяСправочника + ".Реквизиты.НаименованиеПолное") Тогда
		РеквизитыКонтрагента.Вставить("Представление", "НаименованиеПолное");
	Иначе
		РеквизитыКонтрагента.Вставить("Представление", "Наименование");
	КонецЕсли;
	
	Если ЕстьНеобходимыеМетаданные(ИмяСправочника + ".Реквизиты.ИНН") Тогда
		РеквизитыКонтрагента.Вставить("ИНН", "ИНН");
	КонецЕсли;
	
	Если ЕстьНеобходимыеМетаданные(ИмяСправочника + ".Реквизиты.КПП") Тогда
		РеквизитыКонтрагента.Вставить("КПП", "КПП");
	КонецЕсли;
	
	РеквизитыКонтрагента = ЗначенияРеквизитовОбъекта_Марк(Контрагент1С, РеквизитыКонтрагента);
	
	ЗаполнитьЗначенияСвойств(Результат, РеквизитыКонтрагента);
	
	Результат.Представление = СокрЛП(Результат.Представление);
	Результат.ИНН = СокрЛП(Результат.ИНН);
	Результат.КПП = СокрЛП(Результат.КПП);
	
	Возврат Результат;
	
КонецФункции

