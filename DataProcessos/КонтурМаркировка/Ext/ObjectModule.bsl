Функция ДопустимыеВидыКорректируемыхСведенийОКодах(ВидПродукции) Экспорт
	
	ВидыСведений = Перечисление_ВидыКорректируемыхСведений();
	
	Если ЗначениеЗаполнено(ВидПродукции) Тогда
		
		Результат = Новый Массив;
		
		Для Каждого Элемент Из ВидыСведений Цикл
			ДопустимыеВидыПродукции = ДопустимыеВидыПродукцииДляВидаКорректируемыхСведений(Элемент.Значение);
			Если МассивСодержитЗначение(ДопустимыеВидыПродукции, ВидПродукции) Тогда
				Результат.Добавить(Элемент.Значение);
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		Результат = МассивЗначенийИзСтруктуры(ВидыСведений);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДопустимыеВидыПродукцииДляВидаКорректируемыхСведений(ВидСведений) Экспорт
	
	КлючКэш = "ДопустимыеВидыПродукцииДляВидаКорректируемыхСведений: " + ВидСведений;
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидыСведений = Перечисление_ВидыКорректируемыхСведений();
	
	Варианты = Новый Соответствие;
	Варианты.Вставить(ВидыСведений.ИдентификаторВСД, ДопустимыеВидыПродукцииДляКорректировкиИдентификатораВСД());
	Варианты.Вставить(ВидыСведений.СрокГодности, ДопустимыеВидыПродукцииДляКорректировкиСрокаГодности());
	Варианты.Вставить(ВидыСведений.КодТНВЭД, ДопустимыеВидыПродукцииДляКорректировкиКодаТНВЭД());
	Варианты.Вставить(ВидыСведений.ФактическийВес, ДопустимыеВидыПродукцииДляКорректировкиФактическогоВеса());
	Варианты.Вставить(ВидыСведений.РазрешительныйДокумент, ДопустимыеВидыПродукцииДляКорректировкиРазрешительногоДокумента());
	Варианты.Вставить(ВидыСведений.ВариативныйСрокГодности, ДопустимыеВидыПродукцииДляКорректировкиВариативногоСрокаГодности());
	Варианты.Вставить(ВидыСведений.ЛицензияНаНедра, ДопустимыеВидыПродукцииДляКорректировкиЛицензииНаНедра());
	Варианты.Вставить(ВидыСведений.СпособВыпускаТоваров, ДопустимыеВидыПродукцииДляКорректировкиСпособаВыпускаТоваров());
	Варианты.Вставить(ВидыСведений.НомерПартии, ДопустимыеВидыПродукцииДляКорректировкиНомераПартии());
	
	Результат = Варианты[ВидСведений];
	
	Если Результат = Неопределено Тогда
		Результат = ДопустимыеВидыПродукцииДляКорректировкиСведенийОКодах();
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

