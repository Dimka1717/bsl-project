Процедура ТаблицаКодов_ЗаполнитьКлючиСтрокДокумента(ТаблицаКодов, ДокументУчета)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК Т
	|ГДЕ
	|	Т.ДокументУчета = &ДокументУчета
	|	И Т.КлючКода В(&КлючиКодов)");
	Запрос.УстановитьПараметр("КлючиКодов", ТаблицаКодов.ВыгрузитьКолонку("КлючКода"));
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	
	Индекс = ТаблицаКодов.Индексы.Добавить("КлючКода");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТаблицаКодов.Найти(Выборка.КлючКода, "КлючКода").КлючСтрокиДокумента = Выборка.КлючСтрокиДокумента;
	КонецЦикла;
	
	ТаблицаКодов.Индексы.Удалить(Индекс);
	
КонецПроцедуры

Процедура ТаблицаКодов_ЗаполнитьКодыНовыхТранспортныхУпаковок(ТаблицаКодов)
	
	ТребуемыеКоды = Новый Соответствие;
	ТипыУпаковок = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок;
	
	Для Каждого СтрАгрегата Из ТаблицаКодов Цикл
		
		Если СтрАгрегата.ОбщийТипУпаковки <> ТипыУпаковок.ТранспортнаяУпаковка Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрАгрегата.КодМаркировки) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрАгрегата.ВидАгрегата) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиАгрегатов = ЗначениеСоответствия(ТребуемыеКоды, СтрАгрегата.ВидАгрегата, Новый Массив);
		СтрокиАгрегатов.Добавить(СтрАгрегата);
		ТребуемыеКоды.Вставить(СтрАгрегата.ВидАгрегата, СтрокиАгрегатов);
		
	КонецЦикла;
	
	Для каждого Эл Из ТребуемыеКоды Цикл
		
		ВидАгрегата = Эл.Ключ;
		СтрокиАгрегатов = Эл.Значение;
		
		НовыеКоды = НовыеКодыТранспортныхУпаковок(ВидАгрегата, СтрокиАгрегатов.Количество());
		Для Каждого СтрАгрегата Из СтрокиАгрегатов Цикл
			
			СтрАгрегата.КодМаркировки = НовыеКоды[0];
			СтрАгрегата.ПолныйКод = НовыеКоды[0];
			СтрАгрегата.ДляНанесения = Истина;
			СтрАгрегата.КодРазобран = Истина;
			НовыеКоды.Удалить(0);
			
			ОтборСтрок = Новый Структура("КлючАгрегата", СтрАгрегата.КлючКода);
			Для Каждого СтрКода Из ТаблицаКодов.НайтиСтроки(ОтборСтрок) Цикл
				СтрКода.КодАгрегата = СтрАгрегата.КодМаркировки;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

