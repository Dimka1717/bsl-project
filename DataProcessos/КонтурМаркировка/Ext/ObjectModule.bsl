		ВидПродукции = ТаблицаКодов_ВТ_Перемаркировка_ПервыйВидПродукции(МенеджерВТ, ПодходящиеСтатусы, ПодходящиеСпособыВыпуска);
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.Товар КАК Товар,
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	Т.ВидПродукции = &ВидПродукции
	|	И Т.Статус В(&ПодходящиеСтатусы)
	|	И Т.СпособВыпускаТоваров В(&ПодходящиеСпособыВыпуска)");
