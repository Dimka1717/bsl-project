Функция ПричинаВыводаИзОборотаТребуетИННПолучателя(ПричинаВыводаИзОборота) Экспорт
	
	ПричиныВывода = Перечисление_ПричиныВыводаИзОборота();
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.ЭкспортЕАЭС
		Или ПричинаВыводаИзОборота = ПричиныВывода.БезвозмезднаяПередача Тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПричинаВыводаИзОборотаТребуетПервичныйДокумент(ПричинаВыводаИзОборота) Экспорт
	
	Причины = Перечисление_ПричиныВыводаИзОборота();
	
	ПодходящиеПричины = Новый Соответствие;
	ПодходящиеПричины.Вставить(Причины.РозничнаяПродажа, Истина);
	ПодходящиеПричины.Вставить(Причины.ЭкспортЗаПределыЕАЭС, Истина);
	ПодходящиеПричины.Вставить(Причины.Утрата, Истина);
	ПодходящиеПричины.Вставить(Причины.Уничтожение, Истина);
	ПодходящиеПричины.Вставить(Причины.Конфискация, Истина);
	ПодходящиеПричины.Вставить(Причины.ДляСобственныхНужд, Истина);
	ПодходящиеПричины.Вставить(Причины.ВозвратФизическомуЛицу, Истина);
	ПодходящиеПричины.Вставить(Причины.Прочее, Истина);
	ПодходящиеПричины.Вставить(Причины.ДляПроизводственныхЦелей, Истина);
	ПодходящиеПричины.Вставить(Причины.ИстечениеСрокаГодности, Истина);
	ПодходящиеПричины.Вставить(Причины.БезвозмезднаяПередача, Истина);
	ПодходящиеПричины.Вставить(Причины.Утилизация, Истина);
	ПодходящиеПричины.Вставить(Причины.КорректировкаСкладскихОстатков, Истина);
	ПодходящиеПричины.Вставить(Причины.ИспользованиеДляМедицинскогоПрименения, Истина);
	ПодходящиеПричины.Вставить(Причины.ПересортицаПоКодам, Истина);
	ПодходящиеПричины.Вставить(Причины.ОтзывСРынка, Истина);
	
	Результат = (ПодходящиеПричины[ПричинаВыводаИзОборота] = Истина);
	
	Возврат Результат;
	
КонецФункции

Функция ПричинаВыводаИзОборотаДопускаетПервичныйДокумент(ПричинаВыводаИзОборота) Экспорт
	
	ПричиныВывода = Перечисление_ПричиныВыводаИзОборота();
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.Фасовка
		Или ПричинаВыводаИзОборота = ПричиныВывода.ДистанционныйСпособПродажи
		Или ПричинаВыводаИзОборота = ПричиныВывода.ПродажаЧерезВендинговыйАппарат
		Или ПричинаВыводаИзОборота = ПричиныВывода.ПродажаПоОбразцам Тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПричинаВозвратаВОборотТребуетПервичныйДокумент(ПричинаВозвратаВОборот, ТоварОплачен) Экспорт
	
	Причины = Перечисление_ПричиныВозвратаВОборот();
	
	ПодходящиеПричиныВозврата = Новый Массив;
	ПодходящиеПричиныВозврата.Добавить(Причины.БезПоследующейРеализации);
	ПодходящиеПричиныВозврата.Добавить(Причины.РозничнаяРеализация);
	
	Если ТоварОплачен Тогда
		ПодходящиеПричиныВозврата.Добавить(Причины.ДистанционныйСпособПродажи);
	КонецЕсли;
	
	Результат = (ПодходящиеПричиныВозврата.Найти(ПричинаВозвратаВОборот) <> Неопределено);
	
	Возврат Результат;
	
