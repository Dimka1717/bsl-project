Функция ТекстСообщенияПроверкиУстановленнойВерсииМодуля()
	
	ТекущаяВерсияМодуля = ВерсияОбработки();
	ВерсияМодуляВБазе = УстановленнаяВерсияМодуля();
	РасположениеМодуля = РасположениеМодуля();
	ВариантыРасположения = Перечисление_ВариантыРасположенияОбработки();
	
	Если РасположениеМодуля = ВариантыРасположения.ВРасширении Тогда
		Результат = НСтр(
		"ru = 'Запущенная версия модуля Контур.Маркировка отличается от установленной.
		|Для работы с модулем перезапустите программу.'");
	Иначе
		ШаблонСообщения = НСтр(
		"ru = 'Запущенная версия модуля Контур.Маркировка отличается от установленной.
		|Закройте модуль и запустите версию %1.'");
		Результат = ПараметрыВСтроку(ШаблонСообщения, ВерсияМодуляВБазе);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Контракт результата проверки установленной версии модуля
// 
// Возвращаемое значение:
//  Структура - результат проверки установленной версии:
//   * Успешно - Булево - Истина, если установленная версия модуля равна текущей версии модуля;
//   * ТекстСообщения - Строка - текст сообщения пользователю, если проверка не выполнена;
//
Функция Новый_РезультатПроверкиУстановленнойВерсииМодуля()
	
	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("ТекстСообщения", "");
	Результат.Вставить("ПоказатьКнопкуПерезапуска", Ложь);
	
	Возврат Результат;
	
КонецФункции

