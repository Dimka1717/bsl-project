Процедура ОбновитьРегламентноеЗадание(ОписаниеЗадания, Использование, Расписание, ИмяПользователя = Неопределено)
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	РегЗадание = РегламентноеЗадание(ОписаниеЗадания, Использование);
	
	Если РегЗадание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыКоманды = Новый_ПараметрыКомандыОбработки();
	ПараметрыКоманды.ИдентификаторКоманды = ОписаниеЗадания.Команда;
	
	РегЗадание.Параметры = ПараметрыВыполненияРегламентныхЗаданий(ПараметрыКоманды);
	РегЗадание.Использование = Использование;
	РегЗадание.Расписание = Расписание;
	Если ИмяПользователя <> Неопределено Тогда
		РегЗадание.ИмяПользователя = ИмяПользователя;
	КонецЕсли;
	РегЗадание.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ПоддерживаетсяАвтоОбработкаФоновыхЗаданий() Экспорт
	
	Если СерверныйРежимИБ() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Не ВерсияПлатформыНиже("8.3.5")
		И Не ВерсияРежимаСовместимостиНиже("8.3.5") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция МенеджерФоновыхЗаданийДоступен() Экспорт
	
	Если ПоддерживаетсяАвтоОбработкаФоновыхЗаданий() Тогда
		Возврат Истина; // Менеджер доступен всегда
	КонецЕсли;
	
	Попытка
		Отбор = Новый Структура;
		Отбор.Вставить("УникальныйИдентификатор", Новый УникальныйИдентификатор);
		МассивЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
		Результат = Истина;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Результат = Ложь;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

