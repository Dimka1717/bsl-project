	|		ПО (СвязиКлючей.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	ТоварыДокумента.НеПодлежитМаркировке = ЛОЖЬ
	|	И ТоварыДокумента.ОтражениеВЭДО = &ПУ
	|	И КодыДокументовПосле.КлючКода ЕСТЬ NULL
	|	И ИнформацияОКодах.ДляВнутреннегоУчета = ЛОЖЬ
	|	И ИнформацияОКодах.ОбщийТипУпаковки <> &АТК
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДокументУчета,
	|	КлючНоменклатуры1С");
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ПУ", Перечисление_ПравилаОтраженияВЭДО().ПУ);
	Запрос.УстановитьПараметр("АТК", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.АТК);
	Запрос.Выполнить();
	
КонецПроцедуры

