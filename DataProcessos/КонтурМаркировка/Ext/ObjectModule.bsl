// Проверяет заполнение полей документа учета и товары маркировки
//
// Параметры:
//  ДокументУчета - ДокументСсылка.КонтурМаркировка_ДокументыУчета - документ учета;
// 
// Возвращаемое значение:
//  Массив - содержит структуры с полями:
//   * ТекстОшибки - Строка - описание ошибки;
//   * ИмяПоля - Строка - Имя поля документа, связанного с ошибкой;
//   * ИмяТаблицы - Строка - Имя табличной, части связанной с ошибкой;
//   * НомерСтроки - Число - Номер строки табличной части;
//
Функция ПроверитьЗаполнениеДокументаУчета(ДокументУчета) Экспорт
	
	Результат = Новый Массив;
	
	ОписаниеДокумента = ДокументУчета_ПрочитатьДокумент(ДокументУчета);
	
	ОшибкиЗаполненияДокумента = ДокументУчета_ПроверитьЗаполнениеПолей(ОписаниеДокумента);
	ОшибкиТоваровМаркировки = ДокументУчета_ПроверитьТоварыМаркировки(ОписаниеДокумента);
	
	ДополнитьМассив(Результат, ОшибкиЗаполненияДокумента);
	ДополнитьМассив(Результат, ОшибкиТоваровМаркировки);
	
	Возврат Результат;
	
КонецФункции

