Процедура НастроитьОтображениеСрокаТарифа(Форма, Организация) Экспорт
	
	ДатаОкончания = Тариф(Организация).ДатаОкончания;
	
	Если Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		Форма.Элементы.ГруппаИнформацияОТарифе.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Дней70 = 70;
	Дней40 = 40;
	ТекДата = НачалоДня(ТекущаяДатаСеанса());
	ДнейДоОкончанияПодписки = (ДатаОкончания - ТекДата) / СекундВСутках();
	
	Если ТекДата > ДатаОкончания Тогда
		ТекстЗаголовка = НСтр("ru = 'Срок действия тарифа истек'");
	Иначе
		ТекстЗаголовка = ПараметрыВСтроку(НСтр("ru = 'Оплачен до %1'"), Формат(ДатаОкончания, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
	Если ДнейДоОкончанияПодписки > Дней70 Тогда
		ЦветТекста = WebЦвета.Зеленый;
	ИначеЕсли ДнейДоОкончанияПодписки > Дней40 Тогда
		ЦветТекста = WebЦвета.Оранжевый;
	Иначе
		ЦветТекста = WebЦвета.Красный;
	КонецЕсли;
	
	Форма.Элементы.ГруппаИнформацияОТарифе.Видимость = Истина;
	Форма.Элементы.СрокДействияТарифа.Заголовок = ТекстЗаголовка;
	Форма.Элементы.СрокДействияТарифа.ЦветТекста = ЦветТекста;
	
КонецПроцедуры

