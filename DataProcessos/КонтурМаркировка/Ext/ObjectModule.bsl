		ОписаниеОшибки.ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, СоединитьСтроку(Стр.МассивGTIN, ", "));
		ОшибкиЗаполнения.Добавить(ОписаниеОшибки);
