	ЗаполнитьТаблицуКодовИзОписанийКодов(Результат, ЗначениеВМассиве(ОписанияКодов));
	
	Возврат Результат;
	
КонецФункции

Функция ОписанияКодовИзТаблицыКодов(ТаблицаКодов)
	
	Результат = Новый Массив;
	
	ТаблицаКодов.Колонки.Добавить("ОписаниеКода");
	
	Для каждого СтрКода Из ТаблицаКодов Цикл
		
		ОписаниеКода = Новый_ОписаниеНовогоКодаМаркировки();
		ЗаполнитьЗначенияСвойств(ОписаниеКода, СтрКода);
		ЗаполнитьЗначенияСвойств(ОписаниеКода.АналитикаНоменклатуры, СтрКода);
		ЗаполнитьЗначенияСвойств(ОписаниеКода.ДопСведения, СтрКода);
		ЗаполнитьЗначенияСвойств(ОписаниеКода.ДанныеСервиса, СтрКода);
		
		ОписаниеКода.ДопСведения.Объем = СтрКода.Количество;
		
		Если СтрКода.КодРазобран Тогда
			ОписаниеКода.НормализованныйКодМаркировки = СтрКода.КодМаркировки;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрКода.ИсходныйКодМаркировки) Тогда
			ОписаниеКода.КодМаркировки = СтрКода.ИсходныйКодМаркировки;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрКода.ДатаСрокаГодности) Тогда
			ОписаниеКода.ДопСведения.СрокГодности = СтрКода.ДатаСрокаГодности;
		КонецЕсли;
		
		СтрКода.ОписаниеКода = ОписаниеКода;
		
	КонецЦикла;
	
	Индекс = ТаблицаКодов.Индексы.Добавить("КодМаркировки");
	
	Для каждого СтрКода Из ТаблицаКодов Цикл
		Если ЗначениеЗаполнено(СтрКода.КодАгрегата) Тогда
			СтрАгрегата = ТаблицаКодов.Найти(СтрКода.КодАгрегата, "КодМаркировки");
			СтрАгрегата.ОписаниеКода.ВложенныеКоды.Добавить(СтрКода.ОписаниеКода);
		Иначе
			Результат.Добавить(СтрКода.ОписаниеКода);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаКодов.Колонки.Удалить("ОписаниеКода");
	ТаблицаКодов.Индексы.Удалить(Индекс);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьТаблицуКодовИзОписанийКодов(ТаблицаКодов, ОписанияКодов, КодАгрегата = Неопределено)
	
	ТипИдентификатор = Тип("УникальныйИдентификатор");
	
	Для каждого ОписаниеКода Из ОписанияКодов Цикл
		
		СтрКода = ТаблицаКодов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрКода, ОписаниеКода);
		ЗаполнитьЗначенияСвойств(СтрКода, ОписаниеКода.АналитикаНоменклатуры);
		ЗаполнитьЗначенияСвойств(СтрКода, ОписаниеКода.ДопСведения);
		ЗаполнитьЗначенияСвойств(СтрКода, ОписаниеКода.ДанныеСервиса, , "GTIN");
		
		СтрКода.Количество = ОписаниеКода.ДопСведения.Объем;
		
		Если ЗначениеЗаполнено(ОписаниеКода.КлючСтроки) Тогда
			СтрКода.КлючСтрокиОперации = Новый УникальныйИдентификатор(ОписаниеКода.КлючСтроки);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОписаниеКода.КлючСтрокиТоваров) Тогда
			СтрКода.КлючСтрокиДокумента = Новый УникальныйИдентификатор(ОписаниеКода.КлючСтрокиТоваров);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрКода.ОбщийТипУпаковки) Тогда
			Если ЗначениеЗаполнено(СтрКода.Товар) Тогда
				СтрКода.ОбщийТипУпаковки = ОбщийТипУпаковкиПоТипуКодаМаркировки(СтрКода.Товар.ТипКодаМаркировки);
			Иначе
				СтрКода.ОбщийТипУпаковки = ОбщийТипУпаковкиПоВидуУпаковки(ОписаниеКода.ВидУпаковки);
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрКода.GTIN) Тогда
			СтрКода.GTIN = ОписаниеКода.ДанныеСервиса.GTIN;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОписаниеКода.НормализованныйКодМаркировки) Тогда
			СтрКода.КодМаркировки = ОписаниеКода.НормализованныйКодМаркировки;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОписаниеКода.ДопСведения.СрокГодности) Тогда
			СтрКода.ДатаСрокаГодности = ОписаниеКода.ДопСведения.СрокГодности;
		КонецЕсли;
		
		СтрКода.КодАгрегата = КодАгрегата;
		
		Если ЗначениеЗаполнено(ОписаниеКода.ВложенныеКоды) Тогда
			ЗаполнитьТаблицуКодовИзОписанийКодов(ТаблицаКодов, ОписаниеКода.ВложенныеКоды, СтрКода.КодМаркировки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Устарела. Следует использовать НормализоватьКоды()
//
// Для совместимости с ПМ до версии 2.16 (включительно)
// Нормализует коды маркировки
//
Процедура НовыеКоды_НормализоватьКоды(ОписанияКодов, Организация = Неопределено, ВызыватьИсключение = Истина) Экспорт
	
	ТаблицаКодов = ТаблицаКодовИзОписанийКодов(ОписанияКодов);
	
	ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация, ВызыватьИсключение);
	
	ОписанияКодов = ОписанияКодовИзТаблицыКодов(ТаблицаКодов);
	
