Процедура Операция_Проверить_ЗаказКодов(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если ОписаниеОперации.ТипОперации <> Перечисление_ТипыОпераций().ЗаказКодов Тогда
		Возврат;
	КонецЕсли;
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	СпособыВыпуска = Перечисление_СпособыВыпускаТоваров();
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.СервисПровайдер) Тогда
		Операция_ПроверитьВидПродукцииСервисПровайдера(ОписаниеОперации, ОшибкиЗаполнения);
	Иначе
		Операция_ПроверитьВидПродукцииДляЗаказаКодов(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Операция_ПроверитьТипКодаМаркировкиВШапкеИВТоварах(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьСпособВыпускаТоваров(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьТипКодаМаркировки(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьТипОплатыКодов(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьДопустимоеКоличествоУпаковокВЗаказе(ОписаниеОперации, ОшибкиЗаполнения);
	
	Если ОписаниеОперации.ВидПродукции = ВидыПродукции.Легпром
		И ОписаниеОперации.ДопРеквизиты.СпособВыпускаТоваров = СпособыВыпуска.Остатки
		И ОписаниеОперации.ДопРеквизиты.ТипКодаМаркировки <> ТипыКодовМаркировки.Набор Тогда
		Операция_ПроверитьТоварыЛегпромаППРФ883_Остатки(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если ОписаниеОперации.ВидПродукции = ВидыПродукции.МедицинскиеИзделия
		И ОписаниеОперации.ДопРеквизиты.СпособВыпускаТоваров = СпособыВыпуска.Остатки Тогда
		Операция_ПроверитьТоварыМедИзделий_Остатки(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	ОбязательныеРеквизиты = Операция_ОбязательныеРеквизитыЗаказаКодов(ОписаниеОперации);
	
	Операция_ПроверитьОбязательныеРеквизитыШапки(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	Операция_ПроверитьОбязательныеРеквизитыТоваров(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	
КонецПроцедуры

Процедура Операция_Проверить_ПечатьКодов(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если ОписаниеОперации.ТипОперации <> Перечисление_ТипыОпераций().ПечатьКодов Тогда
		Возврат;
	КонецЕсли;
	
	ОбязательныеРеквизиты = Новый_ОбязательныеРеквизитыОперации();
	ОбязательныеРеквизиты.ПоляШапки.Добавить("Организация");
	
	Если ОписаниеОперации.ДопРеквизиты.ПечататьТоварныеЭтикетки Тогда
		ОбязательныеРеквизиты.ПоляШапки.Добавить("ШаблонТоварнойЭтикетки");
	КонецЕсли;
	Если ОписаниеОперации.ДопРеквизиты.ПечататьГрупповыеЭтикетки Тогда
		ОбязательныеРеквизиты.ПоляШапки.Добавить("ШаблонГрупповойЭтикетки");
	КонецЕсли;
	Если ОписаниеОперации.ДопРеквизиты.ПечататьТранспортныеЭтикетки Тогда
		ОбязательныеРеквизиты.ПоляШапки.Добавить("ШаблонТранспортнойЭтикетки");
	КонецЕсли;
	
	Операция_ПроверитьОбязательныеРеквизитыШапки(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	
КонецПроцедуры

Процедура Операция_Проверить_ОтчетОНанесении(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если Не ЭтоОтчетОНанесении(ОписаниеОперации.ТипОперации) Тогда
		Возврат;
	КонецЕсли;
	
	Если ВидПродукцииТребуетУказатьОбъемВОтчетеОНанесении(ОписаниеОперации.ВидПродукции) Тогда
		Если ОписаниеОперации.ДопРеквизиты.НоминальныйОбъемВКегах Тогда
			Операция_ПроверитьНоминальныйОбъемВТоварах(ОписаниеОперации, ОшибкиЗаполнения);
		Иначе
			Операция_ПроверитьОбъемВКодахМаркировки(ОписаниеОперации, ОшибкиЗаполнения);
		КонецЕсли;
	КонецЕсли;
	
	Операция_ПроверитьВидПродукцииДляОтчетаОНанесении(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьДатуСрокаГодности(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьДатуПроизводства(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьАльтернативныеСрокиГодности(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьСодержаниеСпирта(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьДатуИНомерПервичногоДокумента(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьНомерСерии(ОписаниеОперации, ОшибкиЗаполнения);
	
	Если ВидПродукцииТребуетУказатьНомерПартииИлиНомерСерииИлиЗСН(ОписаниеОперации.ВидПродукции) Тогда
		Операция_ПроверитьНомерПартииИНомерСерииИЗаводскиеСерийныеНомера(ОписаниеОперации, ОшибкиЗаполнения);
	Иначе
		Если НастройкиМодуля().ИспользоватьПартионныйУчет
			И ВидПродукцииПоддерживаетПартионныйУчет(ОписаниеОперации.ВидПродукции) Тогда
			Операция_ПроверитьФорматНомераПартии(ОписаниеОперации, ОшибкиЗаполнения);
		КонецЕсли;
	КонецЕсли;
	
	ОбязательныеРеквизиты = Операция_ОбязательныеРеквизитыОтчетаОНанесении(ОписаниеОперации);
	Операция_ПроверитьОбязательныеРеквизитыШапки(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	
КонецПроцедуры

Процедура Операция_Проверить_Перемаркировка(ОписаниеОперации, ОшибкиЗаполнения)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	Если ОписаниеОперации.ТипОперации <> ТипыОпераций.Перемаркировка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не КодыОпераций_ЕстьКоды(ОписаниеОперации.Ссылка) Тогда
		Ошибка = Новый_ОшибкаЗаполнения("КодыМаркировки");
		Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить операцию кодами'");
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
	Операция_ПроверитьДокументСертификации(ОписаниеОперации, ОшибкиЗаполнения);
	
	ОбязательныеРеквизиты = Операция_ДобавитьОбязательныеРеквизитыПеремаркировки();
	Операция_ПроверитьОбязательныеРеквизитыШапки(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	
КонецПроцедуры

Процедура Операция_Проверить_РегистрацияНаборов(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если ОписаниеОперации.ТипОперации <> Перечисление_ТипыОпераций().РегистрацияНаборов Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = НСтр("ru = 'Количество кодов не соответствует составу набора:
	|%1'");
	
	КэшТоваров = Новый Соответствие;
	
	Для Каждого СтрТовара Из ОписаниеОперации.Товары Цикл
		
		ТаблицаКодов = КодыОпераций_Прочитать(ОписаниеОперации.Ссылка, СтрТовара.КлючСтрокиОперации);
		ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
		
		ТаблицаНаборов = ТаблицаКодов.Скопировать(, "КлючКода, КодМаркировки");
		
		ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
		ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
		
		Товар = Товар_Прочитать(СтрТовара.Товар, КэшТоваров);
		КоличествоВложений = 0;
		Для Каждого СоставНабора Из Товар.СоставНабора Цикл
			КоличествоВложений = КоличествоВложений + СоставНабора.КоличествоВложений;
		КонецЦикла;
		
		ТаблицаКодов.Индексы.Добавить("КлючАгрегата");
		
		КодыСОшибками = Новый Массив;
		Для Каждого СтрНабора Из ТаблицаНаборов Цикл
			ВложенныеКоды = ТаблицаКодов.НайтиСтроки(Новый Структура("КлючАгрегата", СтрНабора.КлючКода));
			Если ВложенныеКоды.Количество() <> КоличествоВложений Тогда
				КодыСОшибками.Добавить(СтрНабора.КодМаркировки);
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(КодыСОшибками) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("Товар", "Товары", СтрТовара.НомерСтроки);
			Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, СписокКодовДляТекстаОшибки(КодыСОшибками));
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_Проверить_РегистрацияКИГУ(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если ОписаниеОперации.ТипОперации <> Перечисление_ТипыОпераций().РегистрацияКИГУ Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = НСтр("ru = 'Количество кодов не соответствует составу групповой упаковки:
	|%1'");
	
	КэшТоваров = Новый Соответствие;
	
	Для Каждого СтрТовара Из ОписаниеОперации.Товары Цикл
		
		ТаблицаКодов = КодыОпераций_Прочитать(ОписаниеОперации.Ссылка, СтрТовара.КлючСтрокиОперации);
		ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
		
		ТаблицаКИГУ = ТаблицаКодов.Скопировать(, "КлючКода, КодМаркировки");
		
		ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
		ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
		
		ТаблицаКодов.Индексы.Добавить("КлючАгрегата");
		
		Товар = Товар_Прочитать(СтрТовара.Товар, КэшТоваров);
		КоличествоВложений = Товар.КоличествоВложений;
		
		КодыСОшибками = Новый Массив;
		Для Каждого СтрКИГУ Из ТаблицаКИГУ Цикл
			ВложенныеКоды = ТаблицаКодов.НайтиСтроки(Новый Структура("КлючАгрегата", СтрКИГУ.КлючКода));
			Если ВложенныеКоды.Количество() <> КоличествоВложений Тогда
				КодыСОшибками.Добавить(СтрКИГУ.КодМаркировки);
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(КодыСОшибками) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("Товар", "Товары", СтрТовара.НомерСтроки);
			Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, СписокКодовДляТекстаОшибки(КодыСОшибками));
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_Проверить_РасформированиеАгрегатов(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если ОписаниеОперации.ТипОперации <> Перечисление_ТипыОпераций().РасформированиеАгрегатов Тогда
		Возврат;
	КонецЕсли;
	
	Если Не КодыОпераций_ЕстьКоды(ОписаниеОперации.Ссылка) Тогда
		Ошибка = Новый_ОшибкаЗаполнения("КодыМаркировки");
		Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить операцию кодами'");
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_Проверить_ТрансформацияАгрегатов(ОписаниеОперации, ОшибкиЗаполнения)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	Если ОписаниеОперации.ТипОперации <> ТипыОпераций.ДобавлениеВАгрегат
		И ОписаниеОперации.ТипОперации <> ТипыОпераций.ИзъятиеИзАгрегата Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.КодМаркировки) Тогда
		Ошибка = Новый_ОшибкаЗаполнения("КодыМаркировки");
		Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить код агрегата'");
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
	Если Не КодыОпераций_ЕстьКоды(ОписаниеОперации.Ссылка) Тогда
		Ошибка = Новый_ОшибкаЗаполнения("КодыМаркировки");
		Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить операцию кодами'");
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
	ОбязательныеРеквизиты = Операция_ОбязательныеРеквизитыТрансформацииАгрегатов();
	
	Операция_ПроверитьОбязательныеРеквизитыШапки(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	
КонецПроцедуры

Процедура Операция_Проверить_ФормированиеАТК(ОписаниеОперации, ОшибкиЗаполнения)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	Если ОписаниеОперации.ТипОперации <> ТипыОпераций.ФормированиеАТК Тогда
		Возврат;
	КонецЕсли;
	
	Если Не КодыОпераций_ЕстьКоды(ОписаниеОперации.Ссылка) Тогда
		Ошибка = Новый_ОшибкаЗаполнения("КодыМаркировки");
		Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить операцию кодами'");
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.Товары) Тогда
		Ошибка = Новый_ОшибкаЗаполнения("Товары");
		Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить Товары'");
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	
	Операция_ПроверитьВидПродукцииВШапкеИВТоварах(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьГруппуТНВЭДВШапкеИВТоварах(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьВидПродукцииДляФормированияАТК(ОписаниеОперации, ОшибкиЗаполнения);
	
