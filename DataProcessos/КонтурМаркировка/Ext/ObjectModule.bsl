	Возврат "ЭквивалентыРазделителяGS1";
	
КонецФункции

Функция Новый_ЭквивалентыРазделителяGS1()
	
	Результат = Новый Массив();
	
	Результат.Добавить(ЭквивалентРазделителяGS1());
	Результат.Добавить("_x001d_");
	Результат.Добавить("[GS]");
	
	Возврат Результат;
	
КонецФункции

