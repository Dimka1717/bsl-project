Процедура ПерейтиНаВерсию_3_15_ОбновитьРолиДокументов()
	
	РолиДокументов = Перечисление_РолиДокументовУчета();
	
	ТипыДокументовКорректировки = Новый Массив;
	ТипыДокументовКорректировки.Добавить("КорректировкаРеализации");
	ТипыДокументовКорректировки.Добавить("ВозвратОтПокупателя");
	ТипыДокументовКорректировки.Добавить("ВозвратТоваровОтКлиента");
	ТипыДокументовКорректировки.Добавить("ВозвратТоваровОтПокупателя");
	
	Для каждого Настройка Из НастройкиДокументовУчета_ВсеЭлементы() Цикл
		НастройкиДокументаУчета = НастройкиДокументаУчета_Прочитать(Настройка);
		ТипДокумента = НастройкиДокументаУчета.ТипДокумента;
		Если МассивСодержитЗначение(ТипыДокументовКорректировки, ТипДокумента) Тогда
			ИндексТекущегоЗначения = НастройкиДокументаУчета.РолиДокумента.Найти(РолиДокументов.Отгрузка);
			Если ИндексТекущегоЗначения <> Неопределено Тогда
				НастройкиДокументаУчета.РолиДокумента.Установить(ИндексТекущегоЗначения, РолиДокументов.КорректировкаОтгрузки);
				НастройкиДокументаУчета_Записать(НастройкиДокументаУчета);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

