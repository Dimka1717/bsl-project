Процедура УсловноеОформление_Товары_ТребуетсяЗСН(УсловноеОформление, ТаблицаФормы) Экспорт
	
	ЭлементУО_ПредставлениеНуля = УсловноеОформление.Элементы.Добавить();
	
	ОформляемоеПоле = ЭлементУО_ПредставлениеНуля.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТоварыКоличествоЗСН");
	
	ЭлементОтбора = ЭлементУО_ПредставлениеНуля.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ТаблицаФормы.Имя + ".ТребуетсяЗСН");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	
	ЭлементУО_ПредставлениеНуля.Оформление.УстановитьЗначениеПараметра("Формат", "ЧН='Укажите ЗСН'");
	ЭлементУО_ПредставлениеНуля.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(6, 69, 173));
	
	ЭлементУО_КоличествоЗСНМеньшеТребуемого = УсловноеОформление.Элементы.Добавить();
	
	ОформляемоеПоле = ЭлементУО_КоличествоЗСНМеньшеТребуемого.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТоварыКоличествоЗСН");
	
	ГруппаОтбора = ЭлементУО_КоличествоЗСНМеньшеТребуемого.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ТаблицаФормы.Имя + ".КоличествоЗСН");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ЭлементОтбора.ПравоеЗначение = Новый ПолеКомпоновкиДанных(ТаблицаФормы.Имя + ".КоличествоКодов");
	
	ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ТаблицаФормы.Имя + ".ТребуетсяЗСН");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	
	ЭлементУО_КоличествоЗСНМеньшеТребуемого.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(255, 0, 0));
	
КонецПроцедуры

Процедура УсловноеОформление_Товары_НеТребуетсяЗСН(УсловноеОформление, ТаблицаФормы) Экспорт
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТоварыКоличествоЗСН");
	
	ЭлементОтбора = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ТаблицаФормы.Имя + ".ТребуетсяЗСН");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Ложь;
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Формат", "ЧН='<не требуется>'");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.ТусклоСерый);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
КонецПроцедуры

