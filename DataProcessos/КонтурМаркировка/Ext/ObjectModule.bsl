Функция НовыеКодыТранспортныхУпаковок(ВидАгрегата, КоличествоКодов = 1)
	
	Если ВидАгрегата.ТипКода = Перечисление_ТипыКодовТранспортныхУпаковок().SSCC Тогда
		Возврат НовыеКодыSSCC(ВидАгрегата, КоличествоКодов);
	ИначеЕсли ВидАгрегата.ТипКода = Перечисление_ТипыКодовТранспортныхУпаковок().Code128_26 Тогда
		Возврат НовыеКодыCode128_26(ВидАгрегата, КоличествоКодов);
	Иначе
		ВызватьИсключение ПараметрыВСтроку(НСтр
		("ru = 'Не удалось сформировать новые коды транспортных упаковок.
		|Неизвестный тип кода: %1'"), ВидАгрегата.ТипКода);
	КонецЕсли;
	
КонецФункции

// Генерирует новые штрихкоды SSCC
//
// Параметры:
//  ВидАгрегата - СправочникСсылка.КонтурМаркировка_ВидыАгрегатов - вид агрегата;
//  КоличествоКодов - Число - (необязательный) количество кодов, которые нужно сгенерировать;
// 
// Возвращаемое значение:
//  Массив - содержит строки новых кодов SSCC
//
Функция НовыеКодыSSCC(ВидАгрегата, КоличествоКодов)
	
	ИдентификаторПрименения = "00";
	ИспользоватьSSCC18 = НастройкиМодуля().ИспользоватьSSCC18;
	Если ИспользоватьSSCC18 Тогда
		ИдентификаторПрименения = "";
	КонецЕсли;
	
	Префикс = ВидАгрегата.Префикс;
	КодТипаАгрегата = Формат(ВидАгрегата.КодТипаАгрегата, "ЧН=0; ЧГ=0");
	ПорядковыеНомера = ЗанятьПорядковыеНомераТранспортныхУпаковок(ВидАгрегата, КоличествоКодов);
	
	Результат = Новый Массив;
	
	Для каждого Номер Из ПорядковыеНомера Цикл
		
		Шаблон = "000000000000000000";
		ДлинаШаблона = СтрДлина(Шаблон);
		ДлинаКодаТипаАгрегата = СтрДлина(КодТипаАгрегата);
		ДлинаПрефикса = СтрДлина(Префикс);
		ДлинаНомера = СтрДлина(Номер);
		ДлинаКонтрольногоЧисла = 1;
		ДлинаЗначимойЧасти = ДлинаКодаТипаАгрегата + ДлинаПрефикса + ДлинаНомера + ДлинаКонтрольногоЧисла;
		
		ВедущиеНулиНомера = Лев(Шаблон, ДлинаШаблона - ДлинаЗначимойЧасти);
		НовыйКод = КодТипаАгрегата + Префикс + ВедущиеНулиНомера + Номер;
		
		Результат.Добавить(ИдентификаторПрименения + НовыйКод + КонтрольноеЧислоМодуло10(НовыйКод));
		
	КонецЦикла;
	
	Метрика_Функциональность_ГенераторКодовSSCC(ВидАгрегата.Организация, ИспользоватьSSCC18);
	
	Возврат Результат;
	
КонецФункции

// Генерирует новые штрихкоды Code128 (26 символов)
//
// Параметры:
//  ВидАгрегата - СправочникСсылка.КонтурМаркировка_ВидыАгрегатов - вид агрегата;
//  КоличествоКодов - Число - (необязательный) количество кодов, которые нужно сгенерировать;
// 
// Возвращаемое значение:
//  Массив - содержит строки новых кодов Code128 (26 символов)
//
Функция НовыеКодыCode128_26(ВидАгрегата, КоличествоКодов)
	
	Префикс = ВидАгрегата.Префикс;
	КодТипаАгрегата = Формат(ВидАгрегата.КодТипаАгрегата, "ЧН=0; ЧГ=0");
	ДатаФормирования = Формат(ТекущаяДата(), "ДФ=ггММдд");
	
	ПорядковыеНомера = ЗанятьПорядковыеНомераТранспортныхУпаковок(ВидАгрегата, КоличествоКодов);
	
	Результат = Новый Массив;
	
	Для каждого Номер Из ПорядковыеНомера Цикл
		
		Шаблон = "00000000000000000000000000";
		ДлинаШаблона = СтрДлина(Шаблон);
		ДлинаКодаТипаАгрегата = СтрДлина(КодТипаАгрегата);
		ДлинаПрефикса = СтрДлина(Префикс);
		ДлинаДатыФормирования = СтрДлина(ДатаФормирования);
		ДлинаНомера = СтрДлина(Номер);
		ДлинаЗначимойЧасти = ДлинаКодаТипаАгрегата + ДлинаПрефикса + ДлинаДатыФормирования + ДлинаНомера;
		
		ВедущиеНулиНомера = Лев(Шаблон, ДлинаШаблона - ДлинаЗначимойЧасти);
		
		НовыйКод = КодТипаАгрегата + Префикс + ДатаФормирования + ВедущиеНулиНомера + Номер;
		
		Результат.Добавить(НовыйКод);
		
	КонецЦикла;
	
	Метрика_Функциональность_ГенераторКодовCode128_26(ВидАгрегата.Организация);
	
	Возврат Результат;
	
КонецФункции

// Формирует контрольный символ по алгоритму modulo-10
// см. https://gs1md.org/ru/definirea-cifrei-de-control/
//
// Параметры:
//  Штрихкод - Строка - штрихкод
// 
// Возвращаемое значение:
//  Число - контрольное число
//
Функция КонтрольноеЧислоМодуло10(Штрихкод)
	
	СуммаЧетных = 0;
	СуммаНечетных = 0;
	НомерПоПорядку = 0;
	
	// Цифры штрихкода нумеруются справа налево
	Для Сч = -СтрДлина(Штрихкод) По -1 Цикл
		
		НомерПоПорядку = НомерПоПорядку + 1;
		ТекЧисло = Число(Сред(Штрихкод, -Сч, 1));
		
		Если НомерПоПорядку % 2 = 0 Тогда
			СуммаЧетных = СуммаЧетных + ТекЧисло;
		Иначе
			СуммаНечетных = СуммаНечетных + ТекЧисло;
		КонецЕсли;
		
	КонецЦикла;
	
	// Сумма цифр, на четных местах, суммируется с утроенной суммой цифр, на нечетных местах
	СуммаЦифр = СуммаЧетных + СуммаНечетных * 3;
	
	// Важна только цифра единиц
	Результат = СуммаЦифр % 10;
	
	Если Результат > 0 Тогда
		// Если цифра единиц больше нуля, то контрольная цифра равна дополнению до 10
		Результат = 10 - Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Занимает следующие порядковые номера кода транспортной упаковки
//
// Параметры:
//  ВидАгрегата - СправочникСсылка.КонтурМаркировка_ВидыАгрегатов - вид агрегата;
//  КоличествоУпаковок - Число - (необязательный) количество номеров, которые нужно занять;
// 
// Возвращаемое значение:
//  Массив - содержит строки с порядковыми номерами, которые удалось занять
//
Функция ЗанятьПорядковыеНомераТранспортныхУпаковок(ВидАгрегата, КоличествоУпаковок = 1)
	
	ОписаниеВидаАгрегата = ВидАгрегата_Прочитать(ВидАгрегата);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		СерийныеНомераТранспортныхУпаковок_Заблокировать(ОписаниеВидаАгрегата);
		
		ТекНомер = СерийныеНомераТранспортныхУпаковок_Прочитать(ОписаниеВидаАгрегата);
		
		Результат = Новый Массив;
		Для Сч = 1 По КоличествоУпаковок Цикл
			ТекНомер = ТекНомер + 1;
			ДлинаТекНомера = СтрДлина(Формат(ТекНомер, "ЧН=0; ЧГ=0"));
			Если ДлинаТекНомера > ДопустимаяДлинаСерийногоНомера(ОписаниеВидаАгрегата) Тогда
				ВызватьИсключение НСтр("ru = 'Не удалось сформировать новые коды транспортных упаковок'");
			КонецЕсли;
			Результат.Добавить(Формат(ТекНомер, "ЧГ=0"));
		КонецЦикла;
		
		СерийныеНомераТранспортныхУпаковок_Записать(ОписаниеВидаАгрегата, ТекНомер);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Генерация кодов транспортных упаковок'");
		ДопИнформация = Новый Структура;
		ДопИнформация.Вставить("ВидАгрегата", ОписаниеВидаАгрегата.Наименование);
		ДопИнформация.Вставить("ТипКода", ОписаниеВидаАгрегата.ТипКода);
		ДопИнформация.Вставить("Префикс", ОписаниеВидаАгрегата.Префикс);
		
		ТекстСообщения = НСтр("ru = 'Достигнут максимальный серийный номер транспортной упаковки ""%""1'");
		ТекстСообщения = ПараметрыВСтроку(ТекстСообщения, ВидАгрегата);
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация, ТекстСообщения);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Расчитывает допустимую длину серийного номера по виду агрегата
//
// Параметры:
//  ОписаниеВидаАгрегата - Структура - см. Новый_ВидАгрегата();
// 
// Возвращаемое значение:
//  Число - допустимая длина серийного номера
//
Функция ДопустимаяДлинаСерийногоНомера(ОписаниеВидаАгрегата) Экспорт
	
	Результат = 0;
	
	ТипыКодов = Перечисление_ТипыКодовТранспортныхУпаковок();
	ДлинаПрефикса = СтрДлина(ОписаниеВидаАгрегата.Префикс);
	ДлинаКодаТипаАгрегата = СтрДлина(Формат(ОписаниеВидаАгрегата.КодТипаАгрегата, "ЧН=0; ЧГ=0"));
	
	Если ОписаниеВидаАгрегата.ТипКода = ТипыКодов.SSCC Тогда
		ДлинаКодаАгрегата = 18;
		ДлинаКонтрольногоЧисла = 1;
		Результат = ДлинаКодаАгрегата - ДлинаКодаТипаАгрегата - ДлинаПрефикса - ДлинаКонтрольногоЧисла;
	ИначеЕсли ОписаниеВидаАгрегата.ТипКода = ТипыКодов.Code128_26 Тогда
		ДлинаКодаАгрегата = 26;
		ДлинаДатыФормирования = 6;
		Результат = ДлинаКодаАгрегата - ДлинаКодаТипаАгрегата - ДлинаПрефикса - ДлинаДатыФормирования;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Расчитывает остаток серийных номеров для вида агрегата
//
// Параметры:
//  ВидАгрегата - СправочникСсылка.КонтурМаркировка_ВидыАгрегатов - вид агрегата;
// 
// Возвращаемое значение:
//  Число - количество оставшихся серийных номеров для вида агрегата
//
Функция КоличествоДоступныхСерийныхНомеров(ВидАгрегата) Экспорт
	
	ОписаниеВидаАгрегата = ВидАгрегата_Прочитать(ВидАгрегата);
	ДопустимаяДлинаНомера = ДопустимаяДлинаСерийногоНомера(ОписаниеВидаАгрегата);
	ТекущийНомер = СерийныеНомераТранспортныхУпаковок_Прочитать(ОписаниеВидаАгрегата);
	
	ФорматнаяСтрока = "ЧЦ=" + ДопустимаяДлинаНомера;
	Число27знаков = 100000000000000000000000000;
	МаксимальныйНомер = Формат(Число27знаков, ФорматнаяСтрока);
	
	Результат = МаксимальныйНомер - ТекущийНомер;
	
	Возврат Результат;
	
КонецФункции

Функция СерийныеНомераТранспортныхУпаковок_Прочитать(ОписаниеВидаАгрегата) Экспорт
	
	ТипыКодов = Перечисление_ТипыКодовТранспортныхУпаковок();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.СерийныйНомер КАК СерийныйНомер,
	|	Т.ДатаФормирования КАК ДатаФормирования
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СерийныеНомераТранспортныхУпаковок КАК Т
	|ГДЕ
	|	Т.Префикс = &Префикс
	|	И Т.ТипКода = &ТипКода
	|	И Т.КодТипаАгрегата = &КодТипаАгрегата");
	
	Запрос.УстановитьПараметр("Префикс", ОписаниеВидаАгрегата.Префикс);
	Запрос.УстановитьПараметр("ТипКода", ОписаниеВидаАгрегата.ТипКода);
	Запрос.УстановитьПараметр("КодТипаАгрегата", ОписаниеВидаАгрегата.КодТипаАгрегата);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекДата = НачалоДня(ТекущаяДата());
	Результат = 0;
	
	Если Выборка.Следующий() Тогда
		Если ОписаниеВидаАгрегата.ТипКода = ТипыКодов.Code128_26 Тогда
			Если Выборка.ДатаФормирования >= ТекДата Тогда
				Результат = Выборка.СерийныйНомер;
			КонецЕсли;
		Иначе
			Результат = Выборка.СерийныйНомер;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура СерийныеНомераТранспортныхУпаковок_Записать(ОписаниеВидаАгрегата, СерийныйНомер) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		СерийныеНомераТранспортныхУпаковок_Заблокировать(ОписаниеВидаАгрегата);
		
		Запись = РегистрыСведений.КонтурМаркировка_СерийныеНомераТранспортныхУпаковок.СоздатьМенеджерЗаписи();
		
		ЗаполнитьЗначенияСвойств(Запись, ОписаниеВидаАгрегата);
		Запись.СерийныйНомер = СерийныйНомер;
		Запись.ДатаФормирования = ТекущаяДата();
		
		Запись.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура СерийныеНомераТранспортныхУпаковок_Заблокировать(ОписаниеВидаАгрегата)
	
	Значения = Новый Структура;
	Значения.Вставить("Префикс", ОписаниеВидаАгрегата.Префикс);
	Значения.Вставить("ТипКода", ОписаниеВидаАгрегата.ТипКода);
	Значения.Вставить("КодТипаАгрегата", ОписаниеВидаАгрегата.КодТипаАгрегата);
	
	Объект = "РегистрСведений.КонтурМаркировка_СерийныеНомераТранспортныхУпаковок";
	
	МодульЯдро().ЗаблокироватьПоЗначениям(Объект, Значения);
	
КонецПроцедуры

