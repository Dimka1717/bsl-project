Функция Новый_НастройкиЗаполненияОпераций() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("ТипДокумента");
	Результат.Вставить("ТипыОпераций", Новый Массив);
	
	ТипСтрока = ОписаниеТипа_Строка();
	
	ТаблицаРеквизитов = Новый ТаблицаЗначений;
	ТаблицаРеквизитов.Колонки.Добавить("ТипОперации", ТипСтрока);
	ТаблицаРеквизитов.Колонки.Добавить("ИмяРеквизита", ТипСтрока);
	ТаблицаРеквизитов.Колонки.Добавить("ПредставлениеРеквизита", ТипСтрока);
	ТаблицаРеквизитов.Колонки.Добавить("ПравилоЗаполнения", ТипСтрока);
	ТаблицаРеквизитов.Колонки.Добавить("ТипЗначения", Новый ОписаниеТипов("ОписаниеТипов"));
	ТаблицаРеквизитов.Колонки.Добавить("Значение");
	
	ПравилаЗаполнения = Перечисление_ПравилаЗаполненияРеквизитов();
	ПредставленияРеквизитов = ПредставленияРеквизитовОперацийДляАвтозаполнения();
	ТипыЗначенийРеквизитов = ТипыЗначенийРеквизитовОперацийДляАвтозаполнения();
	
	Для Каждого Элемент Из РеквизитыДляАвтозаполненияОперацийПоТипамОпераций() Цикл
		ТипОперации = Элемент.Ключ;
		РеквизитыОперации = Элемент.Значение;
		Для Каждого Реквизит Из РеквизитыОперации Цикл
			Стр = ТаблицаРеквизитов.Добавить();
			Стр.ТипОперации = ТипОперации;
			Стр.ПравилоЗаполнения = ПравилаЗаполнения.НеЗаполнять;
			Стр.ИмяРеквизита = Реквизит;
			Стр.ПредставлениеРеквизита = ПредставленияРеквизитов[Реквизит];
			Стр.ТипЗначения = ТипыЗначенийРеквизитов[Реквизит];
		КонецЦикла;
	КонецЦикла;
	
	Результат.Вставить("ТаблицаРеквизитов", ТаблицаРеквизитов);
	
	Возврат Результат;
	
КонецФункции

Функция Перечисление_ПравилаЗаполненияРеквизитов() Экспорт
	
	КлючКэш = "ПравилаЗаполненияРеквизитов";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("НеЗаполнять", "Не заполнять");
	Результат.Вставить("ФиксированноеЗначение", "Фиксированное значение");
	Результат.Вставить("РеквизитДокумента1С", "Реквизит документа 1С");
	Результат.Вставить("Формула", "Формула");
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция Перечисление_РеквизитыОперацийДляАвтозаполнения() Экспорт
	
	КлючКэш = "РеквизитыОперацийДляАвтозаполнения";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Новый Структура;
	
	// Вывод из оборота
	Результат.Вставить("ПричинаВыводаИзОборота", "ПричинаВыводаИзОборота");
	Результат.Вставить("НаименованиеПричиныВыводаИзОборота", "НаименованиеПричиныВыводаИзОборота");
	Результат.Вставить("ИННПолучателя", "ИННПолучателя");
	Результат.Вставить("КодСтраныПолучателя", "КодСтраныПолучателя");
	Результат.Вставить("ИдентификаторГосКонтракта", "ИдентификаторГосКонтракта");
	Результат.Вставить("ВидПервичногоДокумента", "ВидПервичногоДокумента");
	Результат.Вставить("НаименованиеПервичногоДокумента", "НаименованиеПервичногоДокумента");
	Результат.Вставить("НомерДокумента", "НомерДокумента");
	Результат.Вставить("ДатаДокумента", "ДатаДокумента");
	Результат.Вставить("ОбъемноСортовойУчет", "ОбъемноСортовойУчет");
	
	// Подбор кодов на ТСД
	Результат.Вставить("КонтактныйТелефон", "КонтактныйТелефон");
	Результат.Вставить("АдресДоставки", "АдресДоставки");
	Результат.Вставить("ПодборСПомощьюМобильногоУстройства", "ПодборСПомощьюМобильногоУстройства");
	Результат.Вставить("МобильноеУстройство", "МобильноеУстройство");
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыДляАвтозаполненияОперацийПоТипамОпераций()
	
	КлючКэш = "РеквизитыДляАвтозаполненияОперацийПоТипамОпераций";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ВсеРеквизиты = Перечисление_РеквизитыОперацийДляАвтозаполнения();
	
	Результат = Новый Соответствие;
	
	// Вывод из оборота
	Реквизиты = Новый Массив;
	Реквизиты.Добавить(ВсеРеквизиты.ПричинаВыводаИзОборота);
	Реквизиты.Добавить(ВсеРеквизиты.НаименованиеПричиныВыводаИзОборота);
	Реквизиты.Добавить(ВсеРеквизиты.ИННПолучателя);
	Реквизиты.Добавить(ВсеРеквизиты.КодСтраныПолучателя);
	Реквизиты.Добавить(ВсеРеквизиты.ИдентификаторГосКонтракта);
	Реквизиты.Добавить(ВсеРеквизиты.ВидПервичногоДокумента);
	Реквизиты.Добавить(ВсеРеквизиты.НаименованиеПервичногоДокумента);
	Реквизиты.Добавить(ВсеРеквизиты.НомерДокумента);
	Реквизиты.Добавить(ВсеРеквизиты.ДатаДокумента);
	Реквизиты.Добавить(ВсеРеквизиты.ОбъемноСортовойУчет);
	
	Результат.Вставить(ТипыОпераций.ВыводИзОборота, Реквизиты);
	
	// Подбор кодов на ТСД
	Реквизиты = Новый Массив;
	Реквизиты.Добавить(ВсеРеквизиты.КонтактныйТелефон);
	Реквизиты.Добавить(ВсеРеквизиты.АдресДоставки);
	Реквизиты.Добавить(ВсеРеквизиты.ПодборСПомощьюМобильногоУстройства);
	Реквизиты.Добавить(ВсеРеквизиты.МобильноеУстройство);
	
	Результат.Вставить(ТипыОпераций.ПодборКодовНаТСД, Реквизиты);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ПредставленияРеквизитовОперацийДляАвтозаполнения()
	
	КлючКэш = "ПредставленияРеквизитовОперацийДляАвтозаполнения";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Реквизиты = Перечисление_РеквизитыОперацийДляАвтозаполнения();
	
	Результат = Новый Структура;
	Результат.Вставить(Реквизиты.ПричинаВыводаИзОборота, НСтр("ru = 'Причина вывода из оборота'"));
	Результат.Вставить(Реквизиты.НаименованиеПричиныВыводаИзОборота, НСтр("ru = 'Наименование причины вывода'"));
	Результат.Вставить(Реквизиты.ИННПолучателя, НСтр("ru = 'ИНН получателя'"));
	Результат.Вставить(Реквизиты.КодСтраныПолучателя, НСтр("ru = 'Страна-получатель'"));
	Результат.Вставить(Реквизиты.ИдентификаторГосКонтракта, НСтр("ru = 'Идентификатор гос.контракта'"));
	Результат.Вставить(Реквизиты.ВидПервичногоДокумента, НСтр("ru = 'Вид первичного документа'"));
	Результат.Вставить(Реквизиты.НаименованиеПервичногоДокумента, НСтр("ru = 'Наименование первичного документа'"));
	Результат.Вставить(Реквизиты.НомерДокумента, НСтр("ru = 'Номер первичного документа'"));
	Результат.Вставить(Реквизиты.ДатаДокумента, НСтр("ru = 'Дата первичного документа'"));
	Результат.Вставить(Реквизиты.ОбъемноСортовойУчет, НСтр("ru = 'Объемно-сортовой учет'"));
	Результат.Вставить(Реквизиты.КонтактныйТелефон, НСтр("ru = 'Контактный телефон'"));
	Результат.Вставить(Реквизиты.АдресДоставки, НСтр("ru = 'Адрес доставки'"));
	Результат.Вставить(Реквизиты.ПодборСПомощьюМобильногоУстройства, НСтр("ru = 'Назначить отгрузку на мобильное устройство'"));
	Результат.Вставить(Реквизиты.МобильноеУстройство, НСтр("ru = 'Мобильное устройство'"));
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ТипыЗначенийРеквизитовОперацийДляАвтозаполнения()
	
	КлючКэш = "ТипыЗначенийРеквизитовОперацийДляАвтозаполнения";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипБулево = ОписаниеТипа_Булево();
	ТипСтрока = ОписаниеТипа_Строка();
	ТипДата = ОписаниеТипа_Дата();
	ТипМобильноеУстройство = ОписаниеТипа_МобильныеУстройства();
	
	Реквизиты = Перечисление_РеквизитыОперацийДляАвтозаполнения();
	
	Результат = Новый Структура;
	Результат.Вставить(Реквизиты.ПричинаВыводаИзОборота, ТипСтрока);
	Результат.Вставить(Реквизиты.НаименованиеПричиныВыводаИзОборота, ТипСтрока);
	Результат.Вставить(Реквизиты.ИННПолучателя, ТипСтрока);
	Результат.Вставить(Реквизиты.КодСтраныПолучателя, ТипСтрока);
	Результат.Вставить(Реквизиты.ИдентификаторГосКонтракта, ТипСтрока);
	Результат.Вставить(Реквизиты.ВидПервичногоДокумента, ТипСтрока);
	Результат.Вставить(Реквизиты.НаименованиеПервичногоДокумента, ТипСтрока);
	Результат.Вставить(Реквизиты.НомерДокумента, ТипСтрока);
	Результат.Вставить(Реквизиты.ДатаДокумента, ТипДата);
	Результат.Вставить(Реквизиты.ОбъемноСортовойУчет, ТипБулево);
	Результат.Вставить(Реквизиты.КонтактныйТелефон, ТипСтрока);
	Результат.Вставить(Реквизиты.АдресДоставки, ТипСтрока);
	Результат.Вставить(Реквизиты.ПодборСПомощьюМобильногоУстройства, ТипБулево);
	Результат.Вставить(Реквизиты.МобильноеУстройство, ТипМобильноеУстройство);
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // НастройкиЗаполненияОпераций

// #Область ГрупповаяОбработка

// Возвращает таблицу документов учета, подходящих для создания
// операций указанного типа по указанной организации, за период
//
// Параметры:
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
//  Период - СтандартныйПериод - период, за который необходимо найти документы;
//  ТипОперации - Строка - тип операции, см. Перечисление_ТипыОпераций();
// 
// Возвращаемое значение:
//  ТаблицаЗначений - содержит документы учета;
//  Неопределено - если нет подходящих документов учета;
//
Функция ГрупповаяОбработка_ТаблицаДокументов(Организация, Период, ТипОперации) Экспорт
	
	Результат = Неопределено;
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ТипыДокументов = ТипыДокументовДляГрупповойОбработкиОпераций(ТипОперации);
	
	Если Не ЗначениеЗаполнено(ТипыДокументов) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипОперации = ТипыОпераций.ПодборКодовНаТСД Тогда
		Результат = ГрупповаяОбработка_ТаблицаДокументов_ПодборКодовНаТСД(Организация, Период, ТипыДокументов);
	КонецЕсли;
	
	Если ТипОперации = ТипыОпераций.ВыводИзОборота Тогда
		Результат = ГрупповаяОбработка_ТаблицаДокументов_ВыводИзОборота(Организация, Период, ТипыДокументов);
	КонецЕсли;
	
	ГрупповаяОбработка_ТаблицаДокументов_ДобавитьРеквизитыКонтрагента(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ГрупповаяОбработка_ТаблицаДокументов_ПодборКодовНаТСД(Организация, Период, ТипыДокументов)
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействияДокументовУчета();
	СтатусыДокументовУчета = Перечисление_СтатусыДокументовУчета();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	ПодходящиеТребуемыеДействия = Новый Массив;
	ПодходящиеТребуемыеДействия.Добавить(ТребуемыеДействия.НачатьРаботу);
	ПодходящиеТребуемыеДействия.Добавить(ТребуемыеДействия.НаполнитьКодами);
	
	ИменаТаблицДокументов = ГрупповаяОбработка_ИменаТаблицДокументов(МенеджерВТ, Организация, Период, ТипыДокументов);
	
	ТекстУсловия = "
	|
	|ГДЕ
	|	ЕСТЬNULL(ТребуемыеДействия.Статус, &ДействиеНачатьРаботу) В (&ПодходящиеТребуемыеДействия)
	|
	|";
	
	ТекстЗапроса = ТекстЗапроса_ТаблицаДокументовДляГрупповойОбработки(ИменаТаблицДокументов, ТекстУсловия);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("СтатусНовый", СтатусыДокументовУчета.Новый);
	Запрос.УстановитьПараметр("ДействиеНачатьРаботу", ТребуемыеДействия.НачатьРаботу);
	Запрос.УстановитьПараметр("ПодходящиеТребуемыеДействия", ПодходящиеТребуемыеДействия);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	МенеджерВТ.Закрыть();
	
	Возврат Результат;
	
КонецФункции

Функция ГрупповаяОбработка_ТаблицаДокументов_ВыводИзОборота(Организация, Период, ТипыДокументов)
	
	Результат = Неопределено;
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействияДокументовУчета();
	СтатусыДокументовУчета = Перечисление_СтатусыДокументовУчета();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	Если Не КодыДокументов_ВТ_ПрочитатьПоТипамДокументовЗаПериод(МенеджерВТ, ТипыДокументов, Период, Организация) Тогда
		МенеджерВТ.Закрыть();
		Возврат Результат;
	КонецЕсли;
	
	ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, Перечисление_ТипыОпераций().ВыводИзОборота);
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	
	ПодходящиеСтатусы = Операция_ВыводИзОборота_ПодходящиеСтатусыКодов();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.ДокументУчета КАК ДокументУчета
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	Т.Статус В(&ПодходящиеСтатусы)
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.ДокументУчета");
	Запрос.УстановитьПараметр("ПодходящиеСтатусы", ПодходящиеСтатусы);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	ПодходящиеДокументыУчета = МассивИзРезультатаЗапроса(Запрос, "ДокументУчета");
	
	ИменаТаблицДокументов = ГрупповаяОбработка_ИменаТаблицДокументов(МенеджерВТ, Организация, Период, ТипыДокументов);
	
	ТекстУсловия = "
	|
	|ГДЕ
	|	ТабДок.ДокументУчета В (&ПодходящиеДокументыУчета)
	|
	|";
	
	ТекстЗапроса = ТекстЗапроса_ТаблицаДокументовДляГрупповойОбработки(ИменаТаблицДокументов, ТекстУсловия);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("СтатусНовый", СтатусыДокументовУчета.Новый);
	Запрос.УстановитьПараметр("ДействиеНачатьРаботу", ТребуемыеДействия.НачатьРаботу);
	Запрос.УстановитьПараметр("ПодходящиеДокументыУчета", ПодходящиеДокументыУчета);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	МенеджерВТ.Закрыть();
	
	Возврат Результат;
	
КонецФункции

Функция ГрупповаяОбработка_ИменаТаблицДокументов(МенеджерВТ, Организация, Период, ТипыДокументов)
	
	ПодходящиеНастройки = Новый Массив;
	
	НастройкиДокументов = ДействующиеНастройкиДокументовУчета();
	Для Каждого Элемент Из ДействующиеНастройкиДокументовУчета() Цикл
		Если МассивСодержитЗначение(ТипыДокументов, Элемент.ТипДокумента) Тогда
			ПодходящиеНастройки.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаДокументов_ВТ_ДобавитьОрганизации1С(МенеджерВТ, Организация);
	ТаблицаДокументов_ВТ_ДобавитьСклады1С(МенеджерВТ, Организация);
	
	Возврат ТаблицаДокументов_ВТ_ИменаТаблицДокументовУчета(МенеджерВТ, ПодходящиеНастройки, Период);
	
КонецФункции

Функция ТекстЗапроса_ТаблицаДокументовДляГрупповойОбработки(ИменаТаблицДокументов, ТекстУсловия = Неопределено)
	
	Результат = "";
	Разделитель = "";
	ТекстЗапроса = "";
	ПерваяНастройка = Истина;
	
	Для Каждого ИмяТаблицы Из ИменаТаблицДокументов Цикл
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ИСТИНА КАК Пометка,
		|	ТабДок.Организация КАК Организация,
		|	ТабДок.Документ1С КАК Документ1С,
		|	ТабДок.ДокументУчета КАК ДокументУчета,
		|	ТабДок.Номер КАК Номер,
		|	ТабДок.Дата КАК Дата,
		|	ТабДок.Контрагент КАК Контрагент,
		|	ТабДок.Склад КАК Склад,
		|	ТабДок.Сумма КАК Сумма,
		|	ТабДок.ТипДокумента КАК ТипДокумента,
		|	ТабДок.Комментарий КАК Комментарий,
		|	ЕСТЬNULL(ОсновныеСтатусы.Статус, &СтатусНовый) КАК Статус,
		|	ЕСТЬNULL(ТребуемыеДействия.Статус, &ДействиеНачатьРаботу) КАК ТребуемоеДействие
		|ИЗ
		|	ТекущаяТаблица КАК ТабДок
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета КАК ОсновныеСтатусы
		|		ПО (ОсновныеСтатусы.ДокументУчета = ТабДок.ДокументУчета)
		|			И (ОсновныеСтатусы.ТипСтатуса = ""ОсновнойСтатус"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета КАК ТребуемыеДействия
		|		ПО (ТребуемыеДействия.ДокументУчета = ТабДок.ДокументУчета)
		|			И (ТребуемыеДействия.ТипСтатуса = ""ТребуемоеДействие"")";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТекущаяТаблица", ИмяТаблицы);
		
		Если ПерваяНастройка Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ", "ВЫБРАТЬ РАЗРЕШЕННЫЕ");
		КонецЕсли;
		
		ПерваяНастройка = Ложь;
		
		Результат = Результат + Разделитель + ТекстЗапроса + ТекстУсловия;
		
		Разделитель = "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|";
		
	КонецЦикла;
	
	Результат = Результат + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ,
	|	Номер УБЫВ";
	
	Возврат Результат;
	
КонецФункции

Процедура ГрупповаяОбработка_ТаблицаДокументов_ДобавитьРеквизитыКонтрагента(ТаблицаДокументов)
	
	Если Не ЗначениеЗаполнено(ТаблицаДокументов) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаДокументов.Колонки.Добавить("КонтрагентИНН");
	ТаблицаДокументов.Колонки.Добавить("КонтрагентКПП");
	Для Каждого Стр Из ТаблицаДокументов Цикл
		РеквизитыКонтрагента = Интеграция_РеквизитыКонтрагента1С(Стр.Контрагент);
		Стр.КонтрагентИНН = РеквизитыКонтрагента.ИНН;
		Стр.КонтрагентКПП = РеквизитыКонтрагента.КПП;
	КонецЦикла;

КонецПроцедуры

Процедура ГрупповаяОбработка_СоздатьОперации(ТаблицаДокументов, ТаблицаОпераций, ТипОперации) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		
		Для Каждого Стр Из ТаблицаДокументов Цикл
			
			НоваяСтрока = ТаблицаОпераций.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр, , "ЕстьОшибки");
			
			НоваяСтрока.Операция = Операция_Создать(ТипОперации, Стр.ДокументУчета);
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Возвращает все типы документов учета, подходящие для создания операций указанного типа
//
// Параметры:
//  ТипОперации - Строка - тип операции, см. Перечисление_ТипыОпераций();
// 
// Возвращаемое значение:
//  Массив - содержит наименования типов документов;
//
Функция ТипыДокументовДляГрупповойОбработкиОпераций(ТипОперации)
	
	Результат = Новый Массив;
	
	ТипыДокументовНастроекЗаполнения = НастройкиЗаполненияОпераций_ТипыДокументов(ТипОперации);
	ТипыДокументовРабочегоСтола = НастройкиРабочегоСтола_ТипыДокументов();
	
	Если Не ЗначениеЗаполнено(ТипыДокументовРабочегоСтола) Тогда
		Результат = ТипыДокументовНастроекЗаполнения;
	Иначе
		Для Каждого ТипДокумента Из ТипыДокументовНастроекЗаполнения Цикл
			Если МассивСодержитЗначение(ТипыДокументовРабочегоСтола, ТипДокумента) Тогда
				Результат.Добавить(ТипДокумента);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // ГрупповаяОбработка

// #Область МаркируемыеТоварныеГруппы

Функция Новый_МаркируемаяТоварнаяГруппа() Экспорт
	
	Возврат МодульЯдро().Новый_МаркируемаяТоварнаяГруппа();
	
КонецФункции

// Читает из доп справочника маркируемую товарную группу
//
// Параметры:
