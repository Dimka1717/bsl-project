Функция Интеграция_ШтрихкодыНоменклатуры(АналитикаНоменклатуры)
	
	Результат = Новый Массив;
	
	ОписаниеРегистра = ТипыОбъектовИС().РегистрШтрихкодов;
	
	Если ЗначениеЗаполнено(ОписаниеРегистра.ПолноеИмя) Тогда
		
		УсловиеНоменклатуры = ПараметрыВСтроку("Т.%1 = &Номенклатура", ОписаниеРегистра.ПолеНоменклатура);
		
		Если ЗначениеЗаполнено(АналитикаНоменклатуры.Характеристика) Тогда
			УсловиеХарактеристики = ПараметрыВСтроку("Т.%1 = &Характеристика", ОписаниеРегистра.ПолеХарактеристика);
		Иначе
			УсловиеХарактеристики = "ИСТИНА";
		КонецЕсли;
		
		ТекстЗапроса = "ВЫБРАТЬ Т.Штрихкод КАК Штрихкод ИЗ РегистрШтрихкодов КАК Т ГДЕ &Номенклатура И &Характеристика";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РегистрШтрихкодов", ОписаниеРегистра.ПолноеИмя);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Т.Штрихкод", "Т." + ОписаниеРегистра.ПолеШтрихкод);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Номенклатура", УсловиеНоменклатуры);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Характеристика", УсловиеХарактеристики);
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Номенклатура", АналитикаНоменклатуры.Номенклатура);
		Запрос.УстановитьПараметр("Характеристика", АналитикаНоменклатуры.Характеристика);
		
		ДополнитьМассив(Результат, МассивИзРезультатаЗапроса(Запрос, "Штрихкод"));
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Номенклатура = АналитикаНоменклатуры.Номенклатура;
		ИмяСправочника = Номенклатура.Метаданные().ПолноеИмя();
		Если ЕстьНеобходимыеМетаданные(ИмяСправочника + ".Реквизиты.Штрихкод") Тогда
			Штрихкод = ЗначениеРеквизитаОбъекта_Марк(Номенклатура, "Штрихкод");
			Если ЗначениеЗаполнено(Штрихкод) Тогда
				Результат.Добавить(Штрихкод);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Интеграция_ПараметрыНоменклатуры1С(АналитикаНоменклатуры, КэшРезультатов = Неопределено)
	
	Если КэшРезультатов <> Неопределено Тогда
		КлючКэш = СтрокаИдентификаторовАналитикиНоменклатуры1С(АналитикаНоменклатуры);
		ПараметрыНоменклатуры = КэшРезультатов[КлючКэш];
		Если ПараметрыНоменклатуры <> Неопределено Тогда
			Возврат ПараметрыНоменклатуры;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыНоменклатуры = Новый Структура;
	ПараметрыНоменклатуры.Вставить("Артикул");
	ПараметрыНоменклатуры.Вставить("Штрихкоды", Новый Массив);
	
	АналитикаНоменклатурыПМ = Новый_АналитикаНоменклатуры1С();
	ЗаполнитьЗначенияСвойств(АналитикаНоменклатурыПМ, АналитикаНоменклатуры);
	
	СтандартнаяОбработка = Истина;
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("АналитикаНоменклатуры", АналитикаНоменклатурыПМ);
	ПараметрыПМ.Вставить("ПараметрыНоменклатуры", ПараметрыНоменклатуры);
	ПМ_ОбработатьСобытие("ПриПолученииПараметровНоменклатуры", ПараметрыПМ, СтандартнаяОбработка);
	
	Если Не СтандартнаяОбработка Тогда
		ПараметрыНоменклатуры = ПараметрыПМ.ПараметрыНоменклатуры;
	Иначе
		Номенклатура = АналитикаНоменклатуры.Номенклатура;
		ИмяСправочника = Номенклатура.Метаданные().ПолноеИмя();
		Если ЕстьНеобходимыеМетаданные(ИмяСправочника + ".Реквизиты.Артикул") Тогда
			ПараметрыНоменклатуры.Артикул = ЗначениеРеквизитаОбъекта_Марк(Номенклатура, "Артикул");
		КонецЕсли;
		ПараметрыНоменклатуры.Штрихкоды = Интеграция_ШтрихкодыНоменклатуры(АналитикаНоменклатуры);
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(КлючКэш, ПараметрыНоменклатуры);
	КонецЕсли;
	
	Возврат ПараметрыНоменклатуры;
	
КонецФункции

