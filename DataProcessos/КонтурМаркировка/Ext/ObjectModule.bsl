Функция ДопустимыеВидыПервичногоДокумента(ПричинаВыводаИзОборота) Экспорт
	
	ВидыДокументов = Перечисление_ВидыПервичныхДокументов();
	ПричиныВывода = Перечисление_ПричиныВыводаИзОборота();
	
	Результат = Новый Массив;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.РозничнаяПродажа Тогда
		Результат.Добавить(ВидыДокументов.КассовыйЧек);
		Результат.Добавить(ВидыДокументов.ТоварныйЧек);
		Результат.Добавить(ВидыДокументов.Прочее);
	КонецЕсли;
		
	Если ПричинаВыводаИзОборота = ПричиныВывода.ДистанционныйСпособПродажи Тогда
		Результат.Добавить(ВидыДокументов.УПД);
		Результат.Добавить(ВидыДокументов.КассовыйЧек);
		Результат.Добавить(ВидыДокументов.ТоварныйЧек);
		Результат.Добавить(ВидыДокументов.ТоварнаяНакладная);
		Результат.Добавить(ВидыДокументов.Прочее);
	КонецЕсли;
		
	Если ПричинаВыводаИзОборота = ПричиныВывода.Конфискация Тогда
		Результат.Добавить(ВидыДокументов.УПД);
		Результат.Добавить(ВидыДокументов.Прочее);
		Результат.Добавить(ВидыДокументов.ТоварнаяНакладная);
	КонецЕсли;
		
	Если ПричинаВыводаИзОборота = ПричиныВывода.Уничтожение Тогда
		Результат.Добавить(ВидыДокументов.АктУничтожения);
		Результат.Добавить(ВидыДокументов.Прочее);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.ЭкспортЗаПределыЕАЭС Тогда
		Результат.Добавить(ВидыДокументов.ТаможеннаяДекларация);
		Результат.Добавить(ВидыДокументов.Прочее);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.БезвозмезднаяПередача Тогда
		Результат.Добавить(ВидыДокументов.ТоварнаяНакладная);
		Результат.Добавить(ВидыДокументов.Прочее);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.ПродажаПоОбразцам Тогда
		Результат.Добавить(ВидыДокументов.КассовыйЧек);
		Результат.Добавить(ВидыДокументов.ТоварныйЧек);
		Результат.Добавить(ВидыДокументов.ТоварнаяНакладная);
		Результат.Добавить(ВидыДокументов.УПД);
		Результат.Добавить(ВидыДокументов.Прочее);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.Утрата
		Или ПричинаВыводаИзОборота = ПричиныВывода.ВозвратФизическомуЛицу
		Или ПричинаВыводаИзОборота = ПричиныВывода.ДляСобственныхНужд
		Или ПричинаВыводаИзОборота = ПричиныВывода.ПродажаЧерезВендинговыйАппарат
		Или ПричинаВыводаИзОборота = ПричиныВывода.ДляПроизводственныхЦелей
		Или ПричинаВыводаИзОборота = ПричиныВывода.Утилизация
		Или ПричинаВыводаИзОборота = ПричиныВывода.Фасовка
		Или ПричинаВыводаИзОборота = ПричиныВывода.ИстечениеСрокаГодности
		Или ПричинаВыводаИзОборота = ПричиныВывода.Прочее
		Или ПричинаВыводаИзОборота = ПричиныВывода.КорректировкаСкладскихОстатков
		Или ПричинаВыводаИзОборота = ПричиныВывода.ИспользованиеДляМедицинскогоПрименения
		Или ПричинаВыводаИзОборота = ПричиныВывода.ОтзывСРынка
		Или ПричинаВыводаИзОборота = ПричиныВывода.ПересортицаПоКодам Тогда
		Результат.Добавить(ВидыДокументов.Прочее);
	КонецЕсли;

	Если ПричинаВыводаИзОборота = ПричиныВывода.ДляПроизводственныхЦелей Тогда
		Результат.Добавить(ВидыДокументов.ЭлектронныйCертификат);
		Результат.Добавить(ВидыДокументов.АкПротезноОртопедическогоИзделия);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДопустимыеПричиныВыводаИзОборота(ВидПродукции, ОбъемноСортовойУчет) Экспорт
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВидПродукции", ВидПродукции);
	
	Если ОбъемноСортовойУчет Тогда
		Отбор.Вставить("ОСУ", Истина);
	Иначе
		Отбор.Вставить("ПУ", Истина);
	КонецЕсли;
	
	Результат = Новый Массив;
	Для Каждого Стр Из ДопустимыеПричиныВыводаИзОборотаПоВидамПродукции().НайтиСтроки(Отбор) Цикл
		Результат.Добавить(Стр.ПричинаВыводаИзОборота);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДопустимыеПричиныВыводаИзОборотаПоВидамПродукции()
	
	КлючКэш = "ДопустимыеПричиныВыводаИзОборотаПоВидамПродукции";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	ПричиныВывода = Перечисление_ПричиныВыводаИзОборота();
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ВидПродукции", Новый ОписаниеТипов("ПеречислениеСсылка.КонтурМаркировка_ВидыПродукции"));
	Результат.Колонки.Добавить("ПричинаВыводаИзОборота", ОписаниеТипа_Строка());
	Результат.Колонки.Добавить("ОСУ", ОписаниеТипа_Булево());
	Результат.Колонки.Добавить("ПУ", ОписаниеТипа_Булево());
	
	СтрокаПричиныВывода = 1;
	КолонкаВидаПродукции = 1;
	
	ТабДок = МакетОбработки("ПричиныВыводаИзОборота");
	
	Для Строка = 2 По ТабДок.ВысотаТаблицы Цикл
		
		ВидПродукцииСтр = СокрЛП(ТабДок.ПолучитьОбласть(Строка, КолонкаВидаПродукции).ТекущаяОбласть.Текст);
		
		Для Колонка = 2 По ТабДок.ШиринаТаблицы Цикл
			
			ПричинаВыводаСтр = СокрЛП(ТабДок.ПолучитьОбласть(СтрокаПричиныВывода, Колонка).ТекущаяОбласть.Текст);
			
			Стр = Результат.Добавить();
			Стр.ВидПродукции = ВидыПродукции[ВидПродукцииСтр];
			Стр.ПричинаВыводаИзОборота = ПричиныВывода[ПричинаВыводаСтр];
			
			Значение = СокрЛП(ТабДок.ПолучитьОбласть(Строка, Колонка).ТекущаяОбласть.Текст);
			
			Если Значение = "ОСУ" Тогда
				Стр.ОСУ = Истина;
			КонецЕсли;
			
			Если Значение = "ПУ" Тогда
				Стр.ПУ = Истина;
			КонецЕсли;
			
			Если Значение = "ОСУ/ПУ" Тогда
				Стр.ОСУ = Истина;
				Стр.ПУ = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Результат.Индексы.Добавить("ВидПродукции, ОСУ");
	Результат.Индексы.Добавить("ВидПродукции, ПУ");
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ДопустимыеПричиныПеремаркировки(ВидПродукции) Экспорт
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	ПричиныПеремаркировки = Перечисление_ПричиныПеремаркировки();
	
	Если ВидПродукции = ВидыПродукции.МедицинскиеИзделия
		Или ВидПродукции = ВидыПродукции.Антисептики
		Или ВидПродукции = ВидыПродукции.Бады Тогда
		
		Результат = Новый Массив;
		Результат.Добавить(ПричиныПеремаркировки.ИспорченоЛибоУтеряноСИСКМ);
		
	Иначе
		Результат = МассивЗначенийИзСтруктуры(ПричиныПеремаркировки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДопустимыеТипыПроизводственныхЗаказов(ВидПродукции) Экспорт
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	ТипыПроизводственныхЗаказов = Перечисление_ТипыПроизводственныхЗаказов();
	
	Результат = Новый Массив;
	Результат.Добавить(ТипыПроизводственныхЗаказов.СобственноеПроизводство);
	
	Если ВидПродукции <> ВидыПродукции.Оптоволокно Тогда
