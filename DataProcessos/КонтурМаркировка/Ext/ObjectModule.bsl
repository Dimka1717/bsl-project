	|	КодыДокументов.КлючКода КАК КлючКода,
	|	ИнформацияОКодах.ОбщийТипУпаковки КАК ОбщийТипУпаковки,
	|	ИнформацияОКодах.НомерПартии КАК НомерПартии,
	|	ТоварыАгрегатов.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	ТоварыАгрегатов.Товар КАК Товар,
	|	МАКСИМУМ(ЕСТЬNULL(ИнформацияОКодах.Товар.ВидПродукции, ИнформацияОКодах.ВидПродукции)) КАК ВидПродукции,
	|	СУММА(ТоварыАгрегатов.КоличествоУпаковок) КАК КоличествоКИ
	|ПОМЕСТИТЬ ТаблицаАгрегатов
	|ИЗ
	|	ДокументыУчета КАК ДокументыУчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО ДокументыУчета.ИсправляемыйДокументУчета = КодыДокументов.ДокументУчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ПО ДокументыУчета.ИсправляемыйДокументУчета = ТоварыДокумента.Ссылка
	|			И (КодыДокументов.КлючСтрокиДокумента = ТоварыДокумента.КлючСтрокиДокумента)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументовПосле
	|		ПО ДокументыУчета.ДокументУчета = КодыДокументовПосле.ДокументУчета
	|			И (КодыДокументов.КлючКода = КодыДокументовПосле.КлючКода)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ТоварыАгрегатов КАК ТоварыАгрегатов
	|		ПО (КодыДокументов.КлючКода = ТоварыАгрегатов.КлючКода)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО (КодыДокументов.КлючКода = КодыМаркировки.КлючКода)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючей
	|		ПО (КодыДокументов.КлючКода = СвязиКлючей.КлючКода)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (СвязиКлючей.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	ТоварыАгрегатов.КлючКода ЕСТЬ НЕ NULL 
	|	И КодыДокументовПосле.КлючКода ЕСТЬ NULL
	|	И ТоварыДокумента.КлючСтрокиДокумента ЕСТЬ NULL
	|	И ИнформацияОКодах.ДляВнутреннегоУчета = ЛОЖЬ
	|	И ИнформацияОКодах.ОбщийТипУпаковки = &Транспортная
	|
	|СГРУППИРОВАТЬ ПО
	|	ДокументыУчета.ДокументУчета,
	|	КодыМаркировки.КодМаркировки,
	|	КодыДокументов.КлючКода,
	|	ИнформацияОКодах.ОбщийТипУпаковки,
	|	ИнформацияОКодах.НомерПартии,
	|	ТоварыАгрегатов.Товар,
	|	ТоварыАгрегатов.КлючНоменклатуры1С");
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("Транспортная", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	Запрос.Выполнить();
	
КонецПроцедуры

