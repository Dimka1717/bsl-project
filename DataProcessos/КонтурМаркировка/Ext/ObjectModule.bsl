	|ГДЕ
	|	СерийныеНомераТранспортныхУпаковок.ТипКода = &СтарыйТипКода");
	
	Запрос.УстановитьПараметр("СтарыйТипКода", СтарыйТипКода);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Запись = РегистрыСведений.КонтурМаркировка_СерийныеНомераТранспортныхУпаковок.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.Прочитать();
		
		Запись.ТипКода = НовыйТипКода;
