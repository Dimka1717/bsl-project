	ПараметрыРаспределения.РазрешитьПустуюСериюИсточника = Истина;
	Для Каждого СтрМарк Из СведенияОМаркировке_ДоступныеСтрокиОСУ(ТаблицаМаркировки) Цикл
		СведенияОМаркировке_Распределить_ОСУ_МеньшеОднойУпаковки(СтрМарк, ТоварыДокументов, ПараметрыРаспределения);
	КонецЦикла;
	
	ПараметрыРаспределения.РазрешитьПустуюХарактеристикуИсточника = Истина;
	Для Каждого СтрМарк Из СведенияОМаркировке_ДоступныеСтрокиОСУ(ТаблицаМаркировки) Цикл
		СведенияОМаркировке_Распределить_ОСУ_МеньшеОднойУпаковки(СтрМарк, ТоварыДокументов, ПараметрыРаспределения);
	КонецЦикла;
	
	ПараметрыРаспределения.РазрешитьПустуюСериюПриемника = Истина;
	Для Каждого СтрМарк Из СведенияОМаркировке_ДоступныеСтрокиОСУ(ТаблицаМаркировки) Цикл
		СведенияОМаркировке_Распределить_ОСУ_МеньшеОднойУпаковки(СтрМарк, ТоварыДокументов, ПараметрыРаспределения);
	КонецЦикла;
	
	ПараметрыРаспределения.РазрешитьПустуюХарактеристикуПриемника = Истина;
	Для Каждого СтрМарк Из СведенияОМаркировке_ДоступныеСтрокиОСУ(ТаблицаМаркировки) Цикл
		СведенияОМаркировке_Распределить_ОСУ_МеньшеОднойУпаковки(СтрМарк, ТоварыДокументов, ПараметрыРаспределения);
	КонецЦикла;
	
