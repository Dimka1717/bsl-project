// Записывает операцию в базу
//
// Параметры:
//  ОписаниеОперации - Структура - см. Новый_Операция()
// 
// Возвращаемое значение:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - записанная операция
//
Функция ЗаписатьОперацию(ОписаниеОперации) Экспорт
	
	ВызыватьИсключение = Истина;
	ПроверитьУстановленнуюВерсиюМодуля(ВызыватьИсключение);
	
	Возврат Операция_Записать(ОписаниеОперации);
	
КонецФункции

// Возвращает описание операции совместимое с ПМ
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция
// 
// Возвращаемое значение:
//  Операция - Структура - см. НовоеОписаниеОперации()
//
Функция ПрочитатьОперацию(Операция) Экспорт
	
	Результат = Операция_ПрочитатьОперацию(Операция);
	
	ЗаполнитьОписаниеОперацииДляСовместимостиПМ(Результат);
	
	Возврат Результат;
	
КонецФункции

// Возвращает таблицу операций по документу учета с отобром по типам и статусам
//
// Параметры:
//  Документ - СправочникСсылка.КонтурМаркировка_ДокументыУчета, ДокументСсылка - документ 1С или документ учета;
//  ТипыОпераций - Массив - (необязательный) фильтр по типам операций, см Перечисление_ТипыОпераций();
//  СтатусыОпераций - Массив - (необязательный) фильтр по статусам операций, см. Перечисление_СтатусыОпераций();
//  ОперацииОснования - Массив - (необязательный) фильтр по операциям основания;
//  БезОперацииОснования - Булево - (необязадельный) Истина, если нужны операции в которых нет операции основания;
//
// Возвращаемое значение:
//  ТаблицаЗначений - содержит колонки:
//   * ОперацияСсылка - СправочникСсылка.КонтурМаркировка_Операции;
//   * ТипОперации    - Строка - см. Перечисление_ТипыОпераций();
//   * Статус         - Строка - см. Перечисление_СтатусыОпераций();
//
Функция ОперацииДокумента(Документ
	, ТипыОпераций = Неопределено
	, СтатусыОпераций = Неопределено
	, ОперацииОснования = Неопределено
	, БезОперацииОснования = Ложь) Экспорт
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ);
	
	Возврат ДокументУчета_СписокОпераций(ДокументУчета
	, ТипыОпераций
	, СтатусыОпераций
	, ОперацииОснования
	, БезОперацииОснования)
	
КонецФункции

// Создает операцию указанного типа, заполняет ее данными документа и записывает в базу
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С;
//             - СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ учета;
//  ТипОперации - Строка - см. Перечисление_ТипыОпераций();
//  ОперацияОснование - СправочникСсылка.КонтурМаркировка_Операции - (необязательный)
//                           операция, на основании которой создается новая операция;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Операции - созданная операция
//
Функция СоздатьОперациюПоДокументу(Документ1С, ТипОперации, ОперацияОснование = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ1С) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен документ 1С'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипОперации) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен тип операции'");
	КонецЕсли;
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С, Истина);
	
	Результат = Операция_Создать(ТипОперации, ДокументУчета, ОперацияОснование);
	
	Возврат Результат;
	
КонецФункции

// Возвращает коды из электронного документа, на основании которого создана сверка на приемке
//
// Параметры:
//  ОрганизацияПолучатель - СправочникСсылка - организация получатель электронного документа;
//  ИННОтправителя        - Строка - ИНН отправителя электронного документа;
//  НомерДокумента        - Строка - номер электронного документа;
//  ДатаДокумента         - Дата   - дата электронного документа (с точностью до дня);
//  ОписаниеОшибки        - Строка - исходящий параметр, содержит ошибку возникшую при выполнении функции;
// 
// Возвращаемое значение:
//  Массив - содержит структуры с полями:
//   * НомерСтроки        - Число  - номер строки в табличной части электронного документа;
//   * НаименованиеТовара - Строка - наименование товара;
//   * КодыМаркировки     - Массив - содержит структуры с полями:
//      ** КодМаркировки          - Строка - значение штрихкода;
//      ** ВложенныеКоды          - Массив - содержит аналогичные структуры с вложенными кодами;
//      ** Отсканирован           - Булево, Неопределено - Истина, если код был отсканирован;
//      ** ВведенВОборот          - Булево, Неопределено - Ложь, если код не введен в оборот;
//      ** ПринадлежитОтправителю - Булево, Неопределено - Ложь, если код не принадлежит отправителю;
//      ** КорректныйФорматКода   - Булево, Неопределено - Ложь, если код имеет некорректный формат передачи в УПД;
//      ** ЕстьДействующийРД      - Булево, Неопределено - Ложь, если код имеет ошибки разрешительной документации;
//
Функция КодыДокументаИзСверкиНаПриемке(ОрганизацияПолучатель, ИННОтправителя, НомерДокумента, ДатаДокумента,
	ОписаниеОшибки = Неопределено) Экспорт
	
	Результат = Новый Массив;
	
	Организация = Организация_НайтиПоОрганизации1С(ОрганизацияПолучатель);
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		
		ТекстОшибки = НСтр("ru = 'Не удалось найти настройку организации ""%1"" в подсистеме маркировки'");
		ОписаниеОшибки = ПараметрыВСтроку(ТекстОшибки, ОрганизацияПолучатель);
		
		Возврат Результат;
		
	КонецЕсли;
	
	Операция = Операция_НайтиОперацию_ВходящийУПД(Организация, ИННОтправителя, НомерДокумента, ДатаДокумента);
	
	Если Не ЗначениеЗаполнено(Операция) Тогда
		
		ТекстОшибки = НСтр("ru = 'Не удалось найти операцию сверки на приемке по электронному документу №%1 от %2'");
		ДатаДокументаСтрокой = Формат(ДатаДокумента, "ДФ=dd.MM.yyyy");
		ОписаниеОшибки = ПараметрыВСтроку(ТекстОшибки, НомерДокумента, ДатаДокументаСтрокой);
		
		Возврат Результат;
		
	КонецЕсли;
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	
	РезультатСверки = Операция_ВходящийУПД_РезультатСверки(ОписаниеОперации);
	
	Результат = РезультатСверки.КодыДокумента;
	
	Возврат Результат;
	
КонецФункции

// Удаляет все операции указанного типа по документу 1С
//
// Параметры:
//  Документ - ДокументСсылка, СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ 1С;
//  ТипОпераций - Строка - см. Перечисление_ТипыОпераций();
//
Процедура УдалитьОперацииПоДокументу(Документ, ТипОпераций) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен документ 1С'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипОпераций) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен тип операции'");
	КонецЕсли;
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ, Истина);
	МассивОпераций = Операция_НайтиОперации(ТипОпераций, ДокументУчета);
	
	УдалитьОперации(МассивОпераций);
	
КонецПроцедуры

// Удаляет операции маркировки из справочника
//
// Параметры:
//  МассивОпераций - Массив из СправочникСсылка.КонтурМаркировка_Операции
//
Процедура УдалитьОперации(МассивОпераций) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		Операции_Удалить(МассивОпераций);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Перезаполняет операцию маркировки
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция
//
Процедура ПерезаполнитьОперацию(Операция) Экспорт
	
	Операция_Перезаполнить(Операция);
	
КонецПроцедуры

// Возвращает статус первой незавершенной операции или статус последней если все операции завершены
//
// Параметры:
//  Документ - ДокументСсылка, СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ 1С или документ учета;
//  ТипОперации - Строка - см. Перечисление_ТипыОпераций();
//
// Возвращаемое значение:
//  Строка - статус операции;
//
Функция СтатусОперацииПоДокументу(Документ, ТипОперации) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен документ 1С'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипОперации) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен тип операции'");
	КонецЕсли;
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ, Истина);
	МассивОпераций = Операция_НайтиОперации(ТипОперации, ДокументУчета);
	
	Если Не ЗначениеЗаполнено(МассивОпераций) Тогда
		ВызватьИсключение НСтр("ru = 'Не найдена подходящая операция для получения статуса'");
	КонецЕсли;
	
	Для Каждого Операция Из МассивОпераций Цикл
		
		Результат = Операция_ОсновнойСтатус(Операция);
		Если Не Операция_Завершена(Результат) Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает основной статус операции
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция;
// 
// Возвращаемое значение:
//  Строка - см. Перечисление_СтатусыОпераций()
//
Функция ОсновнойСтатусОперации(Операция) Экспорт
	
	Если Не ЗначениеЗаполнено(Операция) Тогда
		ВызватьИсключение НСтр("ru = 'Не указана операция для получения основного статуса'");
	КонецЕсли;
	
	Результат = Операция_ОсновнойСтатус(Операция);
	
	Возврат Результат;
	
КонецФункции

// Возвращает массив операций указанного типа по документу
//
// Параметры:
//  Документ - ДокументСсылка, СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ 1С или документ учета;
//  ТипОпераций - Строка - см. Перечисление_ТипыОпераций();
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.КонтурМаркировка_Операции - операции;
//
Функция ОперацииПоДокументу(Документ, ТипОпераций) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен документ 1С'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипОпераций) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен тип операции'");
	КонецЕсли;
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ, Истина);
	Результат = Операция_НайтиОперации(ТипОпераций, ДокументУчета);
	
	Возврат Результат;
	
КонецФункции

// Добавляет операцию в регистр сведений очередь обмена
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция;
//
Процедура ДобавитьОперациюВОчередьОбмена(Операция) Экспорт
	
	Если Не ЗначениеЗаполнено(Операция) Тогда
		ВызватьИсключение НСтр("ru = 'Не указана операция, которую надо добавить в очередь обмена'");
	КонецЕсли;
	
	Если Задача_Прочитать(Операция) <> Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Работа по операции уже начата'");
	КонецЕсли;
	
	Задача_Создать(Операция);
	
КонецПроцедуры

// Получает коды маркировки операции
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция, коды которой нужно получить;
//  КлючСтрокиОперации - УникальныйИдентификатор - (необязательный) ключ строки операции основания;
// 
// Возвращаемое значение:
//  ТаблицаЗначений - см. Новый_ТаблицаКодов();
//
Функция ПрочитатьКодыОперации(Операция, КлючСтрокиОперации = Неопределено) Экспорт
	
	Возврат КодыОпераций_Прочитать(Операция, КлючСтрокиОперации);
	
КонецФункции

// Создает и заполняет операцию по таблице кодов
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С;
//  ТипОперации - Строка - см. Перечисление_ТипыОпераций();
//  ТаблицаКодов - ТаблицаЗначений - см. Новый_ТаблицаКодов()
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Операции - созданная операция
//
Функция СоздатьОперациюПоДокументуИЗагрузитьКоды(Документ1С, ТипОперации, ТаблицаКодов) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ1С) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен документ 1С'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипОперации) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен тип операции'");
	КонецЕсли;
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С, Истина);
	
	ТаблицаКодов_ДополнитьИнформациейИБ(ТаблицаКодов);
	
	Возврат Операция_Создать(ТипОперации, ДокументУчета, , , ТаблицаКодов);
	
КонецФункции

// Проверяет заполнение операции
//
// Параметры:
//  Операция - СправочникСсылка.Операция, Структура - операция или см. функцию Новый_Операция();
// 
// Возвращаемое значение:
//  Массив - содержит структуры с полями:
//   * ТекстОшибки - Строка - описание ошибки;
//   * ИмяПоля - Строка - имя поля документа, связанного с ошибкой;
//   * ИмяТаблицы - Строка - имя табличной, части связанной с ошибкой;
//   * НомерСтроки - Число - номер строки табличной части;
//
Функция ПроверитьЗаполнениеОперации(Операция) Экспорт
	
	Если ТипЗнч(Операция) = Тип("СправочникСсылка.КонтурМаркировка_Операции") Тогда
		ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	Иначе
		ОписаниеОперации = Операция;
	КонецЕсли;
	
	Возврат Операция_Проверить(ОписаниеОперации);
	
КонецФункции

// #КонецОбласти // Операции

// #Область КодыМаркировки

// Добавляет коды в документ
//
// Параметры:
//  Документ - ДокументСсылка, СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ 1С или документ учета;
//  ТаблицаКодов  - ТаблицаЗначений - см. ТаблицаНовыхКодов();
//  ПараметрыЗагрузкиКодов - Структура - (необязательный), см. ПараметрыЗагрузкиНовыхКодовВДокумент()
//
Процедура ДобавитьНовыеКодыВДокумент(Документ, ТаблицаКодов, ПараметрыЗагрузкиКодов = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен документ'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнена коллекция кодов'");
	КонецЕсли;
	
	Если ПараметрыЗагрузкиКодов = Неопределено Тогда
		ПараметрыЗагрузкиКодов = Новый_ПараметрыЗагрузкиНовыхКодовВДокумент();
	КонецЕсли;
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ, Истина);
	
	КодыДокументов_ДобавитьНовыеКоды(ТаблицаКодов, ДокументУчета, ПараметрыЗагрузкиКодов);
	
	Функциональность = Перечисление_ФункциональностьМодуля().ДобавитьКодыВДокумент;
	Метрика_Функциональность_ЗагрузкаКодовВДокумент(ДокументУчета, Функциональность);
	
КонецПроцедуры

// Нормализует коды маркировки и создает карточки товаров если их нет
//
// Параметры:
//  ОписанияИлиТаблицаКодов - Массив, Таблица значений - содержит структуры см. функцию ОписаниеКодаМаркировки()
//                            или строки см. функцию ТаблицаНовыхКодов(), в которых поле КодМаркировки должно быть заполнено
//  Организация1С - СправочникСсылка - организация;
// 
// Возвращаемое значение:
//  Булево - Ложь, если при распознавании кодов возникли ошибки,
//           детали указаны в поле ОписаниеОшибки
//
Функция РаспознатьКоды(ОписанияИлиТаблицаКодов, Организация1С) Экспорт
	
	Если Не ЗначениеЗаполнено(ОписанияИлиТаблицаКодов) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТипЗнч(Организация1С) = Тип("СправочникСсылка.КонтурМаркировка_Организации") Тогда
		Организация = Организация1С;
	Иначе
		Организация = Организация_НайтиПоОрганизации1С(Организация1С, Истина);
	КонецЕсли;
	
	Если ТипЗнч(ОписанияИлиТаблицаКодов) = Тип("ТаблицаЗначений") Тогда
		ТаблицаКодов = ОписанияИлиТаблицаКодов;
		ВосстановитьТаблицуКодовДляСовместимостиМодуль(ТаблицаКодов);
	Иначе
		ТаблицаКодов = ТаблицаКодовИзОписанийКодов(ОписанияИлиТаблицаКодов);
	КонецЕсли;
	
	Если Не ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТаблицаКодов_ДополнитьИнформациейИБ(ТаблицаКодов);
	
	Если ЭтоМассив(ОписанияИлиТаблицаКодов) Тогда
		ОписанияИлиТаблицаКодов = ОписанияКодовИзТаблицыКодов(ТаблицаКодов);
	ИначеЕсли ЭтоСтруктура(ОписанияИлиТаблицаКодов) Тогда
		ОписанияИлиТаблицаКодов = ОписанияКодовИзТаблицыКодов(ТаблицаКодов)[0];
	Иначе
		ОписанияИлиТаблицаКодов = ТаблицаКодов;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Генерирует нужное количество новых штрихкодов для агрегатов
//
// Параметры:
//  ВидАгрегата - СправочникСсылка.КонтурМаркировка_ВидыАгрегатов - вид агрегата;
//  КоличествоКодов - Число - (необязательный) количество кодов, которые нужно сгенерировать;
// 
// Возвращаемое значение:
//  Массив - содержит строки с новыми кодами
//
Функция СформироватьНовыеКодыАгрегатов(ВидАгрегата, КоличествоКодов = 1) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ТипШтрихкода = ВидАгрегата.ТипШтрихкода;
		КодыАгрегатов = НовыеКодыТранспортныхУпаковок(ВидАгрегата, КоличествоКодов);
		
		ТаблицаКодов = Новый_ТаблицаКодов();
		Для каждого КодАгрегата Из КодыАгрегатов Цикл
			Стр = ТаблицаКодов.Добавить();
			Стр.ДляНанесения = Истина;
			Стр.КодМаркировки = КодАгрегата;
			Стр.ПолныйКод = КодАгрегата;
			Стр.ТипШтрихкода = ТипШтрихкода;
			Стр.ВидАгрегата = ВидАгрегата;
			Стр.ТипУпаковки = Перечисления.КонтурМаркировка_ТипыУпаковок.МонотоварнаяУпаковка;
			Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка;
		КонецЦикла;
		
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат КодыАгрегатов;
	
КонецФункции

// Пытается распознать коды маркировки
// Требуется авторизация в сервсие
//
// Параметры:
//  ТаблицаКодов - Таблица значений - см. Новый_ТаблицаКодов()
//
Процедура НормализоватьКоды(ТаблицаКодов, Организация = Неопределено, ВызыватьИсключение = Истина) Экспорт
	
	ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация, ВызыватьИсключение);
	
КонецПроцедуры

// Подбирает коды маркировки для печати этикеток по документу
//
// Параметры:
//  Документ - ДокументСсылка, СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ 1С или документ учета;
//  ПараметрыПодбораКодов - Структура - (необязательный) содержит поля:
//   * Товар - СправочникСсылка.КонтурМаркировка_Товары - товар маркировки;
//   * Номенклатура - СправочникСсылка - номенклатура 1С;
//   * Характеристика - СправочникСсылка - характеристика номенклатуры;
//   * Упаковка - СправочникСсылка - упаковка;
//   * Серия - СправочникСсылка - серия;
//   * КоличествоКодовТребуется - Число - количество кодов;
// 
// Возвращаемое значение:
//  Массив из Строка - коды маркировки с криптохвостами
//
Функция КодыМаркировкиДляНанесенияПоДокументу(Документ, ПараметрыПодбораКодов = Неопределено) Экспорт
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ, Истина);
	ПараметрыПодбора = Новый_ПараметрыПодбораКодовДляНанесения();
	
	Если ПараметрыПодбораКодов <> Неопределено Тогда
		АналитикаНоменклатуры = Новый_АналитикаНоменклатуры1С();
		ЗаполнитьЗначенияСвойств(АналитикаНоменклатуры, ПараметрыПодбораКодов);
		Если ПараметрыПодбораКодов.Свойство("Номенклатура1С") Тогда
			АналитикаНоменклатуры.Номенклатура = ПараметрыПодбораКодов.Номенклатура1С; // Для совместимости с 2.19
		КонецЕсли;
		ПараметрыПодбора.КлючНоменклатуры1С = КлючНоменклатуры1С_Подобрать(АналитикаНоменклатуры);
	КонецЕсли;
	
	Результат = КодыДокументов_ПолныеКодыДляНанесения(ДокументУчета, ПараметрыПодбора);
	
	Возврат Результат;
	
КонецФункции

// Вызывает событие ПМ ПриЗагрузкеКодовИзВнешнегоИсточника
//
// Параметры:
//  Документ - ДокументСсылка, СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ 1С или документ учета;
//  ДопПараметры - Структура - доп параметры для ПМ;
// 
// Возвращаемое значение:
//  Булево - Истина, если добавить коды удалось
//
Функция ДобавитьКодыВДокументИзВнешнегоИсточника(Документ1С, ДопПараметры = Неопределено) Экспорт
	
	ВызыватьИсключение = Истина;
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С, ВызыватьИсключение);
	
	Возврат КодыДокументов_ДобавитьИзВнешнегоИсточника(ДокументУчета, ДопПараметры);
	
КонецФункции

// Выгружает коды документа 1С в файл
//
// Параметры:
//  Документ - ДокументСсылка, СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ 1С или документ учета;
//  ФорматФайла			 - Строка			 - см. функцию Перечисление_ФорматыФайловСКодами();
//  ВыгружатьПолныеКоды	 - Булево			 - (необязательный) если не указан используется настройка модуля, иначе:
//  			* Истина - если нужно выгрузить коды с криптохвостами;
//  			* Ложь   - если нужно выгрузить коды без криптохвостов;
// 
// Возвращаемое значение:
//  Массив - содержит по умолчанию один элемент, структуру со свойствами:
//  * ИмяФайла - имя, с которым нужно сохранить файл;
//  * ДвоичныеДанные - данные файла;
//
Функция ВыгрузитьКодыДокументаВФайл(Документ, ФорматФайла, ВыгружатьПолныеКоды = Неопределено) Экспорт
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ, Истина);
	
	Возврат ВыгрузитьКодыДокументаУчетаВФайл(ДокументУчета, ФорматФайла, ВыгружатьПолныеКоды);
	
КонецФункции

// Добавляет в базу информацию о кодах
//
// Параметры:
//  ТаблицаКодов - ТаблицаЗначений - см. функцию Новый_ТаблицаКодов();
//  ДобавитьКоличествоВСоставКода - Булево - Истина, если необходимо добавить количество в полный код;
//
Процедура ДобавитьИнформациюОКодах(ТаблицаКодов, ДобавитьКоличествоВСоставКода = Ложь) Экспорт
	
	ТаблицаКодов_ДополнитьКолонки(ТаблицаКодов);
	ТаблицаКодов_ДополнитьИнформациейИБ(ТаблицаКодов);
	
	КодыБезКлючей = ТаблицаКодов_КодыМаркировкиБезКлючей(ТаблицаКодов);
	Если ЗначениеЗаполнено(КодыБезКлючей) Тогда
		ТекстОшибки = НСтр("ru = 'В базе не найдены коды для добавления информации: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, СписокКодовДляТекстаОшибки(КодыБезКлючей));
	КонецЕсли;
	
	Если ДобавитьКоличествоВСоставКода Тогда
		ПолныеКоды_Прочитать(ТаблицаКодов);
		ТаблицаКодов_ДобавитьКоличествоВПолныеКоды(ТаблицаКодов);
	КонецЕсли;
	
	ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
	
КонецПроцедуры

// Находит в базе коды по серийным номерам и товарам, которым они принадлежат,
// затем заполняет информацию о них в таблице кодов.
// Товары должны быть указаны в таблице кодов, либо переданы общим списком.
//
// Параметры:
//  ТаблицаКодов - ТаблицаЗначений - см. функцию Новый_ТаблицаКодов();
//  Товары - Массив, СправочникСсылка.КонтурМаркировка_Товары - обязательный, если товары не указаны в таблице кодов;
//
Процедура ПрочитатьИнформациюОКодахПоСерийнымНомерам(ТаблицаКодов, Товары = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТаблицаКодов.Найти(Справочники.КонтурМаркировка_Товары.ПустаяСсылка(), "Товар") = Неопределено Тогда
		
		// Товары уже указаны в таблице кодов
		ТаблицаКодов_НайтиКлючиПоСерийнымНомерам(ТаблицаКодов);
		
	Иначе
		
		// Пробуем найти коды по списку товаров
		Если Не ЗначениеЗаполнено(Товары) Тогда
			ВызватьИсключение НСтр("ru = 'Не удалось найти коды маркировки по серийным номерам, не указаны товары'");
		КонецЕсли;
		
		ПустойКлюч = ПустойУникальныйИдентификатор();
		ИндексСерийныйНомер = ТаблицаКодов.Индексы.Добавить("СерийныйНомер");
		
		Для каждого Товар Из ЗначениеВМассиве(Товары) Цикл
			
			ПустыеСтроки = ТаблицаКодов.НайтиСтроки(Новый Структура("КлючКода", ПустойКлюч));
			Если Не ЗначениеЗаполнено(ПустыеСтроки) Тогда
				Прервать; // Нашли все коды
			КонецЕсли;
			
			ТаблицаДляПоиска = Новый_ТаблицаКодов();
			Для каждого СтрКода Из ПустыеСтроки Цикл
				Стр = ТаблицаДляПоиска.Добавить();
				Если ЗначениеЗаполнено(СтрКода.СерийныйНомер) Тогда
					Стр.СерийныйНомер = СтрКода.СерийныйНомер;
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрКода.Товар) Тогда
					Стр.Товар = Товар;
				КонецЕсли;
			КонецЦикла;
			ТаблицаКодов_НайтиКлючиПоСерийнымНомерам(ТаблицаДляПоиска);
			
			Для каждого Стр Из ТаблицаДляПоиска Цикл
				
				Если Не ЗначениеЗаполнено(Стр.КлючКода) Тогда
					Продолжить;
				КонецЕсли;
				
				Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Новый Структура("СерийныйНомер", Стр.СерийныйНомер)) Цикл
					
					Если ЗначениеЗаполнено(СтрКода.КлючКода) И СтрКода.КодМаркировки <> Стр.КодМаркировки Тогда
						ШаблонОшибки = НСтр("ru = 'Не удалось найти коды маркировки,
						|серийный номер ""%1"" подходит сразу к нескольким кодам маркировки: %2, %3'");
						ВызватьИсключение ПараметрыВСтроку(ШаблонОшибки, Стр.СерийныйНомер, Стр.КодМаркировки, СтрКода.КодМаркировки);
					КонецЕсли;
					
					СтрКода.КлючКода = Стр.КлючКода;
					СтрКода.КодМаркировки = Стр.КодМаркировки;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
		ТаблицаКодов.Индексы.Удалить(ИндексСерийныйНомер);
		
	КонецЕсли;
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
КонецПроцедуры

// Очищает в базе информацию о кодах по указанным полям
//
// Параметры:
//  КодыМаркировки - Массив, Строка - код или коллекция нормализованных кодов;
//  ИменаПолей - Массив, Строка - поля разделенные запятой или массив полей, которые нужно очистить;
//
Процедура ОчиститьИнформациюОКодах(КодыМаркировки, ИменаПолей) Экспорт
	
	Если ТипЗнч(ИменаПолей) = Тип("Строка") Тогда
		МассивПолей = РазделитьСтроку(ИменаПолей);
	Иначе
		МассивПолей = ИменаПолей;
	КонецЕсли;
	
	МассивДопустимыхПолей = РазделитьСтроку(ИнформацияОКодах_ИменаПолей());
	МассивДопустимыхПолей.Добавить("ЗаводскойСерийныйНомер");
	МассивДопустимыхПолей.Добавить("Количество");
	
	Для каждого ИмяПоля Из МассивПолей Цикл
		Если Не МассивСодержитЗначение(МассивДопустимыхПолей, ИмяПоля) Тогда
			ТекстОшибки = НСтр("ru = 'Недопустимое поле для очистки информации о кодах: %1'");
			ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаКодов = ТаблицаКодов_ЗагрузитьКодыМаркировки(КодыМаркировки);
	ТаблицаКодов_ЗаполнитьКлючиКодов(ТаблицаКодов);
	
	КодыБезКлючей = ТаблицаКодов_КодыМаркировкиБезКлючей(ТаблицаКодов);
	Если ЗначениеЗаполнено(КодыБезКлючей) Тогда
		ТекстОшибки = НСтр("ru = 'Не найдены коды для очистки информации: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, СписокКодовДляТекстаОшибки(КодыБезКлючей));
	КонецЕсли;
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	Для каждого ИмяПоля Из МассивПолей Цикл
		ТаблицаКодов.ЗаполнитьЗначения(Неопределено, ИмяПоля);
	КонецЦикла;
	
	ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
	
КонецПроцедуры

// Добавляет в таблицу кодов вложенные коды и читает информацию по ним
//
// Параметры:
//  ТаблицаКодов - ТаблицаЗначений - см. функцию Новый_ТаблицаКодов();
//
Процедура ДобавитьВложенныеКодыВТаблицуКодов(ТаблицаКодов) Экспорт
	
	ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
КонецПроцедуры

// Добавляет в таблицу кодов вложенные коды всех уровней и читает информацию по ним
//
// Параметры:
//  ТаблицаКодов - ТаблицаЗначений - см. функцию Новый_ТаблицаКодов();
//
Процедура ДобавитьВсеВложенныеКодыВТаблицуКодов(ТаблицаКодов) Экспорт
	
	ТаблицаКодов_ДобавитьКлючиВсехВложенныхКодов(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
КонецПроцедуры

// Заполняет связи ключей, коды маркировки, а также информацию из регистров
// КонтурМаркировка_СтатусыКодовГИСМТ и КонтурМаркировка_ИнформацияОКодах
//
// Параметры:
//  ТаблицаКодов - ТаблицаЗначений - см. функцию Новый_ТаблицаКодов();
//
Процедура ЗаполнитьВсюИнформациюВТаблицеКодов(ТаблицаКодов) Экспорт
	
	Если ТаблицаКодов_ЕстьПустыеКлючиКодов(ТаблицаКодов) Тогда
		ТаблицаКодов_ЗаполнитьКлючиКодов(ТаблицаКодов);
	КонецЕсли;
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
КонецПроцедуры

// Добавляет в таблицу кодов полные коды
//
// Параметры:
//  ТаблицаКодов - ТаблицаЗначений - см. функцию Новый_ТаблицаКодов();
//  ЗаменитьGS - Булево - Истина, если необходимо заменить разделитель GS1 на строку \u001d
//
Процедура ДобавитьПолныеКодыВТаблицуКодов(ТаблицаКодов, ЗаменитьGS = Ложь) Экспорт
	
	ПолныеКоды_Прочитать(ТаблицаКодов);
	
	Если ЗаменитьGS Тогда
		ТаблицаКодов_ЗаменитьРазделителиGS1(ТаблицаКодов);
	КонецЕсли;
	
КонецПроцедуры

// Расформировывает агрегат
//
// Параметры:
//  КодАгрегата - Строка - код маркировки агрегата
//
Процедура РасформироватьАгрегат(КодАгрегата) Экспорт
	
	КлючАгрегата = КодМаркировки_НайтиКлюч(КодАгрегата);
	КодМаркировки_РасформироватьАгрегат(КлючАгрегата);
	
КонецПроцедуры

