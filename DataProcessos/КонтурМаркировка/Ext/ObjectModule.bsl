Процедура Операция_ВводВОборот_ДобавитьПодходящиеТовары_Бакалея(ПодходящиеТовары, МенеджерВТ, ВидПродукции, СпособВводаВОборот, ПодходящиеСтатусы)
	
	Если ВидПродукции <> Перечисление_ВидыПродукции().Бакалея Тогда
		Возврат;
	КонецЕсли;
	
	ФичаФлаги = Перечисление_ФичаФлаги();
	СпособыВвода = Перечисление_СпособыВводаВОборот();
	ГруппаПлатности = 2;
	
	Если СпособВводаВОборот = СпособыВвода.Импорт Тогда
		Если ФичаФлагВключен(ФичаФлаги.ИмпортБакалеяВолна2) Тогда
			ДополнитьМассив(ПодходящиеТовары, ТаблицаКодов_ВТ_ТоварыГруппыПлатности(МенеджерВТ, ГруппаПлатности, ПодходящиеСтатусы, ВидПродукции));
		КонецЕсли;
	КонецЕсли;
	
	Если СпособВводаВОборот = СпособыВвода.ИмпортФТС Тогда
		Исключения = Новый Массив;
		Если Не ФичаФлагВключен(ФичаФлаги.ИмпортФТСБакалеяВолна2) Тогда
			ДополнитьМассив(Исключения, ТаблицаКодов_ВТ_ТоварыГруппыПлатности(МенеджерВТ, ГруппаПлатности, ПодходящиеСтатусы, ВидПродукции));
		КонецЕсли;
		ДополнитьМассив(ПодходящиеТовары, ТаблицаКодов_ВТ_ТоварыБезИсключений(МенеджерВТ, Исключения, ПодходящиеСтатусы, ВидПродукции));
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ВводВОборот_ДобавитьПодходящиеТовары_Косметика(ПодходящиеТовары, МенеджерВТ, ВидПродукции, СпособВводаВОборот, ПодходящиеСтатусы)
	
	Если ВидПродукции <> Перечисление_ВидыПродукции().Косметика Тогда
		Возврат;
	КонецЕсли;
	
	ФичаФлаги = Перечисление_ФичаФлаги();
	СпособыВвода = Перечисление_СпособыВводаВОборот();
	ГруппаПлатности_2 = 2;
	ГруппаПлатности_3 = 3;
	
	Результат = Новый Массив;
	
	Если СпособВводаВОборот = СпособыВвода.Импорт Тогда
		Если ФичаФлагВключен(ФичаФлаги.ИмпортКосметикаВолна2) Тогда
			ДополнитьМассив(ПодходящиеТовары, ТаблицаКодов_ВТ_ТоварыГруппыПлатности(МенеджерВТ, ГруппаПлатности_2, ПодходящиеСтатусы, ВидПродукции));
		КонецЕсли;
		Если ФичаФлагВключен(ФичаФлаги.ИмпортКосметикаВолна3) Тогда
			ДополнитьМассив(ПодходящиеТовары, ТаблицаКодов_ВТ_ТоварыГруппыПлатности(МенеджерВТ, ГруппаПлатности_3, ПодходящиеСтатусы, ВидПродукции));
		КонецЕсли;
	КонецЕсли;
	
	Если СпособВводаВОборот = СпособыВвода.ИмпортФТС Тогда
		Исключения = Новый Массив;
		Если Не ФичаФлагВключен(ФичаФлаги.ИмпортФТСКосметикаВолна2) Тогда
			ДополнитьМассив(Исключения, ТаблицаКодов_ВТ_ТоварыГруппыПлатности(МенеджерВТ, ГруппаПлатности_2, ПодходящиеСтатусы, ВидПродукции));
		КонецЕсли;
		Если Не ФичаФлагВключен(ФичаФлаги.ИмпортФТСКосметикаВолна3) Тогда
			ДополнитьМассив(Исключения, ТаблицаКодов_ВТ_ТоварыГруппыПлатности(МенеджерВТ, ГруппаПлатности_3, ПодходящиеСтатусы, ВидПродукции));
		КонецЕсли;
		ДополнитьМассив(ПодходящиеТовары, ТаблицаКодов_ВТ_ТоварыБезИсключений(МенеджерВТ, Исключения, ПодходящиеСтатусы, ВидПродукции));
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_НаполнениеНаборовНаТСД(ОписаниеОперации, ТаблицаКодов)
	
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	Организация = ОписаниеОперации.Организация;
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ПодходящиеСтатусы = Операция_НаполнениеНаборовНаТСД_ПодходящиеСтатусыКодов();
	Набор = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Набор;
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
			ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
			ТаблицаКодов = Новый_ТаблицаКодов();
		Иначе
			КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ);
		КонецЕсли;
	Иначе
		КодыОпераций_ВТ_Прочитать(ОперацияОснование, МенеджерВТ);
	КонецЕсли;
	
	ТаблицаКодов_ВТ_УдалитьКодыСВложеннымиКодами(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОперации, Операция, ДокументУчета, ОперацияОснование);
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		ВидПродукции = ТаблицаКодов_ВТ_ПервыйВидПродукции(МенеджерВТ);
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.Товар КАК Товар,
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	Т.ОбщийТипУпаковки = &Набор
	|	И Т.ВидПродукции = &ВидПродукции
	|	И Т.Статус В(&ПодходящиеСтатусы)");
	Запрос.УстановитьПараметр("ВидПродукции", ВидПродукции);
	Запрос.УстановитьПараметр("ПодходящиеСтатусы", ПодходящиеСтатусы);
	Запрос.УстановитьПараметр("Набор", Набор);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	МенеджерВТ.Закрыть();
	
	ПоляТоваров = "Товар, КлючНоменклатуры1С, КлючСтрокиДокумента";
	Операция_ЗаполнитьТаблицуТоваров(ОписаниеОперации.Товары, ТаблицаЗапроса, ПоляТоваров);
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Стр.КодТНВЭД = Стр.Товар.КодТНВЭД;
	КонецЦикла;
	
	Отбор = Новый Структура(ПоляТоваров);
	ОписаниеОперации.Товары.Индексы.Добавить(ПоляТоваров);
	Для каждого СтрЗапроса Из ТаблицаЗапроса Цикл
		ЗаполнитьЗначенияСвойств(Отбор, СтрЗапроса);
		СтрТовара = ОписаниеОперации.Товары.НайтиСтроки(Отбор)[0];
		СтрКода = ТаблицаКодов.Добавить();
		СтрКода.КлючКода = СтрЗапроса.КлючКода;
		СтрКода.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
		СтрКода.КлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ОтчетОНанесении(ОписаниеОперации, ТаблицаКодов)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	Организация = ОписаниеОперации.Организация;
	ВидыПродукции = Перечисление_ВидыПродукции();
	СпособыВыпускаТоваров = Перечисление_СпособыВыпускаТоваров();
	
	Если ЗначениеЗаполнено(Операция) Тогда
		НоминальныйОбъемВКегах = ОписаниеОперации.ДопРеквизиты.НоминальныйОбъемВКегах;
	Иначе
		НоминальныйОбъемВКегах =
		НастройкиМодуля().НоминальныйОбъемВКегахПоУмолчанию
		Или ОписаниеОперации.ДопРеквизиты.НоминальныйОбъемВКегах;
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(ОперацияОснование) Тогда
		КодыОпераций_ВТ_Прочитать(ОперацияОснование, МенеджерВТ);
	Иначе
		Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
			ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
			ТаблицаКодов = Новый_ТаблицаКодов();
		Иначе
			КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ);
		КонецЕсли;
	КонецЕсли;
	ТаблицаКодов_ВТ_ЗаменитьТранспортныеУпаковкиНаВложенныеКоды(МенеджерВТ);
	ТаблицаКодов_ВТ_ДобавитьВложенныеКодыГрупповыхУпаковок(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОперации, Операция, ДокументУчета);
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		ВидПродукции = ТаблицаКодов_ВТ_ПервыйВидПродукции(МенеджерВТ);
	КонецЕсли;
	
	ТипСрокаГодности = ОписаниеОперации.ДопРеквизиты.ТипСрокаГодности;
	Если Не ЗначениеЗаполнено(ТипСрокаГодности) Тогда
		ТипСрокаГодности = ТаблицаКодов_ВТ_ПервыйТипСрокаГодности(МенеджерВТ);
	КонецЕсли;
	
	МаркированныйТовар = Перечисления.КонтурМаркировка_ТипыУпаковок.МаркированныйТовар;
	
	ПодходящиеСтатусы = Новый Массив;
	ПодходящиеСтатусы.Добавить("");
	ПодходящиеСтатусы.Добавить(Перечисление_СтатусыКодов().Выпущен);
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СервисыПодписок = Перечисление_СервисыПодписок();
	ОписаниеТарифа = Тариф(Организация);
	
	ПодходящиеСпособыВыпуска = Новый Массив;
	Если Не ОперацияДоступнаПоТарифу(ТипыОпераций.ОтчетОНанесении, ОписаниеТарифа)
		И СервисДоступенПоТарифу(СервисыПодписок.Перемаркировка, ОписаниеТарифа) Тогда
		ПодходящиеСпособыВыпуска.Добавить(Перечисление_СпособыВыпускаТоваров().Перемаркировка);
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	Т.Товар КАК Товар,
	|	МАКСИМУМ(Т.НомерПартии) КАК НомерПартии
	|ПОМЕСТИТЬ НомераПартий
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета.ТоварыМаркировки КАК Т
	|ГДЕ
	|	Т.Ссылка = &ДокументУчета
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.КлючСтрокиДокумента,
	|	Т.Товар
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючСтрокиДокумента,
	|	Товар
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаКодов.КлючКода КАК КлючКода,
	|	ТаблицаКодов.Товар КАК Товар,
	|	ТаблицаКодов.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	ТаблицаКодов.ДатаСрокаГодности КАК ДатаСрокаГодности,
	|	ТаблицаКодов.ДатаПроизводства КАК ДатаПроизводства,
	|	ТаблицаКодов.ЗаводскойСерийныйНомер КАК ЗаводскойСерийныйНомер,
	|	ТаблицаКодов.СпособВыпускаТоваров КАК СпособВыпускаТоваров,
	|	ТаблицаКодов.Количество КАК Количество,
	|	ТаблицаКодов.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	ЕСТЬNULL(НомераПартий.НомерПартии, """") КАК НомерПартии
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ НомераПартий КАК НомераПартий
	|		ПО ТаблицаКодов.КлючСтрокиДокумента = НомераПартий.КлючСтрокиДокумента
	|			И ТаблицаКодов.Товар = НомераПартий.Товар
	|ГДЕ
	|	ТаблицаКодов.ТипУпаковки = &МаркированныйТовар
	|	И ТаблицаКодов.ВидПродукции = &ВидПродукции
	|	И ТаблицаКодов.Статус В(&ПодходящиеСтатусы)
	|	И &ТипСрокаГодности
	|	И &СпособВыпускаТовара";
	
	Если ВидПродукции = ВидыПродукции.Молоко
		И ЗначениеЗаполнено(ТипСрокаГодности) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипСрокаГодности", "ТаблицаКодов.Товар.ТипСрокаГодности = &ТипСрокаГодности");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипСрокаГодности", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПодходящиеСпособыВыпуска) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СпособВыпускаТовара", "ТаблицаКодов.СпособВыпускаТоваров В(&ПодходящиеСпособыВыпуска)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СпособВыпускаТовара", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ВидПродукции", ВидПродукции);
	Запрос.УстановитьПараметр("ПодходящиеСтатусы", ПодходящиеСтатусы);
	Запрос.УстановитьПараметр("МаркированныйТовар", МаркированныйТовар);
	Запрос.УстановитьПараметр("ТипСрокаГодности", ТипСрокаГодности);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("ПодходящиеСпособыВыпуска", ПодходящиеСпособыВыпуска);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Выборка = Запрос.Выполнить().Выбрать();
	МенеджерВТ.Закрыть();
	
	КэшТоваров = Новый Соответствие;
	ОписаниеОперации.Товары.Очистить();
	ДопустимоеКоличествоКодовВСтроке = Операция_ДопустимоеКоличествоКодов(ТипОперации);
	
	Пока Выборка.Следующий() Цикл
		
		ОписаниеТовара = Товар_Прочитать(Выборка.Товар, КэшТоваров);
		НоминальныйОбъем = ОписаниеТовара.ДопРеквизиты.НоминальныйОбъем;
		ЭтоКег = ОписаниеТовара.ДопРеквизиты.ЭтоКег;
		ЭтоПроизводствоРФ = (Выборка.СпособВыпускаТоваров = СпособыВыпускаТоваров.ПроизводствоРФ);
		
		СтрТовара = Неопределено;
		Для каждого Стр Из ОписаниеОперации.Товары Цикл
			Если Стр.Товар = Выборка.Товар
				И Стр.КлючНоменклатуры1С = Выборка.КлючНоменклатуры1С
				И Стр.ДатаСрокаГодности = Выборка.ДатаСрокаГодности
				И Стр.ДатаПроизводства = Выборка.ДатаПроизводства
				И Стр.КлючСтрокиДокумента = Выборка.КлючСтрокиДокумента
				И Стр.НомерПартии = Выборка.НомерПартии
				И Стр.КоличествоУпаковок < ДопустимоеКоличествоКодовВСтроке Тогда
				СтрТовара = Стр;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрТовара = Неопределено Тогда
			СтрТовара = ОписаниеОперации.Товары.Добавить();
			СтрТовара.КлючСтрокиОперации = Новый УникальныйИдентификатор;
			СтрТовара.КлючСтрокиДокумента = Выборка.КлючСтрокиДокумента;
			СтрТовара.КлючНоменклатуры1С = Выборка.КлючНоменклатуры1С;
			СтрТовара.Товар = Выборка.Товар;
			СтрТовара.ДатаСрокаГодности = Выборка.ДатаСрокаГодности;
			СтрТовара.ДатаПроизводства = Выборка.ДатаПроизводства;
			СтрТовара.НомерПартии = Выборка.НомерПартии;
		КонецЕсли;
		
		Если Не СтрТовара.ЭтоПроизводствоРФ
			И ЭтоПроизводствоРФ Тогда
			СтрТовара.ЭтоПроизводствоРФ = ЭтоПроизводствоРФ;
		КонецЕсли;
		
		Количество = Выборка.Количество;
		Если Не ЗначениеЗаполнено(Выборка.Количество)
			И ЭтоКег И НоминальныйОбъемВКегах Тогда
			Количество = НоминальныйОбъем;
		КонецЕсли;
		
		СтрТовара.Количество = СтрТовара.Количество + Количество;
		СтрТовара.КоличествоУпаковок = СтрТовара.КоличествоУпаковок + 1;
		
		СтрКода = ТаблицаКодов.Добавить();
		СтрКода.КлючКода = Выборка.КлючКода;
		СтрКода.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
		СтрКода.КлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ОтчетОНанесенииНаТСД(ОписаниеОперации)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеДокумента = ДокументУчета_ПрочитатьДокумент(ДокументУчета);
	НоминальныйОбъемВКегах = Истина;
	КэшТоваров = Новый Соответствие;
	
	ОписаниеОперации.Товары.Очистить();
	Для каждого СтрТов Из ОписаниеДокумента.ТоварыМаркировки Цикл
		
		Если СтрТов.КоличествоУпаковок = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрДок = ОписаниеДокумента.ТоварыДокумента.Найти(СтрТов.КлючСтрокиДокумента, "КлючСтрокиДокумента");
		Если СтрДок = Неопределено
			Или СтрДок.НеПодлежитМаркировке Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеТовара = Товар_Прочитать(СтрТов.Товар, КэшТоваров);
		
		Стр = ОписаниеОперации.Товары.Добавить();
		Стр.Товар = СтрТов.Товар;
		Стр.КлючНоменклатуры1С = СтрДок.КлючНоменклатуры1С;
		Стр.КлючСтрокиДокумента = СтрТов.КлючСтрокиДокумента;
		Стр.КоличествоУпаковок = СтрТов.КоличествоУпаковок;
		
		Если НоминальныйОбъемВКегах
			И ОписаниеТовара.ДопРеквизиты.ЭтоКег Тогда
			Стр.Количество = ОписаниеТовара.ДопРеквизиты.НоминальныйОбъем * СтрТов.КоличествоУпаковок;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_СообщениеОбОтгрузке(ОписаниеОперации, ТаблицаКодов)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	Организация = ОписаниеОперации.Организация;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ПодходящиеСтатусы = Операция_СообщениеОбОтгрузке_ПодходящиеСтатусыКодов();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
		ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
		ТаблицаКодов = Новый_ТаблицаКодов();
	Иначе
		КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ);
	КонецЕсли;
	ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОперации, Операция, ДокументУчета);
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		ВидПродукции = Операция_СообщениеОбОтгрузке_ПервыйВидПродукции(МенеджерВТ);
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.Товар КАК Товар,
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	Т.ВидПродукции = &ВидПродукции
	|	И Т.Статус В(&ПодходящиеСтатусы)");
	Запрос.УстановитьПараметр("ПодходящиеСтатусы", ПодходящиеСтатусы);
	Запрос.УстановитьПараметр("ВидПродукции", ВидПродукции);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	МенеджерВТ.Закрыть();
	
	ПоляТоваров = "Товар, КлючНоменклатуры1С";
	Операция_ЗаполнитьТаблицуТоваров(ОписаниеОперации.Товары, ТаблицаЗапроса, ПоляТоваров);
	
	Отбор = Новый Структура(ПоляТоваров);
	ОписаниеОперации.Товары.Индексы.Добавить(ПоляТоваров);
	Для каждого СтрЗапроса Из ТаблицаЗапроса Цикл
		ЗаполнитьЗначенияСвойств(Отбор, СтрЗапроса);
		СтрТовара = ОписаниеОперации.Товары.НайтиСтроки(Отбор)[0];
		СтрКода = ТаблицаКодов.Добавить();
		СтрКода.КлючКода = СтрЗапроса.КлючКода;
		СтрКода.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_РегистрацияКИТУ(ОписаниеОперации, ТаблицаКодов)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
