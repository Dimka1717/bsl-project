Процедура КонтурПлагины_ПриПолученииНастроекПлагина(ПараметрыСобытия)
	
	Настройки = КонтурПлагины_НастройкиПлагина(ПараметрыСобытия.Идентификатор);
	Если ЗначениеЗаполнено(Настройки) Тогда
		ПараметрыСобытия.Результат.Успешно = Истина;
		ПараметрыСобытия.Результат.Данные = Настройки;
	КонецЕсли;
	
КонецПроцедуры

Процедура КонтурПлагины_ПриСохраненииНастроекПлагина(ПараметрыСобытия)
	
	Плагин = КонтурПлагины_НайтиПлагин(ПараметрыСобытия.Идентификатор);
	ТипФайла = Перечисление_ТипыФайлов().ФайлНастроекПлагина;
	
	ОписаниеПлагина = КонтурПлагин_Прочитать(Плагин);
	
	ОписаниеФайла = Новый_ОписаниеФайла();
	ОписаниеФайла.ДанныеФайла = ПараметрыСобытия.Настройки;
	ОписаниеФайла.ИмяФайла = ПараметрыВСтроку("%1 (настройки)", ОписаниеПлагина.Представление);
	ОписаниеФайла.ТипФайла = ТипФайла;
	ОписаниеФайла.ВладелецФайла = Плагин;
	ОписаниеФайла.Идентификатор = ОписаниеПлагина.Идентификатор;
	
	Файл_Записать(ОписаниеФайла);
	
	ПараметрыСобытия.Результат.Успешно = Истина;
	
КонецПроцедуры

Функция КонтурПлагины_ВключитьОтключитьПлагин(ИдентификаторПлагина, Включен)
	
	Плагин = КонтурПлагины_НайтиПлагин(ИдентификаторПлагина);
	
