Функция ДвоичныеДанныеИзСправочникаВнешнихОбработок(Ссылка) Экспорт
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение НСтр(
		"ru = 'Не указан элемент справочника дополнительных обработок'");
	КонецЕсли;
	
	ПолеХранилища = Интеграция_ИмяХранилищаФайлаВнешнейОбработки(Ссылка);
	Если Не ЗначениеЗаполнено(ПолеХранилища) Тогда
		ИмяСправочника = Ссылка.Метаданные().Имя;
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'В справочнике ""%1"" не удалось найти реквизит с файлом дополнительной обработки ""%2""'")
		, ИмяСправочника, Ссылка);
	КонецЕсли;
	
	ДвоичныеДанные = ЗначениеРеквизитаОбъекта_Марк(Ссылка, ПолеХранилища).Получить();
	
	Если Не ЗначениеЗаполнено(ДвоичныеДанные) Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Не заполнен файл дополнительной обработки ""%1""'"), Ссылка);
	КонецЕсли;
	
	Возврат ДвоичныеДанные;
	
