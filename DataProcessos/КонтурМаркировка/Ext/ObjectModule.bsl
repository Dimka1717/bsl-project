Процедура КонтурПлагины_ПриПолученииСпискаЗагруженныхПлагинов(ПараметрыСобытия)
	
	МодульКП = МодульКонтурПлагины();
	
	ИмяСправочника = КонтурПлагины_ИмяСправочника();
	ВсеПлагины = ДопСправочник_ВсеЭлементы(ИмяСправочника);
	Для Каждого Плагин Из ВсеПлагины Цикл
		
		ОписаниеПлагина = КонтурПлагин_Прочитать(Плагин);
		
		СведенияОПлагине = МодульКП.Новый_СведенияОПлагине(
			ОписаниеПлагина.Идентификатор,
			ОписаниеПлагина.Версия,
			ОписаниеПлагина.Включен,
			ОписаниеПлагина.Представление
		);
		
		ПараметрыСобытия.Результат.Добавить(СведенияОПлагине);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура КонтурПлагины_ПриВыполненииHTTPЗапроса(ОписаниеЗапроса, ОписаниеОтвета)
	
	Результат = Мок_КонтурПлагины_ПриВыполненииHTTPЗапроса(ОписаниеЗапроса, ОписаниеОтвета);
	Если Результат <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	
	Запрос.Хост = ОписаниеЗапроса.ИмяСервера;
	Запрос.Схема = ОписаниеЗапроса.Схема;
	Запрос.Таймаут = ОписаниеЗапроса.Таймаут;
	Запрос.Метод = ОписаниеЗапроса.Метод;
	Запрос.ПутьНаСервере = ОписаниеЗапроса.ПутьНаСервере;
	Запрос.ТелоЗапроса = ОписаниеЗапроса.ТелоЗапроса;
	Запрос.ТелоОтветаКакДвоичныеДанные = ОписаниеЗапроса.ТелоОтветаКакДвоичныеДанные;
	
	Для Каждого Параметр Из ОписаниеЗапроса.Параметры Цикл
		Запрос.Параметры.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	ОбработатьОшибкуHTTP(Ответ, Запрос);
	
	ОписаниеОтвета.КодОтвета = Ответ.КодОтвета;
	ОписаниеОтвета.ТелоОтвета = Ответ.ТелоОтвета;
	Для Каждого Заголовок Из Ответ.Заголовки Цикл
		ОписаниеОтвета.Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
	КонецЦикла;
	
КонецПроцедуры

