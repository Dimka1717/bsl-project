		МассивОбъектов = ЗначениеВМассиве(ОбъектОбмена);
	Иначе
		МассивОбъектов = Организация_ВсеОрганизацииДляОбмена();
	КонецЕсли;
		
	Для каждого Элемент Из МассивОбъектов Цикл
		ИдентификаторЗадания = Элемент.УникальныйИдентификатор();
		ОписаниеЗадания = Задание_ВыполнитьОбменССервисом(ИдентификаторЗадания);
		Если ФоновоеЗаданиеВыполняется(ОписаниеЗадания) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
