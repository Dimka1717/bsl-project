Процедура ПроверитьНастройкиТекущегоУзлаРИБ()
	
	Настройки = НастройкиМодуля();
	Если Настройки.РежимРИБ Тогда
		
		Результат = МодульЯдро().ДопСправочник_НастройкиТекущегоУзлаРИБ(Настройки.ПланОбмена);
		Если Результат = Неопределено Тогда
			
			ПрефиксИБ = ТипыОбъектовИС().ПрефиксИБ;
			Если Не ЗначениеЗаполнено(ПрефиксИБ) Тогда
				
				Действие = НСтр("ru = 'Проверка настроек текущего узла РИБ'");
				Ошибка = НСтр("ru = 'Не заполнен префикс информационной базы'");
				ТекстСообщения = НСтр("ru = 'Необходимо заполнить префикс информационной базы'");
				ОбработатьОшибку(Действие, Ошибка,, ТекстСообщения);
				
				ВызватьИсключение Ошибка;
				
			Иначе
				
				НастройкиУзла = МодульЯдро().Новый_НастройкиУзлаРИБ();
				НастройкиУзла.Узел = МодульЯдро().ТекущийУзелПланаОбмена(Настройки.ПланОбмена);
				НастройкиУзла.ПрефиксИБ = ПрефиксИБ;
				МодульЯдро().НастройкиУзлаРИБ_Записать(НастройкиУзла);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
