// Зписывает в базу числитель и знаменатель для расчета количества кодов по количеству 1С
//
// Параметры:
//  КлючНоменклатуры1С - СправочникСсылка.КонтурМаркировка_КлючиНоменклатуры1С - ключ номенклатуры;
//  Числитель - Число - числитель;
//  Знаменатель - Число - знаменатель;
//
Процедура КоэффициентПересчета_Записать(КлючНоменклатуры1С, Числитель, Знаменатель) Экспорт
	
	АналитикаНоменклатуры1С = АналитикаНоменклатуры1С(КлючНоменклатуры1С);
	АналитикаНоменклатурыБезСерии = Новый_АналитикаНоменклатуры1С();
	ЗаполнитьЗначенияСвойств(АналитикаНоменклатурыБезСерии, АналитикаНоменклатуры1С, , "Серия");
	КлючНоменклатурыБезСерии = КлючНоменклатуры1С_Подобрать(АналитикаНоменклатурыБезСерии);
	
	Запись = РегистрыСведений.КонтурМаркировка_КоэффициентыПересчета.СоздатьМенеджерЗаписи();
	Запись.КлючНоменклатуры1С = КлючНоменклатурыБезСерии;
	Запись.Числитель = Числитель;
	Запись.Знаменатель = Знаменатель;
	Запись.Записать();
	
КонецПроцедуры

// Устанавливает исключительную блокировку в регистре сведений Аналитика номенклатуры 1С по ключевым реквизитам
//
// Параметры:
//  КлючНоменклатуры1С - СправочникСсылка.КонтурМаркировка_КлючиНоменклатуры1С - ключ номенклатуры
//
Процедура КоэффициентПересчета_Заблокировать(КлючНоменклатуры1С) Экспорт
	
	Объект = "РегистрСведений.КонтурМаркировка_КоэффициентыПересчета";
	Значения = Новый Структура("КлючНоменклатуры1С", КлючНоменклатуры1С);
	МодульЯдро().ЗаблокироватьПоЗначениям(Объект, Значения);
	
КонецПроцедуры

// Читает из базы числитель и знаменатель для расчета количества кодов по количеству товаров
//
// Параметры:
//  КлючНоменклатуры1С - СправочникСсылка.КонтурМаркировка_КлючиНоменклатуры1С - ключ номенклатуры;
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//   * Числитель - Число - числитель;
//   * Знаменатель - Число - знаменатель;
//
Функция КоэффициентПересчета_Прочитать(КлючНоменклатуры1С) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Числитель", 1);
	Результат.Вставить("Знаменатель", 1);
	
	Если Не ЗначениеЗаполнено(КлючНоменклатуры1С) Тогда
		Возврат Результат;
	КонецЕсли;
	
	КлючиАналитики = Новый_КлючиАналитикиНоменклатуры1С();
	ЗаполнитьЗначенияСвойств(КлючиАналитики, КлючНоменклатуры1С, , "КлючСерии");
	КлючНоменклатурыБезСерии = КлючНоменклатуры1С_ПодобратьПоКлючамАналитики(КлючиАналитики);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Числитель КАК Числитель,
	|	Т.Знаменатель КАК Знаменатель
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КоэффициентыПересчета КАК Т
	|ГДЕ
	|	Т.КлючНоменклатуры1С = &КлючНоменклатуры1С");
	
	Запрос.УстановитьПараметр("КлючНоменклатуры1С", КлючНоменклатурыБезСерии);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.Числитель) Тогда
			Результат.Числитель = Выборка.Числитель;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Знаменатель) Тогда
			Результат.Знаменатель = Выборка.Знаменатель;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает таблицу аналитики номенклатуры по ключам
//
// Параметры:
//  КлючиНоменклатуры1С - Массив из СправочникСсылка.КонтурМаркировка_КлючиНоменклатуры1С - ключи номенклатуры;
// 
// Возвращаемое значение:
//  ТаблицаЗначений - см. функцию Новый_ТаблицаАналитикиНоменклатуры();
//
Функция ТаблицаАналитикиНоменклатуры(КлючиНоменклатуры1С)
	
	Результат = Новый_ТаблицаАналитикиНоменклатуры();
	Для Каждого КлючНоменклатуры1С Из КлючиНоменклатуры1С Цикл
		СтрокаТЗ = Результат.Добавить();
		СтрокаТЗ.КлючНоменклатуры1С = КлючНоменклатуры1С;
		ЗаполнитьЗначенияСвойств(СтрокаТЗ, КлючНоменклатуры1С);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает пустую таблицу аналитики номенклатуры
// 
// Возвращаемое значение:
//  ТаблицаЗначений:
//    * КлючНоменклатуры1С - СправочникСсылка.КонтурМаркировка_КлючиНоменклатуры1С - ключ номенклатуры;
//    * Номенклатура - Справочники.ТипВсеСсылки() - номенклатура;
//    * Характеристика - Справочники.ТипВсеСсылки() - характеристика;
//    * Упаковка - Справочники.ТипВсеСсылки() - упаковка;
//
Функция Новый_ТаблицаАналитикиНоменклатуры()
	
	ТипСправочник = Справочники.ТипВсеСсылки();
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("КлючНоменклатуры1С", ОписаниеТипа_КлючиНоменклатуры1С());
	Результат.Колонки.Добавить("Номенклатура", ТипСправочник);
	Результат.Колонки.Добавить("Характеристика", ТипСправочник);
	Результат.Колонки.Добавить("Упаковка", ТипСправочник);
	
	Возврат Результат;
	
КонецФункции

