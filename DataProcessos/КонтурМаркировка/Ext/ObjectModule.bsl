// Описание вида документа для выбора из информационной системы
// 
// Возвращаемое значение:
//  Структура - содержит свойства:
//   * Представление    - Строка - представление вида документа;
//   * ПолноеИмяОбъекта - Строка - полное имя объекта, который нужно выбрать;
//   * ИмяФормыВыбора   - Строка - (необязательный) путь к нестандартной форме выбора, которую нужно открыть;
//   * ПараметрыФормы   - Структура - параметры, которые будут переданы в форму, содержит свойство:
//      ** Отбор - Структура - отбор, который будет установлен списке выбора:
//          *** Ключ     - Строка - имя поля для отбора;
//          *** Значение - Произвольный - значение поля отбора;
//
Функция Новый_ОписаниеВидаДокументаДляВыбора() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Представление"	, "");
	Результат.Вставить("ПолноеИмяОбъекта", "");
	Результат.Вставить("ИмяФормыВыбора"	, "");
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Новый Структура);
	Результат.Вставить("ПараметрыФормы", ПараметрыФормы);
	
	Возврат Результат;
	
КонецФункции

