// #Область СервисПровайдеры

// Синхронизирует список сервис-провайдеров по организации с сервисом.
//
// Параметры:
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
//
Процедура СервисПровайдеры_Синхронизировать(Организация) Экспорт
	
	Исключения = Новый Массив;
	Исключения.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Велосипеды);
	Исключения.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.НикотиносодержащаяПродукция);
	Исключения.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Табак);
	Исключения.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.БезалкогольноеПиво);
	Исключения.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.АльтернативныйТабак);
	
	ВсеВидыПродукции = ВсеВидыПродукции(Исключения);
	
	ДопустимыеВидыПродукции = Новый Массив;
	ДопустимыеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Легпром);
	ДопустимыеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Обувь);
	ДопустимыеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Парфюмерия);
	ДопустимыеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Шины);
	ДопустимыеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Фототовары);
	ДопустимыеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Молоко);
	ДопустимыеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Велосипеды);
	ДопустимыеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.МедицинскиеИзделия);
	ДопустимыеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Вода);
	ДопустимыеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Пиво);
	ДопустимыеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Бады);
	ДопустимыеВидыПродукции.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Антисептики);
	
	Для каждого ВидПродукции Из ДопустимыеВидыПродукции Цикл
		СервисПровайдеры_СинхронизироватьПоВидуПродукции(Организация, ВидПродукции);
	КонецЦикла;
	
	Метрика_Функциональность_СинхронизацияСервисПровайдеров(Организация);
	
КонецПроцедуры

// Синхронизирует список сервис-провайдеров по организации с сервисом по указанной товарной группе.
//
// Параметры:
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
//  ВидПродукции - ПеречислениеСсылка.КонтурМаркировка_ВидыПродукции - вид продукции;
//
Процедура СервисПровайдеры_СинхронизироватьПоВидуПродукции(Организация, ВидПродукции)
	
	Действие = НСтр("ru = 'Синхронизация списка сервис-провайдеров'");
	ДопИнформация = Новый СписокЗначений;
	ДопИнформация.Добавить(Организация, "Организация");
	ДопИнформация.Добавить(ВидПродукции, "Вид продукции");
	
	ТоварнаяГруппа = ТоварнаяГруппаВСервисе(ВидПродукции);
	
	Попытка
		Ответ = Маркировка_СписокСервисПровайдеров(Организация, ТоварнаяГруппа);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		ДопИнформация = Новый СТруктура();
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
		ВызватьИсключение;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из Ответ Цикл
		
		РольВСервисе = СвойствоСтруктуры(Элемент, "role", "");
		Попытка
			Роль = РольСервисПровайдераПоРолиИзСервиса(РольВСервисе);
		Исключение
			Ошибка = ИнформацияОбОшибке();
			ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
			Продолжить;
		КонецПопытки;
		
		СтранаКодАльфа2 = СвойствоСтруктуры(Элемент, "country", "");
		НаименованиеСтраны = НаименованиеСтраныПоКодАльфа2(СтранаКодАльфа2);
		Если Не ЗначениеЗаполнено(НаименованиеСтраны) Тогда
			ТекстОшибки = НСтр("ru = 'Не удалось найти в ОКСМ страну по коду: %1'");
			ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, СтранаКодАльфа2);
			ОбработатьОшибку(Действие, ТекстОшибки, ДопИнформация);
			Продолжить;
		КонецЕсли;
		
		ОписаниеСП = Новый_СервисПровайдер();
		ОписаниеСП.Наименование = СвойствоСтруктуры(Элемент, "providerName", "");
		ОписаниеСП.ИНН = СвойствоСтруктуры(Элемент, "taxIdentificationNumber", "");
		ОписаниеСП.Роль = Роль;
		ОписаниеСП.Страна = НаименованиеСтраны;
		ОписаниеСП.Идентификатор = СвойствоСтруктуры(Элемент, "id", "");
		ОписаниеСП.Площадка = СвойствоСтруктуры(Элемент, "name", "");
		ОписаниеСП.Адрес = СвойствоСтруктуры(Элемент, "address", "");
		ОписаниеСП.КонтактноеЛицо = СвойствоСтруктуры(Элемент, "contactPerson", "");
		ОписаниеСП.АдресЭП = СвойствоСтруктуры(Элемент, "email", "");
		
		Для Каждого ТоварнаяГруппаСП Из Элемент.productGroups Цикл
			
			Попытка
				ВидПродукцииСП = ВидПродукцииПоТоварнойГруппеИзСервиса(ТоварнаяГруппаСП);
			Исключение
				Ошибка = ИнформацияОбОшибке();
				ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
				Прервать;
			КонецПопытки;
			
			ОписаниеСП.ВидыПродукции.Добавить(ВидПродукцииСП);
			
		КонецЦикла;
		
		СервисПровайдеры_Записать(ОписаниеСП);
		
	КонецЦикла;
	
КонецПроцедуры

// Описание сервис-провайдера.
// 
// Возвращаемое значение:
//  Структура - описание сервис-провайдера:
//   * Ссылка - КонтурМаркировка_СервисПровайдеры - ссылка на элемент;
//   * Наименование - Строка - наименование сервис-провайдера;
//   * ИНН - Строка - ИНН;
//   * Роль - ПеречислениеСсылка.КонтурМаркировка_РолиСервисПровайдеров - роль сервис-провайдера;
//   * Страна - Строка - наименование страны;
//   * Идентификатор - Строка - идентификатор сервис-провайдера в сервисе;
//   * Площадка - Строка - наименование площадки;
//   * Адрес - Строка - адрес сервис-провайдера;
//   * КонтактноеЛицо - Строка - контактное лицо;
//   * АдресЭП - Строка - электронный адрес;
//   * ВидыПродукции - Массив из ПеречислениеСсылка.КонтурМаркировка_ВидыПродукции - виды продукции;
//
Функция Новый_СервисПровайдер()
	
	Результат = Новый Структура;
	Результат.Вставить("Ссылка");
	Результат.Вставить("Наименование");
	Результат.Вставить("ИНН");
	Результат.Вставить("Роль");
	Результат.Вставить("Страна");
	Результат.Вставить("Идентификатор");
	Результат.Вставить("Площадка");
	Результат.Вставить("Адрес");
	Результат.Вставить("КонтактноеЛицо");
	Результат.Вставить("АдресЭП");
	Результат.Вставить("ВидыПродукции", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

// Обновляет существующий или создает новый элемент в справочнике КонтурМаркировка_СервисПровайдеры.
// При создании нового элемента записывает ссылку на созданный элемент в поле ОписаниеСП.Ссылка.
//
// Параметры:
//  ОписаниеСП - Структура - см. фунцию Новый_СервисПровайдер();
//
Процедура СервисПровайдеры_Записать(ОписаниеСП)
	
	СервисПровайдер = ОписаниеСП.Ссылка;
	Если Не ЗначениеЗаполнено(СервисПровайдер) Тогда
		СервисПровайдер = СервисПровайдеры_НайтиПоИдентификатору(ОписаниеСП.Идентификатор);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СервисПровайдер) Тогда
		
		Если ОбъектВПроцессеОбновления(СервисПровайдер) Тогда
			ВызватьИсключение_ОбъектВПроцессеОбновления(СервисПровайдер);
		КонецЕсли;
		
		СервисПровайдерОбъект = СервисПровайдер.ПолучитьОбъект();
		
	Иначе
		СервисПровайдерОбъект = Справочники.КонтурМаркировка_СервисПровайдеры.СоздатьЭлемент();
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(СервисПровайдерОбъект, ОписаниеСП,, "Ссылка, ВидыПродукции");
	
	СервисПровайдерОбъект.ВидыПродукции.Очистить();
	Для Каждого ВидПродукции Из ОписаниеСП.ВидыПродукции Цикл
		НоваяСтрока = СервисПровайдерОбъект.ВидыПродукции.Добавить();
		НоваяСтрока.ВидПродукции = ВидПродукции;
	КонецЦикла;
	
	СервисПровайдерОбъект.Записать();
	
	ОписаниеСП.Ссылка = СервисПровайдерОбъект.Ссылка;
	
КонецПроцедуры

// Находит сервис-провайдер в справочнике по его идентификатору.
//
// Параметры:
//  Идентификатор - Строка - идентификатор сервис-провайдера в сервисе;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_СервисПровайдеры - сервис-провайдер;
//  Неопределено - если идентификатор не задан;
//
Функция СервисПровайдеры_НайтиПоИдентификатору(Идентификатор)
	
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СервисПровайдеры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_СервисПровайдеры КАК СервисПровайдеры
	|ГДЕ
	|	СервисПровайдеры.Идентификатор = &Идентификатор");
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	Результат = ПолучитьРезультатЗапроса(Запрос);
	
	Возврат Результат;
	
КонецФункции

Функция СервисПровайдеры_ВидПродукцииДоступен(СервисПровайдер, ВидПродукции)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.ВидПродукции КАК ВидПродукции
	|ИЗ
	|	Справочник.КонтурМаркировка_СервисПровайдеры.ВидыПродукции КАК Т
	|ГДЕ
	|	Т.Ссылка = &СервисПровайдер
	|	И Т.ВидПродукции = &ВидПродукции");
	Запрос.УстановитьПараметр("СервисПровайдер", СервисПровайдер);
	Запрос.УстановитьПараметр("ВидПродукции", ВидПродукции);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// По строковой роли из сервиса определяет значение перечисления КонтурМаркировка_РолиСервисПровайдеров.
// Если роль не найдена - генерируется исключение.
//
// Параметры:
//  РольВСервисе - Строка - роль сервис-провайдера в сервисе;
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.КонтурМаркировка_РолиСервисПровайдеров - роль сервис-провайдера;
//  Неопределено - роль в сервисе не задана;
//
Функция РольСервисПровайдераПоРолиИзСервиса(РольВСервисе)
	
	Результат = Неопределено;
	
	Если Не СоответствиеРолейСервисПровайдеров().Свойство(РольВСервисе, Результат) Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось определить роль сервис-провайдера по роли из сервиса: %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, РольВСервисе);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает соответствие между ролями сервис-провайдеров в сервисе
// и значениями перечислениея КонтурМаркировка_РолиСервисПровайдеров.
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - соответствие ролей сервис-провайдеров;
//
Функция СоответствиеРолейСервисПровайдеров()
	
	КлючКэш = "СоответствиеРолейСервисПровайдеров";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Cem", Перечисления.КонтурМаркировка_РолиСервисПровайдеров.ЦЭМ);
	Результат.Вставить("Cm", Перечисления.КонтурМаркировка_РолиСервисПровайдеров.КонтрактноеПроизводство);
	Результат.Вставить("Cl", Перечисления.КонтурМаркировка_РолиСервисПровайдеров.ЛогистическийСклад);
	Результат.Вставить("Ca", Перечисления.КонтурМаркировка_РолиСервисПровайдеров.КомиссионнаяПлощадка);
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

