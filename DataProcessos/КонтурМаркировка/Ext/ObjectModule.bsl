Процедура Операция_ЗаполнитьТаблицуТоваров(ТаблицаТоваров, ТаблицаИсточник, ПоляТоваров)
	
	ТаблицаЗапроса = ТаблицаИсточник.Скопировать(, ПоляТоваров);
	ТаблицаЗапроса.Колонки.Добавить("КоличествоУпаковок", ОписаниеТипа_Число());
	ТаблицаЗапроса.ЗаполнитьЗначения(1, "КоличествоУпаковок");
	ТаблицаЗапроса.Свернуть(ПоляТоваров, "КоличествоУпаковок");
	
	ТаблицаТоваров.Очистить();
	Для каждого Стр Из ТаблицаЗапроса Цикл
		НоваяСтрока = ТаблицаТоваров.Добавить();
		НоваяСтрока.КлючСтрокиОперации = Новый УникальныйИдентификатор;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр, ПоляТоваров);
		НоваяСтрока.КоличествоУпаковок = Стр.КоличествоУпаковок;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_Перезаполнить(Операция)
	
	Реквизиты = Новый Структура("ТипОперации, ДокументУчета, ОперацияОснование");
	Реквизиты = ЗначенияРеквизитовОбъекта_Марк(Операция, Реквизиты);
	ТипОперации = Реквизиты.ТипОперации;
	ДокументУчета = Реквизиты.ДокументУчета;
	ОперацияОснование = Реквизиты.ОперацияОснование;
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	Если ТипОперации <> ТипыОпераций.ВводВОборот Тогда
		ТекстОшибки = НСтр("ru = 'Перезаполнение доступно только для операций с типом %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ТипыОпераций.ВводВОборот);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Операция_Заблокировать(Операция);
		
		ОписаниеОперации = Новый_Операция();
		ОписаниеОперации.ТипОперации = ТипОперации;
		ОписаниеОперации.ДокументУчета = ДокументУчета;
		ОписаниеОперации.ОперацияОснование = ОперацияОснование;
		
		ТаблицаКодов = Новый_ТаблицаКодов();
		Операция_Заполнить(ОписаниеОперации, ТаблицаКодов);
		
		ОписаниеОперации.Ссылка = Операция;
		Операция_Записать(ОписаниеОперации);
		КодыОпераций_Записать(ТаблицаКодов, Операция);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция Операция_СообщениеОбОтгрузке_ПервыйВидПродукции(МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИнформацияОКодах.ВидПродукции КАК ВидПродукции
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючей
	|		ПО ТаблицаКодов.КлючКода = СвязиКлючей.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (СвязиКлючей.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Неопределено;
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.ВидПродукции;
		Если ЗначениеЗаполнено(Результат) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

