Процедура ПерейтиНаВерсию_3_14_ЗаполнитьНаличиеИПечатьЭтикетки(ИмяДопРеквизитаШаблон
	, ИмяДопРеквизитаЕстьЭтикетки
	, ИмяДопРеквизитаПечататьЭтикетки)
	
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-off
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Операции.Ссылка КАК Операция,
	|	ДопРеквизитЕстьЭтикетки.Значение КАК ЕстьЭтикетки,
	|	ДопРеквизитПечататьЭтикетки.Значение КАК ПечататьЭтикетки
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Операции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ДопРеквизитШаблон
	|		ПО Операции.Ссылка = ДопРеквизитШаблон.Объект
	|			И (ДопРеквизитШаблон.ИмяРеквизита = &ИмяДопРеквизитаШаблон)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ДопРеквизитЕстьЭтикетки
	|		ПО Операции.Ссылка = ДопРеквизитЕстьЭтикетки.Объект
	|			И (ДопРеквизитЕстьЭтикетки.ИмяРеквизита = &ИмяДопРеквизитаЕстьЭтикетки)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ДопРеквизитПечататьЭтикетки
	|		ПО Операции.Ссылка = ДопРеквизитПечататьЭтикетки.Объект
	|			И (ДопРеквизитПечататьЭтикетки.ИмяРеквизита = &ИмяДопРеквизитаПечататьЭтикетки)
	|ГДЕ
	|	Операции.ТипОперации = &ПечатьКодов
	|	И (ДопРеквизитЕстьЭтикетки.Значение ЕСТЬ NULL
	|			ИЛИ ДопРеквизитПечататьЭтикетки.Значение ЕСТЬ NULL)");
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-on
	
	Запрос.УстановитьПараметр("ИмяДопРеквизитаШаблон", ИмяДопРеквизитаШаблон);
	Запрос.УстановитьПараметр("ИмяДопРеквизитаЕстьЭтикетки", ИмяДопРеквизитаЕстьЭтикетки);
	Запрос.УстановитьПараметр("ИмяДопРеквизитаПечататьЭтикетки", ИмяДопРеквизитаПечататьЭтикетки);
	Запрос.УстановитьПараметр("ПечатьКодов", Перечисление_ТипыОпераций().ПечатьКодов);
	Выборка = Запрос.Выполнить().Выбрать();
	
	НаборЗаписейЕстьЭтикетки = РегистрыСведений.КонтурМаркировка_ДопРеквизиты.СоздатьНаборЗаписей();
	НаборЗаписейЕстьЭтикетки.Отбор.ИмяРеквизита.Установить(ИмяДопРеквизитаЕстьЭтикетки);
	
	НаборЗаписейПечататьЭтикетки = РегистрыСведений.КонтурМаркировка_ДопРеквизиты.СоздатьНаборЗаписей();
	НаборЗаписейПечататьЭтикетки.Отбор.ИмяРеквизита.Установить(ИмяДопРеквизитаПечататьЭтикетки);
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЕстьЭтикетки = NULL Тогда
			Запись = НаборЗаписейЕстьЭтикетки.Добавить();
			Запись.Объект = Выборка.Операция;
			Запись.ИмяРеквизита = ИмяДопРеквизитаЕстьЭтикетки;
			Запись.Значение = Истина;
		КонецЕсли;
		Если Выборка.ПечататьЭтикетки = NULL Тогда
			Запись = НаборЗаписейПечататьЭтикетки.Добавить();
			Запись.Объект = Выборка.Операция;
			Запись.ИмяРеквизита = ИмяДопРеквизитаПечататьЭтикетки;
			Запись.Значение = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если НаборЗаписейЕстьЭтикетки.Модифицированность() Тогда
		НаборЗаписейЕстьЭтикетки.Записать(Ложь);
	КонецЕсли;
	Если НаборЗаписейПечататьЭтикетки.Модифицированность() Тогда
		НаборЗаписейПечататьЭтикетки.Записать(Ложь);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПерейтиНаВерсию_3_14_ЗавершитьЗаказыКодовОжидающиеПеремаркировку()
	
	СтарыеДействия = Новый Массив;
	СтарыеДействия.Добавить("Проверить создание перемаркировки");
	СтарыеДействия.Добавить("Проверить статусы перемаркированных кодов");
	
	НовоеДействие = Перечисление_ТребуемыеДействия().ОперацияЗавершена;
	НовыйСтатус = Перечисление_СтатусыОпераций().ОперацияЗавершена;
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Операция КАК Операция,
	|	Т.ДатаПостановки КАК ДатаПостановки
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОчередьОбмена КАК Т
	|ГДЕ
	|	Т.ТребуемоеДействие В(&СтарыеДействия)");
	Запрос.УстановитьПараметр("СтарыеДействия", СтарыеДействия);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Операция = Выборка.Операция;
		
		Набор = РегистрыСведений.КонтурМаркировка_ОчередьОбмена.СоздатьНаборЗаписей();
		Набор.Отбор.Операция.Установить(Операция);
		Набор.Прочитать();
		
		Для каждого Стр Из Набор Цикл
			Стр.ТребуемоеДействие = НовоеДействие;
		КонецЦикла;
		
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Записать();
		
		СтатусыОперации_ЗаписатьОсновнойСтатус(Операция, НовыйСтатус, Выборка.ДатаПостановки);
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

