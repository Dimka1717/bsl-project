Функция Операция_ОбязательныеРеквизитыЗаказаКодов(ОписаниеОперации)
	
	Результат = Новый_ОбязательныеРеквизитыОперации();
	
	ПоляШапки = Результат.ПоляШапки;
	ПоляТоваров = Результат.ПоляТоваров;
	
	СпособыВыпуска = Перечисление_СпособыВыпускаТоваров();
	
	ПоляШапки.Добавить("Организация");
	ПоляШапки.Добавить("Склад");
	ПоляШапки.Добавить("ВидПродукции");
	ПоляШапки.Добавить("СпособВыпускаТоваров");
	ПоляШапки.Добавить("ТипКодаМаркировки");
	
	ПоляТоваров.Добавить("Товар");
	ПоляТоваров.Добавить("КоличествоУпаковок");
	
	СпособВыпускаТоваров = ОписаниеОперации.ДопРеквизиты.СпособВыпускаТоваров;
	
	Если СпособВыпускаТоваров = СпособыВыпуска.Перемаркировка Тогда
		ПоляТоваров.Добавить("КодТНВЭД");
	КонецЕсли;
	
	Если ВидПродукцииТребуетТипОплатыКодов(ОписаниеОперации.ВидПродукции) Тогда
		ПоляШапки.Добавить("ТипОплатыКодов");
	КонецЕсли;
	
	Если (СпособВыпускаТоваров = СпособыВыпуска.Остатки
		Или СпособВыпускаТоваров = СпособыВыпуска.Перемаркировка)
		И ОписаниеОперации.ДопРеквизиты.КарточкиТоваровПринадлежатДругойОрганизации Тогда
		ПоляШапки.Добавить("СобственникТовараИНН");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Операция_ОбязательныеРеквизитыОтчетаОНанесении(ОписаниеОперации)
	
	Результат = Новый_ОбязательныеРеквизитыОперации();
	ПоляШапки = Результат.ПоляШапки;
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	
	ПоляШапки.Добавить("Организация");
	ПоляШапки.Добавить("Склад");
	ПоляШапки.Добавить("ТипИспользования");
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	
	КонтролироватьПлощадкуДляБезалкогольногоПива = (ВидПродукции = ВидыПродукции.БезалкогольноеПиво
	И ФичаФлагВключен(Перечисление_ФичаФлаги().КонтрольПлощадкаНанесениеБезалкогольноеПиво));
	
	КонтролироватьПлощадку = (ВидПродукции = ВидыПродукции.Пиво
	Или ВидПродукции = ВидыПродукции.БезалкогольныеНапитки
	Или ВидПродукции = ВидыПродукции.СтроительныеМатериалы
	Или КонтролироватьПлощадкуДляБезалкогольногоПива);
	
	Если КонтролироватьПлощадку Тогда
		ПоляШапки.Добавить("Площадка");
	КонецЕсли;
	
	Если ВидПродукцииТребуетУказатьТипСрокаГодности(ВидПродукции)
		И Операция_ЕстьЕдиницыТоваров(ОписаниеОперации.Товары) Тогда
		ПоляШапки.Добавить("ТипСрокаГодности");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

