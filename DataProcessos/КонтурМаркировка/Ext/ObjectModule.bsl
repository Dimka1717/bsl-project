Функция ЗначенияРавныВПределахПогрешности(Значение1, Значение2, ДоляПогрешности = 0.01)
	
	Если Цел(Значение1) = Значение1
		И Цел(Значение2) = Значение2 Тогда
		// Для целых значений погрешность не нужна
		Возврат Значение1 = Значение2;
	КонецЕсли;
	
	КоличествоЗначений = 2;
	Погрешность = (Значение1 + Значение2) / КоличествоЗначений * ДоляПогрешности;
	
	Разница = Значение1 - Значение2;
	
	Возврат Макс(-Разница, Разница) <= Погрешность;
	
КонецФункции

