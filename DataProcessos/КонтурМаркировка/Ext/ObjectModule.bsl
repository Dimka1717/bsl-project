// Находит первую операцию подходящую по параметрам
//
// Параметры:
//  ТипОперации - Строка - (необязательный) см. Перечисление_ТипыОпераций();
//  ДокументУчетаСсылка - СправочникСсылка.КонтурМаркировка_ДокументыУчета - (необязательный);
//  ОперацияОснованиеСсылка - СправочникСсылка.КонтурМаркировка_Операции - (необязательный);
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Операции;
//  Неопределено - если подходящая операция не найдена;
//
Функция Операция_НайтиОперацию(ТипОперации = Неопределено
	, ДокументУчетаСсылка = Неопределено, ОперацияОснованиеСсылка = Неопределено) Экспорт
	
	МассивОпераций = Операция_НайтиОперации(ТипОперации, ДокументУчетаСсылка, ОперацияОснованиеСсылка);
	
	Если ЗначениеЗаполнено(МассивОпераций) Тогда
		Результат = МассивОпераций[0];
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

