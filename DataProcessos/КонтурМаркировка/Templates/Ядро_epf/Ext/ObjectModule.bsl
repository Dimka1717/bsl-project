// Заполняет в описании запроса HTTP параметры сервиса и настройки прокси
//
// Параметры:
//  ОписаниеЗапроса - Структура - см. Новый_ОписаниеЗапросаHTTP();
//
Процедура Портал_ЗаполнитьОбщиеНастройкиHTTP(ОписаниеЗапроса)
	
	Если НастройкиМодуля().ТестовоеОкружение Тогда
		ОписаниеСервиса = СтруктураURI(ИнтернетАдреса().СервисПорталТестовый);
	Иначе
		ОписаниеСервиса = СтруктураURI(ИнтернетАдреса().СервисПортал);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ОписаниеЗапроса, ОписаниеСервиса);
	
	UserAgent = ПараметрыВСтроку("Kontur.Mark 1C %1 (%2)"
								, ВерсияОбработки()
								, ВариантРасположенияМодуляДляUserAgent());
	
	ОписаниеЗапроса.Заголовки.Вставить("User-Agent", UserAgent);
	
	ЗаполнитьНастройкиПроксиСервера(ОписаниеЗапроса);
	
КонецПроцедуры

// Заполняет в описании запроса HTTP параметры сервиса и настройки прокси
//
// Параметры:
//  ОписаниеЗапроса - Структура - см. Новый_ОписаниеЗапросаHTTP();
//  ТестовоеОкружение - Булево - Истина, если необходимо использовать тестовое окружение;
//
Процедура Портал_ЗаполнитьОбщиеНастройкиHTTPДляМетрик(ОписаниеЗапроса, ТестовоеОкружение)
	
	Если ТестовоеОкружение Тогда
		ОписаниеСервиса = СтруктураURI(ИнтернетАдреса().СервисПорталТестовый);
	Иначе
		ОписаниеСервиса = СтруктураURI(ИнтернетАдреса().СервисПортал);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ОписаниеЗапроса, ОписаниеСервиса);
	
	UserAgent = ПараметрыВСтроку("Kontur.Mark 1C %1 (%2)"
								, ВерсияОбработки()
								, ВариантРасположенияМодуляДляUserAgent());
	
	ОписаниеЗапроса.Заголовки.Вставить("User-Agent", UserAgent);
	
	ЗаполнитьНастройкиПроксиСервера(ОписаниеЗапроса);
	
КонецПроцедуры

