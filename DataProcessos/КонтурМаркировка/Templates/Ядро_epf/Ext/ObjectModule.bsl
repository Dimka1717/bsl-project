// Устанавливает исключительную блокировку на объект базы данных по значению
//
// Параметры:
//  ИмяОбъекта - Строка - полное имя объекта, который нужно заблокировать;
//  Значения - Структура - содержит имена полей объекта и значения, по которым нужно заблокировать;
//
Процедура ЗаблокироватьПоЗначениям(ИмяОбъекта, Значения) Экспорт
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		ЗаблокироватьПоЗначениямДляИзменения(ИмяОбъекта, Значения);
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить(ИмяОбъекта);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Для Каждого Элемент Из Значения Цикл
		ЭлементБлокировки.УстановитьЗначение(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

// Устанавливает исключительную блокировку на объект базы данных по таблице
//
// Параметры:
//  ИмяОбъекта - Строка - полное имя объекта, который нужно заблокировать;
//  Поле - Строка - поле объекта, по которому нужно заблокировать;
//  ИсточникДанных - ТаблицаЗначений, РезультатЗапроса - коллекция с данными для блокировки;
//  ИмяКолонки - Строка - (необязательный) имя колонки, в которой указаны значения для блокировки;
//
Процедура ЗаблокироватьПоТаблице(ИмяОбъекта, Поле, ИсточникДанных, Знач ИмяКолонки = Неопределено) Экспорт
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		ЗаблокироватьПоТаблицеДляИзменения(ИмяОбъекта, Поле, ИсточникДанных, ИмяКолонки);
		Возврат;
	КонецЕсли;
	
	Если ИмяКолонки = Неопределено Тогда
		ИмяКолонки = Поле;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить(ИмяОбъекта);
	ЭлементБлокировки.ИсточникДанных = ИсточникДанных;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных(Поле, ИмяКолонки);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

Процедура ЗаблокироватьПоТаблицеДляИзменения(ИмяОбъекта, Поле, ИсточникДанных, Знач ИмяКолонки = Неопределено)
	
	Если Не ИспользуетсяАвтоматическийРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяКолонки = Неопределено Тогда
		ИмяКолонки = Поле;
	КонецЕсли;
	
	Если ТипЗнч(ИсточникДанных) = Тип("РезультатЗапроса") Тогда
		Таблица = ИсточникДанных.Выгрузить().Скопировать(, ИмяКолонки);
	Иначе
		Таблица = ИсточникДанных.Скопировать(, ИмяКолонки);
	КонецЕсли;
	Таблица.Свернуть(ИмяКолонки);
	
	ТекстЗапроса = "ВЫБРАТЬ ИСТИНА КАК Поле ИЗ Объект КАК Т ГДЕ Т.Поле В(&Значения) ДЛЯ ИЗМЕНЕНИЯ";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Объект", ИмяОбъекта);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Т.Поле", "Т." + Поле);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Значения", Таблица.ВыгрузитьКолонку(ИмяКолонки));
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ЗаблокироватьПоЗначениямДляИзменения(ИмяОбъекта, Значения)
	
	Если Не ИспользуетсяАвтоматическийРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ ИСТИНА КАК Поле ИЗ Объект КАК Т ГДЕ &Условия ДЛЯ ИЗМЕНЕНИЯ";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Объект", ИмяОбъекта);
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Условия = "";
	Разделитель = "";
	НомерПараметра = 0;
	Для Каждого Элемент Из Значения Цикл
		НомерПараметра = НомерПараметра + 1;
		ИмяПараметра = "Параметр" + Формат(НомерПараметра, "ЧГ=");
		Условия = Условия + Разделитель + "Т." + Элемент.Ключ + " = &" + ИмяПараметра;
		Запрос.УстановитьПараметр(ИмяПараметра, Элемент.Значение);
		Разделитель = " И ";
	КонецЦикла;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условия", Условия);
	
	Запрос.Выполнить();
	
КонецПроцедуры

