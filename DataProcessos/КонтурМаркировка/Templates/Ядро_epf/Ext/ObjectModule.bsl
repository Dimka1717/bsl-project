Функция Сертификаты_Найти(ОтпечатокСертификата) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Сертификаты КАК Т
	|ГДЕ
	|	Т.ОтпечатокСертификата = &ОтпечатокСертификата");
	Запрос.УстановитьПараметр("ОтпечатокСертификата", ОтпечатокСертификата);
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "Ссылка");
	
КонецФункции

Функция Сертификаты_Записать(ОписаниеСертификата) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Если ЗначениеЗаполнено(ОписаниеСертификата.Ссылка) Тогда
			
			Если ОбъектВПроцессеОбновления(ОписаниеСертификата.Ссылка) Тогда
				ВызватьИсключение_ОбъектВПроцессеОбновления(ОписаниеСертификата.Ссылка);
			КонецЕсли;
			
			ОбъектСертификата = ОписаниеСертификата.Ссылка.ПолучитьОбъект();
			
		Иначе
			ОбъектСертификата = Справочники.КонтурМаркировка_Сертификаты.СоздатьЭлемент();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ОбъектСертификата, ОписаниеСертификата);
		ОбъектСертификата.Наименование = НаименованиеСертификата(ОписаниеСертификата);
		
		ОбъектСертификата.Записать();
		
		ОписаниеСертификата.Ссылка = ОбъектСертификата.Ссылка;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат ОписаниеСертификата.Ссылка;
	
КонецФункции

Функция Новый_Сертификат() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ссылка");
	Результат.Вставить("ВидСертификата");
	Результат.Вставить("ОтпечатокСертификата");
	Результат.Вставить("НаименованиеОрганизации");
	Результат.Вставить("ДатаВыдачи");
	Результат.Вставить("ДатаОкончания");
	Результат.Вставить("ФИО");
	Результат.Вставить("ИНН");
	Результат.Вставить("КПП");
	Результат.Вставить("Издатель");
	Результат.Вставить("Должность");
	
	Возврат Результат;
	
КонецФункции

Функция СрокДействияСертификатаИстек(ДатаОкончания) Экспорт
	
	Результат = ДатаОкончания < НачалоДня(ТекущаяДатаСеанса());
	
	Возврат Результат;
	
КонецФункции

Функция СрокДействияСертификатаЗаканчивается(ДатаОкончания) Экспорт
	
	ДатаПредупреждения = ДатаОкончания - СрокПредупрежденияОбОкончанииСертификата();
	
	Результат = ДатаПредупреждения < ТекущаяДатаСеанса();
	
	Возврат Результат;
	
КонецФункции

Функция СрокПредупрежденияОбОкончанииСертификата() Экспорт
	
	КоличествоСуток = 30;
	
	Возврат КоличествоСуток * СекундВСутках();
	
КонецФункции

Функция НаименованиеСертификата(ОписаниеСертификата)
	
	СоставНаименования = Новый Массив;
	СоставНаименования.Добавить(ОписаниеСертификата.ФИО);
	
	Если ЗначениеЗаполнено(ОписаниеСертификата.НаименованиеОрганизации)
		И ОписаниеСертификата.ФИО <> ОписаниеСертификата.НаименованиеОрганизации Тогда
		СоставНаименования.Добавить(ОписаниеСертификата.НаименованиеОрганизации);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеСертификата.Должность) Тогда
		СоставНаименования.Добавить(ОписаниеСертификата.Должность);
	КонецЕсли;
	
	ШаблонНаименования = НСтр("ru = '%1, до %2'");
	
	Результат = ПараметрыВСтроку(ШаблонНаименования
	, СоединитьСтроку(СоставНаименования, ", ")
	, Формат(ОписаниеСертификата.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	
	Возврат Результат;
	
КонецФункции

