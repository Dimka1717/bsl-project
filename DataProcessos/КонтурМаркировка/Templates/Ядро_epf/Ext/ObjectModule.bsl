Функция НужноОтправитьМетрики(СтекМетрик)
	
	ПрошлоВремени = 0;
	Если ЗначениеЗаполнено(СтекМетрик.ДатаПервогоСобытия) Тогда
		ПрошлоВремени = ТекущаяДатаСеанса() - СтекМетрик.ДатаПервогоСобытия;
	КонецЕсли;
	
	Если СтекМетрик.РазмерСтека >= СтекМетрик_МаксимальныйРазмер()
		Или ПрошлоВремени >= ПериодОтправкиМетрик() Тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

