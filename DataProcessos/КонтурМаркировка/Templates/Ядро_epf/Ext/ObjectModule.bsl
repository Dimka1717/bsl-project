
// #Область ОписаниеПеременных

Перем КэшНаСервере;

// #КонецОбласти // ОписаниеПеременных

// #Область СведенияОВнешнейОбработке

// Версия обработки в стандартном формате
//
// Возвращаемое значение:
//  Строка - версия в формате РР.ВВ.ФФ.СС, где:
//   * РР - номер редакции    - в рамках одной редакции гарантируется обратная совместимость;
//   * ВВ - номер версии      - новая функциональность (или несколько);
//   * ФФ - номер исправления - исправление ошибки;
Функция ВерсияОбработки() Экспорт
	
	Возврат "3.15.7";
	
КонецФункции

// Сведения о внешней обработке совместимые с БСП
//
// Возвращаемое значение:
//  Структура - содержит свойства:
//   * Версия          - Строка - версия обработки;
//   * Наименование    - Строка - представление для администратора (наименование элемента справочника),
//                                берется синоним объекта метаданных внешней обработки;
//   * Информация      - Строка - краткая информация о внешней обработке,
//                                берется комментарий объекта метаданных внешней обработки;
//   * БезопасныйРежим - Булево - признак подключения внешней обработки в безопасном режиме:
//                                 Игнорируется привилегированный режим
//                                 Запрещены внешние по отношению к платформе «1С:Предприятия» действия:
//                                  COM;
//                                  загрузка внешних компонент;
//                                  запуск внешних приложений и команд операционной системы;
//                                  доступ к файловой системе, кроме временных файлов;
//                                  доступ к Интернету.
//   * Вид             - Строка - содержит значение "ДополнительнаяОбработка";
//   * Команды         - ТаблицаЗначений - настройки команд, поставляемых внешней обработкой:
//      ** Идентификатор        - Строка- внутреннее имя команды;
//      ** Представление        - Строка- пользовательское представление команды;
//      ** Использование        - Строка- тип команды:
//                                         "ВызовКлиентскогоМетода",
//                                         "ВызовСерверногоМетода";
//      ** Модификатор          - Строка- дополнительная классификация команды;
//      ** ПоказыватьОповещение - Булево- если Истина, то при запуске команды выводится оповещение "Команда выполняется...";
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	МетаданныеОбработки = Метаданные();
	
	Результат = Новый Структура;
	Результат.Вставить("БезопасныйРежим", Ложь);
	Результат.Вставить("Наименование", МетаданныеОбработки.Синоним);
	Результат.Вставить("Информация", МетаданныеОбработки.Комментарий);
	Результат.Вставить("Команды", КомандыВнешнейОбработки());
	Результат.Вставить("Версия", ВерсияОбработки());
	Результат.Вставить("Вид", "ДополнительнаяОбработка");
	Результат.Вставить("ВерсияБСП", "1.2.1.4");
	
	Возврат Результат;
	
КонецФункции

Функция КомандыВнешнейОбработки()
	
	МетаданныеОбработки = Метаданные();
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Представление", ТипСтрока);
	Результат.Колонки.Добавить("Идентификатор", ТипСтрока);
	Результат.Колонки.Добавить("Использование", ТипСтрока);
	Результат.Колонки.Добавить("Модификатор", ТипСтрока);
	Результат.Колонки.Добавить("ПоказыватьОповещение", ТипБулево);
	Результат.Колонки.Добавить("Скрыть", ТипБулево);
	
	Команды = Перечисление_КомандыОбработки();
	ПредставленияКоманд = Перечисление_ПредставленияКомандОбработки();
	ВариантыИспользования = Перечисление_ВариантыИспользованияКоманд();
	
	Если МетаданныеОбработки.Синоним = "Контур.Маркировка" Тогда
		Стр = Результат.Добавить();
		Стр.Идентификатор = Команды.ОткрытьФорму;
		Стр.Представление = МетаданныеОбработки.Синоним;
		Стр.Использование = ВариантыИспользования.ОткрытиеФормы;
	КонецЕсли;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ВыполнитьРегламентныеДействия;
	Стр.Представление = ПредставленияКоманд.ВыполнитьРегламентныеДействия;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ОбменССервисом;
	Стр.Представление = ПредставленияКоманд.ОбменССервисом;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ОбновлениеМодуля;
	Стр.Представление = ПредставленияКоманд.ОбновлениеМодуля;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ОчисткаУстаревшихДанных;
	Стр.Представление = ПредставленияКоманд.ОчисткаУстаревшихДанных;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ОбновитьДанныеПодсистемы;
	Стр.Представление = ПредставленияКоманд.ОбновитьДанныеПодсистемы;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Ложь;
	Стр.Скрыть = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ОбновитьСтатусыКодовДокумента;
	Стр.Представление = ПредставленияКоманд.ОбновитьСтатусыКодовДокумента;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Ложь;
	Стр.Скрыть = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ОбновлениеПлагинов;
	Стр.Представление = ПредставленияКоманд.ОбновлениеПлагинов;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ПроверитьКодыДокумента;
	Стр.Представление = ПредставленияКоманд.ПроверитьКодыДокумента;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Ложь;
	Стр.Скрыть = Истина;
	
	Возврат Результат;
	
КонецФункции

Функция Перечисление_КомандыОбработки() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ОткрытьФорму"					, "ОткрытьФорму");
	Результат.Вставить("ВыполнитьРегламентныеДействия"	, "ВыполнитьРегламентныеДействия");
	Результат.Вставить("ОбменССервисом"					, "ОбменССервисом");
	Результат.Вставить("ОбновлениеМодуля"				, "ОбновлениеМодуля");
	Результат.Вставить("ОчисткаУстаревшихДанных"		, "ОчисткаУстаревшихДанных");
	Результат.Вставить("ОбновлениеПлагинов"				, "ОбновлениеПлагинов");
	// Служебные команды
	Результат.Вставить("ОбновитьДанныеПодсистемы"		, "ОбновитьДанныеПодсистемы");
	Результат.Вставить("ОбновитьСтатусыКодовДокумента"	, "ОбновитьСтатусыКодовДокумента");
	Результат.Вставить("ПроверитьКодыДокумента"			, "ПроверитьКодыДокумента");
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция Перечисление_ВариантыИспользованияКоманд()
	
	Результат = Новый Структура;
	Результат.Вставить("ОткрытиеФормы", "ОткрытиеФормы");
	Результат.Вставить("ВызовСерверногоМетода", "ВызовСерверногоМетода");
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция Перечисление_ПредставленияКомандОбработки()
	
	Команды = Перечисление_КомандыОбработки();
	
	Результат = Новый Структура;
	Результат.Вставить(Команды.ВыполнитьРегламентныеДействия, НСтр("ru = 'Регламентные действия'"));
	Результат.Вставить(Команды.ОбменССервисом				, НСтр("ru = 'Обмен с сервисом'"));
	Результат.Вставить(Команды.ОбновлениеМодуля				, НСтр("ru = 'Обновление модуля'"));
	Результат.Вставить(Команды.ОчисткаУстаревшихДанных		, НСтр("ru = 'Очистка устаревших данных'"));
	Результат.Вставить(Команды.ОбновлениеПлагинов			, НСтр("ru = 'Обновление плагинов'"));
	// Служебные команды
	Результат.Вставить(Команды.ОбновитьДанныеПодсистемы		, НСтр("ru = 'Обновить данные подсистемы (служебная)'"));
	Результат.Вставить(Команды.ОбновитьСтатусыКодовДокумента, НСтр("ru = 'Обновить статусы кодов документа (служебная)'"));
	Результат.Вставить(Команды.ПроверитьКодыДокумента		, НСтр("ru = 'Проверить коды документа (служебная)'"));
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

// #КонецОбласти // СведенияОВнешнейОбработке

// #Область КомандыВнешнейОбработки

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыКоманды = Неопределено) Экспорт
	
	Если Не МодульИнициализирован() Тогда
		Инициализировать(ПараметрыКоманды);
	КонецЕсли;
	
	Команды = Перечисление_КомандыОбработки();
	
	Если ИдентификаторКоманды = Команды.ВыполнитьРегламентныеДействия Тогда
		
		ВыполнитьРегламентныеДействия(ПараметрыКоманды);
		
	ИначеЕсли ИдентификаторКоманды = Команды.ОчисткаУстаревшихДанных Тогда
		
		ОчиститьУстаревшиеДанные();
		
	ИначеЕсли ИдентификаторКоманды = Команды.ОбновитьДанныеПодсистемы Тогда
		
		ОбработчикОбновления = СвойствоСтруктуры(ПараметрыКоманды, "ОбработчикОбновления");
		
		Если ЗначениеЗаполнено(ОбработчикОбновления) Тогда
			ОбновитьДанныеПодсистемы(ОбработчикОбновления);
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = Команды.ОбновитьСтатусыКодовДокумента Тогда
		
		ДокументУчета = СвойствоСтруктуры(ПараметрыКоманды, "ДокументУчета");
		
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			ДокументУчета_ОбновитьСтатусыКодов(ДокументУчета);
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = Команды.ПроверитьКодыДокумента Тогда
		
		ДокументУчета = СвойствоСтруктуры(ПараметрыКоманды, "ДокументУчета");
		
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			ДокументУчета_ПроверитьКоды(ДокументУчета);
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = Команды.ОбменССервисом Тогда
		
		КонтекстОбмена = СвойствоСтруктуры(ПараметрыКоманды, "КонтекстОбмена");
		
		Если ЗначениеЗаполнено(КонтекстОбмена) Тогда
			ВыполнитьОбменССервисом(КонтекстОбмена);
		Иначе
			МодульКонтурМаркировка().ВыполнитьОбменПоВсемОрганизациям();
		КонецЕсли;
		
	Иначе
		ТекстОшибки = НСтр("ru = 'Неизвестный идентификатор команды: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, ИдентификаторКоманды);
	КонецЕсли;
	
	ОтправитьМетрики();
	
КонецПроцедуры

// Вызывает одноименное событие в ПМ
//
// Параметры:
//  ДопПараметры - Произвольный - дополнительные параметры, которые можно передать в ПМ
//
Процедура ВыполнитьРегламентныеДействия(ДопПараметры = Неопределено) Экспорт
	
	Метрика_Функциональность_РегламентныеДействия();
	
	ПМ_ОбработатьСобытие("ВыполнитьРегламентныеДействия", ДопПараметры);
	
КонецПроцедуры

// #КонецОбласти // КомандыВнешнейОбработки

// #Область Инициализация

// Заполняет параметры модуля с проверкой перехода на новую версию
//
Процедура Инициализировать(ПараметрыКоманды)
	
	РасположениеМодуля = СвойствоСтруктуры(ПараметрыКоманды , "РасположениеМодуля");
	ПутьКФайлуМодуля = СвойствоСтруктуры(ПараметрыКоманды , "ПутьКФайлуМодуля");
	
	ПараметрыСессии_Инициализировать(РасположениеМодуля, ПутьКФайлуМодуля);
	
КонецПроцедуры

// Проверяет наличие параметров сеанса для запуска через общий модуль
//
// Параметры:
//  ИдентификаторФормы - УникальныйИдентификатор - идентификатор формы модуля
//
Функция МодульИнициализирован()
	
	Попытка
		ВерсияМодуляСессии = ПараметрыСессии_Прочитать("ВерсияМодуля");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Результат = (ВерсияМодуляСессии = ВерсияОбработки());
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // Инициализация

// #Область ПереходНаНовуюВерсию

Процедура ПерейтиНаВерсию_3_8_ОтложенноеОбновление(ОписаниеОбработчика)
	
	Версия = ОписаниеОбработчика.Версия;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ДокументыУчета.Ссылка, Операции.Ссылка) КАК Ссылка
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОбновлениеДанных КАК ОбновлениеДанных
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета КАК ДокументыУчета
	|		ПО ОбновлениеДанных.Объект = ДокументыУчета.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции КАК Операции
	|		ПО ОбновлениеДанных.Объект = Операции.Ссылка
	|ГДЕ
	|	ОбновлениеДанных.Версия = &Версия
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕСТЬNULL(ДокументыУчета.Дата, Операции.Дата) УБЫВ");
	Запрос.УстановитьПараметр("Версия", Версия);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.КонтурМаркировка_ДокументыУчета") Тогда
			ПерейтиНаВерсию_3_8_ОбновитьКоличествоКодовДокумента(Выборка.Ссылка, Версия);
		Иначе
			ПерейтиНаВерсию_3_8_ОбновитьКоличествоКодовОперации(Выборка.Ссылка, Версия);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПерейтиНаВерсию_3_8_ОбновитьКоличествоКодовДокумента(ДокументУчета, Версия)
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыДокументов_ОбновитьКоличествоКодов(ДокументУчета);
		
		ОтложенноеОбновлениеДанных_УдалитьОбъект(ДокументУчета, Версия);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Отложенное обновление количества кодов документа'");
		ДопИнформация = Новый СписокЗначений;
		ДопИнформация.Добавить(Версия, "Версия");
		ДопИнформация.Добавить(ДокументУчета, "Документ учета");
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
		ВызватьИсключение;
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	// BSLLS:SetPrivilegedMode-on
	
	ТекстСообщения = ПараметрыВСтроку(НСтр("ru = 'Документ обновлен до версии %1'"), Версия);
	ДобавитьПредупреждениеВЖурналРегистрации(ТекстСообщения, ДокументУчета);
	
КонецПроцедуры

Процедура ПерейтиНаВерсию_3_8_ОбновитьКоличествоКодовОперации(Операция, Версия)
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыОпераций_ОбновитьКоличествоКодов(Операция);
		
		ОтложенноеОбновлениеДанных_УдалитьОбъект(Операция, Версия);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Отложенное обновление количества кодов операции'");
		ДопИнформация = Новый СписокЗначений;
		ДопИнформация.Добавить(Версия, "Версия");
		ДопИнформация.Добавить(Операция, "Операция");
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
		ВызватьИсключение;
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	// BSLLS:SetPrivilegedMode-on
	
	ТекстСообщения = ПараметрыВСтроку(НСтр("ru = 'Операция обновлена до версии %1'"), Версия);
	ДобавитьПредупреждениеВЖурналРегистрации(ТекстСообщения, Операция);
	
КонецПроцедуры

// #КонецОбласти // ПереходНаНовуюВерсию

// #Область ОбновлениеДанных

// Выполняет отложенное обновление данных подсистемы
//
// Параметры:
//  ОписаниеОбработчика - Структура - см. функцию КонтурМаркировка.epf -> МодульОбъекта.Новый_ОбработчикОбновления();
//
Процедура ОбновитьДанныеПодсистемы(ОписаниеОбработчика) Экспорт
	
	ШаблонКода = "%1(ОписаниеОбработчика)";
	СтрокаКода = ПараметрыВСтроку(ШаблонКода, ОписаниеОбработчика.МетодОтложенногоОбновления);
	Выполнить(СтрокаКода);
	
КонецПроцедуры

// Добавляет объекты для выполнения отложенного обновления
//
// Параметры:
//  Объекты - СправочникСсылка,Массив - объекты для добавления;
//  Версия  - Строка - версия модуля, до которой необходимо обновить объекты;
//
Процедура ОтложенноеОбновлениеДанных_ДобавитьОбъекты(Объекты, Версия) Экспорт
	
	Колонка = "Объект";
	ТипКолонки = Метаданные.РегистрыСведений.КонтурМаркировка_ОбновлениеДанных.Измерения.Объект.Тип;
	ТаблицаОбъектов = Новый ТаблицаЗначений;
	ТаблицаОбъектов.Колонки.Добавить(Колонка, ТипКолонки);
	ТаблицаЗначений_ЗагрузитьМассив(ТаблицаОбъектов, ЗначениеВМассиве(Объекты), Колонка);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Объект КАК Объект
	|ПОМЕСТИТЬ Объекты
	|ИЗ
	|	&ТаблицаОбъектов КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Объекты.Объект КАК Объект,
	|	&Версия КАК Версия
	|ИЗ
	|	Объекты КАК Объекты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ОбновлениеДанных КАК ОбновлениеДанных
	|		ПО Объекты.Объект = ОбновлениеДанных.Объект
	|			И (ОбновлениеДанных.Версия = &Версия)
	|ГДЕ
	|	ОбновлениеДанных.Версия ЕСТЬ NULL");
	Запрос.УстановитьПараметр("Версия", Версия);
	Запрос.УстановитьПараметр("ТаблицаОбъектов", ТаблицаОбъектов);
	
	Набор = РегистрыСведений.КонтурМаркировка_ОбновлениеДанных.СоздатьНаборЗаписей();
	Набор.Отбор.Версия.Установить(Версия);
	Набор.Загрузить(Запрос.Выполнить().Выгрузить());
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать(Ложь);
	
КонецПроцедуры

// Удаляет объект из очереди отложенного обновления
//
// Параметры:
//  Объект - СправочникСсылка - объект для добавления;
//  Версия - Строка - версия до которой был обновлен объект;
//
Процедура ОтложенноеОбновлениеДанных_УдалитьОбъект(Объект, Версия)
	
	Набор = РегистрыСведений.КонтурМаркировка_ОбновлениеДанных.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Объект);
	Набор.Отбор.Версия.Установить(Версия);
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();
	
КонецПроцедуры

// Проверяет наличие объектов которые нужно обновить
//
// Параметры:
//  Версия - Строка - версия модуля;
// 
// Возвращаемое значение:
//  Булево - Истина, если есть хоть один объект;
//
Функция ЕстьОбъектыДляОтложенногоОбновления(Версия) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОбновлениеДанных КАК Т
	|ГДЕ
	|	Т.Версия = &Версия");
	Запрос.УстановитьПараметр("Версия", Версия);
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// Проверяет, находится ли переданный объект в процессе обновления
//
// Параметры:
//  Ссылка - СправочникСсылка - ссылка на проверяемый объект;
// 
// Возвращаемое значение:
//  Булево - Истина, если объект присутствует в регистре КонтурМаркировка_ОбновлениеДанных;
//
Функция ОбъектВПроцессеОбновления(Ссылка) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОбновлениеДанных КАК Т
	|ГДЕ
	|	Т.Объект = &Объект");
	Запрос.УстановитьПараметр("Объект", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ВызватьИсключение_ОбъектВПроцессеОбновления(Ссылка) Экспорт
	
	ШаблонОшибки = НСтр("ru = 'Не удалось записать %1 - выполняется обновление данных'");
	ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, Ссылка);
	
	ВызватьИсключение ТекстОшибки;
	
КонецПроцедуры

// #КонецОбласти // ОбновлениеДанных

// #Область МодульКонтурМаркировка

Функция МодульКонтурМаркировка()
	
	Результат = Неопределено;
	
	Попытка
		Результат = ВзаимодействиеКонтурМаркировка.МодульКонтурМаркировка();
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Результат = Неопределено Тогда
		
		ПутьКФайлу = ПараметрыСессии_Прочитать("ПутьКФайлуМодуля");
		Если ЗначениеЗаполнено(ПутьКФайлу) Тогда
			
			Попытка
				МодульИзФайла = МодульОбщегоНазначения().СоздатьВнешнююОбработкуБезПредупреждений(ПутьКФайлу);
			Исключение
				Ошибка = ИнформацияОбОшибке();
			КонецПопытки;
			
			Результат = ВзаимодействиеКонтурМаркировка.МодульКонтурМаркировка();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // МодульКонтурМаркировка

// #Область ПодключаемыйМодуль

Функция Модуль_ПМ(Настройки = Неопределено, ВызыватьИсключение = Ложь)
	
	КлючКэш = "МодульПМ";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Настройки = Неопределено Тогда
		Настройки = НастройкиМодуля();
	КонецЕсли;
	
	Если Не Настройки.ПМ_Использовать Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВариантыРасположения = Перечисление_ВариантыРасположенияОбработки();
	
	Попытка
		
		Если Настройки.ПМ_Расположение = ВариантыРасположения.НаДиске Тогда
			Результат = ПМ_ПодключитьОбработкуНаДиске(Настройки.ПМ_Путь);
		ИначеЕсли Настройки.ПМ_Расположение = ВариантыРасположения.ВСправочнике Тогда
			Результат = ПМ_ПодключитьОбработкуВСправочнике(Настройки.ПМ_Ссылка);
		Иначе
			Результат = ПМ_СоздатьОбработкуКонфигурации(Настройки.ПМ_ИмяОбработки);
		КонецЕсли;
		
		ПМ_ПроверитьВерсию(Результат);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Загрузка подключаемого модуля'");
		ТекстСообщения = НСтр("ru = 'Не удалось загрузить подключаемый модуль'");
		ОбработатьОшибку(Действие, Ошибка, Настройки, ТекстСообщения);
		
		Если ВызыватьИсключение Тогда
			ВызватьИсключение;
		КонецЕсли;
		
	КонецПопытки;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ПМ_ПодключитьОбработкуНаДиске(ПутьКФайлу)
	
	Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Не указан путь к файлу подключаемого модуля ""%1""'"), ПутьКФайлу);
	ИначеЕсли Не МодульОбщегоНазначения().ФайлСуществует(ПутьКФайлу) Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Не найден файл подключаемого модуля ""%1""'"), ПутьКФайлу);
	КонецЕсли;
	
	Результат = МодульОбщегоНазначения().СоздатьВнешнююОбработкуБезПредупреждений(ПутьКФайлу);
	
	СведенияОбОбработке = Результат.СведенияОВнешнейОбработке();
	
	Если Не МассивСодержитЗначение(ПМ_ДопустимыеНаименованияОбработки(), СведенияОбОбработке.Наименование) Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Обработка не является подключаемым модулем ""%1""'"), ПутьКФайлу);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПМ_ПодключитьОбработкуВСправочнике(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение НСтр(
		"ru = 'Не указан элемент справочника с подключаемым модулем'");
	КонецЕсли;
	
	ПолеХранилища = Интеграция_ИмяХранилищаФайлаВнешнейОбработки(Ссылка);
	Если Не ЗначениеЗаполнено(ПолеХранилища) Тогда
		ИмяСправочника = Ссылка.Метаданные().Имя;
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'В справочнике ""%1"" не удалось найти реквизит с файлом подключаемого модуля ""%1""'")
		, ИмяСправочника, Ссылка);
	КонецЕсли;
	
	ДвоичныеДанные = ЗначениеРеквизитаОбъекта_Марк(Ссылка, ПолеХранилища).Получить();
	
	Если Не ЗначениеЗаполнено(ДвоичныеДанные) Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Не заполнен файл подключаемого модуля ""%1""'"), Ссылка);
	КонецЕсли;
	
	Результат = МодульОбщегоНазначения().СоздатьВнешнююОбработкуБезПредупреждений(ДвоичныеДанные);
	
	СведенияОбОбработке = Результат.СведенияОВнешнейОбработке();
	
	Если Не МассивСодержитЗначение(ПМ_ДопустимыеНаименованияОбработки(), СведенияОбОбработке.Наименование) Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Обработка не является подключаемым модулем ""%1""'"), Ссылка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПМ_СоздатьОбработкуКонфигурации(ИмяОбработки)
	
	Если Не ЗначениеЗаполнено(ИмяОбработки) Тогда
		
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Не указано имя обработки подключаемого модуля ""%1""'"), ИмяОбработки);
		
	ИначеЕсли Метаданные.Обработки.Найти(ИмяОбработки) = Неопределено Тогда
		
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'В составе конфигурации не найдена обработка подключаемого модуля ""%1""'"), ИмяОбработки);
		
	КонецЕсли;
	
	Результат = МодульОбщегоНазначения().СоздатьОбработкуИзКонфигурации(ИмяОбработки);
	
	СведенияОбОбработке = Результат.СведенияОВнешнейОбработке();
	
	Если Не МассивСодержитЗначение(ПМ_ДопустимыеНаименованияОбработки(), СведенияОбОбработке.Наименование) Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Обработка не является подключаемым модулем ""%1""'"), ИмяОбработки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПМ_ДопустимыеНаименованияОбработки()
	
	Результат = Новый Массив;
	Результат.Добавить("Контур.Маркировка (подключаемый модуль)");
	Результат.Добавить("Подключаемый модуль (Контур.Маркировка)");
	
	Возврат Результат;
	
КонецФункции

Процедура ПМ_ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка = Ложь) Экспорт
	
	ПараметрыСобытия.Вставить("БезопасныеДопПараметрыПМ", НастройкиМодуля().ПМ_БезопасныеДопПараметры);
	ПараметрыСобытия.Вставить("ДопПараметрыПМ", НастройкиМодуля().ПМ_ДопПараметры);
	
	МодульМаркировки = МодульКонтурМаркировка();
	
	ОчиститьОсновнойМодуль = Ложь;
	
	Попытка
		
		Если МодульМаркировки.ОсновнойМодуль = Неопределено Тогда
			ОчиститьОсновнойМодуль = Истина;
			МодульМаркировки.ОсновнойМодуль = МодульКонтурМаркировка(); // Поддержка вызова ОсновнойМодуль.ОсновнойМодуль
		КонецЕсли;
		
		КонтурПлагины_ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка);
		ПМ_ОбработатьСобытие_ПослеКонтурПлагинов(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка);
		
		Если ОчиститьОсновнойМодуль Тогда
			МодульМаркировки.ОсновнойМодуль = Неопределено;
		КонецЕсли;
		
	Исключение
		
		Если ОчиститьОсновнойМодуль Тогда
			МодульМаркировки.ОсновнойМодуль = Неопределено;
		КонецЕсли;
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ПМ_ОбработатьСобытие_ПослеКонтурПлагинов(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка = Ложь) Экспорт
	
	СобытиеОбработано = Мок_ПМ_ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка);
	Если СобытиеОбработано Тогда
		Возврат;
	КонецЕсли;
	
	МодульПМ = Модуль_ПМ();
	Если МодульПМ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МодульМаркировки = МодульКонтурМаркировка();
	
	ОчиститьОсновнойМодуль = Ложь;
	ОчиститьОсновнойМодульПМ = Ложь;
	
	Попытка
		
		Если МодульМаркировки.ОсновнойМодуль = Неопределено Тогда
			ОчиститьОсновнойМодуль = Истина;
			МодульМаркировки.ОсновнойМодуль = МодульКонтурМаркировка(); // Поддержка вызова ОсновнойМодуль.ОсновнойМодуль для ОФ
		КонецЕсли;
		
		Если МодульПМ.ОсновнойМодуль = Неопределено Тогда
			ОчиститьОсновнойМодульПМ = Истина;
			МодульПМ.ОсновнойМодуль = МодульМаркировки.ОсновнойМодуль;
		КонецЕсли;
		
		МодульПМ.ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка);
		
		Если ОчиститьОсновнойМодульПМ Тогда
			МодульПМ.ОсновнойМодуль = Неопределено;
		КонецЕсли;
		Если ОчиститьОсновнойМодуль Тогда
			МодульМаркировки.ОсновнойМодуль = Неопределено;
		КонецЕсли;
		
	Исключение
		
		Если ОчиститьОсновнойМодульПМ Тогда
			МодульПМ.ОсновнойМодуль = Неопределено;
		КонецЕсли;
		Если ОчиститьОсновнойМодуль Тогда
			МодульМаркировки.ОсновнойМодуль = Неопределено;
		КонецЕсли;
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Вызов события ПМ'");
		ОбработатьОшибку(Действие, Ошибка , ИмяСобытия);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ПМ_ОбработатьСобытие_ПриВыполненииЗадачиВОчередиОбмена(ПараметрыПМ, СтандартнаяОбработка)
	
	Если Мок_ПМ_ОбработатьСобытие("ПриВыполненииЗадачиВОчередиОбмена", ПараметрыПМ, СтандартнаяОбработка) Тогда
		Возврат;
	КонецЕсли;
	
	ПМ_ОбработатьСобытие("ПриВыполненииЗадачиВОчередиОбмена", ПараметрыПМ, СтандартнаяОбработка);
	
КонецПроцедуры

// Проверяет что версия модуля ПМ совместима с модулем
//
// Параметры:
//  МодульПМ - ОбработкаОбъект - объект обработки модуля ПМ;
//
Процедура ПМ_ПроверитьВерсию(МодульПМ)
	
	ТекущаяВерсия = ПМ_ВерсияОбработки(МодульПМ);
	МинимальнаяВерсия = МинимальнаяВерсияПМ();
	
	Если СравнитьВерсии(МинимальнаяВерсия, ТекущаяВерсия) > 0 Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Текущая версия подключаемого модуля (ПМ) не поддерживается.
		|Необходимо сохранить шаблон новой версии ПМ на диск и перенести в него доработки.
		|Текущая версия ПМ: %1
		|Требуется версия ПМ: %2 и выше'")
		, ТекущаяВерсия, МинимальнаяВерсия);
	КонецЕсли;
	
КонецПроцедуры

