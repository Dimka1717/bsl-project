Функция Маркировка_ВводВОборот_Создать(ОписаниеЗадачи, СтруктураКонтента, СпособВводаВОборот)
	
	Организация = ОписаниеЗадачи.Организация;
	ИдентификаторСклада = ОписаниеЗадачи.Склад.Идентификатор;
	
	Результат = Новый_Результат_ОтветаHTTP();
	Ответ_Мок = Мок_ВводВОборот_Создать(Организация, ИдентификаторСклада, СтруктураКонтента, СпособВводаВОборот);
	Если Не Ответ_Мок = Неопределено Тогда
		Результат.Результат = Ответ_Мок;
		Возврат Результат;
	КонецЕсли;
	
	СпособыВводаВОборот = Перечисление_СпособыВводаВОборот();
	
	Если СпособВводаВОборот = СпособыВводаВОборот.ПроизводствоРФ Тогда
		ПутьНаСервере = "/api/v1/codes/introduction/production";
	ИначеЕсли СпособВводаВОборот = СпособыВводаВОборот.Импорт Тогда
		ПутьНаСервере = "/api/v1/codes/introduction/import";
	ИначеЕсли СпособВводаВОборот = СпособыВводаВОборот.Трансгран Тогда
		ПутьНаСервере = "/api/v1/codes/introduction/cross-border";
	ИначеЕсли СпособВводаВОборот = СпособыВводаВОборот.ИмпортФТС Тогда
		ПутьНаСервере = "/api/v1/codes/introduction/import-fts";
	ИначеЕсли СпособВводаВОборот = СпособыВводаВОборот.Остатки Тогда
		ПутьНаСервере = "/api/v1/codes/introduction/remains";
	Иначе
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Не удалось определить метод в сервисе для ввода в оборот: %1'"), СпособВводаВОборот);
	КонецЕсли;
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	Маркировка_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	Маркировка_ДобавитьТокен(Запрос, Организация);
	
	Запрос.Метод = "POST";
	Запрос.ПутьНаСервере = ПутьНаСервере;
	Запрос.Параметры.Вставить("warehouseId", ИдентификаторСклада);
	Запрос.ТелоЗапроса = ЗначениеВСтрокуJSON(СтруктураКонтента);
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	ДобавитьВИсториюЗапросовВСервис(ОписаниеЗадачи, Запрос, Ответ);
	ОбработатьОшибкуHTTP(Ответ, Запрос, Результат);
	
	Если Результат.Успешно Тогда
		Результат.Результат = СократитьКавычки(Ответ.ТелоОтвета);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

