//  Строка - полный путь к форме
//
Функция ПМ_ПутьКФормеМодуляКлиента() Экспорт
	
	Если СравнитьВерсии(ПМ_ВерсияОбработки(), "2.8") < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяОбработки = Модуль_ПМ().Метаданные().ПолноеИмя();
	Результат = ИмяОбработки + ".Форма.МодульКлиента";
	
	Возврат Результат;
	
