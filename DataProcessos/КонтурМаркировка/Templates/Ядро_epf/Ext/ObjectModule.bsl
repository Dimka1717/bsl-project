		НовоеДействие = Неопределено;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьВыводаИзОборота;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьВыводаИзОборота;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОбновлениеСтатусовКодов;
		НовоеДействие = ТребуемыеДействия.ОбновитьСтатусыКодовПослеВыводаИзОборота;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedError")
		Или НРег(СтатусДокумента) = НРег("CrptSendingError") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус вывода из оброта: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

// #КонецОбласти // ВыводИзОборота

// #Область ОтменаВыводаИзОборота

Функция ОчередьОбмена_ОтменаВыводаИзОборота_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеОтменуВыводаИзОборота);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлДляПодписиОтменыВыводаИзОборота);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьГотовностьОтменыВыводаИзОборота);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_ОтменаВыводаИзОборота_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьВСервисеОтменуВыводаИзОборота Тогда
		Задача_ОтменаВыводаИзОборота_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлДляПодписиОтменыВыводаИзОборота Тогда
		Задача_ОтменаВыводаИзОборота_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_ОтменаВыводаИзОборота_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьГотовностьОтменыВыводаИзОборота Тогда
		Задача_ОтменаВыводаИзОборота_ПроверитьСтатус(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ОтменаВыводаИзОборота_СоздатьВСервисе(ОписаниеЗадачи)
	
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	
	ОписаниеОперацииОснования = Операция_ПрочитатьОперацию(ОписаниеОперации.ОперацияОснование);
	ОбъемноСортовойУчет = ОписаниеОперацииОснования.ДопРеквизиты.ОбъемноСортовойУчет;
	
	Попытка
		Контент = Контент_ОтменаВыводаИзОборота(ОписаниеОперации);
		Ответ = Маркировка_ОтменаВыводаИзОборота_Создать(ОписаниеЗадачи, Контент, ОбъемноСортовойУчет);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.ТребуемоеДействие = Перечисление_ТребуемыеДействия().ПолучитьФайлДляПодписиОтменыВыводаИзОборота;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	СтатусОперацииОснования = Перечисление_СтатусыОпераций().ОжиданиеОтменыВыводаИзОборота;
	СтатусыОперации_ЗаписатьОсновнойСтатус(ОписаниеЗадачи.Операция.ОперацияОснование, СтатусОперацииОснования);
	
	Метрика_Функциональность_ОтменаВыводаИзОборота(Организация);
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_ОтменаВыводаИзОборота_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_ОтменаВыводаИзОборота_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.id;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ОтменаВыводаИзОборота_ОтправитьПодпись(ОписаниеЗадачи)
	
	Организация = ОписаниеЗадачи.Организация;
	ИдентификаторЗаказа = ОписаниеЗадачи.ИдентификаторДокумента;
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_ОтменаВыводаИзОборота_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.ТребуемоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьОтменыВыводаИзОборота;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_ОтменаВыводаИзОборота_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created")
		Или НРег(СтатусДокумента) = НРег("ReadyForSend") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = Неопределено;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьОтменыВыводаИзОборота;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьОтменыВыводаИзОборота;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОперацияЗавершена;
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		
		СтатусОперацииОснования = СтатусыОпераций.ОперацияОтменена;
		СтатусыОперации_ЗаписатьОсновнойСтатус(ОписаниеЗадачи.Операция.ОперацияОснование, СтатусОперацииОснования);
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedError")
		Или НРег(СтатусДокумента) = НРег("CrptSendingError") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
		СтатусОперацииОснования = СтатусыОпераций.ОшибкаОтменыОперации;
		СтатусыОперации_ЗаписатьОсновнойСтатус(ОписаниеЗадачи.Операция.ОперацияОснование, СтатусОперацииОснования);
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус отмены вывода из оброта: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ТребуемоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

// #КонецОбласти // ОтменаВыводаИзОборота

// #Область ВводВОборот

Функция ОчередьОбмена_ВводВОборот_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.ПроверитьСтатусыКодовВводаВОборот);
	Результат.Добавить(ТребуемыеДействия.СоздатьРегистрациюСтрокВводаВОборот);
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеВводВОборот);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлДляПодписиВводаВОборот);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьГотовностьВводаВОборот);
	Результат.Добавить(ТребуемыеДействия.РасформироватьАТКПослеРегистрации);
	Результат.Добавить(ТребуемыеДействия.ПроверитьРегистрациюСтрокВводаВОборот);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_ВводВОборот_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.ПроверитьСтатусыКодовВводаВОборот Тогда
		Задача_ВводВОборот_ПроверитьСтатусыКодов(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьРегистрациюСтрокВводаВОборот Тогда
		Задача_ВводВОборот_СоздатьВводНаКаждуюСтроку(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьВСервисеВводВОборот Тогда
		Задача_ВводВОборот_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлДляПодписиВводаВОборот Тогда
		Задача_ВводВОборот_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_ВводВОборот_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьГотовностьВводаВОборот Тогда
		Задача_ВводВОборот_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.РасформироватьАТКПослеРегистрации Тогда
		Задача_ВводВОборот_РасформироватьАТКПослеРегистрации(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьРегистрациюСтрокВводаВОборот Тогда
		Задача_ВводВОборот_ПроверитьСтатусыСтрок(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

// #Область ОбработкаВсехСтрокВводаВОборот

Процедура Задача_ВводВОборот_ПроверитьСтатусыКодов(ОписаниеЗадачи)
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ПодходящиеСтатусы = Операция_ВводВОборот_ПодходящиеСтатусыКодов();
	СтатусНанесен = Перечисление_СтатусыКодов().Нанесен;
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	
	ДатаПоследнегоОбновленияСтатусов = ОписаниеЗадачи.ДопРеквизиты.ДатаОбновленияСтатусовКодов;
	ПрошлоВремени = ТекущаяДата() - ДатаПоследнегоОбновленияСтатусов;
	
	Если ПрошлоВремени > СекундВМинуте() Тогда
		Операция_ОбновитьСтатусыКодов(Операция, СтатусНанесен);
		ОписаниеЗадачи.ДопРеквизиты.ДатаОбновленияСтатусовКодов = ТекущаяДата();
	КонецЕсли;
	
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	ТаблицаКодов_ПрочитатьСтатусыКодов(ТаблицаКодов);
	
	ТаблицаКодов.Колонки.Добавить("КоличествоКодов", ОписаниеТипа_Число());
	ТаблицаКодов.ЗаполнитьЗначения(1, "КоличествоКодов");
	ТаблицаКодов.Свернуть("Статус", "КоличествоКодов");
	
	ВсеКодыНанесены = Истина;
	Для каждого Стр Из ТаблицаКодов Цикл
		Если Стр.Статус <> СтатусНанесен Тогда
			ВсеКодыНанесены = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ВсеКодыНанесены Тогда
		ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.СоздатьРегистрациюСтрокВводаВОборот;
		Задача_Записать(ОписаниеЗадачи);
		Возврат;
	КонецЕсли;
	
	СписокСтатусов = Новый Массив;
	ЕстьНедопустимыйСтатус = Ложь;
	Для каждого Стр Из ТаблицаКодов Цикл
		Если ПодходящиеСтатусы.Найти(Стр.Статус) = Неопределено Тогда
			ЕстьНедопустимыйСтатус = Истина;
			СтрокаСтатуса = НСтр("ru = '%1 - %2 кодов (недопустимый статус)'");
		Иначе
			СтрокаСтатуса = НСтр("ru = '%1 - %2 кодов'");
		КонецЕсли;
		СписокСтатусов.Добавить(ПараметрыВСтроку(СтрокаСтатуса, Стр.Статус, Стр.КоличествоКодов));
	КонецЦикла;
	
	Если ЕстьНедопустимыйСтатус Тогда
		
		ТекстОшибки = ПараметрыВСтроку(
		НСтр("ru = 'Обнаружен недопустимый для ввода в оборот статус!
		|%1'"), СоединитьСтроку(СписокСтатусов, Символы.ПС));
		
		ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОшибкаОбработки;
		ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
		
	Иначе
		
		Действие = НСтр("ru = 'Ввод в оборот'");
		ТекстПредупреждения = НСтр(
		"ru = 'Отложена регистрация ввода в оборот в ГИС МТ,
		|еще не все коды находятся в статусе %1'");
		ТекстПредупреждения = ПараметрыВСтроку(ТекстПредупреждения, СтатусНанесен);
		ЗафиксироватьПредупреждение(Действие, ТекстПредупреждения, СписокСтатусов, Операция);
		
		ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ПроверитьСтатусыКодовВводаВОборот;
		ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОжиданиеСтатусаКодовНанесен;
		
	КонецЕсли;
	
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ВводВОборот_СоздатьВводНаКаждуюСтроку(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	
	Если Не КодыОпераций_ЕстьКоды(Операция) Тогда
		ТекстОшибки = НСтр("ru = 'Ввод в оборот не содержит кодов'");
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ТипОпераций = Перечисление_ТипыОпераций().РегистрацияСтрокиВводаВОборот;
	СтарыеОперации = Операция_НайтиПодчиненныеОперации(ОписаниеЗадачи.Операция, ТипОпераций, Истина);
	Операции_Удалить(СтарыеОперации);
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Если КодыОпераций_ЕстьКоды(Операция, Стр.КлючСтрокиОперации) Тогда
			Операция_СоздатьРегистрациюСтрокиВводаВОборот(ОписаниеОперации, Стр);
		КонецЕсли;
	КонецЦикла;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьРегистрациюСтрокВводаВОборот;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправляетсяВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации);
	
КонецПроцедуры

Процедура Задача_ВводВОборот_ПроверитьСтатусыСтрок(ОписаниеЗадачи)
	
	ТипОпераций = Перечисление_ТипыОпераций().РегистрацияСтрокиВводаВОборот;
	ВсеЗадачиЗавершены = Задача_ВсеПодчиненныеОперацииЗавершены(ОписаниеЗадачи.Операция, ТипОпераций);
	Если Не ВсеЗадачиЗавершены Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОшибкиВПодчиненных = Задача_ЕстьОшибкиВПодчиненныхОперациях(ОписаниеЗадачи.Операция, ТипОпераций);
	
	Если ЕстьОшибкиВПодчиненных Тогда
		
		ВсеОшибки = Задача_ОшибкиВПодчиненныхОперациях(ОписаниеЗадачи.Операция, ТипОпераций);
		ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ИсправитьОшибку;
		ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОшибкаОбработки;
		ОписаниеЗадачи.ОписаниеОшибки = СоединитьСтроку(ВсеОшибки, Символы.ПС);
		Задача_Записать(ОписаниеЗадачи);
		
	Иначе
		Задача_Завершить(ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти // ОбработкаВсехСтрокВводаВОборот

// #Область ОбработкаКаждойСтрокиВводаВОборот

Процедура Задача_ВводВОборот_СоздатьВСервисе(ОписаниеЗадачи)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	СпособВводаВОборот = ДопРеквизит_Прочитать(ОперацияОснование, "СпособВводаВОборот");
	Контент = Контент_ВводВОборот(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_ВводВОборот_Создать(ОписаниеЗадачи, Контент, СпособВводаВОборот);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьФайлДляПодписиВводаВОборот;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_ВводВОборот(ОписаниеОперации);
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_ВводВОборот_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_ВводВОборот_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.id;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ВводВОборот_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_ВводВОборот_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьВводаВОборот;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_ВводВОборот_ПроверитьСтатус(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = Неопределено;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьВводаВОборот;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьВводаВОборот;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		Реквизиты = ЗначенияРеквизитовОбъекта_Марк(Операция, "ОперацияОснование, КлючСтрокиОперацииОснования");
		Если КодыОпераций_ЕстьАТК(Реквизиты.ОперацияОснование, Реквизиты.КлючСтрокиОперацииОснования) Тогда
			НовыйСтатус = СтатусыОпераций.ЗарегистрированВГИС;
			НовоеДействие = ТребуемыеДействия.РасформироватьАТКПослеРегистрации;
		Иначе
			НовыйСтатус = СтатусыОпераций.ОперацияЗавершена;
			НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		КонецЕсли;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSendingError")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedError") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус ввода в оборот: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ВводВОборот_РасформироватьАТКПослеРегистрации(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	Организация = ОписаниеОперации.Организация;
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	КлючСтрокиОперацииОснования = ОписаниеОперации.КлючСтрокиОперацииОснования;
	ОбщийТипУпаковкиАТК = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.АТК;
	
	ТаблицаКодовОперации = КодыОпераций_Прочитать(ОперацияОснование, КлючСтрокиОперацииОснования);
	ТаблицаКодов_ПрочитатьИнформациюОКодах(ТаблицаКодовОперации);
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	Для каждого Стр Из ТаблицаКодовОперации Цикл
		Если Стр.ОбщийТипУпаковки = ОбщийТипУпаковкиАТК Тогда
			СтрКода = ТаблицаКодов.Добавить();
			СтрКода.КлючКода = Стр.КлючКода;
			СтрКода.КлючСтрокиДокумента = Стр.КлючСтрокиДокумента;
			СтрКода.УдалитьИзДокумента = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьИнформациюИСтатусыКодов(ТаблицаКодов);
	ТаблицаКодов_ОбновитьСтатусы(ТаблицаКодов, Организация);
	
	Отбор = Новый Структура("КлючАгрегата");
	ОтборАТК = Новый Структура("ОбщийТипУпаковки", ОбщийТипУпаковкиАТК);
	Для каждого СтрАТК Из ТаблицаКодов.НайтиСтроки(ОтборАТК) Цикл
		Отбор.КлючАгрегата = СтрАТК.КлючКода;
		Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
			СтрКода.КлючСтрокиДокумента = СтрАТК.КлючСтрокиДокумента;
			СтрКода.КлючАгрегата = Неопределено;
		КонецЦикла;
	КонецЦикла;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		ТаблицаКодов_ЗаполнитьПоДокументуКлючиНоменклатуры1С(ТаблицаКодов, ДокументУчета);
		ТаблицаКодов_ЗаписатьИнформациюИСтатусыКодов(ТаблицаКодов);
		КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, Ложь);
		ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета);
		Задача_Завершить(ОписаниеЗадачи);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

// #КонецОбласти // ОбработкаКаждойСтрокиВводаВОборот

// #КонецОбласти // ВводВОборот

// #Область ОтчетОНанесении

Функция ОчередьОбмена_ОтчетОНанесении_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеОтчетОНанесенииНаТСД);
	Результат.Добавить(ТребуемыеДействия.ПроверитьГотовностьОтчетаОНанесенииНаТСД);
	Результат.Добавить(ТребуемыеДействия.ПолучитьКодыОтчетаОНанесенииНаТСД);
	Результат.Добавить(ТребуемыеДействия.СоздатьРегистрациюСтрокОтчетаОНанесении);
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеОтчетОНанесении);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлОтчетаОНанесенииДляПодписи);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьГотовностьОтчетаОНанесении);
	Результат.Добавить(ТребуемыеДействия.ОбновитьОтчетПослеЧастичнойПриемки);
	Результат.Добавить(ТребуемыеДействия.ОбновитьНомерПартииПослеРегистрации);
	Результат.Добавить(ТребуемыеДействия.ПроверитьРегистрациюСтрокОтчетаОНанесении);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_ОтчетОНанесении_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьВСервисеОтчетОНанесенииНаТСД Тогда
		Задача_ОтчетОНанесенииНаТСД_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьГотовностьОтчетаОНанесенииНаТСД Тогда
		Задача_ОтчетОНанесенииНаТСД_ПроверитьСтатусНаполнения(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьКодыОтчетаОНанесенииНаТСД Тогда
		Задача_ОтчетОНанесенииНаТСД_ПолучитьКоды(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьРегистрациюСтрокОтчетаОНанесении Тогда
		Задача_ОтчетОНанесении_СоздатьОтчетНаКаждуюСтроку(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьВСервисеОтчетОНанесении Тогда
		Задача_ОтчетОНанесении_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлОтчетаОНанесенииДляПодписи Тогда
		Задача_ОтчетОНанесении_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_ОтчетОНанесении_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьГотовностьОтчетаОНанесении Тогда
		Задача_ОтчетОНанесении_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОбновитьОтчетПослеЧастичнойПриемки Тогда
		Задача_ОтчетОНанесении_ОбновитьПослеЧастичнойПриемки(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьРегистрациюСтрокОтчетаОНанесении Тогда
		Задача_ОтчетОНанесении_ПроверитьСтатусСтрок(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОбновитьНомерПартииПослеРегистрации Тогда
		Задача_ОтчетОНанесении_ОбновитьНомерПартииПослеРегистрации(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

// #Область ОбработкаВсехСтрокОтчета

Процедура Задача_ОтчетОНанесении_СоздатьОтчетНаКаждуюСтроку(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	
	Если Не КодыОпераций_ЕстьКоды(Операция) Тогда
		ТекстОшибки = НСтр("ru = 'Отчет о нанесении не содержит кодов'");
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ТипОпераций = Перечисление_ТипыОпераций().РегистрацияСтрокиОтчетаОНанесении;
	СтарыеОперации = Операция_НайтиПодчиненныеОперации(ОписаниеЗадачи.Операция, ТипОпераций, Истина);
	Операции_Удалить(СтарыеОперации);
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Если КодыОпераций_ЕстьКоды(Операция, Стр.КлючСтрокиОперации) Тогда
			Операция_СоздатьРегистрациюСтрокиОтчетаОНанесении(ОписаниеОперации, Стр);
		КонецЕсли;
	КонецЦикла;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьРегистрациюСтрокОтчетаОНанесении;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправляетсяВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации);
	
КонецПроцедуры

Процедура Задача_ОтчетОНанесении_ПроверитьСтатусСтрок(ОписаниеЗадачи)
	
	ТипОперации = Перечисление_ТипыОпераций().РегистрацияСтрокиОтчетаОНанесении;
	ВсеЗадачиЗавершены = Задача_ВсеПодчиненныеОперацииЗавершены(ОписаниеЗадачи.Операция, ТипОперации);
	Если Не ВсеЗадачиЗавершены Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОшибкиВПодчиненных = Задача_ЕстьОшибкиВПодчиненныхОперациях(ОписаниеЗадачи.Операция, ТипОперации);
	ЕстьПринятыеЧастично = Задача_ВПодчиненныхОперацияхЕстьПринятыеЧастично(ОписаниеЗадачи.Операция, ТипОперации);
	
	Если ЕстьОшибкиВПодчиненных Тогда
		
		ВсеОшибки = Задача_ОшибкиВПодчиненныхОперациях(ОписаниеЗадачи.Операция, ТипОперации);
		ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ИсправитьОшибку;
		ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОшибкаОбработки;
		ОписаниеЗадачи.ОписаниеОшибки = СоединитьСтроку(ВсеОшибки, Символы.ПС);
		Задача_Записать(ОписаниеЗадачи);
		
	ИначеЕсли ЕстьПринятыеЧастично Тогда
		
		ВсеОшибки = Задача_ОшибкиВПодчиненныхОперациях(ОписаниеЗадачи.Операция, ТипОперации);
		ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПринятЧастично;
		ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ПринятЧастично;
		ОписаниеЗадачи.ОписаниеОшибки = СоединитьСтроку(ВсеОшибки, Символы.ПС);
		Задача_Записать(ОписаниеЗадачи);
		
	Иначе
		
		Задача_Завершить(ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти // ОбработкаВсехСтрокОтчета

// #Область ОбработкаКаждойСтрокиОтчета

Процедура Задача_ОтчетОНанесении_СоздатьВСервисе(ОписаниеЗадачи)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	
	Попытка
		Контент = Контент_ОтчетОНанесении(ОписаниеОперации);
		Ответ = Маркировка_ОтчетОНанесении_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьФайлОтчетаОНанесенииДляПодписи;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_ОтчетОНанесении_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_ОтчетОНанесении_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.id;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ОтчетОНанесении_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_ОтчетОНанесении_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьОтчетаОНанесении;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправляетсяВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_ОтчетОНанесении_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьОтчетаОНанесении;
	
	ИначеЕсли НРег(СтатусДокумента) = НРег("TsdProcessStart") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьОтчетаОНанесении;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ReadyForSend") Тогда
		
		НовыйСтатус = СтатусыОпераций.НаполненНаТСД;
		НовоеДействие = ТребуемыеДействия.ПолучитьФайлОтчетаОНанесенииДляПодписи;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьОтчетаОНанесении;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьОтчетаОНанесении;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОбновлениеСтатусовКодов;
		НовоеДействие = ТребуемыеДействия.ОбновитьНомерПартииПослеРегистрации;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSendingError")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedError") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedPartially") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОбновлениеСтатусовКодов;
		НовоеДействие = ТребуемыеДействия.ОбновитьОтчетПослеЧастичнойПриемки;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус отчета о нанесении: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ОтчетОНанесении_ОбновитьПослеЧастичнойПриемки(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	Организация = ОписаниеОперации.Организация;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	КлючСтрокиОперацииОснования = ОписаниеОперации.КлючСтрокиОперацииОснования;
	
	Попытка
		Ответ = Маркировка_ОтчетОНанесении_ИнформацияОЧастичнойПриемке(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	errors = Ответ.Результат.errors;
	appliedCodes = Ответ.Результат.appliedCodes;
	
	ТаблицаКодов = КодыОпераций_ТаблицаКодов(ОперацияОснование, КлючСтрокиОперацииОснования);
	КодыМаркировки_Прочитать(ТаблицаКодов);
	Для Сч = -(ТаблицаКодов.Количество() - 1) По 0 Цикл
		СтрКода = ТаблицаКодов[-Сч];
		Если appliedCodes.Найти(СтрКода.КодМаркировки) = Неопределено Тогда
			ТаблицаКодов.Удалить(СтрКода);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаКодов_ПрочитатьСтатусыКодов(ТаблицаКодов);
	Если ТаблицаКодов_ОбновитьСтатусПоПервомуКоду(ТаблицаКодов, Организация, ВидПродукции) Тогда
		ТаблицаКодов_ЗаписатьСтатусыКодов(ТаблицаКодов);
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПринятЧастично;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ПринятЧастично;
	ОписаниеЗадачи.ОписаниеОшибки = ОтчетОНанесении_ОшибкиЧастичноПринятыхКодов(errors);
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Функция ОтчетОНанесении_ОшибкиЧастичноПринятыхКодов(errors)
	
	ОшибкиСКодами = Новый Массив;
	Для каждого Элемент Из МассивСтруктур_Разбить(errors, "errorCode") Цикл
		
		ОписанияОшибок = Элемент.Значение;
		ТекстОшибки = СокрЛП(ОписанияОшибок[0].errorMessage);
		ВсеКоды = МассивСтруктур_Выгрузить(ОписанияОшибок, "code");
		СписокКодов = СписокКодовДляТекстаОшибки(ВсеКоды);
		
		ОшибкиСКодами.Добавить(ТекстОшибки + ": " + СписокКодов);
		
	КонецЦикла;
	
	Возврат СоединитьСтроку(ОшибкиСКодами, Символы.ПС);
	
КонецФункции

Процедура Задача_ОтчетОНанесении_ОбновитьНомерПартииПослеРегистрации(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	Организация = ОписаниеОперации.Организация;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	КлючСтрокиОперации = ОписаниеОперации.КлючСтрокиОперацииОснования;
	ИдентификаторДокумента = ОписаниеЗадачи.ИдентификаторДокумента;
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если Не НастройкиМодуля().ИспользоватьПартионныйУчет
		Или Не ВидПродукцииПоддерживаетПартионныйУчет(ВидПродукции) Тогда
		Задача_Завершить(ОписаниеЗадачи);
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов = КодыОпераций_ТаблицаКодов(ОперацияОснование, КлючСтрокиОперации);
	КодыМаркировки_Прочитать(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	УдалосьОбновить = ТаблицаКодов_ОбновитьСтатусы(ТаблицаКодов, Организация);
	
	ОтборСтрокБезПартии = Новый Структура("НомерПартии", "");
	СтрокиБезПартии = ТаблицаКодов.НайтиСтроки(ОтборСтрокБезПартии);
	
	НомерПартии = "";
	
	Если СтрокиБезПартии.Количество() > 0 Тогда
		
		ОписаниеОснования = Операция_ПрочитатьОперацию(ОперацияОснование);
		ДопРеквизиты = ОписаниеОснования.ДопРеквизиты;
		Стр = ОписаниеОснования.Товары.Найти(КлючСтрокиОперации, "КлючСтрокиОперации");
		
		НомерПартии = ДопРеквизиты.НомерПартии;
		Если ЗначениеЗаполнено(Стр.НомерПартии) Тогда
			НомерПартии = Стр.НомерПартии;
		КонецЕсли;
		
		Для Каждого СтрБезПартии Из СтрокиБезПартии Цикл
			СтрБезПартии.НомерПартии = НомерПартии;
		КонецЦикла;
		
	КонецЕсли;
	
	Если УдалосьОбновить 
		Или ЗначениеЗаполнено(НомерПартии) Тогда
		ТаблицаКодов_ЗаписатьИнформациюИСтатусыКодов(ТаблицаКодов);
	КонецЕсли;
	
	Задача_Завершить(ОписаниеЗадачи);
	
КонецПроцедуры

// #КонецОбласти // ОбработкаКаждойСтрокиОтчета

// #КонецОбласти // ОтчетОНанесении

// #Область ОтчетОНанесенииНаТСД

Процедура Задача_ОтчетОНанесенииНаТСД_СоздатьВСервисе(ОписаниеЗадачи)
	
	ИдентификаторДокумента = ОписаниеЗадачи.ИдентификаторДокумента;
	
	Если Не ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
		
		ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
		Контент = Контент_ОтчетОНанесенииНаТСД(ОписаниеОперации);
		
		Попытка
			Ответ = Маркировка_НаполнениеДокумента_Создать(ОписаниеЗадачи, Контент);
		Исключение
			Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		КонецПопытки;
		
		Если Не ЗначениеЗаполнено(Ответ)
			Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
			Возврат;
		КонецЕсли;
		
		ОписаниеЗадачи.ИдентификаторДокумента = Ответ.Результат;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьОтчетаОНанесенииНаТСД;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленНаТСД;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ОтчетОНанесенииНаТСД_ПроверитьСтатусНаполнения(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created")
		Или НРег(СтатусДокумента) = НРег("Processed")Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьОтчетаОНанесенииНаТСД;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Enriched")
		Или НРег(СтатусДокумента) = НРег("Completed")Тогда
		
		НовыйСтатус = СтатусыОпераций.НаполненНаТСД;
		НовоеДействие = ТребуемыеДействия.ПолучитьКодыОтчетаОНанесенииНаТСД;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Failed") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус отчета о нанесении на ТСД: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ОтчетОНанесенииНаТСД_ПолучитьКоды(ОписаниеЗадачи)
	
	Организация = ОписаниеЗадачи.Организация;
	Операция = ОписаниеЗадачи.Операция;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	
	Попытка
		Ответ = Маркировка_ОтчетОНанесенииНаТСД_Результат(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	Контент = Ответ.Результат;
	
	ОтчетОНанесенииНаТСД_НормализоватьРазделителиGS1(Контент);
	ОтчетОНанесенииНаТСД_РазделитьСклеенныеКоды(Контент, ВидПродукции);
	ОтчетОНанесенииНаТСД_УдалитьКодыТранспортнойУпаковки(Контент);
	ОтчетОНанесенииНаТСД_ВосстановитьРазделительGS1(Контент, ВидПродукции);
	
	ТаблицаКодов = Задача_ОтчетОНанесенииНаТСД_ТаблицаКодов(Операция, Контент.positions);
	
	Если ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация, Ложь) Тогда
		Задача_ОтчетОНанесенииНаТСД_ЗавершитьПолучениеКодов(ОписаниеЗадачи, ТаблицаКодов);
	Иначе
		Задача_ЗаписатьКодыВРедакторДляРаспознавания(ОписаниеЗадачи, ТаблицаКодов);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ОтчетОНанесенииНаТСД_ЗавершитьПолучениеКодов(ОписаниеЗадачи, ТаблицаКодов)
	
	Операция = ОписаниеЗадачи.Операция;
	ДокументУчета = ЗначениеРеквизитаОбъекта_Марк(Операция , "ДокументУчета");
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ТаблицаКодов_ЗаполнитьПоДокументуКлючиНоменклатуры1С(ТаблицаКодов, ДокументУчета);
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
		КодыОпераций_Записать(ТаблицаКодов, Операция);
		КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, Ложь);
		ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета);
		
		ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().СоздатьРегистрациюСтрокОтчетаОНанесении;
		Задача_Записать(ОписаниеЗадачи);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ОтчетОНанесенииНаТСД_НормализоватьРазделителиGS1(Контент) Экспорт
	
	Для Каждого position Из Контент.positions Цикл
		Для Каждого Элемент Из position.codes Цикл
			Элемент.code = ВосстановитьРазделительGS1(Элемент.code);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтчетОНанесенииНаТСД_РазделитьСклеенныеКоды(Контент, ВидПродукции) Экспорт
	
	НастройкиРазбора = НастройкиРазбораКодаМаркировки(ВидПродукции);
	ШаблоныКодов = НастройкиРазбора.ШаблоныКодовМаркировки;
	
	Для Каждого position Из Контент.positions Цикл
		Для Сч = -position.codes.ВГраница() По 0 Цикл
			
			Стр = position.codes[-Сч];
			ДлинаКода = СтрДлина(Стр.code);
			
			Для Сч2 = -(ШаблоныКодов.Количество()-1) По 0 Цикл
				
				ШаблонКода = ШаблоныКодов[-Сч2];
				Если ШаблонКода.ВидУпаковки = Перечисления.КонтурМаркировка_ВидыУпаковок.Логистическая Тогда
					Продолжить;
				КонецЕсли;
				
				Если ДлинаКода = ШаблонКода.Длина Тогда
					Прервать; // Код по длине соответствует шаблону, разделять его не надо
				ИначеЕсли ДлинаКода < (ШаблонКода.Длина * 2) Тогда
					Продолжить; // Длина кода меньше двух шаблонов, разделять нечего
				КонецЕсли;
				
				Совпадения = Плагин_НайтиСовпаденияПоШаблону(Стр.code, ШаблонКода.РегулярноеВыражение);
				Если Не ЗначениеЗаполнено(Совпадения) Тогда
					Продолжить;
				КонецЕсли;
				Если СоединитьСтроку(Совпадения) <> Стр.code Тогда
					Продолжить; // Потерялась часть строки кода, разделять нельзя
				КонецЕсли;
				
				position.codes.Удалить(-Сч);
				
				Для Сч3 = -Совпадения.ВГраница() По 0 Цикл
					НоваяСтрока = СкопироватьОбъект(Стр);
					НоваяСтрока.code = Совпадения[-Сч3];
					НоваяСтрока.markingCodeType = ТипКодаМаркировкиВСервисе(ШаблонКода.ВидУпаковки);
					position.codes.Вставить(-Сч, НоваяСтрока);
				КонецЦикла;
				
				Прервать;
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтчетОНанесенииНаТСД_УдалитьКодыТранспортнойУпаковки(Контент)
	
	Для Каждого position Из Контент.positions Цикл
		Для Сч = -position.codes.ВГраница() По 0 Цикл
			ТипУпаковки = ТипУпаковкиПоТипуКодаМаркировкиИзСервиса(position.codes[-Сч].markingCodeType);
			Если ТипУпаковки = Перечисления.КонтурМаркировка_ТипыУпаковок.МонотоварнаяУпаковка
				Или ТипУпаковки = Перечисления.КонтурМаркировка_ТипыУпаковок.МультитоварнаяУпаковка Тогда
				position.codes.Удалить(-Сч);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтчетОНанесенииНаТСД_ВосстановитьРазделительGS1(Контент, ВидПродукции) Экспорт
	
	Если ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Молоко Тогда
		
		ОтчетОНанесенииНаТСД_ВосстановитьРазделительGS1_МолочнаяПродукция(Контент);
		
	ИначеЕсли ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Вода
		Или ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Пиво
		Или ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Бады
		Или ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Антисептики Тогда
		
		ОтчетОНанесенииНаТСД_ВосстановитьРазделительGS1_ВодаПивоБадыАнтисептики(Контент);
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтчетОНанесенииНаТСД_ВосстановитьРазделительGS1_МолочнаяПродукция(Контент)
	
	ДлинаБезРазделителяБезВеса = 30;
	ДлинаДоРазделителяБезВеса = 24;
	
	ДлинаБезРазделителяСВесом = 40;
	ДлинаДоРазделителяСВесом = 30;
	
	Разделитель = РазделительGS1();
	
	Для Каждого position Из Контент.positions Цикл
		Для Каждого Эл Из position.codes Цикл
			
			Если Найти(Эл.code, Разделитель) = 0 Тогда // Разделителя нет
				
				Если СтрДлина(Эл.code) = ДлинаБезРазделителяБезВеса Тогда // Длина кода соответствует шаблону без веса
					Эл.code = Лев(Эл.code, ДлинаДоРазделителяБезВеса) + Разделитель + Сред(Эл.code, ДлинаДоРазделителяБезВеса + 1);
					Продолжить;
				КонецЕсли;
				
				Если СтрДлина(Эл.code) = ДлинаБезРазделителяСВесом Тогда // Длина кода соответствует шаблону с весом
					// восстановим разделитель перед весом
					Эл.code = Лев(Эл.code, ДлинаДоРазделителяСВесом) + Разделитель + Сред(Эл.code, ДлинаДоРазделителяСВесом + 1);
					// восстановим разделитель перед кодом проверки
					Эл.code = Лев(Эл.code, ДлинаДоРазделителяБезВеса) + Разделитель + Сред(Эл.code, ДлинаДоРазделителяБезВеса + 1);
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтчетОНанесенииНаТСД_ВосстановитьРазделительGS1_ВодаПивоБадыАнтисептики(Контент)
	
	ДлинаБезРазделителя = 37;
	ДлинаДоРазделителя = 31;
	
	Разделитель = РазделительGS1();
	
	Для Каждого position Из Контент.positions Цикл
		Для Каждого Эл Из position.codes Цикл
			
			Если Найти(Эл.code, Разделитель) = 0 // Разделителя нет
				И СтрДлина(Эл.code) = ДлинаБезРазделителя Тогда // Длина кода соответствует шаблону
				Эл.code = Лев(Эл.code, ДлинаДоРазделителя) + Разделитель + Сред(Эл.code, ДлинаДоРазделителя + 1);
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция Задача_ОтчетОНанесенииНаТСД_ТаблицаКодов(Операция, positions)
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	
	Для Каждого position Из positions Цикл
		
		СтрТовара = ОписаниеОперации.Товары.Найти(position.number, "НомерСтроки");
		Если СтрТовара = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		codes = СвойствоСтруктуры(position, "codes");
		Если Не ЗначениеЗаполнено(codes) Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого code Из codes Цикл
			Стр = ТаблицаКодов.Добавить();
			Стр.КодМаркировки = code.code;
			Стр.ПолныйКод = code.originalCode;
			Стр.ТипУпаковки = ТипУпаковкиПоТипуКодаМаркировкиИзСервиса(code.markingCodeType);
			Стр.КлючНоменклатуры1С = СтрТовара.КлючНоменклатуры1С;
			Стр.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
			Стр.КлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаЗначений_СвернутьПоВсемКолонкам(ТаблицаКодов);
	
	Возврат ТаблицаКодов;
	
КонецФункции

Процедура ОчередьОбмена_ОтчетОНанесенииНаТСД_НачатьРедактирование(Операция) Экспорт
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	ОписаниеЗадачи = Задача_Прочитать(Операция);
	
	Если ОписаниеЗадачи.ТребуемоеДействие <> ТребуемыеДействия.ПроверитьГотовностьОтчетаОНанесенииНаТСД Тогда
		ТекстОшибки = НСтр("ru = 'Невозможно начать редактирование отчета о нанесении на ТСД в статусе %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ОписаниеЗадачи.ТребуемоеДействие);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ЗавершитьВнесениеИзменений;
	ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОжиданиеЗавершенияИзменений;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура ОчередьОбмена_ОтчетОНанесенииНаТСД_ЗавершитьРедактирование(Операция) Экспорт
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	ОписаниеЗадачи = Задача_Прочитать(Операция);
	
	Если ОписаниеЗадачи.ТребуемоеДействие <> ТребуемыеДействия.ЗавершитьВнесениеИзменений Тогда
		
		ТекстОшибки = НСтр("ru = 'Невозможно завершить редактирование отчета о нанесении на ТСД в статусе %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ОписаниеЗадачи.ТребуемоеДействие);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
	
	НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьОтчетаОНанесенииНаТСД;
	
	СтатусыОперации_ЗаписатьОсновнойСтатус(Операция, НовыйСтатус);
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

// #КонецОбласти // ОтчетОНанесенииНаТСД

// #Область НаполнениеАгрегатовНаТСД

Функция ОчередьОбмена_НаполнениеАгрегатовНаТСД_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.ПроверитьВозможностьРегистрацииВсехАгрегатов);
	Результат.Добавить(ТребуемыеДействия.СоздатьНаКаждыйАгрегатНаполнениеНаТСД);
	Результат.Добавить(ТребуемыеДействия.ПроверитьВозможностьРегистрацииАгрегата);
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеНаполнениеАгрегатаНаТСД);
	Результат.Добавить(ТребуемыеДействия.ПолучитьРезультатНаполненияАгрегатаНаТСД);
	Результат.Добавить(ТребуемыеДействия.ОбновитьДокументАгрегацииВСервисе);
	Результат.Добавить(ТребуемыеДействия.ПроверитьСтатусНаполненияАгрегатаНаТСД);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлАгрегатаДляПодписи);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_НаполнениеАгрегатовНаТСД_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.ПроверитьВозможностьРегистрацииВсехАгрегатов Тогда
		Задача_Агрегация_ПроверитьВозможностьРегистрацииВсехАгрегатов(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьНаКаждыйАгрегатНаполнениеНаТСД Тогда
		Задача_НаполнениеАгрегатовНаТСД_СоздатьНаполнениеНаКаждыйАгрегат(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьВозможностьРегистрацииАгрегата Тогда
		Задача_Агрегация_ПроверитьВозможностьРегистрацииАгрегата(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьВСервисеНаполнениеАгрегатаНаТСД Тогда
		Задача_НаполнениеАгрегатовНаТСД_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьРезультатНаполненияАгрегатаНаТСД Тогда
		Задача_НаполнениеАгрегатовНаТСД_ПолучитьРезультат(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОбновитьДокументАгрегацииВСервисе Тогда
		Задача_НаполнениеАгрегатовНаТСД_ОбновитьДокумент(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьСтатусНаполненияАгрегатаНаТСД Тогда
		Задача_НаполнениеАгрегатовНаТСД_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлАгрегатаДляПодписи Тогда
		Задача_Агрегация_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_Агрегация_ОтправитьПодпись(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

// #Область ОбработкаВсехАгрегатовНаТСД

Процедура Задача_НаполнениеАгрегатовНаТСД_СоздатьНаполнениеНаКаждыйАгрегат(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	КодыМаркировки_Прочитать(ТаблицаКодов);
	ТаблицаКодов.Сортировать("КодМаркировки Убыв");
	
	ТипОпераций = Перечисление_ТипыОпераций().НаполнениеОдногоАгрегатаНаТСД;
	СтарыеОперации = Операция_НайтиПодчиненныеОперации(Операция, ТипОпераций);
	Операции_Удалить(СтарыеОперации);
	
	Для каждого Стр Из ТаблицаКодов Цикл
		Операция_СоздатьНаполнениеАгрегатаНаТСД(ОписаниеОперации, Стр.КлючСтрокиОперации, Стр.КлючКода);
	КонецЦикла;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ОжиданиеГотовности;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

// #КонецОбласти // ОбработкаВсехАгрегатовНаТСД

// #Область ОбработкаКаждогоАгрегатаНаТСД

Процедура Задача_НаполнениеАгрегатовНаТСД_СоздатьВСервисе(ОписаниеЗадачи)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	НаполнитьНаТСД = Истина;
	Контент = Контент_НаполнениеАгрегатаНаТСД(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_Агрегация_Создать(ОписаниеЗадачи, Контент, НаполнитьНаТСД);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьНаполненияАгрегатаНаТСД;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_НаполнениеАгрегатовНаТСД_ПроверитьГотовность(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьНаполненияАгрегатаНаТСД;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("TsdProcessStart") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьНаполненияАгрегатаНаТСД;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ReturnedToTsd") Тогда
		
		НовыйСтатус = СтатусыОпераций.ВозвращенНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьНаполненияАгрегатаНаТСД;
		
	ИначеЕсли Задача_НаполнениеАгрегатовНаТСД_МожноПолучитьРезультат(СтатусДокумента) Тогда
		
		НовыйСтатус = СтатусыОпераций.НаполненНаТСД;
		НовоеДействие = ТребуемыеДействия.ПолучитьРезультатНаполненияАгрегатаНаТСД;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус наполнения агрегата на ТСД: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_НаполнениеАгрегатовНаТСД_ПолучитьРезультат(ОписаниеЗадачи)
	
	Организация = ОписаниеЗадачи.Организация;
	Операция = ОписаниеЗадачи.Операция;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	ЗаполнитьПолныеКоды = ОписаниеОперации.ДопРеквизиты.ПолучатьПолныеКодыПриНаполненииАгрегатаНаТСД;
	
	Попытка
		Ответ = Маркировка_Агрегация_ДокументАгрегации(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	codes = СвойствоСтруктуры(Ответ.Результат, "codes", Новый Массив);
	originalCodes = СвойствоСтруктуры(Ответ.Результат, "originalCodes", Новый Массив);
	ТаблицаНовыхКодов = ТаблицаКодов_ЗагрузитьКодыМаркировки(originalCodes, ЗаполнитьПолныеКоды);
	
	Если ТаблицаКодов_НормализоватьКоды(ТаблицаНовыхКодов, Организация, Ложь) Тогда
		
		ОбновитьДокументВСервисе = Ложь;
		Отбор = Новый Структура("ТипШтрихкода", Перечисления.КонтурМаркировка_ТипыШтрихкодов.SSCC);
		
		Для Каждого Стр Из ТаблицаНовыхКодов.НайтиСтроки(Отбор) Цикл
			
			Если Не МассивСодержитЗначение(codes, Стр.КодМаркировки) Тогда
				ОбновитьДокументВСервисе = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Задача_НаполнениеАгрегатовНаТСД_ЗавершитьПолучениеКодов(ОписаниеЗадачи, ТаблицаНовыхКодов, ОбновитьДокументВСервисе);

	Иначе
		Задача_ЗаписатьКодыВРедакторДляРаспознавания(ОписаниеЗадачи, ТаблицаНовыхКодов);
	КонецЕсли;
	
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_НаполнениеАгрегатовНаТСД_ЗавершитьПолучениеКодов(ОписаниеЗадачи, ТаблицаКодов, ОбновитьДокументВСервисе = Ложь)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	КлючАгрегата = ОписаниеОперации.ДопРеквизиты.КлючКода;
	КодАгрегата = КодМаркировки_НайтиПоКлючу(КлючАгрегата);
	РегистрироватьАгрегаты = ОписаниеОперации.ДопРеквизиты.РегистрироватьАгрегатыПослеНаполнения;
	
	ТаблицаКодов_ЗаполнитьКлючиКодов(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	ОшибкаДублирования = Ложь;
	
	Для каждого Стр Из ТаблицаКодов Цикл
		
		Если Стр.КодМаркировки = КодАгрегата Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.КодАгрегата) И Стр.КодАгрегата <> КодАгрегата Тогда
			Стр.ОписаниеОшибки = ОписаниеОшибки_КодПринадлежитДругомуАгрегату(Стр.КодАгрегата);
			ОшибкаДублирования = Истина;
			Продолжить;
		КонецЕсли;
		
		Стр.КодАгрегата = КодАгрегата;
		Стр.КлючАгрегата = КлючАгрегата;
		Стр.УдалитьИзДокумента = Истина;
		
	КонецЦикла;
	
	Если ОшибкаДублирования Тогда
		Задача_ЗаписатьКодыВРедакторДляИсправленияДублей(ОписаниеЗадачи, ТаблицаКодов);
		Возврат;
	КонецЕсли;
	
	Задача_НаполнениеАгрегатовНаТСД_ДобавитьСтарыеКоды(ТаблицаКодов, КлючАгрегата, ДокументУчета);
	
	СтрАгрегата = ТаблицаКодов.Найти(КлючАгрегата, "КлючКода");
	СтрАгрегата.УдалитьИзДокумента = КодыДокументов_ЕстьКодВСтруктуреУпаковок(ДокументУчета, КлючАгрегата);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
		
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			
			КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, Ложь);
			ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета);
			
		КонецЕсли;
		
		Если РегистрироватьАгрегаты Тогда
			Если ОбновитьДокументВСервисе Тогда
				ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ОбновитьДокументАгрегацииВСервисе;
			Иначе
				ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьСтатусНаполненияАгрегатаНаТСД;
			КонецЕсли;
			Задача_Записать(ОписаниеЗадачи);
		Иначе
			Задача_Завершить(ОписаниеЗадачи);
		КонецЕсли;
		
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура Задача_НаполнениеАгрегатовНаТСД_ОбновитьДокумент(ОписаниеЗадачи)
	
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	ИдентификаторДокумента = ОписаниеЗадачи.ИдентификаторДокумента;
	Контент = Контент_Агрегация_ОбновлениеДокумента(ОписаниеОперации);
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	
	Попытка
		Ответ = Маркировка_Агрегация_ОбновитьДокумент(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьСтатусНаполненияАгрегатаНаТСД;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ГотовКОтправкеВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_ОбновитьДокументНаполнениеАгрегатовНаТСД(Организация);
	
КонецПроцедуры

Процедура Задача_НаполнениеАгрегатовНаТСД_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	СтатусДокумента = Ответ.Результат.Статус;
	ТекстОшибки = Ответ.Результат.Комментарий;
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьНаполненияАгрегатаНаТСД;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("TsdProcessStart") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьНаполненияАгрегатаНаТСД;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ReturnedToTsd") Тогда
		
		НовыйСтатус = СтатусыОпераций.ВозвращенНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьНаполненияАгрегатаНаТСД;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ReadyForSend") Тогда
		
		НовыйСтатус = СтатусыОпераций.ГотовКОтправкеВГИС;
		НовоеДействие = ТребуемыеДействия.ПолучитьФайлАгрегатаДляПодписи;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОперацияЗавершена;
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSendingError")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedError") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус наполнения агрегата на ТСД: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_НаполнениеАгрегатовНаТСД_ДобавитьСтарыеКоды(ТаблицаКодов, КлючАгрегата, ДокументУчета)
	
	КлючСтрокиДокумента = Неопределено;
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		КлючСтрокиДокумента = КодыДокументов_КлючСтрокиДокумента(КлючАгрегата, ДокументУчета);
	КонецЕсли;
	
	ТаблицаСтарыхКодов = Новый_ТаблицаКодов();
	Стр = ТаблицаСтарыхКодов.Добавить();
	Стр.КлючКода = КлючАгрегата;
	Стр.КлючСтрокиДокумента = КлючСтрокиДокумента;
	
	ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаСтарыхКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаСтарыхКодов);
	
	Для каждого Стр Из ТаблицаСтарыхКодов Цикл
		СтрКода = ТаблицаКодов.Найти(Стр.КодМаркировки, "КодМаркировки");
		Если СтрКода = Неопределено Тогда
			СтрКода = ТаблицаКодов.Добавить();
			ЗаполнитьЗначенияСвойств(СтрКода, Стр);
			Если СтрКода.КлючКода <> КлючАгрегата Тогда
				СтрКода.КодАгрегата = Неопределено;
				СтрКода.КлючАгрегата = Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция Задача_НаполнениеАгрегатовНаТСД_МожноПолучитьРезультат(СтатусДокумента)
	
	ПодходящиеСтатусы = Новый Соответствие;
	ПодходящиеСтатусы.Вставить(НРег("ReadyForSend"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("CrptSending"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("CrptSendingError"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("CrptProcessing"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("CrptProcessedSuccess"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("CrptProcessedError"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("Archived"), Истина);
	
	Возврат (ПодходящиеСтатусы[НРег(СтатусДокумента)] = Истина);
	
КонецФункции

Функция ОписаниеОшибки_КодПринадлежитДругомуАгрегату(КодАгрегата) Экспорт
	
	ОписаниеОшибки = НСтр("ru = 'Код принадлежит другому агрегату %1'");
	
	Возврат ПараметрыВСтроку(ОписаниеОшибки, КодАгрегата);
	
КонецФункции

