// Опеределяет номер решения в терминах сервиса по принятому решению
//
// Параметры:
//  ВидПродукции - Строка - см. ВидыДокументовОбязательнойСертификации()
// 
// Возвращаемое значение:
//  Строка - тип производства в терминах сервиса
//
Функция КодРешенияВСервисе(ПринятоеРешение)
	
	КлючКэш = "СоответствиеКодовРешений";
	КодыРешений = Кэш_Прочитать(КлючКэш);
	
	Если Не ЗначениеЗаполнено(КодыРешений) Тогда
		
		ПринятыеРешения = Перечисление_ПринятыеРешения();
		
		КодыРешений = Новый Соответствие;
		КодыРешений.Вставить(ПринятыеРешения.ВыпускТоваровРазрешен, "ReleaseAllowed");
		КодыРешений.Вставить(ПринятыеРешения.ВыпускТоваровПоСтатье121, "SpecificRelease121");
		КодыРешений.Вставить(ПринятыеРешения.ВыпускТоваровПоСтатье122, "SpecificRelease122");
		КодыРешений.Вставить(ПринятыеРешения.ВыпускТоваровПоСтатье123, "SpecificRelease123");
		КодыРешений.Вставить(ПринятыеРешения.УсловныйВыпускТоваров, "ConditionallyRelease");
		КодыРешений.Вставить(ПринятыеРешения.ВыпускТоваровПриУсловииИсполненияОбязательств
		, "ReleaseWithCustomsDuties");
		
		Кэш_Поместить(КлючКэш, Новый ФиксированноеСоответствие(КодыРешений));
		
	КонецЕсли;
	
	Результат = КодыРешений.Получить(ПринятоеРешение);
	
	Если Результат = Неопределено Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Не удалось определить код решения в сервисе по принятому решению ""%1""'")
		, ПринятоеРешение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Опеределяет вид сертификата в терминах сервиса по виду документа сертфикации
