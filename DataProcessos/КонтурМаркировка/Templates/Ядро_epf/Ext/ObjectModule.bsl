Функция ТипыОбъектовИС() Экспорт
	
	КлючКэш = "СтандартноеОписаниеОбъектовИС";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат = Неопределено Тогда
		Результат = Интеграция_СтандартноеОписаниеОбъектовИС();
		Кэш_Поместить(КлючКэш, Результат);
	КонецЕсли;
	
	ПараметрыПМ = Новый Структура("Результат", Результат);
	ПМ_ОбработатьСобытие("ПриЗаполненииТиповОбъектовИС", ПараметрыПМ);
	Результат = ПараметрыПМ.Результат;
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция Интеграция_СтандартноеОписаниеОбъектовИС()
	
	Результат = Новый_ОписаниеТиповОбъектовИС();
	
	Интеграция_ЗаполнитьСтандартноеОписаниеБазовыхСправочников(Результат);
