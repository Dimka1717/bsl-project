	КодыМаркировки_Записать(ТаблицаКодов);
	
	ТаблицаКодов_ЗаполнитьКлючиАгрегатов(ТаблицаКодов);
	
	СвязиКлючейКодов_Записать(ТаблицаКодов);
	
