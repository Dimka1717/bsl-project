// Определяет вид возврата в оборот по причине вывода из оборота в терминах сервиса
//
// Параметры:
//  ПричинаВозвратаВОборот - см. Перечисление_ПричиныВозвратаВОборот()
// 
// Возвращаемое значение:
//  Строка - вид возврата в оборот в терминах сервиса
//
Функция ВидВозвратаВОборотВСервисе(ПричинаВозвратаВОборот)
	
	Причины = Перечисление_ПричиныВозвратаВОборот();
	
	ПричиныВСервисе = Новый Соответствие;
	ПричиныВСервисе.Вставить(Причины.ДистанционныйСпособПродажи, "RemoteSale");
	ПричиныВСервисе.Вставить(Причины.РозничнаяРеализация, "Retail");
	ПричиныВСервисе.Вставить(Причины.БезПоследующейРеализации, "OwnUse");
	ПричиныВСервисе.Вставить(Причины.Гостайна, "StateContract");
	ПричиныВСервисе.Вставить(Причины.Вендинг, "VendingReturn");
	ПричиныВСервисе.Вставить(Причины.ОтКонечногоПокупателя, "NotForSale");
	
	Результат = ПричиныВСервисе[ПричинаВозвратаВОборот];
	
	Если Результат = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось определить вид возврата в оборот по причине возврата в оборот в сервисе: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстСообщения, ПричинаВозвратаВОборот);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Опеределяет способ приемки в терминах сервиса
//
// Параметры:
//  СтатусПриемки - Строка - см. Перечисление_СтатусыПриемки()
// 
// Возвращаемое значение:
//  Строка - способ приемки в терминах сервиса
//
Функция СпособПриемкиВСервисе(СтатусПриемки)
	
	СтатусыПриемки = Перечисление_СтатусыПриемки();
	
	Если СтатусПриемки = СтатусыПриемки.Принято Тогда
		СпособПриемки = "AcceptAll";
	ИначеЕсли СтатусПриемки = СтатусыПриемки.Отклонено Тогда
		СпособПриемки = "RejectAll";
	ИначеЕсли СтатусПриемки = СтатусыПриемки.ПринятоЧастично Тогда
		СпособПриемки = "AcceptPartially";
	Иначе
		ВызватьИсключение НСтр(ПараметрыВСтроку("ru = 'Неизвестный статус приемки %1'", СтатусПриемки));
	КонецЕсли;
	
	Возврат СпособПриемки;
	
КонецФункции

// Опеределяет тип срока годности молока в терминах сервиса
//
// Параметры:
//  ОписаниеТовара - Структура - см. Новый_Товар()
// 
// Возвращаемое значение:
//  Строка
//
Функция ТипСрокаГодностиВСервисе(ОписаниеТовара)
	
	Если ОписаниеТовара.ВидПродукции <> Перечисления.КонтурМаркировка_ВидыПродукции.Молоко Тогда
		Возврат "None";
	КонецЕсли;
	
	ТипыСроковГодности = Перечисление_ТипыСроковГодности();
	
	Если ОписаниеТовара.ТипСрокаГодности = ТипыСроковГодности.СрокГодностиМеньше72 Тогда
		Результат = "MilkLessThan72";
	ИначеЕсли ОписаниеТовара.ТипСрокаГодности = ТипыСроковГодности.СрокГодностиБольше72 Тогда
		Результат = "MilkMoreThan72";
	ИначеЕсли ОписаниеТовара.ТипСрокаГодности = ТипыСроковГодности.СрокГодностиБольше72СУсловием Тогда
		Результат = "MilkAlternative";
	Иначе
		Результат = "None";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Опеределяет тип использования кодов в отчете о нанесении в терминах сервиса
