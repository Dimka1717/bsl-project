Функция ОчередьОбмена_ЗаказКодов_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьПодчиненныеЗаказы);
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеЗаказКодов);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлыДляПодписиЗаказа);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьГотовностьКодов);
	Результат.Добавить(ТребуемыеДействия.СоздатьЗадачуНаПолучениеКодов);
	Результат.Добавить(ТребуемыеДействия.ПолучитьНовыеКодыИзСервиса);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлыДляПодписиЗакрытияЗаказа);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодписьЗакрытиеЗаказа);
	Результат.Добавить(ТребуемыеДействия.ПроверитьСтатусыПодчиненныхЗаказов);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_ЗаказКодов_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьПодчиненныеЗаказы Тогда
		Задача_ЗаказКодов_СоздатьПодчиненныеЗаказы(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьВСервисеЗаказКодов Тогда
		Задача_ЗаказКодов_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлыДляПодписиЗаказа Тогда
		Задача_ЗаказКодов_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_ЗаказКодов_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьГотовностьКодов Тогда
		Задача_ЗаказКодов_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьЗадачуНаПолучениеКодов Тогда
		Задача_ЗаказКодов_СоздатьЗадачуНаПолучениеКодов(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьНовыеКодыИзСервиса Тогда
		Задача_ЗаказКодов_ПолучитьКодыИзСервиса(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлыДляПодписиЗакрытияЗаказа Тогда
		Задача_ЗаказКодов_ПолучитьКонтентЗакрытияДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодписьЗакрытиеЗаказа Тогда
		Задача_ЗаказКодов_ОтправитьПодписьЗакрытиеЗаказа(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьСтатусыПодчиненныхЗаказов Тогда
		Задача_ЗаказКодов_ПроверитьСтатусыПодчиненныхЗаказов(ОписаниеЗадачи);
		
	Иначе
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ЗаказКодов_СоздатьПодчиненныеЗаказы(ОписаниеЗадачи)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Операция = ОписаниеЗадачи.Операция;
		ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
		ТипОпераций = Перечисление_ТипыОпераций().ЗаказКодов;
		
		Если ОписаниеОперации.ДопРеквизиты.ЗаказатьКодыДляВложенныхТоваров Тогда
			Задача_ЗаказКодов_СформироватьЗаказыДляВложенныхКодов(ОписаниеОперации);
			НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьСтатусыПодчиненныхЗаказов;
			НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжидаетКодыВложенныхТоваров;
		Иначе
			НовоеДействие = Перечисление_ТребуемыеДействия().СоздатьВСервисеЗаказКодов;
			НовыйСтатусОперации = Перечисление_СтатусыОпераций().Новый;
		КонецЕсли;
		
		ОписаниеЗадачи.НовоеДействие = НовоеДействие;
		ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатусОперации;
		Задача_Записать(ОписаниеЗадачи);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура Задача_ЗаказКодов_СформироватьЗаказыДляВложенныхКодов(ОписаниеОперации)
	
	ОбщиеДанные = Новый_Операция();
	ОбщиеДанные.ОперацияОснование = ОписаниеОперации.Ссылка;
	ОбщиеДанные.ТипОперации       = ОписаниеОперации.ТипОперации;
	ОбщиеДанные.Организация       = ОписаниеОперации.Организация;
	ОбщиеДанные.Склад             = ОписаниеОперации.Склад;
	ОбщиеДанные.ВидПродукции      = ОписаниеОперации.ВидПродукции;
	ОбщиеДанные.ДокументУчета     = ОписаниеОперации.ДокументУчета;
	ЗаполнитьЗначенияСвойств(ОбщиеДанные.ДопРеквизиты, ОписаниеОперации.ДопРеквизиты);
	
	Для каждого СтрТовара Из ОписаниеОперации.Товары Цикл
		
		Товар = СтрТовара.ВложенныйТовар;
		КоличествоВложенныхУпаковок = СтрТовара.КоличествоУпаковокВложенногоТовара;
		
		Если Не ЗначениеЗаполнено(Товар)
			Или Не ЗначениеЗаполнено(КоличествоВложенныхУпаковок) Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеНовойОперации = СкопироватьОбъект(ОбщиеДанные);
		ОписаниеНовойОперации.ДопРеквизиты.ЗаказатьКодыДляВложенныхТоваров = Ложь;
		ОписаниеНовойОперации.ДопРеквизиты.ТипКодаМаркировки = Товар.ТипКодаМаркировки;
		ОписаниеНовойОперации.КлючСтрокиОперацииОснования = СтрТовара.КлючСтрокиОперации;
		
		Стр = ОписаниеНовойОперации.Товары.Добавить();
		Стр.НомерСтроки = СтрТовара.НомерСтроки;
		Стр.Товар = Товар;
		Стр.КоличествоУпаковок = КоличествоВложенныхУпаковок;
		Стр.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
		Стр.КлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
		
		Операция_Записать(ОписаниеНовойОперации);
		Задача_Создать(ОписаниеНовойОперации.Ссылка);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Задача_ЗаказКодов_СоздатьВСервисе(ОписаниеЗадачи)
	
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_ЗаказКодов(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_ЗаказКодов_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьФайлыДляПодписиЗаказа;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Если ОписаниеОперации.ДопРеквизиты.СпособВыпускаТоваров = Перечисление_СпособыВыпускаТоваров().Перемаркировка Тогда
		Метрика_Функциональность_ЗаказДляПеремаркировки(Организация);
	КонецЕсли;
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_ЗаказКодов_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_ЗаказКодов_ФайлыДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	Файл_УдалитьКонтентДляПодписи(Операция);
	Для Каждого Элемент Из Ответ.Результат Цикл
		Файл_СохранитьКонтентДляПодписи(Операция, Элемент.content, Элемент.id);
	КонецЦикла;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ЗаказКодов_ОтправитьПодпись(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	МассивФайлов = Файл_НайтиФайлыПодписей(Операция);
	
	ПодписанныеФайлы = Новый Массив;
	Для Каждого Файл Из МассивФайлов Цикл
		ОписаниеФайла = Файл_Прочитать(Файл);
		Элемент = Новый Структура;
		Элемент.Вставить("id", ОписаниеФайла.Идентификатор);
		Элемент.Вставить("content", ОписаниеФайла.ДанныеФайла);
		ПодписанныеФайлы.Добавить(Элемент);
	КонецЦикла;
	
	Попытка
		Ответ = Маркировка_ЗаказКодов_ОтправитьВГИС(ОписаниеЗадачи, ПодписанныеФайлы);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьКодов;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ЗаказВОбработке;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(МассивФайлов);
	
КонецПроцедуры

Процедура Задача_ЗаказКодов_СоздатьЗадачуНаПолучениеКодов(ОписаниеЗадачи)
	
	ПроверитьПовторно = Ложь;
	
	Попытка
		Маркировка_ПолучениеКодов_СоздатьЗадачу(ОписаниеЗадачи, ПроверитьПовторно);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	
	Если ПроверитьПовторно Тогда
		ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьКодов;
	Иначе
		ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьНовыеКодыИзСервиса;
	КонецЕсли;
	
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ЗаказКодов_ПолучитьКодыИзСервиса(ОписаниеЗадачи)
	
	СтатусЗадачи = Задача_ПолучениеКодов_ПроверитьСтатус(ОписаниеЗадачи);
	СтатусыЗадачи = Перечисление_СтатусыПолученияКодов();
	СпособыВыпуска = Перечисление_СпособыВыпускаТоваров();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТипыУпаковок = Перечисления.КонтурМаркировка_ТипыУпаковок;
	ТипыШтрихкодов = Перечисления.КонтурМаркировка_ТипыШтрихкодов;
	
	Если СтатусЗадачи = СтатусыЗадачи.Невыполнена Тогда
		Возврат;
	КонецЕсли;
	Если СтатусЗадачи = СтатусыЗадачи.НедостаточноСредств Тогда
		ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьКодов;
		ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().НедостаточноСредств;
		ОписаниеЗадачи.ОписаниеОшибки = НСтр("ru = 'Недостаточно средств для заказа кодов'");
		Задача_Записать(ОписаниеЗадачи);
		Возврат;
	КонецЕсли;
	
	Операция = ОписаниеЗадачи.Операция;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	Организация = ОписаниеОперации.Организация;
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ИдентификаторДокумента = ОписаниеЗадачи.ИдентификаторДокумента;
	СпособВыпускаТоваров = ОписаниеОперации.ДопРеквизиты.СпособВыпускаТоваров;
	ТипКодаМаркировки = ОписаниеОперации.ДопРеквизиты.ТипКодаМаркировки;
	КодыДляДокумента = ЗначениеЗаполнено(ДокументУчета);
	КодыДляПеремаркировки = (СпособВыпускаТоваров = СпособыВыпуска.Перемаркировка);
	ОбщийТипУпаковки = ОбщийТипУпаковкиПоТипуКодаМаркировки(ТипКодаМаркировки);
	
	ПредыдущийКод = "";
	ТаблицаКодов = Новый_ТаблицаКодов();
	Пока Истина Цикл
		
		Попытка
			Ответ = Маркировка_ПолучениеКодов_ПолучитьКоды(ОписаниеЗадачи, ПредыдущийКод);
		Исключение
			Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
			Возврат;
		КонецПопытки;
		
		Если Не ЗначениеЗаполнено(Ответ)
			Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
			Возврат;
		КонецЕсли;
		
		МассивКодов = Ответ.Результат;
		Если Не ЗначениеЗаполнено(МассивКодов) Тогда
			Прервать;
		КонецЕсли;
		
		Для Каждого code Из МассивКодов Цикл
			Стр = ТаблицаКодов.Добавить();
			Стр.ПолныйКод = code.value;
			Стр.КодМаркировки = code.value;
			Стр.ВидПродукции = ВидПродукции;
			Стр.ЗаказКодов = Операция;
			Стр.GTIN = code.gtin;
			Стр.ОбщийТипУпаковки = ОбщийТипУпаковки;
			Стр.ТипУпаковки = ТипыУпаковок.МаркированныйТовар;
			Стр.ТипШтрихкода = ТипыШтрихкодов.GS1_DataMatrix;
			Стр.ДляНанесения = Истина;
			Стр.СпособВыпускаТоваров = СпособВыпускаТоваров;
		КонецЦикла;
		
		ПредыдущийКод = МассивКодов[МассивКодов.ВГраница()].value;
		
	КонецЦикла;
	
	Если Не ТаблицаКодов_НормализоватьКодыЗаказа(ТаблицаКодов)
		И Не ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация) Тогда
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, НСтр("ru = 'Не удалось нормализовать коды заказа'"));
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов_РаспределитьКлючиСтрокОперацииЗаказа(ТаблицаКодов, ОписаниеОперации.Товары);
	
	Если КодыДляДокумента Или КодыДляПеремаркировки Тогда
		Если КодыДляДокумента Тогда
			ТаблицаКодов_ЗаполнитьПоДокументуКлючиНоменклатуры1С(ТаблицаКодов, ДокументУчета);
		КонецЕсли;
		ТаблицаКодов_ОбновитьСтатусПоПервомуКоду(ТаблицаКодов, Организация);
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
	КонецЕсли;
	
	Если КодыДляДокумента Тогда
		КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, Ложь);
		ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета);
	ИначеЕсли КодыДляПеремаркировки Тогда
		КодыОпераций_Записать(ТаблицаКодов, Операция);
	Иначе
		КодыЗаказов_Записать(ТаблицаКодов, Операция);
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ПолучитьФайлыДляПодписиЗакрытияЗаказа;
	ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ЗакрытиеЗаказа;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ЗаказКодов_ПолучитьКонтентЗакрытияДляПодписи(ОписаниеЗадачи)
	
	СтатусыЗакрытия = Перечисление_СтатусыЗакрытияЗаказаКодов();
	
	СтатусЗакрытия = Задача_ЗаказКодов_СтатусЗакрытияЗаказа(ОписаниеЗадачи);
	Если СтатусЗакрытия = СтатусыЗакрытия.Неизвестен Тогда
		Возврат;
	КонецЕсли;
	Если СтатусЗакрытия = СтатусыЗакрытия.Закрыт Тогда
		Задача_Завершить(ОписаниеЗадачи);
		Возврат;
	КонецЕсли;
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_ЗаказКодов_ФайлыДляПодписиЗакрытия(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	Файл_УдалитьКонтентДляПодписи(Операция);
	
	Если Не ЗначениеЗаполнено(Ответ.Результат) Тогда // Заказ уже закрыт
		Задача_Завершить(ОписаниеЗадачи);
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из Ответ.Результат.contents Цикл
		Файл_СохранитьКонтентДляПодписи(Операция, Элемент.content, Элемент.id);
	КонецЦикла;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайлЗакрытияЗаказа;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписатьЗакрытиеЗаказа;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ЗаказКодов_ОтправитьПодписьЗакрытиеЗаказа(ОписаниеЗадачи)
	
	СтатусыЗакрытия = Перечисление_СтатусыЗакрытияЗаказаКодов();
	
	СтатусЗакрытия = Задача_ЗаказКодов_СтатусЗакрытияЗаказа(ОписаниеЗадачи);
	Если СтатусЗакрытия = СтатусыЗакрытия.Неизвестен Тогда
		Возврат;
	КонецЕсли;
	
	ФайлыПодписей = Файл_НайтиФайлыПодписей(ОписаниеЗадачи.Операция);
	
	Если СтатусЗакрытия = СтатусыЗакрытия.Открыт Тогда
		
		ПодписанныеФайлы = Новый Массив;
		Для Каждого Файл Из ФайлыПодписей Цикл
			ОписаниеФайла = Файл_Прочитать(Файл);
			Элемент = Новый Структура;
			Элемент.Вставить("id", ОписаниеФайла.Идентификатор);
			Элемент.Вставить("content", ОписаниеФайла.ДанныеФайла);
			ПодписанныеФайлы.Добавить(Элемент);
		КонецЦикла;
		
		Попытка
			Ответ = Маркировка_ЗаказКодов_ЗакрытьЗаказ(ОписаниеЗадачи, ПодписанныеФайлы);
		Исключение
			Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		КонецПопытки;
		
		Если Не ЗначениеЗаполнено(Ответ)
			Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Файлы_Удалить(ФайлыПодписей);
	Задача_Завершить(ОписаниеЗадачи);
	
КонецПроцедуры

Функция Задача_ЗаказКодов_СтатусЗакрытияЗаказа(ОписаниеЗадачи)
	
	СтатусыЗакрытия = Перечисление_СтатусыЗакрытияЗаказаКодов();
	
	Попытка
		Ответ = Маркировка_ЗаказКодов_СтатусЗакрытия(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат СтатусыЗакрытия.Неизвестен;
	КонецЕсли;
	
	СтатусЗаказа = Ответ.Результат.closingState;
	Если НРег(СтатусЗаказа) <> НРег("Open") Тогда
		Возврат СтатусыЗакрытия.Закрыт;
	КонецЕсли;
	
	Возврат СтатусыЗакрытия.Открыт;
	
КонецФункции

Процедура Задача_ЗаказКодов_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = Неопределено;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CodesOrderSent") Тогда
		
		НовыйСтатус = СтатусыОпераций.ЗаказВОбработке;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьКодов;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CodesOrderReleased") Тогда
		
		НовыйСтатус = СтатусыОпераций.ПолучениеКодов;
		НовоеДействие = ТребуемыеДействия.СоздатьЗадачуНаПолучениеКодов;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CodesOrderReceived") Тогда
		
		ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
		Если ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.СервисПровайдер) Тогда
			// Это временное исправление, коды на самом деле переданы сервис-провайдеру
			НовыйСтатус = СтатусыОпераций.ОперацияЗавершена;
			НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		Иначе
			НовыйСтатус = СтатусыОпераций.ПолучениеКодов;
			НовоеДействие = ТребуемыеДействия.ПолучитьНовыеКодыИзСервиса;
		КонецЕсли;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("SentServiceProvider")
		Или НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОперацияЗавершена;
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("PartialSentServiceProvider") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОперацияЗавершена;
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Failed")
		Или НРег(СтатусДокумента) = НРег("CodesOrderPartiallyFailed") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус заказа кодов: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Функция Задача_ПолучениеКодов_ПроверитьСтатус(ОписаниеЗадачи)
	
	СтатусыЗадачи = Перечисление_СтатусыПолученияКодов();
	
	Попытка
		Ответ = Маркировка_ПолучениеКодов_СтатусЗадачи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат СтатусыЗадачи.Невыполнена;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	Если ОписаниеСтатуса.hasResult <> Истина Тогда
		Возврат СтатусыЗадачи.Невыполнена;// Коды еще не готовы
	КонецЕсли;
	
	Если Задача_ЗаказКодов_ТребуетсяОплатаВСервисе(ОписаниеСтатуса) Тогда
		Возврат СтатусыЗадачи.НедостаточноСредств;
	КонецЕсли;
	
	Возврат СтатусыЗадачи.Выполнена;
	
КонецФункции

Функция Задача_ЗаказКодов_ТребуетсяОплатаВСервисе(ОписаниеСтатуса)
	
	ТребуетсяОплатаВСервисе = Ложь;
	
	МассивОшибок = Неопределено;
	
	Если ОписаниеСтатуса.result.Свойство("errors", МассивОшибок) Тогда
		
		Для Каждого ОшибкаЗадачи Из МассивОшибок Цикл
			
			Если НРег(ОшибкаЗадачи.code) = "paymentrequired" Тогда
				
				ТребуетсяОплатаВСервисе = Истина;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТребуетсяОплатаВСервисе;
	
КонецФункции

Процедура Задача_ЗаказКодов_ПроверитьСтатусыПодчиненныхЗаказов(ОписаниеЗадачи)
	
	ЗаказКодов = Перечисление_ТипыОпераций().ЗаказКодов;
	
	ВсеЗадачиЗавершены = Задача_ВсеПодчиненныеОперацииЗавершены(ОписаниеЗадачи.Операция, ЗаказКодов);
	Если Не ВсеЗадачиЗавершены Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОшибкиВПодчиненных = Задача_ЕстьОшибкиВПодчиненныхОперациях(ОписаниеЗадачи.Операция, ЗаказКодов);
	
	Если ЕстьОшибкиВПодчиненных Тогда
		ВсеОшибки = Задача_ОшибкиВПодчиненныхОперациях(ОписаниеЗадачи.Операция, ЗаказКодов);
		ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ИсправитьОшибку;
		ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОшибкаОбработки;
		ОписаниеЗадачи.ОписаниеОшибки = СоединитьСтроку(ВсеОшибки, Символы.ПС);
	Иначе
		ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().СоздатьВСервисеЗаказКодов;
		ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	КонецЕсли;
	
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

// #КонецОбласти // ЗаказКодов

// #Область ПодборКодовНаТСД

Функция ОчередьОбмена_ПодборКодовНаТСД_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеПодборКодовНаТСД);
	Результат.Добавить(ТребуемыеДействия.ПроверитьГотовностьПодбораКодов);
	Результат.Добавить(ТребуемыеДействия.ПолучитьРезультатПодбораКодов);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_ПодборКодовНаТСД_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьВСервисеПодборКодовНаТСД Тогда
		Задача_ПодборКодовНаТСД_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьГотовностьПодбораКодов Тогда
		Задача_ПодборКодовНаТСД_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьРезультатПодбораКодов Тогда
		Задача_ПодборКодовНаТСД_ПолучитьРезультат(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ПодборКодовНаТСД_СоздатьВСервисе(ОписаниеЗадачи)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_ПодборКодовНаТСД(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_НаполнениеДокумента_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьПодбораКодов;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_ПодборКодовНаТСД_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created")
		Или НРег(СтатусДокумента) = НРег("Processed")Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьПодбораКодов;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Enriched")
		Или НРег(СтатусДокумента) = НРег("Completed")Тогда
		
		НовыйСтатус = СтатусыОпераций.НаполненНаТСД;
		НовоеДействие = ТребуемыеДействия.ПолучитьРезультатПодбораКодов;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Failed") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус наполнения документа: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ПодборКодовНаТСД_ПолучитьРезультат(ОписаниеЗадачи, ПовторноеПолучение = Ложь) Экспорт
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	
	Попытка
		Ответ = Маркировка_НаполнениеДокумента_Результат(ОписаниеЗадачи);
	Исключение
		Если ПовторноеПолучение Тогда
			ВызватьИсключение;
		КонецЕсли;
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	Контент = Ответ.Результат;
	ТаблицаКодов = Задача_ПодборКодовНаТСД_ТаблицаКодов(Операция, Контент.positions);
	
	Если ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация, Ложь) Тогда
		ТаблицаКодов_ДополнитьИнформациейИБ(ТаблицаКодов);
		Задача_ПодборКодовНаТСД_ЗавершитьПолучениеКодов(ОписаниеЗадачи, ТаблицаКодов);
	Иначе
		Задача_ЗаписатьКодыВРедакторДляРаспознавания(ОписаниеЗадачи, ТаблицаКодов);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ПодборКодовНаТСД_ЗавершитьПолучениеКодов(ОписаниеЗадачи, ТаблицаКодов)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	Операция = ОписаниеЗадачи.Операция;
	Реквизиты = ЗначенияРеквизитовОбъекта_Марк(Операция, "ТипОперации, ДокументУчета");
	ТипОперации = Реквизиты.ТипОперации;
	ДокументУчета = Реквизиты.ДокументУчета;
	Организация = ОписаниеЗадачи.Организация;
	
	ТаблицаКодовДокумента = КодыДокументов_Прочитать(ДокументУчета);
	ЗаполнитьТоварыДокумента = (ТипОперации = ТипыОпераций.ПодборТоваровИКодовНаТСД);
	ЗаполнитьТоварыАгрегатов = НастройкиМодуля().ЗаполнятьТоварыАгрегатов;
	
	// Удаляем старые коды из документа по строкам, которые есть в наполнении
	Отбор = Новый Структура("КлючСтрокиДокумента");
	Индекс = ТаблицаКодовДокумента.Индексы.Добавить("КлючСтрокиДокумента");
	КлючиСтрокДокумента = ТаблицаКодов.ВыгрузитьКолонку("КлючСтрокиДокумента");
	СвернутьМассив_Марк(КлючиСтрокДокумента, Истина);
	Для Каждого КлючСтрокиДокумента Из КлючиСтрокДокумента Цикл
		Отбор.КлючСтрокиДокумента = КлючСтрокиДокумента;
		Для Каждого Стр Из ТаблицаКодовДокумента.НайтиСтроки(Отбор) Цикл
			ТаблицаКодовДокумента.Удалить(Стр);
		КонецЦикла;
	КонецЦикла;
	ТаблицаКодовДокумента.Индексы.Удалить(Индекс);
	
	ТаблицаКодов_ЗаполнитьПоДокументуКлючиНоменклатуры1С(ТаблицаКодов, ДокументУчета);
	ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
	ТаблицаЗначений_Дополнить(ТаблицаКодовДокумента, ТаблицаКодов);
	
	Если ЗаполнитьТоварыАгрегатов Тогда
		ТоварыАгрегатов_ЗаполнитьИзГИСМТ(ТаблицаКодов, Организация);
	КонецЕсли;
	
	Если ЗаполнитьТоварыДокумента Тогда
		ОписаниеДокумента = ДокументУчета_ПрочитатьДокумент(ДокументУчета);
		ДокументУчета_ЗаполнитьТоварыМаркировкиИзТаблицыКодов(ОписаниеДокумента, ТаблицаКодовДокумента);
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыОпераций_Записать(ТаблицаКодов, Операция);
		КодыДокументов_Записать(ТаблицаКодовДокумента, ДокументУчета);
		
		Если ЗаполнитьТоварыДокумента Тогда
			ДокументУчета_Записать(ОписаниеДокумента);
		КонецЕсли;
		
		ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета);
		
		Задача_Завершить(ОписаниеЗадачи);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура Задача_ВозвратКодовНаТСД_СоздатьВСервисе(ОписаниеЗадачи, Комментарий)
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если ОписаниеЗадачи.ТребуемоеДействие <> ТребуемыеДействия.ОперацияЗавершена
		И ОписаниеЗадачи.ТребуемоеДействие <> ТребуемыеДействия.РаспознатьКоды Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = ОписаниеЗадачи.ИдентификаторДокумента;
	Если Не ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Организация = ОписаниеЗадачи.Организация;
