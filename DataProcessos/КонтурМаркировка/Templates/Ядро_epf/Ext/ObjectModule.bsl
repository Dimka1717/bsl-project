// #Область УведомленияОПриемке

Функция ОчередьОбмена_УведомлениеОПриемке_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.ОбновитьУведомлениеОПриемке);
	Результат.Добавить(ТребуемыеДействия.ПолучитьКонтентДляПодписиУведомленияОПриемке);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьСтатусУведомленияОПриемке);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_УведомлениеОПриемке_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.ОбновитьУведомлениеОПриемке Тогда
		Задача_УведомлениеОПриемке_ОбновитьДокумент(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьКонтентДляПодписиУведомленияОПриемке Тогда
		Задача_УведомлениеОПриемке_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_УведомлениеОПриемке_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьСтатусУведомленияОПриемке Тогда
		Задача_УведомлениеОПриемке_ПроверитьСтатус(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

// Обновляет данные документа в сервисе
//
// Параметры:
//  ОписаниеЗадачи - Структура - см. функцию Новый_ЗадачаОбмена();
//
Процедура Задача_УведомлениеОПриемке_ОбновитьДокумент(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	ИдентификаторДокумента = ОписаниеОперации.ДопРеквизиты.ИдентификаторДокумента;
	Контент = Контент_УведомлениеОПриемке_ОбновлениеДокумента(Операция);
	
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	
	Попытка
		Ответ = Маркировка_УведомлениеОПриемке_ОбновитьДокумент(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьКонтентДляПодписиУведомленияОПриемке;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ГотовКОтправкеВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_УведомлениеОПриемке(Организация, ОписаниеОперации);
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

// Получает из сервиса контент уведомления о приемке для подписи
// и сохраняет его в файл
//
// Параметры:
//  ОписаниеЗадачи - Структура - см. функцию Новый_ЗадачаОбмена();
//
Процедура Задача_УведомлениеОПриемке_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_УведомлениеОПриемке_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.id;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

// Отправляет подписанный файл уведомления о приемке в ГИС.
// После успешной отправки, подписанный файл удаляется.
//
// Параметры:
//  ОписаниеЗадачи - Структура - см. функцию Новый_ЗадачаОбмена();
//
Процедура Задача_УведомлениеОПриемке_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_УведомлениеОПриемке_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОперацияЗавершена;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьСтатусУведомленияОПриемке;
	Задача_Записать(ОписаниеЗадачи);
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

// Проверяет статус уведомления о приемке в ГИС.
// После успешной отправки, подписанный файл удаляется.
//
// Параметры:
//  ОписаниеЗадачи - Структура - см. функцию Новый_ЗадачаОбмена();
//
Процедура Задача_УведомлениеОПриемке_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_УведомлениеОПриемке_КонтентДокумента(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	Контент = Ответ.Результат;
	СтатусДокумента = СтатусУведомленияОПриемкеПоСтатусуИзСервиса(Контент.documentStatus);
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	НовыйСтатус = СтатусДокумента;
	Если СтатусДокумента = СтатусыОпераций.ОтправленВАрхив
		Или СтатусДокумента = СтатусыОпераций.ПолученУспешныйОтветОтГИС
		Или СтатусДокумента = СтатусыОпераций.ОтГИСПолученоСообщениеОбОшибке
		Или СтатусДокумента = СтатусыОпераций.ВПриемкеОтказано Тогда
		
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		
	ИначеЕсли СтатусДокумента = СтатусыОпераций.ГотовКОтправкеВГИС Тогда
		
		НовоеДействие = ТребуемыеДействия.ПолучитьКонтентДляПодписиУведомленияОПриемке;
		
	ИначеЕсли СтатусДокумента = СтатусыОпераций.ОтправкаЗапросаСФайломВГИС
		Или СтатусДокумента = СтатусыОпераций.ОшибкаОтправкиЗапросаСФайломВГИС
		Или СтатусДокумента = СтатусыОпераций.ЗапросСФайломОтправленВГИС Тогда
		
		НовоеДействие = ТребуемыеДействия.ПроверитьСтатусУведомленияОПриемке;
		
	ИначеЕсли СтатусДокумента = СтатусыОпераций.ДокументОПриемкеОжидаетПодтверждения Тогда
		
		НовоеДействие = ТребуемыеДействия.ОбновитьУведомлениеОПриемке;
		
		
	Иначе
		
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

// #КонецОбласти // УведомленияОПриемке

// #Область ВозвратВОборот

Функция ОчередьОбмена_ВозвратВОборот_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеВозвратВОборот);
	Результат.Добавить(ТребуемыеДействия.ПолучитьКонтентДляПодписиВозвратаВОборот);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьСтатусВозвратаВОборот);
	Результат.Добавить(ТребуемыеДействия.ОбновитьСтатусыКодовПослеВозвратаВОборот);
	
	Возврат Результат;
	
КонецФункции

Функция ОчередьОбмена_ВозвратВОборотНаТСД_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеВозвратВОборотНаТСД);
	Результат.Добавить(ТребуемыеДействия.ПроверитьСтатусВозвратаВОборот);
	Результат.Добавить(ТребуемыеДействия.ПолучитьКонтентДляПодписиВозвратаВОборот);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьСтатусВозвратаВОборот);
	Результат.Добавить(ТребуемыеДействия.ОбновитьСтатусыКодовПослеВозвратаВОборот);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_ВозвратВОборот_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьВСервисеВозвратВОборотНаТСД Тогда
		Задача_ВозвратВОборотНаТСД_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьВСервисеВозвратВОборот Тогда
		Задача_ВозвратВОборот_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьКонтентДляПодписиВозвратаВОборот Тогда
		Задача_ВозвратВОборот_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_ВозвратВОборот_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьСтатусВозвратаВОборот Тогда
		Задача_ВозвратВОборот_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОбновитьСтатусыКодовПослеВозвратаВОборот Тогда
		Задача_ОбновитьСтатусыКодовЗавершитьОперацию(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ВозвратВОборотНаТСД_СоздатьВСервисе(ОписаниеЗадачи)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_ВозвратВОборотНаТСД(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_ВозвратВОборот_СоздатьЧерновик(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьСтатусВозвратаВОборот;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленНаТСД;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_ВозвратВОборот(ОписаниеОперации);
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_ВозвратВОборот_СоздатьВСервисе(ОписаниеЗадачи)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_ВозвратВОборот(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_ВозвратВОборот_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьКонтентДляПодписиВозвратаВОборот;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ГотовКОтправкеВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_ВозвратВОборот(ОписаниеОперации);
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_ВозвратВОборот_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_ВозвратВОборот_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.id;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ВозвратВОборот_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_ВозвратВОборот_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьСтатусВозвратаВОборот;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_ВозвратВОборот_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовоеДействие = Неопределено;
		НовыйСтатус = СтатусыОпераций.СозданВСервисе;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		НовыйСтатус = СтатусыОпераций.ОтправленВАрхив;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ReadyForSend") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПолучитьКонтентДляПодписиВозвратаВОборот;
		НовыйСтатус = СтатусыОпераций.ГотовКОтправкеВГИС;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Processing")
		Или НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПроверитьСтатусВозвратаВОборот;
		НовыйСтатус = СтатусыОпераций.ОбрабатываетсяВГИС;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedSuccess") Тогда
		
		НовоеДействие = ТребуемыеДействия.ОбновитьСтатусыКодовПослеВозвратаВОборот;
		НовыйСтатус = СтатусыОпераций.ОбновлениеСтатусовКодов;
		
	ИначеЕсли Задача_ВозвратВОборот_СтатусОшибка(СтатусДокумента) Тогда
		
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("TsdProcessStart") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПроверитьСтатусВозвратаВОборот;
		НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Sending")
		Или НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПроверитьСтатусВозвратаВОборот;
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус возврата в оборот: %1'"), СтатусДокумента);
		
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Функция Задача_ВозвратВОборот_СтатусОшибка(Статус)
	
	СтатусыОшибки = Новый Соответствие;
	СтатусыОшибки.Вставить(НРег("ProcessedError"), Истина);
	СтатусыОшибки.Вставить(НРег("CrptProcessedError"), Истина);
	СтатусыОшибки.Вставить(НРег("SendingError"), Истина);
	СтатусыОшибки.Вставить(НРег("CrptSendingError"), Истина);
	
	Возврат (СтатусыОшибки[НРег(Статус)] = Истина);
	
КонецФункции

