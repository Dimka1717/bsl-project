Функция ДобавитьЗаводскойСерийныйНомерВПолныйКод(Знач ПолныйКод, ЗСН)
	
	СтрокаЗСН = Base64ИзСтроки(ЗСН);
	РазделительGS = РазделительGS1();
	
	Разделитель = "";
	Если Найти(ПолныйКод, РазделительGS) > 0 Тогда
		Разделитель = РазделительGS;
	КонецЕсли;
	
	Идентификатор = Разделитель + ИдентификаторПрименения_ЗСН();
	ДлинаПоказателя = СтрДлина(СтрокаЗСН);
	ДлинаИдентификатора = СтрДлина(Идентификатор);
	ИдентификаторСПоказателем = Прав(ПолныйКод, ДлинаИдентификатора + ДлинаПоказателя);
	
	Если Лев(ИдентификаторСПоказателем, ДлинаИдентификатора) = Идентификатор Тогда
		Возврат ПолныйКод; // Код уже содержит ЗСН
	КонецЕсли;
	
	Возврат ПолныйКод + Идентификатор + СтрокаЗСН;
	
КонецФункции

// Возвращает представление строки табличной части с лидирующими нулями в зависимости от количества строк
//
