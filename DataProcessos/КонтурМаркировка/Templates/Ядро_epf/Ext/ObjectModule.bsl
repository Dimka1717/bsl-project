// Возвращает рабочее представление номенклатуры 1С
//
// Параметры:
//  АналитикаНоменклатуры - Структура - см. Новый_АналитикаНоменклатуры1С();
//  КэшРезультатов - Соответствие - (необязательный) кэш результатов функции;
// 
// Возвращаемое значение:
//  Строка - рабочее представление номенклатуры
//
Функция ПредставлениеНоменклатуры1С(АналитикаНоменклатуры, КэшРезультатов = Неопределено) Экспорт
	
	Если КэшРезультатов <> Неопределено Тогда
		КлючКэш = СтрокаИдентификаторовАналитикиНоменклатуры1С(АналитикаНоменклатуры);
		Результат = КэшРезультатов[КлючКэш];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	НаименованиеНоменклатуры = СокрЛП(АналитикаНоменклатуры.Номенклатура);
	
	ТекстВСкобках = ПредставлениеНоменклатуры_ТекстВСкобках(
	АналитикаНоменклатуры.Характеристика
	, АналитикаНоменклатуры.Упаковка
	, АналитикаНоменклатуры.Серия);
	
	Если ЗначениеЗаполнено(ТекстВСкобках) Тогда
		Результат = ПараметрыВСтроку("%1 (%2)", НаименованиеНоменклатуры, ТекстВСкобках);
	Иначе
		Результат = НаименованиеНоменклатуры;
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(КлючКэш, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеНоменклатуры_ТекстВСкобках(Характеристика, Упаковка, Серия, ДляПечати = Ложь) Экспорт
	
	ТекстВСкобках = Новый Массив;
	
	Если ДляПечати Тогда
		НаименованиеХарактеристики = НаименованиеХарактеристики(Характеристика);
	Иначе
		НаименованиеХарактеристики = СокрЛП(Характеристика);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НаименованиеХарактеристики) Тогда
		ТекстВСкобках.Добавить(НаименованиеХарактеристики);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Упаковка) Тогда
		ТекстВСкобках.Добавить(СокрЛП(Упаковка));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Серия) Тогда
		ТекстВСкобках.Добавить(СокрЛП(Серия));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстВСкобках) Тогда
		Результат = СоединитьСтроку(ТекстВСкобках, ", ");
	Иначе
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Формирует текст с первыми пятью кодами маркировки через запятую,
// если кодов больше, например 8, то добавляет текст "и еще 3"
//
// Параметры:
//  КодыМаркировки - Массив, ТаблицаЗначений - таблица содержит колонку КодМаркировки
// 
// Возвращаемое значение:
//  Строка - текст со списком кодов
//
Функция СписокКодовДляТекстаОшибки(КодыМаркировки) Экспорт
	
	МаксимумКодовВСообщении = 5;
	МассивКодов = Новый Массив;
	ВсегоКодов = КодыМаркировки.Количество();
	
	Для Сч = 1 По Мин(ВсегоКодов, МаксимумКодовВСообщении) Цикл
		
		Элемент = КодыМаркировки[Сч - 1];
		
		Если ТипЗнч(Элемент) = Тип("Строка") Тогда
			КодМаркировки = Элемент;
		Иначе
			КодМаркировки = Элемент.КодМаркировки;
		КонецЕсли;
		
		МассивКодов.Добавить(УдалитьНедопустимыеСимволыXML(КодМаркировки));
		
	КонецЦикла;
	
	Результат = СоединитьСтроку(МассивКодов, ", ");
	
	Если ВсегоКодов > МаксимумКодовВСообщении Тогда
		ЕщеКодов = ВсегоКодов - МаксимумКодовВСообщении;
		СтрокаЕщеКодов = НСтр("ru = 'и еще %1'");
		Результат = Результат + " " + ПараметрыВСтроку(СтрокаЕщеКодов, ЕщеКодов);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

