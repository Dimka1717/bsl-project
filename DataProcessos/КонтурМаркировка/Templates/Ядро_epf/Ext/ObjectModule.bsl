Функция Интеграция_ПолноеИмяСправочникаВнешнейОбработки(Ссылка = Неопределено)
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Результат = Ссылка.Метаданные().ПолноеИмя();
	Иначе
		ТипыОбъектов = ТипыОбъектовИС();
		Если ЗначениеЗаполнено(ТипыОбъектов.ВнешняяОбработка) Тогда
			Результат = СтрЗаменить(ТипыОбъектов.ВнешняяОбработка, "СправочникСсылка", "Справочник");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Интеграция_ПодходящийОбъектМетаданных(ВариантыМетаданных)
	
	Для Каждого Вариант Из ЗначениеВМассиве(ВариантыМетаданных) Цикл
