Функция ОчередьОбмена_Агрегация_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.ПроверитьВозможностьРегистрацииВсехАгрегатов);
	Результат.Добавить(ТребуемыеДействия.СоздатьРегистрациюНаКаждыйАгрегат);
	Результат.Добавить(ТребуемыеДействия.ПроверитьВозможностьРегистрацииАгрегата);
	Результат.Добавить(ТребуемыеДействия.СоздатьАгрегатВСервисе);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлАгрегатаДляПодписи);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_Агрегация_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.ПроверитьВозможностьРегистрацииВсехАгрегатов Тогда
		Задача_Агрегация_ПроверитьВозможностьРегистрацииВсехАгрегатов(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьРегистрациюНаКаждыйАгрегат Тогда
		Задача_Агрегация_СоздатьРегистрациюНаКаждыйАгрегат(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьВозможностьРегистрацииАгрегата Тогда
		Задача_Агрегация_ПроверитьВозможностьРегистрацииАгрегата(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьАгрегатВСервисе Тогда
		Задача_Агрегация_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлАгрегатаДляПодписи Тогда
		Задача_Агрегация_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_Агрегация_ОтправитьПодпись(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_Агрегация_ПроверитьВозможностьРегистрацииВсехАгрегатов(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	ТаблицаКодов_ДобавитьКлючиТранспортныхУпаковокНижнегоУровня(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	Если ТаблицаКодов_ОбновитьСтатусы(ТаблицаКодов, Организация) Тогда
		ТаблицаКодов_ЗаписатьСтатусыКодов(ТаблицаКодов);
	Иначе
		Возврат;
	КонецЕсли;
	
	Разделитель = "";
	ОбщийТекстОшибки = "";
	Для каждого СтрокаАгрегата Из ТаблицаКодов Цикл
		ТекстОшибки = Задача_Агрегация_ПроверитьВозможностьРегистрацииСтрокиАгрегата(СтрокаАгрегата, Организация);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ОбщийТекстОшибки = ОбщийТекстОшибки + Разделитель + ТекстОшибки;
			Разделитель = Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ОбщийТекстОшибки) Тогда
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ОбщийТекстОшибки);
	Иначе
		Если Операция.ТипОперации = Перечисление_ТипыОпераций().НаполнениеАгрегатовНаТСД Тогда
			ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().СоздатьНаКаждыйАгрегатНаполнениеНаТСД;
		Иначе
			ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().СоздатьРегистрациюНаКаждыйАгрегат;
		КонецЕсли;
		Задача_Записать(ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_Агрегация_СоздатьРегистрациюНаКаждыйАгрегат(ОписаниеЗадачи)
	
	СтатусыКодов = Перечисление_СтатусыКодов();
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Операция = ОписаниеЗадачи.Операция;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	ТаблицаКодов_ПрочитатьСтатусыКодов(ТаблицаКодов);
	КодыМаркировки_Прочитать(ТаблицаКодов);
	ТаблицаКодов.Сортировать("КодМаркировки Убыв");
	
	Операции_Удалить(Операция_НайтиПодчиненныеОперации(Операция, ТипыОпераций.РегистрацияОдногоАгрегатаВГИС, Истина));
	
	ЕстьПодчиненныеОперации = Ложь;
	Для каждого Стр Из ТаблицаКодов Цикл
		Если Стр.Статус = СтатусыКодов.НеНайден Тогда
			Операция_СоздатьРегистрациюНаКаждыйАгрегат(ОписаниеОперации, Стр.КлючСтрокиОперации, Стр.КлючКода);
			ЕстьПодчиненныеОперации = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ОписаниеОперации.ТипОперации = ТипыОпераций.РегистрацияОдногоАгрегатаВГИС Тогда
		Если ЕстьПодчиненныеОперации Тогда
			ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ОжиданиеГотовности;
			ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОжиданиеГотовности;
		Иначе
			ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ПроверитьВозможностьРегистрацииАгрегата;
			ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ПроверкаВозможностиРегистрацииАгрегата;
		КонецЕсли;
	Иначе
		ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ОжиданиеГотовности;
		ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОжиданиеГотовности;
	КонецЕсли;
	
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_Агрегация_ПроверитьВозможностьРегистрацииАгрегата(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	ТаблицаКодов.Добавить().КлючКода = Операция_КлючКода(Операция);
	КодыМаркировки_Прочитать(ТаблицаКодов);
	
	Если Не ТаблицаКодов_ОбновитьСтатусы(ТаблицаКодов, Организация) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = Задача_Агрегация_ПроверитьВозможностьРегистрацииСтрокиАгрегата(ТаблицаКодов[0], Организация);
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ТекстОшибки);
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	Иначе
		Если Операция.ТипОперации = Перечисление_ТипыОпераций().НаполнениеОдногоАгрегатаНаТСД Тогда
			ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().СоздатьВСервисеНаполнениеАгрегатаНаТСД;
		Иначе
			ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().СоздатьАгрегатВСервисе;
		КонецЕсли;
		Задача_Записать(ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_Агрегация_СоздатьВСервисе(ОписаниеЗадачи)
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	ИдентификаторСклада = ОписаниеОперации.Склад.Идентификатор;
	Контент = Контент_Агрегация(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_Агрегация_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ПолучитьФайлАгрегатаДляПодписи;
	ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_Агрегация_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_Агрегация_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.id;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_Агрегация_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ДанныеФайла = Файл_Прочитать(ФайлПодписи).ДанныеФайла;
	
	Попытка
		Ответ = Маркировка_Агрегация_ОтправитьВГИС(ОписаниеЗадачи, ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьАгрегата;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_Агрегация_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	СтатусДокумента = Ответ.Результат.Статус;
	ТекстОшибки = Ответ.Результат.Комментарий;
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("TsdProcessStart") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ReturnedToTsd") Тогда
		
		НовыйСтатус = СтатусыОпераций.ВозвращенНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ReadyForSend") Тогда
		
		НовыйСтатус = СтатусыОпераций.НаполненНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОперацияЗавершена;
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSendingError")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedError") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус агрегации: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

Функция Задача_Агрегация_ПроверитьВозможностьРегистрацииСтрокиАгрегата(СтрокаАгрегата, Организация)
	
	СтатусыКодов = Перечисление_СтатусыКодов();
	
	Статус = СтрокаАгрегата.Статус;
	КодАгрегата = СтрокаАгрегата.КодМаркировки;
	ВладелецИНН = СтрокаАгрегата.ВладелецИНН;
	ВладелецНаименование = СтрокаАгрегата.ВладелецНаименование;
	ЕстьАгрегатВторогоУровня = ЗначениеЗаполнено(СтрокаАгрегата.КлючАгрегата);
	
	АгрегатЗарегистрирован = Ложь;
	НедопустимыйСтатусАгрегата = Ложь;
	АгрегатПринадлежитДругойОрганизации = Ложь;
	
	Если Статус = СтатусыКодов.НетДоступа Тогда
		АгрегатПринадлежитДругойОрганизации = Истина;
	ИначеЕсли Статус = СтатусыКодов.Списан
		Или Статус = СтатусыКодов.ВыбылИзОборота
		Или Статус = СтатусыКодов.Разагрегирован Тогда
		НедопустимыйСтатусАгрегата = Истина;
	Иначе
		Если Статус <> СтатусыКодов.НеНайден Тогда
			Если ВладелецИНН = Организация.ИНН Тогда
				АгрегатЗарегистрирован = Истина;
			Иначе
				АгрегатПринадлежитДругойОрганизации = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если АгрегатЗарегистрирован И Не ЕстьАгрегатВторогоУровня Тогда
		ШаблонОшибки = НСтр("ru = 'Код агрегата %1 уже зарегистрирован в ГИС МТ'");
		ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, КодАгрегата, ВладелецНаименование, ВладелецИНН);
	ИначеЕсли АгрегатПринадлежитДругойОрганизации Тогда
		ШаблонОшибки = НСтр("ru = 'Код агрегата %1 уже зарегистрирован в ГИС МТ организацией: %2, ИНН %3'");
		ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, КодАгрегата, ВладелецНаименование, ВладелецИНН);
	ИначеЕсли НедопустимыйСтатусАгрегата Тогда
		ШаблонОшибки = НСтр("ru = 'Код агрегата %1 уже зарегистрирован в ГИС МТ и имеет недопустимый статус: %2'");
		ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, КодАгрегата, Статус);
	Иначе
		ТекстОшибки = "";
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции

// #КонецОбласти // РегистрацияАгрегатов

// #Область РасформированиеАгрегатов

Функция ОчередьОбмена_Разагрегация_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьРасформированияАгрегатовВГИС);
	Результат.Добавить(ТребуемыеДействия.ПроверитьАгрегатДляРасформированияВГИС);
	Результат.Добавить(ТребуемыеДействия.СоздатьРасформированиеАгрегатаВСервисе);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлРасформированияАгрегатаДляПодписи);
	Результат.Добавить(ТребуемыеДействия.РасформироватьАгрегатПослеРегистрации);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_Разагрегация_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьРасформированияАгрегатовВГИС Тогда
		Задача_Разагрегация_СоздатьРасформированияАгрегатовВГИС(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьАгрегатДляРасформированияВГИС Тогда
		Задача_Разагрегация_ПроверитьВозможностьРасформированияВГИС(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьРасформированиеАгрегатаВСервисе Тогда
		Задача_Разагрегация_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлРасформированияАгрегатаДляПодписи Тогда
		Задача_Разагрегация_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_Разагрегация_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.РасформироватьАгрегатПослеРегистрации Тогда
		Задача_Разагрегация_РасформироватьАгрегатПослеРегистрации(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

// #Область ОбработкаВсехАгрегатов

Процедура Задача_Разагрегация_СоздатьРасформированияАгрегатовВГИС(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	
	ТипОпераций = Перечисление_ТипыОпераций().РасформированиеАгрегатаВГИС;
	СтарыеОперации = Операция_НайтиПодчиненныеОперации(Операция, ТипОпераций);
	Операции_Удалить(СтарыеОперации);
	
	Для каждого Стр Из ТаблицаКодов Цикл
		Операция_СоздатьРасформированиеАгрегатаВГИС(Операция, Стр.КлючСтрокиОперации, Стр.КлючКода);
	КонецЦикла;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ОжиданиеГотовности;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

// #КонецОбласти // ОбработкаВсехАгрегатов

// #Область ОбработкаКаждогоАгрегата

Процедура Задача_Разагрегация_ПроверитьВозможностьРасформированияВГИС(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	КлючАгрегата = Операция_КлючКода(Операция);
	КодАгрегата = КодМаркировки_НайтиПоКлючу(КлючАгрегата);
	
	Попытка
		Ответ = Маркировка_СтатусыКодов(КодАгрегата, Организация);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
		Возврат;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ) Тогда
		Возврат;
	КонецЕсли;
	
	Статус = СтатусКодаПоСтатусуИзСервиса(Ответ[0]);
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	СтатусыКодов = Перечисление_СтатусыКодов();
	
	Если Не ЗначениеЗаполнено(Статус)
		Или Статус = СтатусыКодов.НеНайден
		Или Статус = СтатусыКодов.Разагрегирован
		Или Статус = СтатусыКодов.ВыбылИзОборота
		Или Статус = СтатусыКодов.НетДоступа Тогда
		КодМаркировки_РасформироватьАгрегат(КлючАгрегата);
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		НовыйСтатусОперации = СтатусыОпераций.ОперацияЗавершена;
	Иначе
		НовоеДействие = ТребуемыеДействия.СоздатьРасформированиеАгрегатаВСервисе;
		НовыйСтатусОперации = "";
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатусОперации;
	Задача_Записать(ОписаниеЗадачи);
	
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_Разагрегация_СоздатьВСервисе(ОписаниеЗадачи)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	ИдентификаторСклада = ОписаниеОперации.Склад.Идентификатор;
	Контент = Контент_Разагрегация(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_Разагрегация_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьФайлРасформированияАгрегатаДляПодписи;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_Разагрегация_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_Разагрегация_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	Id = Ответ.Результат.documentId;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, Id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_Разагрегация_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_Разагрегация_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьРасформированияАгрегата;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_Разагрегация_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = Ответ.Результат.Комментарий;
	СтатусДокумента = Ответ.Результат.Статус;
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьРасформированияАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьРасформированияАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьРасформированияАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedSuccess") Тогда
		
		НовыйСтатус = СтатусыОпераций.ЗарегистрированВГИС;
		НовоеДействие = ТребуемыеДействия.РасформироватьАгрегатПослеРегистрации;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSendingError")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedError") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		
		ТекстОшибки = НСтр("ru = 'Неизвестный статус расформирования агрегата: %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_Разагрегация_РасформироватьАгрегатПослеРегистрации(ОписаниеЗадачи)
	
	КлючАгрегата = Операция_КлючКода(ОписаниеЗадачи.Операция);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		КодМаркировки_РасформироватьАгрегат(КлючАгрегата);
		Задача_Завершить(ОписаниеЗадачи);
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

