// Возвращает связи с товара с номенклатурой 1С
//
// Параметры:
//  Товар - СправочникСсылка.КонтурМаркировка_Товары - товар;
// 
// Возвращаемое значение:
//  ТаблицаЗначений - см. функцию Новый_ТаблицаНоменклатуры();
//
Функция СвязиНоменклатуры_Прочитать(Товар) Экспорт
	
	Результат = Новый_ТаблицаНоменклатуры();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Товар КАК Товар,
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СвязиНоменклатуры1С КАК Т
	|ГДЕ
	|	Т.Товар = &Товар");
	Запрос.УстановитьПараметр("Товар", Товар);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Стр = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Выборка);
		ЗаполнитьЗначенияСвойств(Стр, АналитикаНоменклатуры1С(Выборка.КлючНоменклатуры1С));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

