	Ответ_Мок = Мок_СтатусДокумента(ИдентификаторДокумента, Организация);
	Если Не Ответ_Мок = Неопределено Тогда
		Результат.Результат = Ответ_Мок;
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	Маркировка_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	Маркировка_ДобавитьТокен(Запрос, Организация);
	
	Запрос.ПутьНаСервере = "/api/v1/documents/{documentId}/history";
	Запрос.Параметры.Вставить("documentId", ИдентификаторДокумента);
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	ОбработатьОшибкуHTTP(Ответ, Запрос, Результат);
	
	Если Не Результат.Успешно Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИсторияСтатусов = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета);
	
	Комментарий = "";
	Статус = "";
	
	Если ЗначениеЗаполнено(ИсторияСтатусов) Тогда
		
		МассивСтруктур_Сортировать(ИсторияСтатусов, "timestamp");
		ПоследнийСтатус = ИсторияСтатусов[ИсторияСтатусов.ВГраница()];
		Статус = ПоследнийСтатус.newStatus;
		Комментарий = СвойствоСтруктуры(ПоследнийСтатус, "comment");
		Если ЗначениеЗаполнено(Комментарий) Тогда
			Комментарий = УдалитьНедопустимыеСимволыXML(Комментарий);
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеСтатуса = Новый Структура;
	ДанныеСтатуса.Вставить("Комментарий", Комментарий);
	ДанныеСтатуса.Вставить("Статус", Статус);
	
	Результат.Результат = ДанныеСтатуса;
	
	Возврат Результат;
	
