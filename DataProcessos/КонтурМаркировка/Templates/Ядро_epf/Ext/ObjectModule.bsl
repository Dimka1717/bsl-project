Функция Контент_ПодборКодовНаТСД(ОписаниеОперации)
	
	Операция = ОписаниеОперации.Ссылка;
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ИспользоватьМобУстройство = ДопРеквизиты.ПодборСПомощьюМобильногоУстройства;
	МобильноеУстройство = ДопРеквизиты.МобильноеУстройство;
	
	Результат = Новый Структура;
	Результат.Вставить("section", "Enrichment");
	Результат.Вставить("counteragentName", ДопРеквизиты.КонтрагентНаименование);
	Результат.Вставить("counteragentInn", ДопРеквизиты.КонтрагентИНН);
	Результат.Вставить("counteragentKpp", ДопРеквизиты.КонтрагентКПП);
	Результат.Вставить("documentNumber", ДопРеквизиты.НомерДокумента);
	Результат.Вставить("documentDate", ДопРеквизиты.ДатаДокумента);
	
	Результат.Вставить("checkCodesTtis", ОписаниеОперации.ДопРеквизиты.ПроверятьКодыПриСканировании);
	
	Если ИспользоватьМобУстройство И ЗначениеЗаполнено(МобильноеУстройство) Тогда
		Результат.Вставить("mobileTsd", МобильныеУстройства_МассивId(МобильноеУстройство));
		counteragentInfo = Новый Структура;
		ДобавитьЗаполненноеЗначениеВСтруктуру(counteragentInfo, "address", ДопРеквизиты.АдресДоставки);
		ДобавитьЗаполненноеЗначениеВСтруктуру(counteragentInfo, "phone", ДопРеквизиты.КонтактныйТелефон);
		Результат.Вставить("counteragentAdditionalInfo", counteragentInfo);
	КонецЕсли;
	
	ВзятьНаименованиеИзТовара = ОднаСтрокаДокументаСодержитНесколькоТоваровМаркировки(ОписаниеОперации.Товары);
	
	positions = Новый Массив;
	Для Каждого Стр ИЗ ОписаниеОперации.Товары Цикл
		
		position = Новый Структура;
		position.Вставить("number", Стр.НомерСтроки);
		position.Вставить("quantity", Стр.КоличествоУпаковок);
		position.Вставить("name", НаименованиеПозицииДляКонтента(Стр, ВзятьНаименованиеИзТовара));
		
		Если ЗначениеЗаполнено(Стр.Товар) Тогда
			position.Вставить("gtin", Стр.Товар.GTIN);
		КонецЕсли;
		
		positions.Добавить(position);
		
	КонецЦикла;
	
	Результат.Вставить("positions", positions);
	
	Возврат Результат;
	
КонецФункции

Функция Контент_ОтчетОНанесенииНаТСД(ОписаниеОперации)
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	
	Результат = Новый Структура;
	Результат.Вставить("section", "UtilisationReport");
	Результат.Вставить("documentNumber", ОписаниеОперации.Номер);
	Результат.Вставить("documentDate", ОписаниеОперации.Дата);
	
	positions = Новый Массив;
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		
		ДатаСрокаГодности = Стр.ДатаСрокаГодности;
		Наименование = НаименованиеПозицииДляКонтента(Стр);
		
		Если ЗначениеЗаполнено(Стр.Количество) Тогда
			СтрокаОбъем = ПараметрыВСтроку(НСтр("ru = 'объем %1'"), Стр.Количество);
			Наименование = Наименование + ", " + СтрокаОбъем;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДатаСрокаГодности) Тогда
			СтрокаГоденДо = ПараметрыВСтроку(НСтр("ru = 'годен до %1'"), Формат(ДатаСрокаГодности, "ДФ=dd.MM.yyyy"));
			Наименование = Наименование + ", " + СтрокаГоденДо;
		КонецЕсли;
		
		position = Новый Структура;
		position.Вставить("name"	, Наименование);
		position.Вставить("number"	, Стр.НомерСтроки);
		position.Вставить("quantity", Стр.КоличествоУпаковок);
		position.Вставить("gtin"	, Стр.Товар.GTIN);
		positions.Добавить(position);
		
	КонецЦикла;
	
	Результат.Вставить("positions", positions);
	
	Возврат Результат;
	
КонецФункции

Функция Контент_ОтчетОНанесении(ОписаниеОперации)
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	
	Операция = ОписаниеОперации.Ссылка;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	ОписаниеОснования = Операция_ПрочитатьОперацию(ОперацияОснование);
	КлючСтрокиОперации = ОписаниеОперации.КлючСтрокиОперацииОснования;
	ДопРеквизиты = ОписаниеОснования.ДопРеквизиты;
	
	Организация = ОписаниеОснования.Организация;
	ВидПродукции = ОписаниеОснования.ВидПродукции;
	ТипИспользования = ДопРеквизиты.ТипИспользования;
	НоминальныйОбъемВКегах = ДопРеквизиты.НоминальныйОбъемВКегах;
	Площадка = ДопРеквизиты.Площадка;
	НомерДокумента = ЗначениеРеквизитаОбъекта_Марк(ОписаниеОперации.ОперацияОснование, "Код");
	
	Стр = ОписаниеОснования.Товары.Найти(КлючСтрокиОперации, "КлючСтрокиОперации");
	ОписаниеТовара = Товар_Прочитать(Стр.Товар);
	ТипКодаМаркировки = ОписаниеТовара.ТипКодаМаркировки;
	НоминальныйОбъем = ОписаниеТовара.ДопРеквизиты.НоминальныйОбъем;
	ЭтоКег = ОписаниеТовара.ДопРеквизиты.ЭтоКег;
	ТребуетсяЗСН = ОписаниеТовара.ДопРеквизиты.ИспользоватьЗаводскойСН;
	ПеременныйВес = ОписаниеТовара.ПеременныйВес;
	ДатаСрокаГодности = Стр.ДатаСрокаГодности;
	
	НомерПервичногоДокумента = ДопРеквизиты.НомерДокумента;
	Если ЗначениеЗаполнено(Стр.НомерДокумента) Тогда
		НомерПервичногоДокумента = Стр.НомерДокумента;
	КонецЕсли;
	
	ДатаПервичногоДокумента = ДопРеквизиты.ДатаДокумента;
	Если ЗначениеЗаполнено(Стр.ДатаДокумента) Тогда
		ДатаПервичногоДокумента = Стр.ДатаДокумента;
	КонецЕсли;
	
	ДатаПроизводства = ДопРеквизиты.ДатаПроизводства;
	Если ЗначениеЗаполнено(Стр.ДатаПроизводства) Тогда
		ДатаПроизводства = Стр.ДатаПроизводства;
	КонецЕсли;
	
	НомерПартии = ДопРеквизиты.НомерПартии;
	Если ЗначениеЗаполнено(Стр.НомерПартии) Тогда
		НомерПартии = Стр.НомерПартии;
	КонецЕсли;
	
	НомерСерии = ДопРеквизиты.НомерСерии;
	Если ЗначениеЗаполнено(Стр.НомерСерии) Тогда
		НомерСерии = Стр.НомерСерии;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("usageType", ТипИспользованияВСервисе(ТипИспользования));
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ВидПродукции));
	Результат.Вставить("positionName", НаименованиеПозицииДляКонтента(Стр));
	
	Если ЗначениеЗаполнено(ДатаСрокаГодности) Тогда
		Результат.Вставить("expirationDate", ЛокальнаяДатаСоСмещениемXML(ДатаСрокаГодности));
		Результат.Вставить("expirationType", ТипСрокаГодностиВСервисе(ОписаниеТовара));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Стр.АльтернативныеСрокиГодности) Тогда
		Результат.Вставить("expirationDateConditions", УсловияИстеченияСроковГодности(Стр.АльтернативныеСрокиГодности));
		Результат.Вставить("expirationType", ТипСрокаГодностиВСервисе(ОписаниеТовара));
	КонецЕсли;
	
	УказыватьДатуПроизводства = Истина;
	Если ТипКодаМаркировки = ТипыКодовМаркировки.Набор
		Или ТипКодаМаркировки = ТипыКодовМаркировки.ГрупповаяУпаковка Тогда
		УказыватьДатуПроизводства = ВидПродукцииДопускаетДатуПроизводстваВОтчетеОНанесенииДляКИНКИГУ(ВидПродукции);
	КонецЕсли;
	
	Если УказыватьДатуПроизводства Тогда
		ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "productionDate", НачалоДня(ДатаПроизводства));
	КонецЕсли;
	
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "batchNumber", НомерПартии);
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "seriesNumber", НомерСерии);
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "documentNumber", НомерДокумента);
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "comment", ОписаниеОснования.Комментарий);
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "documentNumber", НомерДокумента);
	
	Если ВидПродукции = ВидыПродукции.Молоко
		Или ВидПродукции = ВидыПродукции.Морепродукты Тогда
		Результат.Вставить("cisType", ТипПотребительскойУпаковкиВСервисе(ТипКодаМаркировки));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Площадка) Тогда
		
		УказыватьДанныеПлощадки = (ВидПродукции = ВидыПродукции.Пиво
		Или ВидПродукции = ВидыПродукции.БезалкогольныеНапитки
		Или ВидПродукции = ВидыПродукции.БезалкогольноеПиво
		Или ВидПродукции = ВидыПродукции.СтроительныеМатериалы);
		
		Если УказыватьДанныеПлощадки Тогда
			
			ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "fiasId", Площадка.ИдентификаторФИАС);
			
			Если Не ЭтоИП(Организация.ИНН) Тогда
				Результат.Вставить("kpp", Площадка.КПП);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ВидПродукции = ВидыПродукции.Бады Тогда
			ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "vetisGuid", Площадка.ИдентификаторВЕТИС);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВидПродукцииДопускаетУказаниеФактическогоСодержанияСпирта(ВидПродукции) Тогда
		Результат.Вставить("alcoholVolume", Стр.СодержаниеСпирта);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерПервичногоДокумента) И ЗначениеЗаполнено(ДатаПервичногоДокумента) Тогда
		
		primaryDocument = Новый Структура;
		primaryDocument.Вставить("number", НомерПервичногоДокумента);
		primaryDocument.Вставить("date", Формат(ДатаПервичногоДокумента, "ДФ='yyyy-MM-dd'"));
		
		Результат.Вставить("primaryDocument", primaryDocument);
		
	КонецЕсли;
	
	ИспользованФактическийОбъемКег = Ложь;
	ИспользованНоминальныйОбъемКег = Ложь;
	
	ТаблицаКодов = КодыОпераций_ПолныеКоды(ОперацияОснование, Стр.КлючСтрокиОперации);
	
	Если ЭтоКег
		И (ВидПродукции = ВидыПродукции.Пиво Или ВидПродукции = ВидыПродукции.БезалкогольноеПиво) Тогда
		Для Каждого Стр Из ТаблицаКодов Цикл
			Если ЗначениеЗаполнено(Стр.Количество) Тогда
				Количество = Стр.Количество;
				ИспользованФактическийОбъемКег = Истина;
			ИначеЕсли НоминальныйОбъемВКегах Тогда
				Количество = НоминальныйОбъем;
				ИспользованНоминальныйОбъемКег = Истина;
			Иначе
				Количество = 0;
			КонецЕсли;
			Если ЗначениеЗаполнено(Количество)
				И Не ПолныйКодСодержитОбъем(Стр.ПолныйКод) Тогда
				Стр.ПолныйКод = ДобавитьОбъемВПолныйКод(Стр.ПолныйКод, Количество);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ПеременныйВес И ВидПродукцииПоддерживаетВесВСтруктуреКодаОтчетаОНанесении(ВидПродукции) Тогда
		Для Каждого Стр Из ТаблицаКодов Цикл
			Если ЗначениеЗаполнено(Стр.Количество)
				И Не ПолныйКодСодержитВес(Стр.ПолныйКод) Тогда
				Стр.ПолныйКод = ДобавитьВесВПолныйКод(Стр.ПолныйКод, Стр.Количество);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ТребуетсяЗСН Тогда
		Для Каждого Стр Из ТаблицаКодов Цикл
			Если ЗначениеЗаполнено(Стр.ЗаводскойСерийныйНомер) Тогда
				Стр.ПолныйКод = ДобавитьЗаводскойСерийныйНомерВПолныйКод(Стр.ПолныйКод, Стр.ЗаводскойСерийныйНомер);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Результат.Вставить("codes", ТаблицаКодов.ВыгрузитьКолонку("ПолныйКод"));
	
	Функциональность = Перечисление_ФункциональностьМодуля();
	Если ЭтоКег Тогда
		СтекМетрик_ДобавитьФункциональность(Функциональность.ОтчетОНанесенииНаКеги, Организация);
	КонецЕсли;
	Если ИспользованФактическийОбъемКег Тогда
		СтекМетрик_ДобавитьФункциональность(Функциональность.ОтчетОНанесенииНаКегиСФактическимОбъемом, Организация);
	КонецЕсли;
	Если ИспользованНоминальныйОбъемКег Тогда
		СтекМетрик_ДобавитьФункциональность(Функциональность.ОтчетОНанесенииНаКегиСНоминальнымОбъемом, Организация);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Контент_Отгрузка(ОписаниеОперации)
	
	ОбъемноСортовойУчет = ОписаниеОперации.ДопРеквизиты.ОбъемноСортовойУчет;
	
	Если ОбъемноСортовойУчет Тогда
		Результат = Контент_Отгрузка_ОбъемноСортовойУчет(ОписаниеОперации);
	Иначе
		Результат = Контент_Отгрузка_ПоэкземплярныйУчет(ОписаниеОперации);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Контент_Отгрузка_ПоэкземплярныйУчет(ОписаниеОперации)
	
	ТипыОтгрузок = Перечисление_ТипыОтгрузок();
	ПричиныВывода = Перечисление_ПричиныВыводаИзОборотаПриОтгрузке();
	
	Операция = ОписаниеОперации.Ссылка;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ТипОтгрузки = ДопРеквизиты.ТипОтгрузки;
	ПричинаВыводаИзОборота = ДопРеквизиты.ПричинаВыводаИзОборота;
	
	Результат = Новый Структура;
	Результат.Вставить("receiverInn", ДопРеквизиты.ИННПолучателя);
	Результат.Вставить("transferDate", ДопРеквизиты.ДатаОтгрузки);
	Результат.Вставить("primaryDocumentNumber", ДопРеквизиты.НомерДокумента);
	Результат.Вставить("primaryDocumentDate", ДопРеквизиты.ДатаДокумента);
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ВидПродукции));
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "comment", ОписаниеОперации.Комментарий);
	
	Если ТипОтгрузки = ТипыОтгрузок.ТрансграничнаяТорговля Тогда
		
		Результат.Вставить("receiverGln", ДопРеквизиты.GLNПолучателя);
		Результат.Вставить("receiverCountryCode" , ДопРеквизиты.КодСтраныПолучателя);
		
	ИначеЕсли ТипОтгрузки = ТипыОтгрузок.ОтгрузкаСВыводомИзОборота Тогда
		
		Результат.Вставить("withdrawnReason", ПричинаВыводаИзОборотаПриОтгрузкеВСервисе(ПричинаВыводаИзОборота));
