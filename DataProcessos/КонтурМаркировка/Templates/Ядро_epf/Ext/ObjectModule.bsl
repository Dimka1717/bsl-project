// Добавляет в метрики событие об использовании функциональности ввода в оборот
//
// Параметры:
//  ОписаниеОперации - Структура - см. Новый_Операция()
//
Процедура Метрика_Функциональность_ВводВОборот(ОписаниеОперации)
	
	Организация = ОписаниеОперации.Организация;
	
	ТипыПроизводственныхЗаказов =  Перечисление_ТипыПроизводственныхЗаказов();
	ТипПроизводственногоЗаказа = ОписаниеОперации.ДопРеквизиты.ТипПроизводственногоЗаказа;
	
	Если ТипПроизводственногоЗаказа = ТипыПроизводственныхЗаказов.КонтрактноеПроизводство Тогда
		Функциональность = Перечисление_ФункциональностьМодуля().ВводВОборотСКонтрактнымПроизводством;
	Иначе
		Функциональность = Перечисление_ФункциональностьМодуля().ВводВОборот;
	КонецЕсли;
	
	СтекМетрик_ДобавитьФункциональность(Функциональность, Организация);
	
КонецПроцедуры

// Добавляет в метрики событие об использовании функциональности возврата в оборот
//
// Параметры:
//  ОписаниеОперации - Структура - см. Новый_Операция()
//
Процедура Метрика_Функциональность_ВозвратВОборот(ОписаниеОперации)
	
	Организация = ОписаниеОперации.Организация;
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	Если ОписаниеОперации.ТипОперации = ТипыОпераций.ВозвратВОборот Тогда
		Функциональность = Перечисление_ФункциональностьМодуля().ВозвратВОборот;
	ИначеЕсли ОписаниеОперации.ТипОперации = ТипыОпераций.ВозвратВОборотНаТСД Тогда
		Если ЗначениеЗаполнено(ОписаниеОперации.ДокументУчета) Тогда
			Функциональность = Перечисление_ФункциональностьМодуля().ВозвратВОборотНаТСД;
		Иначе
			Функциональность = Перечисление_ФункциональностьМодуля().ВозвратВОборотНаТСДБезДокументаУчета;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Функциональность) Тогда
		Возврат;
	КонецЕсли;
	
	СтекМетрик_ДобавитьФункциональность(Функциональность, Организация);
	
КонецПроцедуры

