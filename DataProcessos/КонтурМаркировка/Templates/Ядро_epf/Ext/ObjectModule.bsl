// #Область КонтурПлагины

Функция МодульКонтурПлагины() Экспорт
	
	ИмяФайла = ИмяФайлаМодуляКонтурПлагины();
	
	Если НастройкиМодуля().РежимОтладки Тогда
		Попытка
			Результат = МодульКонтурМаркировка().ОбъектВложеннойОбработки(ИмяФайла);
		Исключение
			Ошибка = ИнформацияОбОшибке();
			Результат = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Если Результат = Неопределено И МодульМаркировкиОткрытИзКонфигурации() Тогда
		Результат = ОбъектВложеннойОбработкиИзКонфигурации(ИмяФайла);
	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		Результат = МодульКонтурМаркировка().ОбъектВложеннойОбработки(ИмяФайла);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИмяФайлаМодуляКонтурПлагины()
	
	Возврат "КонтурПлагины.epf";
	
КонецФункции

Процедура КонтурПлагины_ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка = Ложь) Экспорт
	
	Если Не ИспользоватьПлагины() Тогда
		Возврат;
	КонецЕсли;
	
	Если СтандартнаяОбработка Тогда
		ПараметрыСобытия.Вставить("СтандартнаяОбработка", СтандартнаяОбработка);
	КонецЕсли;
	
	МодульМаркировки = МодульКонтурМаркировка();
	
	ОчиститьОсновнойМодуль = Ложь;
	
	Попытка
		
		Если МодульМаркировки.ОсновнойМодуль = Неопределено Тогда
			ОчиститьОсновнойМодуль = Истина;
			МодульМаркировки.ОсновнойМодуль = МодульКонтурМаркировка(); // Поддержка вызова ОсновнойМодуль.ОсновнойМодуль для ОФ
		КонецЕсли;
		
		МодульКонтурПлагины().ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия, КонтурПлагины_КонтекстВызова());
		
		Если ОчиститьОсновнойМодуль Тогда
			МодульМаркировки.ОсновнойМодуль = Неопределено;
		КонецЕсли;
		
		Если СтандартнаяОбработка Тогда
			СтандартнаяОбработка = ПараметрыСобытия.СтандартнаяОбработка;
			ПараметрыСобытия.Удалить("СтандартнаяОбработка");
		КонецЕсли;
		
	Исключение
		
		Если ОчиститьОсновнойМодуль Тогда
			МодульМаркировки.ОсновнойМодуль = Неопределено;
		КонецЕсли;
		
		Если СтандартнаяОбработка Тогда
			СтандартнаяОбработка = ПараметрыСобытия.СтандартнаяОбработка;
			ПараметрыСобытия.Удалить("СтандартнаяОбработка");
		КонецЕсли;
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

Функция ИспользоватьПлагины()
	
	Возврат НастройкиМодуля().ИспользоватьПлагины = Истина;
	
КонецФункции

Функция КонтурПлагины_КонтекстВызова() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ВызывающийМодуль", МодульКонтурМаркировка());
	Результат.Вставить("РежимОтладки",     НастройкиМодуля().РежимОтладки);
	Результат.Вставить("КаталогОтладки",   КонтурПлагины_КаталогОтладки());
	
	Возврат Результат;
	
