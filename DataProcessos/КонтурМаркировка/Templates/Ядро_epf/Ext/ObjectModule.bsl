// Возвращает массив структур опросов пользователей
//
// Параметры:
//  Контент - Структура - см. КонтентДляСпискаОпросовПользователей()
// 
// Возвращаемое значение:
//  Структура - содержит:
//   * notifications - массив - структуры уведомлений с обязательными и произвольными полями
//
Функция СервисУведомлений_ОпросыПользователей(Контент) Экспорт
	
	Результат = Новый_Результат_ОтветаHTTP();
	
	Ответ_Мок = Мок_СервисУведомлений_ОпросыПользователей(Контент);
	Если Ответ_Мок <> Неопределено Тогда
		Результат.Результат = Ответ_Мок;
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	СервисУведомлений_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	
	Запрос.Метод = "POST";
	Запрос.ПутьНаСервере = "/1c/v4/{product_name}/notifications";
	Запрос.Параметры.Вставить("product_name", СервисУведомлений_ИмяПродукта_ОпросыПользователей());
	Запрос.ТелоЗапроса = ЗначениеВСтрокуJSON(Контент);
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	ОбработатьОшибкуHTTP(Ответ, Запрос);
	
	Если Результат.Успешно Тогда
		Результат.Результат = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СервисУведомлений_ИмяПродукта_ОпросыПользователей() Экспорт
	
	Возврат "mark-feedback";
	
КонецФункции

Функция ОпросыПользователей() Экспорт
	
	Результат = Новый Массив;
	
	Если НастройкиМодуля().ОтключитьОпросыПользователей Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяСправочника = ИмяСправочникаОпросыПользователей();
	ЭлементыДопСправочника = ДопСправочник_ВсеЭлементы(ИмяСправочника);
	
	Для Каждого Элемент Из ЭлементыДопСправочника Цикл
		
		ОписаниеОпроса = ОпросПользователей_Прочитать(Элемент);
		Результат.Добавить(ОписаниеОпроса);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ОпросыПользователей_ЗагрузитьИзСервиса() Экспорт
	
	Если НастройкиМодуля().ОтключитьОпросыПользователей Тогда
		Возврат;
	КонецЕсли;
	
	МассивОпросовИзСервиса = Новый Массив;
	ОрганизацииМаркировки = Организация_ВсеОрганизацииДляОбмена();
	Для Каждого Организация Из ОрганизацииМаркировки Цикл
		
		Контент = КонтентДляСпискаОпросовПользователей(Организация.ИНН);
		ИмяПродукта = СервисУведомлений_ИмяПродукта_ОпросыПользователей();
		
		Попытка
			Ответ = СервисУведомлений_ОпросыПользователей(Контент);
		Исключение
			
			Действие = НСтр("ru = 'Не удалось загрузить опросы пользователей'");
			Ошибка = ИнформацияОбОшибке();
			ОбработатьОшибку(Действие, Ошибка);
			
		КонецПопытки;
		
		Если Не ЗначениеЗаполнено(Ответ)
			ИЛИ Ответ.ВременнаяОшибка Тогда
			Возврат;
		КонецЕсли;
		
		ДополнитьМассив(МассивОпросовИзСервиса, Ответ.Результат["notifications"]);
		
	КонецЦикла;
	
	МассивСтруктур_Свернуть(МассивОпросовИзСервиса, "id");
	ОпросыПользователей_ОбновитьПоДаннымСервиса(МассивОпросовИзСервиса);
	
КонецПроцедуры

// Синхронизирует опросы пользователей в базе с сервисом уведомлений
//
// Параметры:
//  ДанныеСервиса - Массив - содержит опросы пользователя из сервиса
//
Процедура ОпросыПользователей_ОбновитьПоДаннымСервиса(ДанныеСервиса)
	
	ОпросыПользователей = ОпросыПользователей();
	Для Каждого ОписаниеОпроса Из ОпросыПользователей Цикл
		Если МассивСтруктур_Найти(ДанныеСервиса, ОписаниеОпроса.ИдентификаторОпроса, "id") = Неопределено Тогда
			ДопСправочник_Удалить(ОписаниеОпроса.Ссылка); // Опрос больше не актуален
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Элемент Из ДанныеСервиса Цикл
		
		НовоеОписаниеОпроса = Новый_ОпросПользователя();
		ОпросыПользователей_ЗаполнитьОпросДаннымиСервиса(НовоеОписаниеОпроса, Элемент);
		
		СтароеОписаниеОпроса = МассивСтруктур_Найти(ОпросыПользователей, Элемент["id"], "ИдентификаторОпроса");
		
		Если СтароеОписаниеОпроса <> Неопределено Тогда
			НовоеОписаниеОпроса.Ссылка = СтароеОписаниеОпроса.Ссылка;
			Если Не ОбъектыОтличаются(НовоеОписаниеОпроса, СтароеОписаниеОпроса) Тогда
				Продолжить; // Такой опрос уже есть в базе
			КонецЕсли;
		КонецЕсли;
		
		ОпросПользователей_Записать(НовоеОписаниеОпроса);
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет структуру опроса пользователя данными из сервиса
//
// Параметры:
//  ОписаниеОпроса - Структура - см. Новый_ОпросПользователя()
//  ДанныеСервиса - Структура - данные опроса пользователя из сервиса
//
Процедура ОпросыПользователей_ЗаполнитьОпросДаннымиСервиса(ОписаниеОпроса, ДанныеСервиса)
	
	ОписаниеОпроса.ИдентификаторОпроса = ДанныеСервиса["id"];
	
	content = ДанныеСервиса["content"];
	ОписаниеОпроса.ТекстОпроса = content["title"];
	ОписаниеОпроса.КлючСценария = content["script_key"];
	
	product_group = content["product_group"];
	ОписаниеОпроса.ВидыПродукции.Очистить();
	Если ЗначениеЗаполнено(product_group) Тогда
		Для Каждого Элемент Из product_group Цикл
			ОписаниеОпроса.ВидыПродукции.Добавить(ВидПродукцииПоТоварнойГруппеИзСервиса(Элемент));
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ОпросПользователей_Прочитать(Опрос)
	
	Результат = Новый_ОпросПользователя();
	
	ЭлементДопСправочника = ДопСправочник_Прочитать(Опрос);
	ЗаполнитьЗначенияСвойств(Результат, ЭлементДопСправочника.ДопРеквизиты);
	Результат.Ссылка = Опрос;
	
	Возврат Результат;
	
КонецФункции

Процедура ОпросПользователей_Записать(ОписаниеОпроса)
	
	ДанныеИБ = Новый_ЭлементДопСправочника(ИмяСправочникаОпросыПользователей());
	ДанныеИБ.Наименование = ОписаниеОпроса.КлючСценария;
	ДанныеИБ.Ссылка = ОписаниеОпроса.Ссылка;
	ДанныеИБ.ДопРеквизиты.Вставить("КлючСценария", ОписаниеОпроса.КлючСценария);
	ДанныеИБ.ДопРеквизиты.Вставить("ИдентификаторОпроса", ОписаниеОпроса.ИдентификаторОпроса);
	ДанныеИБ.ДопРеквизиты.Вставить("ТекстОпроса", ОписаниеОпроса.ТекстОпроса);
	ДанныеИБ.ДопРеквизиты.Вставить("ВидыПродукции", ОписаниеОпроса.ВидыПродукции);
	
	ДопСправочник_Записать(ДанныеИБ);
	
КонецПроцедуры

// Читает из настроек пользователя идентификаторы пройденных опросов
//
// Возвращаемое значение:
//  Массив - содержит идентификаторы пройденных пользователем опросов
//
Функция ИдентификаторыПройденныхОпросовПользователя() Экспорт
	
	Результат = Новый Массив;
	
	КлючиНастроек = Перечисление_КлючиНастроекПользователя();
	
	Попытка
		Результат = ПрочитатьНастройкуПользователя(КлючиНастроек.ИдентификаторыПройденныхОпросов, Результат);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Добавляет идентификатор пройденного опроса в массив и записывает в настройки пользователя
//
// Параметры:
//  ИдентификаторОпроса - Строка - идентификатор пройденного пользователем опроса
//
Процедура ЗафиксироватьИдентификаторПройденногоОпроса(ИдентификаторОпроса) Экспорт
	
	КлючиНастроек = Перечисление_КлючиНастроекПользователя();
	
	ИдентификаторыОпросов = ИдентификаторыПройденныхОпросовПользователя();
	Если ИдентификаторыОпросов.Найти(ИдентификаторОпроса) = Неопределено Тогда
		ИдентификаторыОпросов.Добавить(ИдентификаторОпроса);
	КонецЕсли;
	
	МаксимальноеКоличество = 50;
	Если ИдентификаторыОпросов.Количество() > МаксимальноеКоличество Тогда
		ИдентификаторыОпросов.Удалить(0);
	КонецЕсли;
	
	Попытка
		ЗаписатьНастройкуПользователя(КлючиНастроек.ИдентификаторыПройденныхОпросов, ИдентификаторыОпросов);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Запись идентификатора пройденного опроса пользователя'");
		ТекстСообщения = НСтр("ru = 'Не удалось записать идентификатор %1 в настройки пользователя'");
		ТекстСообщения = ПараметрыВСтроку(ТекстСообщения, ИдентификаторОпроса);
		ОбработатьОшибку(Действие, Ошибка, ИдентификаторОпроса, ТекстСообщения);
	КонецПопытки;
	
КонецПроцедуры

// Формирует контент с фильтрами для получения списка опросов из сервиса уведомлений
//
// Параметры:
//  ИНН - Строка - ИНН организации
