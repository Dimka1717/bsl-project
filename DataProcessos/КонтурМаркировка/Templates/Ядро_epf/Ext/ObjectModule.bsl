Функция ВариантыАналитикиДляПодбораКодов(ЗначенияПолей) Экспорт
	
	ТипТовар = ОписаниеТипа_Товар();
	ТипИдентификатор = ОписаниеТипа_Идентификатор();
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Товар", ТипТовар);
	Результат.Колонки.Добавить("КлючНоменклатуры", ТипИдентификатор);
	Результат.Колонки.Добавить("КлючХарактеристики", ТипИдентификатор);
	Результат.Колонки.Добавить("КлючУпаковки", ТипИдентификатор);
	Результат.Колонки.Добавить("КлючСерии", ТипИдентификатор);
	
	ИменаКолонок = Новый Массив;
	Для каждого Колонка Из Результат.Колонки Цикл
		ИменаКолонок.Добавить(Колонка.Имя);
	КонецЦикла;
	ВсегоВариантов = Результат.Колонки.Количество();
	
	МинимумКолонок = 1;
	Если Не ЗначениеЗаполнено(ЗначенияПолей.Товар) Тогда
		МинимумКолонок = МинимумКолонок + 1; // Исключаем вариант без номенклатуры 1С
	КонецЕсли;
	
	НаборыПолей = Новый Массив;
	Для Сч = -Результат.Колонки.Количество() По -МинимумКолонок Цикл
		НаборПолей = Новый Структура;
		Для НомерКолонки = 1 По -Сч Цикл
			НаборПолей.Вставить(ИменаКолонок.Получить(НомерКолонки - 1));
		КонецЦикла;
		НаборыПолей.Добавить(НаборПолей);
	КонецЦикла;
	
	Для каждого НаборПолей Из НаборыПолей Цикл
		ЗаполнитьЗначенияСвойств(НаборПолей, ЗначенияПолей);
		Если ЗначениеЗаполнено(ЗначенияПолей.КлючНоменклатуры1С) Тогда
			ЗаполнитьЗначенияСвойств(НаборПолей, ЗначенияПолей.КлючНоменклатуры1С);
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), НаборПолей);
	КонецЦикла;
	
	Результат.Свернуть(СоединитьСтроку(ИменаКолонок, ","));
	
	Возврат Результат;
	
КонецФункции

