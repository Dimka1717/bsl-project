	Результат.Вставить("ИнформацияОТарифах", "https://support.kontur.ru/markirovka/80137-ogranichenie_dostupa_k_scenariyam_v_sootvetstvii_s_tarifom");
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // ПрограммныеПеречисления

// #Область НастройкиМодуля

// Читает из базы настройки модуля
//
// Параметры:
//  ОбновитьКэш - Булево - Истина, если нужно повторно прочитать настройки из базы;
// 
// Возвращаемое значение:
//  Структура - см. Новый_НастройкиМодуля();
//
Функция НастройкиМодуля(ОбновитьКэш = Ложь) Экспорт
	
	КлючКэш = ИмяСправочникаНастройкиМодуля();
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено И Не ОбновитьКэш Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Новый_НастройкиМодуля();
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(КлючКэш);
	ЗаполнитьПоляСтруктуры(Результат, ДанныеИБ.ДопРеквизиты);
	
	Если ЗначениеЗаполнено(Результат.ПМ_БезопасныеДопПараметры) Тогда
		Владелец = Пользователи_ТекущийПользователь();
		ЗначенияПараметров = БезопасноеХранилище_Прочитать(Владелец, КлючБезопасныхДопПараметровПМ());
		Если ЗначениеЗаполнено(ЗначенияПараметров) Тогда
			ЗаполнитьЗначенияСвойств(Результат.ПМ_БезопасныеДопПараметры, ЗначенияПараметров);
		КонецЕсли;
	КонецЕсли;
	
	Если Результат.РежимРИБ Тогда
		Результат.НастройкиУзлаРИБ = НастройкиТекущегоУзлаРИБ(Результат.ПланОбмена);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат.ИдентификаторЭкземпляраМодуля) Тогда
		Результат.ИдентификаторЭкземпляраМодуля = Строка(Новый УникальныйИдентификатор);
		НастройкиМодуля_Записать(Результат);
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

// Записывает настройки модуля в доп справочник
//
// Параметры:
//  Настройки - Структура - см. Новый_НастройкиМодуля()
//
Процедура НастройкиМодуля_Записать(Настройки) Экспорт
	
	ИмяСправочника = ИмяСправочникаНастройкиМодуля();
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника);
	
	ДанныеИБ.ДопРеквизиты.Очистить();
	Для каждого Элемент Из Настройки Цикл
		
		Если Элемент.Ключ = "НастройкиУзлаРИБ" Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеИБ.ДопРеквизиты.Вставить(Элемент.Ключ, Элемент.Значение);
		
	КонецЦикла;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Если ЗначениеЗаполнено(Настройки.ПМ_БезопасныеДопПараметры) Тогда
			Владелец = Пользователи_ТекущийПользователь();
			БезопасноеХранилище_Записать(Владелец, Настройки.ПМ_БезопасныеДопПараметры, КлючБезопасныхДопПараметровПМ());
			Для каждого Элемент Из Настройки.ПМ_БезопасныеДопПараметры Цикл
				ДанныеИБ.ДопРеквизиты.ПМ_БезопасныеДопПараметры[Элемент.Ключ] = ПустоеЗначениеТипаЛок(ТипЗнч(Элемент.Значение));
			КонецЦикла;
		КонецЕсли;
		
		Если Настройки.РежимРИБ Тогда
			НастройкиУзлаРИБ_Записать(Настройки.НастройкиУзлаРИБ);
		КонецЕсли;
		
		ДопСправочник_Записать(ДанныеИБ);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Кэш_Поместить(ИмяСправочника, Настройки);
	
КонецПроцедуры

Функция НастройкиУзлаРИБ(Узел)
	
	ИмяСправочника = ИмяСправочникаНастройкиУзлаРИБ();
	ИмяРеквизита = "КодУзла";
	КодУзла = СокрЛП(Узел.Код);
	Результат = ДопСправочник_ПрочитатьПервый(ИмяСправочника, ИмяРеквизита, КодУзла);
	Возврат Результат;
	
КонецФункции

Процедура НастройкиУзлаРИБ_Записать(Настройки) Экспорт
	
	Если Не ЗначениеЗаполнено(Настройки.Узел) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеИБ = НастройкиУзлаРИБ(Настройки.Узел);
	
	Если Не ЗначениеЗаполнено(ДанныеИБ.Наименование) Тогда
		ДанныеИБ.Наименование = Настройки.Узел.Наименование;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДанныеИБ.Наименование) Тогда
		ДанныеИБ.Наименование = Настройки.ПрефиксИБ;
	КонецЕсли;
	
	ДопРеквизиты = ДанныеИБ.ДопРеквизиты;
	ДопРеквизиты.Очистить();
	ДопРеквизиты.Вставить("ПрефиксИБ", СокрЛП(Настройки.ПрефиксИБ));
	ДопРеквизиты.Вставить("КодУзла", СокрЛП(Настройки.Узел.Код));
	
	ДопСправочник_Записать(ДанныеИБ);
	
КонецПроцедуры

Функция НастройкиТекущегоУзлаРИБ(ПланОбмена)
	
	Узел = ТекущийУзелПланаОбмена(ПланОбмена);
	ДанныеИБ = НастройкиУзлаРИБ(Узел);
	
	Результат = Новый_НастройкиУзлаРИБ();
	Результат.Узел = Узел;
	ЗаполнитьПоляСтруктуры(Результат, ДанныеИБ.ДопРеквизиты);
	
	Возврат Результат;
	
КонецФункции

Функция ДопСправочник_НастройкиТекущегоУзлаРИБ(ПланОбмена) Экспорт
	
	Узел = ТекущийУзелПланаОбмена(ПланОбмена);
	ДанныеИБ = НастройкиУзлаРИБ(Узел);
	
	Возврат ДанныеИБ.Ссылка;
	
КонецФункции

Функция ТекущийУзелПланаОбмена(ПланОбмена) Экспорт
	
	Результат = ПланыОбмена[Метаданные.НайтиПоТипу(ПланОбмена).Имя].ЭтотУзел();
	
	Возврат Результат;
	
КонецФункции

