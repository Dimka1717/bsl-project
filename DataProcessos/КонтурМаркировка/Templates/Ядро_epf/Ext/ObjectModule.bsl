Функция ПрефиксНомера(Дата)
	
	ПрефиксИБ = ТипыОбъектовИС().ПрефиксИБ;
	НомерГода = Прав(Формат(Год(Дата), "ЧГ=0"), 2);
	
	Если ЗначениеЗаполнено(ПрефиксИБ) Тогда
		Результат = ПараметрыВСтроку("%1-%2-", ПрефиксИБ, НомерГода);
	Иначе
		Результат = ПараметрыВСтроку("%1-", НомерГода);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Опеределяет вариант расположения модуля для указания в загловке User-Agent
//
// Возвращаемое значение:
//  Строка - вариант расположения модуля для указания в заголовке запроса
//
Функция ВариантРасположенияМодуляДляUserAgent()
	
	РасположениеМодуля = РасположениеМодуля();
	
	Если РасположениеМодуля = Перечисление_ВариантыРасположенияОбработки().НаДиске Тогда
		Результат = "disk";
	ИначеЕсли РасположениеМодуля = Перечисление_ВариантыРасположенияОбработки().ВСправочнике Тогда
		Результат = "directory";
	ИначеЕсли РасположениеМодуля = Перечисление_ВариантыРасположенияОбработки().ВКонфигурации Тогда
		Результат = "configuration";
	ИначеЕсли РасположениеМодуля = Перечисление_ВариантыРасположенияОбработки().ВРасширении Тогда
		Результат = "extention";
	Иначе
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Находит первую строку строку по параметрам отбора
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - таблица значений;
//  ПараметрыОтбора - Структура - параметры отбора;
// 
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено
//
Функция ТаблицаЗначений_НайтиСтроку(ТаблицаЗначений, ПараметрыОтбора) Экспорт
	
	НайденныеСтроки = ТаблицаЗначений.НайтиСтроки(ПараметрыОтбора);
	
	Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
		Результат = НайденныеСтроки[0];
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Сворачивает таблицу значений по всем колонкам
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - таблица значений;
//  КолонкиСуммирования - Строка - имена колонок, разделенные запятыми,
//                                 по которым нужно суммировать значения;
//  КолонкиИсключения   - Строка - имена колонок, разделенные запятыми,
//                                 которые будут очищены перед сворачиванием;
//
Процедура ТаблицаЗначений_СвернутьПоВсемКолонкам(ТаблицаЗначений, КолонкиСуммирования = "", КолонкиИсключения = "") Экспорт
	
	Если ЗначениеЗаполнено(КолонкиСуммирования) Тогда
		МассивКолонокСуммирования = РазделитьСтроку(КолонкиСуммирования);
	Иначе
		МассивКолонокСуммирования = Новый Массив;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КолонкиИсключения) Тогда
		Для каждого ИмяКолонки Из РазделитьСтроку(КолонкиИсключения) Цикл
			ТаблицаЗначений.ЗаполнитьЗначения(Неопределено, ИмяКолонки);
		КонецЦикла;
	КонецЕсли;
	
	МассивКолонокГруппировок = Новый Массив;
	Для каждого Колонка Из ТаблицаЗначений.Колонки Цикл
		Если МассивКолонокСуммирования.Найти(Колонка.Имя) = Неопределено Тогда
			МассивКолонокГруппировок.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	КолонкиГруппировок = СоединитьСтроку(МассивКолонокГруппировок, ", ");
	
	ТаблицаЗначений.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	
КонецПроцедуры

