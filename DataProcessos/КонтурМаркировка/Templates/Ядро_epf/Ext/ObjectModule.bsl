Функция Контент_Перемаркировка(ОписаниеОперации)
	
	Операция = ОписаниеОперации.Ссылка;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	ОписаниеОснования = Операция_ПрочитатьОперацию(ОперацияОснование);
	КлючСтрокиОперации = ОписаниеОперации.КлючСтрокиОперацииОснования;
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ДопРеквизиты = ОписаниеОснования.ДопРеквизиты;
	ПричинаПеремаркировки = ОписаниеОснования.ДопРеквизиты.ПричинаПеремаркировки;
	ДатаПеремаркировки = ОписаниеОснования.ДопРеквизиты.ДатаПеремаркировки;
	Номер = ОписаниеОперации.Номер;
	
	СтрокаОснования = ОписаниеОснования.Товары.Найти(КлючСтрокиОперации, "КлючСтрокиОперации");
	ДанныеДокументаСертификации = ДанныеДокументаСертификации(СтрокаОснования);
	КодТНВЭД = СтрокаОснования.Товар.КодТНВЭД;
	
	Результат = Новый Структура;
	Результат.Вставить("documentNumber", Номер);
	Результат.Вставить("remarkingDate", ДатаПеремаркировки);
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ВидПродукции));
	Результат.Вставить("remarkingCause", ПричинаПеремаркировкиВСервисе(ПричинаПеремаркировки));
	
	ТаблицаКодов = КодыОпераций_ТаблицаКодов(ОперацияОснование, СтрокаОснования.КлючСтрокиОперации, Ложь);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	products = Новый Массив;
	Для каждого Стр Из ТаблицаКодов Цикл
		
		product = Новый Структура;
		product.Вставить("name", НаименованиеПозицииДляКонтента(Стр));
		product.Вставить("gtin", Стр.GTIN);
		product.Вставить("newCode", Стр.КодМаркировки);
		product.Вставить("tnvedCode", КодТНВЭД);
		
		Если ЗначениеЗаполнено(ДанныеДокументаСертификации) Тогда
			product.Вставить("certificate", ДанныеДокументаСертификации);
		КонецЕсли;
		
		products.Добавить(product);
		
	КонецЦикла;
	
	Результат.Вставить("products", products);
	
	Возврат Результат;
	
КонецФункции

Функция Контент_УведомлениеОПриемке_ОбновлениеДокумента(Операция)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ТипИсходнойОтгрузки = ДопРеквизиты.ТипИсходнойОтгрузки;
	
	Результат = Новый Структура;
	Результат.Вставить("acceptanceDate", ДопРеквизиты.ДатаПриемки);
	Результат.Вставить("acceptanceDecision", СпособПриемкиВСервисе(ДопРеквизиты.СтатусПриемки));
	
	Если ДопРеквизиты.СтатусПриемки <> Перечисление_СтатусыПриемки().Отклонено Тогда
		
		ДеревоСведенийОТоварах = Операция_УведомлениеОПриемке_СведенияОТоварах(ОписаниеОперации);
		
		positions = Новый Массив;
		Результат.Вставить("positions", positions);
		Контент_УведомлениеОПриемке_ОбновлениеДокумента_ДобавитьПозиции(positions, ДеревоСведенийОТоварах.Строки, ТипИсходнойОтгрузки);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура Контент_УведомлениеОПриемке_ОбновлениеДокумента_ДобавитьПозиции(positions, СтрокиДерева, ТипИсходнойОтгрузки)
	
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		
		Если ЗначениеЗаполнено(СтрокаДерева.Строки) Тогда
			
			Если ЗначениеЗаполнено(СтрокаДерева.Товар) Тогда
				
				Контент_УведомлениеОПриемке_ОбновлениеДокумента_ДобавитьПозиции(positions, СтрокаДерева.Строки, ТипИсходнойОтгрузки);
				
			Иначе
				
				position = МассивСтруктур_Найти(positions, СтрокаДерева.КодАгрегата, "code");
				Если position = Неопределено Тогда
					position = Новый Структура;
					position.Вставить("children", Новый Массив);
					positions.Добавить(position);
					Контент_УведомлениеОПриемке_ОбновлениеДокумента_ЗаполнитьПозицию(position, СтрокаДерева, ТипИсходнойОтгрузки);
				КонецЕсли;
				
				Контент_УведомлениеОПриемке_ОбновлениеДокумента_ДобавитьПозиции(position.children, СтрокаДерева.Строки, ТипИсходнойОтгрузки);
				
			КонецЕсли;
			
		Иначе
			position = Новый Структура;
			positions.Добавить(position);
			Контент_УведомлениеОПриемке_ОбновлениеДокумента_ЗаполнитьПозицию(position, СтрокаДерева, ТипИсходнойОтгрузки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Контент_УведомлениеОПриемке_ОбновлениеДокумента_ЗаполнитьПозицию(position, СтрокаДерева, ТипИсходнойОтгрузки)
	
	Если ТипИсходнойОтгрузки = Перечисление_ТипыИсходныхОтгрузок().ТрансграничнаяОтгрузкаОСУ Тогда
		Контент_УведомлениеОПриемке_ОбновлениеДокумента_ЗаполнитьПозициюОСУ(position, СтрокаДерева);
	Иначе
		Контент_УведомлениеОПриемке_ОбновлениеДокумента_ЗаполнитьПозициюПУ(position, СтрокаДерева);
	КонецЕсли;
	
	Если СтрокаДерева.Принято <> Неопределено Тогда
		position.Вставить("accepted", СтрокаДерева.Принято);
	КонецЕсли;
	
КонецПроцедуры

Процедура Контент_УведомлениеОПриемке_ОбновлениеДокумента_ЗаполнитьПозициюОСУ(position, СтрТовара)
	
	position.Вставить("gtin", СтрТовара.GTIN);
	position.Вставить("cisQuantity", СтрТовара.КоличествоКИ);
	
	ЦенаВКопейках = РублиВКопейки(СтрТовара.Цена);
	ДобавитьЗаполненноеЗначениеВСтруктуру(position, "productCost", ЦенаВКопейках);
	
	СуммаНДСВКопейках = РублиВКопейки(СтрТовара.СуммаНДС);
	position.Вставить("productTax", СуммаНДСВКопейках);
	
	ВесВГраммах = СтрТовара.Количество * ГраммВКилограмме();
	ДобавитьЗаполненноеЗначениеВСтруктуру(position, "weightGrams", ВесВГраммах);
	
	ДобавитьЗаполненноеЗначениеВСтруктуру(position, "tnvedCode", СтрТовара.КодТНВЭД);
	ДобавитьЗаполненноеЗначениеВСтруктуру(position, "accompanyingDocument", СтрТовара.ИдентификаторВСД);
	
КонецПроцедуры

Процедура Контент_УведомлениеОПриемке_ОбновлениеДокумента_ЗаполнитьПозициюПУ(position, СтрДерева)
	
	Если Не ЗначениеЗаполнено(СтрДерева.КодМаркировки) Тогда
		position.Вставить("code", СтрДерева.КодАгрегата);
		Возврат;
	КонецЕсли;
	
	СтрТовара = СтрДерева;
	Пока СтрТовара.Родитель <> Неопределено Цикл
		СтрТовара = СтрТовара.Родитель;
	КонецЦикла;
	
	position.Вставить("code", ЗаменитьРазделительGS1(СтрДерева.КодМаркировки));
	
	Если ЗначениеЗаполнено(СтрДерева.Цена) Тогда
		ЦенаВКопейках = РублиВКопейки(СтрДерева.Цена);
	Иначе
		ЦенаВКопейках = РублиВКопейки(СтрТовара.Цена);
	КонецЕсли;
	position.Вставить("productCost", ЦенаВКопейках);
	
	Если ЗначениеЗаполнено(СтрДерева.СуммаНДС) Тогда
		СуммаНДСВКопейках = РублиВКопейки(СтрДерева.СуммаНДС);
	Иначе
		СуммаНДСВКопейках = РублиВКопейки(СтрТовара.СуммаНДС);
	КонецЕсли;
	position.Вставить("productTax", СуммаНДСВКопейках);
	
	ДобавитьЗаполненноеЗначениеВСтруктуру(position, "tnvedCode", СтрТовара.КодТНВЭД);
	ДобавитьЗаполненноеЗначениеВСтруктуру(position, "accompanyingDocument", СтрТовара.ИдентификаторВСД);
	
КонецПроцедуры

Функция Контент_НаполнениеНаборовНаТСД(ОписаниеОперации)
	
	Операция = ОписаниеОперации.Ссылка;
	
	Результат = Новый Структура;
	Результат.Вставить("documentNumber", ОписаниеОперации.Номер);
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ОписаниеОперации.ВидПродукции));
	
	КэшТоваров = Новый Соответствие;
	aggregationUnits = Новый Массив;
	Для Каждого Стр ИЗ ОписаниеОперации.Товары Цикл
		
		Наименование = НаименованиеПозицииДляКонтента(Стр);
		
		КоличествоВложений = 0;
		setItems = Новый Массив;
		Если ЗначениеЗаполнено(Стр.Товар) Тогда
			Для Каждого Элемент Из Товар_Прочитать(Стр.Товар, КэшТоваров).СоставНабора Цикл
				setItem = Новый Структура;
				setItem.Вставить("name", Элемент.ВложенныйТовар.НаименованиеТовара);
				setItem.Вставить("codesCapacity", Элемент.КоличествоВложений);
				setItems.Добавить(setItem);
				КоличествоВложений = КоличествоВложений + Элемент.КоличествоВложений;
			КонецЦикла;
		КонецЕсли;
		
		Для каждого КодМаркировки Из КодыОпераций_КодыМаркировки(Операция, Стр.КлючСтрокиОперации, Ложь, Истина) Цикл
			unit = Новый Структура;
			unit.Вставить("setName", Наименование);
			unit.Вставить("kinCode", КодМаркировки);
			ДобавитьЗаполненноеЗначениеВСтруктуру(unit, "setItems", setItems);
			ДобавитьЗаполненноеЗначениеВСтруктуру(unit, "setCodesCapacity", КоличествоВложений);
			aggregationUnits.Добавить(unit);
		КонецЦикла;
		
	КонецЦикла;
	Результат.Вставить("aggregationUnits", aggregationUnits);
	
	Возврат Результат;
	
КонецФункции

