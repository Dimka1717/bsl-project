	Результат = Новый ФиксированныйМассив(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

// Возвращает полное имя объекта метаданных
//
// Параметры:
//  Объект - Произвольный - ссылка на объект;
// 
// Возвращаемое значение:
//  Строка - полное имя
//
Функция ПолноеИмяОбъекта(Объект)
	
	ТипОбъекта = ТипЗнч(Объект);
	
	КлючКэш = "ПолныеИменаОбъектов";
	ПолныеИмена = Кэш_Прочитать(КлючКэш);
	Если ПолныеИмена = Неопределено Тогда
		ПолныеИмена = Новый Соответствие;
		Кэш_Поместить(КлючКэш, ПолныеИмена);
	Иначе
		Результат = ПолныеИмена[ТипОбъекта];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	МетаданнеОбъекта = Метаданные.НайтиПоТипу(ТипОбъекта);
	
	Результат = "";
	Если МетаданнеОбъекта <> Неопределено Тогда
		Результат = МетаданнеОбъекта.ПолноеИмя();
	КонецЕсли;
	
	ПолныеИмена.Вставить(ТипОбъекта, Результат);
	
	Возврат Результат;
	
КонецФункции

