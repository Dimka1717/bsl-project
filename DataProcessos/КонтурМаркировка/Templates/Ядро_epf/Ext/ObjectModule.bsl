		position.Вставить("name", НаименованиеПозицииДляКонтента(Стр));
		position.Вставить("codes", КодыОпераций_КодыМаркировки(Операция, Стр.КлючСтрокиОперации, Ложь));
		positions.Добавить(position);
	КонецЦикла;
	Результат.Вставить("positions", positions);
	
	Возврат Результат;
	
