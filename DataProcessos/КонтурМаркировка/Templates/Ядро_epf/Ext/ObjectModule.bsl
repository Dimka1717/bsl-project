Функция КодыДокументов_Прочитать(ДокументУчета, КлючСтрокиДокумента = Неопределено) Экспорт
	
	ДокументУчета_ИзвлечьКодыИзАрхива(ДокументУчета);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	КодыДокументов.КлючКода КАК КлючКода,
	|	КодыДокументов.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	ТоварыДокумента.НомерСтроки КАК НомерСтрокиДокумента
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ПО КодыДокументов.КлючСтрокиДокумента = ТоварыДокумента.КлючСтрокиДокумента
	|			И (ТоварыДокумента.Ссылка = &ДокументУчета)
	|ГДЕ
	|	КодыДокументов.ДокументУчета = &ДокументУчета
	|	И &КлючСтрокиДокумента";
	
	Если КлючСтрокиДокумента = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиДокумента", "ИСТИНА");
	Иначе
		Условие = "КодыДокументов.КлючСтрокиДокумента = &КлючСтрокиДокумента";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиДокумента", Условие);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("КлючСтрокиДокумента", КлючСтрокиДокумента);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый_ТаблицаКодов();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), Выборка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция КодыДокументов_ОбщееКоличествоКодов(ДокументУчета) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Т.КоличествоКодов), 0) КАК КоличествоКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КоличествоКодовДокументов КАК Т
	|ГДЕ
	|	Т.ДокументУчета = &ДокументУчета");
	
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "КоличествоКодов");
	
КонецФункции

Функция КодыДокументов_ЕстьКоды(ДокументУчета, КлючСтрокиДокумента = Неопределено) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.КлючКода КАК КлючКода
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК Т
	|ГДЕ
	|	Т.ДокументУчета = &ДокументУчета
	|	И &КлючСтрокиДокумента";
	
	Если КлючСтрокиДокумента = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиДокумента", "ИСТИНА");
	Иначе
		Условие = "Т.КлючСтрокиДокумента = &КлючСтрокиДокумента";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиДокумента", Условие);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("КлючСтрокиДокумента", КлючСтрокиДокумента);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция КодыДокументов_ЕстьКодВСтруктуреУпаковок(ДокументУчета, КлючКода)
	
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	Стр = ТаблицаКодов.Добавить();
	Стр.КлючКода = КлючКода;
	ТаблицаЗначений_УдалитьЛишниеКолонки(ТаблицаКодов, "КлючКода");
	
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
	ТаблицаКодов_ВТ_ДобавитьКлючиАгрегатовВерхнегоУровня(МенеджерВТ);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТаблицаКодов.КлючКода КАК КлючКода
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО ТаблицаКодов.КлючКода = КодыДокументов.КлючКода
	|			И (КодыДокументов.ДокументУчета = &ДокументУчета)
	|ГДЕ
	|	ТаблицаКодов.КлючКода <> &КлючКода");
	
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("КлючКода", КлючКода);
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	РезультатЗапроса = Запрос.Выполнить();
	
	МенеджерВТ.Закрыть();
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции

Процедура КодыДокументов_Записать(ТаблицаКодов
	, ДокументУчета
	, УдалитьСтарыеКоды = Истина
	, ОбновитьКлючиНоменклатуры1С = Ложь) Экспорт
	
	Если Не УдалитьСтарыеКоды
		И ЗначениеЗаполнено(ТаблицаКодов)
		И ТаблицаКодов.Количество() <= НебольшоеКоличествоЗаписейРегистра()
		И КодыДокументов_ОбщееКоличествоКодов(ДокументУчета) > НебольшоеКоличествоЗаписейРегистра() Тогда
		КодыДокументов_ЗаписатьЧерезМенеджерЗаписи(ТаблицаКодов, ДокументУчета);
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыДокументов_Заблокировать(ДокументУчета);
		
		Набор = РегистрыСведений.КонтурМаркировка_КодыДокументов.СоздатьНаборЗаписей();
		Набор.Отбор.ДокументУчета.Установить(ДокументУчета);
		Набор.Прочитать();
		
		ТаблицаНабора = Набор.Выгрузить();
		ТаблицаНабора.Колонки.Добавить("Записать");
		ИндексКлючКода = ТаблицаНабора.Индексы.Добавить("КлючКода");
		
		Для каждого СтрКода Из ТаблицаКодов Цикл
			
			СтрНабора = ТаблицаНабора.Найти(СтрКода.КлючКода, "КлючКода");
			Если СтрНабора = Неопределено Тогда
				СтрНабора = ТаблицаНабора.Добавить();
				СтрНабора.КлючКода = СтрКода.КлючКода;
			КонецЕсли;
			
			СтрНабора.ДокументУчета = ДокументУчета;
			СтрНабора.КлючСтрокиДокумента = СтрКода.КлючСтрокиДокумента;
			СтрНабора.Записать = Не СтрКода.УдалитьИзДокумента;
			
		КонецЦикла;
		ТаблицаНабора.Индексы.Удалить(ИндексКлючКода);
		
		Если Не УдалитьСтарыеКоды Тогда
			Для каждого СтрНабора Из ТаблицаНабора Цикл
				Если СтрНабора.Записать = Неопределено Тогда
					СтрНабора.Записать = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		УдаленныеКоды = Новый Массив;
		Для Сч = -(ТаблицаНабора.Количество() - 1) По 0 Цикл
			СтрНабора = ТаблицаНабора.Получить(-Сч);
			Если СтрНабора.Записать <> Истина Тогда
				УдаленныеКоды.Добавить(СтрНабора.КлючКода);
				ТаблицаНабора.Удалить(СтрНабора);
			КонецЕсли;
		КонецЦикла;
		ТаблицаНабора.Колонки.Удалить("Записать");
		
		Набор.Загрузить(ТаблицаНабора);
		Набор.Записать();
		
		Если ОбновитьКлючиНоменклатуры1С Тогда
			КодыДокументов_ОбновитьКлючиНоменклатуры1С(ДокументУчета);
		КонецЕсли;
		
		КодыДокументов_ОбновитьКоличествоКодов(ДокументУчета);
		КодыЗаказов_ВернутьКодыВЗаказы(УдаленныеКоды);
		УстаревшиеКоды_Записать(УдаленныеКоды);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура КодыДокументов_ЗаписатьЧерезМенеджерЗаписи(ТаблицаКодов, ДокументУчета)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыДокументов_Заблокировать(ДокументУчета);
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.*
		|ИЗ
		|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК Т
		|ГДЕ
		|	Т.ДокументУчета = &ДокументУчета
		|	И Т.КлючКода В(&КлючиКодов)");
		Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
		Запрос.УстановитьПараметр("КлючиКодов", ТаблицаКодов.ВыгрузитьКолонку("КлючКода"));
		ТаблицаНабора = Запрос.Выполнить().Выгрузить();
		
		УдаленныеКоды = Новый Массив;
		
		Для каждого СтрКода Из ТаблицаКодов Цикл
			
			СтрНабора = ТаблицаНабора.Найти(СтрКода.КлючКода, "КлючКода");
			
			Если СтрКода.УдалитьИзДокумента Тогда
				Если СтрНабора <> Неопределено Тогда
					Запись = РегистрыСведений.КонтурМаркировка_КодыДокументов.СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(Запись, СтрНабора);
					Запись.Удалить();
				КонецЕсли;
				УдаленныеКоды.Добавить(СтрКода.КлючКода);
				Продолжить;
			КонецЕсли;
			
			Если СтрНабора = Неопределено Тогда
				Запись = РегистрыСведений.КонтурМаркировка_КодыДокументов.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись, СтрКода);
				Запись.ДокументУчета = ДокументУчета;
				Запись.Записать();
			Иначе
				Запись = РегистрыСведений.КонтурМаркировка_КодыДокументов.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись, СтрНабора);
				Запись.ДокументУчета = ДокументУчета;
				Запись.Прочитать();
				ЗаполнитьЗначенияСвойств(Запись, СтрКода);
				Запись.Записать();
			КонецЕсли;
			
		КонецЦикла;
		
		КодыДокументов_ОбновитьКоличествоКодов(ДокументУчета);
		
		УстаревшиеКоды_Записать(УдаленныеКоды);
		КодыЗаказов_ВернутьКодыВЗаказы(УдаленныеКоды);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура КодыДокументов_ПереместитьВАрхив(ДокументУчета)
	
	ДопСвойства = Перечисление_ДопСвойства();
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыДокументов_Заблокировать(ДокументУчета);
		
		ТаблицаКодов = КодыДокументов_Прочитать(ДокументУчета);
		
		Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
			
			ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
			
			ПоляДляФайла =
			"КодМаркировки, ХешСуммаКодаМаркировки, КлючКода,
			|ЗаводскойСерийныйНомер, СерийныйНомер, Количество,
			|КлючСтрокиДокумента, КлючНоменклатуры1С, Товар,
			|ТипШтрихкода, ТипУпаковки, ОбщийТипУпаковки, ВидПродукции,
			|ДляВнутреннегоУчета";
			
			ТаблицаЗначений_УдалитьЛишниеКолонки(ТаблицаКодов, ПоляДляФайла);
			
			ОписаниеФайла = Новый_ОписаниеФайла();
			ОписаниеФайла.ДанныеФайла = ТаблицаКодов;
			ОписаниеФайла.ВладелецФайла = ДокументУчета;
			ОписаниеФайла.ТипФайла = Перечисление_ТипыФайлов().КодыДокумента;
			Файл_Записать(ОписаниеФайла);
			
			Набор = РегистрыСведений.КонтурМаркировка_КодыДокументов.СоздатьНаборЗаписей();
			Набор.ОбменДанными.Загрузка = Истина;
			Набор.Отбор.ДокументУчета.Установить(ДокументУчета);
			Набор.Записать();
			
			Набор = РегистрыСведений.КонтурМаркировка_КоличествоКодовДокументов.СоздатьНаборЗаписей();
			Набор.ОбменДанными.Загрузка = Истина;
			Набор.Отбор.ДокументУчета.Установить(ДокументУчета);
			Набор.Записать();
			
			УстаревшиеКоды_Записать(ТаблицаКодов.ВыгрузитьКолонку("КлючКода"));
			
			ДопСвойство_Записать(ДокументУчета, ДопСвойства.КоличествоКодовВАрхиве, ТаблицаКодов.Количество());
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура КодыДокументов_ИзвлечьИзФайла(ДокументУчета)
	
	ДопСвойства = Перечисление_ДопСвойства();
	
	Результат = Новый_ТаблицаКодов();
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыДокументов_Заблокировать(ДокументУчета);
		
		ФайлКодов = Файл_Найти(ДокументУчета, Перечисление_ТипыФайлов().КодыДокумента);
		
		Если ЗначениеЗаполнено(ФайлКодов) Тогда
			
			ТаблицаКодов = Файл_Прочитать(ФайлКодов).ДанныеФайла;
			ТаблицаКодов_ДополнитьКолонки(ТаблицаКодов);
			ТаблицаКодов.ЗаполнитьЗначения(Истина, "КодРазобран");
			
			// Если коды загрузили в другой документ из внешнего источника
			ТаблицаКодов_ЗаполнитьКлючиКодов(ТаблицаКодов);
			ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
			
			ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
			КодыДокументов_Записать(ТаблицаКодов, ДокументУчета);
			
			Файлы_Удалить(ФайлКодов);
			
			ДопСвойство_Записать(ДокументУчета, ДопСвойства.КоличествоКодовВАрхиве, 0);
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура КодыДокументов_ОбновитьКоличествоКодов(ДокументУчета) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КодыДокументов.ДокументУчета КАК ДокументУчета,
	|	КодыДокументов.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	ЕСТЬNULL(ИнформацияОКодах.КлючНоменклатуры1С, ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_КлючиНоменклатуры1С.ПустаяСсылка)) КАК КлючНоменклатуры1С,
	|	ЕСТЬNULL(ИнформацияОКодах.Товар, ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_Товары.ПустаяСсылка)) КАК Товар,
	|	ЕСТЬNULL(ИнформацияОКодах.ТипУпаковки, ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ТипыУпаковок.ПустаяСсылка)) КАК ТипУпаковки,
	|	ЕСТЬNULL(ИнформацияОКодах.ОбщийТипУпаковки, ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ОбщиеТипыУпаковок.ПустаяСсылка)) КАК ОбщийТипУпаковки,
	|	ЕСТЬNULL(СтатусыКодов.Статус, """") КАК СтатусКодов,
	|	КОЛИЧЕСТВО(*) КАК КоличествоКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО КодыДокументов.КлючКода = СвязиКлючейКодов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (СвязиКлючейКодов.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|		ПО (СвязиКлючейКодов.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода)
	|ГДЕ
	|	КодыДокументов.ДокументУчета = &ДокументУчета
	|
	|СГРУППИРОВАТЬ ПО
	|	КодыДокументов.ДокументУчета,
	|	КодыДокументов.КлючСтрокиДокумента,
	|	ЕСТЬNULL(ИнформацияОКодах.КлючНоменклатуры1С, ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_КлючиНоменклатуры1С.ПустаяСсылка)),
	|	ЕСТЬNULL(ИнформацияОКодах.Товар, ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_Товары.ПустаяСсылка)),
	|	ЕСТЬNULL(ИнформацияОКодах.ТипУпаковки, ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ТипыУпаковок.ПустаяСсылка)),
	|	ЕСТЬNULL(ИнформацияОКодах.ОбщийТипУпаковки, ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ОбщиеТипыУпаковок.ПустаяСсылка)),
	|	ЕСТЬNULL(СтатусыКодов.Статус, """")");
	
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	
	Набор = РегистрыСведений.КонтурМаркировка_КоличествоКодовДокументов.СоздатьНаборЗаписей();
	Набор.Отбор.ДокументУчета.Установить(ДокументУчета);
	Набор.Загрузить(Запрос.Выполнить().Выгрузить());
	Набор.Записать();
	
КонецПроцедуры

Процедура КодыДокументов_ОбновитьКоличествоКодовПоТаблицеКодов(ТаблицаКодов)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.ДокументУчета КАК ДокументУчета
	|ПОМЕСТИТЬ ДокументыУчета
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК Т
	|ГДЕ
	|	Т.КлючКода В(&КлючиКодов)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДокументУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыУчета.ДокументУчета КАК ДокументУчета,
	|	КодыДокументов.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	ЕСТЬNULL(ИнформацияОКодах.КлючНоменклатуры1С, ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_КлючиНоменклатуры1С.ПустаяСсылка)) КАК КлючНоменклатуры1С,
	|	ЕСТЬNULL(ИнформацияОКодах.Товар, ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_Товары.ПустаяСсылка)) КАК Товар,
	|	ЕСТЬNULL(ИнформацияОКодах.ТипУпаковки, ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ТипыУпаковок.ПустаяСсылка)) КАК ТипУпаковки,
	|	ЕСТЬNULL(ИнформацияОКодах.ОбщийТипУпаковки, ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ОбщиеТипыУпаковок.ПустаяСсылка)) КАК ОбщийТипУпаковки,
	|	ЕСТЬNULL(СтатусыКодов.Статус, """") КАК СтатусКодов,
	|	СУММА(1) КАК КоличествоКодов
	|ИЗ
	|	ДокументыУчета КАК ДокументыУчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО ДокументыУчета.ДокументУчета = КодыДокументов.ДокументУчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО (КодыДокументов.КлючКода = СвязиКлючейКодов.КлючКода)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (СвязиКлючейКодов.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|		ПО (СвязиКлючейКодов.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДокументыУчета.ДокументУчета,
	|	КодыДокументов.КлючСтрокиДокумента,
	|	ЕСТЬNULL(ИнформацияОКодах.КлючНоменклатуры1С, ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_КлючиНоменклатуры1С.ПустаяСсылка)),
	|	ЕСТЬNULL(ИнформацияОКодах.Товар, ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_Товары.ПустаяСсылка)),
	|	ЕСТЬNULL(ИнформацияОКодах.ТипУпаковки, ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ТипыУпаковок.ПустаяСсылка)),
	|	ЕСТЬNULL(ИнформацияОКодах.ОбщийТипУпаковки, ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ОбщиеТипыУпаковок.ПустаяСсылка)),
	|	ЕСТЬNULL(СтатусыКодов.Статус, """")
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокументУчета
	|ИТОГИ ПО
	|	ДокументУчета");
	
	Запрос.УстановитьПараметр("КлючиКодов", ТаблицаЗначений_ВыгрузитьКолонку(ТаблицаКодов, "КлючКода"));
	
	ВыборкаДокумент = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДокумент.Следующий() Цикл
		
		Набор = РегистрыСведений.КонтурМаркировка_КоличествоКодовДокументов.СоздатьНаборЗаписей();
		Набор.Отбор.ДокументУчета.Установить(ВыборкаДокумент.ДокументУчета);
		
		Выборка = ВыборкаДокумент.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Набор.Добавить(), Выборка);
		КонецЦикла;
		
		Набор.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура КодыДокументов_Заблокировать(ДокументУчета) Экспорт
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КонтурМаркировка_КодыДокументов");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("ДокументУчета", ДокументУчета);
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

Процедура КодыДокументов_ЗаблокироватьПоТаблице(Таблица, ИмяКолонки = "ДокументУчета") Экспорт
	
	Поле = "ДокументУчета";
	Объект = "РегистрСведений.КонтурМаркировка_КодыДокументов";
	ЗаблокироватьПоТаблице(Объект, Поле, Таблица, ИмяКолонки);
	
КонецПроцедуры

Процедура КодыДокументов_ОбновитьКлючиНоменклатуры1С(ДокументУчета) Экспорт
	
	// Временная таблица нужна для исключения построения неоптимального плана запроса
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КодыДокументов.КлючКода КАК КлючКода,
	|	ИнформацияОКодах.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	ТоварыДокумента.КлючНоменклатуры1С КАК НовыйКлючНоменклатуры1С
	|ПОМЕСТИТЬ ТабКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ПО КодыДокументов.КлючСтрокиДокумента = ТоварыДокумента.КлючСтрокиДокумента
	|			И (ТоварыДокумента.Ссылка = &ДокументУчета)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО КодыДокументов.КлючКода = СвязиКлючейКодов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (СвязиКлючейКодов.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	КодыДокументов.ДокументУчета = &ДокументУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабКодов.КлючКода КАК КлючКода,
	|	ТабКодов.НовыйКлючНоменклатуры1С КАК НовыйКлючНоменклатуры1С
	|ИЗ
	|	ТабКодов КАК ТабКодов
	|ГДЕ
	|	ТабКодов.КлючНоменклатуры1С <> ТабКодов.НовыйКлючНоменклатуры1С");
	
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	
	ТаблицаКодов = Запрос.Выполнить().Выгрузить();
	ТаблицаКодов_ДополнитьКолонки(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьИнформациюОКодах(ТаблицаКодов);
	
	ТаблицаКодов.Колонки.Удалить("КлючНоменклатуры1С");
	ТаблицаКодов.Колонки.НовыйКлючНоменклатуры1С.Имя = "КлючНоменклатуры1С";
	
	ТаблицаКодов_ЗаписатьИнформациюОКодах(ТаблицаКодов);
	
КонецПроцедуры

Функция КодыДокументов_КлючСтрокиДокумента(КлючКода, ДокументУчета)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК Т
	|ГДЕ
	|	Т.КлючКода = &КлючКода
	|	И Т.ДокументУчета = &ДокументУчета");
	Запрос.УстановитьПараметр("КлючКода", КлючКода);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "КлючСтрокиДокумента");
	
КонецФункции

Процедура КодыДокументов_РасформироватьАгрегат(КлючАгрегата, ТаблицаКодов)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.ДокументУчета КАК ДокументУчета,
	|	МАКСИМУМ(Т.КлючСтрокиДокумента) КАК КлючСтрокиДокумента
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК Т
	|ГДЕ
	|	Т.КлючКода = &КлючАгрегата
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.ДокументУчета");
	Запрос.УстановитьПараметр("КлючАгрегата", КлючАгрегата);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		КодыДокументов_ЗаблокироватьПоТаблице(РезультатЗапроса);
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ТаблицаКодов.ЗаполнитьЗначения(Выборка.КлючСтрокиДокумента, "КлючСтрокиДокумента");
			КодыДокументов_Записать(ТаблицаКодов, Выборка.ДокументУчета, Ложь, Истина);
			ДокументУчета_ОбновитьТребуемоеДействие(Выборка.ДокументУчета);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// #КонецОбласти // КодыДокументов

// #Область КлючиНоменклатуры1С

// Находит или создает ключ номенклатуры 1С по ключевым реквизитам
//
// Параметры:
//  АналитикаНоменклатуры - Структура, СтрокаТаблицыЗначений - содержит поля:
//   * Номенклатура - СправочникСсылка - номенклатура;
//   * Характеристика - СправочникСсылка - характеристика;
//   * Упаковка - СправочникСсылка - упаковка;
//   * Серия - СправочникСсылка - серия;
//  КэшРезультатов - Соответствие - локальный кэш результатов;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_КлючиНоменклатуры1С
//
Функция КлючНоменклатуры1С_Подобрать(АналитикаНоменклатуры, КэшРезультатов = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(АналитикаНоменклатуры.Номенклатура) Тогда
		Возврат ПустойКлючНоменклатуры1С();
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КлючКэш = СтрокаИдентификаторовАналитикиНоменклатуры1С(АналитикаНоменклатуры);
		Результат = КэшРезультатов[КлючКэш];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	КлючиАналитики = КлючиАналитикиНоменклатуры1С_Подобрать(АналитикаНоменклатуры);
	
	Результат = КлючНоменклатуры1С_Найти(КлючиАналитики);
	Если Не ЗначениеЗаполнено(Результат) Тогда
		КлючиАналитикиНоменклатуры1С_Записать(КлючиАналитики);
		Результат = КлючНоменклатуры1С_Найти(КлючиАналитики);
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(КлючКэш, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Находит или создает ключ номенклатуры 1С по ключам аналитики номенклатуры
//
// Параметры:
//  КлючиАналитики - Структура, СтрокаТабличнойЧасти - содержит поля:
//   * КлючНоменклатуры - УникальныйИдентификатор - ключ номенклатуры;
//   * КлючХарактеристики - УникальныйИдентификатор - ключ характеристики;
//   * КлючУпаковки - УникальныйИдентификатор - ключ упаковки;
//   * КлючСерии - УникальныйИдентификатор - ключ серии;
//  КэшРезультатов - Соответствие - локальный кэш результатов;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_КлючиНоменклатуры1С
//
Функция КлючНоменклатуры1С_ПодобратьПоКлючамАналитики(КлючиАналитики, КэшРезультатов = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(КлючиАналитики.КлючНоменклатуры) Тогда
		Возврат ПустойКлючНоменклатуры1С();
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КлючКэш = СтрокаКлючейАналитикиНоменклатуры1С(КлючиАналитики);
		Результат = КэшРезультатов[КлючКэш];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Результат = КлючНоменклатуры1С_Найти(КлючиАналитики);
	Если Не ЗначениеЗаполнено(Результат) Тогда
		КлючиАналитикиНоменклатуры1С_Записать(КлючиАналитики);
		Результат = КлючНоменклатуры1С_Найти(КлючиАналитики);
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(КлючКэш, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КлючНоменклатуры1С_Найти(КлючиАналитики)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КлючиАналитикиНоменклатуры1С КАК Т
	|ГДЕ
	|	Т.КлючНоменклатуры = &КлючНоменклатуры
	|	И Т.КлючХарактеристики = &КлючХарактеристики
	|	И Т.КлючУпаковки = &КлючУпаковки
	|	И Т.КлючСерии = &КлючСерии");
	
	Запрос.УстановитьПараметр("КлючНоменклатуры", КлючиАналитики.КлючНоменклатуры);
	Запрос.УстановитьПараметр("КлючХарактеристики", КлючиАналитики.КлючХарактеристики);
	Запрос.УстановитьПараметр("КлючУпаковки", КлючиАналитики.КлючУпаковки);
	Запрос.УстановитьПараметр("КлючСерии", КлючиАналитики.КлючСерии);
	
	Результат = ПолучитьРезультатЗапроса(Запрос, "КлючНоменклатуры1С");
	
	Возврат Результат;
	
КонецФункции

// Возвращает представление ключа номенклатуры 1С, учитывая ограничения платформы 8.2
//
// Параметры:
//  КлючСсылка - СправочникСсылка.КонтурМаркировка_КлючиНоменклатуры1С - ключ номенклатуры 1С;
// 
// Возвращаемое значение:
//  Строка - представление аналитики номенклатуры;
//
Функция КлючНоменклатуры1С_Представление(КлючНоменклатуры1С)
	
	Результат = СокрЛП(КлючНоменклатуры1С);
	МаксДлинаНаименованияВСправочнике = 150;
	
	Если СтрДлина(Результат) = МаксДлинаНаименованияВСправочнике И ВерсияРежимаСовместимостиНиже("8.3") Тогда
		// В 8.2 вместо обработки представления используется поле Наименование,
		// в это поле может не поместиться вся строка представления номенклатуры
		Результат = Справочники.КонтурМаркировка_КлючиНоменклатуры1С.ПредставлениеНоменклатуры1С(КлючНоменклатуры1С);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура КлючНоменклатуры1С_ОбновитьПредставление(КлючНоменклатуры1С)
	
	МаксДлинаНаименованияВСправочнике = 150;
	НовоеПредставление = Справочники.КонтурМаркировка_КлючиНоменклатуры1С.ПредставлениеНоменклатуры1С(КлючНоменклатуры1С);
	НовоеПредставление = Лев(НовоеПредставление, МаксДлинаНаименованияВСправочнике);
	
	Если КлючНоменклатуры1С.Наименование <> НовоеПредставление Тогда
		ОбъектКлюча = КлючНоменклатуры1С.ПолучитьОбъект();
		ОбъектКлюча.ДополнительныеСвойства.Вставить("ОтключитьЗаписьАналитики");
		ОбъектКлюча.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция КлючиАналитикиНоменклатуры1С_Подобрать(АналитикаНоменклатуры)
	
	Результат = Новый_КлючиАналитикиНоменклатуры1С();
	
	Результат.КлючНоменклатуры = КлючОбъекта1С(АналитикаНоменклатуры.Номенклатура);
	Результат.КлючХарактеристики = КлючОбъекта1С(АналитикаНоменклатуры.Характеристика);
	Результат.КлючУпаковки = КлючОбъекта1С(АналитикаНоменклатуры.Упаковка);
	Результат.КлючСерии = КлючОбъекта1С(АналитикаНоменклатуры.Серия);
	
	Результат.ТипКлючаНоменклатуры = ТипКлючаОбъекта1С(АналитикаНоменклатуры.Номенклатура);
	Результат.ТипКлючаХарактеристики = ТипКлючаОбъекта1С(АналитикаНоменклатуры.Характеристика);
	Результат.ТипКлючаУпаковки = ТипКлючаОбъекта1С(АналитикаНоменклатуры.Упаковка);
	Результат.ТипКлючаСерии = ТипКлючаОбъекта1С(АналитикаНоменклатуры.Серия);
	
	Возврат Результат;
	
КонецФункции

Процедура КлючиАналитикиНоменклатуры1С_Записать(КлючиАналитики)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КлючиАналитикиНоменклатуры1С_Заблокировать(КлючиАналитики);
		
		Запись = РегистрыСведений.КонтурМаркировка_КлючиАналитикиНоменклатуры1С.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, КлючиАналитики);
		Запись.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура КлючиАналитикиНоменклатуры1С_Заблокировать(КлючиАналитики)
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КонтурМаркировка_КлючиАналитикиНоменклатуры1С");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Для каждого ИмяКлюча Из РазделитьСтроку(ИменаКлючейАналитикиНоменклатуры1С()) Цикл
		ЭлементБлокировки.УстановитьЗначение(ИмяКлюча, КлючиАналитики[ИмяКлюча]);
	КонецЦикла;
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

Функция ИменаПолейАналитикиНоменклатуры1С()
	
	Возврат Справочники.КонтурМаркировка_КлючиНоменклатуры1С.ИменаПолейАналитикиНоменклатуры1С();
	
КонецФункции

Функция ИменаКлючейАналитикиНоменклатуры1С()
	
	Возврат Справочники.КонтурМаркировка_КлючиНоменклатуры1С.ИменаКлючейАналитикиНоменклатуры1С();
	
КонецФункции

Функция АналитикаНоменклатуры1С(КлючиАналитики, КэшКлючейНоменклатуры1С = Неопределено) Экспорт
	
	Возврат Справочники.КонтурМаркировка_КлючиНоменклатуры1С.АналитикаНоменклатуры1С(КлючиАналитики, КэшКлючейНоменклатуры1С);
	
КонецФункции

Функция Новый_АналитикаНоменклатуры1С() Экспорт
	
	Возврат Новый Структура(ИменаПолейАналитикиНоменклатуры1С());
	
КонецФункции

Функция Новый_КлючиАналитикиНоменклатуры1С() Экспорт
	
	Результат = Новый Структура(ИменаКлючейАналитикиНоменклатуры1С());
	
	ПустойИдентификатор = ПустойУникальныйИдентификатор();
	
	Для каждого Эл Из Результат Цикл
		Результат[Эл.Ключ] = ПустойИдентификатор;
		Результат.Вставить(СтрЗаменить(Эл.Ключ, "Ключ", "ТипКлюча"), "");
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти

// #Область ДокументыУчета

// Читает документ учета из базы и возвращает его структуру
//
// Параметры:
//  ДокументУчета - СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ, который нужно прочитать
// 
// Возвращаемое значение:
//  Структура - см. Новый_ДокументУчета()
//
Функция ДокументУчета_ПрочитатьДокумент(ДокументУчета) Экспорт
	
	Результат = Новый_ДокументУчета();
	Результат.Ссылка = ДокументУчета;
	
	ДокументУчета_ПрочитатьШапку(Результат);
	ДокументУчета_ПрочитатьТоварыДокумента(Результат);
	ДокументУчета_ПрочитатьТоварыМаркировки(Результат);
	ДокументУчета_ПрочитатьСтатусы(Результат);
	ДокументУчета_ПрочитатьДопРеквизиты(Результат);
	
	Возврат Результат;
	
КонецФункции

// Читает из базы реквизиты из справочника и заполняет ими документ учета
//
// Параметры:
//  ДокументУчета - Структура - см. Новый_ДокументУчета()
//
Процедура ДокументУчета_ПрочитатьШапку(ОписаниеДокумента)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Код КАК Номер,
	|	Т.Дата КАК Дата,
	|	Т.ТипДокумента КАК ТипДокумента,
	|	Т.Организация КАК Организация,
	|	Т.Склад КАК Склад,
	|	Т.Комментарий КАК Комментарий,
	|	Т.Наименование КАК Наименование,
	|	Т.КлючДокумента1С КАК КлючДокумента1С,
	|	Т.ТипКлючаДокумента1С КАК ТипКлючаДокумента1С,
	|	Т.ОбъемноСортовойУчет КАК ОбъемноСортовойУчет,
	|	Т.ВерсияДанных КАК ВерсияДанных
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка", ОписаниеДокумента.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ОписаниеДокумента, Выборка);
		ОписаниеДокумента.Документ1С = МодульОбщегоНазначения().СсылкаПоИдентификатору(
		Выборка.КлючДокумента1С, Выборка.ТипКлючаДокумента1С);
	КонецЕсли;
	
КонецПроцедуры

// Читает из базы доп реквизиты документа учета
//
// Параметры:
//  ОписаниеДокумента - Структура - см. Новый_ДокументУчета()
// 
Процедура ДокументУчета_ПрочитатьДопРеквизиты(ОписаниеДокумента)
	
	ДопРеквизитыИБ = ДопРеквизиты_Прочитать(ОписаниеДокумента.Ссылка);
	
	Если ЗначениеЗаполнено(ДопРеквизитыИБ) Тогда
		ЗаполнитьЗначенияСвойств(ОписаниеДокумента.ДопРеквизиты, ДопРеквизитыИБ);
	КонецЕсли;
	
КонецПроцедуры

// Читает из базы все статусы и заполняет ими документ учета
//
// Параметры:
//  ОписаниеДокумента - Структура - см. Новый_ДокументУчета()
//
Процедура ДокументУчета_ПрочитатьСтатусы(ОписаниеДокумента)
	
	ВсеСтатусы = СтатусыДокументаУчета_Прочитать(ОписаниеДокумента.Ссылка);
	
	ЗаполнитьЗначенияСвойств(ОписаниеДокумента.Статусы, ВсеСтатусы);
	
КонецПроцедуры

Процедура ДокументУчета_ПрочитатьТоварыДокумента(ОписаниеДокумента)
	
	ОписаниеДокумента.ТоварыДокумента.Очистить();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ *
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки");
	Запрос.УстановитьПараметр("Ссылка", ОписаниеДокумента.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	КэшАналитики = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		Стр = ОписаниеДокумента.ТоварыДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Выборка);
		
		АналитикаНоменклатуры = АналитикаНоменклатуры1С(Выборка.КлючНоменклатуры1С, КэшАналитики);
		ЗаполнитьЗначенияСвойств(Стр, АналитикаНоменклатуры);
		
		Если ЗначениеЗаполнено(Стр.Количество)
			И ЗначениеЗаполнено(Стр.КоличествоУпаковок) Тогда
			Стр.Коэффициент = Стр.КоличествоУпаковок / Стр.Количество;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДокументУчета_ПрочитатьТоварыМаркировки(ОписаниеДокумента)
	
	ОписаниеДокумента.ТоварыМаркировки.Очистить();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Товар КАК Товар,
	|	Т.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	Т.НомерПартии КАК НомерПартии
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета.ТоварыМаркировки КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка",ОписаниеДокумента.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ОписаниеДокумента.ТоварыМаркировки.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

// Записывает документ учета в базу данных
//
// Параметры:
//  ОписаниеДокумента - Структура - см. Новый_ДокументУчета()
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_ДокументыУчета - записанный документ учета
//
Функция ДокументУчета_Записать(ОписаниеДокумента) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Если ЗначениеЗаполнено(ОписаниеДокумента.Ссылка) Тогда
			
			Если ОбъектВПроцессеОбновления(ОписаниеДокумента.Ссылка) Тогда
				ВызватьИсключение_ОбъектВПроцессеОбновления(ОписаниеДокумента.Ссылка);
			КонецЕсли;
			Ссылка = ОписаниеДокумента.Ссылка;
			ДокументУчета_Заблокировать(Ссылка);
			СтатусыДокументаУчета_Заблокировать(Ссылка);
			ОбъектДокумента = Ссылка.ПолучитьОбъект();
			
			Если СокрЛП(ОписаниеДокумента.ВерсияДанных) <> СокрЛП(ОбъектДокумента.ВерсияДанных) Тогда
				ВызватьИсключение НСтр("ru = 'Версия документа в базе изменилась, текущую версию записать невозможно!'");
			КонецЕсли;
			
			Если ОбъектДокумента.ПометкаУдаления Тогда
				ОбъектДокумента.ПометкаУдаления = Ложь;
			КонецЕсли;
			
		Иначе
			
			ОбъектДокумента = Справочники.КонтурМаркировка_ДокументыУчета.СоздатьЭлемент();
			
			Если ЗначениеЗаполнено(ОписаниеДокумента.Документ1С) Тогда
				
				УникальныйИдентификатор = ОписаниеДокумента.Документ1С.УникальныйИдентификатор();
				
				Ссылка = Справочники.КонтурМаркировка_ДокументыУчета.ПолучитьСсылку(УникальныйИдентификатор);
				ОбъектДокумента.УстановитьСсылкуНового(Ссылка);
				
			КонецЕсли;
			
		КонецЕсли;
		
		ДокументУчета_ДополнитьШапкуДокумента(ОписаниеДокумента);
		ДокументУчета_ДополнитьТоварыДокумента(ОписаниеДокумента);
		ЗаполнитьЗначенияСвойств(ОбъектДокумента, ОписаниеДокумента, , "Ссылка");
		ОбъектДокумента.Код = ОписаниеДокумента.Номер;
		
		Если Не ЗначениеЗаполнено(ОбъектДокумента.Дата) Тогда
			ОбъектДокумента.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ОбъектДокумента.Код) Тогда
			ДокументУчета_УстановитьНовыйКод(ОбъектДокумента);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ОбъектДокумента.Наименование) Тогда
			ДокументУчета_УстановитьНовоеНаименование(ОбъектДокумента);
		КонецЕсли;
		
		ОбъектДокумента.ТоварыДокумента.Загрузить(ОписаниеДокумента.ТоварыДокумента);
		ОбъектДокумента.ТоварыМаркировки.Загрузить(ОписаниеДокумента.ТоварыМаркировки);
		
		ОбъектДокумента.Записать();
		ОписаниеДокумента.Дата = ОбъектДокумента.Дата;
		ОписаниеДокумента.Номер = ОбъектДокумента.Код;
		ОписаниеДокумента.Ссылка = ОбъектДокумента.Ссылка;
		ОписаниеДокумента.ВерсияДанных = ОбъектДокумента.ВерсияДанных;
		ОписаниеДокумента.Наименование = ОбъектДокумента.Наименование;
		
		ДокументУчета_ЗаписатьСтатусы(ОписаниеДокумента);
		
		ДопРеквизиты_Записать(ОписаниеДокумента.Ссылка, ОписаниеДокумента.ДопРеквизиты);
		
		Метрики_ПриЗаписиДокументаУчета(ОписаниеДокумента);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат ОписаниеДокумента.Ссылка;
	
КонецФункции

Процедура ДокументУчета_Заблокировать(Ссылка) Экспорт
	
	Объект = "Справочник.КонтурМаркировка_ДокументыУчета";
	Значения = Новый Структура("Ссылка", Ссылка);
	ЗаблокироватьПоЗначениям(Объект, Значения);
	
КонецПроцедуры

Процедура ДокументУчета_УстановитьНовыйКод(ОбъектДокумента)
	
	ОбъектДокумента.УстановитьНовыйКод(ПрефиксНомера(ОбъектДокумента.Дата));
	
КонецПроцедуры

Процедура ДокументУчета_УстановитьНовоеНаименование(ОбъектДокумента)
	
	Настройка = НастройкиДокументовУчета_НайтиПоТипуДокумента(ОбъектДокумента.ТипДокумента);
	ОписаниеНастройки = НастройкиДокументаУчета_Прочитать(Настройка);
	
	ОбъектДокумента.Наименование = ПараметрыВСтроку("%1 %2 от %3"
	, ОписаниеНастройки.Наименование
	, ОбъектДокумента.Код
	, Формат(ОбъектДокумента.Дата, "ДФ=dd.MM.yyyy"));
	
КонецПроцедуры

Процедура ДокументУчета_ДополнитьШапкуДокумента(ОписаниеДокумента)
	
	ОписаниеДокумента.КлючДокумента1С = КлючОбъекта1С(ОписаниеДокумента.Документ1С);
	ОписаниеДокумента.ТипКлючаДокумента1С = ТипКлючаОбъекта1С(ОписаниеДокумента.Документ1С);
	
КонецПроцедуры

Процедура ДокументУчета_ДополнитьТоварыДокумента(ОписаниеДокумента)
	
	ТоварыДокумента = ОписаниеДокумента.ТоварыДокумента;
	
	Если Не ЗначениеЗаполнено(ТоварыДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоСтрок = ТоварыДокумента.Количество();
	ЕстьНомераСтрок = ЗначениеЗаполнено(ТоварыДокумента[0].НомерСтроки);
	ЕстьОтражениеВЭДО = ЗначениеЗаполнено(ТоварыДокумента[0].ОтражениеВЭДО);
	КэшКлючаНоменклатуры = Новый Соответствие;
	
	Для Сч = 1 По КоличествоСтрок Цикл
		
		Стр = ТоварыДокумента[Сч - 1];
		
		Если Не ЕстьНомераСтрок Тогда
			Стр.НомерСтроки = Сч;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.КлючНоменклатуры1С) Тогда
			Стр.КлючНоменклатуры1С = КлючНоменклатуры1С_Подобрать(Стр, КэшКлючаНоменклатуры);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.ПредставлениеСтроки) Тогда
			ДокументУчета_ЗаполнитьПредставлениеСтроки(Стр, КоличествоСтрок);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.ОтражениеВЭДО) Тогда
			ДокументУчета_ЗаполнитьПредставлениеСтроки(Стр, КоличествоСтрок);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЕстьОтражениеВЭДО Тогда
		ДокументУчета_ЗаполнитьПравилаОтраженияЭДО(ОписаниеДокумента);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДокументУчета_ЗаполнитьТоварыДокументаИзТаблицыКодов(ТоварыДокумента, ТаблицаКодов) Экспорт
	
	ТоварыДокумента.Очистить();
	
	Для Каждого Стр Из ТаблицаЗначений_Разбить(ТаблицаКодов, "КлючНоменклатуры1С") Цикл
		
		МассивСтрок = Стр.МассивСтрок;
		КлючНоменклатуры1С = Стр.КлючНоменклатуры1С;
		АналитикаНоменклатуры = АналитикаНоменклатуры1С(КлючНоменклатуры1С);
		
		СтрДок = ТоварыДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(СтрДок, МассивСтрок[0]);
		ЗаполнитьЗначенияСвойств(СтрДок, АналитикаНоменклатуры);
		СтрДок.КлючСтрокиДокумента = Новый УникальныйИдентификатор;
		
		Для каждого СтрКода Из МассивСтрок Цикл
			
			Количество = 1;
			Если ЗначениеЗаполнено(СтрКода.Количество) Тогда
				Количество = СтрКода.Количество;
			КонецЕсли;
			
			СтрДок.Количество = СтрДок.Количество + Количество;
			СтрДок.КоличествоУпаковок = СтрДок.КоличествоУпаковок + 1;
			СтрКода.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДокументУчета_ЗаполнитьТоварыМаркировкиИзТаблицыКодов(ОписаниеДокумента, ТаблицаКодов) Экспорт
	
	ТоварыДокумента = ОписаниеДокумента.ТоварыДокумента;
	ТоварыМаркировки = ОписаниеДокумента.ТоварыМаркировки;
	
	Для Каждого СтрДок Из ТоварыДокумента Цикл
		
		Отбор = Новый Структура("КлючСтрокиДокумента", СтрДок.КлючСтрокиДокумента);
		СтрокиКодов = ТаблицаКодов.НайтиСтроки(Отбор);
		Если Не ЗначениеЗаполнено(СтрокиКодов) Тогда
			Продолжить;
		КонецЕсли;
		
		// Удаляем старый набор товаров
		Для Сч = -(ТоварыМаркировки.Количество() - 1) По 0 Цикл
			СтрТов = ТоварыМаркировки.Получить(-Сч);
			Если СтрТов.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента Тогда
				ТоварыМаркировки.Удалить(-Сч);
			КонецЕсли;
		КонецЦикла;
		
		СтрокиТоваров = Новый Соответствие;
		
		Для Каждого СтрКода Из СтрокиКодов Цикл
			
			Если Не ЗначениеЗаполнено(СтрКода.Товар) Тогда
				Продолжить;
			КонецЕсли;
			
			СтрТов = СтрокиТоваров[СтрКода.Товар];
			Если СтрТов = Неопределено Тогда
				СтрТов = ТоварыМаркировки.Добавить();
				СтрТов.Товар = СтрКода.Товар;
				СтрТов.КлючСтрокиДокумента = СтрКода.КлючСтрокиДокумента;
				СтрокиТоваров.Вставить(СтрКода.Товар, СтрТов);
			КонецЕсли;
			
			СтрТов.КоличествоУпаковок = СтрТов.КоличествоУпаковок + 1;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДокументУчета_ЗаполнитьПредставлениеСтроки(СтрокаДокумента, КоличествоСтрок) Экспорт
	
	НомерСтроки = СтрокаДокумента.НомерСтроки;
	ПредставлениеНоменклатуры = ПредставлениеНоменклатуры1С(СтрокаДокумента);
	ПредставлениеСтроки = ПредставлениеСтрокиСНомером(НомерСтроки, ПредставлениеНоменклатуры, КоличествоСтрок);
	
	СтрокаДокумента.ПредставлениеСтроки = ПредставлениеСтроки;
	
КонецПроцедуры

Процедура ДокументУчета_ЗаполнитьПравилаОтраженияЭДО(ОписаниеДокумента) Экспорт
	
	ПравилаОтражения = Перечисление_ПравилаОтраженияВЭДО();
	ЭтоВнутреннееПеремещение = ДокументУчета_ТипуДокументаДоступнаРоль(
	ОписаниеДокумента.ТипДокумента, Перечисление_РолиДокументовУчета().ВнутреннееПеремещение);
	
	ПараметрыПроверки = Новый_ПараметрыПроверкиТоваровДокумента();
	ПараметрыПроверки.ЭтоВнутреннееПеремещение = ЭтоВнутреннееПеремещение;
	
	Для Каждого СтрДок Из ОписаниеДокумента.ТоварыДокумента Цикл
		
		СтрДок.ОтражениеВЭДО = ПравилаОтражения.ПУ;
		
		СтрТов = ОписаниеДокумента.ТоварыМаркировки.Найти(СтрДок.КлючСтрокиДокумента, "КлючСтрокиДокумента");
		Если СтрТов = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеТовара = Товар_Прочитать(СтрТов.Товар);
		Если Не Товар_ПоддерживаетОСУВДокументе(ОписаниеТовара, ПараметрыПроверки) Тогда
			Продолжить;
		КонецЕсли;
		
		ОтражениеВЭДО = МаркируемыеТоварныеГруппы_ОтражениеВЭДО(ОписаниеТовара.ВидПродукции);
		Если ЗначениеЗаполнено(ОтражениеВЭДО) Тогда
			СтрДок.ОтражениеВЭДО = ОтражениеВЭДО;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДокументУчета_ОбновитьПредставлениеКлючейНоменклатуры1С(ОписаниеДокумента) Экспорт
	
	ТоварыДокумента = ОписаниеДокумента.ТоварыДокумента;
	
	Для Каждого КлючНоменклатуры1С Из ТаблицаЗначений_ВыгрузитьКолонку(ТоварыДокумента, "КлючНоменклатуры1С", Истина) Цикл
		КлючНоменклатуры1С_ОбновитьПредставление(КлючНоменклатуры1С);
	КонецЦикла;
	
КонецПроцедуры

Функция Товар_ПоддерживаетОСУВДокументе(ОписаниеТовара, ПараметрыПроверки) Экспорт
	
	Результат = Истина;
	
	ВидПродукции = ОписаниеТовара.ВидПродукции;
	ВидыПродукции = Перечисление_ВидыПродукции();
	
	Если ВидПродукции = ВидыПродукции.Пиво Тогда
		Результат = ПараметрыПроверки.ЭтоВнутреннееПеремещение;
	КонецЕсли;
	
	Если ВидПродукции = ВидыПродукции.Антисептики Тогда
		Результат = Товар_ПоддерживаетОСУАнтисептики(ОписаниеТовара, ПараметрыПроверки.ОСУРазрешенАнтисептикиГруппаПлатности1);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Товар_ПоддерживаетОСУАнтисептики(ОписаниеТовара, ОСУРазрешенАнтисептикиГруппаПлатности1)
	
	Результат = Ложь;
	
	ГруппаПлатности_1 = 1;
	ГруппаПлатности_2 = 2;
	
	ГруппаПлатности_1_ПоддерживаетОСУ = ОписаниеТовара.ДопРеквизиты.ГруппаПлатности = ГруппаПлатности_1
	И ОСУРазрешенАнтисептикиГруппаПлатности1;
	ГруппаПлатности_2_ПоддерживаетОСУ = ОписаниеТовара.ДопРеквизиты.ГруппаПлатности = ГруппаПлатности_2
	И ФичаФлагВключен(Перечисление_ФичаФлаги().ПравилоОтраженияОСУАнтисептикиВолна1);
	
	Если ГруппаПлатности_1_ПоддерживаетОСУ Или ГруппаПлатности_2_ПоддерживаетОСУ Тогда
		
		ОтражениеВЭДО = МаркируемыеТоварныеГруппы_ОтражениеВЭДО(ОписаниеТовара.ВидПродукции);
		
		Результат = (ЗначениеЗаполнено(ОтражениеВЭДО)
		И ОтражениеВЭДО = Перечисление_ПравилаОтраженияВЭДО().ОСУ)
		Или Не ЗначениеЗаполнено(ОтражениеВЭДО);
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ПараметрыПроверкиТоваровДокумента()
	
	Результат = Новый Структура;
	Результат.Вставить("ЭтоВнутреннееПеремещение", Ложь);
	Результат.Вставить("ОСУРазрешенАнтисептикиГруппаПлатности1", Ложь);
	
	Возврат Результат;
	
КонецФункции

// Записывает все статусы документа учета
// Для операций, у которых нет специфических статусов
//
// Параметры:
//  ОписаниеДокумента - Структура - описание документа, см. Новый_ДокументУчета()
//
Процедура ДокументУчета_ЗаписатьСтатусы(ОписаниеДокумента) Экспорт
	
	ДокументУчета = ОписаниеДокумента.Ссылка;
	Документ1С = ДокументУчета_Документ1С(ДокументУчета);
	СтатусыДокумента = ОписаниеДокумента.Статусы;
	
	СтатусыДокумента.ТребуемоеДействие = ДокументУчета_НовоеТребуемоеДействие(ДокументУчета, СтатусыДокумента.ОсновнойСтатус);
	СтатусыДокументаУчета_Записать(ДокументУчета, СтатусыДокумента);
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("Документ1С", Документ1С);
	ПараметрыПМ.Вставить("ДокументУчета", ДокументУчета);
	ПараметрыПМ.Вставить("СтатусыДокумента", СтатусыДокумента);
	ПМ_ОбработатьСобытие("ПриЗаписиСтатусовДокументаУчета", ПараметрыПМ);
	
КонецПроцедуры

// Определяет наличие коэффициентов пересчета в документе учета
//
// Параметры:
//  ОписаниеДокумента - Структура - см. функцию Новый_ДокументУчета();
// 
// Возвращаемое значение:
//  Булево - Истина, если есть хотя бы один коэффициент пересчета отличный от 1;
//
Функция ДокументУчета_ЕстьКоэффициентыПересчета(ОписаниеДокумента)
	
	Для Каждого Стр Из ОписаниеДокумента.ТоварыДокумента Цикл
		Если ЗначениеЗаполнено(Стр.Коэффициент)
			И Стр.Коэффициент <> 1 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ДокументУчета_Документ1С(ДокументУчета, КэшРезультатов = Неопределено) Экспорт
	
	Если КэшРезультатов <> Неопределено Тогда
		Результат = КэшРезультатов[ДокументУчета];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Реквизиты = ЗначенияРеквизитовОбъекта_Марк(ДокументУчета, "КлючДокумента1С, ТипКлючаДокумента1С");
	Результат = МодульОбщегоНазначения().СсылкаПоИдентификатору(Реквизиты.КлючДокумента1С, Реквизиты.ТипКлючаДокумента1С);
	
	Если КэшРезультатов <> Неопределено И ЗначениеЗаполнено(Результат) Тогда
		КэшРезультатов.Вставить(ДокументУчета, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДокументУчета_ИзвлечьКодыИзАрхива(ДокументУчета) Экспорт
	
	КоличествоКодов = КодыДокументов_ОбщееКоличествоКодов(ДокументУчета);
	
	Если Не ЗначениеЗаполнено(КоличествоКодов) Тогда
		
		КоличествоКодовВАрхиве = ДопСвойство_Прочитать(ДокументУчета
		, Перечисление_ДопСвойства().КоличествоКодовВАрхиве);
		
		Если ЗначениеЗаполнено(КоличествоКодовВАрхиве) Тогда
			КодыДокументов_ИзвлечьИзФайла(ДокументУчета);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДокументУчета_ОбновитьСтатусыКодов(ДокументУчета) Экспорт
	
	Организация = ЗначениеРеквизитаОбъекта_Марк(ДокументУчета, "Организация");
	
	ТаблицаКодов = КодыДокументов_Прочитать(ДокументУчета);
	ТаблицаКодов_ДобавитьКлючиВсехВложенныхКодов(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	УдалосьОбновить = ТаблицаКодов_ОбновитьСтатусы(ТаблицаКодов, Организация);
	
	Если УдалосьОбновить Тогда
		ТаблицаКодов_ЗаписатьИнформациюИСтатусыКодов(ТаблицаКодов);
	КонецЕсли;
	
	Если УдалосьОбновить Тогда
		ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета);
	КонецЕсли;
	
	Возврат УдалосьОбновить;
	
КонецФункции

Процедура ДокументУчета_ПроверитьКоды(ДокументУчета) Экспорт
	
	ТаблицаКодов = КодыДокументов_Прочитать(ДокументУчета);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	ДокументУчета_ПроверитьРДКодов(ДокументУчета, ТаблицаКодов);
	
	ДокументУчета_ПроверитьКоды_ЗаписатьРезультат(ДокументУчета);
	
КонецПроцедуры

Процедура ДокументУчета_ПроверитьКоды_ЗаписатьРезультат(ДокументУчета)
	
	ТипыСтатусов = Перечисление_ТипыСтатусов();
	СтатусыПроверкиРД = Перечисление_СтатусыПроверкиРДКодовДокумента();
	СтатусыРезультата = Перечисление_СтатусыРезультатаПроверкиКодовДокумента();
	
	СтатусыПредупреждение = Новый Массив;
	СтатусыПредупреждение.Добавить(СтатусыПроверкиРД.ВсеКодыНедоступныДляОтгрузки);
	СтатусыПредупреждение.Добавить(СтатусыПроверкиРД.ЧастьКодовНедоступныДляОтгрузки);
	
	ЕстьСтатусыПредупреждение = Ложь;
	Для Каждого Элемент Из ДокументУчета_СтатусыПроверокКодов(ДокументУчета) Цикл
		ТипСтатуса = Элемент.Ключ;
		Статус = Элемент.Значение;
		Если МассивСодержитЗначение(СтатусыПредупреждение, Статус) Тогда
			ЕстьСтатусыПредупреждение = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьСтатусыПредупреждение Тогда
		СтатусПроверкиКодов = СтатусыРезультата.Предупреждение;
	Иначе
		СтатусПроверкиКодов = СтатусыРезультата.Успешно;
	КонецЕсли;
	
	СтатусыДокументаУчета_ЗаписатьСтатус(ДокументУчета, ТипыСтатусов.РезультатПроверкиКодовДокумента, СтатусПроверкиКодов);
	
КонецПроцедуры

Процедура ДокументУчета_ПроверитьРДКодов(ДокументУчета, ТаблицаКодов) Экспорт
	
	ТаблицаДляПроверкиРД = Новый_ТаблицаКодов();
	Для Каждого Элемент Из ОбщиеТипыУпаковокДляПроверкиРД() Цикл
		Отбор = Новый Структура("ОбщийТипУпаковки", Элемент);
		ТаблицаЗначений_Дополнить(ТаблицаДляПроверкиРД, ТаблицаКодов.Скопировать(Отбор));
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ТаблицаДляПроверкиРД) Тогда
		ДокументУчета_УдалитьРезультатыПроверкиКодов(ДокументУчета);
		Возврат;
	КонецЕсли;
	
	Организация = ЗначениеРеквизитаОбъекта_Марк(ДокументУчета, "Организация");
	
	ТаблицаДляПроверкиРД.Колонки.Добавить("РезультатПроверкиРД", ОписаниеТипа_Строка());
	УдалосьОбновить = ТаблицаКодов_ОбновитьСтатусы(ТаблицаДляПроверкиРД, Организация);
	
	Если УдалосьОбновить Тогда
		РезультатПроверкиРД = ДокументУчета_ПроверитьРДКодов_Отгрузка(ТаблицаДляПроверкиРД);
		ДокументУчета_ПроверитьРДКодов_ЗаписатьРезультат(ДокументУчета, РезультатПроверкиРД);
	КонецЕсли;
	
	Функциональность = Перечисление_ФункциональностьМодуля().ОбновлениеСтатусовПроверкиРД;
	СтекМетрик_ДобавитьФункциональность(Функциональность, ДокументУчета.Организация);
	
КонецПроцедуры

Функция ДокументУчета_ПроверитьРДКодов_Отгрузка(ТаблицаКодов)
	
	Результат = Новый Структура;
	Результат.Вставить("Статус");
	Результат.Вставить("КодыСОшибками", Новый Массив);
	
	РезультатыПроверкиРД = Перечисление_РезультатыПроверкиРДКода();
	СтатусыПроверкиРД = Перечисление_СтатусыПроверкиРДКодовДокумента();
	
	Для Каждого Стр Из ТаблицаЗначений_РазбитьНаТаблицы(ТаблицаКодов, "РезультатПроверкиРД") Цикл
		ЧастьТаблицы = Стр.ЧастьТаблицы;
		РезультатПроверкиРД = Стр.РезультатПроверкиРД;
		Если РезультатПроверкиРД = РезультатыПроверкиРД.Недоступен Тогда
			ДополнитьМассив(Результат.КодыСОшибками, ЧастьТаблицы.ВыгрузитьКолонку("КодМаркировки"));
		КонецЕсли;
	КонецЦикла;
	
	ВсегоКодов = ТаблицаКодов.Количество();
	КодовСОшибками = Результат.КодыСОшибками.Количество();
	Если КодовСОшибками = 0 Тогда
		Результат.Статус = СтатусыПроверкиРД.ВсеКодыДоступныДляОтгрузки;
	ИначеЕсли КодовСОшибками = ВсегоКодов Тогда
		Результат.Статус = СтатусыПроверкиРД.ВсеКодыНедоступныДляОтгрузки;
	Иначе
		Результат.Статус = СтатусыПроверкиРД.ЧастьКодовНедоступныДляОтгрузки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДокументУчета_ПроверитьРДКодов_ЗаписатьРезультат(ДокументУчета, РезультатПроверки)
	
	// Запись статуса проверки разрешительной документации
	ТипСтатуса = Перечисление_ТипыСтатусов().ПроверкаРДКодов;
	СтатусыДокументаУчета_ЗаписатьСтатус(ДокументУчета, ТипСтатуса, РезультатПроверки.Статус);
	
	// Запись кодов с ошибками разрешительной документации в файл
	ТипФайла = Перечисление_ТипыФайлов().РезультатПроверкиРД;
	Идентификатор = ДокументУчета.УникальныйИдентификатор();
	Если ЗначениеЗаполнено(РезультатПроверки.КодыСОшибками) Тогда
		Файл_Добавить(РезультатПроверки.КодыСОшибками, ТипФайла, ДокументУчета, Идентификатор);
	Иначе
		ДокументУчета_УдалитьФайлыРезультатаПроверкиРД(ДокументУчета);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДокументУчета_УдалитьРезультатыПроверкиКодов(ДокументУчета) Экспорт
	
	ДокументУчета_УдалитьСтатусыПроверокКодов(ДокументУчета);
	ДокументУчета_УдалитьФайлыРезультатаПроверкиРД(ДокументУчета);
	
КонецПроцедуры

Процедура ДокументУчета_УдалитьСтатусыПроверокКодов(ДокументУчета)
	
	СтатусыПроверок = ДокументУчета_СтатусыПроверокКодов(ДокументУчета);
	Для Каждого Элемент Из СтатусыПроверок Цикл
		Запись = РегистрыСведений.КонтурМаркировка_СтатусыДокументовУчета.СоздатьМенеджерЗаписи();
		Запись.ДокументУчета = ДокументУчета;
		Запись.ТипСтатуса = Элемент.Ключ;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Запись.Удалить();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ДокументУчета_СтатусыПроверокКодов(ДокументУчета)
	
	Результат = Новый Структура;
	
	ТипыСтатусовПроверок = Новый Массив;
	ТипыСтатусовПроверок.Добавить(Перечисление_ТипыСтатусов().РезультатПроверкиКодовДокумента);
	ТипыСтатусовПроверок.Добавить(Перечисление_ТипыСтатусов().ПроверкаРДКодов);
	
	Для Каждого Элемент Из СтатусыДокументаУчета_Прочитать(ДокументУчета) Цикл
		ТипСтатуса = Элемент.Ключ;
		Статус = Элемент.Значение;
		Если МассивСодержитЗначение(ТипыСтатусовПроверок, ТипСтатуса) Тогда
			Результат.Вставить(ТипСтатуса, Статус);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ДокументУчета_УдалитьФайлыРезультатаПроверкиРД(ДокументУчета)
	
	ТипФайла = Перечисление_ТипыФайлов().РезультатПроверкиРД;
	Файлы_Удалить(Файлы_Найти(ДокументУчета, ТипФайла));
	
КонецПроцедуры

Функция ДокументУчета_СписокОпераций(ДокументУчета
	, ТипыОпераций = Неопределено
	, СтатусыОпераций = Неопределено
	, ОперацииОснования = Неопределено
	, БезОперацииОснования = Ложь) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Операции.Ссылка КАК ОперацияСсылка,
	|	Операции.ТипОперации КАК ТипОперации,
	|	ЕСТЬNULL(СтатусыОпераций.Статус, &НовыйСтатус) КАК Статус
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Операции
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК СтатусыОпераций
	|		ПО Операции.Ссылка = СтатусыОпераций.Операция
	|			И (СтатусыОпераций.ТипСтатуса = &ОсновнойСтатус)
	|ГДЕ
	|	НЕ Операции.ПометкаУдаления
	|	И Операции.ДокументУчета = &ДокументУчета
	|	И &ТипыОпераций
	|	И &СтатусыОпераций
	|	И &ОперацииОснования
	|	И &БезОперацииОснования
	|
	|УПОРЯДОЧИТЬ ПО
	|	Операции.Дата";
	
	Если ЗначениеЗаполнено(ТипыОпераций) Тогда
		ТекстУсловия = "Операции.ТипОперации В(&ТипыОпераций)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипыОпераций", ТекстУсловия);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипыОпераций", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтатусыОпераций) Тогда
		ТекстУсловия = "ЕСТЬNULL(СтатусыОпераций.Статус, &НовыйСтатус) В(&СтатусыОпераций)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СтатусыОпераций", ТекстУсловия);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СтатусыОпераций", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОперацииОснования) Тогда
		ТекстУсловия = "Операции.ОперацияОснование В(&ОперацииОснования)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперацииОснования", ТекстУсловия);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперацииОснования", "ИСТИНА");
	КонецЕсли;
	
	Если БезОперацииОснования Тогда
		ТекстУсловия = "Операции.ОперацияОснование = ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_Операции.ПустаяСсылка)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&БезОперацииОснования", ТекстУсловия);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&БезОперацииОснования", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ОсновнойСтатус", "ОсновнойСтатус");
	Запрос.УстановитьПараметр("НовыйСтатус", Перечисление_СтатусыОпераций().Новый);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("ТипыОпераций", ТипыОпераций);
	Запрос.УстановитьПараметр("СтатусыОпераций", СтатусыОпераций);
	Запрос.УстановитьПараметр("ОперацииОснования", ОперацииОснования);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Процедура ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	СтатусыДокумента = СтатусыДокументаУчета_Прочитать(ДокументУчета);
	
	НовоеТребуемоеДействие = ДокументУчета_НовоеТребуемоеДействие(ДокументУчета, СтатусыДокумента.ОсновнойСтатус);
	
	Если СтатусыДокумента.ТребуемоеДействие <> НовоеТребуемоеДействие Тогда
		СтатусыДокумента.ТребуемоеДействие = НовоеТребуемоеДействие;
		СтатусыДокументаУчета_Записать(ДокументУчета, СтатусыДокумента);
	КонецЕсли;
	
КонецПроцедуры

Функция ДокументУчета_НовоеТребуемоеДействие(ДокументУчета, СтатусДокументаУчета) Экспорт
	
	СтатусыДокументаУчета = Перечисление_СтатусыДокументовУчета();
	
	Если СтатусДокументаУчета = СтатусыДокументаУчета.Новый Тогда
		
		Результат = ДокументУчета_НовоеТребуемоеДействие_ДляСтатусаНовый(ДокументУчета);
		
	ИначеЕсли СтатусДокументаУчета = СтатусыДокументаУчета.ВРаботе Тогда
		
		Результат = ДокументУчета_НовоеТребуемоеДействие_ДляСтатусаВРаботе(ДокументУчета);
		
	Иначе
		
		Результат = Перечисление_ТребуемыеДействияДокументовУчета().РаботаЗавершена;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_НовоеТребуемоеДействие_ДляСтатусаНовый(ДокументУчета)
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействияДокументовУчета();
	
	Результат = ТребуемыеДействия.НачатьРаботу;
	
	Если Не ДокументУчета_ТоварыМаркировкиПодобраны(ДокументУчета) Тогда
		Результат = ТребуемыеДействия.ПодобратьТовары;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_НовоеТребуемоеДействие_ДляСтатусаВРаботе(ДокументУчета)
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействияДокументовУчета();
	
	Если ДокументУчета_ЕстьОперацииСОшибками(ДокументУчета)
		Или ДокументУчета_ЕстьОшибкиТоваровМаркировки(ДокументУчета) Тогда
		
		Результат = ТребуемыеДействия.ИсправитьОшибку;
		
	ИначеЕсли ДокументУчета_ОжидаетНаполненияНаТСД(ДокументУчета) Тогда
		
		Результат = ТребуемыеДействия.ЗаполнитьНаТСД;
		
	ИначеЕсли Не ДокументУчета_ТоварыМаркировкиПодобраны(ДокументУчета) Тогда
		
		Результат = ТребуемыеДействия.ПодобратьТовары;
		
	ИначеЕсли Не ДокументУчета_ЕстьКоды(ДокументУчета) Тогда
		
		Результат = ТребуемыеДействия.НаполнитьКодами;
		
		
	ИначеЕсли ДокументУчета_ЕстьКодыДляПечати(ДокументУчета) Тогда
		
		Результат = ТребуемыеДействия.НапечататьЭтикетки;
		
	ИначеЕсли ДокументУчета_ЕстьКодыДляОтчетаОНанесении(ДокументУчета) Тогда
		
		Результат = ТребуемыеДействия.ОтчитатьсяОНанесении;
		
	ИначеЕсли ДокументУчета_ЕстьКодыДляВводаВОборот(ДокументУчета) Тогда
		
		Результат = ТребуемыеДействия.ВвестиВОборот;
		
	ИначеЕсли ДокументУчета_ВсеКодыВВеденыВОборот(ДокументУчета) Тогда
		
		Результат = ТребуемыеДействия.ЗавершитьРаботу;
		
	Иначе
		
		Результат = ТребуемыеДействия.ПродолжитьРаботу;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_ЕстьКоды(ДокументУчета)
	
	Результат = Ложь;
	
	Свойство = Перечисление_ДопСвойства().КоличествоКодовВАрхиве;
	КоличествоКодовВАрхиве = ДопСвойство_Прочитать(ДокументУчета, Свойство);
	
	Если КодыДокументов_ЕстьКоды(ДокументУчета) ИЛИ ЗначениеЗаполнено(КоличествоКодовВАрхиве) Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_ЕстьКодыДляПечати(ДокументУчета)
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КодыДокументов.КлючКода КАК КлючКода
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО КодыДокументов.КлючКода = СвязиКлючейКодов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО КодыДокументов.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (СвязиКлючейКодов.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	КодыДокументов.ДокументУчета = &ДокументУчета
	|	И КодыМаркировки.ФайлСПолнымКодом <> &ПустойФайл
	|	И ИнформацияОКодах.ДляНанесения
	|	И ИнформацияОКодах.ДатаПечати = ДАТАВРЕМЯ(1, 1, 1)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("ПустойФайл", Справочники.КонтурМаркировка_Файлы.ПустаяСсылка());
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ДокументУчета_ЕстьКодыДляВводаВОборот(ДокументУчета)
	
	СтатусыКодов = Перечисление_СтатусыКодов();
	ТипыОпераций = Перечисление_ТипыОпераций();
	ТипыСтатусов = Перечисление_ТипыСтатусов();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КодыДокументов.КлючКода КАК КлючКода
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО КодыДокументов.КлючКода = СвязиКлючейКодов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|		ПО (СвязиКлючейКодов.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (СвязиКлючейКодов.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ПО КодыДокументов.КлючКода = КодыОпераций.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции КАК ВводыВОборот
	|		ПО (КодыОпераций.Операция = ВводыВОборот.Ссылка)
	|			И (ВводыВОборот.ТипОперации = &ТипОперацииВводВОборот)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК СтатусыВводов
	|		ПО (ВводыВОборот.Ссылка = СтатусыВводов.Операция)
	|			И (СтатусыВводов.ТипСтатуса = &ОсновнойСтатус)
	|ГДЕ
	|	КодыДокументов.ДокументУчета = &ДокументУчета
	|	И СтатусыКодов.Статус = &СтатусКодаНанесен
	|	И ЕСТЬNULL(СтатусыВводов.Статус, &СтатусОперацииНовый) = &СтатусОперацииНовый";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("СтатусКодаНанесен", СтатусыКодов.Нанесен);
	Запрос.УстановитьПараметр("СтатусОперацииНовый", СтатусыОпераций.Новый);
	Запрос.УстановитьПараметр("ТипОперацииВводВОборот", ТипыОпераций.ВводВОборот);
	Запрос.УстановитьПараметр("ОсновнойСтатус", ТипыСтатусов.ОсновнойСтатус);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ДокументУчета_ЕстьКодыДляОтчетаОНанесении(ДокументУчета)
	
	СтатусыКодов = Перечисление_СтатусыКодов();
	ТипыОпераций = Перечисление_ТипыОпераций();
	ТипыСтатусов = Перечисление_ТипыСтатусов();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	
	ТипыОтчетовОНанесении = Новый Массив;
	ТипыОтчетовОНанесении.Добавить(ТипыОпераций.ОтчетОНанесении);
	ТипыОтчетовОНанесении.Добавить(ТипыОпераций.ОтчетОНанесенииНаТСД);
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КодыДокументов.КлючКода КАК КлючКода
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО КодыДокументов.КлючКода = СвязиКлючейКодов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|		ПО (СвязиКлючейКодов.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (СвязиКлючейКодов.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ПО КодыДокументов.КлючКода = КодыОпераций.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции КАК ОтчетыОНанесении
	|		ПО (КодыОпераций.Операция = ОтчетыОНанесении.Ссылка)
	|			И (ОтчетыОНанесении.ТипОперации В (&ТипыОтчетовОНанесении))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК СтатусыОтчетов
	|		ПО (ОтчетыОНанесении.Ссылка = СтатусыОтчетов.Операция)
	|			И (СтатусыОтчетов.ТипСтатуса = &ОсновнойСтатус)
	|ГДЕ
	|	КодыДокументов.ДокументУчета = &ДокументУчета
	|	И СтатусыКодов.Статус = &СтатусКодаВыпущен
	|	И ЕСТЬNULL(СтатусыОтчетов.Статус, &СтатусОперацииНовый) = &СтатусОперацииНовый";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("СтатусКодаВыпущен", СтатусыКодов.Выпущен);
	Запрос.УстановитьПараметр("СтатусОперацииНовый", СтатусыОпераций.Новый);
	Запрос.УстановитьПараметр("ТипыОтчетовОНанесении", ТипыОтчетовОНанесении);
	Запрос.УстановитьПараметр("ОсновнойСтатус", ТипыСтатусов.ОсновнойСтатус);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

