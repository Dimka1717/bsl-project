Функция Операция_КлючКода(Операция)
	
	Возврат ДопРеквизит_Прочитать(Операция, Перечисление_ИменаДопРеквизитов().КлючКода);
	
КонецФункции

Функция Операция_ПервоеДействие(ТипОперации)
	
	Действия = Перечисление_ТребуемыеДействия();
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	НачДействия = Новый Соответствие;
	НачДействия.Вставить(ТипыОпераций.ЗаказКодов,                        Действия.СоздатьПодчиненныеЗаказы);
	НачДействия.Вставить(ТипыОпераций.ВводВОборот,                       Действия.ПроверитьСтатусыКодовВводаВОборот);
	НачДействия.Вставить(ТипыОпераций.РегистрацияСтрокиВводаВОборот,     Действия.СоздатьВСервисеВводВОборот);
	НачДействия.Вставить(ТипыОпераций.РегистрацияАгрегатов,              ОчередьОбмена_Агрегация_БизнесПроцесс()[0]);
	НачДействия.Вставить(ТипыОпераций.РегистрацияОдногоАгрегатаВГИС,     Действия.СоздатьРегистрациюНаКаждыйАгрегат);
	НачДействия.Вставить(ТипыОпераций.РасформированиеАгрегатов,          Действия.СоздатьРасформированияАгрегатовВГИС);
	НачДействия.Вставить(ТипыОпераций.РасформированиеАгрегатаВГИС,       Действия.ПроверитьАгрегатДляРасформированияВГИС);
	НачДействия.Вставить(ТипыОпераций.СообщениеОбОтгрузке,               Действия.СоздатьВСервисеСообщениеОбОтгрузке);
	НачДействия.Вставить(ТипыОпераций.ВыводИзОборота,                    Действия.СоздатьВСервисеВыводИзОборота);
	НачДействия.Вставить(ТипыОпераций.ПодборКодовНаТСД,                  Действия.СоздатьВСервисеПодборКодовНаТСД);
	НачДействия.Вставить(ТипыОпераций.ПодборТоваровИКодовНаТСД,          Действия.СоздатьВСервисеПодборКодовНаТСД);
	НачДействия.Вставить(ТипыОпераций.НаполнениеАгрегатовНаТСД,          ОчередьОбмена_НаполнениеАгрегатовНаТСД_БизнесПроцесс()[0]);
	НачДействия.Вставить(ТипыОпераций.НаполнениеОдногоАгрегатаНаТСД,     Действия.ПроверитьВозможностьРегистрацииАгрегата);
	НачДействия.Вставить(ТипыОпераций.ОтчетОНанесенииНаТСД,              Действия.СоздатьВСервисеОтчетОНанесенииНаТСД);
	НачДействия.Вставить(ТипыОпераций.ОтчетОНанесении,                   Действия.СоздатьРегистрациюСтрокОтчетаОНанесении);
	НачДействия.Вставить(ТипыОпераций.РегистрацияСтрокиОтчетаОНанесении, Действия.СоздатьВСервисеОтчетОНанесении);
	НачДействия.Вставить(ТипыОпераций.ОтчетОВыбытии,                     Действия.СоздатьВСервисеВыбытиеКодов);
	НачДействия.Вставить(ТипыОпераций.ОтчетОВыбытииНаТСД,                Действия.СоздатьВСервисеОтчетОВыбытииНаТСД);
	НачДействия.Вставить(ТипыОпераций.Перемаркировка,                    ОчередьОбмена_Перемаркировка_БизнесПроцесс()[0]);
	НачДействия.Вставить(ТипыОпераций.РегистрацияСтрокиПеремаркировки,   Действия.СоздатьВСервисеПеремаркировку);
	НачДействия.Вставить(ТипыОпераций.НаполнениеНаборовНаТСД,            Действия.СоздатьВСервисеДокументФормированияНаборов);
	НачДействия.Вставить(ТипыОпераций.УведомлениеОПриемке,               ОчередьОбмена_УведомлениеОПриемке_БизнесПроцесс()[0]);
	НачДействия.Вставить(ТипыОпераций.РегистрацияКИГУ,                   ОчередьОбмена_РегистрацияКИГу_БизнесПроцесс()[0]);
	НачДействия.Вставить(ТипыОпераций.РегистрацияСтрокиКИГУ,             Действия.СоздатьВСервисеДокументРегистрацииКИГУ);
	НачДействия.Вставить(ТипыОпераций.ВозвратВОборот,                    ОчередьОбмена_ВозвратВОборот_БизнесПроцесс()[0]);
	НачДействия.Вставить(ТипыОпераций.ВозвратВОборотНаТСД,               ОчередьОбмена_ВозвратВОборотНаТСД_БизнесПроцесс()[0]);
	НачДействия.Вставить(ТипыОпераций.ОтменаВыводаИзОборота,             ОчередьОбмена_ОтменаВыводаИзОборота_БизнесПроцесс()[0]);
	НачДействия.Вставить(ТипыОпераций.ДобавлениеВАгрегат,                ОчередьОбмена_ТрансформацияАгрегатов_БизнесПроцесс()[0]);
	НачДействия.Вставить(ТипыОпераций.ИзъятиеИзАгрегата,                 ОчередьОбмена_ТрансформацияАгрегатов_БизнесПроцесс()[0]);
	НачДействия.Вставить(ТипыОпераций.ФормированиеАТК,                   ОчередьОбмена_ФормированиеАТК_БизнесПроцесс()[0]);
	НачДействия.Вставить(ТипыОпераций.РасформированиеАТК,                ОчередьОбмена_РасформированиеАТК_БизнесПроцесс()[0]);
	НачДействия.Вставить(ТипыОпераций.ДобавлениеВАТК,                    ОчередьОбмена_ТрансформацияАТК_БизнесПроцесс()[0]);
	НачДействия.Вставить(ТипыОпераций.ИзъятиеИзАТК,                      ОчередьОбмена_ТрансформацияАТК_БизнесПроцесс()[0]);
	НачДействия.Вставить(ТипыОпераций.РегистрацияНаборов,                ОчередьОбмена_РегистрацияНаборов_БизнесПроцесс()[0]);
	НачДействия.Вставить(ТипыОпераций.РегистрацияСтрокиНаборов,          Действия.СоздатьВСервисеДокументФормированияНаборов);
	НачДействия.Вставить(ТипыОпераций.КорректировкаСведенийОКодах,       ОчередьОбмена_КорректировкаСведенийОКодах_БизнесПроцесс()[0]);
	НачДействия.Вставить(ТипыОпераций.РасформированиеНаборов,            Действия.СоздатьРасформированияАгрегатовВГИС);
	НачДействия.Вставить(ТипыОпераций.РегистрацияСтрокиКорректировкиСведенийОКодах, Действия.СоздатьВСервисеКорректировкуСведенийОКодах);
	НачДействия.Вставить(ТипыОпераций.УведомлениеОСостоянииКодов,        ОчередьОбмена_УведомлениеОСостоянииКодов_БизнесПроцесс()[0]);
	НачДействия.Вставить(ТипыОпераций.РегистрацияСтрокиУведомленияОСостоянииКодов, Действия.СоздатьВСервисеУведомлениеОСостоянииКодов);
	
	Результат = НачДействия[ТипОперации];
	
	Возврат Результат;
	
КонецФункции

Функция Операция_ОбновитьСтатусыКодов(Операция, КромеКодовСоСтатусом = Неопределено) Экспорт
	
	Организация = ЗначениеРеквизитаОбъекта_Марк(Операция, "Организация");
	
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	ТаблицаКодов_ДобавитьКлючиВсехВложенныхКодов(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьИнформациюИСтатусыКодов(ТаблицаКодов);
	КодыМаркировки_Прочитать(ТаблицаКодов);
	
	Если ЗначениеЗаполнено(КромеКодовСоСтатусом) Тогда
		Для Сч = -(ТаблицаКодов.Количество() - 1) По 0 Цикл
			Если ТаблицаКодов[-Сч].Статус = КромеКодовСоСтатусом Тогда
				ТаблицаКодов.Удалить(-Сч);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	УдалосьОбновить = ТаблицаКодов_ОбновитьСтатусы(ТаблицаКодов, Организация);
	
	Если УдалосьОбновить Тогда
		ТаблицаКодов_ЗаписатьИнформациюИСтатусыКодов(ТаблицаКодов);
	КонецЕсли;
	
	Возврат УдалосьОбновить;
	
КонецФункции

Процедура Операция_ВосстановитьОбменСМоментаОшибки(Операция, ВосстановитьПодчиненныеОперации = Истина) Экспорт
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	ОписаниеЗадачи = Задача_Прочитать(Операция);
	Если ОписаниеЗадачи = Неопределено
		Или ОписаниеЗадачи.ТребуемоеДействие <> ТребуемыеДействия.ИсправитьОшибку Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Задача_ВосстановитьПредыдущееДействие(ОписаниеЗадачи);
		Если ВосстановитьПодчиненныеОперации Тогда
			Операция_ВосстановитьОбменПодчиненныхОперацийСМоментаОшибки(Операция);
		КонецЕсли;
		
		Пока ЗначениеЗаполнено(ОписаниеЗадачи.ОперацияОснование) Цикл
			ОписаниеЗадачи = Задача_Прочитать(ОписаниеЗадачи.ОперацияОснование);
			Если ОписаниеЗадачи = Неопределено
				Или ОписаниеЗадачи.ТребуемоеДействие <> ТребуемыеДействия.ИсправитьОшибку Тогда
				Прервать;
			КонецЕсли;
			Задача_ВосстановитьПредыдущееДействие(ОписаниеЗадачи);
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура Операция_ВосстановитьОбменПодчиненныхОперацийСМоментаОшибки(Операция)
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	ПодчиненныеОперации = Операция_НайтиПодчиненныеОперации(Операция);
	
	Для каждого ОписаниеЗадачи Из Задачи_Прочитать(ПодчиненныеОперации) Цикл
		Если ОписаниеЗадачи.ТребуемоеДействие = ТребуемыеДействия.ИсправитьОшибку Тогда
			Задача_ВосстановитьПредыдущееДействие(ОписаниеЗадачи);
			Операция_ВосстановитьОбменПодчиненныхОперацийСМоментаОшибки(ОписаниеЗадачи.Операция);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_РаспознатьКоды(Операция, ТаблицаКодов) Экспорт
	
	ОписаниеЗадачи = Задача_Прочитать(Операция);
	Если ОписаниеЗадачи.ТребуемоеДействие <> Перечисление_ТребуемыеДействия().РаспознатьКоды Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, ОписаниеЗадачи.Организация, Ложь) Тогда
		Задача_ЗаписатьКодыВРедакторДляРаспознавания(ОписаниеЗадачи, ТаблицаКодов);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ВернутьКодыНаТСД(Операция, Комментарий) Экспорт
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	ОписаниеЗадачи = Задача_Прочитать(Операция);
	
	Если ОписаниеЗадачи.ТипОперации = ТипыОпераций.ПодборКодовНаТСД
		Или ОписаниеЗадачи.ТипОперации = ТипыОпераций.ПодборТоваровИКодовНаТСД Тогда
		Задача_ВозвратКодовНаТСД_СоздатьВСервисе(ОписаниеЗадачи, Комментарий);
	КонецЕсли;
	
	Если ОписаниеЗадачи.ТипОперации = ТипыОпераций.НаполнениеНаборовНаТСД Тогда
		Задача_ФормированиеНаборов_ВернутьНаТСД(ОписаниеЗадачи, Комментарий);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_НазначитьНаДругоеУстройство(Операция) Экспорт
	
	ОписаниеЗадачи = Задача_Прочитать(Операция);
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если ОписаниеЗадачи.ТребуемоеДействие <> ТребуемыеДействия.ПроверитьГотовностьПодбораКодов Тогда
		Возврат;
	КонецЕсли;
	
	Задача_НазначитьДругоеУстройство_СоздатьВСервисе(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Операция_ПроверитьСтатусОбменаПодчиненныхОпераций(Операция)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		
		ОчередьОбмена_Заблокировать(Операция);
		
		СостояниеОбмена = Операция_СостояниеОбменаПодчиненныхОпераций(Операция);
		
		НовоеДействие = "";
		НовыйСтатусОперации = "";
		ОписаниеОшибки = "";
		Если СостояниеОбмена.ЕстьОшибки Тогда
			НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
			НовыйСтатусОперации = СтатусыОпераций.ОшибкаОбработки;
			ОписаниеОшибки = СоединитьСтроку(Задача_ОшибкиВПодчиненныхОперациях(Операция), Символы.ПС);
		Иначе
			ТипОперации = ЗначениеРеквизитаОбъекта_Марк(Операция, "ТипОперации");
			Если СостояниеОбмена.ОперацииЗавершены Тогда
				Если ТипОперации = ТипыОпераций.РегистрацияОдногоАгрегатаВГИС Тогда
					НовоеДействие = ТребуемыеДействия.ПроверитьВозможностьРегистрацииАгрегата;
					НовыйСтатусОперации = СтатусыОпераций.ПроверкаВозможностиРегистрацииАгрегата;
				Иначе
					НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
					НовыйСтатусОперации = СтатусыОпераций.ОперацияЗавершена;
				КонецЕсли;
			Иначе
				НовоеДействие = ТребуемыеДействия.ОжиданиеГотовности;
				НовыйСтатусОперации = СтатусыОпераций.ОжиданиеГотовности;
			КонецЕсли;
		КонецЕсли;
		
		ОписаниеЗадачи = Задача_Прочитать(Операция);
		ОписаниеЗадачи.НовоеДействие = НовоеДействие;
		ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатусОперации;
		ОписаниеЗадачи.ОписаниеОшибки = ОписаниеОшибки;
		Задача_Записать(ОписаниеЗадачи);
		
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция Операция_ВыводИзОборота_МожноУказатьЦену(ПричинаВывода)
	
	ПричиныВывода = Перечисление_ПричиныВыводаИзОборота();
	
	КлючКэш = "ПричиныВыводаИзОборотаМожноУказатьЦену";
	ДопустимыеПричины = Кэш_Прочитать(КлючКэш);
	Если ДопустимыеПричины = Неопределено Тогда
		ДопустимыеПричины = Новый Массив;
		ДопустимыеПричины.Добавить(ПричиныВывода.РозничнаяПродажа);
		ДопустимыеПричины.Добавить(ПричиныВывода.ДистанционныйСпособПродажи);
		ДопустимыеПричины.Добавить(ПричиныВывода.ПродажаЧерезВендинговыйАппарат);
		ДопустимыеПричины.Добавить(ПричиныВывода.Фасовка);
		ДопустимыеПричины.Добавить(ПричиныВывода.ПродажаПоОбразцам);
		ДопустимыеПричины.Добавить(ПричиныВывода.ДляСобственныхНужд);
		ДопустимыеПричины.Добавить(ПричиныВывода.ДляПроизводственныхЦелей);
		ДопустимыеПричины.Добавить(ПричиныВывода.БезвозмезднаяПередача);
		Кэш_Поместить(КлючКэш, ДопустимыеПричины);
	КонецЕсли;
	
	Результат = ДопустимыеПричины.Найти(ПричинаВывода) <> Неопределено;
	
	Возврат Результат;
	
КонецФункции

Функция Операция_СостояниеОбменаПодчиненныхОпераций(ОперацияОснование, ТипОпераций = "")
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Ошибки = Новый Массив;
	Ошибки.Добавить(ТребуемыеДействия.ИсправитьОшибку);
	Ошибки.Добавить(ТребуемыеДействия.РаспознатьКоды);
	Ошибки.Добавить(ТребуемыеДействия.УстранитьДубли);
	
	ЗавершенныеДействия = Новый Массив;
	ЗавершенныеДействия.Добавить(ТребуемыеДействия.ОперацияЗавершена);
	ЗавершенныеДействия.Добавить(ТребуемыеДействия.ПринятЧастично);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ОчередьОбмена.ТребуемоеДействие В (&Ошибки)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьОшибки,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА ОчередьОбмена.ТребуемоеДействие В (&ЗавершенныеДействия)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ОперацииЗавершены
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Операции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ОчередьОбмена КАК ОчередьОбмена
	|		ПО Операции.Ссылка = ОчередьОбмена.Операция
	|ГДЕ
	|	Операции.ОперацияОснование = &ОперацияОснование
	|	И &ТипОпераций";
	
	Если ЗначениеЗаполнено(ТипОпераций) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипОпераций", "Операции.ТипОперации = &ТипОпераций");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипОпераций", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТипОпераций", ТипОпераций);
	Запрос.УстановитьПараметр("ОперацияОснование", ОперацияОснование);
	Запрос.УстановитьПараметр("ЗавершенныеДействия", ЗавершенныеДействия);
	Запрос.УстановитьПараметр("Ошибки", Ошибки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Результат = Новый Структура;
	Результат.Вставить("ЕстьОшибки", Выборка.ЕстьОшибки = Истина);
	Результат.Вставить("ОперацииЗавершены", Выборка.ОперацииЗавершены = Истина);
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // СлужебныеМетоды

// #Область ВходящийУПД

// Находит или создает операцию Входящий УПД и сохраняет контент в файл
//
// Параметры:
//  Контент - Структура - см. ApiReconciliation;
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Операции
//
Функция Операция_ВходящийУПД_Сохранить(Контент, Организация)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ТипыФайлов = Перечисление_ТипыФайлов();
		ТипыОпераций = Перечисление_ТипыОпераций();
		
		СтатусОперации	 = СтатусВходящегоУПДПоСтатусуИзСервиса(Контент.status);
		ДатаДокумента	 = ДатаИзСтрокиXML(Контент.documentDate);
		ДатаСтатуса		 = ДатаИзСтрокиXML(Контент.documentStatusUpdatedDate);
		ИдентификаторДокумента = Контент.documentId;
		
		Операция = Операция_НайтиПоДопРеквизиту(ТипыОпераций.ВходящийУПД, "ИдентификаторДокумента", ИдентификаторДокумента);
		
		Если ЗначениеЗаполнено(Операция) Тогда
			ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
		Иначе
			ОписаниеОперации = Новый_Операция();
		КонецЕсли;
		
		ОписаниеОперации.Организация = Организация;
		ОписаниеОперации.ТипОперации = ТипыОпераций.ВходящийУПД;
		ОписаниеОперации.ДопРеквизиты.ДатаДокумента			 = ДатаДокумента;
		ОписаниеОперации.ДопРеквизиты.НомерДокумента		 = СвойствоСтруктуры(Контент, "documentNumber");
		ОписаниеОперации.ДопРеквизиты.КонтрагентНаименование = СвойствоСтруктуры(Контент, "senderName");
		ОписаниеОперации.ДопРеквизиты.КонтрагентИНН			 = СвойствоСтруктуры(Контент, "senderInn");
		ОписаниеОперации.ДопРеквизиты.ИдентификаторДокумента = ИдентификаторДокумента;
		ОписаниеОперации.ДопРеквизиты.СодержитОшибки = Операция_ВходящийУПД_СодержитОшибки(Контент);
		
		Результат = Операция_Записать(ОписаниеОперации);
		СтатусыОперации_ЗаписатьОсновнойСтатус(ОписаниеОперации.Ссылка, СтатусОперации, ДатаСтатуса);
		Файл_Добавить(Контент, ТипыФайлов.КонтентВходящегоУПД, ОписаниеОперации.Ссылка, ИдентификаторДокумента);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Проверяет наличие кодов маркировки в контенте входящего УПД
//
// Параметры:
//  Контент - Структура - контент входящего УПД;
// 
// Возвращаемое значение:
//  Булево - Истина, если контент содержит коды маркировки;
//
Функция Операция_ВходящийУПД_ЕстьКоды(Контент)
	
	Результат = Ложь;
	
	Для каждого position Из Контент.positions Цикл
		
		ЕстьКодыМаркировки = ЗначениеЗаполнено(position.codes);
		ПозицияСОтгрузкойПоОСУ = (position.Свойство("isVva") И position.isVva = Истина);
		
		Если ЕстьКодыМаркировки Или ПозицияСОтгрузкойПоОСУ Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Проверяет наличие ошибок в контенте входящего УПД
//
// Параметры:
//  Контент - Структура - контент входящего УПД;
// 
// Возвращаемое значение:
//  Булево - Истина, если контент содержит ошибки
//
Функция Операция_ВходящийУПД_СодержитОшибки(Контент)
	
	exceptCodes = СвойствоСтруктуры(Контент, "exceptCodes");
	Если ЗначениеЗаполнено(exceptCodes) тогда
		Возврат Истина;
	КонецЕсли;
	
	Для каждого Стр Из Контент.positions Цикл
		
		Для каждого code Из Стр.codes Цикл
			Для каждого check Из code.checks Цикл
				Если НРег(check.result) = НРег("Error") Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		isVva = СвойствоСтруктуры(Стр, "isVva", Ложь);
		Если isVva Тогда
			
			Для каждого check Из Стр.vva.gtinChecks Цикл
				Если НРег(check.result) = НРег("Error") Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЦикла;
			
			Для каждого code Из Стр.vva.codes Цикл
				Для каждого check Из code.checks Цикл
					Если НРег(check.result) = НРег("Error") Тогда
						Возврат Истина;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// #КонецОбласти // ВходящийУПД

// #Область УведомлениеОПриемке

// Возвращает контент уведомления о приемке.
// Если контента нет в базе, то выполняется запрос к сервису маркировки.
//
// Параметры:
//  ОписаниеОперации - Структура - см. функцию Новый_Операция();
// 
// Возвращаемое значение:
//  Структура - См. Маркировка_УведомлениеОПриемке_КонтентДокумента();
//
Функция Операция_УведомлениеОПриемке_КонтентДокумента(ОписаниеОперации)
	
	Организация = ОписаниеОперации.Организация;
	ИдентификаторДокумента = ОписаниеОперации.ДопРеквизиты.ИдентификаторДокумента;
	
	ОписаниеЗадачи = Новый_ЗадачаОбмена();
	ОписаниеЗадачи.Вставить("ИдентификаторДокумента", ИдентификаторДокумента);
	ОписаниеЗадачи.Вставить("Организация", Организация);
	ОписаниеЗадачи.Вставить("Склад", ОписаниеОперации.Склад);
	ОписаниеЗадачи.Вставить("Операция", ОписаниеОперации.Ссылка);
	
	Попытка
		Ответ = Маркировка_УведомлениеОПриемке_КонтентДокумента(ОписаниеЗадачи);
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Получение контента уведомления о приемке'");
		ТекстСообщения = НСтр("ru = 'Не удалось получить из сервиса контент уведомления о приемке'");
		ДопИнформация = Новый Структура;
		ДопИнформация.Вставить("Организация", Организация);
		ДопИнформация.Вставить("ИдентификаторДокумента", ИдентификаторДокумента);
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация, ТекстСообщения);
		ВызватьИсключение;
		
	КонецПопытки;
	
	Возврат Ответ.Результат;
	
КонецФункции

// Заполняет по контенту описание операции уведомление о приемке
//
// Параметры:
//  ОписаниеОперации - Структура - см. Новый_Операция();
//  Контент - Структура - см. Маркировка_УведомлениеОПриемке_КонтентДокумента();
//
Процедура Операция_УведомлениеОПриемке_ЗаполнитьПоКонтенту(ОписаниеОперации, Контент)
	
	ЭтоТрансгран = СвойствоСтруктуры(Контент, "acceptCrossborder", Ложь);
	СпособПриемки = СвойствоСтруктуры(Контент, "acceptanceDecision");
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	
	ДопРеквизиты.ТипИсходнойОтгрузки = ТипИсходнойОтгрузкиПоТипуИзСервиса(Контент.shipmentType);
	
	ДопРеквизиты.НомерДокумента = СвойствоСтруктуры(Контент, "releaseOrderNumber");
	ДопРеквизиты.ДатаДокумента = ДатаИзСтрокиXML(Контент.transferDate);
	ДопРеквизиты.ДатаПриемки = ДатаИзСтрокиXML(СвойствоСтруктуры(Контент, "acceptanceDate"));
	
	ДопРеквизиты.ДокументОснованиеНомер = СвойствоСтруктуры(Контент, "primaryDocumentNumber");
	ДопРеквизиты.ДокументОснованиеДата = ДатаИзСтрокиXML(Контент.primaryDocumentDate);
	
	ДопРеквизиты.СтатусПриемки = СтатусПриемкиПоСпособуИзСервиса(СпособПриемки);
	ДопРеквизиты.СтатусСверкиНаТСД = СтатусСверкиНаТСДПоСтатусуИзСервиса(Контент.reconciliationStatus);
	
	Если ЭтоТрансгран Тогда
		ДопРеквизиты.КонтрагентИНН = Контент.exporterVatPayerId;
		ДопРеквизиты.КонтрагентНаименование = Контент.exporterName;
	Иначе
		ДопРеквизиты.КонтрагентИНН = Контент.senderInn;
	КонецЕсли;
	
КонецПроцедуры

// Функция-конструктор результата функции Операция_УведомлениеОПриемке_СведенияОТоварах()
// 
// Возвращаемое значение:
//  Дерево значений - сведений о товарах документа уведомление о приемке:
//   * НаименованиеТовара - Строка - наименование товара;
//   * КодМаркировки - Строка - код маркировки;
//   * КодАгрегата - Строка - код агрегата (транспортной упаковки);
//   * Цена - Число - цена за единицу товара;
//   * СуммаНДС - Число - сумма НДС;
//   * GTIN - Строка - gtin;
//   * КоличествоКИ - Число - количество передаваемых КИ по данному коду товара;
//   * КоличествоКИГУ - Число - количество передаваемых КИГУ по данному коду товара;
//   * СтатусТовараНаСверке - Строка - статус товара на сверке;
//
Функция Новый_УведомлениеОПриемке_СведенияОТоварах()
	
	ОписаниеТипаЧисло = ОписаниеТипа_Число();
	ОписаниеТипаСтрока = ОписаниеТипа_Строка();
	ОписаниеТипаМассив = Новый ОписаниеТипов("Массив");
	
	Результат = Новый ДеревоЗначений;
	Результат.Колонки.Добавить("КодМаркировки", ОписаниеТипаСтрока);
	Результат.Колонки.Добавить("КодАгрегата", ОписаниеТипаСтрока);
	Результат.Колонки.Добавить("Цена", ОписаниеТипаЧисло);
	Результат.Колонки.Добавить("СуммаНДС", ОписаниеТипаЧисло);
	Результат.Колонки.Добавить("GTIN", ОписаниеТипаСтрока);
	Результат.Колонки.Добавить("КоличествоКИ", ОписаниеТипаЧисло);
	Результат.Колонки.Добавить("КоличествоКИГУ", ОписаниеТипаЧисло);
	Результат.Колонки.Добавить("СтатусТовараНаСверке", ОписаниеТипаСтрока);
	Результат.Колонки.Добавить("Принято");
	Результат.Колонки.Добавить("КартинкаПринято", ОписаниеТипаЧисло);
	Результат.Колонки.Добавить("КодТНВЭД", ОписаниеТипаСтрока);
	Результат.Колонки.Добавить("ИдентификаторВСД", ОписаниеТипаСтрока);
	Результат.Колонки.Добавить("Товар", ОписаниеТипа_Товар());
	Результат.Колонки.Добавить("Количество", ОписаниеТипаЧисло);
	
	Возврат Результат;
	
КонецФункции

// Сохраняет дерево значений "Сведений о товарах" уведомления о приемке в файлы
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция обновления статусов;
//  ДеревоСведенийОТоварах - ДеревоЗначений - дерево сведений о товарах уведомления о приемке;
//
Процедура Операция_УведомлениеОПриемке_СведенияОТоварах_СохранитьВФайл(Операция, ДеревоСведенийОТоварах) Экспорт
	
	Если Не ЗначениеЗаполнено(Операция) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = ДопРеквизит_Прочитать(Операция, "ИдентификаторДокумента");
	ТипФайла = Перечисление_ТипыФайлов().ДеревоСведенийОТоварах;
	
	Файл_Добавить(ДеревоСведенийОТоварах, ТипФайла, Операция, ИдентификаторДокумента);
	
КонецПроцедуры

// Возвращает заполненную по контенту таблицу сведений о товарах уведомления о приемке
//
// Параметры:
//  ОписаниеОперации - Структура - см. функцию Новый_Операция();
// 
// Возвращаемое значение:
//  ТаблицаЗначений - сведения о товарах документа,
//                    см. функцию Новый_ТаблицаСведенийОТоварахУведомленияОПриемке();
//
Функция Операция_УведомлениеОПриемке_СведенияОТоварах(ОписаниеОперации) Экспорт
	
	СведенияОТоварах = Неопределено;
	Операция = ОписаниеОперации.Ссылка;
	Организация = ОписаниеОперации.Организация;
	ТипИсходнойОтгрузки = ОписаниеОперации.ДопРеквизиты.ТипИсходнойОтгрузки;
	ИдентификаторДокумента = ОписаниеОперации.ДопРеквизиты.ИдентификаторДокумента;
	
	ТипФайла = Перечисление_ТипыФайлов().ДеревоСведенийОТоварах;
	Файл = Файл_НайтиПоИдентификатору(Операция, ИдентификаторДокумента, ТипФайла);
	Если ЗначениеЗаполнено(Файл) Тогда
		ОписаниеФайла = Файл_Прочитать(Файл);
		СведенияОТоварах = ОписаниеФайла.ДанныеФайла;
	КонецЕсли;
	
	Если СведенияОТоварах = Неопределено
		Или Не ЗначениеЗаполнено(ТипИсходнойОтгрузки) Тогда // Для совместимости с 2.19.3
		Контент = Операция_УведомлениеОПриемке_КонтентДокумента(ОписаниеОперации);
		Если ЗначениеЗаполнено(Контент) Тогда
			Операция_УведомлениеОПриемке_ЗаполнитьПоКонтенту(ОписаниеОперации, Контент);
			Операция_Записать(ОписаниеОперации);
			СведенияОТоварах = Операция_УведомлениеОПриемке_СведенияОТоварахИзКонтента(Контент, ОписаниеОперации);
			Операция_УведомлениеОПриемке_СведенияОТоварах_СохранитьВФайл(Операция, СведенияОТоварах);
		КонецЕсли;
	КонецЕсли;
	
	Возврат СведенияОТоварах;
	
КонецФункции

Функция Операция_УведомлениеОПриемке_СведенияОТоварахИзКонтента(Контент, ОписаниеОперации)
	
	Результат = Новый_УведомлениеОПриемке_СведенияОТоварах();
	
	products = СвойствоСтруктуры(Контент, "products");
	Если Не ЗначениеЗаполнено(products) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Организация = ОписаниеОперации.Организация;
	ТипИсходнойОтгрузки = ОписаниеОперации.ДопРеквизиты.ТипИсходнойОтгрузки;
	
	Если ТипИсходнойОтгрузки = Перечисление_ТипыИсходныхОтгрузок().ТрансграничнаяОтгрузкаОСУ Тогда
		Для Каждого productInfo Из products Цикл
			Операция_УведомлениеОПриемке_СведенияОТоварах_ДобавитьСтрокуОСУ(Результат, productInfo, Организация);
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого productInfo Из products Цикл
		Операция_УведомлениеОПриемке_СведенияОТоварах_ДобавитьСтроки(Результат, productInfo, Организация);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура Операция_УведомлениеОПриемке_СведенияОТоварах_ДобавитьСтроки(ДеревоТоваров, СтрКонтента, Организация
	, МассивРодителей = Неопределено)
	
	GTIN = СвойствоСтруктуры(СтрКонтента, "gtin");
	КодМаркировки = СвойствоСтруктуры(СтрКонтента, "uitCode");
	КодАгрегата = СвойствоСтруктуры(СтрКонтента, "uituCode");
	КоличествоКИ = СвойствоСтруктуры(СтрКонтента, "cisQuantity");
	КоличествоКИГУ = СвойствоСтруктуры(СтрКонтента, "groupQuantity");
	ВложенныеСтроки = СвойствоСтруктуры(СтрКонтента, "children");
	
	Если МассивРодителей = Неопределено Тогда
		МассивРодителей = Новый Массив;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КодМаркировки) Тогда
		
		Если Не ЗначениеЗаполнено(GTIN) Тогда
			GTIN = GTINИзКодаМаркировки(КодМаркировки);
		КонецЕсли;
		
		СтрТовара = ДеревоТоваров.Строки.Найти(GTIN, "GTIN");
		Если СтрТовара = Неопределено Тогда
			СтрТовара = Операция_УведомлениеОПриемке_СведенияОТоварах_ДобавитьСтрокуТовара(ДеревоТоваров, СтрКонтента, GTIN, Организация);
		КонецЕсли;
		
		СтрРодитель = СтрТовара;
		Для Каждого СтрКонтентаРодителя Из МассивРодителей Цикл
			// Находим или добавляем агрегаты верхнего уровня
			КодАгрегатаРодителя = СвойствоСтруктуры(СтрКонтентаРодителя, "uituCode");
			Если ЗначениеЗаполнено(КодАгрегатаРодителя) Тогда
				СтрАгрегата = СтрРодитель.Строки.Найти(КодАгрегатаРодителя, "КодАгрегата", Истина);
				Если СтрАгрегата = Неопределено Тогда
					СтрАгрегата = СтрРодитель.Строки.Добавить();
					Операция_УведомлениеОПриемке_СведенияОТоварах_ЗаполнитьСтрокуАгрегата(
					СтрАгрегата, СтрКонтентаРодителя, КодАгрегатаРодителя);
				КонецЕсли;
				СтрРодитель = СтрАгрегата;
			КонецЕсли;
		КонецЦикла;
		
		СтрКода = СтрРодитель.Строки.Добавить();
		
		Операция_УведомлениеОПриемке_СведенияОТоварах_ЗаполнитьСтрокуКода(СтрКода, СтрКонтента, КодМаркировки);
		
	ИначеЕсли ЗначениеЗаполнено(ВложенныеСтроки) Тогда
		
		// Добавляем вложенные коды и все агрегаты, в которые они входят
		МассивРодителей.Добавить(СтрКонтента);
		Для Каждого ВложеннаяСтрКонтента Из ВложенныеСтроки Цикл
			Операция_УведомлениеОПриемке_СведенияОТоварах_ДобавитьСтроки(ДеревоТоваров, ВложеннаяСтрКонтента, Организация, МассивРодителей);
		КонецЦикла;
		
	ИначеЕсли ЗначениеЗаполнено(КодАгрегата) Тогда // Агрегат без вложенных кодов
		
		СтрРодитель = ДеревоТоваров;
		Для Каждого СтрКонтентаРодителя Из МассивРодителей Цикл
			// Находим или добавляем агрегаты верхнего уровня
			КодАгрегатаРодителя = СвойствоСтруктуры(СтрКонтентаРодителя, "uituCode");
			Если ЗначениеЗаполнено(КодАгрегатаРодителя) Тогда
				СтрАгрегата = СтрРодитель.Строки.Найти(КодАгрегатаРодителя, "КодАгрегата", Истина);
				Если СтрАгрегата = Неопределено Тогда
					СтрАгрегата = СтрРодитель.Строки.Добавить();
					Операция_УведомлениеОПриемке_СведенияОТоварах_ЗаполнитьСтрокуАгрегата(
					СтрАгрегата, СтрКонтентаРодителя, КодАгрегатаРодителя);
				КонецЕсли;
				СтрРодитель = СтрАгрегата;
			КонецЕсли;
		КонецЦикла;
		
		СтрАгрегата = СтрРодитель.Строки.Добавить();
		Операция_УведомлениеОПриемке_СведенияОТоварах_ЗаполнитьСтрокуАгрегата(СтрАгрегата, СтрКонтента, КодАгрегата);
		
	Иначе
		
		// Строка не содержит коды
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_УведомлениеОПриемке_СведенияОТоварах_ДобавитьСтрокуОСУ(ДеревоТоваров, СтрКонтента, Организация)
	
	GTIN = СвойствоСтруктуры(СтрКонтента, "gtin");
	checkStatus = СвойствоСтруктуры(СтрКонтента, "checkStatus");
	weightGrams = СвойствоСтруктуры(СтрКонтента, "weightGrams");
	
	СтрТовара = ДеревоТоваров.Строки.Добавить();
	СтрКонтента.Свойство("productCost",          СтрТовара.Цена);
	СтрКонтента.Свойство("productTax",           СтрТовара.СуммаНДС);
	СтрКонтента.Свойство("accompanyingDocument", СтрТовара.ИдентификаторВСД);
	СтрКонтента.Свойство("tnvedCode",            СтрТовара.КодТНВЭД);
	СтрКонтента.Свойство("cisQuantity",          СтрТовара.КоличествоКИ);
	СтрКонтента.Свойство("groupQuantity",        СтрТовара.КоличествоКИГУ);
	
	СтрТовара.GTIN = GTIN;
	СтрТовара.Цена = СтрТовара.Цена / 100;
	СтрТовара.СуммаНДС = СтрТовара.СуммаНДС / 100;
	СтрТовара.СтатусТовараНаСверке = СтатусТовараНаСверкеПоСтатусуИзСервиса(checkStatus);
	
	Если ЗначениеЗаполнено(weightGrams) Тогда
		ВесВКилограммах = weightGrams / ГраммВКилограмме();
		СтрТовара.Количество = ВесВКилограммах;
	КонецЕсли;
	
	Операция_УведомлениеОПриемке_СведенияОТоварах_ЗаполнитьСтатусПриемки(СтрТовара, СтрКонтента);
	Операция_УведомлениеОПриемке_СведенияОТоварах_ЗаполнитьТоварВСтроке(СтрТовара, СтрКонтента, Организация);
	
	Если Не ЗначениеЗаполнено(СтрТовара.КодТНВЭД) Тогда
		СтрТовара.КодТНВЭД = СтрТовара.Товар.КодТНВЭД;
	КонецЕсли
	
КонецПроцедуры

Функция Операция_УведомлениеОПриемке_СведенияОТоварах_ДобавитьСтрокуТовара(ДеревоТоваров, СтрКонтента, GTIN, Организация)
	
	СтрТовара = ДеревоТоваров.Строки.Добавить();
	СтрКонтента.Свойство("cisQuantity",          СтрТовара.КоличествоКИ);
	СтрКонтента.Свойство("groupQuantity",        СтрТовара.КоличествоКИГУ);
	СтрКонтента.Свойство("productCost",          СтрТовара.Цена);
	СтрКонтента.Свойство("productTax",           СтрТовара.СуммаНДС);
	СтрКонтента.Свойство("accompanyingDocument", СтрТовара.ИдентификаторВСД);
	СтрКонтента.Свойство("tnvedCode",            СтрТовара.КодТНВЭД);
	
	СтрТовара.GTIN = GTIN;
	СтрТовара.Цена = СтрТовара.Цена / 100;
	СтрТовара.СуммаНДС = СтрТовара.СуммаНДС / 100;
	
	Операция_УведомлениеОПриемке_СведенияОТоварах_ЗаполнитьТоварВСтроке(СтрТовара, СтрКонтента, Организация);
	
	Если Не ЗначениеЗаполнено(СтрТовара.КодТНВЭД) Тогда
		СтрТовара.КодТНВЭД = СтрТовара.Товар.КодТНВЭД;
	КонецЕсли;
	
	Возврат СтрТовара;
	
КонецФункции

Процедура Операция_УведомлениеОПриемке_СведенияОТоварах_ЗаполнитьСтрокуАгрегата(СтрАгрегата, СтрКонтента, КодАгрегата)
	
	checkStatus = СвойствоСтруктуры(СтрКонтента, "checkStatus");
	
	СтрАгрегата.КодАгрегата = КодАгрегата;
	СтрАгрегата.СтатусТовараНаСверке = СтатусТовараНаСверкеПоСтатусуИзСервиса(checkStatus);
	
	Операция_УведомлениеОПриемке_СведенияОТоварах_ЗаполнитьСтатусПриемки(СтрАгрегата, СтрКонтента);
	
КонецПроцедуры

Процедура Операция_УведомлениеОПриемке_СведенияОТоварах_ЗаполнитьСтрокуКода(СтрКода, СтрКонтента, КодМаркировки)
	
	checkStatus = СвойствоСтруктуры(СтрКонтента, "checkStatus");
	
	СтрКода.КодМаркировки = ЗаменитьРазделительGS1(КодМаркировки);
	СтрКода.Цена = СвойствоСтруктуры(СтрКонтента, "productCost", 0) / 100;
	СтрКода.СуммаНДС = СвойствоСтруктуры(СтрКонтента, "productTax", 0) / 100;
	СтрКода.СтатусТовараНаСверке = СтатусТовараНаСверкеПоСтатусуИзСервиса(checkStatus);
	
	Операция_УведомлениеОПриемке_СведенияОТоварах_ЗаполнитьСтатусПриемки(СтрКода, СтрКонтента);
	
КонецПроцедуры

Процедура Операция_УведомлениеОПриемке_СведенияОТоварах_ЗаполнитьТоварВСтроке(СтрТовара, СтрокаКонтента, Организация)
	
	GTIN = СтрТовара.GTIN;
	Товар = Товар_Найти(GTIN);
	
	Если Не ЗначениеЗаполнено(Товар) Тогда
		
		Товары_СоздатьОбновитьПоИнформацииИзСервиса(ЗначениеВМассиве(GTIN), Истина);
		
		Товар = Товар_Найти(GTIN);
		
		Если Не ЗначениеЗаполнено(Товар) Тогда
			ОписаниеТовара = Новый_Товар();
			ОписаниеТовара.GTIN = GTIN;
			ОписаниеТовара.КодТНВЭД = СтрТовара.КодТНВЭД;
			ОписаниеТовара.Наименование = СвойствоСтруктуры(СтрокаКонтента, "productName");
			Товар_Записать(ОписаниеТовара);
			Товар = ОписаниеТовара.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	СтрТовара.Товар = Товар;
	
КонецПроцедуры

Процедура Операция_УведомлениеОПриемке_СведенияОТоварах_ЗаполнитьСтатусПриемки(СтрокаДЗ, СтрокаКонтента)
	
	accepted = СвойствоСтруктуры(СтрокаКонтента, "accepted");
	
	Если ЗначениеЗаполнено(accepted) Тогда
		СтрокаДЗ.Принято = (НРег(accepted) = НРег("true"));
	КонецЕсли;
	
	Если СтрокаДЗ.Принято = Истина Тогда
		СтрокаДЗ.КартинкаПринято = 5;
	ИначеЕсли СтрокаДЗ.Принято = Ложь Тогда
		СтрокаДЗ.КартинкаПринято = 3;
	Иначе
		СтрокаДЗ.КартинкаПринято = 0;
	КонецЕсли;
	
КонецПроцедуры

