	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ КлючиАгрегатов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таб.КлючКода КАК КлючКода,
	|	Таб.КлючАгрегата КАК КлючАгрегата,
	|	Таб.МожноУдалить КАК МожноУдалить
	|ПОМЕСТИТЬ Итог1
	|ИЗ
	|	Таб1 КАК Таб");
	Запрос.УстановитьПараметр("ПустойКлюч", ПустойУникальныйИдентификатор());
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Агрегаты.КлючКода КАК КлючКода,
	|	Агрегаты.КлючАгрегата КАК КлючАгрегата,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА Агрегаты.МожноУдалить = ЛОЖЬ
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ Таб.МожноУдалить
	|		КОНЕЦ) КАК МожноУдалить
	|ПОМЕСТИТЬ Таб2
	|ИЗ
	|	Таб1 КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаКодов КАК Агрегаты
	|		ПО Таб.КлючАгрегата = Агрегаты.КлючКода
	|
	|СГРУППИРОВАТЬ ПО
	|	Агрегаты.КлючКода,
	|	Агрегаты.КлючАгрегата
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючАгрегата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.КлючАгрегата КАК КлючАгрегата,
	|	МИНИМУМ(Т.МожноУдалить) КАК МожноУдалить
	|ПОМЕСТИТЬ Итог2
	|ИЗ
	|	(ВЫБРАТЬ
	|		Т.КлючКода КАК КлючКода,
	|		Т.КлючАгрегата КАК КлючАгрегата,
	|		Т.МожноУдалить КАК МожноУдалить
	|	ИЗ
	|		Итог1 КАК Т
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Т.КлючКода,
	|		Т.КлючАгрегата,
	|		Т.МожноУдалить
	|	ИЗ
	|		Таб2 КАК Т) КАК Т
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.КлючКода,
	|	Т.КлючАгрегата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Таб1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Итог1";
	
	Пока Истина Цикл
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
		Выборка = Запрос.ВыполнитьПакет().Получить(0).Выбрать();
		Выборка.Следующий();
		Если Выборка.Количество = 0 Тогда
			Прервать;
		КонецЕсли;
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Таб1", "Таб2");
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Итог1", "Итог2");
	КонецЦикла;
	
	ЕстьИтог1 = Найти(ТекстЗапроса, "ПОМЕСТИТЬ Итог1") > 0;
	
	ТекстЗапроса =
	"УНИЧТОЖИТЬ ТаблицаКодов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.КлючАгрегата КАК КлючАгрегата,
	|	Т.МожноУдалить КАК МожноУдалить
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	Итог2 КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Т.КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Таб2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Итог2";
	
	Если ЕстьИтог1 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Итог2", "Итог1");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Таб2", "Таб1");
