// Опеределяет причину выбытия кодов в терминах сервиса
//
// Параметры:
//  ПричинаВыбытия - Строка - см. Перечисление_ПричиныВыбытияКодов()
// 
// Возвращаемое значение:
//  Строка - тип оплаты в терминах сервиса
//
Функция ПричинаВыбытияВСервисе(ПричинаВыбытия)
	
	Причины = Перечисление_ПричиныВыбытияКодов();
	
	Если ПричинаВыбытия = Причины.Брак Тогда
		
		Результат = "Defect";
		
	ИначеЕсли ПричинаВыбытия = Причины.ИстекСрокГодности Тогда
		
		Результат = "Expiry";
		
	ИначеЕсли ПричинаВыбытия = Причины.ЛабораторныеОбразцы Тогда
		
		Результат = "QaSamples";
		
	ИначеЕсли ПричинаВыбытия = Причины.ОтзывСРынка Тогда
		
		Результат = "ProductRecall";
		
	ИначеЕсли ПричинаВыбытия = Причины.Рекламации Тогда
		
		Результат = "Complaints";
		
	ИначеЕсли ПричинаВыбытия = Причины.ТестированиеПродукта Тогда
		
		Результат = "ProductTesting";
		
	ИначеЕсли ПричинаВыбытия = Причины.ДемонстрационныеОбразцы Тогда
		
		Результат = "DemoSamples";
		
	ИначеЕсли ПричинаВыбытия = Причины.УтратаТоваров Тогда
		
		Результат = "DamageLoss";
		
	ИначеЕсли ПричинаВыбытия = Причины.УничтожениеТоваров Тогда
		
		Результат = "Destruction";
		
	ИначеЕсли ПричинаВыбытия = Причины.ЛиквидацияПредприятия Тогда
		
		Результат = "Liquidation";
		
	ИначеЕсли ПричинаВыбытия = Причины.КонфискацияТоваров Тогда
		
		Результат = "Confiscation";
		
	ИначеЕсли ПричинаВыбытия = Причины.ДругиеПричины Тогда
		
		Результат = "Other";
		
	Иначе
		
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестная причина выбытия: %1'"), ПричинаВыбытия);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Опеределяет причину выбытия кодов в терминах сервиса
//
// Параметры:
//  ПричинаВыбытия - Строка - см. Перечисление_ПричиныВыбытияКодов()
// 
// Возвращаемое значение:
//  Строка - тип оплаты в терминах сервиса
//
Функция ПричинаПеремаркировкиВСервисе(ПричинаПеремаркировки)
	
	Причины = Перечисление_ПричиныПеремаркировки();
	
	Если ПричинаПеремаркировки = Причины.ИспорченоЛибоУтеряноСИСКМ Тогда
		
		Результат = "KmSpoiled";
		
	//ИначеЕсли ПричинаПеремаркировки = Причины.ВыявленыОшибкиОписанияТовара Тогда
	//	
	//	Результат = "DescriptionErrors";
	//	
	ИначеЕсли ПричинаПеремаркировки = Причины.ВозвратОтРозничногоПокупателя Тогда
		
		Результат = "RetailReturn";
		
	ИначеЕсли ПричинаПеремаркировки = Причины.ВозвратВСлучаеДистанционнойПродажи Тогда
		
		Результат = "RemoteSaleReturn";
		
	ИначеЕсли ПричинаПеремаркировки = Причины.ВозвратОтКонечногоПокупателяЮрЛицаИП Тогда
		
		Результат = "LegalReturn";
		
	ИначеЕсли ПричинаПеремаркировки = Причины.РеализацияТоваровПриобретённыхВИныхЦелях Тогда
		
		Результат = "InternalReturn";
		
	ИначеЕсли ПричинаПеремаркировки = Причины.ВозвратРанееЭкспортированногоВЕАЭС Тогда
		
		Результат = "EecExportReturn";
		
	Иначе
		
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестная причина перемаркировки: %1'"), ПричинаПеремаркировки);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Опеределяет способ выпуска товаров в терминах сервиса
//
// Параметры:
//  СпособВыпускаТоваров - Строка - см. Перечисление_СпособыВыпускаТоваров()
// 
// Возвращаемое значение:
//  Строка - способ выпуска товаров в терминах сервиса
//
Функция СпособВыпускаТоваровВСервисе(СпособВыпускаТоваров)
	
	СпособыВыпускаТоваров = Перечисление_СпособыВыпускаТоваров();
	
	Если СпособВыпускаТоваров = СпособыВыпускаТоваров.Остатки Тогда
		Результат = "remains";
	ИначеЕсли СпособВыпускаТоваров = СпособыВыпускаТоваров.Импорт Тогда
		Результат = "import";
	ИначеЕсли СпособВыпускаТоваров = СпособыВыпускаТоваров.ПроизводствоРФ Тогда
		Результат = "production";
	ИначеЕсли СпособВыпускаТоваров = СпособыВыпускаТоваров.Перемаркировка Тогда
		Результат = "remark";
	ИначеЕсли СпособВыпускаТоваров = СпособыВыпускаТоваров.МаркировкаВнеПроизводстваИлиИмпорта Тогда
		Результат = "reapply";
	Иначе
		ТекстСообщения = НСтр("ru = 'Неизвестный способ выпуска товаров: %1'");
		ТекстСообщения = ПараметрыВСтроку(ТекстСообщения, СпособВыпускаТоваров);
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Опеределяет тип эмиссии по способу выпуска товаров в терминах сервиса
//
// Параметры:
//  СпособВыпускаТоваров - Строка - см. Перечисление_СпособыВыпускаТоваров()
// 
// Возвращаемое значение:
//  Строка - тип эмиссии в терминах сервиса
//
Функция ТипЭмиссииВСервисеПоСпособуВыпускаТоваров(СпособВыпускаТоваров)
	
	СпособыВыпускаТоваров = Перечисление_СпособыВыпускаТоваров();
	
	Если СпособВыпускаТоваров = СпособыВыпускаТоваров.ПроизводствоРФ Тогда
		Результат = "Local";
	ИначеЕсли СпособВыпускаТоваров = СпособыВыпускаТоваров.Импорт Тогда
		Результат = "Foreign";
	Иначе
		ТекстСообщения = НСтр("ru = 'Неизвестный способ выпуска товаров: %1'");
		ТекстСообщения = ПараметрыВСтроку(ТекстСообщения, СпособВыпускаТоваров);
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Опеределяет причину вывода из оборота в терминах сервиса
//
// Параметры:
//  ПричинаВыводаИзОборота - см. Перечисление_ПричиныВыводаИзОборота()
// 
// Возвращаемое значение:
//  Строка - причина вывода из оборота в терминах сервиса
//
Функция ПричинаВыводаИзОборотаВСервисе(ПричинаВыводаИзОборота)
	
	Причины = Перечисление_ПричиныВыводаИзОборота();
	
	ПричиныВСервисе = Новый Соответствие;
	ПричиныВСервисе.Вставить(Причины.РозничнаяПродажа,                        "Retail");
	ПричиныВСервисе.Вставить(Причины.ЭкспортЕАЭС,                             "EasTrade");
	ПричиныВСервисе.Вставить(Причины.ЭкспортЗаПределыЕАЭС,                    "ExportBeyondEEC");
	ПричиныВСервисе.Вставить(Причины.ДистанционныйСпособПродажи,              "Distance");
	ПричиныВСервисе.Вставить(Причины.Утрата,                                  "Loss");
	ПричиныВСервисе.Вставить(Причины.Уничтожение,                             "Destruction");
	ПричиныВСервисе.Вставить(Причины.Конфискация,                             "Confiscation");
	ПричиныВСервисе.Вставить(Причины.ДляСобственныхНужд,                      "OwnUse");
	ПричиныВСервисе.Вставить(Причины.ВозвратФизическомуЛицу,                  "Return");
	ПричиныВСервисе.Вставить(Причины.Прочее,                                  "Other");
	ПричиныВСервисе.Вставить(Причины.ДляПроизводственныхЦелей,                "ProductionUse");
	ПричиныВСервисе.Вставить(Причины.ПродажаПоГосКонтракту,                   "StateContract");
	ПричиныВСервисе.Вставить(Причины.ИстечениеСрокаГодности,                  "Expiration");
	ПричиныВСервисе.Вставить(Причины.БезвозмезднаяПередача,                   "Donation");
	ПричиныВСервисе.Вставить(Причины.Утилизация,                              "Utilization");
	ПричиныВСервисе.Вставить(Причины.Фасовка,                                 "Packing");
	ПричиныВСервисе.Вставить(Причины.ПродажаЧерезВендинговыйАппарат,          "Vending");
	ПричиныВСервисе.Вставить(Причины.КорректировкаСкладскихОстатков,          "BalanceCorrection");
	ПричиныВСервисе.Вставить(Причины.ПродажаПоОбразцам,                       "BySamples");
	ПричиныВСервисе.Вставить(Причины.ИспользованиеДляМедицинскогоПрименения,  "MedicalUse");
	ПричиныВСервисе.Вставить(Причины.ИспользованиеДляВетеринарногоПрименения, "VeterinaryUse");
	ПричиныВСервисе.Вставить(Причины.ПродажаПоСделкеСГосударственнойТайной,   "StateSecret");
	ПричиныВСервисе.Вставить(Причины.ОтзывСРынка,                             "Recall");
	ПричиныВСервисе.Вставить(Причины.ПересортицаПоКодам,                      "Mismatch");
	
	Результат = ПричиныВСервисе[ПричинаВыводаИзОборота];
	
	Если Результат = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось определить причину вывода из оборота в сервисе: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстСообщения, ПричинаВыводаИзОборота);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Опеределяет тип первичного документа в терминах сервиса
