	|		ПО КодыОпераций.КлючКода = СвязиКлючейКодов.КлючКода
	|			И (&ПрочитатьИнформациюОКодах)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (СвязиКлючейКодов.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|			И (&ПрочитатьИнформациюОКодах)
	|ГДЕ
	|	КодыОпераций.Операция = &Операция
	|	И &КлючСтрокиОперации
	|	И &ДляВнутреннегоУчета";
	
	Если КлючСтрокиОперации = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиОперации", "ИСТИНА");
	Иначе
		Условие = "КодыОпераций.КлючСтрокиОперации = &КлючСтрокиОперации";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиОперации", Условие);
	КонецЕсли;
	
	Если ДляВнутреннегоУчета = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДляВнутреннегоУчета", "ИСТИНА");
		ПрочитатьИнформациюОКодах = Ложь;
	Иначе
		Условие = "ИнформацияОКодах.ДляВнутреннегоУчета = &ДляВнутреннегоУчета";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДляВнутреннегоУчета", Условие);
		ПрочитатьИнформациюОКодах = Истина;
	КонецЕсли;
	
	Если Упорядочить Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|
		|УПОРЯДОЧИТЬ ПО КодМаркировки";
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Операция", Операция);
	Запрос.УстановитьПараметр("КлючСтрокиОперации", КлючСтрокиОперации);
	Запрос.УстановитьПараметр("ДляВнутреннегоУчета", ДляВнутреннегоУчета);
	Запрос.УстановитьПараметр("ПрочитатьИнформациюОКодах", ПрочитатьИнформациюОКодах);
	
	Возврат МассивИзРезультатаЗапроса(Запрос, "КодМаркировки");
	
КонецФункции

Функция КодыОпераций_ПолныеКоды(Операция, КлючСтрокиОперации = Неопределено)
	
	ТаблицаКодов = КодыОпераций_Прочитать(Операция, КлючСтрокиОперации);
	КодыМаркировки_Прочитать(ТаблицаКодов);
	ПолныеКоды_Прочитать(ТаблицаКодов);
	
	КодыБезПолныхКодов = ТаблицаКодов.НайтиСтроки(Новый Структура("ПолныйКод", ""));
	Если ЗначениеЗаполнено(КодыБезПолныхКодов) Тогда
		СписокКодов = СписокКодовДляТекстаОшибки(КодыБезПолныхКодов);
		ТекстОшибки = НСтр("ru = 'Не удалось найти полные коды для кодов: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, СписокКодов);
	КонецЕсли;
	
	Возврат ТаблицаКодов;
	
КонецФункции

Функция КодыОпераций_КоличествоЗаводскихСерийныхНомеров(Операция, КлючСтрокиОперации = Неопределено) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	КодыОпераций.КлючСтрокиОперации КАК КлючСтрокиОперации,
	|	КОЛИЧЕСТВО(*) КАК КоличествоЗСН
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО КодыОпераций.КлючКода = КодыМаркировки.КлючКода
	|ГДЕ
	|	&КлючСтрокиОперации
	|	И КодыОпераций.Операция = &Операция
	|	И КодыМаркировки.ЗаводскойСерийныйНомер <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	КлючСтрокиОперации";
	
	Если КлючСтрокиОперации = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиОперации", "ИСТИНА");
	Иначе
		ТекстУсловия = "КодыОпераций.КлючСтрокиОперации = &КлючСтрокиОперации";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиОперации", ТекстУсловия);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Операция", Операция);
	Запрос.УстановитьПараметр("КлючСтрокиОперации", КлючСтрокиОперации);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция КодыОпераций_ОбщееКоличествоКодовАТК(Операция, КлючСтрокиОперации = Неопределено)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
