Функция ТаблицаКодов_ЕстьКодыАгрегатов(ТаблицаКодов) Экспорт
	
	Отбор = Новый Структура("КодАгрегата", "");
	Возврат ТаблицаКодов.Количество() > ТаблицаКодов.НайтиСтроки(Отбор).Количество();
	
КонецФункции

Функция ТаблицаКодов_ЕстьАгрегатыИВложенныеКоды(ТаблицаКодов)
	
	Если Не ТаблицаКодов_ЕстьКлючиАгрегатов(ТаблицаКодов)
		И Не ТаблицаКодов_ЕстьКодыАгрегатов(ТаблицаКодов) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат = Ложь;
	
	ИндексКодМаркировки = ТаблицаКодов.Индексы.Добавить("КодМаркировки");
	ИндексКлючКода = ТаблицаКодов.Индексы.Добавить("КлючКода");
	
	Для каждого Стр Из ТаблицаКодов Цикл
		
		Если ЗначениеЗаполнено(Стр.КодАгрегата)
			И ТаблицаКодов.Найти(Стр.КодАгрегата, "КодМаркировки") <> Неопределено Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.КлючАгрегата)
			И ТаблицаКодов.Найти(Стр.КлючАгрегата, "КлючКода") <> Неопределено Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаКодов.Индексы.Удалить(ИндексКодМаркировки);
	ТаблицаКодов.Индексы.Удалить(ИндексКлючКода);
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаКодов_ЕстьПустыеКлючиСтрокДокументов(ТаблицаКодов) Экспорт
	
	Возврат ТаблицаКодов.Найти(ПустойУникальныйИдентификатор(), "КлючСтрокиДокумента") <> Неопределено;
	
КонецФункции

Функция ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация = Неопределено, ВызыватьИсключение = Истина) Экспорт
	
	ТаблицаКодов_ЗаполнитьИсходныеКодыМаркировки(ТаблицаКодов);
	ТаблицаКодов_УдалитьКавычкиЭкранированияCSV(ТаблицаКодов);
	ТаблицаКодов_ВосстановитьРазделителиGS1(ТаблицаКодов);
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ВыполнитьАвторизацию(Организация, Ложь);
	Иначе
		Организация = Организация_ЛюбаяСДоступомВСервис();
	КонецЕсли;
	
	ТаблицаКодов_РазобратьКодыДоСерийногоНомера(ТаблицаКодов);
	ТаблицаКодов_ПодобратьТовары(ТаблицаКодов);
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		ТаблицаКодов_НормализоватьКИТУ20(ТаблицаКодов, Организация);
		ТаблицаНормализации = ТаблицаКодов_СформироватьТаблицуНормализации(ТаблицаКодов, Организация);
		ТаблицаКодов_ЗаполнитьПоТаблицеНормализации(ТаблицаКодов, ТаблицаНормализации);
		ТаблицаКодов_ПодобратьТовары(ТаблицаКодов);
		ТаблицаКодов_ДополнитьИзСтатусовКодов(ТаблицаКодов, Организация, Ложь);
		ТаблицаКодов_ПодобратьТовары(ТаблицаКодов);
		ТаблицаКодов_ЗаполнитьПоТаблицеНормализации(ТаблицаКодов, ТаблицаНормализации, Истина);
		ТаблицаКодов_ЗаполнитьОбщийТипУпаковки(ТаблицаКодов);
		
		Метрика_Функциональность_НормализаторВСервисе(Организация);
		
	КонецЕсли;
	
	НеразобранныеСтроки = ТаблицаКодов.НайтиСтроки(Новый Структура("КодРазобран", Ложь));
	Если ЗначениеЗаполнено(НеразобранныеСтроки) Тогда
		
		ТаблицаНеразобранныхКодов = ТаблицаКодов.Скопировать(НеразобранныеСтроки);
		
		ТаблицаКодов_НормализоватьКодыВ1С(ТаблицаНеразобранныхКодов);
		ТаблицаКодов_ПодобратьТовары(ТаблицаНеразобранныхКодов);
		ТаблицаКодов_ДополнитьИзСтатусовКодов(ТаблицаНеразобранныхКодов, Организация, ВызыватьИсключение);
		ТаблицаКодов_ПодобратьТовары(ТаблицаНеразобранныхКодов);
		ТаблицаКодов_НормализоватьКодыВ1С(ТаблицаНеразобранныхКодов, Истина);
		
		Метрика_Функциональность_Нормализатор1С(Организация);
		
	КонецЕсли;
	
	ТаблицаКодов_ОбновитьКодАгрегатаПослеНормализации(ТаблицаКодов);
	
	Возврат Не ТаблицаКодов_ЕстьНеРазобранные(ТаблицаКодов);
	
КонецФункции

Функция ТаблицаКодов_НормализоватьКодыЗаказа(ТаблицаКодов)
	
	ТаблицаКодов_ЗаполнитьИсходныеКодыМаркировки(ТаблицаКодов);
	ТаблицаКодов_ВосстановитьРазделителиGS1(ТаблицаКодов);
	ТаблицаКодов_РазобратьКодыДоСерийногоНомера(ТаблицаКодов, Истина);
	ТаблицаКодов_ПодобратьТовары(ТаблицаКодов);
	
	Возврат Не ТаблицаКодов_ЕстьНеРазобранные(ТаблицаКодов);
	
КонецФункции

Процедура ТаблицаКодов_НормализоватьКИТУ20(ТаблицаКодов, Организация)
	
	ТаблицаВариантов = ТаблицаКодов_НормализоватьКИТУ20_ТаблицаВариантов(ТаблицаКодов);
	ТаблицаКодов_НормализоватьКИТУ20_ПоДаннымИБ(ТаблицаВариантов);
	ТаблицаКодов_НормализоватьКИТУ20_ПоСтатусам(ТаблицаВариантов, Организация);
	ТаблицаКодов_НормализоватьКИТУ20_ПоНастройке(ТаблицаВариантов);
	
КонецПроцедуры

Функция ТаблицаКодов_НормализоватьКИТУ20_ТаблицаВариантов(ТаблицаКодов)
	
	ДлинаКода18 = 18;
	ДлинаКода20 = 20;
	ЛидирующиеНули = "00";
	ДлинаЛидирующихНулей = СтрДлина(ЛидирующиеНули);
	
	Результат = Новый_ТаблицаКодов();
	Результат.Колонки.Добавить("СтрокаТаблицыКодов");
	Для Каждого СтрКода Из ТаблицаКодов Цикл
		
		Если СтрКода.КодРазобран Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрДлина(СтрКода.КодМаркировки) = ДлинаКода20
			И Лев(СтрКода.КодМаркировки, ДлинаЛидирующихНулей) = ЛидирующиеНули Тогда
			
			Стр = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(Стр, СтрКода);
			Стр.СтрокаТаблицыКодов = СтрКода;
			
			Стр = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(Стр, СтрКода);
			Стр.СтрокаТаблицыКодов = СтрКода;
			Стр.КодМаркировки = Прав(Стр.КодМаркировки, ДлинаКода18);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.ЗаполнитьЗначения(Истина, "КодРазобран");
	Результат.ЗаполнитьЗначения(Перечисления.КонтурМаркировка_ТипыШтрихкодов.SSCC, "ТипШтрихкода");
	Результат.ЗаполнитьЗначения(Перечисления.КонтурМаркировка_ТипыУпаковок.МонотоварнаяУпаковка, "ТипУпаковки");
	Результат.ЗаполнитьЗначения(Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка, "ОбщийТипУпаковки");
	
	Возврат Результат;
	
КонецФункции

Процедура ТаблицаКодов_НормализоватьКИТУ20_ПоДаннымИБ(ТаблицаВариантов)
	
	Если Не ЗначениеЗаполнено(ТаблицаВариантов) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов_ЗаполнитьКлючиКодов(ТаблицаВариантов);
	ТаблицаКодов_ПрочитатьИнформациюОКодах(ТаблицаВариантов);
	
	КолонкиЗаполнения = ТаблицаКодов_НормализоватьКИТУ20_КолонкиЗаполнения();
	
	Сч = -(ТаблицаВариантов.Количество() - 1);
	Пока Сч < 0 Цикл
		
		Индекс = -Сч;
		СтрКИТУ18 = ТаблицаВариантов[Индекс];
		СтрКИТУ20 = ТаблицаВариантов[Индекс - 1];
		Сч = Сч + 2;
		
		СтрКода = СтрКИТУ20.СтрокаТаблицыКодов;
		
		Если ЗначениеЗаполнено(СтрКИТУ20.КлючКода) Тогда
			СтрКИТУ = СтрКИТУ20;
		ИначеЕсли ЗначениеЗаполнено(СтрКИТУ18.КлючКода) Тогда
			СтрКИТУ = СтрКИТУ18;
		Иначе
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрКода, СтрКИТУ, КолонкиЗаполнения);
		
		ТаблицаВариантов.Удалить(СтрКИТУ18);
		ТаблицаВариантов.Удалить(СтрКИТУ20);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_НормализоватьКИТУ20_ПоСтатусам(ТаблицаВариантов, Организация)
	
	Если Не ЗначениеЗаполнено(ТаблицаВариантов)
		Или Не ТаблицаКодов_ОбновитьСтатусы(ТаблицаВариантов, Организация) Тогда
		Возврат;
	КонецЕсли;
	
	КолонкиЗаполнения = ТаблицаКодов_НормализоватьКИТУ20_КолонкиЗаполнения();
	ВидыПродукции = Перечисление_ВидыПродукции();
	СтатусыКодов = Перечисление_СтатусыКодов();
	ОрганизацияИНН = Организация.ИНН;
	
	Сч = -(ТаблицаВариантов.Количество() - 1);
	Пока Сч < 0 Цикл
		
		Индекс = -Сч;
		СтрКИТУ18 = ТаблицаВариантов[Индекс];
		СтрКИТУ20 = ТаблицаВариантов[Индекс - 1];
		СтрКода = СтрКИТУ20.СтрокаТаблицыКодов;
		
		Сч = Сч + 2;
		
		СтрКода = СтрКИТУ20.СтрокаТаблицыКодов;
		
		СтрокаКИТУ20Существует = ЗначениеЗаполнено(СтрКИТУ20.Статус)
		И СтрКИТУ20.Статус <> СтатусыКодов.НеНайден
		И СтрКИТУ20.Статус <> СтатусыКодов.НетДоступа
		И СтрКИТУ20.Статус <> СтатусыКодов.Разагрегирован;
		
		СтрокаКИТУ18Существует = ЗначениеЗаполнено(СтрКИТУ18.Статус)
		И СтрКИТУ18.Статус <> СтатусыКодов.НеНайден
		И СтрКИТУ18.Статус <> СтатусыКодов.НетДоступа
		И СтрКИТУ18.Статус <> СтатусыКодов.Разагрегирован;
		
		ЛюбойВидПродукции = Не ЗначениеЗаполнено(СтрКода.ВидПродукции);
		СтрокаКИТУ20ПодходитТГ = (СтрКИТУ20.ВидПродукции = СтрКода.ВидПродукции Или ЛюбойВидПродукции);
		СтрокаКИТУ18ПодходитТГ = (СтрКИТУ18.ВидПродукции = СтрКода.ВидПродукции Или ЛюбойВидПродукции);
		
		СтрокаКИТУ20ПодходитВладелец = (СтрКИТУ20.ВладелецИНН = ОрганизацияИНН);
		СтрокаКИТУ18ПодходитВладелец = (СтрКИТУ18.ВладелецИНН = ОрганизацияИНН);
		
		СтрокаКИТУ20Расформирован = (СтрКИТУ20.Статус = СтатусыКодов.Разагрегирован);
		СтрокаКИТУ18Расформирован = (СтрКИТУ18.Статус = СтатусыКодов.Разагрегирован);
		
		ПолностьюПодходитСтрокаКИТУ20 = Ложь;
		Если СтрокаКИТУ20Существует И СтрокаКИТУ20ПодходитТГ И СтрокаКИТУ20ПодходитВладелец Тогда
			ПолностьюПодходитСтрокаКИТУ20 = Истина;
		КонецЕсли;
		
		ПолностьюПодходитСтрокаКИТУ18 = Ложь;
		Если СтрокаКИТУ18Существует И СтрокаКИТУ18ПодходитТГ И СтрокаКИТУ18ПодходитВладелец Тогда
			ПолностьюПодходитСтрокаКИТУ18 = Истина;
		КонецЕсли;
		
		Если ПолностьюПодходитСтрокаКИТУ20 Тогда
			СтрКИТУ = СтрКИТУ20;
		ИначеЕсли ПолностьюПодходитСтрокаКИТУ18 Тогда
			СтрКИТУ = СтрКИТУ18;
		Иначе
			Если СтрокаКИТУ20Существует И СтрокаКИТУ20ПодходитТГ И Не СтрокаКИТУ18Существует Тогда
				СтрКИТУ = СтрКИТУ20;
			ИначеЕсли СтрокаКИТУ18Существует И СтрокаКИТУ18ПодходитТГ И Не СтрокаКИТУ20Существует Тогда
				СтрКИТУ = СтрКИТУ18;
			ИначеЕсли СтрокаКИТУ20Расформирован И СтрокаКИТУ20ПодходитТГ Тогда
				СтрКИТУ = СтрКИТУ20;
			ИначеЕсли СтрокаКИТУ18Расформирован И СтрокаКИТУ18ПодходитТГ Тогда
				СтрКИТУ = СтрКИТУ18;
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрКода, СтрКИТУ, КолонкиЗаполнения);
		
		ТаблицаВариантов.Удалить(СтрКИТУ18);
		ТаблицаВариантов.Удалить(СтрКИТУ20);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_НормализоватьКИТУ20_ПоНастройке(ТаблицаВариантов)
	
	Если Не ЗначениеЗаполнено(ТаблицаВариантов) Тогда
		Возврат;
	КонецЕсли;
	
	КолонкиЗаполнения = ТаблицаКодов_НормализоватьКИТУ20_КолонкиЗаполнения();
	ИспользоватьSSCC18 = НастройкиМодуля().ИспользоватьSSCC18;
	
	Сч = -(ТаблицаВариантов.Количество() - 1);
	Пока Сч < 0 Цикл
		
		Индекс = -Сч;
		СтрКИТУ18 = ТаблицаВариантов[Индекс];
		СтрКИТУ20 = ТаблицаВариантов[Индекс - 1];
		СтрКода = СтрКИТУ20.СтрокаТаблицыКодов;
		Сч = Сч + 2;
		
		Если ИспользоватьSSCC18 Тогда
			СтрКИТУ = СтрКИТУ18;
		Иначе
			СтрКИТУ = СтрКИТУ20;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрКода, СтрКИТУ, КолонкиЗаполнения);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ТаблицаКодов_НормализоватьКИТУ20_КолонкиЗаполнения()
	
	Возврат "КодМаркировки, КодРазобран, ВидПродукции, ОбщийТипУпаковки, ТипШтрихкода, ТипУпаковки";
	
КонецФункции

Функция ТаблицаКодов_СформироватьТаблицуНормализации(ТаблицаКодов, Организация) Экспорт
	
	Результат = Новый_ТаблицаНормализации();
	РазмерПорции = 10000;
	
	Для Каждого ЧастьТаблицы Из ТаблицаЗначений_Разбить(ТаблицаКодов, "ВидПродукции", РазмерПорции) Цикл
		
		МассивСтрок = ЧастьТаблицы.МассивСтрок;
		ВидПродукции = ЧастьТаблицы.ВидПродукции;
		ЕстьВидПродукции = ЗначениеЗаполнено(ВидПродукции);
		
		КодыМаркировки = Новый Массив;
		Для каждого СтрКода Из МассивСтрок Цикл
			
			Если СтрКода.КодРазобран Тогда
				Продолжить;
			КонецЕсли;
			
			КодыМаркировки.Добавить(СтрКода.КодМаркировки);
			
		КонецЦикла;
		
		Если Не ЗначениеЗаполнено(КодыМаркировки) Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			Контент = Новый Структура("codes", КодыМаркировки);
			ТоварнаяГруппа = ТоварнаяГруппаВСервисе(ВидПродукции);
			Ответ = Маркировка_НормализоватьКоды(Контент, ТоварнаяГруппа, Организация);
		Исключение
			
			Ответ = Неопределено;
			
			Ошибка = ИнформацияОбОшибке();
			ПредставлениеОшибки = КраткоеПредставлениеОшибки(Ошибка);
			СписокКодовДляОшибки = СписокКодовДляТекстаОшибки(КодыМаркировки);
			ДопИнформация = Новый Структура;
			ДопИнформация.Вставить("Организация", Организация);
			ДопИнформация.Вставить("ВидПродукции", ВидПродукции);
			ДопИнформация.Вставить("КодыМаркировки", СписокКодовДляОшибки);
			Действие = НСтр("ru = 'Нормализация кодов в сервисе'");
			ШаблонСообщения = НСтр("ru = 'Не удалось нормализовать коды в сервисе: %1
			|%2'");
			ТекстСообщения = ПараметрыВСтроку(ШаблонСообщения, СписокКодовДляОшибки, ПредставлениеОшибки);
			ОбработатьОшибку(Действие, Ошибка, ДопИнформация, ТекстСообщения);
			
			ШаблонОшибки = НСтр("ru = 'Не удалось нормализовать код в сервисе
			|%1'");
			ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, КраткоеПредставлениеОшибки(Ошибка));
			Для Каждого СтрКода Из МассивСтрок Цикл
				СтрКода.ОписаниеОшибки = ТекстОшибки;
			КонецЦикла;
			
		КонецПопытки;
		
		Если ЗначениеЗаполнено(Ответ) Тогда
			Для Каждого Элемент Из Ответ Цикл
				Если ЕстьВидПродукции Тогда
					ЗаполнитьСтрокуТаблицыНормализации(Результат.Добавить(), Элемент);
				Иначе
					Для Каждого info Из Элемент.infos Цикл
						ЗаполнитьСтрокуТаблицыНормализации(Результат.Добавить(), info);
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьСтрокуТаблицыНормализации(СтрокаНормализации, CodeInfo)
	
	CodeInfo.Свойство("codeType",       СтрокаНормализации.ТипКода);
	CodeInfo.Свойство("sourceCode",     СтрокаНормализации.КодМаркировки);
	CodeInfo.Свойство("productGroup",   СтрокаНормализации.ТоварнаяГруппа);
	CodeInfo.Свойство("normalizedCode", СтрокаНормализации.НормализованныйКод);
	
	CodeInfo.components.Свойство("sscc",                   СтрокаНормализации.SSCC);
	CodeInfo.components.Свойство("gtin",                   СтрокаНормализации.GTIN);
	CodeInfo.components.Свойство("serial",                 СтрокаНормализации.СерийныйНомер);
	CodeInfo.components.Свойство("mrp",                    СтрокаНормализации.МРЦ);
	CodeInfo.components.Свойство("expires",                СтрокаНормализации.ДатаСрокаГодности);
	CodeInfo.components.Свойство("ai",                     СтрокаНормализации.ДополнительныйИдентификатор);
	CodeInfo.components.Свойство("productionDate",         СтрокаНормализации.ДатаПроизводства);
	CodeInfo.components.Свойство("ttisAggregate",          СтрокаНормализации.КодАгрегата);
	CodeInfo.components.Свойство("weight",                 СтрокаНормализации.Вес);
	CodeInfo.components.Свойство("weightApp",              СтрокаНормализации.ИдентификаторПримененияВеса);
	CodeInfo.components.Свойство("volume",                 СтрокаНормализации.Объем);
	CodeInfo.components.Свойство("volumeApp",              СтрокаНормализации.ИдентификаторПримененияОбъема);
	CodeInfo.components.Свойство("FactorySerialNumber",    СтрокаНормализации.ЗаводскойСерийныйНомер);
	CodeInfo.components.Свойство("FactorySerialNumberApp", СтрокаНормализации.ИдентификаторПримененияЗСН);
	
	СтрокаНормализации.ТоварнаяГруппа = НРег(СтрокаНормализации.ТоварнаяГруппа);
	
КонецПроцедуры

Процедура ТаблицаКодов_ЗаполнитьПоТаблицеНормализации(ТаблицаКодов, ТаблицаНормализации, ПроверитьВидПродукции = Ложь)
	
	КэшТГ = Новый Соответствие;
	
	ОтборКод = Новый Структура("КодМаркировки");
	ОтборКодТГ = Новый Структура("КодМаркировки, ТоварнаяГруппа");
	
	ИндексКод = ТаблицаНормализации.Индексы.Добавить("КодМаркировки");
	ИндексКодТГ = ТаблицаНормализации.Индексы.Добавить("КодМаркировки, ТоварнаяГруппа");
	
	Для Каждого СтрКода Из ТаблицаКодов Цикл
		
		Если СтрКода.КодРазобран Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПроверитьВидПродукции
			И Не ЗначениеЗаполнено(СтрКода.ВидПродукции) Тогда
			
			Если ЗначениеЗаполнено(СтрКода.Товар) И ЗначениеЗаполнено(СтрКода.Товар.ВидПродукции) Тогда
				СтрКода.ВидПродукции = СтрКода.Товар.ВидПродукции;
			Иначе
				СтрКода.ОписаниеОшибки = НСтр("ru = 'Не удалось подобрать вариант нормализации: Не задан вид продукции'");
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		ТоварнаяГруппа = Неопределено;
		Если ЗначениеЗаполнено(СтрКода.ВидПродукции) Тогда
			ТоварнаяГруппа = КэшТГ[СтрКода.ВидПродукции];
			Если Не ЗначениеЗаполнено(ТоварнаяГруппа) Тогда
				ТоварнаяГруппа = НРег(ТоварнаяГруппаВСервисе(СтрКода.ВидПродукции));
				КэшТГ.Вставить(СтрКода.ВидПродукции, ТоварнаяГруппа);
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТоварнаяГруппа) Тогда
			ОтборКодТГ.ТоварнаяГруппа = ТоварнаяГруппа;
			ОтборКодТГ.КодМаркировки = СтрКода.КодМаркировки;
			ВариантыНормализации = ТаблицаНормализации.НайтиСтроки(ОтборКодТГ);
		Иначе
			ОтборКод.КодМаркировки = СтрКода.КодМаркировки;
			ВариантыНормализации = ТаблицаНормализации.НайтиСтроки(ОтборКод);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ВариантыНормализации) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ВариантыНормализации.Количество() = 1 Тогда
			ТаблицаКодов_ЗаполнитьПоВариантуНормализации(СтрКода, ВариантыНормализации[0]);
		Иначе
			Для Каждого ВариантНормализации Из ВариантыНормализации Цикл
				Если ЗначениеЗаполнено(ВариантНормализации.GTIN) Тогда
					СтрКода.GTIN = ВариантНормализации.GTIN;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаНормализации.Индексы.Удалить(ИндексКод);
	ТаблицаНормализации.Индексы.Удалить(ИндексКодТГ);
	
КонецПроцедуры

Процедура ТаблицаКодов_ЗаполнитьПоВариантуНормализации(СтрокаКода, ВариантНормализации)
	
	СтрокаКода.КодРазобран = Истина;
	
	СтрокаКода.GTIN = ВариантНормализации.GTIN;
	СтрокаКода.ТипУпаковки = ТипУпаковкиПоТипуКодаМаркировкиИзСервиса(ВариантНормализации.ТипКода);
	СтрокаКода.ТипШтрихкода = ТипШтрихкодаПоТипуКодаМаркировкиИзСервиса(ВариантНормализации.ТипКода);
	СтрокаКода.КодМаркировки = ВариантНормализации.НормализованныйКод;
	СтрокаКода.СерийныйНомер = ВариантНормализации.СерийныйНомер;
	СтрокаКода.ОписаниеОшибки = "";
	
	Если СтрокаКода.ТипШтрихкода = Перечисления.КонтурМаркировка_ТипыШтрихкодов.SSCC Тогда
		СтрокаКода.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаКода.ВидПродукции)
		И ЗначениеЗаполнено(ВариантНормализации.ТоварнаяГруппа) Тогда
		СтрокаКода.ВидПродукции = ВидПродукцииПоТоварнойГруппеИзСервиса(ВариантНормализации.ТоварнаяГруппа);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВариантНормализации.ДатаСрокаГодности) Тогда
		СтрокаКода.ДатаСрокаГодности = ВариантНормализации.ДатаСрокаГодности;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВариантНормализации.Вес) Тогда
		СтрокаКода.Количество = ЗначениеЧисловогоПоказателяGS1(ВариантНормализации.Вес
		, ВариантНормализации.ИдентификаторПримененияВеса);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВариантНормализации.Объем) Тогда
		СтрокаКода.Количество = ЗначениеЧисловогоПоказателяGS1(ВариантНормализации.Объем
		, ВариантНормализации.ИдентификаторПримененияОбъема);
	КонецЕсли;
	
КонецПроцедуры

Процедура ТаблицаКодов_ЗаполнитьИсходныеКодыМаркировки(ТаблицаКодов)
	
	Для каждого Стр Из ТаблицаКодов Цикл
		Стр.ИсходныйКодМаркировки = Стр.КодМаркировки;
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_УдалитьКавычкиЭкранированияCSV(ТаблицаКодов) Экспорт
	
	Кавычки = Кавычки();
	
	Для каждого Стр Из ТаблицаКодов Цикл
		
		ЕстьКавычкиСлева = (Лев(Стр.КодМаркировки, 1) = Кавычки);
		ЕстьКавычкиСправа = (Прав(Стр.КодМаркировки, 1) = Кавычки);
		
		Если ЕстьКавычкиСлева И ЕстьКавычкиСправа Тогда
			Стр.КодМаркировки = Сред(Стр.КодМаркировки, 2, СтрДлина(Стр.КодМаркировки) - 2);
			Стр.КодМаркировки = СтрЗаменить(Стр.КодМаркировки, ДвеКавычки(), Кавычки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_РазобратьКодыДоСерийногоНомера(ТаблицаКодов, ОбновитьКодМаркировки = Ложь)
	
	ТипыШтрихкодов = Перечисления.КонтурМаркировка_ТипыШтрихкодов;
	РазделительGS1 = РазделительGS1();
	
	ДлинаGTIN = 14;
	ГруппаGTIN = "01";
	ГруппаСерийныйНомер = "21";
	НачалоGTIN = СтрДлина(ГруппаGTIN) + 1;
	ПозицияСерийныйНомер = НачалоGTIN + ДлинаGTIN;
	НачалоСерийногоНомера = ПозицияСерийныйНомер + СтрДлина(ГруппаСерийныйНомер);
	МаскимальнаяДлинаСерийногоНомера = 20;
	
	Для каждого СтрКода Из ТаблицаКодов Цикл
		
		Если СтрКода.КодРазобран Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрКода.ТипШтрихкода)
			И СтрКода.ТипШтрихкода <> ТипыШтрихкодов.GS1_DataMatrix Тогда
			Продолжить;
		КонецЕсли;
		
		СерийныйНомер = "";
		Если Лев(СтрКода.КодМаркировки, 2) = ГруппаGTIN
			И Сред(СтрКода.КодМаркировки, ПозицияСерийныйНомер, 2) = ГруппаСерийныйНомер Тогда
			
			ПозицияРазделителяGS1 = Найти(СтрКода.КодМаркировки, РазделительGS1);
			ДлинаСерийногоНомера = ПозицияРазделителяGS1 - НачалоСерийногоНомера;
			
			Если ДлинаСерийногоНомера > 0
				И ДлинаСерийногоНомера < МаскимальнаяДлинаСерийногоНомера Тогда
				НормализованныйКод = Лев(СтрКода.КодМаркировки, ПозицияРазделителяGS1 - 1);
				GTIN = Сред(НормализованныйКод, НачалоGTIN, ДлинаGTIN);
				СерийныйНомер = Сред(НормализованныйКод, НачалоСерийногоНомера);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СерийныйНомер) Тогда
			
			СтрКода.GTIN = GTIN;
			СтрКода.СерийныйНомер = СерийныйНомер;
			СтрКода.ТипШтрихкода = ТипыШтрихкодов.GS1_DataMatrix;
			СтрКода.ОписаниеОшибки = "";
			
			Если ОбновитьКодМаркировки Тогда
				СтрКода.КодМаркировки = НормализованныйКод;
				СтрКода.КодРазобран = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ТаблицаКодов_ПодобратьТовары(ТаблицаКодов) Экспорт
	
	СозданоТоваров = 0;
	
	Для каждого ЧастьТаблицы Из ТаблицаЗначений_Разбить(ТаблицаКодов, "GTIN") Цикл
		
		GTIN = ЧастьТаблицы.GTIN;
		СтрокиКодов = ЧастьТаблицы.МассивСтрок;
		
		Если Не ЗначениеЗаполнено(GTIN) Тогда
			Продолжить;
		КонецЕсли;
		
		Товар = Товар_Найти(GTIN);
		
		Если Не ЗначениеЗаполнено(Товар) Тогда
			
			ОписаниеТовара = Новый_Товар();
			ОписаниеТовара.GTIN = GTIN;
			Товар_ЗаполнитьИзСервиса(ОписаниеТовара);
			
			Если ЗначениеЗаполнено(ОписаниеТовара.ДопРеквизиты.ОшибкаГИСМТ) Тогда
				Продолжить;
			КонецЕсли;
			
			Товар_Записать(ОписаниеТовара);
			Товар = ОписаниеТовара.Ссылка;
			СозданоТоваров = СозданоТоваров + 1;
			
		КонецЕсли;
		
		ОбщийТипУпаковки = ОбщийТипУпаковкиПоТипуКодаМаркировки(Товар.ТипКодаМаркировки);
		
		Для каждого Стр Из СтрокиКодов Цикл
			
			Если ЗначениеЗаполнено(Стр.Товар) Тогда
				Продолжить;
			КонецЕсли;
			
			Стр.Товар = Товар;
			Стр.ОписаниеОшибки = "";
			
			Если Не ЗначениеЗаполнено(Стр.ВидПродукции) Тогда
				Стр.ВидПродукции = Товар.ВидПродукции;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Стр.ОбщийТипУпаковки)
				И Стр.ТипУпаковки = Перечисления.КонтурМаркировка_ТипыУпаковок.МаркированныйТовар Тогда
				Стр.ОбщийТипУпаковки = ОбщийТипУпаковки;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат СозданоТоваров;
	
КонецФункции

Процедура ТаблицаКодов_ЗаполнитьОбщийТипУпаковки(ТаблицаКодов)
	
	Для каждого ЧастьТаблицы Из ТаблицаЗначений_Разбить(ТаблицаКодов, "Товар") Цикл
		
		Товар = ЧастьТаблицы.Товар;
		СтрокиКодов = ЧастьТаблицы.МассивСтрок;
		
		Если Не ЗначениеЗаполнено(Товар) Тогда
			Продолжить;
		КонецЕсли;
		
		ОбщийТипУпаковки = ОбщийТипУпаковкиПоТипуКодаМаркировки(Товар.ТипКодаМаркировки);
		
		Для каждого Стр Из СтрокиКодов Цикл
			Если Не ЗначениеЗаполнено(Стр.ОбщийТипУпаковки)
				И Стр.ТипУпаковки = Перечисления.КонтурМаркировка_ТипыУпаковок.МаркированныйТовар Тогда
				Стр.ОбщийТипУпаковки = ОбщийТипУпаковки;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_ДополнитьИзСтатусовКодов(ТаблицаКодов, Организация, ВызыватьИсключение = Истина)
	
	СтрокиКодов = Новый Массив;
	МассивКодов = Новый Массив;
	Для каждого Стр Из ТаблицаКодов Цикл
		Если Не ЗначениеЗаполнено(Стр.Товар)
			Или Не ЗначениеЗаполнено(Стр.ОбщийТипУпаковки) Тогда
			СтрокиКодов.Добавить(Стр);
			МассивКодов.Добавить(Стр.КодМаркировки);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(МассивКодов) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Ответ = Маркировка_СтатусыКодов(МассивКодов, Организация);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		ОшибкаПолученияСтатусов = КраткоеПредставлениеОшибки(Ошибка);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ) Тогда
		Если ВызыватьИсключение Тогда
			СписокКодов = СписокКодовДляТекстаОшибки(МассивКодов);
			ТекстОшибки = НСтр("ru = 'Не удалось получить из сервиса статусы кодов %1
			|%2'");
			ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, СписокКодов, ОшибкаПолученияСтатусов);
		Иначе
			Для каждого Стр Из СтрокиКодов Цикл
				ТекстОшибки = НСтр("ru = 'Не удалось получить из сервиса статус кода
				|%1'");
				Стр.ОписаниеОшибки = ПараметрыВСтроку(ТекстОшибки, ОшибкаПолученияСтатусов);
			КонецЦикла;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	КэшТоваров = Новый Соответствие;
	ОшибкиСтатусов = Новый Соответствие;
	
	Для Сч = 0 По СтрокиКодов.ВГраница() Цикл
		
		Стр = СтрокиКодов[Сч];
		CisInfoResult = Ответ[Сч];
		
		Если Не ЗначениеЗаполнено(CisInfoResult) Тогда
			Продолжить;
		КонецЕсли;
		
		value = CisInfoResult["value"];
		error = CisInfoResult["error"];
		
		Если ЗначениеЗаполнено(error) Тогда
			ШаблонОшибки = НСтр("ru = 'Не удалось получить статус кода: %1'");
			ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, error);
			Стр.ОписаниеОшибки = ТекстОшибки;
			ОшибкиСтатусов.Вставить(error);
			Продолжить;
		КонецЕсли;
		
		gtin = value["gtin"];
		productGroup = value["productGroup"];
		generalPackageType = value["generalPackageType"];
		emissionType = value["emissionType"];
		
		Если ЗначениеЗаполнено(gtin) Тогда
			Стр.GTIN = gtin;
		КонецЕсли;
		
		Стр.ВидПродукции = ВидПродукцииПоТоварнойГруппеИзСервиса(productGroup);
		Стр.ОбщийТипУпаковки = ОбщийТипУпаковкиПоОбщемуТипуУпаковкиИзСервиса(generalPackageType);
		Стр.СпособВыпускаТоваров = СпособВыпускаТоваровПоСпособуВыпускаИзСервиса(emissionType);
		Стр.ОписаниеОшибки = "";
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ОшибкиСтатусов) И ВызыватьИсключение Тогда
		СписокОшибок = СписокКодовДляТекстаОшибки(КлючиСоответствия(ОшибкиСтатусов));
		ШаблонОшибки = НСтр("ru = 'Не удалось получить статусы всех кодов
		|%1'");
		ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, СписокОшибок);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
КонецПроцедуры

Процедура ТаблицаКодов_ОбновитьКодАгрегатаПослеНормализации(ТаблицаКодов)
	
	Если Не ТаблицаКодов_ЕстьКодыАгрегатов(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("КодАгрегата");
	Индекс = ТаблицаКодов.Индексы.Добавить("КодАгрегата");
	
	Для каждого СтрАгрегата Из ТаблицаКодов Цикл
		Отбор.КодАгрегата = СтрАгрегата.ИсходныйКодМаркировки;
		Для Каждого Стр Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
			Стр.КодАгрегата = СтрАгрегата.КодМаркировки;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаКодов.Индексы.Удалить(Индекс);
	
КонецПроцедуры

Процедура ТаблицаКодов_НормализоватьКодыВ1С(ТаблицаКодов, ПроверитьВидПродукции = Ложь) Экспорт
	
	Для каждого СтрКода Из ТаблицаКодов Цикл
		
		Если СтрКода.КодРазобран Тогда
			Продолжить;
		КонецЕсли;
		
		КодМаркировки = СтрКода.КодМаркировки;
		Если Не ЗначениеЗаполнено(КодМаркировки) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПроверитьВидПродукции
			И Не ЗначениеЗаполнено(СтрКода.ВидПродукции) Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ДанныеКода = РазобратьКодМаркировки(КодМаркировки, СтрКода.ВидПродукции);
		Исключение
			Ошибка = ИнформацияОбОшибке();
			СтрКода.ОписаниеОшибки = Ошибка.Описание;
			Продолжить;
		КонецПопытки;
		
		СтрКода.КодРазобран = Истина;
		СтрКода.ТипШтрихкода = ДанныеКода.ТипШтрихкода;
		СтрКода.КодМаркировки = ДанныеКода.НормализованныйКодМаркировки;
		СтрКода.ТипУпаковки = ТипУпаковкиПоВидуУпаковки(ДанныеКода.ВидУпаковки);
		
		СоставКодаМаркировки = ДанныеКода.СоставКодаМаркировки;
		
		Если СоставКодаМаркировки.Свойство("GTIN") Тогда
			СтрКода.GTIN = СоставКодаМаркировки.GTIN;
		КонецЕсли;
		
		Если СоставКодаМаркировки.Свойство("СерийныйНомер") Тогда
			СтрКода.СерийныйНомер = СоставКодаМаркировки.СерийныйНомер;
		КонецЕсли;
		
		Если СоставКодаМаркировки.Свойство("Вес") Тогда
			СтрКода.Количество = СоставКодаМаркировки.Вес;
		КонецЕсли;
		
		Если СоставКодаМаркировки.Свойство("Объем") Тогда
			СтрКода.Количество = СоставКодаМаркировки.Объем;
		КонецЕсли;
		
		СтрКода.ОписаниеОшибки = "";
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_РаспределитьКлючиСтрокОперацииЗаказа(ТаблицаКодов, Товары)
	
	ПоляТоваров = "Товар, КлючСтрокиОперации";
	Отбор = Новый Структура(ПоляТоваров);
	Отбор.КлючСтрокиОперации = ПустойУникальныйИдентификатор();
	
	Для каждого СтрТовара Из Товары Цикл
		
		Распределено = 0;
		Отбор.Товар = СтрТовара.Товар;
		Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
			Если Распределено = СтрТовара.КоличествоУпаковок Тогда
				Прервать;
			КонецЕсли;
			СтрКода.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
			СтрКода.КлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
			СтрКода.КлючНоменклатуры1С = СтрТовара.КлючНоменклатуры1С;
			Распределено = Распределено + 1;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(СтрТовара.ВложенныйТовар)
			И ЗначениеЗаполнено(СтрТовара.КоличествоУпаковокВложенногоТовара) Тогда
			Распределено = 0;
			Отбор.Товар = СтрТовара.ВложенныйТовар;
			Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
				Если Распределено = СтрТовара.КоличествоУпаковокВложенногоТовара Тогда
					Прервать;
				КонецЕсли;
				СтрКода.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
				СтрКода.КлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
				Распределено = Распределено + 1;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_ЗаполнитьПоДокументуКлючиНоменклатуры1С(ТаблицаКодов, ДокументУчета)
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов.Скопировать(, "КлючКода, КлючНоменклатуры1С"), "ТабКодов", "КлючКода");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТабКодов.КлючКода КАК КлючКода,
	|	ТоварыДокумента.КлючНоменклатуры1С КАК КлючНоменклатуры1С
	|ИЗ
	|	ТабКодов КАК ТабКодов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО ТабКодов.КлючКода = КодыДокументов.КлючКода
	|			И (КодыДокументов.ДокументУчета = &ДокументУчета)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ПО (КодыДокументов.КлючСтрокиДокумента = ТоварыДокумента.КлючСтрокиДокумента)
	|			И (КодыДокументов.ДокументУчета = &ДокументУчета)
	|ГДЕ
	|	ТоварыДокумента.КлючНоменклатуры1С ЕСТЬ НЕ NULL 
	|	И ТоварыДокумента.КлючНоменклатуры1С <> ТабКодов.КлючНоменклатуры1С");
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Индекс = ТаблицаКодов.Индексы.Добавить("КлючКода");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТаблицаКодов.Найти(Выборка.КлючКода, "КлючКода").КлючНоменклатуры1С = Выборка.КлючНоменклатуры1С;
	КонецЦикла;
	
	ТаблицаКодов.Индексы.Удалить(Индекс);
	
КонецПроцедуры

Функция ТаблицаКодов_ЗагрузитьКодыМаркировки(КодыМаркировки, ЗаполнитьПолныеКоды = Ложь) Экспорт
	
	Результат = Новый_ТаблицаКодов();
	
	Для Каждого КодМаркировки Из ЗначениеВМассиве(КодыМаркировки) Цикл
		
		Если Не ЗначениеЗаполнено(КодМаркировки) Тогда
			Продолжить;
		КонецЕсли;
		
		Стр = Результат.Добавить();
		Стр.КодМаркировки = КодМаркировки;
		
		Если ЗаполнитьПолныеКоды Тогда
			Стр.ПолныйКод = КодМаркировки;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ТаблицаКодов_ДобавитьКлючиТранспортныхУпаковокНижнегоУровня(ТаблицаКодов)
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов.Скопировать(, "КлючКода"), "Таб1", "КлючКода");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 0
	|	Т.КлючКода КАК КлючКода,
	|	Т.КлючКода КАК КлючАгрегата
	|ПОМЕСТИТЬ Итог1
	|ИЗ
	|	Таб1 КАК Т");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВложенныеУпаковки.КлючКода КАК КлючКода,
	|	ВложенныеУпаковки.КлючАгрегата КАК КлючАгрегата
	|ПОМЕСТИТЬ Таб2
	|ИЗ
	|	Таб1 КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК ВложенныеУпаковки
	|		ПО Таб.КлючКода = ВложенныеУпаковки.КлючАгрегата
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (ВложенныеУпаковки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	ИнформацияОКодах.ОбщийТипУпаковки = ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.КлючАгрегата КАК КлючАгрегата
	|ПОМЕСТИТЬ Итог2
	|ИЗ
	|	Итог1 КАК Т
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.КлючКода,
	|	Т.КлючАгрегата
	|ИЗ
	|	Таб2 КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Таб1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Итог1";
	
	Пока Истина Цикл
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
		Выборка = Запрос.ВыполнитьПакет().Получить(0).Выбрать();
		Выборка.Следующий();
		Если Выборка.Количество = 0 Тогда
			Прервать;
		КонецЕсли;
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Таб1", "Таб2");
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Итог1", "Итог2");
	КонецЦикла;
	
	Если Найти(ТекстЗапроса, "ПОМЕСТИТЬ Итог1") > 0 Тогда
		ТекстЗапроса = "ВЫБРАТЬ * ИЗ Итог1";
	Иначе
		ТекстЗапроса = "ВЫБРАТЬ * ИЗ Итог2";
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Выборка = Запрос.Выполнить().Выбрать();
	МенеджерВТ.Закрыть();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаКодов.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов) Экспорт
	
	МассивКлючей = ТаблицаКодов.ВыгрузитьКолонку("КлючКода");
	СвернутьМассив_Марк(МассивКлючей, Истина);
	Если Не ЗначениеЗаполнено(МассивКлючей) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.КлючАгрегата КАК КлючАгрегата
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК Т
	|ГДЕ
	|	Т.КлючАгрегата В(&МассивКлючей)
	|	И НЕ Т.КлючКода В (&МассивКлючей)");
	Запрос.УстановитьПараметр("МассивКлючей", МассивКлючей);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаКодов.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_ДополнитьИнформациейИБ(ТаблицаКодов) Экспорт
	
	ТаблицаКодов_ЗаполнитьКлючиКодов(ТаблицаКодов);
	
	ТаблицаКодовИБ = ТаблицаКодов.Скопировать( , "КлючКода");
	ТаблицаКодов_ДополнитьКолонки(ТаблицаКодовИБ);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодовИБ);
	
	ПоляИБ = Новый Массив;
	ПоляИБ.Добавить("ЗаводскойСерийныйНомер");
	ПоляИБ.Добавить("СерийныйНомер");
	ПоляИБ.Добавить("Количество");
	ПоляИБ.Добавить("ВладелецИНН");
	ПоляИБ.Добавить("ПроизводительИНН");
	
	ДополнитьМассив(ПоляИБ, РазделитьСтроку(ИнформацияОКодах_ИменаПолей()));
	ДополнитьМассив(ПоляИБ, РазделитьСтроку(СтатусыКодовГИСМТ_ИменаПолей()));
	
	Для Сч = 0 По (ТаблицаКодов.Количество() - 1) Цикл
		
		Стр = ТаблицаКодов[Сч];
		СтрИБ = ТаблицаКодовИБ[Сч];
		
		Если Не ЗначениеЗаполнено(СтрИБ.КлючКода) Тогда
			Продолжить; // В базе нет такого кода
		КонецЕсли;
		
		Для каждого ИмяПоля Из ПоляИБ Цикл
			Если Не ЗначениеЗаполнено(Стр[ИмяПоля]) Или Стр[ИмяПоля] = Ложь Тогда
				Стр[ИмяПоля] = СтрИБ[ИмяПоля];
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_УдалитьВесОбъемИзПолныхКодов(ТаблицаКодов)
	
	РазделительGS1 = РазделительGS1();
	ИдентификаторВеса = ИдентификаторПрименения_ВесВКилограммах();
	ИдентификаторОбъема = ИдентификаторПрименения_ОбъемВЛитрах();
	
	ДлинаПоказателя = 6;
	ДлинаПозицииТочки = 1;
	ДлинаИдентификатораПрименения = 3;
	ДлинаВесаОбъема = ДлинаИдентификатораПрименения + ДлинаПозицииТочки + ДлинаПоказателя;
	
	Для каждого Стр Из ТаблицаКодов Цикл
		
		ПолныйКод = Стр.ПолныйКод;
		Если ДлинаВесаОбъема >= СтрДлина(ПолныйКод) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаВесаОбъема = Прав(ПолныйКод, ДлинаВесаОбъема);
		ИдентификаторПрименения = Лев(СтрокаВесаОбъема, ДлинаИдентификатораПрименения);
		
		Если ИдентификаторПрименения = ИдентификаторВеса
			Или ИдентификаторПрименения = ИдентификаторОбъема Тогда
			ПолныйКод = Лев(ПолныйКод, СтрДлина(ПолныйКод) - ДлинаВесаОбъема);
			Если Прав(ПолныйКод, 1) = РазделительGS1 Тогда
				ПолныйКод = Лев(ПолныйКод, СтрДлина(ПолныйКод) - 1);
			КонецЕсли;
			Стр.ПолныйКод = ПолныйКод;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_УдалитьЗаводскойСерийныйНомерИзПолныхКодов(ТаблицаКодов, Организация, ВидПродукции)
	
	ВыполнитьАвторизацию(Организация, Ложь);
	
	ТаблицаКодовДляНормализации = Новый_ТаблицаКодов();
	Для каждого Стр Из ТаблицаКодов Цикл
		НоваяСтрока = ТаблицаКодовДляНормализации.Добавить();
		НоваяСтрока.КодМаркировки = Стр.ПолныйКод;
		НоваяСтрока.ВидПродукции = ВидПродукции;
	КонецЦикла;
	
	ТаблицаНормализации = ТаблицаКодов_СформироватьТаблицуНормализации(ТаблицаКодовДляНормализации, Организация);
	ТаблицаНормализации.Индексы.Добавить("КодМаркировки");
	
	РазделительGS1 = РазделительGS1();
	
	Для каждого Стр Из ТаблицаКодов Цикл
		
		ПолныйКод = Стр.ПолныйКод;
		СтрНорм = ТаблицаНормализации.Найти(ПолныйКод, "КодМаркировки");
		Если СтрНорм = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаводскойСН = СтрНорм.ЗаводскойСерийныйНомер;
		ИдентификаторЗСН = СтрНорм.ИдентификаторПримененияЗСН;
		
		Если ЗначениеЗаполнено(ЗаводскойСН) Тогда
			ПолныйКод = СтрЗаменить(ПолныйКод, ИдентификаторЗСН + Base64ИзСтроки(ЗаводскойСН), "");
			Если Прав(ПолныйКод, 1) = РазделительGS1 Тогда
				ПолныйКод = Лев(ПолныйКод, СтрДлина(ПолныйКод) - 1);
			КонецЕсли;
			Стр.ПолныйКод = ПолныйКод;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ТаблицаКодов_ЕстьНеРазобранные(ТаблицаКодов)
	
	Возврат ТаблицаКодов.Найти(Ложь, "КодРазобран") <> Неопределено;
	
