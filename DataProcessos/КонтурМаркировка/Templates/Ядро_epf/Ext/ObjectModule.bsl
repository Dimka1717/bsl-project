// Возвращает информацию о количестве кодов на свободных остатках
//
// Параметры:
//  ПараметрыОтбора - Структура - (необязательный) содержит поля:
//   * Товар - СправочникСсылка.КонтурМаркировка_Товары - (необязательный) товар;
//   * Организация - СправочникСсылка.КонтурМаркировка_Организации - (необязательный) организация;
//   * ВидПродукции - ПеречислениеСсылка.КонтурМаркировка_ВидыПродукции - (необязательный) вид продукции;
// 
// Возвращаемое значение:
//  ТаблицаЗначений - содержит колонки:
//  * Товар - СправочникСсылка.КонтурМаркировка_Товары - товар;
//  * Организация - СправочникСсылка.КонтурМаркировка_Организации - (необязательный) организация;
//  * ВидПродукции - ПеречислениеСсылка.КонтурМаркировка_ВидыПродукции - Вид продукции;
//  * ДатаЭмиссии - Дата - дата эмиссии;
//  * ВладелецИНН - Строка - ИНН владельца карточки товара;
//  * ПроизводительИНН - Строка - ИНН производителя из карточки товара;
//  * КоличествоКодов - Число - количество кодов на свободном остатке;
//  * СрокЖизни - Число - количество дней до окончания срока жизни кодов;
//
Функция КоличествоКодовНаСвободныхОстатках(ПараметрыОтбора = Неопределено) Экспорт
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ПоместитьТаблицуВЗапрос(МенеджерВТ, СрокиЖизниКодовПоВидамПродукции(), "СрокиЖизниКодов", "ВидПродукции");
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	КодыЗаказов.Товар КАК Товар,
	|	КодыЗаказов.ЗаказКодов.ВидПродукции КАК ВидПродукции,
	|	НАЧАЛОПЕРИОДА(КодыЗаказов.ЗаказКодов.Дата, ДЕНЬ) КАК ДатаЭмиссии,
	|	КодыЗаказов.ЗаказКодов.Организация КАК Организация,
	|	СУММА(КодыЗаказов.КоличествоКодов) КАК КоличествоКодов,
	|	ТипОплатыКодов.Значение КАК ТипОплатыКодов
	|ПОМЕСТИТЬ СвободныеКоды
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыЗаказов КАК КодыЗаказов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ТипОплатыКодов
	|		ПО КодыЗаказов.ЗаказКодов = ТипОплатыКодов.Объект
	|			И (ТипОплатыКодов.ИмяРеквизита = &ТипОплатыКодов)
	|ГДЕ
	|	&Товар
	|	И &Организация
	|	И &ВидПродукции
	|	И НЕ КодыЗаказов.ЗаказКодов В (&СтарыеЗаказы)
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(КодыЗаказов.ЗаказКодов.Дата, ДЕНЬ),
	|	КодыЗаказов.ЗаказКодов.Организация,
	|	КодыЗаказов.Товар,
	|	КодыЗаказов.ЗаказКодов.ВидПродукции,
	|	ТипОплатыКодов.Значение
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВидПродукции
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СвободныеКоды.Товар КАК Товар,
	|	СвободныеКоды.ДатаЭмиссии КАК ДатаЭмиссии,
	|	СвободныеКоды.Организация КАК Организация,
	|	СвободныеКоды.ВидПродукции КАК ВидПродукции,
	|	СвободныеКоды.Товар.ВладелецКарточкиТовара.ИНН КАК ВладелецИНН,
	|	СвободныеКоды.Товар.Производитель.ИНН КАК ПроизводительИНН,
	|	СвободныеКоды.КоличествоКодов КАК КоличествоКодов,
	|	ВЫБОР
	|		КОГДА СвободныеКоды.ТипОплатыКодов = &ПоНанесению
	|			ТОГДА СрокиЖизниКодов.СрокЖизни - РАЗНОСТЬДАТ(СвободныеКоды.ДатаЭмиссии, &ТекущаяДата, ДЕНЬ)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СрокЖизни
	|ИЗ
	|	СвободныеКоды КАК СвободныеКоды
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СрокиЖизниКодов КАК СрокиЖизниКодов
	|		ПО СвободныеКоды.ВидПродукции = СрокиЖизниКодов.ВидПродукции
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товар,
	|	СрокЖизни";
	
	Товар = СвойствоСтруктуры(ПараметрыОтбора, "Товар");
	Организация = СвойствоСтруктуры(ПараметрыОтбора, "Организация");
	ВидПродукции = СвойствоСтруктуры(ПараметрыОтбора, "ВидПродукции");
	
	Если ЗначениеЗаполнено(Товар) Тогда
		Условие = "КодыЗаказов.Товар = &Товар";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Товар", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Товар", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Условие = "КодыЗаказов.ЗаказКодов.Организация = &Организация";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Организация", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Организация", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидПродукции) Тогда
		Условие = "КодыЗаказов.ЗаказКодов.ВидПродукции = &ВидПродукции";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидПродукции", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидПродукции", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("Товар", Товар);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВидПродукции", ВидПродукции);
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("СтарыеЗаказы", ЗаказыСИстекшимСрокомЖизниКодов());
	Запрос.УстановитьПараметр("ПоНанесению", Перечисление_ТипыОплатыКодов().ПоНанесению);
	Запрос.УстановитьПараметр("ТипОплатыКодов", Перечисление_ИменаДопРеквизитов().ТипОплатыКодов);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Возвращает автоматический режим управления блокировкой данных,
// если в базе по умолчанию используется режим "Автоматический и управляемый"
//
// Это нужно для того, чтобы снизить количество ошибок установки неправильного режима блокировки в транзакциях,
// когда кроме объектов Контур.Маркировки задействованы объекты системы учета с автоматическим режимом
// 
// Возвращаемое значение:
//  РежимУправленияБлокировкойДанных.Автоматический - если в базе используется "Автоматический и управляемый" режим блокировки
//  Неопределено - если в базе используется "Автоматический" или "Управляемый" режим управления блокировки данных по умолчанию
//
Функция РежимУправленияБлокировкой()
	
	КлючКэш = "РежимУправленияБлокировкой";
	СтруктураРезультата = Кэш_Прочитать(КлючКэш);
	Если СтруктураРезультата <> Неопределено Тогда
		Возврат СтруктураРезультата.Результат;
	КонецЕсли;
	
	РежимыУправления = Метаданные.СвойстваОбъектов.РежимУправленияБлокировкойДанныхПоУмолчанию;
	ТекущийРежимБлокировки = Метаданные.РежимУправленияБлокировкойДанных;
	
	Если ТекущийРежимБлокировки = РежимыУправления.АвтоматическийИУправляемый Тогда
		Результат = РежимУправленияБлокировкойДанных.Автоматический;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	СтруктураРезультата = Новый Структура("Результат", Результат);
	
	Кэш_Поместить(КлючКэш, СтруктураРезультата);
	
	Возврат Результат;
	
КонецФункции

