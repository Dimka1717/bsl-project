	ИдентификаторЗаказа = ОписаниеЗадачи.ИдентификаторДокумента;
	
	Результат = Мок_ПолучениеКодов_СоздатьЗадачу(Организация, ИдентификаторЗаказа, ПроверитьПовторно);
	Если Не Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	Маркировка_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	Маркировка_ДобавитьТокен(Запрос, Организация);
	
	Запрос.Метод = "POST";
	Запрос.ПутьНаСервере = "/api/v1/codes/orders/{id}/receive-job";
	Запрос.Параметры.Вставить("id", ИдентификаторЗаказа);
	Запрос.ДопустимыеКодыОтвета.Добавить(409);
	
