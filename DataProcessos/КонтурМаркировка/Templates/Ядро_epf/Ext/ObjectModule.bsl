Функция Маркировка_Лента_НовыеСобытия(Организация, ГраницаЧтенияЛенты = Неопределено)
	
	Результат = Мок_Лента_НовыеСобытия(Организация, ГраницаЧтенияЛенты);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	Маркировка_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	Маркировка_ДобавитьТокен(Запрос, Организация);
	
	ЛимитСобытий = 10000;
	Запрос.Параметры.Вставить("organizationId", Организация.Идентификатор);
	Запрос.Параметры.Вставить("limit", ЛимитСобытий);
	
	Если ТипЗнч(ГраницаЧтенияЛенты) = Тип("Строка") Тогда
		Запрос.ПутьНаСервере = "/api/v1/events/{organizationId}/after-event";
		Запрос.Параметры.Вставить("afterEventId", ГраницаЧтенияЛенты);
	Иначе
		Запрос.ПутьНаСервере = "/api/v1/events/{organizationId}/after-date";
		Если ЗначениеЗаполнено(ГраницаЧтенияЛенты) Тогда
			Запрос.Параметры.Вставить("afterDate", УниверсальнаяДатаXML(ГраницаЧтенияЛенты));
		КонецЕсли;
	КонецЕсли;
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	ОбработатьОшибкуHTTP(Ответ, Запрос);
	Результат = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета);
	
	Возврат Результат;
	
