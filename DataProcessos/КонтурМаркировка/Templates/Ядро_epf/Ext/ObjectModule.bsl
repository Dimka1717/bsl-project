//  Структура - содержит:
//   * Ключ - Строка - статус кода в сервисе;
//   * Значение - Строка - статус кода в 1С, см. Перечисление_СтатусыКодов();
//
Функция СоответствиеСтатусовКодов()
	
	КлючКэш = "СоответствиеСтатусовКодов";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтатусыКодов = Перечисление_СтатусыКодов();
	
	Результат = Новый Соответствие;
	Результат.Вставить(НРег("Emitted")				, СтатусыКодов.Выпущен);
	Результат.Вставить(НРег("Applied")				, СтатусыКодов.Нанесен);
	Результат.Вставить(НРег("Introduced")			, СтатусыКодов.ВведенВОборот);
	Результат.Вставить(НРег("WrittenOff")			, СтатусыКодов.Списан);
	Результат.Вставить(НРег("Retired")				, СтатусыКодов.ВыбылИзОборота);
	Результат.Вставить(НРег("Disaggregation")		, СтатусыКодов.Разагрегирован);
	Результат.Вставить(НРег("IntroducedReturned")	, СтатусыКодов.ВозвращенВОборот);
	Результат.Вставить(НРег("Unknown")				, СтатусыКодов.НеОпределен);
	
	Результат = Новый ФиксированноеСоответствие(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция СоответствиеСпособовВыпускаТоваров()
	
	КлючКэш = "СоответствиеСпособовВыпускаТоваров";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СпособыВыпускаТоваров = Перечисление_СпособыВыпускаТоваров();
	
	Результат = Новый Соответствие;
	Результат.Вставить(НРег("Remains"), СпособыВыпускаТоваров.Остатки);
	Результат.Вставить(НРег("Foreign"), СпособыВыпускаТоваров.Импорт);
	Результат.Вставить(НРег("Local"), СпособыВыпускаТоваров.ПроизводствоРФ);
	Результат.Вставить(НРег("Remark"), СпособыВыпускаТоваров.Перемаркировка);
	Результат.Вставить(НРег("Reapply"), СпособыВыпускаТоваров.МаркировкаВнеПроизводстваИлиИмпорта);
	
	Результат = Новый ФиксированноеСоответствие(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция СостояниеКодовВСервисе(СостояниеКодов)
	
	СостоянияКодов = Перечисление_СостоянияКодов();
	
	СостоянияВСервисе = Новый Соответствие;
	СостоянияВСервисе.Вставить(СостоянияКодов.ОтгрузкаНаЭкспорт, "ShippedAbroad");
	СостоянияВСервисе.Вставить(СостоянияКодов.ОтменаОтгрузкиНаЭкспорт, "CancelShippedAbroad");
	
	Результат = СостоянияВСервисе[СостояниеКодов];
	
	Если Результат = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось определить состояние кодов в терминах сервиса: %1 '");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, СостояниеКодов);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Контент_ВводВОборот_ИдентификаторВСД(СтрТовара, ДопРеквизиты)
	
	Если ЗначениеЗаполнено(СтрТовара.Товар)
		И Не СтрТовара.Товар.ПодлежитВетеринарномуКонтролю Тогда
		Возврат "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрТовара.ИдентификаторВСД) Тогда
		Результат = КаноническийИдентификаторИзСтроки(СтрТовара.ИдентификаторВСД);
	ИначеЕсли ЗначениеЗаполнено(ДопРеквизиты.ИдентификаторВСД) Тогда
		Результат = КаноническийИдентификаторИзСтроки(ДопРеквизиты.ИдентификаторВСД);
	Иначе
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Контент_ВводВОборот_aggregateCode(СтрАгрегата, ТаблицаКодов, ИдентификаторВСД, ОписаниеРД)
	
	ВложенныеКоды = ТаблицаКодов.НайтиСтроки(Новый Структура("КодАгрегата", СтрАгрегата.КодМаркировки));
	
	Если ЗначениеЗаполнено(ВложенныеКоды) Тогда
		
		Результат = Новый_aggregateCode(СтрАгрегата);
		
		children = Новый Массив;
		Для Каждого Стр Из ВложенныеКоды Цикл
			Если Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Комплект
				Или Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ЕдиницаТовара Тогда
				children.Добавить(Новый_aggregateCode(Стр, ИдентификаторВСД, ОписаниеРД));
			Иначе
				children.Добавить(Контент_ВводВОборот_aggregateCode(Стр, ТаблицаКодов, ИдентификаторВСД, ОписаниеРД));
			КонецЕсли;
		КонецЦикла;
		
		Результат.Вставить("children", children);
		
	Иначе
		
		Результат = Новый_aggregateCode(СтрАгрегата, ИдентификаторВСД, ОписаниеРД);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Контент_ВводВОборот_importFtsAggregateCode(СтрАгрегата, ТаблицаКодов, ИдентификаторВСД)
	
	ВложенныеКоды = ТаблицаКодов.НайтиСтроки(Новый Структура("КодАгрегата", СтрАгрегата.КодМаркировки));
	
	Если ЗначениеЗаполнено(ВложенныеКоды) Тогда
		
		Результат = Новый_importFtsAggregateCode(СтрАгрегата);
		
		children = Новый Массив;
		Для Каждого Стр Из ВложенныеКоды Цикл
			Если Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Комплект
				Или Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ЕдиницаТовара Тогда
				children.Добавить(Новый_importFtsAggregateCode(Стр, ИдентификаторВСД));
			Иначе
				children.Добавить(Контент_ВводВОборот_importFtsAggregateCode(Стр, ТаблицаКодов, ИдентификаторВСД));
			КонецЕсли;
		КонецЦикла;
		
		Результат.Вставить("children", children);
		
	Иначе
		
		Результат = Новый_importFtsAggregateCode(СтрАгрегата, ИдентификаторВСД);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Контент_ВводВОборот_crossBorderAggregateCode(СтрАгрегата, ТаблицаКодов, ИдентификаторВСД, ОписаниеРД, ВидПродукции)
	
	ВложенныеКоды = ТаблицаКодов.НайтиСтроки(Новый Структура("КодАгрегата", СтрАгрегата.КодМаркировки));
	
	Если ЗначениеЗаполнено(ВложенныеКоды) Тогда
		
		children = Новый Массив;
		Для Каждого Стр Из ВложенныеКоды Цикл
			Если Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Комплект
				Или Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ЕдиницаТовара Тогда
				СтрАгрегата.Сумма = СтрАгрегата.Сумма + Стр.Цена;
				СтрАгрегата.СуммаНДС = СтрАгрегата.СуммаНДС + Стр.ЦенаНДС;
				СтрАгрегата.СуммаАкциза = СтрАгрегата.СуммаАкциза + Стр.ЦенаАкциза;
				children.Добавить(Новый_crossBorderAggregateCode(Стр, ВидПродукции, ИдентификаторВСД, ОписаниеРД));
			Иначе
				children.Добавить(Контент_ВводВОборот_crossBorderAggregateCode(Стр, ТаблицаКодов, ИдентификаторВСД, ОписаниеРД, ВидПродукции));
			КонецЕсли;
		КонецЦикла;
		
		Результат = Новый_crossBorderAggregateCode(СтрАгрегата, ВидПродукции);
		Результат.Вставить("children", children);
		
	Иначе
		
		Результат = Новый_crossBorderAggregateCode(СтрАгрегата, ВидПродукции, ИдентификаторВСД, ОписаниеРД);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура Контент_ВводВОборот_ЗаполнитьРД(Контент, ОписаниеРД)
	
	ДобавитьЗаполненноеЗначениеВСтруктуру(Контент, "certificateDocument", ОписаниеРД.ВидДокументаСертификации);
	ДобавитьЗаполненноеЗначениеВСтруктуру(Контент, "certificateDocumentDate", ОписаниеРД.ДатаДокументаСертификации);
	ДобавитьЗаполненноеЗначениеВСтруктуру(Контент, "certificateDocumentNumber", ОписаниеРД.НомерДокументаСертификации);
	
	Если ЗначениеЗаполнено(ОписаниеРД.НомераСкважин) Тогда
		Контент.Вставить("wellNumbers", РазделитьСтроку(ОписаниеРД.НомераСкважин));
	КонецЕсли;
	
КонецПроцедуры

Функция Новый_aggregateCode(СтрКода, ИдентификаторВСД = Неопределено, ОписаниеРД = Неопределено)
	
	Результат = Новый Структура;
	
	Если СтрКода.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка Тогда
		Результат.Вставить("uitucode", СтрКода.КодМаркировки);
	Иначе
		Результат.Вставить("uitcode", СтрКода.КодМаркировки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторВСД)
		И ЗначениеЗаполнено(СтрКода.Товар)
		И СтрКода.Товар.ПодлежитВетеринарномуКонтролю Тогда
		Результат.Вставить("accompanyingDocument", ИдентификаторВСД);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеРД) Тогда
		Контент_ВводВОборот_ЗаполнитьРД(Результат, ОписаниеРД);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_importFtsAggregateCode(СтрКода, ИдентификаторВСД = Неопределено)
	
	Результат = Новый Структура;
	
	Результат.Вставить("code", СтрКода.КодМаркировки);
	
	Если ЗначениеЗаполнено(ИдентификаторВСД)
		И ЗначениеЗаполнено(СтрКода.Товар)
		И СтрКода.Товар.ПодлежитВетеринарномуКонтролю Тогда
		Результат.Вставить("accompanyingDocument", ИдентификаторВСД);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_crossBorderAggregateCode(СтрКода, ВидПродукции, ИдентификаторВСД = Неопределено, ОписаниеРД = Неопределено, ОписаниеЦены = Неопределено)
	
	Результат = Новый Структура;
	
	Если СтрКода.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка Тогда
		Результат.Вставить("uitucode", СтрКода.КодМаркировки);
	Иначе
		Результат.Вставить("uitcode", СтрКода.КодМаркировки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеРД) Тогда
		Контент_ВводВОборот_ЗаполнитьРД(Результат, ОписаниеРД);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторВСД)
		И ЗначениеЗаполнено(СтрКода.Товар)
		И СтрКода.Товар.ПодлежитВетеринарномуКонтролю Тогда
		Результат.Вставить("accompanyingDocument", ИдентификаторВСД);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрКода.Сумма) Тогда
		Результат.Вставить("cost", СтрКода.Сумма);
	Иначе
		ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "cost", СтрКода.Цена);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрКода.СуммаНДС) Тогда
		Результат.Вставить("vat", СтрКода.СуммаНДС);
	Иначе
		Если ЗначениеЗаполнено(СтрКода.ЦенаНДС) Или ВидПродукцииТребуетСуммуНДСПриВводеВОборот(ВидПродукции) Тогда
			Результат.Вставить("vat", СтрКода.ЦенаНДС);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрКода.СуммаАкциза) Тогда
		Результат.Вставить("excise", СтрКода.СуммаАкциза);
	Иначе
		ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "excise", СтрКода.ЦенаАкциза);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_Контент_ВводВОборот_ОписаниеРД()
	
	Результат = Новый Структура;
	Результат.Вставить("НомераСкважин");
	Результат.Вставить("ВидДокументаСертификации");
	Результат.Вставить("ДатаДокументаСертификации");
	Результат.Вставить("НомерДокументаСертификации");
	
	Возврат Результат;
	
КонецФункции

Функция АртикулПоЗначениюИзСервиса(ЗначениеВСервисе)
	
	ТипыАртикулов = Перечисление_ТипыАртикуловВСервисе();
	
	Если СтрокаНачинаетсяС(ЗначениеВСервисе, ТипыАртикулов.МодельАртикул) Тогда
		ДлинаТипаАртикула = СтрДлина(ТипыАртикулов.МодельАртикул);
	ИначеЕсли СтрокаНачинаетсяС(ЗначениеВСервисе, ТипыАртикулов.Артикул) Тогда
		ДлинаТипаАртикула = СтрДлина(ТипыАртикулов.Артикул);
	ИначеЕсли СтрокаНачинаетсяС(ЗначениеВСервисе, ТипыАртикулов.Модель) Тогда
		ДлинаТипаАртикула = СтрДлина(ТипыАртикулов.Модель);
	Иначе
		ДлинаТипаАртикула = 0;
	КонецЕсли;
	
	Результат = Сред(ЗначениеВСервисе, ДлинаТипаАртикула + 1);
	
	Возврат СокрЛП(Результат);
	
КонецФункции

