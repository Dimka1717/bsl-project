Функция ВсеВидыПродукции(Исключения = Неопределено) Экспорт
	
	КлючКэш = "ВсеВидыПродукции";
	Если ЗначениеЗаполнено(Исключения) Тогда
		КлючКэш = КлючКэш + " за исключением: " + СоединитьСтроку(Исключения, ", ");
	КонецЕсли;
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Исключения = Неопределено Тогда
		Исключения = Новый Массив;
	КонецЕсли;
	
	Исключения.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.СлабыйАлкоголь);
	Исключения.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.КабельнаяПродукция);
	
	Результат = Новый Массив;
	Для каждого Значение Из Метаданные.Перечисления.КонтурМаркировка_ВидыПродукции.ЗначенияПеречисления Цикл
		ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции[Значение.Имя];
		Если ЗначениеЗаполнено(Исключения) И МассивСодержитЗначение(Исключения, ВидПродукции) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(ВидПродукции);
	КонецЦикла;
	
	Результат = Новый ФиксированныйМассив(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ДопустимыеВидыПродукцииДляОтчетаОНанесении() Экспорт
	
	ВидыПродукции = Перечисления.КонтурМаркировка_ВидыПродукции;
	
	Результат = Новый Массив;
	Результат.Добавить(ВидыПродукции.Молоко);
	Результат.Добавить(ВидыПродукции.Вода);
	Результат.Добавить(ВидыПродукции.Пиво);
	Результат.Добавить(ВидыПродукции.Бады);
	Результат.Добавить(ВидыПродукции.Антисептики);
	Результат.Добавить(ВидыПродукции.МедицинскиеИзделия);
	Результат.Добавить(ВидыПродукции.БезалкогольныеНапитки);
	Результат.Добавить(ВидыПродукции.Морепродукты);
	Результат.Добавить(ВидыПродукции.Консервы);
	Результат.Добавить(ВидыПродукции.Косметика);
	Результат.Добавить(ВидыПродукции.Ветпрепараты);
	Результат.Добавить(ВидыПродукции.РастительныеМасла);
	Результат.Добавить(ВидыПродукции.Игрушки);
