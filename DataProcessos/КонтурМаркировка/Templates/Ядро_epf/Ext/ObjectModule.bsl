// Проверяет что фича-флаг включен
//
// Параметры:
//  ФичаФлаг - Строка - см. Перечисление_ФичаФлаги();
// 
// Возвращаемое значение:
//  Булево - Истина, если фича-флаг включен
//
Функция ФичаФлагВключен(ФичаФлаг) Экспорт
	
	ФичаФлагиВключения = Перечисление_ФичаФлагиВключения();
	ФичаФлагиОтключения = Перечисление_ФичаФлагиОтключения();
	
	Результат = Ложь;
	
	Если ЕстьЗначениеВСтруктуре(ФичаФлагиВключения, ФичаФлаг) Тогда
		Результат = ОтложеннуюФункциюМожноИспользовать(ФичаФлаг);
	КонецЕсли;
	
	Если ЕстьЗначениеВСтруктуре(ФичаФлагиОтключения, ФичаФлаг) Тогда
		Результат = Не ВременнуюФункциюНужноОтключить(ФичаФлаг);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Добавляет или удаляет значение в массиве в зависимости от того включен фича-флаг или выключен
//
// Параметры:
//  Массив   - Массив - массив значений;
//  Значение - Произвольный - значение, которое нужно добавить или удалить в массиве;
//  ФичаФлаг - Строка - см. Перечисление_ФичаФлаги();
//
Процедура ИзменитьМассивПоФичаФлагу(Массив, Значение, ФичаФлаг) Экспорт
	
	Если ФичаФлагВключен(ФичаФлаг) Тогда
		ДобавитьЗначениеВМассив(Массив, Значение);
	Иначе
		УдалитьЗначениеИзМассива(Массив, Значение);
	КонецЕсли;
	
КонецПроцедуры

// Проверяет необходимость отключения временной функции
//
// Параметры:
//  ИмяФункции - Строка - имя функции;
// 
// Возвращаемое значение:
//  Булево - Истина, если функцию нужно отключить
//
Функция ВременнуюФункциюНужноОтключить(ИмяФункции) Экспорт
	
	ДатаОтключения = СвойствоСтруктуры(СписокВременныхФункций().ДатыОтключения, ИмяФункции, '00010101');
	
	Возврат (ТекущаяДатаСеанса() >= ДатаОтключения);
	
КонецФункции

// Проверяет возможность использования отложенной функции
//
// Параметры:
//  ИмяФункции - Строка - имя функции;
// 
// Возвращаемое значение:
//  Булево - Истина, если функцию можно использовать
//
Функция ОтложеннуюФункциюМожноИспользовать(ИмяФункции) Экспорт
	
	ДатаВключения = СвойствоСтруктуры(СписокОтложенныхФункций().ДатыВключения, ИмяФункции, '00010101');
	
	Возврат (ТекущаяДатаСеанса() >= ДатаВключения);
	
КонецФункции

Процедура ОбновитьФичаФлаги() Экспорт
	
	ОписаниеВременныхФункций = СписокВременныхФункций();
	ОписаниеОтложенныхФункций = СписокОтложенныхФункций();
	ВерсияСписка = ОписаниеОтложенныхФункций.ВерсияСписка;
	ДатаПроверки = ОписаниеОтложенныхФункций.ДатаПроверки;
	ТекущаяДатаПроверки = ТекущаяДата();
	
	Если НачалоДня(ДатаПроверки) = НачалоДня(ТекущаяДатаПроверки) Тогда
		Возврат;
	КонецЕсли;
	
	Контент = КонтентДляПроверкиОбновления();
	Продукт = Перечисление_ПродуктыВСервисеОбновлений().ФичаФлаги;
	ТипКонтента = Перечисление_ТипыКонтентовВСервисеОбновлений().ФичаФлаги;
	
	Попытка
		Ответ = СервисОбновлений_ПроверитьОбновления(Контент, Продукт);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Обновление списка временных и отложенных функций'");
		ОбработатьОшибку(Действие, Ошибка);
		Возврат;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или Ответ.contain_update <> Истина
		Или Ответ.name = ВерсияСписка Тогда
		
		ОписаниеВременныхФункций.ДатаПроверки = ТекущаяДатаПроверки;
		ОписаниеОтложенныхФункций.ДатаПроверки = ТекущаяДатаПроверки;
		
		СписокВременныхФункций_Записать(ОписаниеВременныхФункций);
		СписокОтложенныхФункций_Записать(ОписаниеОтложенныхФункций);
		
		Возврат;
		
	КонецЕсли;
	
	СсылкаНаФайл = АдресФайлаОбновленияИзСервиса(Ответ, ТипКонтента);
	ФайлСписка = СкачатьФайлИзИнтернета(СсылкаНаФайл);
	СтрокаСписка = СтрокаИзДвоичныхДанных(ФайлСписка);
	СписокИзСервиса = ЗначениеИзСтрокиJSON(СтрокаСписка);
	
	version = СвойствоСтруктуры(СписокИзСервиса, "version");
	enableFeatures = СвойствоСтруктуры(СписокИзСервиса, "enableFeatures");
	disableFeatures = СвойствоСтруктуры(СписокИзСервиса, "disableFeatures");
	
	ОписаниеВременныхФункций.ВерсияСписка = version;
	ОписаниеВременныхФункций.ДатаПроверки = ТекущаяДатаПроверки;
	ОписаниеВременныхФункций.ДатыОтключения.Очистить();
	Если ЗначениеЗаполнено(disableFeatures) Тогда
		Для каждого Элемент Из disableFeatures Цикл
			ОписаниеВременныхФункций.ДатыОтключения.Вставить(Элемент.Ключ, ДатаИзСтрокиXML(Элемент.Значение));
		КонецЦикла;
	КонецЕсли;
	
	ОписаниеОтложенныхФункций.ВерсияСписка = version;
	ОписаниеОтложенныхФункций.ДатаПроверки = ТекущаяДатаПроверки;
	ОписаниеОтложенныхФункций.ДатыВключения.Очистить();
	Если ЗначениеЗаполнено(enableFeatures) Тогда
		Для каждого Элемент Из enableFeatures Цикл
			ОписаниеОтложенныхФункций.ДатыВключения.Вставить(Элемент.Ключ, ДатаИзСтрокиXML(Элемент.Значение));
		КонецЦикла;
	КонецЕсли;
	
	СписокВременныхФункций_Записать(ОписаниеВременныхФункций);
	СписокОтложенныхФункций_Записать(ОписаниеОтложенныхФункций);
	
КонецПроцедуры

Процедура СписокОтложенныхФункций_Записать(СписокФункций) Экспорт
	
	ИмяСправочника = ИмяСправочникаСписокОтложенныхФункций();
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника);
	
	ДанныеИБ.ДопРеквизиты.Очистить();
	ДополнитьСтруктуру(ДанныеИБ.ДопРеквизиты, СписокФункций.ДатыВключения);
	ДанныеИБ.ДопРеквизиты.Вставить("ДатаПроверки", СписокФункций.ДатаПроверки);
	
	ДанныеИБ.Комментарий = СписокФункций.ВерсияСписка;
	
	ДопСправочник_Записать(ДанныеИБ);
	ПараметрыСессии_Поместить(ИмяСправочника, Неопределено);
	
КонецПроцедуры

Процедура СписокВременныхФункций_Записать(СписокФункций) Экспорт
	
	ИмяСправочника = ИмяСправочникаСписокВременныхФункций();
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника);
	
	ДанныеИБ.ДопРеквизиты.Очистить();
	ДополнитьСтруктуру(ДанныеИБ.ДопРеквизиты, СписокФункций.ДатыОтключения);
	ДанныеИБ.ДопРеквизиты.Вставить("ДатаПроверки", СписокФункций.ДатаПроверки);
	
	ДанныеИБ.Комментарий = СписокФункций.ВерсияСписка;
	
	ДопСправочник_Записать(ДанныеИБ);
	ПараметрыСессии_Поместить(ИмяСправочника, Неопределено);
	
КонецПроцедуры

Функция СписокВременныхФункций() Экспорт
	
	ИмяСправочника = ИмяСправочникаСписокВременныхФункций();
	Результат = ПараметрыСессии_Прочитать(ИмяСправочника);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника);
	
	Результат = Новый_СписокВременныхФункций();
	Результат.ВерсияСписка = ДанныеИБ.Комментарий;
	ДополнитьСтруктуру(Результат.ДатыОтключения, ДанныеИБ.ДопРеквизиты);
	
	Результат.ДатаПроверки = СвойствоСтруктуры(ДанныеИБ.ДопРеквизиты, "ДатаПроверки", '00010101');
	Результат.ДатыОтключения.Удалить("ДатаПроверки");
	
	Возврат Результат;
	
КонецФункции

Функция СписокОтложенныхФункций() Экспорт
	
	ИмяСправочника = ИмяСправочникаСписокОтложенныхФункций();
	Результат = ПараметрыСессии_Прочитать(ИмяСправочника);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника);
	
	Результат = Новый_СписокОтложенныхФункций();
	Результат.ВерсияСписка = ДанныеИБ.Комментарий;
	ДополнитьСтруктуру(Результат.ДатыВключения, ДанныеИБ.ДопРеквизиты);
	
	Результат.ДатаПроверки = СвойствоСтруктуры(ДанныеИБ.ДопРеквизиты, "ДатаПроверки", '00010101');
	Результат.ДатыВключения.Удалить("ДатаПроверки");
	
	Возврат Результат;
	
КонецФункции

Функция АдресФайлаОбновленияИзСервиса(ОтветОтСервиса, ТипКонтента) Экспорт
	
	ДанныеФайла = МассивСтруктур_Найти(ОтветОтСервиса.links, ТипКонтента, "content_type");
	Если Не ЗначениеЗаполнено(ДанныеФайла) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДанныеФайла.href;
	
КонецФункции

Функция ИмяСправочникаСписокОтложенныхФункций()
	
	Возврат "СписокОтложенныхФункций";
	
КонецФункции

Функция ИмяСправочникаСписокВременныхФункций()
	
	Возврат "СписокВременныхФункций";
	
КонецФункции

Функция Новый_СписокОтложенныхФункций() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ВерсияСписка");
	Результат.Вставить("ДатаПроверки");
	Результат.Вставить("ДатыВключения", Новый Структура);
	
	Возврат Результат;
	
КонецФункции

Функция Новый_СписокВременныхФункций() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ВерсияСписка");
	Результат.Вставить("ДатаПроверки");
	Результат.Вставить("ДатыОтключения", Новый Структура);
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // ВременныеИОтложенныеФункции

// #Область ДополнительныеСправочники

Функция ДопСправочник_Прочитать(Ссылка) Экспорт
	
	Результат = Новый_ЭлементДопСправочника();
	ЗаполнитьЗначенияСвойств(Результат, Ссылка, , "ДопРеквизиты");
	
	Для каждого Стр Из Ссылка.ДопРеквизиты Цикл
	
		ИмяРеквизита = Стр.ИмяРеквизита;
		
		Если ЗначениеЗаполнено(Стр.Значение) Тогда
			Значение = Стр.Значение;
		ИначеЕсли ЗначениеЗаполнено(Стр.ЗначениеСсылка) Тогда
			Значение = Стр.ЗначениеСсылка;
		Иначе
			Значение = Стр.ЗначениеХранилище.Получить();
		КонецЕсли;
		
		Результат.ДопРеквизиты.Вставить(ИмяРеквизита, Значение);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ДопСправочник_Записать(ОписаниеЭлемента) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Если ЗначениеЗаполнено(ОписаниеЭлемента.Ссылка) Тогда
			
			Если ОбъектВПроцессеОбновления(ОписаниеЭлемента.Ссылка) Тогда
				ВызватьИсключение_ОбъектВПроцессеОбновления(ОписаниеЭлемента.Ссылка);
			КонецЕсли;
			
			ДопСправочник_Заблокировать(ОписаниеЭлемента.Ссылка);
			Объект = ОписаниеЭлемента.Ссылка.ПолучитьОбъект();
			
			Если Объект.ПометкаУдаления Тогда
				Объект.ПометкаУдаления = Ложь;
			КонецЕсли;
			
		Иначе
			Объект = Справочники.КонтурМаркировка_ДопСправочники.СоздатьЭлемент();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Объект, ОписаниеЭлемента, , "ДопРеквизиты");
		
		Если Не ЗначениеЗаполнено(Объект.Наименование) Тогда
			Объект.Наименование = ОписаниеЭлемента.ИмяСправочника;
		КонецЕсли;
		
		Объект.ДопРеквизиты.Очистить();
		
		Для каждого Элемент Из ОписаниеЭлемента.ДопРеквизиты Цикл
			
			Значение = Элемент.Значение;
			ИмяРеквизита = Элемент.Ключ;
			
			Если Значение = Ложь Или Не ЕстьЗначение(Значение) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Объект.ДопРеквизиты.Добавить();
			НоваяСтрока.ИмяРеквизита = ИмяРеквизита;
			
			Если ЭтоПростойТип(Значение) Тогда
				НоваяСтрока.Значение = Элемент.Значение;
			ИначеЕсли ЭтоСсылка(Значение) И ЭтоОбъектКонтурМаркировки(Значение) Тогда
				НоваяСтрока.ЗначениеСсылка = Элемент.Значение;
			Иначе
				НоваяСтрока.ЗначениеХранилище = ЗначениеВХранилище(Значение);
			КонецЕсли;
			
		КонецЦикла;
		
		Объект.Записать();
		
		ОписаниеЭлемента.Ссылка = Объект.Ссылка;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ДопСправочник_Удалить(Ссылка) Экспорт
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектДопСправочника = Ссылка.ПолучитьОбъект();
	ОбъектДопСправочника.ОбменДанными.Загрузка = Истина;
	ОбъектДопСправочника.Удалить();
	
КонецПроцедуры

Функция ДопСправочник_ПрочитатьПервый(ИмяСправочника, ИмяРеквизита = "", ЗначениеРеквизита = Неопределено) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Спр.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_ДопСправочники КАК Спр
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДопСправочники.ДопРеквизиты КАК ТЧ
	|		ПО ТЧ.Ссылка = Спр.Ссылка
	|ГДЕ
	|	Спр.ИмяСправочника = &ИмяСправочника
	|	И НЕ Спр.ПометкаУдаления
	|	И &УсловиеПоРеквизиту";
	
	Если ЗначениеЗаполнено(ИмяРеквизита) Тогда
		Если ЭтоПростойТип(ЗначениеРеквизита) Тогда
			ТекстУсловия =  "ТЧ.ИмяРеквизита = &ИмяРеквизита И ТЧ.Значение = &ЗначениеРеквизита";
		ИначеЕсли ЭтоСсылка(ЗначениеРеквизита) Тогда
			ТекстУсловия =  "ТЧ.ИмяРеквизита = &ИмяРеквизита И ТЧ.ЗначениеСсылка = &ЗначениеРеквизита";
		Иначе
			ВызватьИсключение ПараметрыВСтроку(НСтр(
			"ru = 'Неизвестный тип значения ""%1"" для поиска в доп справочнике по доп реквизиту '"), ЗначениеРеквизита);
		КонецЕсли;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоРеквизиту", ТекстУсловия);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоРеквизиту", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ИмяСправочника", ИмяСправочника);
	Запрос.УстановитьПараметр("ИмяРеквизита", ИмяРеквизита);
	Запрос.УстановитьПараметр("ЗначениеРеквизита", ЗначениеРеквизита);
	
	Ссылка = ПолучитьРезультатЗапроса(Запрос);
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Результат = ДопСправочник_Прочитать(Ссылка);
	Иначе
		Результат = Новый_ЭлементДопСправочника(ИмяСправочника);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДопСправочник_ВсеЭлементы(ИмяСправочника) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_ДопСправочники КАК Т
	|ГДЕ
	|	Т.ИмяСправочника = &ИмяСправочника");
	
	Запрос.УстановитьПараметр("ИмяСправочника", ИмяСправочника);
	
	Возврат МассивИзРезультатаЗапроса(Запрос);
	
КонецФункции

Функция ДопСправочник_НайтиПоДопРеквизиту(ИмяСправочника, ИмяРеквизита, Значение) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТЧ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_ДопСправочники.ДопРеквизиты КАК ТЧ
	|ГДЕ
	|	ТЧ.ИмяРеквизита = &ИмяРеквизита
	|	И ТЧ.Ссылка.ИмяСправочника = &ИмяСправочника
	|	И &Значение";
	
	Если ЭтоПростойТип(Значение) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Значение", "ТЧ.Значение = &Значение");
	ИначеЕсли ЭтоСсылка(Значение) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Значение", "ТЧ.ЗначениеСсылка = &Значение");
	Иначе
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный тип значения ""%1"" для поиска в доп справочнике по доп реквизиту '"), Значение);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ИмяСправочника", ИмяСправочника);
	Запрос.УстановитьПараметр("ИмяРеквизита", ИмяРеквизита);
	Запрос.УстановитьПараметр("Значение", Значение);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат МассивИзРезультатаЗапроса(Запрос);
	
КонецФункции

Процедура ДопСправочник_Заблокировать(Ссылка)
	
	Объект = "Справочник.КонтурМаркировка_ДопСправочники";
	Значения = Новый Структура("Ссылка", Ссылка);
	ЗаблокироватьПоЗначениям(Объект, Значения);
	
КонецПроцедуры

Функция Новый_ЭлементДопСправочника(ИмяСправочника = "") Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Ссылка");
	Результат.Вставить("ИмяСправочника", ИмяСправочника);
	Результат.Вставить("Наименование");
	Результат.Вставить("Ответственный");
	Результат.Вставить("Комментарий");
	
	Результат.Вставить("ДопРеквизиты", Новый Структура);
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // ДополнительныеСправочники

// #Область КодыЗаказов

Процедура КодыЗаказов_Записать(ТаблицаКодов, ЗаказКодов, УдалитьСтарыеКоды = Истина) Экспорт
	
	ТипыФайлов = Перечисление_ТипыФайлов();
	
	ПоляТаблицыДляФайла =
	"КлючКода, ПолныйКод, КодМаркировки, ХешСуммаКодаМаркировки,
	|СерийныйНомер, ЗаводскойСерийныйНомер, Количество,
	|Товар, КлючНоменклатуры1С, СпособВыпускаТоваров";
	
	ТаблицаДляФайла = ТаблицаКодов.Скопировать(, ПоляТаблицыДляФайла);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыЗаказов_Заблокировать(ЗаказКодов);
		
		Файл = Файл_Найти(ЗаказКодов, ТипыФайлов.КодыЗаказа);
		Файл_Заблокировать(Файл);
		
		ОписаниеФайла = Файл_Прочитать(Файл);
		Если ОписаниеФайла = Неопределено Тогда
			ОписаниеФайла = Новый_ОписаниеФайла();
			ОписаниеФайла.ТипФайла = ТипыФайлов.КодыЗаказа;
			ОписаниеФайла.ВладелецФайла = ЗаказКодов;
		КонецЕсли;
		
		Если Не УдалитьСтарыеКоды И ЗначениеЗаполнено(ОписаниеФайла.ДанныеФайла) Тогда
			ТаблицаЗначений_Дополнить(ОписаниеФайла.ДанныеФайла, ТаблицаДляФайла);
		Иначе
			ОписаниеФайла.ДанныеФайла = ТаблицаДляФайла;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОписаниеФайла.ДанныеФайла) Тогда
			Файл_Записать(ОписаниеФайла);
		Иначе
			Файлы_Удалить(Файл);
		КонецЕсли;
		
		Набор = РегистрыСведений.КонтурМаркировка_КодыЗаказов.СоздатьНаборЗаписей();
		Набор.Отбор.ЗаказКодов.Установить(ЗаказКодов);
		Набор.Загрузить(КодыЗаказов_ТаблицаЗаказа(ОписаниеФайла.ДанныеФайла, ЗаказКодов));
		Набор.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура КодыЗаказов_Удалить(ЗаказКодов)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Набор = РегистрыСведений.КонтурМаркировка_КодыЗаказов.СоздатьНаборЗаписей();
		Набор.Отбор.ЗаказКодов.Установить(ЗаказКодов);
		Набор.Записать();
		
		Файл = Файл_Найти(ЗаказКодов, Перечисление_ТипыФайлов().КодыЗаказа);
		Если ЗначениеЗаполнено(Файл) Тогда
			Файлы_Удалить(Файл);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура КодыЗаказов_ВернутьКодыВЗаказы(КлючиКодов)
	
	Если Не ЗначениеЗаполнено(КлючиКодов) Тогда
		Возврат;
	КонецЕсли;
	
	СтатусыКодов = Перечисление_СтатусыКодов();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	СвязиКлючейКодов.КлючКода КАК КлючКода
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО СвязиКлючейКодов.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО СвязиКлючейКодов.КлючКода = КодыДокументов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ПО СвязиКлючейКодов.КлючКода = КодыОпераций.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|		ПО СвязиКлючейКодов.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода
	|ГДЕ
	|	СвязиКлючейКодов.КлючКода В(&КлючиКодов)
	|	И СвязиКлючейКодов.КлючАгрегата = &ПустойКлюч
	|	И КодыОпераций.КлючКода ЕСТЬ NULL
	|	И КодыДокументов.КлючКода ЕСТЬ NULL
	|	И ИнформацияОКодах.ДляНанесения
	|	И ИнформацияОКодах.ЗаказКодов <> &ПустойЗаказ
	|	И ИнформацияОКодах.ДатаПечати = &ПустаяДата
	|	И ВЫБОР
	|			КОГДА ИнформацияОКодах.ВидПродукции В (&ВидыПродукцииСНанесением)
	|				ТОГДА ЕСТЬNULL(СтатусыКодов.Статус, &ПустойСтатусКода) В (&ПустойСтатусКода, &СтатусКодаВыпущен)
	|			ИНАЧЕ ЕСТЬNULL(СтатусыКодов.Статус, &ПустойСтатусКода) В (&ПустойСтатусКода, &СтатусКодаВыпущен, &СтатусКодаНанесен)
	|		КОНЕЦ");
	Запрос.УстановитьПараметр("КлючиКодов", КлючиКодов);
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	Запрос.УстановитьПараметр("ПустойКлюч", ПустойУникальныйИдентификатор());
	Запрос.УстановитьПараметр("ПустойЗаказ", Справочники.КонтурМаркировка_Операции.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустойСтатусКода", "");
	Запрос.УстановитьПараметр("СтатусКодаВыпущен", СтатусыКодов.Выпущен);
	Запрос.УстановитьПараметр("СтатусКодаНанесен", СтатусыКодов.Нанесен);
	Запрос.УстановитьПараметр("ВидыПродукцииСНанесением", ДопустимыеВидыПродукцииДляОтчетаОНанесении());
	
	ТаблицаКодов = Запрос.Выполнить().Выгрузить();
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов_ДополнитьКолонки(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	ПолныеКоды_Прочитать(ТаблицаКодов);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Для каждого Стр Из ТаблицаЗначений_Разбить(ТаблицаКодов, "ЗаказКодов") Цикл
			
			МассивСтрок = Стр.МассивСтрок;
			ЗаказКодов = Стр.ЗаказКодов;
			Если Не ЗначениеЗаполнено(ЗаказКодов) Тогда
				Продолжить;
			КонецЕсли;
			
			ТаблицаКодовЗаказа = Новый_ТаблицаКодов();
			Для каждого СтрКода Из МассивСтрок Цикл
				Если ЗначениеЗаполнено(СтрКода.ПолныйКод) Тогда
					ЗаполнитьЗначенияСвойств(ТаблицаКодовЗаказа.Добавить(), СтрКода);
				КонецЕсли;
			КонецЦикла;
			
			Если Не ЗначениеЗаполнено(ТаблицаКодовЗаказа) Тогда
				Продолжить;
			КонецЕсли;
			
			ТаблицаКодовЗаказа.ЗаполнитьЗначения(Неопределено, "Серия");
			ТаблицаКодовЗаказа.ЗаполнитьЗначения(Неопределено, "КлючНоменклатуры1С");
			ТаблицаКодов_ПодобратьКлючиНоменклатуры1С(ТаблицаКодовЗаказа);
			КодыЗаказов_Записать(ТаблицаКодовЗаказа, ЗаказКодов, Ложь);
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция КодыЗаказов_Подобрать(ТребуемыеКоды, ЗаказКодов = Неопределено) Экспорт
	
	Результат = Новый_ТаблицаКодов();
	СтарыеЗаказы = ЗаказыСИстекшимСрокомЖизниКодов();
	
	Для каждого СтрТреб Из ТребуемыеКоды Цикл
		
		ВариантыАналитики = ВариантыАналитикиДляПодбораКодов(СтрТреб);
		
		Для каждого ЗначенияАналитики Из ВариантыАналитики Цикл
			
			Если ЗначениеЗаполнено(СтрТреб.КоличествоКодовТребуется)
				И СтрТреб.КоличествоКодовТребуется = СтрТреб.КоличествоКодовПодобрано Тогда
				Прервать;
			КонецЕсли;
			
			Запрос = Новый Запрос(КодыЗаказов_Подобрать_ТекстЗапроса_ПодходящиеКоды(ЗначенияАналитики, СтрТреб, ЗаказКодов));
			Запрос.УстановитьПараметр("СтарыеЗаказы", СтарыеЗаказы);
			Запрос.УстановитьПараметр("ЗаказКодов", ЗаказКодов);
			Для каждого Колонка Из ВариантыАналитики.Колонки Цикл
				Запрос.УстановитьПараметр(Колонка.Имя, ЗначенияАналитики[Колонка.Имя]);
			КонецЦикла;
			
			// BSLLS:CreateQueryInCycle-off
			Выборка = Запрос.Выполнить().Выбрать();
			// BSLLS:CreateQueryInCycle-on
			Пока Выборка.Следующий() Цикл
				
				КоличествоКодовТребуется = СтрТреб.КоличествоКодовТребуется - СтрТреб.КоличествоКодовПодобрано;
				КоличествоКодов = Мин(КоличествоКодовТребуется, Выборка.КоличествоКодов);
				ТаблицаКодов = КодыЗаказов_ИзвлечьИзФайла(КоличествоКодов, Выборка.ЗаказКодов, Выборка.Товар, Выборка.КлючНоменклатуры1С);
				СтрТреб.КоличествоКодовПодобрано = СтрТреб.КоличествоКодовПодобрано + ТаблицаКодов.Количество();
				
				Если ЗначениеЗаполнено(СтрТреб.НовыйКлючСтрокиДокумента) Тогда
					ТаблицаКодов.ЗаполнитьЗначения(СтрТреб.НовыйКлючСтрокиДокумента, "КлючСтрокиДокумента");
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрТреб.НовыйКлючСтрокиОперации) Тогда
					ТаблицаКодов.ЗаполнитьЗначения(СтрТреб.НовыйКлючСтрокиОперации, "КлючСтрокиОперации");
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрТреб.КлючНоменклатуры1С) Тогда
					ТаблицаКодов.ЗаполнитьЗначения(СтрТреб.КлючНоменклатуры1С, "КлючНоменклатуры1С");
				КонецЕсли;
				
				ТаблицаЗначений_Дополнить(Результат, ТаблицаКодов);
				
				Если ЗначениеЗаполнено(СтрТреб.КоличествоКодовТребуется)
					И СтрТреб.КоличествоКодовТребуется = СтрТреб.КоличествоКодовПодобрано Тогда
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаКодов_ЗаписатьВсюИнформацию(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция КодыЗаказов_Подобрать_ТекстЗапроса_ПодходящиеКоды(ЗначенияАналитики, СтрТреб, ЗаказКодов = Неопределено)
	
	ШаблонТекстаЗапросаСНоменклатурой =
	"ВЫБРАТЬ
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С
	|ПОМЕСТИТЬ ПодходящиеКлючи
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КлючиАналитикиНоменклатуры1С КАК Т
	|ГДЕ
	|	Т.КлючНоменклатуры = &КлючНоменклатуры
	|	И Т.КлючХарактеристики = &КлючХарактеристики
	|	И Т.КлючУпаковки = &КлючУпаковки
	|	И Т.КлючСерии = &КлючСерии
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючНоменклатуры1С
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КодыЗаказов.ЗаказКодов КАК ЗаказКодов,
	|	КодыЗаказов.Товар КАК Товар,
	|	КодыЗаказов.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	КодыЗаказов.КоличествоКодов КАК КоличествоКодов,
	|	КодыЗаказов.ЗаказКодов.Дата КАК ДатаЗаказа,
	|	КодыЗаказов.ЗаказКодов.Код КАК НомерЗаказа
	|ИЗ
	|	ПодходящиеКлючи КАК ПодходящиеКлючи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыЗаказов КАК КодыЗаказов
	|		ПО ПодходящиеКлючи.КлючНоменклатуры1С = КодыЗаказов.КлючНоменклатуры1С
	|			И (&Товар)
	|ГДЕ
	|	НЕ КодыЗаказов.ЗаказКодов В (&СтарыеЗаказы)
	|	И &ЗаказКодов
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаЗаказа,
	|	НомерЗаказа";
	
	ШаблонТекстаЗапросаБезНоменклатуры =
	"ВЫБРАТЬ
	|	КодыЗаказов.ЗаказКодов КАК ЗаказКодов,
	|	КодыЗаказов.Товар КАК Товар,
	|	КодыЗаказов.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	КодыЗаказов.КоличествоКодов КАК КоличествоКодов,
	|	КодыЗаказов.ЗаказКодов.Дата КАК ДатаЗаказа,
	|	КодыЗаказов.ЗаказКодов.Код КАК НомерЗаказа
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыЗаказов КАК КодыЗаказов
	|ГДЕ
	|	&Товар
	|	И &ЗаказКодов
	|	И НЕ КодыЗаказов.ЗаказКодов В (&СтарыеЗаказы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаЗаказа,
	|	НомерЗаказа";
	
	Если ЗначениеЗаполнено(ЗначенияАналитики.КлючНоменклатуры) Тогда
		Результат = ШаблонТекстаЗапросаСНоменклатурой;
	Иначе
		Результат = ШаблонТекстаЗапросаБезНоменклатуры;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвойствоСтруктуры(ЗначенияАналитики, "Товар")) Тогда
		Условие = "КодыЗаказов.Товар = &Товар";
		Результат = СтрЗаменить(Результат, "&Товар", Условие);
	Иначе
		Результат = СтрЗаменить(Результат, "&Товар", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаказКодов) Тогда
		Условие = "КодыЗаказов.ЗаказКодов = &ЗаказКодов";
		Результат = СтрЗаменить(Результат, "&ЗаказКодов", Условие);
	Иначе
		Результат = СтрЗаменить(Результат, "&ЗаказКодов", "ИСТИНА");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КодыЗаказов_ИзвлечьИзФайла(КоличествоКодовТребуется, ЗаказКодов, Товар, КлючНоменклатуры1С)
	
	ВидПродукции = Товар.ВидПродукции;
	ОбщийТипУпаковки = ОбщийТипУпаковкиПоТипуКодаМаркировки(Товар.ТипКодаМаркировки);
	ТипУпаковки = Перечисления.КонтурМаркировка_ТипыУпаковок.МаркированныйТовар;
	ТипШтрихкода = Перечисления.КонтурМаркировка_ТипыШтрихкодов.GS1_DataMatrix;
	
	Результат = Новый_ТаблицаКодов();
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыЗаказов_Заблокировать(ЗаказКодов);
		
		Файл = Файл_Найти(ЗаказКодов, Перечисление_ТипыФайлов().КодыЗаказа);
		Файл_Заблокировать(Файл);
		ОписаниеФайла = Файл_Прочитать(Файл);
		
		ИзвлеченоКодов = 0;
		Для Сч = -(ОписаниеФайла.ДанныеФайла.Количество() - 1) По 0 Цикл
			
			Стр = ОписаниеФайла.ДанныеФайла[-Сч];
			
			Если Стр.Товар = Товар И Стр.КлючНоменклатуры1С = КлючНоменклатуры1С Тогда
				
				СтрКода = Результат.Добавить();
				ЗаполнитьЗначенияСвойств(СтрКода, Стр);
				
				СтрКода.ОбщийТипУпаковки = ОбщийТипУпаковки;
				СтрКода.ТипУпаковки = ТипУпаковки;
				СтрКода.ТипШтрихкода = ТипШтрихкода;
				СтрКода.ВидПродукции = ВидПродукции;
				СтрКода.ДляНанесения = Истина;
				СтрКода.ЗаказКодов = ЗаказКодов;
				
				ОписаниеФайла.ДанныеФайла.Удалить(Стр);
				
				ИзвлеченоКодов = ИзвлеченоКодов + 1;
				Если ИзвлеченоКодов = КоличествоКодовТребуется Тогда
					Прервать;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ОписаниеФайла.ДанныеФайла) Тогда
			Файл_Записать(ОписаниеФайла);
		Иначе
			Файлы_Удалить(Файл);
		КонецЕсли;
		
		Набор = РегистрыСведений.КонтурМаркировка_КодыЗаказов.СоздатьНаборЗаписей();
		Набор.Отбор.ЗаказКодов.Установить(ЗаказКодов);
		Набор.Загрузить(КодыЗаказов_ТаблицаЗаказа(ОписаниеФайла.ДанныеФайла, ЗаказКодов));
		Набор.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура КодыЗаказов_Заблокировать(ЗаказКодов)
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КонтурМаркировка_КодыЗаказов");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("ЗаказКодов", ЗаказКодов);
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

Функция КодыЗаказов_ТаблицаЗаказа(ТаблицаКодов, ЗаказКодов)
	
	ПоляАналитики = "Товар, КлючНоменклатуры1С";
	Результат = ТаблицаКодов.Скопировать(, ПоляАналитики);
	
	Результат.Колонки.Добавить("КоличествоКодов", Новый ОписаниеТипов("Число"));
	Результат.ЗаполнитьЗначения(1, "КоличествоКодов");
	Результат.Свернуть(ПоляАналитики, "КоличествоКодов");
	
	Результат.Колонки.Добавить("ЗаказКодов", Новый ОписаниеТипов("СправочникСсылка.КонтурМаркировка_Операции"));
	Результат.ЗаполнитьЗначения(ЗаказКодов, "ЗаказКодов");
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // КодыЗаказов

// #Область Нормализатор

Функция РазобратьКодМаркировки(Знач ДанныеДляРазбора, ВидыПродукции = Неопределено)
	
	ПримечаниеКРезультатуРазбора = Новый Структура("ИдентификаторОшибки, ТекстОшибки, РезультатРазбора", "", "", Неопределено);
	
	ИдентификаторыОшибок = ИдентификаторыОшибокРазобраКодаМаркировки();
	
	Настройки = НастройкиРазбораКодаМаркировки(ВидыПродукции);
	
	ВидыПродукцииДляФильтра = Новый Массив;
	Если ЗначениеЗаполнено(ВидыПродукции) И ТипЗнч(ВидыПродукции) = Тип("ПеречислениеСсылка.КонтурМаркировка_ВидыПродукции") Тогда
		ВидыПродукцииДляФильтра.Добавить(ВидыПродукции);
	ИначеЕсли ЗначениеЗаполнено(ВидыПродукции) И ТипЗнч(ВидыПродукции) = Тип("Массив") Тогда
		Для Каждого Значение Из ВидыПродукции Цикл
			Если ЗначениеЗаполнено(Значение) И ТипЗнч(Значение) = Тип("ПеречислениеСсылка.КонтурМаркировка_ВидыПродукции") Тогда
				ВидыПродукцииДляФильтра.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	СвернутьМассив_Марк(ВидыПродукцииДляФильтра);
	
	ФильтрПоВидуПродукции = Новый Структура("Использовать, ВидыПродукции", Ложь, Неопределено);
	Если ВидыПродукцииДляФильтра.Количество() > 0 Тогда
		ФильтрПоВидуПродукции.Использовать = Истина;
		ФильтрПоВидуПродукции.ВидыПродукции = Новый ФиксированныйМассив(ВидыПродукцииДляФильтра);
	КонецЕсли;
	
	РезультатРазбора = Неопределено;
	Если ТипЗнч(ДанныеДляРазбора) = Тип("Строка") Тогда
		Если Найти(ДанныеДляРазбора, РазделительGS1()) > 0 Тогда
			РезультатРазбора = РазобратьСтрокуШтрихкодаGS1(ДанныеДляРазбора);
		КонецЕсли;
	Иначе
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Данные для разбора штрихкода некорректны
		|%1'"), УдалитьНедопустимыеСимволыXML(ДанныеДляРазбора));
	КонецЕсли;
	
	Если РезультатРазбора = Неопределено Тогда
		
		СодержитGS1 = Ложь;
		НачинаетсяСоСкобки = СтрокаНачинаетсяС(ДанныеДляРазбора, "(");
		КодМаркировки = ДанныеДляРазбора;
		
	Иначе
		
		Если Не РезультатРазбора.Разобран Тогда
			ВызватьИсключение ПараметрыВСтроку(НСтр(
			"ru = 'Не удалось разобрать штрихкод
			|%1
			|%2'"), РезультатРазбора.ОписаниеОшибки, УдалитьНедопустимыеСимволыXML(ДанныеДляРазбора));
		КонецЕсли;
		
		СодержитGS1 = Истина;
		НачинаетсяСоСкобки = Ложь;
		КодМаркировки = РезультатРазбора.ПредставлениеШтрихкода;
		
	КонецЕсли;
	
	ДлинаКодаМаркировки = СтрДлина(КодМаркировки);
	
	ПараметрыРазбораКодаМаркировки = Новый Структура;
	ПараметрыРазбораКодаМаркировки.Вставить("КодМаркировки"			, КодМаркировки);
	ПараметрыРазбораКодаМаркировки.Вставить("НачинаетсяСоСкобки"	, НачинаетсяСоСкобки);
	ПараметрыРазбораКодаМаркировки.Вставить("СодержитGS1"			, СодержитGS1);
	ПараметрыРазбораКодаМаркировки.Вставить("РезультатРазбора"		, РезультатРазбора);
	ПараметрыРазбораКодаМаркировки.Вставить("ДлинаКодаМаркировки"	, ДлинаКодаМаркировки);
	ПараметрыРазбораКодаМаркировки.Вставить("ФильтрПоВидуПродукции"	, ФильтрПоВидуПродукции);
	
	НайденныеШаблоны = ШаблонРазбораКодаМаркировки(ПараметрыРазбораКодаМаркировки, Настройки);
	
	Результат = Новый Массив;
	
	Для Каждого ШаблонКодаМаркировки Из НайденныеШаблоны Цикл
		ДанныеРезультата = КодМаркировкиСоответствуетШаблону(ПараметрыРазбораКодаМаркировки, Настройки, ШаблонКодаМаркировки);
		Если ДанныеРезультата <> Неопределено Тогда
			Результат.Добавить(ДанныеРезультата);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		
		ДанныеРезультата = Неопределено;
		
		Если ЭтоНеформализованныйКодМаркировки(ПараметрыРазбораКодаМаркировки, Настройки, ДанныеРезультата) Тогда
			Возврат ДанныеРезультата;
			КонецЕсли;
		
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Код маркировки не соответствует ни одному шаблону
		|%1'"), УдалитьНедопустимыеСимволыXML(ДанныеДляРазбора));
		
	КонецЕсли;
	
	РезультатПоФильтру = Новый Массив;
	
	Для Каждого ДанныеРезультата Из Результат Цикл
		
		ВидыПродукцииПоФильтру = ВидыПродукцииПоФильтру(ФильтрПоВидуПродукции, ДанныеРезультата.ВидыПродукции);
		
		Если Не ЗначениеЗаполнено(ВидыПродукцииПоФильтру) Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеРезультата.ВидыПродукции = ВидыПродукцииПоФильтру;
		
		РезультатПоФильтру.Добавить(ДанныеРезультата);
		
	КонецЦикла;
	
	Если РезультатПоФильтру.Количество() = 1 Тогда
		
		Возврат РезультатПоФильтру[0];
		
	ИначеЕсли РезультатПоФильтру.Количество() > 1 Тогда
		
		ДанныеРезультата = Неопределено;
		
		Если ОбработатьРезультатНесколькихШаблонов(РезультатПоФильтру, ДанныеРезультата) Тогда
			Возврат ДанныеРезультата;
		КонецЕсли;
		
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Код маркировки соответствует нескольким шаблонам
		|%1'"), УдалитьНедопустимыеСимволыXML(ДанныеДляРазбора));
		
	Иначе
		
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Код маркировки соответствует другим видам продукции
		|%1'"), УдалитьНедопустимыеСимволыXML(ДанныеДляРазбора));
		
	КонецЕсли;
	
КонецФункции

Функция КодМаркировкиСоответствуетШаблону(ПараметрыРазбораКодаМаркировки, Настройки, ШаблонКодаМаркировки)
	
	ДанныеШаблона = Настройки.ШаблоныИОписанияВидовПродукции[ШаблонКодаМаркировки.Шаблон];
	
	СоставКодаМаркировки = СкопироватьОбъект(ДанныеШаблона.СоставКодаМаркировки);
	
	ПараметрыОписанияКодаМаркировки = Новый Структура;
	ПараметрыОписанияКодаМаркировки.Вставить("ОписаниеКодаМаркировки",      ДанныеШаблона.ОписаниеКодаМаркировки);
	ПараметрыОписанияКодаМаркировки.Вставить("Шаблон",                      ШаблонКодаМаркировки.Шаблон);
	ПараметрыОписанияКодаМаркировки.Вставить("ТипШтрихкода",                ШаблонКодаМаркировки.ТипШтрихкода);
	ПараметрыОписанияКодаМаркировки.Вставить("ВидУпаковки",                 ШаблонКодаМаркировки.ВидУпаковки);
	
	ЗначенияЭлементовКМ = Новый Соответствие;
	
	Если Не КодМаркировкиСоответствуетОписанию(ПараметрыРазбораКодаМаркировки, ПараметрыОписанияКодаМаркировки, СоставКодаМаркировки, ЗначенияЭлементовКМ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеРезультата = НовыйРезультатРазбораКодаМаркировки();
	ДанныеРезультата.КодМаркировки        = ПараметрыРазбораКодаМаркировки.КодМаркировки;
	ДанныеРезультата.ТипШтрихкода         = ШаблонКодаМаркировки.ТипШтрихкода;
	ДанныеРезультата.ВидУпаковки          = ШаблонКодаМаркировки.ВидУпаковки;
	ДанныеРезультата.ВидыПродукции        = ДанныеШаблона.ВидыПродукции;
	ДанныеРезультата.СоставКодаМаркировки = СоставКодаМаркировки;
	
	ВидПродукции = Неопределено;
	Если ДанныеШаблона.ВидыПродукции.Количество() = 1 Тогда
		ВидПродукции = ДанныеШаблона.ВидыПродукции[0];
	ИначеЕсли ПараметрыРазбораКодаМаркировки.ФильтрПоВидуПродукции.Использовать Тогда
		Для Каждого ТекВидПродукции Из ПараметрыРазбораКодаМаркировки.ФильтрПоВидуПродукции.ВидыПродукции Цикл
			Если ДанныеШаблона.ВидыПродукции.Найти(ТекВидПродукции) <> Неопределено Тогда
				Если ВидПродукции <> Неопределено Тогда
					// Подходят разные виды продукции
					ВидПродукции = Неопределено;
					Прервать;
				КонецЕсли;
				ВидПродукции = ТекВидПродукции;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ДанныеРезультата.НормализованныйКодМаркировки = НормализоватьКодМаркировки(ДанныеРезультата, ВидПродукции);
	
	Возврат ДанныеРезультата;
	
КонецФункции

Функция НастройкиРазбораКодаМаркировки(ВидПродукции = Неопределено)
	
	КлючКэш = "НастройкиРазбораКодаМаркировки " + ВидПродукции;
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ВидПродукции = Неопределено Тогда
		ДоступныеВидыПродукции = ВсеВидыПродукции();
	Иначе
		ДоступныеВидыПродукции = ЗначениеВМассиве(ВидПродукции);
	КонецЕсли;
	
	Результат = Новый_НастройкиРазбораКодаМаркировки();
	Результат.ДоступныеВидыПродукции = ДоступныеВидыПродукции;
	Результат.Алфавит = ДопустимыеСимволыВКодеМаркировки();
	
	Для Каждого ДоступныйВидПродукции Из ДоступныеВидыПродукции Цикл
		ДополнитьНастройкиРазбораКодаМаркировки(Результат, ДоступныйВидПродукции);
	КонецЦикла;
	ТаблицаЗначений_СвернутьПоВсемКолонкам(Результат.ШаблоныКодовМаркировкиПоВидамПродукции);
	
	ТаблицаЗначений_Дополнить(Результат.ШаблоныКодовМаркировки, Результат.ШаблоныКодовМаркировкиПоВидамПродукции);
	ТаблицаЗначений_СвернутьПоВсемКолонкам(Результат.ШаблоныКодовМаркировки);
	Результат.ШаблоныКодовМаркировки.Сортировать("ДлинаСоСкобкой, Длина");
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция Новый_НастройкиРазбораКодаМаркировки()
	
	ШаблоныКодовМаркировки = Новый ТаблицаЗначений;
	ШаблоныКодовМаркировки.Колонки.Добавить("Шаблон",              Новый ОписаниеТипов("Строка"));
	ШаблоныКодовМаркировки.Колонки.Добавить("ТипШтрихкода",        Новый ОписаниеТипов("ПеречислениеСсылка.КонтурМаркировка_ТипыШтрихкодов"));
	ШаблоныКодовМаркировки.Колонки.Добавить("ВидУпаковки",         Новый ОписаниеТипов("ПеречислениеСсылка.КонтурМаркировка_ВидыУпаковок"));
	ШаблоныКодовМаркировки.Колонки.Добавить("КоличествоЭлементов", Новый ОписаниеТипов("Число"));
	ШаблоныКодовМаркировки.Колонки.Добавить("НачинаетсяСоСкобки",  Новый ОписаниеТипов("Булево"));
	ШаблоныКодовМаркировки.Колонки.Добавить("Длина",               Новый ОписаниеТипов("Число"));
	ШаблоныКодовМаркировки.Колонки.Добавить("ДлинаСоСкобкой",      Новый ОписаниеТипов("Число"));
	ШаблоныКодовМаркировки.Колонки.Добавить("КодПервогоЭлемента",  Новый ОписаниеТипов("Строка"));
	ШаблоныКодовМаркировки.Колонки.Добавить("РегулярноеВыражение", Новый ОписаниеТипов("Строка"));
	
	ШаблоныКодовМаркировкиПоВидамПродукции = ШаблоныКодовМаркировки.СкопироватьКолонки();
	ШаблоныКодовМаркировкиПоВидамПродукции.Колонки.Добавить("ВидПродукции", Новый ОписаниеТипов("ПеречислениеСсылка.КонтурМаркировка_ВидыПродукции"));
	
	Настройки = Новый Структура;
	Настройки.Вставить("ДоступныеВидыПродукции",                 Новый Массив);
	Настройки.Вставить("Алфавит",                                Новый Структура);
	Настройки.Вставить("ШаблоныКодовМаркировкиПоВидамПродукции", ШаблоныКодовМаркировкиПоВидамПродукции);
	Настройки.Вставить("ШаблоныКодовМаркировки",                 ШаблоныКодовМаркировки);
	Настройки.Вставить("ШаблоныИОписанияВидовПродукции",         Новый Соответствие);
	
	Возврат Настройки;
	
КонецФункции

Функция ОписанияШаблоновКодаМаркировки(ОписаниеЭлементовКМ, ШаблоныСтрокой)
	
	СписокОписанийШаблонов = Новый Массив;
	
	Для Каждого ШаблонСтрокой Из ШаблоныСтрокой Цикл
		
		ОписаниеШаблонаКМ = Новый Массив;
		
		СписокЭлементовКМ = РазделитьСтроку(ШаблонСтрокой, "+");
		Для Каждого ИмяЭлементаКМ Из СписокЭлементовКМ Цикл
			
			ОписаниеЭлементаКМ = ОписаниеЭлементовКМ[СокрЛП(ИмяЭлементаКМ)];
			
			ОписаниеШаблонаКМ.Добавить(ОписаниеЭлементаКМ);
			
		КонецЦикла;
		
		СписокОписанийШаблонов.Добавить(ОписаниеШаблонаКМ);
		
	КонецЦикла;
	
	Возврат СписокОписанийШаблонов;
	
КонецФункции

Процедура ЗаполнитьВРегулярныхВыраженияхКодовМаркировкиРазделительGS1(РегулярныеВыражения)
	
	Разделитель = РазделительGS1();
	
	Для Сч = 0 По РегулярныеВыражения.ВГраница() Цикл
		РегулярныеВыражения[Сч] = ПараметрыВСтроку(РегулярныеВыражения[Сч], Разделитель);
	КонецЦикла;
	
КонецПроцедуры

// Формирует описание элемента для кода маркировки
// 
// Параметры:
// 	Код - Строка - Код элемента.
// 	Имя - Строка - Имя элемента.
// 	КоличествоЗнаков - Число - Число знаков.
// 	АлфавитДопустимыхСимволов - Строка - Если заполнено, то определяет какими символами может быть заполнено значение элемента.
// Возвращаемое значение:
// 	Структура - описание элемента для кода маркировки:
// * Код - Строка - Код элемента.
// * Имя - Строка - Имя элемента.
// * Длина - Число - Число знаков.
// * Алфавит - Строка - Если заполнено, то определяет какими символами может быть заполнено значение элемента.
Функция ОписаниеЭлементаКодаМаркировки(Код, Имя, КоличествоЗнаков, АлфавитДопустимыхСимволов = "")
	ОписаниеКода = Новый Структура;
	ОписаниеКода.Вставить("Код",     Код);
	ОписаниеКода.Вставить("Имя",     Имя);
	ОписаниеКода.Вставить("Длина",   КоличествоЗнаков);
	ОписаниеКода.Вставить("Алфавит", АлфавитДопустимыхСимволов);
	Возврат ОписаниеКода;
КонецФункции

