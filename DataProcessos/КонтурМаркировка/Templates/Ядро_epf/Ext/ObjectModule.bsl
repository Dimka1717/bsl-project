// Добавляет события функциональности в стек метрик и сбрасывает количество использований
//
// Параметры:
//  Стек - Структура - см. Новый_СтекМетрик();
//
Процедура ДобавитьСобытияФункциональностиВСтекМетрик(СтекМетрик)
	
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Действие = Перечисление_ДействияМетрики().ОтправкаМетрик;
	Категория = Перечисление_КатегорииМетрики().Функциональность;
	
	Для каждого Стр Из ВсяФункциональностьСтекаМетрик(СтекМетрик) Цикл
		
		Идентификатор = Стр.Организация.Идентификатор;
		
		Если Не ЗначениеЗаполнено(Идентификатор)
			Или Не ЗначениеЗаполнено(Стр.КоличествоИспользований) Тогда
			Продолжить;
		КонецЕсли;
		
		ДопСведения = Новый Структура("КоличествоИспользований", Стр.КоличествоИспользований);
		ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения, Идентификатор, Стр.Функциональность);
		ОписаниеМетрики.Организация = Стр.Организация;
		СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики, Ложь);
		
	КонецЦикла;
	
	Для каждого Элемент1 Из СтекМетрик.ФункциональностьПоОрганизациям Цикл
		НаборФункций = Элемент1.Значение;
		Для каждого Элемент2 Из НаборФункций Цикл
			НаборФункций[Элемент2.Ключ] = 0;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Добавляет в описания метрик производительности ветку, версию обработки и тип замера
//
// Параметры:
//  СтекМетрик - Массив - см. Новый_СтекМетрик();
//
Процедура ДополнитьЗамерыПроизводительностиВСтекеМетрик(СтекМетрик)
	
	ОписанияМетрик = СтекМетрик.Топики[Перечисление_ТопикиМетрики().Здоровье];
	Если Не ЗначениеЗаполнено(ОписанияМетрик) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыЗамеров = Перечисление_ТипыЗамеровПроизводительности();
	
	ИмяВетки = ИмяВетки();
	ВерсияОбработки = ВерсияОбработки();
	НастройкиМодуля = НастройкиМодуля();
	
	Для Каждого ОписаниеМетрики Из ОписанияМетрик Цикл
		
		ОписаниеМетрики.ДопСведения.Вставить("Ветка", ИмяВетки);
		ОписаниеМетрики.ДопСведения.Вставить("ВерсияМодуля", ВерсияОбработки);
		
		Если НастройкиМодуля.СинтетическийЗамерПроизводительности Тогда
			ОписаниеМетрики.Метка = ТипыЗамеров.Синтетический;
		ИначеЕсли НастройкиМодуля.ТестовоеОкружение Тогда
			ОписаниеМетрики.Метка = ТипыЗамеров.Тестовый;
		Иначе
			ОписаниеМетрики.Метка = ТипыЗамеров.Продуктивный;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОписаниеЗначенияПеременнойМетрики(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Число") Тогда
		type = "number";
		value = ЧислоXML(Значение);
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		type = "string";
		value = СокрЛП(Значение);
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		type = "uuid";
		value = СокрЛП(Значение);
	ИначеЕсли ТипЗначения = Тип("ДвоичныеДанные") Тогда
		type = "base64";
		value = Base64Строка(Значение);
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		type = "string";
		value = БулевоXML(Значение);
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		type = "string";
		value = ЛокальнаяДатаXML(Значение);
	ИначеЕсли ЭтоСсылка(Значение) Тогда
		type = "string";
		value = СокрЛП(Значение);
	Иначе
		ТекстОшибки = НСтр("ru = 'Неизвестное значение переменной для записи в метрики: %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, Значение);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Результат = Новый Структура("type, value", type, value);
	
	Возврат Результат;
	
КонецФункции

Функция ВсяФункциональностьСтекаМетрик(СтекМетрик)
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.КонтурМаркировка_Организации"));
	Результат.Колонки.Добавить("Функциональность", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("КоличествоИспользований", Новый ОписаниеТипов("Число"));
	
	Для каждого Элемент1 Из СтекМетрик.ФункциональностьПоОрганизациям Цикл
		
		Если Элемент1.Ключ = ИмяОбщейОрганизацииДляМетрик() Тогда
			МассивОрганизаций = Организация_ВсеОрганизации();
		Иначе
			МассивОрганизаций = ЗначениеВМассиве(Элемент1.Ключ);
		КонецЕсли;
		
		НаборФункций = Элемент1.Значение;
		
		Для каждого Организация Из МассивОрганизаций Цикл
			Для каждого Элемент2 Из НаборФункций Цикл
				Стр = Результат.Добавить();
				Стр.Организация = Организация;
				Стр.Функциональность = Элемент2.Ключ;
				Стр.КоличествоИспользований = Элемент2.Значение;
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
	Результат.Сортировать("Организация");
	
	Возврат Результат;
	
КонецФункции

