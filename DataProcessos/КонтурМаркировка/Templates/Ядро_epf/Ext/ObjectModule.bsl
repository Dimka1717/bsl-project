Функция ПараметрыСессии_Прочитать(Ключ)
	
	Попытка
		Параметры = ПараметрыСеанса.КонтурМаркировка_ПараметрыСессии.Получить();
		Результат = Параметры.Получить(Ключ);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура ПараметрыСессии_Поместить(Ключ, Значение)
	
	Попытка
		Параметры = ПараметрыСеанса.КонтурМаркировка_ПараметрыСессии.Получить();
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Соответствие;
	КонецЕсли;
	
	Параметры.Вставить(Ключ, Значение);
	ПараметрыСеанса.КонтурМаркировка_ПараметрыСессии = Новый ХранилищеЗначения(Параметры);
	
КонецПроцедуры

