	ЦенаАкциза = 0;
	Если ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Пиво Тогда
		ЦенаАкциза = РублиВКопейки(СтрТовара.СуммаАкциза);
	КонецЕсли;
	
	ОписаниеРД = Новый_Контент_ВводВОборот_ОписаниеРД();
