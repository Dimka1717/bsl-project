	ПараметрыСессии_Поместить("ИдентификаторСеанса", Новый УникальныйИдентификатор);
	ПараметрыСессии_Поместить("ПутьКФайлуМодуля", ПутьКФайлуМодуля);
	
	СтекМетрик_Поместить(Новый_СтекМетрик());
	
