	ТипыБизнесПроцессовОпераций_Добавить(Результат, ТипыОпер.УведомлениеОПриемке,                          ТипыПроц.УведомлениеОПриемке);
	ТипыБизнесПроцессовОпераций_Добавить(Результат, ТипыОпер.РегистрацияКИГУ,                              ТипыПроц.РегистрацияКИГУ);
	ТипыБизнесПроцессовОпераций_Добавить(Результат, ТипыОпер.РегистрацияСтрокиКИГУ,                        ТипыПроц.РегистрацияКИГУ);
	ТипыБизнесПроцессовОпераций_Добавить(Результат, ТипыОпер.ВозвратВОборот,                               ТипыПроц.ВозвратВОборот);
	ТипыБизнесПроцессовОпераций_Добавить(Результат, ТипыОпер.ВозвратВОборотНаТСД,                          ТипыПроц.ВозвратВОборотНаТСД);
	ТипыБизнесПроцессовОпераций_Добавить(Результат, ТипыОпер.ДобавлениеВАгрегат,                           ТипыПроц.ТрансформацияАгрегатов);
	ТипыБизнесПроцессовОпераций_Добавить(Результат, ТипыОпер.ИзъятиеИзАгрегата,                            ТипыПроц.ТрансформацияАгрегатов);
	ТипыБизнесПроцессовОпераций_Добавить(Результат, ТипыОпер.ФормированиеАТК,                              ТипыПроц.ФормированиеАТК);
	ТипыБизнесПроцессовОпераций_Добавить(Результат, ТипыОпер.РасформированиеАТК,                           ТипыПроц.РасформированиеАТК);
	ТипыБизнесПроцессовОпераций_Добавить(Результат, ТипыОпер.ДобавлениеВАТК,                               ТипыПроц.ТрансформацияАТК);
	ТипыБизнесПроцессовОпераций_Добавить(Результат, ТипыОпер.ИзъятиеИзАТК,                                 ТипыПроц.ТрансформацияАТК);
	ТипыБизнесПроцессовОпераций_Добавить(Результат, ТипыОпер.РегистрацияНаборов,                           ТипыПроц.РегистрацияНаборов);
	ТипыБизнесПроцессовОпераций_Добавить(Результат, ТипыОпер.РегистрацияСтрокиНаборов,                     ТипыПроц.РегистрацияНаборов);
	ТипыБизнесПроцессовОпераций_Добавить(Результат, ТипыОпер.КорректировкаСведенийОКодах,                  ТипыПроц.КорректировкаСведенийОКодах);
	ТипыБизнесПроцессовОпераций_Добавить(Результат, ТипыОпер.РегистрацияСтрокиКорректировкиСведенийОКодах, ТипыПроц.КорректировкаСведенийОКодах);
	ТипыБизнесПроцессовОпераций_Добавить(Результат, ТипыОпер.РасформированиеНаборов,                       ТипыПроц.Разагрегация);
	ТипыБизнесПроцессовОпераций_Добавить(Результат, ТипыОпер.УведомлениеОСостоянииКодов,                   ТипыПроц.УведомлениеОСостоянииКодов);
	ТипыБизнесПроцессовОпераций_Добавить(Результат, ТипыОпер.РегистрацияСтрокиУведомленияОСостоянииКодов,  ТипыПроц.УведомлениеОСостоянииКодов);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Процедура ТипыБизнесПроцессовОпераций_Добавить(ТипыБизнесПроцессовОпераций, ТипОперации, ТипБизнесПроцесса)
	
	Стр = ТипыБизнесПроцессовОпераций.Добавить();
	Стр.ТипОперации = ТипОперации;
	Стр.ТипБизнесПроцесса = ТипБизнесПроцесса;
	
КонецПроцедуры

// Выполняет требуемые действия для задач указанного бизнес процесса
//
// Параметры:
//  ТипБизнесПроцесса - Строка - см. функцию Перечисление_ТипыБизнесПроцессовОчередиЗадач();
//  КонтекстОбмена - Структура - см. функцию Новый_КонтекстОбмена();
//
Процедура ОчередьОбмена_ОбработатьЗадачи(ТипБизнесПроцесса, КонтекстОбмена)
	
	ТипыБизнесПроцессов = Перечисление_ТипыБизнесПроцессовОчередиОбмена();
	БизнесПроцесс = ОчередьОбмена_БизнесПроцесс(ТипБизнесПроцесса);
	
	Организация = КонтекстОбмена.Организация;
	ДокументУчета = КонтекстОбмена.ДокументУчета;
	
	Для Каждого Действие Из БизнесПроцесс Цикл
		
		ОбработанныеОперации = Новый Массив;
		МассивОпераций = ОчередьОбмена_НайтиОперации(Действие, Организация, ДокументУчета);
		
		Пока ЗначениеЗаполнено(МассивОпераций) Цикл
			
			Для Каждого Операция Из МассивОпераций Цикл
				
				Если ОбъектВПроцессеОбновления(Операция)
					Или Не ОчередьОбмена_ОперациюМожноОбработатьВЭтомУзлеРИБ(Операция)
					Или Не ОчередьОбмена_ЗанятьОперациюДляОбмена(Операция) Тогда
					Продолжить;
				КонецЕсли;
				
				ОписаниеЗадачи = Задача_Прочитать(Операция);
				
				Если ОписаниеЗадачи.ТребуемоеДействие = Действие
					И ОписаниеЗадачи.ТипБизнесПроцесса = ТипБизнесПроцесса Тогда
					
					Попытка
						ОчередьОбмена_ВыполнитьЗадачу(ТипБизнесПроцесса, ОписаниеЗадачи);
					Исключение
						ОчередьОбмена_ОсвободитьОперациюПослеОбмена();
						Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке(), Ложь);
					КонецПопытки;
					
				КонецЕсли;
				
				ОчередьОбмена_ОсвободитьОперациюПослеОбмена();
				
			КонецЦикла;
			
			ДополнитьМассив(ОбработанныеОперации, МассивОпераций);
			
			МассивОпераций = ОчередьОбмена_НайтиОперации(Действие, Организация, ДокументУчета, , ОбработанныеОперации);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОчередьОбмена_ВыполнитьЗадачу(ТипБизнесПроцесса, ОписаниеЗадачи)
	
	ТипыБизнесПроцессов = Перечисление_ТипыБизнесПроцессовОчередиОбмена();
	ТипБизнесПроцесса = ОписаниеЗадачи.ТипБизнесПроцесса;
	СтандартнаяОбработка = Истина;
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("ОписаниеЗадачи", ОписаниеЗадачи);
	ПараметрыПМ.Вставить("ТипБизнесПроцесса", ТипБизнесПроцесса);
	ПМ_ОбработатьСобытие_ПриВыполненииЗадачиВОчередиОбмена(ПараметрыПМ, СтандартнаяОбработка);
	
	Если Не СтандартнаяОбработка Тогда
		Задача_Записать(ОписаниеЗадачи);
		Возврат;
	КонецЕсли;
	
	Если ТипБизнесПроцесса = ТипыБизнесПроцессов.УведомлениеОПриемке Тогда
		ОчередьОбмена_УведомлениеОПриемке_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.НаполнениеАгрегатовНаТСД Тогда
		ОчередьОбмена_НаполнениеАгрегатовНаТСД_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.ЗаказКодов Тогда
		ОчередьОбмена_ЗаказКодов_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.ВводВОборот Тогда
		ОчередьОбмена_ВводВОборот_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.Агрегация Тогда
		ОчередьОбмена_Агрегация_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.Отгрузка Тогда
		ОчередьОбмена_Отгрузка_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.ВыводИзОборота Тогда
		ОчередьОбмена_ВыводИзОборота_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.Разагрегация Тогда
		ОчередьОбмена_Разагрегация_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.ОтчетОНанесении Тогда
		ОчередьОбмена_ОтчетОНанесении_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.ОтчетОВыбытии Тогда
		ОчередьОбмена_ОтчетОВыбытии_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.Перемаркировка Тогда
		ОчередьОбмена_Перемаркировка_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.ФормированиеНаборов Тогда
		ОчередьОбмена_НаполнениеНаборовНаТСД_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.ПодборКодовНаТСД Тогда
		ОчередьОбмена_ПодборКодовНаТСД_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.РегистрацияКИГУ Тогда
		ОчередьОбмена_РегистрацияКИГу_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.ВозвратВОборот
		Или ТипБизнесПроцесса = ТипыБизнесПроцессов.ВозвратВОборотНаТСД Тогда
		ОчередьОбмена_ВозвратВОборот_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.ОтменаВыводаИзОборота Тогда
		ОчередьОбмена_ОтменаВыводаИзОборота_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.ТрансформацияАгрегатов Тогда
		ОчередьОбмена_ТрансформацияАгрегатов_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.ФормированиеАТК Тогда
		ОчередьОбмена_ФормированиеАТК_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.РасформированиеАТК Тогда
		ОчередьОбмена_РасформированиеАТК_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.ТрансформацияАТК Тогда
		ОчередьОбмена_ТрансформацияАТК_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.РегистрацияНаборов Тогда
		ОчередьОбмена_РегистрацияНаборов_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.КорректировкаСведенийОКодах Тогда
		ОчередьОбмена_КорректировкаСведенийОКодах_ОбработатьЗадачу(ОписаниеЗадачи);
		
	ИначеЕсли ТипБизнесПроцесса = ТипыБизнесПроцессов.УведомлениеОСостоянииКодов Тогда
		ОчередьОбмена_УведомлениеОСостоянииКодов_ОбработатьЗадачу(ОписаниеЗадачи);
		
	Иначе
		
		ТекстОшибки = НСтр("ru = 'Неизвестный тип бизнес процесса: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, ТипБизнесПроцесса);
		
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает исключительную блокировку в очереди задач по операции
//
// Параметры:
//  ОперацияСсылка - СправочникСсылка.КонтурМаркировка_Операции - операция, по которой нужно заблокировать задачи
//
Процедура ОчередьОбмена_Заблокировать(ОперацияСсылка)
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КонтурМаркировка_ОчередьОбмена");
	ЭлементБлокировки.УстановитьЗначение("Операция", ОперацияСсылка);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

Процедура ОчередьОбмена_ЗаписатьФайлыПодписей(КонтекстОбмена) Экспорт
	
	ВидыСертификатов = Перечисление_ВидыСертификатов();
	ДопСвойства = Перечисление_ДопСвойства();
	
	Для каждого ОписаниеФайла Из КонтекстОбмена.ФайлыДляПодписи Цикл
		
		Если Не ОписаниеФайла.ПодписанЭП Тогда
			Продолжить;
		КонецЕсли;
		
		Файл = ОписаниеФайла.Ссылка;
		Операция = ОписаниеФайла.ВладелецФайла;
		
		Если Не Файл_Существует(Файл)
			Или Файл_Подписан(Файл) Тогда
			Продолжить;
		КонецЕсли;
		
		НачатьТранзакцию(РежимУправленияБлокировкой());
		
		Попытка
			
			Файл_Записать(ОписаниеФайла);
			
			ДопСвойство_Записать(Операция
			, ДопСвойства.Сертификат
			, КонтекстОбмена.Сертификат);
			
			ДопСвойство_Записать(Операция
			, ДопСвойства.Подписант
			, Пользователи_ТекущийПользователь());
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			Ошибка = ИнформацияОбОшибке();
			ВызватьИсключение;
		КонецПопытки;
		
		Если КонтекстОбмена.Сертификат.ВидСертификата = ВидыСертификатов.НаФизЛицо Тогда
			Метрика_Функциональность_ПодписаниеСертификатомПоДоверенности(КонтекстОбмена.Организация);
		КонецЕсли;
		
	КонецЦикла;
	
	КонтекстОбмена.ФайлыДляПодписи.Очистить();
	
КонецПроцедуры

Процедура ОчередьОбмена_УстановитьДействиеОтправитьПодпись(КонтекстОбмена) Экспорт
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Организация = КонтекстОбмена.Организация;
	ДокументУчета = КонтекстОбмена.ДокументУчета;
	
	МассивОпераций = ОчередьОбмена_ОперацииГотовыеКОтправкеПодписи(Организация, ДокументУчета);
	
	Для Каждого Операция Из МассивОпераций Цикл
		
		ОписаниеЗадачи = Задача_Прочитать(Операция);
		ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.Подписан;
		
		Если ОписаниеЗадачи.ТребуемоеДействие = ТребуемыеДействия.ПодписатьФайл Тогда
			ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ОтправитьПодпись;
		ИначеЕсли ОписаниеЗадачи.ТребуемоеДействие = ТребуемыеДействия.ПодписатьФайлЗакрытияЗаказа Тогда
			ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ОтправитьПодписьЗакрытиеЗаказа;
		Иначе
			Продолжить;
		КонецЕсли;
		
		Задача_Записать(ОписаниеЗадачи);
		
	КонецЦикла;
	
КонецПроцедуры

// Подписывает файлы контента
//
// Параметры:
//  КонтекстОбмена - Структура - см. Новый_КонтекстОбмена();
// 
// Возвращаемое значение:
//  Булево - Истина, если подписан хотябы один файл;
//
Функция ОчередьОбмена_ПодписатьФайлы(КонтекстОбмена)
	
	Если Не ЗначениеЗаполнено(КонтекстОбмена.ФайлыДляПодписи) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПроверитьДоступностьПодписиНаСервере(КонтекстОбмена);
	
	Если Не КонтекстОбмена.ДоступнаПодписьНаСервере Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МассивФайлов = МассивСтруктур_Выгрузить(КонтекстОбмена.ФайлыДляПодписи, "ДанныеФайла");
	
	Попытка
		
		Подписи = Плагин_ПодписатьДанные(МассивФайлов, КонтекстОбмена.ОтпечатокСертификата);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Подпись файлов'");
		ДопИнформация = Новый СписокЗначений;
		ДопИнформация.Добавить(КонтекстОбмена.Организация, "Организация");
		ДопИнформация.Добавить(КонтекстОбмена.Сертификат, "Сертификат");
		ДопИнформация.Добавить(КонтекстОбмена.ОтпечатокСертификата, "Отпечаток сертификата");
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
		
		КонтекстОбмена.ТекстОшибки = КраткоеПредставлениеОшибки(Ошибка);
		КонтекстОбмена.НеУдалосьПодписатьФайлы = Истина;
		
		Возврат Ложь;
		
	КонецПопытки;
	
	Для Сч = 0 По КонтекстОбмена.ФайлыДляПодписи.ВГраница() Цикл
		ОписаниеФайла = КонтекстОбмена.ФайлыДляПодписи[Сч];
		ОписаниеФайла.ДанныеФайла = Подписи[Сч];
		ОписаниеФайла.ПодписанЭП = Истина;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ОчередьОбмена_ПрочитатьНовуюПорциюФайловДляПодписи(КонтекстОбмена) Экспорт
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Действия = Новый Массив;
	Действия.Добавить(ТребуемыеДействия.ПодписатьФайл);
	Действия.Добавить(ТребуемыеДействия.ПодписатьФайлЗакрытияЗаказа);
	Организация = КонтекстОбмена.Организация;
	ДокументУчета = КонтекстОбмена.ДокументУчета;
	РазмерПорции = 100;
	МассивОпераций = ОчередьОбмена_НайтиОперации(Действия, Организация, ДокументУчета, РазмерПорции);
	Если Не ЗначениеЗаполнено(МассивОпераций) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПодписанЭП = Ложь;
	ТипФайлов = Перечисление_ТипыФайлов().КонтентДляПодписи;
	МассивФайлов = Файлы_Найти(МассивОпераций, ТипФайлов, ПодписанЭП);
	Если Не ЗначениеЗаполнено(МассивФайлов) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КонтекстОбмена.ФайлыДляПодписи = Файлы_Прочитать(МассивФайлов);
	
	Возврат Истина;
	
КонецФункции

Функция ОчередьОбмена_ЗанятьОперациюДляОбмена(Операция)
	
	КлючКэш = "ОбъектОперацииОбмена";
	ОбъектОперации = Кэш_Прочитать(КлючКэш);
	Если ОбъектОперации = Неопределено
		Или ОбъектОперации.Ссылка <> Операция Тогда
		ОбъектОперации = Операция.ПолучитьОбъект();
	КонецЕсли;
	
	Попытка
		ОбъектОперации.Заблокировать();
		Кэш_Поместить(КлючКэш, ОбъектОперации);
		Результат = Истина;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Результат = Ложь;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_ОсвободитьОперациюПослеОбмена()
	
	КлючКэш = "ОбъектОперацииОбмена";
	ОбъектОперации = Кэш_Прочитать(КлючКэш);
	
	Если ОбъектОперации <> Неопределено Тогда
		Попытка
			ОбъектОперации.Разблокировать();
		Исключение
			Ошибка = ИнформацияОбОшибке();
		КонецПопытки;
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Неопределено);
	
КонецПроцедуры

Функция ОчередьОбмена_ОперациюМожноОбработатьВЭтомУзлеРИБ(Операция)
	
	Настройки = НастройкиМодуля();
	Если Не Настройки.РежимРИБ Тогда
		Возврат Истина;
	КонецЕсли;
	
	ЭтоГлавныйУзел = ЭтоГлавныйУзелРИБ();
	Если Настройки.РазрешитьОбменПоВсемОбъектамВГлавномУзле И ЭтоГлавныйУзел Тогда
		Возврат Истина;
	КонецЕсли;
	
	Номер = ЗначениеРеквизитаОбъекта_Марк(Операция, "Код");
	ПозицияРазделителя = Найти(Номер, "-");
	НомерСодержитПрефикс = ЗначениеЗаполнено(ПозицияРазделителя);
	
	Если Не НомерСодержитПрефикс Тогда
		Возврат ЭтоГлавныйУзел;
	КонецЕсли;
	
	ПрефиксИБ = Настройки.НастройкиУзлаРИБ.ПрефиксИБ;
	ДлинаПрефикса = СтрДлина(ПрефиксИБ);
	ПрефиксНомера = Сред(Номер, ПозицияРазделителя - ДлинаПрефикса, ДлинаПрефикса);
	
	Возврат (ПрефиксНомера = ПрефиксИБ);
	
КонецФункции

// Находит операцию в очереди обмена по идентификатору документа в сервисе
// и проверяет что операция в базе существует
//
// Параметры:
//  ИдентификаторДокумента - Строка - идентификатор операции
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Операции - найденная операция
//  Неопределено - операция не найдена
//
Функция ОчередьОбмена_НайтиОперациюПоИдентификаторуДокумента(ИдентификаторДокумента)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Операции.Ссылка КАК Ссылка
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОчередьОбмена КАК ОчередьОбмена
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции КАК Операции
	|		ПО ОчередьОбмена.Операция = Операции.Ссылка
	|ГДЕ
	|	ОчередьОбмена.ИдентификаторДокумента = &ИдентификаторДокумента");
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
	
	Возврат ПолучитьРезультатЗапроса(Запрос);
	
КонецФункции

Процедура ОчередьОбмена_ЗавершитьПолучениеКодов(Операция) Экспорт
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	ОписаниеЗадачи = Задача_Прочитать(Операция);
	ДанныеРедактора = РедакторКодов_ПолучитьИзФайла(Операция);
	Если ДанныеРедактора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов = ДанныеРедактора.ТаблицаКодов;
	ТипОперации = ЗначениеРеквизитаОбъекта_Марк(Операция, "ТипОперации");
	
	Если ТипОперации = ТипыОпераций.ПодборКодовНаТСД
		Или ТипОперации = ТипыОпераций.ПодборТоваровИКодовНаТСД Тогда
		
		Задача_ПодборКодовНаТСД_ЗавершитьПолучениеКодов(ОписаниеЗадачи, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.ОтчетОНанесенииНаТСД Тогда
		
		Задача_ОтчетОНанесенииНаТСД_ЗавершитьПолучениеКодов(ОписаниеЗадачи, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.ОтчетОВыбытииНаТСД Тогда
		
		Задача_ОтчетОВыбытииНаТСД_ЗавершитьПолучениеКодов(ОписаниеЗадачи, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.НаполнениеОдногоАгрегатаНаТСД Тогда
		
		Задача_НаполнениеАгрегатовНаТСД_ЗавершитьПолучениеКодов(ОписаниеЗадачи, ТаблицаКодов, Истина);
		
	Иначе
		Возврат;
	КонецЕсли;
	
	РедакторКодов_УдалитьФайл(Операция);
	
КонецПроцедуры

Процедура ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи)
	
	ТекстОшибки = НСтр("ru = 'Неизвестное действие ""%1"" для обмена с сервисом по операции: %2'");
	ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, Действие, ОписаниеЗадачи.Операция);
	
КонецПроцедуры

// Удаляет задачу из очереди
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - владелец задачи
//
Процедура Задача_Удалить(Операция) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Задача_Заблокировать(Операция);
		
		Набор = РегистрыСведений.КонтурМаркировка_ОчередьОбмена.СоздатьНаборЗаписей();
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Отбор.Операция.Установить(Операция);
		Набор.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Устанавливает исключительную блокировку в очереди задач по операции
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция, по которой нужно заблокировать очередь
//
Процедура Задача_Заблокировать(Операция)
	
	Объект = "РегистрСведений.КонтурМаркировка_ОчередьОбмена";
	Значения = Новый Структура("Операция", Операция);
	ЗаблокироватьПоЗначениям(Объект, Значения);
	
КонецПроцедуры

Процедура Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи)
	
	Если Не ЗначениеЗаполнено(ОписаниеЗадачи.ОперацияОснование) Тогда
		Возврат;
	КонецЕсли;
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	ПодходящиеДействия = Новый Массив;
	ПодходящиеДействия.Добавить(ТребуемыеДействия.ИсправитьОшибку);
	ПодходящиеДействия.Добавить(ТребуемыеДействия.РаспознатьКоды);
	ПодходящиеДействия.Добавить(ТребуемыеДействия.УстранитьДубли);
	ПодходящиеДействия.Добавить(ТребуемыеДействия.ПринятЧастично);
	ПодходящиеДействия.Добавить(ТребуемыеДействия.ОперацияЗавершена);
	ПодходящиеДействия.Добавить(ТребуемыеДействия.ОбновитьДокументАгрегацииВСервисе);
	
	Если Не МассивСодержитЗначение(ПодходящиеДействия, ОписаниеЗадачи.ТребуемоеДействие) Тогда
		Возврат;
	КонецЕсли;
	
	Операция_ПроверитьСтатусОбменаПодчиненныхОпераций(ОписаниеЗадачи.ОперацияОснование);
	
КонецПроцедуры

Функция Задача_ЕстьОшибкиВПодчиненныхОперациях(ОперацияОснование, ТипОпераций)
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Ошибки = Новый Массив;
	Ошибки.Добавить(ТребуемыеДействия.ИсправитьОшибку);
	Ошибки.Добавить(ТребуемыеДействия.РаспознатьКоды);
	Ошибки.Добавить(ТребуемыеДействия.УстранитьДубли);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Операции.Ссылка КАК Операция
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Операции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ОчередьОбмена КАК ОчередьОбмена
	|		ПО Операции.Ссылка = ОчередьОбмена.Операция
	|ГДЕ
	|	Операции.ОперацияОснование = &ОперацияОснование
	|	И Операции.ТипОперации = &ТипОпераций
	|	И ОчередьОбмена.ТребуемоеДействие В(&Ошибки)");
	Запрос.УстановитьПараметр("ОперацияОснование", ОперацияОснование);
	Запрос.УстановитьПараметр("ТипОпераций", ТипОпераций);
	Запрос.УстановитьПараметр("Ошибки", Ошибки);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция Задача_ВсеПодчиненныеОперацииЗавершены(ОперацияОснование, ТипОпераций)
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	ЗавершенныеДействия = Новый Массив;
	ЗавершенныеДействия.Добавить(ТребуемыеДействия.ИсправитьОшибку);
	ЗавершенныеДействия.Добавить(ТребуемыеДействия.ОперацияЗавершена);
	ЗавершенныеДействия.Добавить(ТребуемыеДействия.ПринятЧастично);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Операции.Ссылка КАК Операция
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Операции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ОчередьОбмена КАК ОчередьОбмена
	|		ПО Операции.Ссылка = ОчередьОбмена.Операция
	|ГДЕ
	|	Операции.ОперацияОснование = &ОперацияОснование
	|	И Операции.ТипОперации = &ТипОпераций
	|	И НЕ ОчередьОбмена.ТребуемоеДействие В(&ЗавершенныеДействия)");
	Запрос.УстановитьПараметр("ЗавершенныеДействия", ЗавершенныеДействия);
	Запрос.УстановитьПараметр("ОперацияОснование", ОперацияОснование);
	Запрос.УстановитьПараметр("ТипОпераций", ТипОпераций);
	
	Возврат Запрос.Выполнить().Пустой();
	
КонецФункции

// Проверяет, есть ли в подчиненных операциях частично принятые ГИС МТ
//
// Параметры:
//  ОперацияОснование - СправочникСсылка.КонтурМаркировка_Операции - операция основание;
//  ТипОпераций - Строка - тип нужных операций, см. Перечисление_ТипыОпераций();
// 
// Возвращаемое значение:
//  Булево - Истина, если есть частично обработанные операции
//
Функция Задача_ВПодчиненныхОперацияхЕстьПринятыеЧастично(ОперацияОснование, ТипОпераций)
	
	Результат = Ложь;
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	МассивОпераций = Операция_НайтиПодчиненныеОперации(ОперацияОснование, ТипОпераций);
	МассивЗадач = Задачи_Прочитать(МассивОпераций);
	
	Для каждого ОписаниеЗадачи Из МассивЗадач Цикл
		Если ОписаниеЗадачи.ТребуемоеДействие = ТребуемыеДействия.ПринятЧастично Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Собирает все ошибки в подчиненных операциях
//
// Параметры:
//  ОперацияОснование - СправочникСсылка.КонтурМаркировка_Операции - операция основание;
//  ТипПодчиненныхОпераций - Строка - тип нужных операций, см. Перечисление_ТипыОпераций();
// 
// Возвращаемое значение:
//  Массив - содержит строки с ошибками обмена в подчиненных операциях
//
Функция Задача_ОшибкиВПодчиненныхОперациях(ОперацияОснование, ТипПодчиненныхОпераций = "")
	
	Результат = Новый Массив;
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	ПодчиненныеОперации = Операция_НайтиПодчиненныеОперации(ОперацияОснование, ТипПодчиненныхОпераций);
	
	Для каждого ОписаниеЗадачи Из Задачи_Прочитать(ПодчиненныеОперации) Цикл
		Если ОписаниеЗадачи.ТребуемоеДействие = ТребуемыеДействия.ИсправитьОшибку
			Или ОписаниеЗадачи.ТребуемоеДействие = ТребуемыеДействия.ПринятЧастично Тогда
			Если ЗначениеЗаполнено(ОписаниеЗадачи.ДопРеквизиты.КраткоеОписаниеОшибки) Тогда
				Результат.Добавить(ОписаниеЗадачи.ДопРеквизиты.КраткоеОписаниеОшибки);
			Иначе
				Результат.Добавить(ОписаниеЗадачи.ОписаниеОшибки);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	СвернутьМассив_Марк(Результат);
	
	Возврат Результат;
	
КонецФункции

Процедура Задача_ВосстановитьПредыдущееДействие(ОписаниеЗадачи)
	
	Если Не ЗначениеЗаполнено(ОписаниеЗадачи.ПредыдущееДействие) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = ОписаниеЗадачи.ПредыдущееДействие;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

// Записывает ошибку в очередь задач и в журнал регистрации
//
// Параметры:
//  ОписаниеЗадачи - Структура - см. Новый_ЗадачаОбмена();
//  Ошибка - ИнформацияОбОшибке, Строка - информация об ошибке;
//  ОстановитьОбмен - Булево - (необязательный) Ложь, если в следующий раз попытку обмена выполнять не нужно;
//
Процедура Задача_ЗаписатьОшибку(ОписаниеЗадачи, Ошибка, ОстановитьОбмен = Истина)
	
	Действие = НСтр("ru = 'Обмен с сервисом'");
	
	ДопИнформация = Новый СписокЗначений;
	ДопИнформация.Добавить(ОписаниеЗадачи.Организация, "Организация");
	ДопИнформация.Добавить(ОписаниеЗадачи.Операция, "Операция");
	ДопИнформация.Добавить(ОписаниеЗадачи.ТребуемоеДействие, "Действие");
	
	Если ЗначениеЗаполнено(ОписаниеЗадачи.ИдентификаторДокумента) Тогда
		ДопИнформация.Добавить(ОписаниеЗадачи.ИдентификаторДокумента, "Идентификатор документа");
	КонецЕсли;
	
	ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
	
	Если ОстановитьОбмен Тогда
		ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ИсправитьОшибку;
		ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОшибкаОбработки;
	КонецЕсли;
	
	ОписаниеЗадачи.ОписаниеОшибки = Ошибка;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

// Записывает коды в редактор для ручного исправления и распознавания
//
// Параметры:
//  ОписаниеЗадачи - Структура - см. Новый_ЗадачаОбмена();
//  ТаблицаКодов - Таблица значений - см. Новый_ТаблицаКодов()
//
Процедура Задача_ЗаписатьКодыВРедакторДляРаспознавания(ОписаниеЗадачи, ТаблицаКодов)
	
	РедакторКодов_ЗаписатьФайл(ОписаниеЗадачи.Операция, Новый_ДанныеРедактораКодов(ТаблицаКодов));
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().РаспознатьКоды;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().НеУдалосьРаспознатьКоды;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

// Записывает коды в редактор для ручного исправления дублей агрегатов
//
// Параметры:
//  ОписаниеЗадачи - Структура - см. Новый_ЗадачаОбмена();
//  ТаблицаКодов - Таблица значений - см. Новый_ТаблицаНовыхКодов()
//
Процедура Задача_ЗаписатьКодыВРедакторДляИсправленияДублей(ОписаниеЗадачи, ТаблицаКодов)
	
	РедакторКодов_ЗаписатьФайл(ОписаниеЗадачи.Операция, Новый_ДанныеРедактораКодов(ТаблицаКодов));
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().УстранитьДубли;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОбнаруженоДублированиеВАгрегатах;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

// Обновляет статусы кодов и завершает операции
//
// Параметры:
//  ОписаниеЗадачи - Структура - см. функцию Новый_ЗадачаОбмена();
//
Процедура Задача_ОбновитьСтатусыКодовЗавершитьОперацию(ОписаниеЗадачи)
	
	Если Операция_ОбновитьСтатусыКодов(ОписаниеЗадачи.Операция) Тогда
		Задача_Завершить(ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

// Проверяет сертификат установленный на компьютер сервера
//
// Параметры:
//  КонтекстОбмена - Строка - см. Новый_КонтекстОбмена();
//
Процедура ПроверитьДоступностьПодписиНаСервере(КонтекстОбмена)
	
	Результат = Мок_ПроверитьДоступностьПодписиНаСервере(КонтекстОбмена);
	Если Результат <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не КонтекстОбмена.ПроверитьСертификатНаСервере Тогда
		Возврат;
	КонецЕсли;
	
	Сертификат = КонтекстОбмена.Сертификат;
	Организация = КонтекстОбмена.Организация;
	ОтпечатокСертификата = КонтекстОбмена.ОтпечатокСертификата;
	
	Если Не ЗначениеЗаполнено(Сертификат) Тогда
		Возврат;
	КонецЕсли;
	
	КонтекстОбмена.ПроверитьСертификатНаСервере = Ложь;
	
	Если Не МожноИспользоватьКриптографиюНаСервере() Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ДанныеСертификата = Плагин_НайтиСертификат(ОтпечатокСертификата);
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Проверка сертификата'");
		ДопИнформация = Новый СписокЗначений;
		ДопИнформация.Добавить(Сертификат, "Сертификат");
		ДопИнформация.Добавить(Организация, "Организация");
		ДопИнформация.Добавить(ОтпечатокСертификата, "Отпечаток сертификата");
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
		
		КонтекстОбмена.ТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		
		Возврат;
		
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(ДанныеСертификата) Тогда
		Возврат;
	КонецЕсли;
	
	КонтекстОбмена.СертификатУстановленНаСервере = Истина;
	
	Если ДанныеСертификата.ЕстьЗакрытыйКлюч Тогда
		КонтекстОбмена.ЕстьЗакрытыйКлюч = Истина;
	КонецЕсли;
	
	Если Не СрокДействияСертификатаИстек(ДанныеСертификата.ДатаОкончания) Тогда
		
		КонтекстОбмена.СертификатДействует = Истина;
		
		Если СрокДействияСертификатаЗаканчивается(ДанныеСертификата.ДатаОкончания) Тогда
			КонтекстОбмена.СрокДействияСертификатаИстекает = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если КонтекстОбмена.СертификатУстановленНаСервере
		И КонтекстОбмена.СертификатДействует
		И КонтекстОбмена.ЕстьЗакрытыйКлюч Тогда
		КонтекстОбмена.ДоступнаПодписьНаСервере = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция ВременнаяОшибкаСервиса(РезультатЗапроса, ОписаниеЗадачи)
	
	Если РезультатЗапроса.ВременнаяОшибка Тогда
		ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОшибкаОбменаССервисом;
		ОписаниеЗадачи.ОписаниеОшибки = НСтр("ru = 'Ошибка запроса в сервис. Попробуйте повторить обмен позже.'");
		Задача_Записать(ОписаниеЗадачи);
	КонецЕсли;
	
	Возврат РезультатЗапроса.ВременнаяОшибка;
	
КонецФункции

