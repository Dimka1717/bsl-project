// Создает товар по данным сервиса
//
// Параметры:
//  GTIN - Строка - GTIN, по которому нужно создать товар;
//  КэшРезультатов - Соответствие - (необязательный) кэш результатов функции;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Товары - новый товар;
//
Функция Товар_НайтиСоздатьПоИнформацииИзСервиса(GTIN, КэшРезультатов) Экспорт
	
	Результат = Товар_Найти(GTIN, КэшРезультатов);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Товары_СоздатьОбновитьПоИнформацииИзСервиса(ЗначениеВМассиве(GTIN), Истина);
	КонецЕсли;
	
	Результат = Товар_Найти(GTIN, КэшРезультатов);
	
	Возврат Результат;
	
КонецФункции

