КонецФункции

Функция ТаблицаКодов_ОбновитьСтатусы(ТаблицаКодов, Организация) Экспорт
	
	УдалосьОбновить = Истина;
	
	ПроверитьРД = ТаблицаКодов.Колонки.Найти("РезультатПроверкиРД") <> Неопределено;
	
	ТаблицаКодов_ВосстановитьРазделителиGS1(ТаблицаКодов);
	
	Для каждого ЧастьТаблицы Из ТаблицаЗначений_Разбить(ТаблицаКодов, "ВидПродукции") Цикл
		
		ВидПродукции = ЧастьТаблицы.ВидПродукции;
		СтрокиТаблицы = ЧастьТаблицы.МассивСтрок;
		
		КодыМаркировки = Новый Массив;
		Для каждого Стр Из СтрокиТаблицы Цикл
			КодыМаркировки.Добавить(Стр.КодМаркировки);
		КонецЦикла;
		
		Ответ = Маркировка_СтатусыКодов(КодыМаркировки, Организация, ВидПродукции);
		Если Не ЗначениеЗаполнено(Ответ) Тогда
			УдалосьОбновить = Ложь;
			Прервать;
		КонецЕсли;
		
		Для Сч = 0 По Ответ.ВГраница() Цикл
			СтатусыКодовГИСМТ_ЗаполнитьСтроку(СтрокиТаблицы[Сч], Ответ[Сч], ПроверитьРД);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат УдалосьОбновить;
	
КонецФункции

Функция ТаблицаКодов_ОбновитьСтатусПоПервомуКоду(ТаблицаКодов, Организация, ВидПродукции = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПервыйКод = ТаблицаКодов[0].КодМаркировки;
	
	Если ВидПродукции = Неопределено Тогда
		ВидПродукции = ТаблицаКодов[0].ВидПродукции;
	КонецЕсли;
	
	Попытка
		Ответ = Маркировка_СтатусыКодов(ПервыйКод, Организация, ВидПродукции);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтатусыКодов = Перечисление_СтатусыКодов();
	
	Статус = СтатусКодаПоСтатусуИзСервиса(Ответ[0]);
	Если Не ЗначениеЗаполнено(Статус)
		Или Статус = СтатусыКодов.НеНайден
		Или Статус = СтатусыКодов.НетДоступа Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для каждого Стр Из ТаблицаКодов Цикл
		Стр.Статус = Статус;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

