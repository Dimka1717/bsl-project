Функция КодыОпераций_ТаблицаКодов(Операция, КлючСтрокиОперации = Неопределено, ДляВнутреннегоУчета = Неопределено) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	КодыОпераций.КлючКода КАК КлючКода,
	|	КодыОпераций.КлючСтрокиОперации КАК КлючСтрокиОперации,
	|	КодыОпераций.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО КодыОпераций.КлючКода = СвязиКлючейКодов.КлючКода
	|			И (&ПрочитатьИнформациюОКодах)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (СвязиКлючейКодов.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|			И (&ПрочитатьИнформациюОКодах)
	|ГДЕ
	|	КодыОпераций.Операция = &Операция
	|	И &КлючСтрокиОперации
	|	И &ДляВнутреннегоУчета";
	
	Если КлючСтрокиОперации = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиОперации", "ИСТИНА");
	Иначе
		ТекстУсловия = "КодыОпераций.КлючСтрокиОперации = &КлючСтрокиОперации";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиОперации", ТекстУсловия);
	КонецЕсли;
	
	Если ДляВнутреннегоУчета = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДляВнутреннегоУчета", "ИСТИНА");
		ПрочитатьИнформациюОКодах = Ложь;
	Иначе
		ТекстУсловия = "ИнформацияОКодах.ДляВнутреннегоУчета = &ДляВнутреннегоУчета";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДляВнутреннегоУчета", ТекстУсловия);
		ПрочитатьИнформациюОКодах = Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Операция", Операция);
	Запрос.УстановитьПараметр("КлючСтрокиОперации", КлючСтрокиОперации);
	Запрос.УстановитьПараметр("ДляВнутреннегоУчета", ДляВнутреннегоУчета);
	Запрос.УстановитьПараметр("ПрочитатьИнформациюОКодах", ПрочитатьИнформациюОКодах);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый_ТаблицаКодов();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), Выборка);
	КонецЦикла;
	
	Возврат Результат;
	
