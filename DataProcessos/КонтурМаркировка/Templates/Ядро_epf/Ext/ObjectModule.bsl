Процедура ДополнитьНастройкиРазбораКодаМаркировки(НастройкиРазбораКодаМаркировки, ВидПродукции)
	
	Если ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Табак Тогда
		
		ОписаниеКодаМаркировкиТабачногоБлока(НастройкиРазбораКодаМаркировки, ВидПродукции);
		ОписаниеКодаМаркировкиТабачнойПачки(НастройкиРазбораКодаМаркировки, ВидПродукции);
		ОписаниеКодаМаркировкиТабачнойПачкиКодПроверки8(НастройкиРазбораКодаМаркировки, ВидПродукции);
		
	ИначеЕсли ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.НикотиносодержащаяПродукция Тогда
		
		ОписаниеКодаМаркировкиНикотиносодержащейПродукции(НастройкиРазбораКодаМаркировки, ВидПродукции);
		ОписаниеКодаМаркировкиНикотиносодержащейПродукцииГрупповаяУпаковка(НастройкиРазбораКодаМаркировки, ВидПродукции);
		
	ИначеЕсли ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Обувь Тогда
		
		ОписаниеКодаМаркировкиОбуви(НастройкиРазбораКодаМаркировки, ВидПродукции);
		ОписаниеКодаМаркировкиОбувиРеспубликаБеларусьКлючПроверки5(НастройкиРазбораКодаМаркировки, ВидПродукции);
		
	ИначеЕсли ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Легпром
		Или ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Парфюмерия
		Или ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Шины
		Или ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Велосипеды
		Или ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.МедицинскиеИзделия Тогда
		
		ОписаниеКодаМаркировкиЛегкаяПромышленностьДухиШиныМедицинскиеИзделияВелосипеды(НастройкиРазбораКодаМаркировки, ВидПродукции);
		
	ИначеЕсли ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Молоко Тогда
		
		ОписаниеКодаМаркировкиМолочнаяПродукция(НастройкиРазбораКодаМаркировки, ВидПродукции);
		ОписаниеКодаМаркировкиМолочнаяПродукция13(НастройкиРазбораКодаМаркировки, ВидПродукции);
		
		ОписаниеКодаМаркировкиМолочнаяПродукцияСкоропортящаяся(НастройкиРазбораКодаМаркировки, ВидПродукции);
		ОписаниеКодаМаркировкиМолочнаяПродукцияСкоропортящаяся13(НастройкиРазбораКодаМаркировки, ВидПродукции);
		
		ОписаниеКодаМаркировкиМолочнаяПродукцияРеспубликаБеларусь(НастройкиРазбораКодаМаркировки, ВидПродукции);
		
	ИначеЕсли ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Фототовары Тогда
		
		ОписаниеКодаМаркировкиФотоаппаратов(НастройкиРазбораКодаМаркировки, ВидПродукции);
		
	ИначеЕсли ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Вода
		Или ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Пиво
		Или ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Бады
		Или ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Антисептики Тогда
		
		ОписаниеКодаМаркировкиПродукцииУпакованнаяВодаПивоБадыАнтисептики13(НастройкиРазбораКодаМаркировки, ВидПродукции);
		
		Если ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Пиво Тогда
			ОписаниеКодаМаркировкиПродукцииПиво(НастройкиРазбораКодаМаркировки, ВидПродукции);
			ОписаниеКодаМаркировкиПродукцииПиво13(НастройкиРазбораКодаМаркировки, ВидПродукции);
		КонецЕсли;
		
		Если ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Бады
			Или ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Антисептики Тогда
			ОписаниеКодаМаркировкиБадыАнтисептики(НастройкиРазбораКодаМаркировки, ВидПродукции);
		КонецЕсли;
		
	Иначе
		Возврат;
	КонецЕсли;
	
	// Упаковка
	ОписаниеКодаМаркировкиЛогистическаяУпаковка20(НастройкиРазбораКодаМаркировки, ВидПродукции);
	
	Если ВидПродукции <> Перечисления.КонтурМаркировка_ВидыПродукции.Табак Тогда
		
		ОписаниеКодаМаркировкиЛогистическаяУпаковка18(НастройкиРазбораКодаМаркировки, ВидПродукции);
		
	КонецЕсли;
	
КонецПроцедуры

// Формирует описание кода маркировки для табачного блока
Процедура ОписаниеКодаМаркировкиТабачногоБлока(НастройкиРазбораКодаМаркировки, ВидПродукции)
	
	Алфавит = НастройкиРазбораКодаМаркировки.Алфавит;
	
	ОписаниеЭлементовКМ = Новый Структура("GTIN, СерийныйНомер, МРЦСтрокой, КодПроверки, КодТНВЭД");
	ОписаниеЭлементовКМ.GTIN          = ОписаниеЭлементаКодаМаркировки("01",   "GTIN",         14);
	ОписаниеЭлементовКМ.СерийныйНомер = ОписаниеЭлементаКодаМаркировки("21",   "СерийныйНомер", 7, Алфавит.БуквыЦифрыЗнаки);
	ОписаниеЭлементовКМ.МРЦСтрокой    = ОписаниеЭлементаКодаМаркировки("8005", "МРЦСтрокой",    6, Алфавит.Цифры);
	ОписаниеЭлементовКМ.КодПроверки   = ОписаниеЭлементаКодаМаркировки("93",   "КодПроверки",   4, Алфавит.БуквыЦифрыЗнаки);
	ОписаниеЭлементовКМ.КодТНВЭД      = ОписаниеЭлементаКодаМаркировки("240",  "КодТНВЭД",      8, Алфавит.Цифры);
	
	ШаблоныСтрокой = Новый Массив;
	ШаблоныСтрокой.Добавить("GTIN + СерийныйНомер");
	ШаблоныСтрокой.Добавить("GTIN + СерийныйНомер + МРЦСтрокой");
	ШаблоныСтрокой.Добавить("GTIN + СерийныйНомер + МРЦСтрокой + КодПроверки");
	ШаблоныСтрокой.Добавить("GTIN + СерийныйНомер + МРЦСтрокой + КодТНВЭД");
	ШаблоныСтрокой.Добавить("GTIN + СерийныйНомер + МРЦСтрокой + КодПроверки + КодТНВЭД");
	ШаблоныСтрокой.Добавить("GTIN + СерийныйНомер + КодПроверки");
	ШаблоныСтрокой.Добавить("GTIN + СерийныйНомер + КодТНВЭД");
	ШаблоныСтрокой.Добавить("GTIN + СерийныйНомер + КодПроверки + КодТНВЭД");
	СписокШаблонов = ОписанияШаблоновКодаМаркировки(ОписаниеЭлементовКМ, ШаблоныСтрокой);
	
	РегулярныеВыражения = Новый Массив;
	РегулярныеВыражения.Добавить("01(\d{14})21(\S{7})");
	РегулярныеВыражения.Добавить("01(\d{14})21(\S{7})%1?8005(\d{6})");
	РегулярныеВыражения.Добавить("01(\d{14})21(\S{7})%1?8005(\d{6})93(\S{4})");
	РегулярныеВыражения.Добавить("01(\d{14})21(\S{7})%1?8005(\d{6})240(\d{8})");
	РегулярныеВыражения.Добавить("01(\d{14})21(\S{7})%1?8005(\d{6})93(\S{4})240(\d{8})");
	РегулярныеВыражения.Добавить("01(\d{14})21(\S{7})%1?93(\S{4})");
	РегулярныеВыражения.Добавить("01(\d{14})21(\S{7})%1?240(\d{8})");
	РегулярныеВыражения.Добавить("01(\d{14})21(\S{7})%1?93(\S{4})240(\d{8})");
	ЗаполнитьВРегулярныхВыраженияхКодовМаркировкиРазделительGS1(РегулярныеВыражения);
	
	ТипШтрихкодаИВидУпаковки = ТипШтрихкодаИВидУпаковки();
	ТипШтрихкодаИВидУпаковки.ТипШтрихкода = Перечисления.КонтурМаркировка_ТипыШтрихкодов.GS1_DataMatrix;
	ТипШтрихкодаИВидУпаковки.ВидУпаковки  = Перечисления.КонтурМаркировка_ВидыУпаковок.Групповая;
	
	СоставКодаМаркировки = НовыйСоставКодаМаркировки(ТипШтрихкодаИВидУпаковки);
	СоставКодаМаркировки.Вставить("ВключаетМРЦ", Ложь);
	СоставКодаМаркировки.Вставить("МРЦ",         0);
	СоставКодаМаркировки.Вставить("МРЦСтрокой", "");
	СоставКодаМаркировки.Вставить("КодТНВЭД",   "");
	
	Для Сч = 0 По СписокШаблонов.ВГраница() Цикл
		
		НастройкаОписанияКода = Новый_НастройкаОписанияКодаМаркировки();
		НастройкаОписанияКода.ВидПродукции = ВидПродукции;
		НастройкаОписанияКода.ТипШтрихкодаИВидУпаковки = ТипШтрихкодаИВидУпаковки;
		НастройкаОписанияКода.СоставКодаМаркировки = СоставКодаМаркировки;
		НастройкаОписанияКода.ОписаниеШаблонаКодаМаркировки = СписокШаблонов[Сч];
		НастройкаОписанияКода.РегулярноеВыражение = РегулярныеВыражения[Сч];
		
		ДобавитьОписаниеШаблонаКодаМаркировкиВидаПродукции(НастройкиРазбораКодаМаркировки, НастройкаОписанияКода);
		
	КонецЦикла;
	
КонецПроцедуры

// Формирует описание кода маркировки для табачной пачки
Процедура ОписаниеКодаМаркировкиТабачнойПачки(НастройкиРазбораКодаМаркировки, ВидПродукции)
	
	Алфавит = НастройкиРазбораКодаМаркировки.Алфавит;
	
	ОписаниеЭлементовКМ = Новый Структура("GTIN, СерийныйНомер, МРЦСтрокой, КодПроверки");
	ОписаниеЭлементовКМ.GTIN          = ОписаниеЭлементаКодаМаркировки("", "GTIN",         14);
	ОписаниеЭлементовКМ.СерийныйНомер = ОписаниеЭлементаКодаМаркировки("", "СерийныйНомер", 7, Алфавит.БуквыЦифрыЗнаки);
	ОписаниеЭлементовКМ.МРЦСтрокой    = ОписаниеЭлементаКодаМаркировки("", "МРЦСтрокой",    4, Алфавит.БуквыЦифрыЗнакиМРЦ);
	ОписаниеЭлементовКМ.КодПроверки   = ОписаниеЭлементаКодаМаркировки("", "КодПроверки",   4, Алфавит.БуквыЦифрыЗнаки);
	
	ШаблоныСтрокой = Новый Массив;
	ШаблоныСтрокой.Добавить("GTIN + СерийныйНомер");
	ШаблоныСтрокой.Добавить("GTIN + СерийныйНомер + МРЦСтрокой");
	ШаблоныСтрокой.Добавить("GTIN + СерийныйНомер + МРЦСтрокой + КодПроверки");
	СписокШаблонов = ОписанияШаблоновКодаМаркировки(ОписаниеЭлементовКМ, ШаблоныСтрокой);
	
	РегулярныеВыражения = Новый Массив;
	РегулярныеВыражения.Добавить("(\d{14})(\S{7})");
	РегулярныеВыражения.Добавить("(\d{14})(\S{7})%1?(\S{4})");
	РегулярныеВыражения.Добавить("(\d{14})(\S{7})%1?(\S{4})(\S{4})");
	ЗаполнитьВРегулярныхВыраженияхКодовМаркировкиРазделительGS1(РегулярныеВыражения);
	
	ТипШтрихкодаИВидУпаковки = ТипШтрихкодаИВидУпаковки();
	ТипШтрихкодаИВидУпаковки.ТипШтрихкода = Перечисления.КонтурМаркировка_ТипыШтрихкодов.GS1_DataMatrix;
	ТипШтрихкодаИВидУпаковки.ВидУпаковки  = Перечисления.КонтурМаркировка_ВидыУпаковок.Потребительская;
	
	СоставКодаМаркировки = НовыйСоставКодаМаркировки(ТипШтрихкодаИВидУпаковки);
	СоставКодаМаркировки.Вставить("ВключаетМРЦ", Ложь);
	СоставКодаМаркировки.Вставить("МРЦ",         0);
	СоставКодаМаркировки.Вставить("МРЦСтрокой", "");
	
	Для Сч = 0 По СписокШаблонов.ВГраница() Цикл
		
		НастройкаОписанияКода = Новый_НастройкаОписанияКодаМаркировки();
		НастройкаОписанияКода.ВидПродукции = ВидПродукции;
		НастройкаОписанияКода.ТипШтрихкодаИВидУпаковки = ТипШтрихкодаИВидУпаковки;
		НастройкаОписанияКода.СоставКодаМаркировки = СоставКодаМаркировки;
		НастройкаОписанияКода.ОписаниеШаблонаКодаМаркировки = СписокШаблонов[Сч];
		НастройкаОписанияКода.РегулярноеВыражение = РегулярныеВыражения[Сч];
		
		ДобавитьОписаниеШаблонаКодаМаркировкиВидаПродукции(НастройкиРазбораКодаМаркировки, НастройкаОписанияКода);
		
	КонецЦикла;
	
КонецПроцедуры

