Функция СервисУведомлений_ЕстьНовостиМаркировки() Экспорт
	
	Результат = Ложь;
	
	Если НастройкиМодуля().ОтключитьУведомленияПользователей Тогда
		Возврат Результат;
	КонецЕсли;
	
	Контент = КонтентДляПроверкиУведомлений();
	
	Попытка
		РезультатЗапроса = СервисУведомлений_ПроверитьУведомления(Контент);
	Исключение
		
		Действие = НСтр("ru = 'Не удалось загрузить уведомления'");
		Ошибка = ИнформацияОбОшибке();
		ОбработатьОшибку(Действие, Ошибка);
		
		Возврат Результат;
		
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(РезультатЗапроса) Тогда
		Возврат Результат;
	КонецЕсли;
	
	МассивНовостей = РезультатЗапроса["notifications"];
	Если МассивНовостей.Количество() > 0 Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает список уведомлений из сервиса
//
// Параметры:
//  Контент - Структура - см. КонтентДляПроверкиОбновления()
// 
// Возвращаемое значение:
//  Структура - содержит:
//   * notifications - массив - структуры уведомлений с обязательными и произвольными полями
//
Функция СервисУведомлений_ПроверитьУведомления(Контент) Экспорт
	
	Результат = Мок_СервисУведомлений_ПроверитьУведомления(Контент);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	СервисУведомлений_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	
	Запрос.Метод = "POST";
	Запрос.ПутьНаСервере = "/1c/v4/{product_name}/notifications";
	Запрос.Параметры.Вставить("product_name", СервисУведомлений_ИмяПродукта_УведомленияМодуля());
	Запрос.ТелоЗапроса = ЗначениеВСтрокуJSON(Контент);
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	
	Если Ответ.КодОтвета = КодОтвета_Успешно() Тогда
		Результат = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета, Истина);
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьТаблицуНовостей() Экспорт
	
	Результат = Новый_ТаблицаУведомлений();
	
	Контент = КонтентДляПроверкиУведомлений();
	РезультатЗапроса = СервисУведомлений_ПроверитьУведомления(Контент);
	Если Не ЗначениеЗаполнено(РезультатЗапроса) Тогда
		Возврат Результат;
	КонецЕсли;
	
	МассивНовостей = РезультатЗапроса["notifications"];
	Если МассивНовостей.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПриоритетыУведомлений = Перечисление_ПриоритетыУведомленийВСервисе();
	
	Для Каждого УведомлениеВСервисе Из МассивНовостей Цикл
		
		Приоритет = УведомлениеВСервисе["priority"];
		
		Если Приоритет = ПриоритетыУведомлений.Высокий Тогда
			УровеньПриоритета = 1;
		ИначеЕсли Приоритет = ПриоритетыУведомлений.Средний Тогда
			УровеньПриоритета = 2;
		ИначеЕсли Приоритет = ПриоритетыУведомлений.Низкий Тогда
			УровеньПриоритета = 3;
		Иначе
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Результат.Добавить();
		
		НоваяСтрока.ТекстУведомления = УведомлениеВСервисе["content"]["text"];
		НоваяСтрока.Приоритет = УровеньПриоритета;
		
	КонецЦикла;
	
	Результат.Сортировать("Приоритет");
	
	Возврат Результат;

КонецФункции

Функция СервисУведомлений_ИмяПродукта_УведомленияМодуля()
	
	Возврат "mark";
	
КонецФункции

Функция КонтентДляПроверкиУведомлений()
	
	Результат = Новый Структура;
	
	Настройки = НастройкиМодуля();
	
	Результат.Вставить("client_id", Настройки.ИдентификаторЭкземпляраМодуля);
	Результат.Вставить("version", ВерсияОбработки());
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ТаблицаУведомлений()
	
	ТипЧисло = ОписаниеТипа_Число();
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ИдентификаторВСервисе", ТипСтрока);
	Результат.Колонки.Добавить("ТекстУведомления", ТипСтрока);
	Результат.Колонки.Добавить("Приоритет", ТипЧисло);
	
	Возврат Результат;
	
КонецФункции

