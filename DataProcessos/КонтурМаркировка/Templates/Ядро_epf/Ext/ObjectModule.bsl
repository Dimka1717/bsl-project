Функция Пользователи_ТекущийПользователь() Экспорт
	
	КлючКэш = "ТекущийПользователь";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ПодобратьТекущегоПользователя();
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Процедура ОбновитьТекущегоПользователя() Экспорт
	
	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Пользователь = ПодобратьТекущегоПользователя();
	
	Если Пользователь.Наименование <> ПользовательИБ.Имя
		Или Пользователь.ПолноеИмя <> ПользовательИБ.ПолноеИмя Тогда
		Пользователи_Обновить(ПользовательИБ, Пользователь);
	КонецЕсли;
	
КонецПроцедуры

Функция ПодобратьТекущегоПользователя()
	
	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	
	Результат = Пользователи_НайтиПоИдентификатору(ПользовательИБ);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		
		Результат = Пользователи_НайтиПоНаименованию(ПользовательИБ);
		
		Если ЗначениеЗаполнено(Результат) Тогда
			Пользователи_Обновить(ПользовательИБ, Результат);
		Иначе
			Результат = Пользователи_Добавить(ПользовательИБ);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Пользователи_НайтиПоИдентификатору(ПользовательИБ)
	
	Идентификатор = ПользовательИБ.УникальныйИдентификатор;
	
	Возврат Справочники.КонтурМаркировка_Пользователи.НайтиПоРеквизиту("ИдентификаторПользователяИБ", Идентификатор);
	
КонецФункции

Функция Пользователи_НайтиПоНаименованию(ПользовательИБ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Пользователи КАК Т
	|ГДЕ
	|	Т.ИдентификаторПользователяИБ = &ПустойИД
	|	И Т.Наименование = &ПолноеИмя
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Пользователи КАК Т
	|ГДЕ
	|	Т.ИдентификаторПользователяИБ = &ПустойИД
	|	И Т.Наименование = &Имя");
	Запрос.УстановитьПараметр("Имя", ПользовательИБ.Имя);
	Запрос.УстановитьПараметр("ПолноеИмя", ПользовательИБ.ПолноеИмя);
	Запрос.УстановитьПараметр("ПустойИД", ПустойУникальныйИдентификатор());
	
	Возврат ПолучитьРезультатЗапроса(Запрос);
	
КонецФункции

Функция Пользователи_Добавить(ПользовательИБ)
	
	Объект = Справочники.КонтурМаркировка_Пользователи.СоздатьЭлемент();
	Объект.Наименование = ПользовательИБ.Имя;
	Объект.ПолноеИмя = ПользовательИБ.ПолноеИмя;
	Объект.ИдентификаторПользователяИБ = ПользовательИБ.УникальныйИдентификатор;
	Объект.Записать();
	
	Возврат Объект.Ссылка;
	
КонецФункции

Процедура Пользователи_Обновить(ПользовательИБ, Пользователь)
	
	Если ОбъектВПроцессеОбновления(Пользователь) Тогда
		ВызватьИсключение_ОбъектВПроцессеОбновления(Пользователь);
	КонецЕсли;
	
	Объект = Пользователь.ПолучитьОбъект();
	Объект.Наименование = ПользовательИБ.Имя;
	Объект.ПолноеИмя = ПользовательИБ.ПолноеИмя;
	Объект.ИдентификаторПользователяИБ = ПользовательИБ.УникальныйИдентификатор;
	Объект.Записать();
	
КонецПроцедуры

// Возвращает массив имен пользователей ИБ
// в случае отсутствия права "Администрирование данных" вернет только имя текущего пользователя
// 
// Возвращаемое значение:
//  Массив - содержит имена пользователей ИБ
//
Функция Пользователи_МассивДоступныхПользователей() Экспорт
	
	Попытка
		ПользователиИБ = ПользователиИнформационнойБазы.ПолучитьПользователей();
	Исключение
		ПользователиИБ = Новый Массив;
		ПользователиИБ.Добавить(ПользователиИнформационнойБазы.ТекущийПользователь());
	КонецПопытки;
	
	Результат = Новый Массив;
	Для Каждого ПользовательИБ Из ПользователиИБ Цикл
		Результат.Добавить(ПользовательИБ.Имя);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

