// #Область ОбменССервисом

// #Область Интерфейс

// Выполняет авторизацию в сервисе Контур.Маркировка и продлевает доступ в ГИС МТ если нужно
//
// Параметры:
//  Организация1С - СправочникСсылка - организация;
//  ВызыватьИсключение - Булево - (необязательный) Ложь, если вызывать исключение при ошибке не нужно;
// 
// Возвращаемое значение:
//  Булево - Истина, если авторизация выполнена успешно
//
Функция ВыполнитьАвторизацию(Организация1С, ВызыватьИсключение = Истина) Экспорт
	
	Если ТипЗнч(Организация1С) = Тип("СправочникСсылка.КонтурМаркировка_Организации") Тогда
		Организация = Организация1С;
	Иначе
		Организация = Организация_НайтиПоОрганизации1С(Организация1С, Истина);
	КонецЕсли;
	
	КонтекстОбмена = КонтекстОбменаССервисом(Организация);
	КонтекстОбмена.ВызыватьИсключение = ВызыватьИсключение;
	
	Результат = Авторизация_Выполнить(КонтекстОбмена);
	
	Возврат Результат;
	
КонецФункции

Процедура ВыполнитьОбменССервисом(КонтекстОбмена) Экспорт
	
	Если Не КонтекстОбмена.ОбменВозможен Тогда
		Возврат;
	КонецЕсли;
	
	Организация = КонтекстОбмена.Организация;
	ДокументУчета = КонтекстОбмена.ДокументУчета;
	ЭтоФоновоеЗадание = ЭтоФоновоеЗадание();
	
	ОбновитьПоляТоваров();
	ОбновитьАнкету(Организация);
	ОбновитьПоляОрганизаций(Организация);
	
	Попытка
		
		ВыполнитьОбмен = Истина;
		Пока ВыполнитьОбмен Цикл
			ОчередьОбмена_ВыполнитьОбмен(КонтекстОбмена);
			ВыполнитьОбмен = Лента_ОбработатьНовыеСобытия(Организация);
		КонецЦикла;
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Обмен с сервисом'");
		ДопИнформация = Новый Структура;
		
		ТекстСообщения = НСтр("ru = 'Не удалось выполнить обмен с сервисом ""%1""'");
		
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			ДопИнформация.Вставить("ДокументУчета", ДокументУчета);
			ТекстСообщения = ПараметрыВСтроку(ТекстСообщения, ДокументУчета);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Организация) Тогда
			ДопИнформация.Вставить("Организация", Организация);
			ТекстСообщения = ПараметрыВСтроку(ТекстСообщения, Организация);
		КонецЕсли;
		
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация, ТекстСообщения);
		
		Если ЭтоФоновоеЗадание Тогда
			БуферОшибок_ЗаписатьВСообщение();
		КонецЕсли;
		
		Если КонтекстОбмена.ВызыватьИсключение Или ЭтоФоновоеЗадание Тогда
			ВызватьИсключение;
		КонецЕсли;
		
	КонецПопытки;
	
	Если ЭтоФоновоеЗадание Тогда
		БуферОшибок_ЗаписатьВСообщение();
	КонецЕсли;
	
	ОтправитьМетрики();
	
КонецПроцедуры

Функция КонтекстОбменаССервисом(Организация, Сертификат = Неопределено, ПродлеватьДоступГИС = Истина) Экспорт
	
	Результат = Новый_КонтекстОбмена(Организация);
	Результат.ПродлеватьДоступГИС = ПродлеватьДоступГИС;
	
	Если ЗначениеЗаполнено(Сертификат) Тогда
		Результат.Сертификат = Сертификат;
		Результат.ОтпечатокСертификата = Сертификат.ОтпечатокСертификата;
	Иначе
		КонтекстОбмена_ЗаполнитьСертификат(Результат);
	КонецЕсли;
	
	КонтекстОбмена_ПроверитьОрганизацию(Результат);
	КонтекстОбмена_ПроверитьАвторизацию(Результат);
	
	Возврат Результат;
	
КонецФункции

Процедура Задача_Создать(Операция, ПервоеДействие = Неопределено) Экспорт
	
	Реквизиты = ЗначенияРеквизитовОбъекта_Марк(Операция, "Организация, ТипОперации");
	Организация = Реквизиты.Организация;
	ТипОперации = Реквизиты.ТипОперации;
	
	Если ПервоеДействие = Неопределено Тогда
		ПервоеДействие = Операция_ПервоеДействие(ТипОперации);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПервоеДействие) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи = Задача_Прочитать(Операция);
	Если ОписаниеЗадачи = Неопределено Тогда
		ОписаниеЗадачи = Новый_ЗадачаОбмена();
	КонецЕсли;
	
	ОписаниеЗадачи.Операция = Операция;
	ОписаниеЗадачи.Организация = Организация;
	ОписаниеЗадачи.НовоеДействие = ПервоеДействие;
	ОписаниеЗадачи.ОписаниеОшибки = "";
	Задача_Записать(ОписаниеЗадачи);
	
	Если Операция_ВлияетНаТребуемоеДействиеДокумента(Операция) Тогда
		ДокументУчета_ОбновитьТребуемоеДействие(Операция.ДокументУчета);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_Завершить(ОписаниеЗадачи)
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ОперацияЗавершена;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОперацияЗавершена;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_Записать(ОписаниеЗадачи) Экспорт
	
	Если Не ЗначениеЗаполнено(ОписаниеЗадачи.ДатаПостановки) Тогда
		ОписаниеЗадачи.ДатаПостановки = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеЗадачи.НовоеДействие) Тогда
		Если ОписаниеЗадачи.НовоеДействие <> ОписаниеЗадачи.ТребуемоеДействие Тогда
			ОписаниеЗадачи.ПредыдущееДействие = ОписаниеЗадачи.ТребуемоеДействие;
			ОписаниеЗадачи.ТребуемоеДействие = ОписаниеЗадачи.НовоеДействие;
		КонецЕсли;
		ОписаниеЗадачи.НовоеДействие = "";
	КонецЕсли;
	
	Если ТипЗнч(ОписаниеЗадачи.ОписаниеОшибки) = Тип("ИнформацияОбОшибке") Тогда
		ОписаниеЗадачи.ДопРеквизиты.КраткоеОписаниеОшибки = КраткоеПредставлениеОшибки(ОписаниеЗадачи.ОписаниеОшибки);
		ОписаниеЗадачи.ОписаниеОшибки = ПодробноеПредставлениеОшибки(ОписаниеЗадачи.ОписаниеОшибки);
	Иначе
		ОписаниеЗадачи.ДопРеквизиты.КраткоеОписаниеОшибки = ОписаниеЗадачи.ОписаниеОшибки;
	КонецЕсли;
	ОписаниеЗадачи.ОписаниеОшибки = УдалитьНедопустимыеСимволыXML(ОписаниеЗадачи.ОписаниеОшибки);
	ОписаниеЗадачи.ДопРеквизиты.КраткоеОписаниеОшибки = УдалитьНедопустимыеСимволыXML(ОписаниеЗадачи.ДопРеквизиты.КраткоеОписаниеОшибки);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ОчередьОбмена_Заблокировать(ОписаниеЗадачи.Операция);
		
		Если ЗначениеЗаполнено(ОписаниеЗадачи.НовыйСтатусОперации) Тогда
			СтатусыОперации_ЗаписатьОсновнойСтатус(ОписаниеЗадачи.Операция, ОписаниеЗадачи.НовыйСтатусОперации);
		КонецЕсли;
		
		Запись = РегистрыСведений.КонтурМаркировка_ОчередьОбмена.СоздатьМенеджерЗаписи();
		Запись.Операция = ОписаниеЗадачи.Операция;
		Запись.Прочитать();
		
		ОбновленаЗапись = Задача_Записать_ОбновитьЗапись(Запись, ОписаниеЗадачи);
		ОбновленыДопРеквизиты = Задача_Записать_ОбновитьДопРеквизиты(Запись, ОписаниеЗадачи);
		
		Если ОбновленаЗапись Или ОбновленыДопРеквизиты Тогда
			Запись.Записать();
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция Задача_Записать_ОбновитьЗапись(Запись, ОписаниеЗадачи)
	
	ОбновленаЗапись = Ложь;
	МодульОбщегоНазначения = МодульОбщегоНазначения();
	
	Для каждого Элемент Из ОписаниеЗадачи Цикл
		
		ИмяРеквизита = Элемент.Ключ;
		НовоеЗначение = Элемент.Значение;
		
		Если ИмяРеквизита = "ДопРеквизиты" Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущееЗначение = МодульОбщегоНазначения.СвойствоОбъекта(Запись, ИмяРеквизита, Null);
		Если ТекущееЗначение = Null Тогда
			Продолжить; // Такого реквизита нет
		КонецЕсли;
		
		Если НовоеЗначение <> ТекущееЗначение Тогда
			Запись[ИмяРеквизита] = НовоеЗначение;
			ОбновленаЗапись = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОбновленаЗапись;
	
КонецФункции

Функция Задача_Записать_ОбновитьДопРеквизиты(Запись, ОписаниеЗадачи)
	
	ОбновленыДопРеквизиты = Ложь;
	
	ДопРеквизитыИБ = Запись.ДопРеквизиты.Получить();
	Если ДопРеквизитыИБ = Неопределено Тогда
		ДопРеквизитыИБ = Новый Структура;
	КонецЕсли;
	
	Для каждого Элемент Из ОписаниеЗадачи.ДопРеквизиты Цикл
		
		ИмяРеквизита = Элемент.Ключ;
		НовоеЗначение = Элемент.Значение;
		ЕстьНовоеЗначение = (НовоеЗначение <> Ложь И ЕстьЗначение(НовоеЗначение));
		
		ТекущееЗначение = Неопределено;
		ЕстьТекущееЗначение = ДопРеквизитыИБ.Свойство(ИмяРеквизита, ТекущееЗначение);
		
		Если ЕстьНовоеЗначение Тогда
			
			Если ИмяРеквизита = "ПроизвольныеДопРеквизиты" Тогда
				ЗначениеИзменено = ОбъектыОтличаются(НовоеЗначение, ТекущееЗначение);
			Иначе
				ЗначениеИзменено = НовоеЗначение <> ТекущееЗначение;
			КонецЕсли;
			
			Если ЗначениеИзменено Тогда
				ДопРеквизитыИБ.Вставить(ИмяРеквизита, НовоеЗначение);
				ОбновленыДопРеквизиты = Истина;
			КонецЕсли;
			
		Иначе
			Если ЕстьТекущееЗначение Тогда
				ДопРеквизитыИБ.Удалить(ИмяРеквизита);
				ОбновленыДопРеквизиты = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОбновленыДопРеквизиты Тогда
		Если ЗначениеЗаполнено(ДопРеквизитыИБ) Тогда
			Запись.ДопРеквизиты = ЗначениеВХранилище(ДопРеквизитыИБ);
		Иначе
			Запись.ДопРеквизиты = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОбновленыДопРеквизиты;
	
КонецФункции

Функция Задача_Прочитать(Операция) Экспорт
	
	МассивЗадач = Задачи_Прочитать(Операция);
	
	Результат = Неопределено;
	Если ЗначениеЗаполнено(МассивЗадач) Тогда
		Результат = МассивЗадач[0];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Задачи_Прочитать(Операции) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.ТипОперации КАК ТипОперации,
	|	Т.ТипБизнесПроцесса КАК ТипБизнесПроцесса
	|ПОМЕСТИТЬ ТипыБизнесПроцессов
	|ИЗ
	|	&ТипыБизнесПроцессов КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТипОперации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОчередьОбмена.*,
	|	Операции.Склад КАК Склад,
	|	Операции.ТипОперации КАК ТипОперации,
	|	Операции.ОперацияОснование КАК ОперацияОснование,
	|	ТипыБизнесПроцессов.ТипБизнесПроцесса КАК ТипБизнесПроцесса
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОчередьОбмена КАК ОчередьОбмена
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции КАК Операции
	|		ПО ОчередьОбмена.Операция = Операции.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТипыБизнесПроцессов КАК ТипыБизнесПроцессов
	|		ПО (Операции.ТипОперации = ТипыБизнесПроцессов.ТипОперации)
	|ГДЕ
	|	ОчередьОбмена.Операция В(&Операции)");
	Запрос.УстановитьПараметр("Операции", Операции);
	Запрос.УстановитьПараметр("ТипыБизнесПроцессов", ОчередьОбмена_ТипыБизнесПроцессовОпераций());
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ЗначениеЗаполнено(Выборка.ТипБизнесПроцесса) Тогда
			ТекстОшибки = НСтр("ru = 'Не удалось определить тип бизнес процесса для типа операции: %1'");
			ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, Выборка.ТипОперации);
		КонецЕсли;
		
		ОписаниеЗадачи = Новый_ЗадачаОбмена();
		ЗаполнитьЗначенияСвойств(ОписаниеЗадачи, Выборка, , "ДопРеквизиты");
		
		ДопРеквизитыИБ = Выборка.ДопРеквизиты.Получить();
		Если ЗначениеЗаполнено(ДопРеквизитыИБ) Тогда
			ЗаполнитьПоляСтруктуры(ОписаниеЗадачи.ДопРеквизиты, ДопРеквизитыИБ);
		КонецЕсли;
		
		Результат.Добавить(ОписаниеЗадачи);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ОчередьОбмена_НайтиОперации(ТребуемыеДействия, Организация
	, ДокументУчета = Неопределено
	, Количество = Неопределено
	, ОперацииИсключения = Неопределено)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Операции.Ссылка КАК Ссылка
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОчередьОбмена КАК ОчередьОбмена
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции КАК Операции
	|		ПО ОчередьОбмена.Операция = Операции.Ссылка
	|			И (&ДокументУчета)
	|ГДЕ
	|	ОчередьОбмена.Организация = &Организация
	|	И ОчередьОбмена.ТребуемоеДействие В(&ТребуемыеДействия)
	|	И &ОперацииИсключения";
	
	Если Количество <> Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ", ТекстЗапросаВыбратьПервые(Количество));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		Условие = "Операции.ДокументУчета = &ДокументУчета";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументУчета", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументУчета", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОперацииИсключения) Тогда
		Условие = "НЕ Операции.Ссылка В (&ОперацииИсключения)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперацииИсключения", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперацииИсключения", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("ТребуемыеДействия", ТребуемыеДействия);
	Запрос.УстановитьПараметр("ОперацииИсключения", ОперацииИсключения);
	
	Результат = МассивИзРезультатаЗапроса(Запрос);
	
	Возврат Результат;
	
КонецФункции

Функция ОчередьОбмена_ОперацииГотовыеКОтправкеПодписи(Организация, ДокументУчета = Неопределено)
	
	ТипыФайлов = Перечисление_ТипыФайлов();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	ПодходящиеДействия = Новый Массив;
	ПодходящиеДействия.Добавить(ТребуемыеДействия.ПодписатьФайл);
	ПодходящиеДействия.Добавить(ТребуемыеДействия.ПодписатьФайлЗакрытияЗаказа);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ОчередьОбмена.Операция КАК Операция
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОчередьОбмена КАК ОчередьОбмена
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Файлы КАК Файлы
	|		ПО ОчередьОбмена.Операция = Файлы.ВладелецФайла
	|ГДЕ
	|	ОчередьОбмена.Организация = &Организация
	|	И ОчередьОбмена.ТребуемоеДействие В(&ПодходящиеДействия)
	|	И Файлы.ТипФайла = &ТипФайла
	|	И &ДокументУчета
	|
	|СГРУППИРОВАТЬ ПО
	|	ОчередьОбмена.Операция
	|
	|ИМЕЮЩИЕ
	|	МИНИМУМ(Файлы.ПодписанЭП) = ИСТИНА";
	
	ТипФайла = ТипыФайлов.КонтентДляПодписи;
	
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		Условие = "ОчередьОбмена.Операция.ДокументУчета = &ДокументУчета";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументУчета", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументУчета", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("ПодходящиеДействия", ПодходящиеДействия);
	Запрос.УстановитьПараметр("ТипФайла", ТипыФайлов.КонтентДляПодписи);
	
	Возврат МассивИзРезультатаЗапроса(Запрос, "Операция");
	
КонецФункции

