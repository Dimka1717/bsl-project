// #Область ДопРеквизиты

Функция ДопРеквизиты_Прочитать(Объект) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.ИмяРеквизита КАК ИмяРеквизита,
	|	Т.Значение КАК Значение,
	|	Т.ЗначениеКлюч КАК ЗначениеКлюч,
	|	Т.ЗначениеСсылка КАК ЗначениеСсылка,
	|	Т.ТипКлючаЗначения КАК ТипКлючаЗначения
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК Т
	|ГДЕ
	|	Т.Объект = &Объект");
	Запрос.УстановитьПараметр("Объект", Объект);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Структура;
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.ЗначениеСсылка) Тогда
			Значение = Выборка.ЗначениеСсылка;
		ИначеЕсли ЗначениеЗаполнено(Выборка.ЗначениеКлюч) Тогда
			Если ЗначениеЗаполнено(Выборка.ТипКлючаЗначения) Тогда
				Значение = МодульОбщегоНазначения().СсылкаПоИдентификатору(Выборка.ЗначениеКлюч, Выборка.ТипКлючаЗначения);
			Иначе
				Значение = Выборка.ЗначениеКлюч;
			КонецЕсли;
		Иначе
			Значение = Выборка.Значение;
		КонецЕсли;
		
		Результат.Вставить(Выборка.ИмяРеквизита, Значение);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДопРеквизит_Прочитать(Объект, ИмяРеквизита, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Значение КАК Значение,
	|	Т.ЗначениеКлюч КАК ЗначениеКлюч,
	|	Т.ЗначениеСсылка КАК ЗначениеСсылка,
	|	Т.ТипКлючаЗначения КАК ТипКлючаЗначения
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК Т
	|ГДЕ
	|	Т.Объект = &Объект
	|	И Т.ИмяРеквизита = &ИмяРеквизита");
	Запрос.УстановитьПараметр("ИмяРеквизита", ИмяРеквизита);
	Запрос.УстановитьПараметр("Объект", Объект);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = ЗначениеПоУмолчанию;
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.ЗначениеСсылка) Тогда
			Результат = Выборка.ЗначениеСсылка;
		ИначеЕсли ЗначениеЗаполнено(Выборка.ЗначениеКлюч) Тогда
			Если ЗначениеЗаполнено(Выборка.ТипКлючаЗначения) Тогда
				Результат = МодульОбщегоНазначения().СсылкаПоИдентификатору(Выборка.ЗначениеКлюч, Выборка.ТипКлючаЗначения);
			Иначе
				Результат = Выборка.ЗначениеКлюч;
			КонецЕсли;
		Иначе
			Результат = Выборка.Значение;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДопРеквизиты_Записать(Объект, ДопРеквизиты) Экспорт
	
	Набор = РегистрыСведений.КонтурМаркировка_ДопРеквизиты.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Объект);
	
	Для каждого Элемент Из ДопРеквизиты Цикл
		
		ИмяРеквизита = Элемент.Ключ;
		Значение = Элемент.Значение;
		
		Если Значение = Ложь
			Или Не ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Запись = Набор.Добавить();
		Запись.ИмяРеквизита = ИмяРеквизита;
		Запись.Объект = Объект;
		
		Если ТипЗнч(Значение) = Тип("УникальныйИдентификатор") Тогда
			Запись.ЗначениеКлюч = Значение;
		ИначеЕсли ЭтоПростойТип(Значение) Тогда
			Запись.Значение = Значение;
		ИначеЕсли ЭтоОбъектКонтурМаркировки(Значение) Тогда
			Запись.ЗначениеСсылка = Значение;
		Иначе
			Запись.ЗначениеКлюч = КлючОбъекта1С(Значение);
			Запись.ТипКлючаЗначения = ТипКлючаОбъекта1С(Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Набор.Записать();
	
КонецПроцедуры

Процедура ДопРеквизиты_Удалить(Объект) Экспорт
	
	Набор = РегистрыСведений.КонтурМаркировка_ДопРеквизиты.СоздатьНаборЗаписей();
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Отбор.Объект.Установить(Объект);
	Набор.Записать();
	
КонецПроцедуры

