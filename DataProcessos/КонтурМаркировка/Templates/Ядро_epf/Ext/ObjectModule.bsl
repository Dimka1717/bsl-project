	КонецЕсли;
	
	ТипДокумента = ЗначениеРеквизитаОбъекта_Марк(ДокументУчета, "ТипДокумента");
	Результат = ДокументУчета_ТипуДокументаДоступнаРоль(ТипДокумента, Роль);
	
