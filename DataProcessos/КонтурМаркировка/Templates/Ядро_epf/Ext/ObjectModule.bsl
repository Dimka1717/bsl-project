Функция Контент_КорректировкаСведенийОКодах(ОписаниеОперации)
	
	ВидыСведений = Перечисление_ВидыКорректируемыхСведений();
	
	Операция = ОписаниеОперации.Ссылка;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	ОписаниеОснования = Операция_ПрочитатьОперацию(ОперацияОснование);
	КлючСтрокиОперации = ОписаниеОперации.КлючСтрокиОперацииОснования;
	
	ВидПродукции = ОписаниеОснования.ВидПродукции;
	ВидКорректируемыхСведений = ОписаниеОснования.ДопРеквизиты.ВидКорректируемыхСведений;
	
	Результат = Новый Структура;
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ВидПродукции));
	Результат.Вставить("documentNumber", ОписаниеОснования.Номер);
	
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "comment", ОписаниеОснования.Комментарий);
	
	Стр = ОписаниеОснования.Товары.Найти(КлючСтрокиОперации, "КлючСтрокиОперации");
	position = Новый Структура;
	position.Вставить("name", НаименованиеПозицииДляКонтента(Стр));
	
	Если ВидКорректируемыхСведений = ВидыСведений.ИдентификаторВСД Тогда
		position.Вставить("accompanyingDocument", КаноническийИдентификаторИзСтроки(Стр.ИдентификаторВСД));
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.ДатаПроизводства Тогда
		position.Вставить("productionDate", НачалоДня(Стр.ДатаПроизводства));
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.СрокГодности Тогда
		position.Вставить("expirationDate", ЛокальнаяДатаСоСмещениемXML(Стр.ДатаСрокаГодности));
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.КодТНВЭД Тогда
		position.Вставить("tnvedCode", Стр.КодТНВЭД);
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.ФактическийВес Тогда
		ВесВГраммах = Стр.Количество * ГраммВКилограмме();
		position.Вставить("weightGram", ВесВГраммах);
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.СпособВыпускаТоваров Тогда
		position.Вставить("emissionType", ТипЭмиссииВСервисеПоСпособуВыпускаТоваров(Стр.СпособВыпускаТоваров));
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.ВариативныйСрокГодности Тогда
		Если ЗначениеЗаполнено(Стр.АльтернативныеСрокиГодности) Тогда
			position.Вставить("expirationDateConditions", УсловияИстеченияСроковГодности(Стр.АльтернативныеСрокиГодности));
		КонецЕсли;
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.РазрешительныйДокумент Тогда
		ТипКорректировки = Стр.ТипКорректировкиСведенийОКодах;
		position.Вставить("certificatesOperation", ТипКорректировкиСведенийОКодахВСервисе(ТипКорректировки));
		certificateDocument = Новый Структура;
		certificateDocument.Вставить("type", СертификатВСервисе(Стр.ВидДокументаСертификации));
		certificateDocument.Вставить("date", Стр.ДатаДокументаСертификации);
		certificateDocument.Вставить("number", Стр.НомерДокументаСертификации);
		position.Вставить("certificates", ЗначениеВМассиве(certificateDocument));
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.ЛицензияНаНедра Тогда
		ТипКорректировки = Стр.ТипКорректировкиСведенийОКодах;
		position.Вставить("licensesOperation", ТипКорректировкиСведенийОКодахВСервисе(ТипКорректировки));
		License = Новый Структура;
		License.Вставить("number", Стр.НомерЛицензииНаНедра);
		License.Вставить("Date", Стр.ДатаЛицензииНаНедра);
		position.Вставить("licenses", ЗначениеВМассиве(License));
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.НомерПартии Тогда
		position.Вставить("partNumber", Стр.НомерПартии);
	КонецЕсли;
	
	position.Вставить("codes", КодыОпераций_КодыМаркировки(ОперацияОснование, Стр.КлючСтрокиОперации, Ложь));
	
	Результат.Вставить("positions", ЗначениеВМассиве(position));
	
	Возврат Результат;
	
КонецФункции

Функция Контент_УведомлениеОСостоянииКодов(ОписаниеОперации)
	
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	КлючСтрокиОперации = ОписаниеОперации.КлючСтрокиОперацииОснования;
	ОписаниеОснования = Операция_ПрочитатьОперацию(ОперацияОснование);
	СтрТовара = ОписаниеОснования.Товары.Найти(КлючСтрокиОперации, "КлючСтрокиОперации");
	
	ВидПродукции = ОписаниеОснования.ВидПродукции;
	ДопРеквизиты = ОписаниеОснования.ДопРеквизиты;
	
	Результат = Новый Структура;
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ВидПродукции));
	Результат.Вставить("documentNumber", ОписаниеОперации.Номер);
	Результат.Вставить("documentDate", ОписаниеОперации.Дата);
	Результат.Вставить("comment", ОписаниеОперации.Комментарий);
	Результат.Вставить("actionType", СостояниеКодовВСервисе(ДопРеквизиты.СостояниеКодов));
	
	Если ДопРеквизиты.СостояниеКодов = Перечисление_СостоянияКодов().ОтгрузкаНаЭкспорт Тогда
		
		Результат.Вставить("kpp", ДопРеквизиты.Площадка.КПП);
		Результат.Вставить("transferDate", ДопРеквизиты.ДатаОтгрузки);
		Результат.Вставить("receiverCountryCode", ДопРеквизиты.КодСтраныПолучателя);
		Результат.Вставить("receiverInn", ДопРеквизиты.ИННПолучателя);
		Результат.Вставить("receiverName", ДопРеквизиты.НаименованиеПолучателя);
		
		Если ДопРеквизиты.ВидТранспортногоДокумента = Перечисление_ВидыТранспортныхДокументов().ТТН Тогда
			Результат.Вставить("transportDetails", Новый Структура);
			Результат.transportDetails.Вставить("vehicleNumber", ДопРеквизиты.ГосномерТранспортногоСредства);
			Результат.transportDetails.Вставить("number", ДопРеквизиты.НомерДокумента);
			Результат.transportDetails.Вставить("date", ДопРеквизиты.ДатаДокумента);
		Иначе
			Результат.Вставить("epdId", ДопРеквизиты.ИдентификаторЭПД);
		КонецЕсли;
		
	КонецЕсли;
	
	position = Новый Структура;
	position.Вставить("name", НаименованиеПозицииДляКонтента(СтрТовара));
	position.Вставить("codes", КодыОпераций_КодыМаркировки(ОперацияОснование, КлючСтрокиОперации, Ложь));
	Результат.Вставить("positions", ЗначениеВМассиве(position));
	
	Возврат Результат;
	
КонецФункции

