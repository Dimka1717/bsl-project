Функция Новый_Операция_Статусы()
	
	ТипыСтатусов = Перечисление_ТипыСтатусов();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	
	Результат = Новый Структура;
	Результат.Вставить(ТипыСтатусов.ОсновнойСтатус, СтатусыОпераций.Новый);
	Результат.Вставить(ИмяПоляДатаСтатуса(ТипыСтатусов.ОсновнойСтатус), '00010101');
	
	Возврат Результат;
	
