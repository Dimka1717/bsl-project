// Удаляет кавычки слева и справа
//
// Параметры:
//  Строка - Строка - строка
// 
// Возвращаемое значение:
//  Строка - строка без кавычек слева и справа
//
Функция СократитьКавычки(Строка) Экспорт
	
	Кавычки = Кавычки();
	ЕстьКавычкиСлева = (Лев(Строка, 1) = Кавычки);
	ЕстьКавычкиСправа = (Прав(Строка, 1) = Кавычки);
	
	Если Не ЕстьКавычкиСлева
		Или Не ЕстьКавычкиСправа Тогда
		Возврат Строка;
	КонецЕсли;
	
	Возврат Сред(Строка, 2, СтрДлина(Строка) - 2);
	
КонецФункции

// Заменяет две двойные кавычки на одну
