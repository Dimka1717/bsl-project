// Форматирует строку версии по правилам семантического версионирования
// https://semver.org/lang/ru/
//
// Параметры:
//  Версия - Строка - версия, которую необходимо форматировать
//
// Возвращаемое значение:
//  Строка
//
Функция СемантическийФорматВерсии(Знач Версия) Экспорт
	
	ПустаяВерсия = "0";
	Версия = СтрЗаменить(Версия, "/", ".");
	ЧастиВерсии = РазделитьСтроку(Версия, ".");
	МажорнаяВерсия = ЗначениеИзМассива(ЧастиВерсии, 0, ПустаяВерсия);
	МинорнаяВерсия = ЗначениеИзМассива(ЧастиВерсии, 1, ПустаяВерсия);
	Исправление = ЗначениеИзМассива(ЧастиВерсии, 2, ПустаяВерсия);
	
	Если Не ВСтрокеТолькоЦифры(МажорнаяВерсия) Тогда
		МажорнаяВерсия = ПустаяВерсия;
	КонецЕсли;
	Если Не ВСтрокеТолькоЦифры(МинорнаяВерсия) Тогда
		МинорнаяВерсия = ПустаяВерсия;
	КонецЕсли;
	Если Не ВСтрокеТолькоЦифры(Исправление) Тогда
		Исправление = ПустаяВерсия;
	КонецЕсли;
	
	Дополнение = "";
	Для Индекс = 3 По ЧастиВерсии.ВГраница() Цикл
		Дополнение = Дополнение + СтрЗаменить(ЧастиВерсии[Индекс], " ", "");
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Дополнение) Тогда
		Результат = ПараметрыВСтроку("%1.%2.%3-%4", МажорнаяВерсия, МинорнаяВерсия, Исправление, Дополнение);
	Иначе
		Результат = ПараметрыВСтроку("%1.%2.%3", МажорнаяВерсия, МинорнаяВерсия, Исправление);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВыводИзОборота_ЕстьНомерПартии(ОписаниеОперации)
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.НомерПартии) Тогда
		Результат = Истина;
	Иначе
		Для Каждого Стр Из ОписаниеОперации.Товары Цикл
			Если ЗначениеЗаполнено(Стр.НомерПартии) Тогда
				Результат = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура Замер_МаксКодовВОперации_Поместить(ОписаниеОперации)
	
	КоличествоКодов = КодыОпераций_ОбщееКоличествоКодов(ОписаниеОперации.Ссылка);
	
	КлючПараметров = "МаксКодовВОперации";
	ТекКоличество = ПараметрыСессии_Прочитать(КлючПараметров);
	
	Если Не ЗначениеЗаполнено(ТекКоличество)
		Или КоличествоКодов > ТекКоличество Тогда
		ПараметрыСессии_Поместить(КлючПараметров, КоличествоКодов);
	КонецЕсли;
	
КонецПроцедуры

