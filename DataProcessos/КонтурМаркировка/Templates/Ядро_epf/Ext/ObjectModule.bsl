// Опеределяет способ изготовления средства идентификации по роли сервис-провайдера
//
// Параметры:
//  РольСервисПровайдера - ПеречислениеСсылка.КонтурМаркировка_РолиСервисПровайдеров
// 
// Возвращаемое значение:
//  Строка - способ изготовления средства идентификации в терминах сервиса
//
Функция СпособИзготовленияВСервисе(РольСервисПровайдера)
	
	РолиСервисПровайдеров = Перечисления.КонтурМаркировка_РолиСервисПровайдеров;
	
	Если РольСервисПровайдера = РолиСервисПровайдеров.ЦЭМ Тогда
		Результат = "Cem";
	ИначеЕсли РольСервисПровайдера = РолиСервисПровайдеров.КонтрактноеПроизводство Тогда
		Результат = "Cm";
	ИначеЕсли РольСервисПровайдера = РолиСервисПровайдеров.ЛогистическийСклад Тогда
		Результат = "Cl";
	ИначеЕсли РольСервисПровайдера = РолиСервисПровайдеров.КомиссионнаяПлощадка Тогда
		Результат = "Ca";
	Иначе
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестная роль сервис-провайдера: %1'"), РольСервисПровайдера);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет статус входящего УПД в терминах 1С по статусу из сервиса
//
// Параметры:
//  СтатусВСервисе - Строка - статус входящего УПД в терминах сервиса
// 
// Возвращаемое значение:
//  Строка - см. Перечисление_СтатусыОпераций()
//
Функция СтатусВходящегоУПДПоСтатусуИзСервиса(СтатусВСервисе)
	
	Результат = СоответствиеСтатусовВходящегоУПД().Получить(НРег(СтатусВСервисе));
	
	Если Результат = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Неизвестный статус входящего УПД: %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, СтатусВСервисе);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Соответствие между статусами входящего УПД в сервисе и статусами операции в 1С
// 
// Возвращаемое значение:
//  Соответствие - содержит:
//   * Ключ - Строка - статус в сервисе;
//   * Значение - Строка - статус, см. Перечисление_СтатусыОпераций()
//
Функция СоответствиеСтатусовВходящегоУПД()
	
	КлючКэш = "СоответствиеСтатусовВходящегоУПД";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	
	Результат = Новый Соответствие;
	Результат.Вставить(НРег("Created"),          СтатусыОпераций.СозданВСервисе);
	Результат.Вставить(НРег("CrptCodesChecked"), СтатусыОпераций.ПроверенВГИС);
	Результат.Вставить(НРег("Completed"),        СтатусыОпераций.ОперацияЗавершена);
	Результат.Вставить(НРег("Archived"),         СтатусыОпераций.ОтправленВАрхив);
	
	Результат = Новый ФиксированноеСоответствие(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ТипУпаковкиПоТипуКодаМаркировкиИзСервиса(ТипКодаМаркировкиВСервисе)
	
	КлючКэш = "ТипУпаковкиПоТипуКодаМаркировкиИзСервиса: " + ТипКодаМаркировкиВСервисе;
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипыУпаковок = Перечисления.КонтурМаркировка_ТипыУпаковок;
	
	СоответствиеТипов = Новый Соответствие;
	СоответствиеТипов.Вставить(НРег("TtisAggregate"), ТипыУпаковок.МонотоварнаяУпаковка);
	СоответствиеТипов.Вставить(НРег("Transport"), ТипыУпаковок.МонотоварнаяУпаковка);
	СоответствиеТипов.Вставить(НРег("Sscc"), ТипыУпаковок.МонотоварнаяУпаковка);
	СоответствиеТипов.Вставить(НРег("Uit"), ТипыУпаковок.МаркированныйТовар);
	СоответствиеТипов.Вставить(НРег("Group"), ТипыУпаковок.МаркированныйТовар);
	СоответствиеТипов.Вставить(НРег("Consumer"), ТипыУпаковок.МаркированныйТовар);
	
	Результат = СоответствиеТипов[НРег(ТипКодаМаркировкиВСервисе)];
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ТипИсходнойОтгрузкиПоТипуИзСервиса(ТипИсходнойОтгрузки)
	
	ТипыИсходныхОтгрузок = Перечисление_ТипыИсходныхОтгрузок();
	
	Результат = Неопределено;
	
	Если НРег(ТипИсходнойОтгрузки) = НРег("Shipment") Тогда
		Результат = ТипыИсходныхОтгрузок.ОтгрузкаИзРФ;
	ИначеЕсли НРег(ТипИсходнойОтгрузки) = НРег("ShipmentCrossBorder") Тогда
		Результат = ТипыИсходныхОтгрузок.ТрансграничнаяОтгрузка;
	ИначеЕсли НРег(ТипИсходнойОтгрузки) = НРег("ShipmentCrossBorderEasCis") Тогда
		Результат = ТипыИсходныхОтгрузок.ТрансграничнаяОтгрузкаКИ;
	ИначеЕсли НРег(ТипИсходнойОтгрузки) = НРег("ShipmentCrossBorderEasGtin") Тогда
		Результат = ТипыИсходныхОтгрузок.ТрансграничнаяОтгрузкаОСУ;
	Иначе
		ТекстОшибки = НСтр("ru = 'Неизвестный тип исходной отгрузки: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, ТипИсходнойОтгрузки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает статус приемки в 1С по способу из сервиса
//
// Параметры:
//  СпособПриемкиВСервисе - Строка- способ приемки в сервисе;
// 
// Возвращаемое значение:
//  Строка - статус приемки в 1С;
//
Функция СтатусПриемкиПоСпособуИзСервиса(СпособПриемкиВСервисе)
	
	Если Не ЗначениеЗаполнено(СпособПриемкиВСервисе) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Неопределено;
	
	Если Не СоответствиеСтатусовПриемки().Свойство(СпособПриемкиВСервисе, Результат) Тогда
		ТекстОшибки = НСтр("ru = 'Неизвестный способ приемки: %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, СпособПриемкиВСервисе);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Соответствие способов приемки в сервисе и статусов в 1С
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - соответствие способов приемки:
//   *Ключ - способ приемки в сервисе;
//   *Значение - статус приемки в 1С, см. функцию Перечисление_СпособыПриемки();
//
Функция СоответствиеСтатусовПриемки()
	
	КлючКэш = "СоответствиеСпособовПриемки";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СпособыПриемки = Перечисление_СтатусыПриемки();
	
	Результат = Новый Структура;
	Результат.Вставить("AcceptAll", СпособыПриемки.Принято);
	Результат.Вставить("RejectAll", СпособыПриемки.Отклонено);
	Результат.Вставить("AcceptPartially", СпособыПриемки.ПринятоЧастично);
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

// Определяет статус уведомления о приемке в терминах 1С по статусу из сервиса
//
// Параметры:
//  СтатусВСервисе - Строка - статус входящего УПД в терминах сервиса
// 
// Возвращаемое значение:
//  Строка - см. Перечисление_СтатусыОпераций()
//
Функция СтатусУведомленияОПриемкеПоСтатусуИзСервиса(СтатусВСервисе)
	
	Если Не ЗначениеЗаполнено(СтатусВСервисе) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Неопределено;
	
	Если Не СоответствиеСтатусовУведомленийОПриемке().Свойство(СтатусВСервисе, Результат) Тогда
		ТекстОшибки = НСтр("ru = 'Неизвестный статус уведомления о приемке: %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, СтатусВСервисе);
		Результат = Перечисление_СтатусыОпераций().ОшибкаОбработки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Соответствие между статусами уведомлений о приемке в сервисе и статусами операции в 1С
// 
// Возвращаемое значение:
//  Структура - содержит:
//   * Ключ - Строка - статус уведомления в сервисе;
//   * Значение - Строка - статус операции в 1С, см. Перечисление_СтатусыОпераций();
//
Функция СоответствиеСтатусовУведомленийОПриемке()
	
	КлючКэш = "СоответствиеСтатусовУведомленийОПриемке";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	
	Результат = Новый Структура;
	Результат.Вставить("archived",         СтатусыОпераций.ОтправленВАрхив);
	Результат.Вставить("readyForSend",     СтатусыОпераций.ГотовКОтправкеВГИС);
	Результат.Вставить("sentForApprove",   СтатусыОпераций.ЗапросСФайломОтправленВГИС);
	Результат.Вставить("approved",         СтатусыОпераций.ПолученУспешныйОтветОтГИС);
	Результат.Вставить("approvedFailed",   СтатусыОпераций.ОтГИСПолученоСообщениеОбОшибке);
	Результат.Вставить("crptSending",      СтатусыОпераций.ОтправкаЗапросаСФайломВГИС);
	Результат.Вставить("crptSendingError", СтатусыОпераций.ОшибкаОтправкиЗапросаСФайломВГИС);
	Результат.Вставить("cancelled",        СтатусыОпераций.ВПриемкеОтказано);
	Результат.Вставить("waitAcceptance",   СтатусыОпераций.ДокументОПриемкеОжидаетПодтверждения);
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

// Определяет статус сверки на ТСД в терминах 1С по статусу из сервиса
//
// Параметры:
//  СтатусСверкиНаТСДВСервисе - Строка - статус сверки в терминах сервиса
// 
// Возвращаемое значение:
//  Строка - см. Перечисление_СтатусыОпераций()
//
Функция СтатусСверкиНаТСДПоСтатусуИзСервиса(СтатусСверкиНаТСДВСервисе)
	
	Если Не ЗначениеЗаполнено(СтатусСверкиНаТСДВСервисе) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Неопределено;
	
	Если Не СоответствиеСтатусовСверкиНаТСД().Свойство(СтатусСверкиНаТСДВСервисе, Результат) Тогда
		ТекстОшибки = НСтр("ru = 'Неизвестный способ приемки: %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, СтатусСверкиНаТСДВСервисе);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Соответствие между статусами сверки на ТСД в сервисе и статусами сверки на ТСД в 1С
// 
// Возвращаемое значение:
//  Структура - содержит:
//   * Ключ - Строка - статус сверки на ТСД в сервисе;
//   * Значение - Строка - статус сверки на ТСД в 1С, см. Перечисление_СтатусыСверкиНаТСД();
//
Функция СоответствиеСтатусовСверкиНаТСД()
	
	КлючКэш = "СоответствиеСтатусСверкиНаТСД";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтатусыСверкиНаТСД = Перечисление_СтатусыСверкиНаТСД();
	
	Результат = Новый Структура;
	Результат.Вставить("NotChecked", СтатусыСверкиНаТСД.СверкаНеПроизведена);
	Результат.Вставить("CheckedNoCodes", СтатусыСверкиНаТСД.СверкаПроизведенаНетКодов);
	Результат.Вставить("CheckedPartially", СтатусыСверкиНаТСД.СверкаПроизведенаЧастично);
	Результат.Вставить("CheckedAll", СтатусыСверкиНаТСД.СверкаПроизведенаПолностью);
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция СтатусТовараНаСверкеПоСтатусуИзСервиса(СтатусТовараНаСверкеВСервисе)
	
