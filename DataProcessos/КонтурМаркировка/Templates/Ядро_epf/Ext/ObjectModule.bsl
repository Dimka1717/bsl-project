Функция Лента_ДопИнформацияОшибкиСобытияИзмененияСтатусаДокумента(Организация, ОписаниеСобытия)
	
	Результат = Новый Структура;
	Результат.Вставить("Организация", Организация);
	Результат.Вставить("ИдентификаторОрганизации", Организация.Идентификатор);
	Результат.Вставить("ИдентификаторСобытия", ОписаниеСобытия.ИдентификаторСобытия);
	Результат.Вставить("ИдентификаторДокумента", ОписаниеСобытия.ИдентификаторДокумента);
	
	Возврат Результат;
	
