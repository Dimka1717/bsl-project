	ВидыДокументовСертификации = Перечисление_ВидыДокументовОбязательнойСертификации();
	
	Если ВидДокументаСертификации = ВидыДокументовСертификации.СертификатСоответствия Тогда
		Результат = "ConformityCert";
	ИначеЕсли ВидДокументаСертификации = ВидыДокументовСертификации.ДекларацияСоответствия Тогда
		Результат = "ConformityDeclar";
	ИначеЕсли ВидДокументаСертификации = ВидыДокументовСертификации.СвидетельствоГосРегистрации Тогда
		Результат = "StateRegistrationCert";
	Иначе
		Результат = "Undefined";
	КонецЕсли;
	
	Возврат Результат;
	
