// Находит настройку документа учета по типу документа 1С
//
// Параметры:
//  ТипДокумента - Строка - имя документа 1С;
//  ВызыватьИсключение - Булево - (необязательный) Ложь, если нужно отключить ошибку отсутсвия настройки;
//
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_ДопСправочники - настройка документа учета
//
Функция НастройкиДокументовУчета_НайтиПоТипуДокумента(ТипДокумента, ВызыватьИсключение = Истина) Экспорт
	
	КлючКэш = "НастройкиДокументовУчета: " + ТипДокумента;
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяРеквизита = "ТипДокумента";
	ИмяСправочника = ИмяСправочникаНастройкиДокументаУчета();
	МассивСсылок = ДопСправочник_НайтиПоДопРеквизиту(ИмяСправочника, ИмяРеквизита, ТипДокумента);
	
	Результат = Неопределено;
	Если ЗначениеЗаполнено(МассивСсылок) Тогда
		Результат = МассивСсылок[0];
	КонецЕсли;
	
	Если Результат = Неопределено И ВызыватьИсключение Тогда
		ТекстОшибки = НСтр("ru = 'Не заполнены настройки для документа, тип: ' %1");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, ТипДокумента);
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

// Читает из доп справочника настройку документа учета
//
// Параметры:
//  Настройка - СправочникСсылка.КонтурМаркировка_ДопСправочники - настройка
// 
// Возвращаемое значение:
//  Структура - см. Новый_НастройкиДокументаУчета()
//
Функция НастройкиДокументаУчета_Прочитать(Настройка) Экспорт
	
	Результат = Новый_НастройкиДокументаУчета();
	ДопСправочник = ДопСправочник_Прочитать(Настройка);
	
	ЗаполнитьПоляСтруктуры(Результат, ДопСправочник);
	ЗаполнитьПоляСтруктуры(Результат, ДопСправочник.ДопРеквизиты);
	
	Возврат Результат;
	
КонецФункции

// Записывает в доп справочник настройки документа учета
//
// Параметры:
//  Настройки - Структура - см. Новый_НастройкиДокументаУчета()
//
Процедура НастройкиДокументаУчета_Записать(Настройки) Экспорт
	
	ИмяСправочника = ИмяСправочникаНастройкиДокументаУчета();
	ДопСправочник = Новый_ЭлементДопСправочника(ИмяСправочника);
	ДопСправочник.Ссылка = Настройки.Ссылка;
	ДопСправочник.Наименование = Настройки.Наименование;
	
	Для Каждого Элемент Из Настройки Цикл
		
		Ключ = Элемент.Ключ;
		Значение = Элемент.Значение;
		
		Если Ключ = "Ссылка" Или Ключ = "Наименование" Тогда
			Продолжить;
		КонецЕсли;
		
		ДопСправочник.ДопРеквизиты.Вставить(Ключ, Значение);
		
	КонецЦикла;
	
	ДопСправочник_Записать(ДопСправочник);
	
	Настройки.Ссылка = ДопСправочник.Ссылка;
	
КонецПроцедуры

