// #Область СтатусыКодовГИСМТ

Процедура СтатусыКодовГИСМТ_Прочитать(ТаблицаКодов) Экспорт
	
	МассивКлючей = ТаблицаЗначений_ВыгрузитьКолонку(ТаблицаКодов, "КлючСтатусаКода");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Производитель.Наименование КАК ПроизводительНаименование,
	|	Т.Производитель.ИНН КАК ПроизводительИНН,
	|	Т.Владелец.Наименование КАК ВладелецНаименование,
	|	Т.Владелец.ИНН КАК ВладелецИНН,
	|	Т.*
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК Т
	|ГДЕ
	|	Т.КлючСтатусаКода В(&МассивКлючей)");
	Запрос.УстановитьПараметр("МассивКлючей", МассивКлючей);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Индекс = ТаблицаКодов.Индексы.Добавить("КлючСтатусаКода");
	
	Отбор = Новый Структура("КлючСтатусаКода");
	Пока Выборка.Следующий() Цикл
		Отбор.КлючСтатусаКода = Выборка.КлючСтатусаКода;
		Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
			ЗаполнитьЗначенияСвойств(СтрКода, Выборка);
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаКодов.Индексы.Удалить(Индекс);
	
КонецПроцедуры

Процедура СтатусыКодовГИСМТ_УдалитьУстаревшие()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючСтатусаКода КАК КлючСтатусаКода
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК Т");
	Выборка = Запрос.Выполнить().Выбрать();
	
	// BSLLS:CreateQueryInCycle-off
	
	Пока Выборка.Следующий() Цикл
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.КлючСтатусаКода КАК КлючСтатусаКода
		|ИЗ
		|	РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК Т
		|ГДЕ
		|	Т.КлючСтатусаКода = &КлючСтатусаКода");
		Запрос.УстановитьПараметр("КлючСтатусаКода", Выборка.КлючСтатусаКода);
		
		Если Запрос.Выполнить().Пустой() Тогда
			НаборЗаписей = РегистрыСведений.КонтурМаркировка_СтатусыКодовГИСМТ.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.КлючСтатусаКода.Установить(Выборка.КлючСтатусаКода);
			НаборЗаписей.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
	// BSLLS:CreateQueryInCycle-on
	
КонецПроцедуры

Функция СтатусыКодовГИСМТ_ЗаполнитьСтроку(СтрокаТаблицы, CisInfo, ПроверитьРД = Ложь) Экспорт
	
	Статус = СтатусКодаПоСтатусуИзСервиса(CisInfo);
	Если Не ЗначениеЗаполнено(Статус) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтрокаТаблицы.Статус = Статус;
	
	value = CisInfo["value"];
	Если ЗначениеЗаполнено(value) Тогда
		
		СтрокаТаблицы.ПроизводительНаименование = value["producerName"];
		СтрокаТаблицы.ПроизводительИНН = value["producerInn"];
		
		СтрокаТаблицы.ВладелецНаименование = value["ownerName"];
		СтрокаТаблицы.ВладелецИНН = value["ownerInn"];
		СтрокаТаблицы.Владелец = Неопределено;
		
		СтрокаТаблицы.ДатаНанесения = ДатаИзСтрокиXML(value["receiptDate"]);
		СтрокаТаблицы.ДатаВводаВОборот = ДатаИзСтрокиXML(value["introducedDate"]);
		
		vetDocumentId = value["vetDocumentId"];
		Если ЗначениеЗаполнено(vetDocumentId) Тогда
			СтрокаТаблицы.ИдентификаторВСД = vetDocumentId;
		КонецЕсли;
		
		producedDate = ДатаИзСтрокиXMLБезUTC(value["producedDate"]);
		Если ЗначениеЗаполнено(producedDate) Тогда
			СтрокаТаблицы.ДатаПроизводства = producedDate;
		КонецЕсли;
		
		expirationDate = ДатаИзСтрокиXMLБезUTC(value["expirationDate"]);
		Если ЗначениеЗаполнено(expirationDate) Тогда
			СтрокаТаблицы.ДатаСрокаГодности = expirationDate;
		КонецЕсли;
		
		productGroup = value["productGroup"];
		Если ЗначениеЗаполнено(productGroup) Тогда
			СтрокаТаблицы.ВидПродукции = ВидПродукцииПоТоварнойГруппеИзСервиса(productGroup);
		КонецЕсли;
		
		packageType = value["packageType"];
		Если ЗначениеЗаполнено(packageType) Тогда
			СтрокаТаблицы.ТипУпаковкиГИСМТ = ТипУпаковкиГИСМТПоТипуУпаковкиИзСервиса(packageType);
		КонецЕсли;
		
		generalPackageType = value["generalPackageType"];
		Если ЗначениеЗаполнено(generalPackageType) Тогда
			СтрокаТаблицы.ОбщийТипУпаковки = ОбщийТипУпаковкиПоОбщемуТипуУпаковкиИзСервиса(generalPackageType);
		КонецЕсли;
		
		partNumber = value["partNumber"];
		Если ЗначениеЗаполнено(partNumber) Тогда
			СтрокаТаблицы.НомерПартии = partNumber;
		КонецЕсли;
		
		emissionType = value["emissionType"];
		Если ЗначениеЗаполнено(emissionType) Тогда
			СтрокаТаблицы.СпособВыпускаТоваров = СпособВыпускаТоваровПоСпособуВыпускаИзСервиса(emissionType);
		КонецЕсли;
		
		Если ПроверитьРД Тогда
			certificateDocuments = value["certificateDocuments"];
			СтрокаТаблицы.РезультатПроверкиРД = РезультатПроверкиРДПоГруппамСтатусаИзСервиса(certificateDocuments);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция РезультатПроверкиРДПоГруппамСтатусаИзСервиса(certificateDocuments)
	
	РезультатыПроверкиРД = Перечисление_РезультатыПроверкиРДКода();
	
	Если Не ЗначениеЗаполнено(certificateDocuments) Тогда
		Возврат РезультатыПроверкиРД.Неопределен;
	КонецЕсли;
	
	ЗеленыеСтатусы = ",1,26,27,28,29,30,";
	ЖелтыеСтатусы = ",2,5,6,7,9,11,12,13,14,15,21,22,23,24,25,";
	КрасныеСтатусы = ",3,16,17,18,19,20,";
	
	ЕстьЗеленыеСтатусы = Ложь;
	ЕстьЖелтыеСтатусы = Ложь;
	ЕстьКрасныеСтатусы = Ложь;
	ЕстьНеизвестныеСтатусы = Ложь;
	Для Каждого Элемент Из certificateDocuments Цикл
		statusGroup = Элемент["statusGroup"];
		Если Не ЗначениеЗаполнено(statusGroup) Тогда
			Продолжить;
		ИначеЕсли Найти(ЗеленыеСтатусы, "," + statusGroup + ",") > 0 Тогда
			ЕстьЗеленыеСтатусы = Истина;
			Прервать;
		ИначеЕсли Найти(ЖелтыеСтатусы, "," + statusGroup + ",") > 0 Тогда
			ЕстьЖелтыеСтатусы = Истина;
		ИначеЕсли Найти(КрасныеСтатусы, "," + statusGroup + ",") > 0 Тогда
			ЕстьКрасныеСтатусы = Истина;
		Иначе
			ЕстьНеизвестныеСтатусы = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьЗеленыеСтатусы Тогда
		Результат = РезультатыПроверкиРД.ДоступенДляОтгрузкиИВводаВОборот;
	ИначеЕсли ЕстьЖелтыеСтатусы Тогда
		Результат = РезультатыПроверкиРД.ДоступенТолькоДляОтгрузки;
	ИначеЕсли ЕстьКрасныеСтатусы Тогда
		Результат = РезультатыПроверкиРД.Недоступен;
	ИначеЕсли ЕстьНеизвестныеСтатусы Тогда
		Результат = РезультатыПроверкиРД.Неизвестен;
	Иначе
		Результат = РезультатыПроверкиРД.Неопределен;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Перечисление_РезультатыПроверкиРДКода()
	
	КлючКэш = "РезультатыПроверкиРДКода";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Новый Структура;
	
	Результат.Вставить("ДоступенДляОтгрузкиИВводаВОборот"	, "Доступен для отгрузки и ввода в оборот");
	Результат.Вставить("ДоступенТолькоДляОтгрузки"			, "Доступен только для отгрузки");
	Результат.Вставить("Недоступен"							, "Недоступен");
	Результат.Вставить("Неизвестен"							, "Неизвестен");
	Результат.Вставить("Неопределен"						, "Неопределен");
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция КлючСтатусаКода_Подобрать(КлючевыеРеквизиты, КэшРезультатов = Неопределено)
	
	Если КэшРезультатов <> Неопределено Тогда
		ИменаПолей = СтатусыКодовГИСМТ_ИменаПолей();
		Если ЗначениеЗаполнено(КэшРезультатов) Тогда
			Отбор = Новый Структура(ИменаПолей);
			ЗаполнитьЗначенияСвойств(Отбор, КлючевыеРеквизиты);
			НайденныеСтроки = КэшРезультатов.НайтиСтроки(Отбор);
			Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
				Возврат НайденныеСтроки[0].КлючСтатусаКода;
			КонецЕсли;
		Иначе
			КэшРезультатов = Новый_ТаблицаКодов();
			КэшРезультатов.Индексы.Добавить(ИменаПолей);
		КонецЕсли;
	КонецЕсли;
	
	Результат = КлючСтатусаКода_НайтиСуществующий(КлючевыеРеквизиты);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		КлючСтатусаКода_Записать(КлючевыеРеквизиты);
		Результат = КлючСтатусаКода_НайтиСуществующий(КлючевыеРеквизиты);
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		СтрКэша = КэшРезультатов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрКэша, КлючевыеРеквизиты);
		СтрКэша.КлючСтатусаКода = Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КлючСтатусаКода_НайтиСуществующий(КлючевыеРеквизиты)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.КлючСтатусаКода КАК КлючСтатусаКода
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК Т
	|ГДЕ
	|	&Условия");
	
	Условия = "";
	Разделитель = "";
	Для каждого ИмяПоля Из РазделитьСтроку(СтатусыКодовГИСМТ_ИменаПолей()) Цикл
		Запрос.УстановитьПараметр(ИмяПоля, КлючевыеРеквизиты[ИмяПоля]);
		Условия = Условия + Разделитель + ПараметрыВСтроку("Т.%1 = &%1", ИмяПоля);
		Разделитель = " И ";
	КонецЦикла;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условия", Условия);
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "КлючСтатусаКода");
	
КонецФункции

Процедура КлючСтатусаКода_Записать(КлючевыеРеквизиты)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		СтатусыКодовГИСМТ_Заблокировать(КлючевыеРеквизиты);
		
		НаборЗаписей = РегистрыСведений.КонтурМаркировка_СтатусыКодовГИСМТ.СоздатьНаборЗаписей();
		Для каждого ИмяПоля Из РазделитьСтроку(СтатусыКодовГИСМТ_ИменаПолей()) Цикл
			НаборЗаписей.Отбор[ИмяПоля].Установить(КлючевыеРеквизиты[ИмяПоля]);
		КонецЦикла;
		
		ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), КлючевыеРеквизиты);
		
		НаборЗаписей.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура СтатусыКодовГИСМТ_Заблокировать(КлючевыеРеквизиты)
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Для каждого ИмяПоля Из РазделитьСтроку(СтатусыКодовГИСМТ_ИменаПолей()) Цикл
		ЭлементБлокировки.УстановитьЗначение(ИмяПоля, КлючевыеРеквизиты[ИмяПоля]);
	КонецЦикла;
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

Функция СтатусыКодовГИСМТ_ИменаПолей() Экспорт
	
	КлючКэш = "СтатусыКодовГИСМТ_ИменаПолей";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВсеПоля = Новый Массив;
	Для каждого Измерение Из Метаданные.РегистрыСведений.КонтурМаркировка_СтатусыКодовГИСМТ.Измерения Цикл
		Если Измерение.Имя <> "КлючСтатусаКода" Тогда
			ВсеПоля.Добавить(Измерение.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Результат = СоединитьСтроку(ВсеПоля, ",");
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти

// #Область УстаревшиеКоды

Процедура УстаревшиеКоды_Записать(КлючиКодов)
	
	Если Не ЗначениеЗаполнено(КлючиКодов) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КодыМаркировки.КлючКода КАК КлючКода
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_УстаревшиеКоды КАК УстаревшиеКоды
	|		ПО КодыМаркировки.КлючКода = УстаревшиеКоды.КлючКода
	|ГДЕ
	|	КодыМаркировки.КлючКода В(&КлючиКодов)
	|	И УстаревшиеКоды.КлючКода ЕСТЬ NULL");
	Запрос.УстановитьПараметр("КлючиКодов", КлючиКодов);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ПорцияЗаписей = МодульОбщегоНазначения().НовыйУникальныйИдентификаторПервойВерсии();
	Набор = РегистрыСведений.КонтурМаркировка_УстаревшиеКоды.СоздатьНаборЗаписей();
	Набор.Отбор.ПорцияЗаписей.Установить(ПорцияЗаписей);
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = Набор.Добавить();
		Запись.КлючКода = Выборка.КлючКода;
		Запись.ПорцияЗаписей = ПорцияЗаписей;
	КонецЦикла;
	
	Набор.Записать();
	
КонецПроцедуры

Процедура УстаревшиеКоды_ВТ_Удалить(МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	УстаревшиеКоды.КлючКода КАК КлючКода,
	|	УстаревшиеКоды.ПорцияЗаписей КАК ПорцияЗаписей
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_УстаревшиеКоды КАК УстаревшиеКоды
	|		ПО ТаблицаКодов.КлючКода = УстаревшиеКоды.КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Результат.ПорцияЗаписей КАК ПорцияЗаписей
	|ИЗ
	|	Результат КАК Результат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Результат.КлючКода КАК КлючКода
	|ИЗ
	|	Результат КАК Результат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Результат");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	РезультатЗапросаПорцииКодов = РезультатыЗапроса[1];
	РезультатЗапросаКлючиКодов = РезультатыЗапроса[2];
	Если РезультатЗапросаКлючиКодов.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов = РезультатЗапросаКлючиКодов.Выгрузить();
	ТаблицаКодов.Индексы.Добавить("КлючКода");
	
	Выборка = РезультатЗапросаПорцииКодов.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Набор = РегистрыСведений.КонтурМаркировка_УстаревшиеКоды.СоздатьНаборЗаписей();
		Набор.Отбор.ПорцияЗаписей.Установить(Выборка.ПорцияЗаписей);
		Набор.Прочитать();
		
		Для Сч = -(Набор.Количество() - 1) По 0 Цикл
			Если ТаблицаКодов.Найти(Набор[-Сч].КлючКода, "КлючКода") <> Неопределено Тогда
				Набор.Удалить(-Сч);
			КонецЕсли;
		КонецЦикла;
		
		Если Набор.Модифицированность() Тогда
			Набор.ОбменДанными.Загрузка = Истина;
			Набор.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстаревшиеКоды_УдалитьУстаревшие(АктуальнаяДатаЗаписей)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	УстаревшиеКоды.ПорцияЗаписей КАК ПорцияЗаписей,
	|	УстаревшиеКоды.КлючКода КАК КлючКода
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_УстаревшиеКоды КАК УстаревшиеКоды
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО УстаревшиеКоды.КлючКода = КодыМаркировки.КлючКода
	|ГДЕ
	|	УстаревшиеКоды.ДатаЗаписи < &АктуальнаяДатаЗаписей
	|	И КодыМаркировки.КлючКода ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Результат.ПорцияЗаписей КАК ПорцияЗаписей
	|ИЗ
	|	Результат КАК Результат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Результат.КлючКода КАК КлючКода
	|ИЗ
	|	Результат КАК Результат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Результат");
	Запрос.УстановитьПараметр("АктуальнаяДатаЗаписей", АктуальнаяДатаЗаписей);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	РезультатЗапросаПорцииКодов = РезультатыЗапроса[1];
	РезультатЗапросаКлючиКодов = РезультатыЗапроса[2];
	Если РезультатЗапросаКлючиКодов.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов = РезультатЗапросаКлючиКодов.Выгрузить();
	ТаблицаКодов.Индексы.Добавить("КлючКода");
	
	Выборка = РезультатЗапросаПорцииКодов.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Набор = РегистрыСведений.КонтурМаркировка_УстаревшиеКоды.СоздатьНаборЗаписей();
		Набор.Отбор.ПорцияЗаписей.Установить(Выборка.ПорцияЗаписей);
		Набор.Прочитать();
		
		Для Сч = -(Набор.Количество() - 1) По 0 Цикл
			Если ТаблицаКодов.Найти(Набор[-Сч].КлючКода, "КлючКода") <> Неопределено Тогда
				Набор.Удалить(-Сч);
			КонецЕсли;
		КонецЦикла;
		
		Если Набор.Модифицированность() Тогда
			Набор.ОбменДанными.Загрузка = Истина;
			Набор.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// #КонецОбласти

// #Область КодыОпераций

Функция КодыОпераций_Прочитать(Операция, КлючСтрокиОперации = Неопределено) Экспорт
	
	ДокументУчета = ЗначениеРеквизитаОбъекта_Марк(Операция, "ДокументУчета");
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	КодыОпераций.КлючКода КАК КлючКода,
	|	КодыОпераций.КлючСтрокиОперации КАК КлючСтрокиОперации,
	|	КодыОпераций.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	ЕСТЬNULL(ТоварыДокумента.НомерСтроки, 0) КАК НомерСтрокиДокумента
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ПО КодыОпераций.КлючСтрокиДокумента = ТоварыДокумента.КлючСтрокиДокумента
	|			И (ТоварыДокумента.Ссылка = &ДокументУчета)
	|ГДЕ
	|	КодыОпераций.Операция = &Операция
	|	И &КлючСтрокиОперации";
	
	Если КлючСтрокиОперации = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиОперации", "ИСТИНА");
	Иначе
		Условие = "КодыОпераций.КлючСтрокиОперации = &КлючСтрокиОперации";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиОперации", Условие);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Операция", Операция);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("КлючСтрокиОперации", КлючСтрокиОперации);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый_ТаблицаКодов();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), Выборка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура КодыОпераций_Записать(ТаблицаКодов, Операция, УдалитьСтарыеКоды = Истина) Экспорт
	
	Если Не УдалитьСтарыеКоды
		И ЗначениеЗаполнено(ТаблицаКодов)
		И ТаблицаКодов.Количество() <= НебольшоеКоличествоЗаписейРегистра()
		И КодыОпераций_ОбщееКоличествоКодов(Операция) > НебольшоеКоличествоЗаписейРегистра() Тогда
		КодыОпераций_ЗаписатьЧерезМенеджерЗаписи(ТаблицаКодов, Операция);
		Возврат;
	КонецЕсли;
	
	ТипОперации = ЗначениеРеквизитаОбъекта_Марк(Операция, "ТипОперации");
	МожноХранитьУпакованнеКоды = (ТипыОперацийМожноХранитьУпакованнеКоды().Найти(ТипОперации) <> Неопределено);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыОпераций_Заблокировать(Операция);
		
		Набор = РегистрыСведений.КонтурМаркировка_КодыОпераций.СоздатьНаборЗаписей();
		Набор.Отбор.Операция.Установить(Операция);
		Набор.Прочитать();
		
		ТаблицаНабора = Набор.Выгрузить();
		ТаблицаНабора.Колонки.Добавить("Записать");
		ИндексКлючКода = ТаблицаНабора.Индексы.Добавить("КлючКода");
		
		Для каждого СтрКода Из ТаблицаКодов Цикл
			
			КодУпакован = ЗначениеЗаполнено(СтрКода.КлючАгрегата) Или ЗначениеЗаполнено(СтрКода.КодАгрегата);
			
			СтрНабора = ТаблицаНабора.Найти(СтрКода.КлючКода, "КлючКода");
			Если СтрНабора = Неопределено Тогда
				СтрНабора = ТаблицаНабора.Добавить();
				СтрНабора.КлючКода = СтрКода.КлючКода;
			КонецЕсли;
			
			СтрНабора.Операция = Операция;
			СтрНабора.КлючСтрокиОперации = СтрКода.КлючСтрокиОперации;
			СтрНабора.КлючСтрокиДокумента = СтрКода.КлючСтрокиДокумента;
			
			Если СтрКода.УдалитьИзОперации Тогда
				СтрНабора.Записать = Ложь;
			ИначеЕсли КодУпакован Тогда
				СтрНабора.Записать = МожноХранитьУпакованнеКоды;
			Иначе
				СтрНабора.Записать = Истина;
			КонецЕсли;
			
		КонецЦикла;
		ТаблицаНабора.Индексы.Удалить(ИндексКлючКода);
		
		Если Не УдалитьСтарыеКоды Тогда
			Для каждого СтрНабора Из ТаблицаНабора Цикл
				Если СтрНабора.Записать = Неопределено Тогда
					СтрНабора.Записать = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		УдаленныеКоды = Новый Массив;
		Для Сч = -(ТаблицаНабора.Количество() - 1) По 0 Цикл
			СтрНабора = ТаблицаНабора.Получить(-Сч);
			Если СтрНабора.Записать <> Истина Тогда
				УдаленныеКоды.Добавить(СтрНабора.КлючКода);
				ТаблицаНабора.Удалить(СтрНабора);
			КонецЕсли;
		КонецЦикла;
		ТаблицаНабора.Колонки.Удалить("Записать");
		
		Набор.Загрузить(ТаблицаНабора);
		Набор.Записать();
		
		КодыОпераций_ОбновитьКоличествоКодов(Операция);
		КодыЗаказов_ВернутьКодыВЗаказы(УдаленныеКоды);
		УстаревшиеКоды_Записать(УдаленныеКоды);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура КодыОпераций_ЗаписатьЧерезМенеджерЗаписи(ТаблицаКодов, Операция)
	
	ТипОперации = ЗначениеРеквизитаОбъекта_Марк(Операция, "ТипОперации");
	МожноХранитьУпакованнеКоды = (ТипыОперацийМожноХранитьУпакованнеКоды().Найти(ТипОперации) <> Неопределено);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыОпераций_Заблокировать(Операция);
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.*
		|ИЗ
		|	РегистрСведений.КонтурМаркировка_КодыОпераций КАК Т
		|ГДЕ
		|	Т.Операция = &Операция
		|	И Т.КлючКода В(&КлючиКодов)");
		Запрос.УстановитьПараметр("Операция", Операция);
		Запрос.УстановитьПараметр("КлючиКодов", ТаблицаКодов.ВыгрузитьКолонку("КлючКода"));
		ТаблицаНабора = Запрос.Выполнить().Выгрузить();
		
		УдаленныеКоды = Новый Массив;
		
		Для каждого СтрКода Из ТаблицаКодов Цикл
			
			КодУпакован = ЗначениеЗаполнено(СтрКода.КлючАгрегата) Или ЗначениеЗаполнено(СтрКода.КодАгрегата);
			
			СтрНабора = ТаблицаНабора.Найти(СтрКода.КлючКода, "КлючКода");
			
			Если СтрКода.УдалитьИзОперации Или (КодУпакован И Не МожноХранитьУпакованнеКоды) Тогда
				Если СтрНабора <> Неопределено Тогда
					Запись = РегистрыСведений.КонтурМаркировка_КодыОпераций.СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(Запись, СтрНабора);
					Запись.Удалить();
				КонецЕсли;
				УдаленныеКоды.Добавить(СтрКода.КлючКода);
				Продолжить;
			КонецЕсли;
			
			Если СтрНабора = Неопределено Тогда
				Запись = РегистрыСведений.КонтурМаркировка_КодыОпераций.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись, СтрКода);
				Запись.Операция = Операция;
				Запись.Записать();
			Иначе
				Запись = РегистрыСведений.КонтурМаркировка_КодыОпераций.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись, СтрНабора);
				Запись.Операция = Операция;
				Запись.Прочитать();
				ЗаполнитьЗначенияСвойств(Запись, СтрКода);
				Запись.Записать();
			КонецЕсли;
			
		КонецЦикла;
		
		КодыОпераций_ОбновитьКоличествоКодов(Операция);
		КодыЗаказов_ВернутьКодыВЗаказы(УдаленныеКоды);
		УстаревшиеКоды_Записать(УдаленныеКоды);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура КодыОпераций_ОбновитьКоличествоКодов(Операция)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КодыОпераций.Операция КАК Операция,
	|	КодыОпераций.КлючСтрокиОперации КАК КлючСтрокиОперации,
	|	ЕСТЬNULL(ИнформацияОКодах.КлючНоменклатуры1С, ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_КлючиНоменклатуры1С.ПустаяСсылка)) КАК КлючНоменклатуры1С,
	|	ЕСТЬNULL(ИнформацияОКодах.Товар, ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_Товары.ПустаяСсылка)) КАК Товар,
	|	ЕСТЬNULL(ИнформацияОКодах.ТипУпаковки, ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ТипыУпаковок.ПустаяСсылка)) КАК ТипУпаковки,
	|	ЕСТЬNULL(ИнформацияОКодах.ОбщийТипУпаковки, ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ОбщиеТипыУпаковок.ПустаяСсылка)) КАК ОбщийТипУпаковки,
	|	ЕСТЬNULL(СтатусыКодов.Статус, """") КАК СтатусКодов,
	|	КОЛИЧЕСТВО(*) КАК КоличествоКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО КодыОпераций.КлючКода = СвязиКлючейКодов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (СвязиКлючейКодов.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|		ПО (СвязиКлючейКодов.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода)
	|ГДЕ
	|	КодыОпераций.Операция = &Операция
	|
	|СГРУППИРОВАТЬ ПО
	|	КодыОпераций.Операция,
	|	КодыОпераций.КлючСтрокиОперации,
	|	ЕСТЬNULL(ИнформацияОКодах.КлючНоменклатуры1С, ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_КлючиНоменклатуры1С.ПустаяСсылка)),
	|	ЕСТЬNULL(ИнформацияОКодах.Товар, ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_Товары.ПустаяСсылка)),
	|	ЕСТЬNULL(ИнформацияОКодах.ТипУпаковки, ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ТипыУпаковок.ПустаяСсылка)),
	|	ЕСТЬNULL(ИнформацияОКодах.ОбщийТипУпаковки, ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ОбщиеТипыУпаковок.ПустаяСсылка)),
	|	ЕСТЬNULL(СтатусыКодов.Статус, """")");
	
	Запрос.УстановитьПараметр("Операция", Операция);
	
	Набор = РегистрыСведений.КонтурМаркировка_КоличествоКодовОпераций.СоздатьНаборЗаписей();
	Набор.Отбор.Операция.Установить(Операция);
	Набор.Загрузить(Запрос.Выполнить().Выгрузить());
	Набор.Записать();
	
КонецПроцедуры

Процедура КодыОпераций_ОбновитьКоличествоКодовПоТаблицеКодов(ТаблицаКодов)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Операция КАК Операция
	|ПОМЕСТИТЬ Операции
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыОпераций КАК Т
	|ГДЕ
	|	Т.КлючКода В(&КлючиКодов)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Операция
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КодыОпераций.Операция КАК Операция,
	|	КодыОпераций.КлючСтрокиОперации КАК КлючСтрокиОперации,
	|	ЕСТЬNULL(ИнформацияОКодах.КлючНоменклатуры1С, ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_КлючиНоменклатуры1С.ПустаяСсылка)) КАК КлючНоменклатуры1С,
	|	ЕСТЬNULL(ИнформацияОКодах.Товар, ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_Товары.ПустаяСсылка)) КАК Товар,
	|	ЕСТЬNULL(ИнформацияОКодах.ТипУпаковки, ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ТипыУпаковок.ПустаяСсылка)) КАК ТипУпаковки,
	|	ЕСТЬNULL(ИнформацияОКодах.ОбщийТипУпаковки, ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ОбщиеТипыУпаковок.ПустаяСсылка)) КАК ОбщийТипУпаковки,
	|	ЕСТЬNULL(СтатусыКодов.Статус, """") КАК СтатусКодов,
	|	СУММА(1) КАК КоличествоКодов
	|ИЗ
	|	Операции КАК Операции
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ПО Операции.Операция = КодыОпераций.Операция
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО (КодыОпераций.КлючКода = СвязиКлючейКодов.КлючКода)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (СвязиКлючейКодов.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|		ПО (СвязиКлючейКодов.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода)
	|
	|СГРУППИРОВАТЬ ПО
	|	КодыОпераций.Операция,
	|	КодыОпераций.КлючСтрокиОперации,
	|	ЕСТЬNULL(ИнформацияОКодах.КлючНоменклатуры1С, ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_КлючиНоменклатуры1С.ПустаяСсылка)),
	|	ЕСТЬNULL(ИнформацияОКодах.Товар, ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_Товары.ПустаяСсылка)),
	|	ЕСТЬNULL(ИнформацияОКодах.ТипУпаковки, ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ТипыУпаковок.ПустаяСсылка)),
	|	ЕСТЬNULL(ИнформацияОКодах.ОбщийТипУпаковки, ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ОбщиеТипыУпаковок.ПустаяСсылка)),
	|	ЕСТЬNULL(СтатусыКодов.Статус, """")
	|
	|УПОРЯДОЧИТЬ ПО
	|	Операция
	|ИТОГИ ПО
	|	Операция");
	
	Запрос.УстановитьПараметр("КлючиКодов", ТаблицаЗначений_ВыгрузитьКолонку(ТаблицаКодов, "КлючКода"));
	
	ВыборкаОперация = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаОперация.Следующий() Цикл
		
		Набор = РегистрыСведений.КонтурМаркировка_КоличествоКодовОпераций.СоздатьНаборЗаписей();
		Набор.Отбор.Операция.Установить(ВыборкаОперация.Операция);
		
		Выборка = ВыборкаОперация.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Набор.Добавить(), Выборка);
		КонецЦикла;
		
		Набор.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

