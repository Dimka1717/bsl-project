КонецПроцедуры

Процедура ТаблицаКодов_ЗаполнитьПорциюЗаписей(ТаблицаКодов)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.ПорцияЗаписей КАК ПорцияЗаписей
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК Т
	|ГДЕ
	|	Т.КлючКода В(&КлючиКодов)");
	Запрос.УстановитьПараметр("КлючиКодов", ТаблицаКодов.ВыгрузитьКолонку("КлючКода"));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Индекс = ТаблицаКодов.Индексы.Добавить("КлючКода");
	Пока Выборка.Следующий() Цикл
		СтрКода = ТаблицаКодов.Найти(Выборка.КлючКода, "КлючКода");
		СтрКода.ПорцияЗаписей = Выборка.ПорцияЗаписей;
	КонецЦикла;
	ТаблицаКодов.Индексы.Удалить(Индекс);
	
КонецПроцедуры

Функция ТаблицаКодов_ТоварныеСтрокиАгрегата(ТаблицаКодов, СтрАгрегата)
	
	СтрокиКодов = Новый Массив;
	Если ЗначениеЗаполнено(СтрАгрегата.КлючКода) Тогда
		СтрокиКодов = ТаблицаКодов.НайтиСтроки(Новый Структура("КлючАгрегата", СтрАгрегата.КлючКода));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтрокиКодов)
		И ЗначениеЗаполнено(СтрАгрегата.КодМаркировки) Тогда
		СтрокиКодов = ТаблицаКодов.НайтиСтроки(Новый Структура("КодАгрегата", СтрАгрегата.КодМаркировки));
	КонецЕсли;
	
	Результат = Новый Массив;
	Для каждого СтрКода Из СтрокиКодов Цикл
		Если СтрКода.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка Тогда
			ДополнитьМассив(Результат, ТаблицаКодов_ТоварныеСтрокиАгрегата(ТаблицаКодов, СтрКода));
		Иначе
			Результат.Добавить(СтрКода);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаКодов_ВложенныеСтрокиАгрегата(ТаблицаКодов, СтрАгрегата)
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(СтрАгрегата.КлючКода) Тогда
		Результат = ТаблицаКодов.НайтиСтроки(Новый Структура("КлючАгрегата", СтрАгрегата.КлючКода));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрАгрегата.КодМаркировки) И Не ЗначениеЗаполнено(Результат) Тогда
		Результат = ТаблицаКодов.НайтиСтроки(Новый Структура("КодАгрегата", СтрАгрегата.КодМаркировки));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ТаблицаКодов_ЗаполнитьКлючиАгрегатов(ТаблицаКодов)
	
	Если Не ТаблицаКодов_ЕстьКодыАгрегатов(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	Индекс = ТаблицаКодов.Индексы.Добавить("КодМаркировки");
	
	КэшКлючейАгрегатов = Новый Соответствие;
	
	Для каждого Стр Из ТаблицаКодов Цикл
		
		КодАгрегата = Стр.КодАгрегата;
		Если Не ЗначениеЗаполнено(КодАгрегата) Тогда
			Стр.КлючАгрегата = Неопределено;
			Продолжить;
		КонецЕсли;
		
		КлючАгрегата = КэшКлючейАгрегатов[КодАгрегата];
		
		Если Не ЗначениеЗаполнено(КлючАгрегата) Тогда
			СтрАгрегата = ТаблицаКодов.Найти(КодАгрегата, "КодМаркировки");
			Если СтрАгрегата <> Неопределено Тогда
				КлючАгрегата = СтрАгрегата.КлючКода;
			Иначе
				КлючАгрегата = КодМаркировки_НайтиКлюч(КодАгрегата);
				Если Не ЗначениеЗаполнено(КлючАгрегата) Тогда
					ШаблонОшибки = НСтр("ru = 'В таблице кодов не удалось найти агрегат ""%1"", в который упакован код ""%2""'");
					ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки
					, УдалитьНедопустимыеСимволыXML(КодАгрегата)
					, УдалитьНедопустимыеСимволыXML(Стр.КодМаркировки));
					ВызватьИсключение ТекстОшибки;
				КонецЕсли;
			КонецЕсли;
			КэшКлючейАгрегатов.Вставить(КодАгрегата, КлючАгрегата);
		КонецЕсли;
		
		Стр.КлючАгрегата = КлючАгрегата;
		
	КонецЦикла;
	
	ТаблицаКодов.Индексы.Удалить(Индекс);
	
КонецПроцедуры

Процедура ТаблицаКодов_ОбновитьТоварыАгрегатов(ТаблицаКодов)
	
	Если Не ТаблицаКодов_ЕстьАгрегатыИВложенныеКоды(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ИндексКодАгрегата = ТаблицаКодов.Индексы.Добавить("КодАгрегата");
	ИндексКлючАгрегата = ТаблицаКодов.Индексы.Добавить("КлючАгрегата");
	Отбор = Новый Структура("ОбщийТипУпаковки", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	
	ТоварыАгрегатов = Новый_ТоварыАгрегатов();
	Для каждого СтрАгрегата Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
		Для каждого СтрКода Из ТаблицаКодов_ТоварныеСтрокиАгрегата(ТаблицаКодов, СтрАгрегата) Цикл
			Стр = ТоварыАгрегатов.Добавить();
			Стр.Товар = СтрКода.Товар;
			Стр.КлючНоменклатуры1С = СтрКода.КлючНоменклатуры1С;
			Стр.КлючКода = СтрАгрегата.КлючКода;
			Стр.КоличествоУпаковок = 1;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаКодов.Индексы.Удалить(ИндексКодАгрегата);
	ТаблицаКодов.Индексы.Удалить(ИндексКлючАгрегата);
	
	ТоварыАгрегатов.Свернуть("КлючКода, Товар, КлючНоменклатуры1С", "Количество, КоличествоУпаковок");
	
	ТоварыАгрегатов_Записать(ТоварыАгрегатов);
	
КонецПроцедуры

Процедура ТаблицаКодов_УточнитьДанныеАгрегатов(ТаблицаКодов) Экспорт
	
	Если Не ТаблицаКодов_ЕстьАгрегатыИВложенныеКоды(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ИндексКодАгрегата = ТаблицаКодов.Индексы.Добавить("КодАгрегата");
	ИндексКлючАгрегата = ТаблицаКодов.Индексы.Добавить("КлючАгрегата");
	
	ТипыУпаковок = Перечисления.КонтурМаркировка_ТипыУпаковок;
	ОбщиеТипыУпаковок = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок;
	
	Отбор = Новый Структура("ТипУпаковки", ТипыУпаковок.МонотоварнаяУпаковка);
	СтрокиАгрегатов = ТаблицаКодов.НайтиСтроки(Отбор);
	
	Отбор = Новый Структура("ТипУпаковки", ТипыУпаковок.МультитоварнаяУпаковка);
	ДополнитьМассив(СтрокиАгрегатов, ТаблицаКодов.НайтиСтроки(Отбор));
	
	Отбор = Новый Структура("ОбщийТипУпаковки", ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	ДополнитьМассив(СтрокиАгрегатов, ТаблицаКодов.НайтиСтроки(Отбор), Истина);
	
	Для Каждого СтрАгрегата Из СтрокиАгрегатов Цикл
		
		ВложенныеСтроки = ТаблицаКодов_ТоварныеСтрокиАгрегата(ТаблицаКодов, СтрАгрегата);
		Если Не ЗначениеЗаполнено(ВложенныеСтроки) Тогда
			ВложенныеСтроки = ТаблицаКодов_ВложенныеСтрокиАгрегата(ТаблицаКодов, СтрАгрегата);
			Если Не ЗначениеЗаполнено(ВложенныеСтроки) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Товар = Неопределено;
		ВидПродукции = Неопределено;
		КлючНоменклатуры1С = Неопределено;
		КлючСтрокиДокумента = Неопределено;
		
		ЭтоПерваяСтрока = Истина;
		
		Для каждого СтрКода Из ВложенныеСтроки Цикл
			
			Если ЭтоПерваяСтрока Тогда
				Товар = СтрКода.Товар;
				ВидПродукции = СтрКода.ВидПродукции;
				КлючНоменклатуры1С = СтрКода.КлючНоменклатуры1С;
				КлючСтрокиДокумента = СтрКода.КлючСтрокиДокумента;
				ЭтоПерваяСтрока = Ложь;
			КонецЕсли;
			
			Если КлючСтрокиДокумента <> СтрКода.КлючСтрокиДокумента Тогда
				КлючСтрокиДокумента = Неопределено;
			КонецЕсли;
			
			Если Товар <> СтрКода.Товар Тогда
				Товар = Неопределено;
			КонецЕсли;
			
			Если ВидПродукции <> СтрКода.ВидПродукции Тогда
				ВидПродукции = Неопределено;
			КонецЕсли;
			
			Если КлючНоменклатуры1С <> СтрКода.КлючНоменклатуры1С Тогда
				КлючНоменклатуры1С = Неопределено;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Товар)
				И Не ЗначениеЗаполнено(ВидПродукции)
				И Не ЗначениеЗаполнено(КлючНоменклатуры1С)
				И ЗначениеЗаполнено(КлючСтрокиДокумента) Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(Товар) Тогда
			СтрАгрегата.Товар = Товар;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВидПродукции) Тогда
			СтрАгрегата.ВидПродукции = ВидПродукции;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КлючНоменклатуры1С) Тогда
			СтрАгрегата.КлючНоменклатуры1С = КлючНоменклатуры1С;
			ЗаполнитьЗначенияСвойств(СтрАгрегата, КлючНоменклатуры1С);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрАгрегата.ОбщийТипУпаковки) Тогда
			// АТК всегда указывается, значит это транспортная упаковка
			СтрАгрегата.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрАгрегата.КлючСтрокиДокумента) Тогда
			СтрАгрегата.КлючСтрокиДокумента = КлючСтрокиДокумента;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрАгрегата.Товар) Тогда
			СтрАгрегата.ВидПродукции = СтрАгрегата.Товар.ВидПродукции;
			СтрАгрегата.ТипУпаковки = Перечисления.КонтурМаркировка_ТипыУпаковок.МонотоварнаяУпаковка;
		Иначе
			СтрАгрегата.ТипУпаковки = Перечисления.КонтурМаркировка_ТипыУпаковок.МультитоварнаяУпаковка;
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаКодов.Индексы.Удалить(ИндексКодАгрегата);
	ТаблицаКодов.Индексы.Удалить(ИндексКлючАгрегата);
	
КонецПроцедуры

Процедура ТаблицаКодов_УточнитьДанныеАгрегатовПоТоварам(ТаблицаКодов, ТоварыАгрегатов) Экспорт
	
	ТипыУпаковок = Перечисления.КонтурМаркировка_ТипыУпаковок;
	ОбщиеТипыУпаковок = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок;
	
	ИндексТоварыАгрегатов = ТоварыАгрегатов.Индексы.Добавить("КлючКода");
	
	Отбор = Новый Структура("ОбщийТипУпаковки", ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	
	Для каждого СтрАгрегата Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
		
		СтрокиТоваров = ТоварыАгрегатов.НайтиСтроки(Новый Структура("КлючКода", СтрАгрегата.КлючКода));
		Если не ЗначениеЗаполнено(СтрокиТоваров) Тогда
			Продолжить;
		КонецЕсли;
		
		Товар = Неопределено;
		ВидПродукции = Неопределено;
		КлючНоменклатуры1С = Неопределено;
		
		ЭтоПерваяСтрока = Истина;
		
		Для каждого СтрТовара Из СтрокиТоваров Цикл
			
			Если ЭтоПерваяСтрока Тогда
				Товар = СтрТовара.Товар;
				ВидПродукции = СтрТовара.Товар.ВидПродукции;
				КлючНоменклатуры1С = СтрТовара.КлючНоменклатуры1С;
				ЭтоПерваяСтрока = Ложь;
			КонецЕсли;
			
			Если Товар <> СтрТовара.Товар Тогда
				Товар = Неопределено;
			КонецЕсли;
			
			Если ВидПродукции <> СтрТовара.Товар.ВидПродукции Тогда
				ВидПродукции = Неопределено;
			КонецЕсли;
			
			Если КлючНоменклатуры1С <> СтрТовара.КлючНоменклатуры1С Тогда
				КлючНоменклатуры1С = Неопределено;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Товар)
				И Не ЗначениеЗаполнено(ВидПродукции)
				И Не ЗначениеЗаполнено(КлючНоменклатуры1С) Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		СтрАгрегата.Товар = Товар;
		СтрАгрегата.ВидПродукции = ВидПродукции;
		
		Если ЗначениеЗаполнено(КлючНоменклатуры1С) Тогда
			СтрАгрегата.КлючНоменклатуры1С = КлючНоменклатуры1С;
			ЗаполнитьЗначенияСвойств(СтрАгрегата, КлючНоменклатуры1С);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрАгрегата.Товар) Тогда
			СтрАгрегата.GTIN = СтрАгрегата.Товар.GTIN;
			СтрАгрегата.ВидПродукции = СтрАгрегата.Товар.ВидПродукции;
			СтрАгрегата.ТипУпаковки = ТипыУпаковок.МонотоварнаяУпаковка;
		Иначе
			СтрАгрегата.ТипУпаковки = ТипыУпаковок.МультитоварнаяУпаковка;
		КонецЕсли;
		
	КонецЦикла;
	
	ТоварыАгрегатов.Индексы.Удалить(ИндексТоварыАгрегатов);
	
КонецПроцедуры

Процедура ТаблицаКодов_ЗаполнитьХешСуммы(ТаблицаКодов)
	
	СтрокиКодов = Новый Массив;
	Для каждого Стр Из ТаблицаКодов Цикл
		Если ЗначениеЗаполнено(Стр.КодМаркировки)
			И Не ЗначениеЗаполнено(Стр.ХешСуммаКодаМаркировки) Тогда
			СтрокиКодов.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	
	ХешСуммы = ХешСуммыСтрок(МассивСтруктур_Выгрузить(СтрокиКодов, "КодМаркировки"));
	
	Для Сч = 0 По СтрокиКодов.ВГраница() Цикл
		СтрокиКодов[Сч].ХешСуммаКодаМаркировки = ХешСуммы[Сч];
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_ВосстановитьВПолныхКодахРазделителиGS1(ТаблицаКодов)
	
	Пробел = " ";
	Эквивалент = ЭквивалентРазделителяGS1();
	ЭквивалентВРег = ВРег(Эквивалент);
	РазделительGS1 = РазделительGS1();
	
	Для каждого Стр Из ТаблицаКодов Цикл
		Если ЗначениеЗаполнено(Стр.ПолныйКод) Тогда
			Стр.ПолныйКод = СтрЗаменить(Стр.ПолныйКод, Пробел, РазделительGS1);
			Стр.ПолныйКод = СтрЗаменить(Стр.ПолныйКод, Эквивалент, РазделительGS1);
			Стр.ПолныйКод = СтрЗаменить(Стр.ПолныйКод, ЭквивалентВРег, РазделительGS1);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_ВосстановитьРазделителиGS1(ТаблицаКодов) Экспорт
	
	Пробел = " ";
	Эквивалент = ЭквивалентРазделителяGS1();
	Представление = ПредставлениеСимволаGS1();
	ЭквивалентВРег = ВРег(Эквивалент);
	РазделительGS1 = РазделительGS1();
	
	Для каждого Стр Из ТаблицаКодов Цикл
		
		Стр.КодМаркировки = СтрЗаменить(Стр.КодМаркировки, Пробел, РазделительGS1);
		Стр.КодМаркировки = СтрЗаменить(Стр.КодМаркировки, Эквивалент, РазделительGS1);
		Стр.КодМаркировки = СтрЗаменить(Стр.КодМаркировки, ЭквивалентВРег, РазделительGS1);
		Стр.КодМаркировки = СтрЗаменить(Стр.КодМаркировки, Представление, РазделительGS1);
		
		Стр.КодАгрегата = СтрЗаменить(Стр.КодАгрегата, Пробел, РазделительGS1);
		Стр.КодАгрегата = СтрЗаменить(Стр.КодАгрегата, Эквивалент, РазделительGS1);
		Стр.КодАгрегата = СтрЗаменить(Стр.КодАгрегата, ЭквивалентВРег, РазделительGS1);
		Стр.КодАгрегата = СтрЗаменить(Стр.КодАгрегата, Представление, РазделительGS1);
		
		Если ЗначениеЗаполнено(Стр.ПолныйКод) Тогда
			Стр.ПолныйКод = СтрЗаменить(Стр.ПолныйКод, Пробел, РазделительGS1);
			Стр.ПолныйКод = СтрЗаменить(Стр.ПолныйКод, Эквивалент, РазделительGS1);
			Стр.ПолныйКод = СтрЗаменить(Стр.ПолныйКод, ЭквивалентВРег, РазделительGS1);
			Стр.ПолныйКод = СтрЗаменить(Стр.ПолныйКод, Представление, РазделительGS1);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

