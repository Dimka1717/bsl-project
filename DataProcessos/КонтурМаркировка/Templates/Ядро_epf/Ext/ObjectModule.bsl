Процедура ИнформацияОКодах_Прочитать(ТаблицаКодов)
	
	МассивКлючей = ТаблицаЗначений_ВыгрузитьКолонку(ТаблицаКодов, "КлючИнформацииОКоде");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Товар.GTIN КАК GTIN,
	|	ЕСТЬNULL(Т.Товар.ВидПродукции, Т.ВидПродукции) КАК ВидПродукции,
	|	ЕСТЬNULL(Т.Товар.НаименованиеТовара, """") КАК НаименованиеТовара,
	|	Т.КлючНоменклатуры1С.КлючНоменклатуры КАК КлючНоменклатуры,
	|	Т.КлючНоменклатуры1С.КлючХарактеристики КАК КлючХарактеристики,
	|	Т.КлючНоменклатуры1С.КлючУпаковки КАК КлючУпаковки,
	|	Т.КлючНоменклатуры1С.КлючСерии КАК КлючСерии,
	|	Т.*
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК Т
	|ГДЕ
	|	Т.КлючИнформацииОКоде В(&МассивКлючей)");
	Запрос.УстановитьПараметр("МассивКлючей", МассивКлючей);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Индекс = ТаблицаКодов.Индексы.Добавить("КлючИнформацииОКоде");
	
	Отбор = Новый Структура("КлючИнформацииОКоде");
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.КлючНоменклатуры1С) Тогда
			АналитикаНоменклатуры = АналитикаНоменклатуры1С(Выборка.КлючНоменклатуры1С);
		КонецЕсли;
		
		Отбор.КлючИнформацииОКоде = Выборка.КлючИнформацииОКоде;
		Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
			ЗаполнитьЗначенияСвойств(СтрКода, Выборка);
			Если ЗначениеЗаполнено(Выборка.КлючНоменклатуры1С) Тогда
				ЗаполнитьЗначенияСвойств(СтрКода, АналитикаНоменклатуры);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаКодов.Индексы.Удалить(Индекс);
	
КонецПроцедуры

Процедура ИнформацияОКодах_УдалитьУстаревшие()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючИнформацииОКоде КАК КлючИнформацииОКоде
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК Т");
	Выборка = Запрос.Выполнить().Выбрать();
	
	// BSLLS:CreateQueryInCycle-off
	
	Пока Выборка.Следующий() Цикл
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.КлючИнформацииОКоде КАК КлючИнформацииОКоде
		|ИЗ
		|	РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК Т
		|ГДЕ
		|	Т.КлючИнформацииОКоде = &КлючИнформацииОКоде");
		Запрос.УстановитьПараметр("КлючИнформацииОКоде", Выборка.КлючИнформацииОКоде);
		
		Если Запрос.Выполнить().Пустой() Тогда
			НаборЗаписей = РегистрыСведений.КонтурМаркировка_ИнформацияОКодах.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.КлючИнформацииОКоде.Установить(Выборка.КлючИнформацииОКоде);
			НаборЗаписей.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
	// BSLLS:CreateQueryInCycle-on
	
КонецПроцедуры

Функция КлючИнформацииОКоде_Подобрать(КлючевыеРеквизиты, КэшРезультатов = Неопределено)
	
	Если КэшРезультатов <> Неопределено Тогда
		ИменаПолей = ИнформацияОКодах_ИменаПолей();
		Если ЗначениеЗаполнено(КэшРезультатов) Тогда
			Отбор = Новый Структура(ИменаПолей);
			ЗаполнитьЗначенияСвойств(Отбор, КлючевыеРеквизиты);
			НайденныеСтроки = КэшРезультатов.НайтиСтроки(Отбор);
			Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
				Возврат НайденныеСтроки[0].КлючИнформацииОКоде;
			КонецЕсли;
		Иначе
			КэшРезультатов = Новый_ТаблицаКодов();
			КэшРезультатов.Индексы.Добавить(ИменаПолей);
		КонецЕсли;
	КонецЕсли;
	
	Результат = КлючИнформацииОКоде_НайтиСуществующий(КлючевыеРеквизиты);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		КлючИнформацииОКоде_Записать(КлючевыеРеквизиты);
		Результат = КлючИнформацииОКоде_НайтиСуществующий(КлючевыеРеквизиты);
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		СтрКэша = КэшРезультатов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрКэша, КлючевыеРеквизиты);
		СтрКэша.КлючИнформацииОКоде = Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КлючИнформацииОКоде_НайтиСуществующий(КлючевыеРеквизиты)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.КлючИнформацииОКоде КАК КлючИнформацииОКоде
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК Т
	|ГДЕ
	|	&Условия");
	
	Условия = "";
	Разделитель = "";
	Для каждого ИмяПоля Из РазделитьСтроку(ИнформацияОКодах_ИменаПолей()) Цикл
		Запрос.УстановитьПараметр(ИмяПоля, КлючевыеРеквизиты[ИмяПоля]);
		Условия = Условия + Разделитель + ПараметрыВСтроку("Т.%1 = &%1", ИмяПоля);
		Разделитель = " И ";
	КонецЦикла;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условия", Условия);
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "КлючИнформацииОКоде");
	
КонецФункции

Процедура КлючИнформацииОКоде_Записать(КлючевыеРеквизиты)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ИнформацияОКодах_Заблокировать(КлючевыеРеквизиты);
		
		НаборЗаписей = РегистрыСведений.КонтурМаркировка_ИнформацияОКодах.СоздатьНаборЗаписей();
		Для каждого ИмяПоля Из РазделитьСтроку(ИнформацияОКодах_ИменаПолей()) Цикл
			НаборЗаписей.Отбор[ИмяПоля].Установить(КлючевыеРеквизиты[ИмяПоля]);
		КонецЦикла;
		
		ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), КлючевыеРеквизиты);
		
		НаборЗаписей.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ИнформацияОКодах_Заблокировать(КлючевыеРеквизиты)
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КонтурМаркировка_ИнформацияОКодах");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Для каждого ИмяПоля Из РазделитьСтроку(ИнформацияОКодах_ИменаПолей()) Цикл
		ЭлементБлокировки.УстановитьЗначение(ИмяПоля, КлючевыеРеквизиты[ИмяПоля]);
	КонецЦикла;
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

Функция ИнформацияОКодах_ИменаПолей() Экспорт
	
	КлючКэш = "ИнформацияОКодах_ИменаПолей";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВсеПоля = Новый Массив;
	Для каждого Измерение Из Метаданные.РегистрыСведений.КонтурМаркировка_ИнформацияОКодах.Измерения Цикл
		Если Измерение.Имя <> "КлючИнформацииОКоде" Тогда
			ВсеПоля.Добавить(Измерение.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Результат = СоединитьСтроку(ВсеПоля, ",");
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти

// #Область СвязиКлючейКодов

Процедура СвязиКлючейКодов_Записать(ТаблицаКодов)
	
	Если ЗначениеЗаполнено(ТаблицаКодов)
		И ТаблицаКодов.Количество() <= НебольшоеКоличествоЗаписейРегистра() Тогда
		СвязиКлючейКодов_ЗаписатьЧерезМенеджерЗаписи(ТаблицаКодов);
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		СвязиКлючейКодов_ЗаблокироватьПоТаблице(ТаблицаКодов);
		
		УстаревшиеКоды = Новый Массив;
		
		Для Каждого ЧастьТаблицы Из ТаблицаЗначений_Разбить(ТаблицаКодов, "ПорцияЗаписей") Цикл
			
			Набор = РегистрыСведений.КонтурМаркировка_СвязиКлючейКодов.СоздатьНаборЗаписей();
			Набор.Отбор.ПорцияЗаписей.Установить(ЧастьТаблицы.ПорцияЗаписей);
			Набор.Прочитать();
			
			ТаблицаНабора = Набор.Выгрузить();
			ТаблицаНабора.Индексы.Добавить("КлючКода");
			
			ЕстьИзменения = Ложь;
			
			Для Каждого СтрКода Из ЧастьТаблицы.МассивСтрок Цикл
				
				СтрНабора = ТаблицаНабора.Найти(СтрКода.КлючКода, "КлючКода");
				
				Если СтрНабора = Неопределено Тогда
					СтрНабора = ТаблицаНабора.Добавить();
					СтрНабора.КлючКода = СтрКода.КлючКода;
					СтрНабора.ПорцияЗаписей = СтрКода.ПорцияЗаписей;
					ЕстьИзменения = Истина;
				КонецЕсли;
				
				Если СтрНабора.КлючАгрегата <> СтрКода.КлючАгрегата Тогда
					ЕстьИзменения = Истина;
					СтрНабора.КлючАгрегата = СтрКода.КлючАгрегата;
					Если Не ЗначениеЗаполнено(СтрКода.КлючАгрегата) Тогда
						УстаревшиеКоды.Добавить(СтрКода.КлючКода);
					КонецЕсли;
				КонецЕсли;
				
				Если СтрНабора.КлючСтатусаКода <> СтрКода.КлючСтатусаКода Тогда
					СтрНабора.КлючСтатусаКода = СтрКода.КлючСтатусаКода;
					ЕстьИзменения = Истина;
				КонецЕсли;
				
				Если СтрНабора.КлючИнформацииОКоде <> СтрКода.КлючИнформацииОКоде Тогда
					СтрНабора.КлючИнформацииОКоде = СтрКода.КлючИнформацииОКоде;
					ЕстьИзменения = Истина;
				КонецЕсли;
				
			КонецЦикла;
			
			Если ЕстьИзменения Тогда
				Набор.Загрузить(ТаблицаНабора);
				Набор.Записать();
			КонецЕсли;
			
		КонецЦикла;
		
		КодыДокументов_ОбновитьКоличествоКодовПоТаблицеКодов(ТаблицаКодов);
		КодыОпераций_ОбновитьКоличествоКодовПоТаблицеКодов(ТаблицаКодов);
		УстаревшиеКоды_Записать(УстаревшиеКоды);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура СвязиКлючейКодов_ЗаписатьЧерезМенеджерЗаписи(ТаблицаКодов)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		СвязиКлючейКодов_ЗаблокироватьПоТаблице(ТаблицаКодов);
		
		УстаревшиеКоды = Новый Массив;
		
		Для Каждого СтрКода Из ТаблицаКодов Цикл
			
			Запись = РегистрыСведений.КонтурМаркировка_СвязиКлючейКодов.СоздатьМенеджерЗаписи();
			Запись.ПорцияЗаписей = СтрКода.ПорцияЗаписей;
			Запись.КлючКода = СтрКода.КлючКода;
			Запись.Прочитать();
			
			ЕстьИзменения = Ложь;
			
			Если Запись.КлючКода <> СтрКода.КлючКода Тогда
				Запись.КлючКода = СтрКода.КлючКода;
				ЕстьИзменения = Истина;
			КонецЕсли;
			
			Если Запись.ПорцияЗаписей <> СтрКода.ПорцияЗаписей Тогда
				Запись.ПорцияЗаписей = СтрКода.ПорцияЗаписей;
				ЕстьИзменения = Истина;
			КонецЕсли;
			
			Если Запись.КлючАгрегата <> СтрКода.КлючАгрегата Тогда
				ЕстьИзменения = Истина;
				Запись.КлючАгрегата = СтрКода.КлючАгрегата;
				Если Не ЗначениеЗаполнено(СтрКода.КлючАгрегата) Тогда
					УстаревшиеКоды.Добавить(СтрКода.КлючКода);
				КонецЕсли;
			КонецЕсли;
			
			Если Запись.КлючСтатусаКода <> СтрКода.КлючСтатусаКода Тогда
				Запись.КлючСтатусаКода = СтрКода.КлючСтатусаКода;
				ЕстьИзменения = Истина;
			КонецЕсли;
			
			Если Запись.КлючИнформацииОКоде <> СтрКода.КлючИнформацииОКоде Тогда
				Запись.КлючИнформацииОКоде = СтрКода.КлючИнформацииОКоде;
				ЕстьИзменения = Истина;
			КонецЕсли;
			
			Если ЕстьИзменения Тогда
				Запись.Записать();
			КонецЕсли;
			
		КонецЦикла;
		
		КодыДокументов_ОбновитьКоличествоКодовПоТаблицеКодов(ТаблицаКодов);
		КодыОпераций_ОбновитьКоличествоКодовПоТаблицеКодов(ТаблицаКодов);
		УстаревшиеКоды_Записать(УстаревшиеКоды);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура СвязиКлючейКодов_Прочитать(ТаблицаКодов)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.*
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК Т
	|ГДЕ
	|	Т.КлючКода В(&КлючиКодов)");
	Запрос.УстановитьПараметр("КлючиКодов", ТаблицаКодов.ВыгрузитьКолонку("КлючКода"));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Индекс = ТаблицаКодов.Индексы.Добавить("КлючКода");
	Пока Выборка.Следующий() Цикл
		СтрКода = ТаблицаКодов.Найти(Выборка.КлючКода, "КлючКода");
		ЗаполнитьЗначенияСвойств(СтрКода, Выборка);
	КонецЦикла;
	ТаблицаКодов.Индексы.Удалить(Индекс);
	
КонецПроцедуры

Процедура СвязиКлючейКодов_ВТ_Прочитать(МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТаблицаКодов.*,
	|	СвязиКлючейКодов.*
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО ТаблицаКодов.КлючКода = СвязиКлючейКодов.КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаКодов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.*
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	Результат КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Т.КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Результат");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Выборка = Запрос.Выполнить();
	
КонецПроцедуры

Процедура СвязиКлючейКодов_ВТ_ПрочитатьКлючиАгрегатов(МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТаблицаКодов.*,
	|	ЕСТЬNULL(КодыАгрегатов.КлючКода, &ПустойКлюч) КАК КлючАгрегата
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО ТаблицаКодов.КлючКода = СвязиКлючейКодов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыАгрегатов
	|		ПО (СвязиКлючейКодов.КлючАгрегата = КодыАгрегатов.КлючКода)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаКодов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.*
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	Результат КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Т.КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Результат");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ПустойКлюч", ПустойУникальныйИдентификатор());
	Выборка = Запрос.Выполнить()
	
КонецПроцедуры

Процедура СвязиКлючейКодов_ЗаблокироватьПоТаблице(Таблица, ИмяКолонки = "ПорцияЗаписей")
	
	Поле = "ПорцияЗаписей";
	Объект = "РегистрСведений.КонтурМаркировка_СвязиКлючейКодов";
	ЗаблокироватьПоТаблице(Объект, Поле, Таблица, ИмяКолонки);
	
КонецПроцедуры

