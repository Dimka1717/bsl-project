Функция Контент_ВыводИзОборота_ПоэкземплярныйУчет(ОписаниеОперации)
	
	ВидыДокументов = Перечисление_ВидыПервичныхДокументов();
	ПричиныВывода = Перечисление_ПричиныВыводаИзОборота();
	
	Операция = ОписаниеОперации.Ссылка;
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ПричинаВыводаИзОборота = ДопРеквизиты.ПричинаВыводаИзОборота;
	ВидПервичногоДокумента = ДопРеквизиты.ВидПервичногоДокумента;
	Площадка = ДопРеквизиты.Площадка;
	
	Результат = Новый Структура;
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ОписаниеОперации.ВидПродукции));
	Результат.Вставить("actionType", ПричинаВыводаИзОборотаВСервисе(ПричинаВыводаИзОборота));
	
	Если ПричинаВыводаИзОборота <> ПричиныВывода.ЭкспортЕАЭС
		И ПричинаВыводаИзОборота <> ПричиныВывода.ПродажаПоГосКонтракту Тогда
		ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "documentDate", ДопРеквизиты.ДатаДокумента);
		ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "documentNumber", ДопРеквизиты.НомерДокумента);
		Если ЗначениеЗаполнено(ВидПервичногоДокумента) Тогда
			Результат.Вставить("documentType", ТипПервичногоДокументаВСервисе(ВидПервичногоДокумента));
		КонецЕсли;
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.БезвозмезднаяПередача Тогда
		Результат.Вставить("buyerInn", ДопРеквизиты.ИННПолучателя);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.ДляСобственныхНужд
		Или ПричинаВыводаИзОборота = ПричиныВывода.ДляПроизводственныхЦелей Тогда
		Если ЗначениеЗаполнено(ДопРеквизиты.ИННПолучателя) Тогда
			Результат.Вставить("buyerInn", ДопРеквизиты.ИННПолучателя);
		КонецЕсли;
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.ЭкспортЕАЭС Тогда
		Результат.Вставить("ImporterId", ДопРеквизиты.ИННПолучателя);
		Результат.Вставить("DestinationCountryCode", ДопРеквизиты.КодСтраныПолучателя);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.ПродажаПоГосКонтракту
			Или ПричинаВыводаИзОборота = ПричиныВывода.ПродажаПоСделкеСГосударственнойТайной Тогда
		Результат.Вставить("stateContractId", ДопРеквизиты.ИдентификаторГосКонтракта);
	КонецЕсли;
	
	Если ВидПервичногоДокумента = ВидыДокументов.Прочее Тогда
		Результат.Вставить("customDocumentName", ДопРеквизиты.НаименованиеПервичногоДокумента);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.Прочее Тогда
		Результат.Вставить("customActionName", ДопРеквизиты.НаименованиеПричиныВыводаИзОборота);
	КонецЕсли;
	
	МожноУказатьЦену = Операция_ВыводИзОборота_МожноУказатьЦену(ПричинаВыводаИзОборота);
	
	Если ЗначениеЗаполнено(Площадка) Тогда
		
		modInfo = Новый Структура;
		
		ДобавитьЗаполненноеЗначениеВСтруктуру(modInfo, "fiasId", Площадка.ИдентификаторФИАС);
		ДобавитьЗаполненноеЗначениеВСтруктуру(modInfo, "kpp", Площадка.КПП);
		
		Результат.Вставить("modInfo", modInfo);
		
	КонецЕсли;
	
	products = Новый Массив;
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		
		product = Новый Структура;
		product.Вставить("name", НаименованиеПозицииДляКонтента(Стр));
		product.Вставить("kiCodes", КодыОпераций_КодыМаркировки(Операция, Стр.КлючСтрокиОперации, Ложь));
		
		Если МожноУказатьЦену И ЗначениеЗаполнено(Стр.Цена) Тогда
			ЦенаВКопейках = РублиВКопейки(Стр.Цена);
			product.Вставить("cost", ЦенаВКопейках);
		КонецЕсли;
		
		products.Добавить(product);
		
	КонецЦикла;
	
	Результат.Вставить("products", products);
	
	Возврат Результат;
	
КонецФункции

