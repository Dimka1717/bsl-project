// Определяет общий тип упаковки в терминах 1С по типу кода маркировки
//
// Параметры:
//  ТипКодаМаркировки - ПеречислениеСсылка.КонтурМаркировка_ТипыКодовМаркировки - тип кода маркировки;
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.КонтурМаркировка_ОбщиеТипыУпаковок
//
Функция ОбщийТипУпаковкиПоТипуКодаМаркировки(ТипКодаМаркировки) Экспорт
	
	Если Не ЗначениеЗаполнено(ТипКодаМаркировки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КлючКэш = "ОбщийТипУпаковкиПоТипуКодаМаркировки: " + ТипКодаМаркировки;
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОбщиеТипыУпаковок = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок;
	ТипыКодовМаркировки = Перечисления.КонтурМаркировка_ТипыКодовМаркировки;
	
	СоответствиеТипов = Новый Соответствие;
	СоответствиеТипов.Вставить(ТипыКодовМаркировки.ЕдиницаТовара, ОбщиеТипыУпаковок.ЕдиницаТовара);
	СоответствиеТипов.Вставить(ТипыКодовМаркировки.ГрупповаяУпаковка, ОбщиеТипыУпаковок.ГрупповаяУпаковка);
	СоответствиеТипов.Вставить(ТипыКодовМаркировки.Комплект, ОбщиеТипыУпаковок.Комплект);
	СоответствиеТипов.Вставить(ТипыКодовМаркировки.Набор, ОбщиеТипыУпаковок.Набор);
	
	Результат = СоответствиеТипов[ТипКодаМаркировки];
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		ТекстОшибки = НСтр("ru = 'Неизвестный тип кода маркировки: %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ТипКодаМаркировки);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

