Процедура ТаблицаКодов_ЗаполнитьКлючиКодов(ТаблицаКодов) Экспорт
	
	ТаблицаКодов_ЗаполнитьХешСуммы(ТаблицаКодов);
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	КолонкиКода = "КодМаркировки, ХешСуммаКодаМаркировки";
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов.Скопировать(, КолонкиКода), "ТабКодов", КолонкиКода);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТабКодов.КодМаркировки КАК КодМаркировки,
	|	КодыМаркировки.КлючКода КАК КлючКода
	|ИЗ
	|	ТабКодов КАК ТабКодов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ТабКодов.КодМаркировки = КодыМаркировки.КодМаркировки
	|			И ТабКодов.ХешСуммаКодаМаркировки = КодыМаркировки.ХешСуммаКодаМаркировки");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Индекс = ТаблицаКодов.Индексы.Добавить("КодМаркировки");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТаблицаКодов.Найти(Выборка.КодМаркировки, "КодМаркировки").КлючКода = Выборка.КлючКода;
	КонецЦикла;
	
	ТаблицаКодов.Индексы.Удалить(Индекс);
	
КонецПроцедуры

Процедура ТаблицаКодов_ДобавитьКлючиВсехВложенныхКодов(ТаблицаКодов) Экспорт
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов.Скопировать(, "КлючКода"), "ТаблицаКодов", "КлючКода");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода
	|ПОМЕСТИТЬ Таб1
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	Т.КлючКода <> &ПустойКлюч
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 0
	|	Т.КлючКода КАК КлючКода,
	|	Т.КлючКода КАК КлючАгрегата
	|ПОМЕСТИТЬ Итог1
	|ИЗ
	|	Таб1 КАК Т");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ПустойКлюч", ПустойУникальныйИдентификатор());
	Запрос.Выполнить();
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СвязиКлючейКодов.КлючКода КАК КлючКода,
	|	СвязиКлючейКодов.КлючАгрегата КАК КлючАгрегата
	|ПОМЕСТИТЬ Таб2
	|ИЗ
	|	Таб1 КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО Таб.КлючКода = СвязиКлючейКодов.КлючАгрегата
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаКодов КАК ТаблицаКодов
	|		ПО (СвязиКлючейКодов.КлючКода = ТаблицаКодов.КлючКода)
	|ГДЕ
	|	ТаблицаКодов.КлючКода ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.КлючАгрегата КАК КлючАгрегата
	|ПОМЕСТИТЬ Итог2
	|ИЗ
	|	Итог1 КАК Т
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Т.КлючКода,
	|	Т.КлючАгрегата
	|ИЗ
	|	Таб2 КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Таб1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Итог1";
	
	Пока Истина Цикл
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
		Выборка = Запрос.ВыполнитьПакет().Получить(0).Выбрать();
		Выборка.Следующий();
		Если Выборка.Количество = 0 Тогда
			Прервать;
		КонецЕсли;
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Таб1", "Таб2");
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Итог1", "Итог2");
	КонецЦикла;
	
	Если Найти(ТекстЗапроса, "ПОМЕСТИТЬ Итог1") > 0 Тогда
		ТекстЗапроса = "ВЫБРАТЬ * ИЗ Итог1";
	Иначе
		ТекстЗапроса = "ВЫБРАТЬ * ИЗ Итог2";
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Выборка = Запрос.Выполнить().Выбрать();
	МенеджерВТ.Закрыть();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаКодов.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_ПодобратьКонтрагентов(ТаблицаКодов)
	
	КэшКонтрагентов = Новый Соответствие;
	ПустойКонтрагент = Справочники.КонтурМаркировка_Контрагенты.ПустаяСсылка();
	ТаблицаКодов.ЗаполнитьЗначения(ПустойКонтрагент, "Владелец, Производитель");
	
	Для каждого Стр Из ТаблицаКодов Цикл
		
		Если Не ЗначениеЗаполнено(Стр.Владелец)
			И ЗначениеЗаполнено(Стр.ВладелецИНН) Тогда
			Контрагент = Контрагент_Подобрать(Стр.ВладелецИНН, , Стр.ВладелецНаименование, КэшКонтрагентов);
			Отбор = Новый Структура("Владелец, ВладелецИНН", ПустойКонтрагент, Стр.ВладелецИНН);
			Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
				СтрКода.Владелец = Контрагент;
			КонецЦикла;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.Производитель)
			И ЗначениеЗаполнено(Стр.ПроизводительИНН) Тогда
			Контрагент = Контрагент_Подобрать(Стр.ПроизводительИНН, , Стр.ПроизводительНаименование, КэшКонтрагентов);
			Отбор = Новый Структура("Производитель, ПроизводительИНН", ПустойКонтрагент, Стр.ПроизводительИНН);
			Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
				СтрКода.Производитель = Контрагент;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_ПодобратьКлючиНоменклатуры1С(ТаблицаКодов) Экспорт
	
	Отбор = Новый_АналитикаНоменклатуры1С();
	
	ТаблицаКодов.Колонки.Добавить("Обработан", Новый ОписаниеТипов("Булево"));
	
	Для каждого Стр Из ТаблицаКодов Цикл
		
		Если Стр.Обработан Тогда
			Продолжить;
		КонецЕсли;
		
		КлючНоменклатуры1С = КлючНоменклатуры1С_Подобрать(Стр);
		
		ЗаполнитьЗначенияСвойств(Отбор, Стр);
		Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
			Если Не ЗначениеЗаполнено(СтрКода.КлючНоменклатуры1С) Тогда
				СтрКода.КлючНоменклатуры1С = КлючНоменклатуры1С;
			КонецЕсли;
			СтрКода.Обработан = Истина;
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаКодов.Колонки.Удалить("Обработан");
	
КонецПроцедуры

Процедура ТаблицаКодов_ПодобратьКлючиИнформацииОКодах(ТаблицаКодов)
	
	ПолеКлюча = "КлючИнформацииОКоде";
	ПустойКлюч = ПустойУникальныйИдентификатор();
	
	Отбор = Новый Структура(ИнформацияОКодах_ИменаПолей());
	Отбор.Вставить(ПолеКлюча, ПустойКлюч);
	
	ТаблицаКодов.ЗаполнитьЗначения(ПустойКлюч, ПолеКлюча);
	
	Пока Истина Цикл
		
		Стр = ТаблицаКодов.Найти(ПустойКлюч, ПолеКлюча);
		Если Стр = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		КлючИнформацииОКоде = КлючИнформацииОКоде_Подобрать(Стр);
		
		ЗаполнитьЗначенияСвойств(Отбор, Стр, , ПолеКлюча);
		Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
			СтрКода.КлючИнформацииОКоде = КлючИнформацииОКоде;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_ПодобратьКлючиСтатусов(ТаблицаКодов)
	
	ПолеКлюча = "КлючСтатусаКода";
	ПустойКлюч = ПустойУникальныйИдентификатор();
	
