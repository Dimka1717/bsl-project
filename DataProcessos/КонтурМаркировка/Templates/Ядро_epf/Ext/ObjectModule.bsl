// Записывает в журнал регистрации информацию об ошибке во время обработки события ленты
//
// Параметры:
//  ИнформацияОбОшибке - ИнформацияОбОшибке - информация об ошибке
//  СобытиеЛенты - Структура - см ApiEvent https://marking-api.testkontur.ru/api/swagger/index.html
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация
//  ПоказыватьСообщение - Булево - Истина, если нужно показать сообщение пользователю. По умолчанию Истина
//
Процедура Лента_ОбработатьОшибку_ОбработкаСобытия(ИнформацияОбОшибке, СобытиеЛенты, Организация, ПоказыватьСообщение = Истина)
	
	Действие = НСтр("ru = 'Лента событий. Обработка события'");
	
	ДопИнформация = Новый Структура;
	ДопИнформация.Вставить("Организация", Организация);
	ДопИнформация.Вставить("eventId", СобытиеЛенты.eventId);
	ДопИнформация.Вставить("eventType", СобытиеЛенты.eventType);
	
	ТипыСобытий = Перечисление_ТипыСобытийЛенты();
	Если СобытиеЛенты.eventType = ТипыСобытий.ИзменениеСтатусаДокумента Тогда
		
		ДопИнформация.Вставить("documentId", СвойствоСтруктуры(СобытиеЛенты.data, "documentId", ""));
		ДопИнформация.Вставить("newStatus", СвойствоСтруктуры(СобытиеЛенты.data, "newStatus", ""));
		ДопИнформация.Вставить("oldStatus", СвойствоСтруктуры(СобытиеЛенты.data, "oldStatus", ""));
		ДопИнформация.Вставить("warehouseId", СвойствоСтруктуры(СобытиеЛенты.data, "warehouseId", ""));
		ДопИнформация.Вставить("workflowType", СвойствоСтруктуры(СобытиеЛенты.data, "workflowType", ""));
		
	КонецЕсли;
	
	ТекстСообщения = "";
	Если ПоказыватьСообщение Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось обработать событие ленты'");
	КонецЕсли;
	
	ОбработатьОшибку(Действие, ИнформацияОбОшибке, ДопИнформация, ТекстСообщения);
	
КонецПроцедуры

