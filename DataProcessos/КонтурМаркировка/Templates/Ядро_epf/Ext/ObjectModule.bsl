// #Область Склады

Процедура СинхронизироватьСклады(Организация) Экспорт
	
	Попытка
		Ответ = Маркировка_СписокСкладов(Организация);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Синхронизация складов'");
		ШаблонСообщения = НСтр("ru = 'Не удалось синхронизировать склады по организации: %1'");
		ТекстСообщения = ПараметрыВСтроку(ШаблонСообщения, Организация);
		ОбработатьОшибку(Действие, Ошибка, Организация, ТекстСообщения);
		Возврат;
	КонецПопытки;
	
	Для Каждого warehouse Из Ответ Цикл
		
		id = СвойствоСтруктуры(warehouse, "id");
		Склад = Склад_НайтиПоИдентификатору(id);
		
		Если ЗначениеЗаполнено(Склад) Тогда
			ОписаниеСклада = Склад_Прочитать(Склад);
		Иначе
			ОписаниеСклада = Новый_Склад();
			ОписаниеСклада.Идентификатор = id;
		КонецЕсли;
		
		ОписаниеСклада.Наименование = СвойствоСтруктуры(warehouse, "name");
		ОписаниеСклада.Адрес = СвойствоСтруктуры(warehouse, "address");
		ОписаниеСклада.GLN = СвойствоСтруктуры(warehouse, "GLN");
		ОписаниеСклада.Организация = Организация;
		Склад_Записать(ОписаниеСклада);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Склад_Записать(ОписаниеСклада) Экспорт
	
	Если ЗначениеЗаполнено(ОписаниеСклада.Ссылка) Тогда
		Если ОбъектВПроцессеОбновления(ОписаниеСклада.Ссылка) Тогда
			ВызватьИсключение_ОбъектВПроцессеОбновления(ОписаниеСклада.Ссылка);
		КонецЕсли;
		СкладОбъект = ОписаниеСклада.Ссылка.ПолучитьОбъект();
	Иначе
		СкладОбъект = Справочники.КонтурМаркировка_Склады.СоздатьЭлемент();
	КонецЕсли;
	
	ОписаниеСклада.КлючСклада1С = КлючОбъекта1С(ОписаниеСклада.Склад1С);
	ОписаниеСклада.ТипКлючаСклада1С = ТипКлючаОбъекта1С(ОписаниеСклада.Склад1С);
	
	ЗаполнитьЗначенияСвойств(СкладОбъект, ОписаниеСклада, , "Ссылка");
	
	СкладОбъект.ОбменДанными.Загрузка = Истина;
	СкладОбъект.Записать();
	
	ОписаниеСклада.Ссылка = СкладОбъект.Ссылка;
	
КонецПроцедуры

Функция Склад_Прочитать(Склад) Экспорт
	
	Результат = Новый_Склад();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.*
	|ИЗ
	|	Справочник.КонтурМаркировка_Склады КАК Т
	|ГДЕ
	|	Т.Ссылка = &Склад");
	Запрос.УстановитьПараметр("Склад", Склад);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.КлючСклада1С) Тогда
		Результат.Склад1С = МодульОбщегоНазначения().СсылкаПоИдентификатору(
		Результат.КлючСклада1С, Результат.ТипКлючаСклада1С);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_Склад() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ссылка");
	Результат.Вставить("Наименование");
	Результат.Вставить("Организация");
	Результат.Вставить("GLN");
	Результат.Вставить("Идентификатор");
	Результат.Вставить("Склад1С");
	Результат.Вставить("КлючСклада1С");
	Результат.Вставить("ТипКлючаСклада1С");
	Результат.Вставить("Адрес");
	Результат.Вставить("Площадка");
	Результат.Вставить("Комментарий");
	
	Возврат Результат;
	
КонецФункции

Функция Склад_НайтиПоИдентификатору(Идентификатор) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Склады КАК Т
	|ГДЕ
	|	Т.Идентификатор = &Идентификатор");
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	Результат = ПолучитьРезультатЗапроса(Запрос);
	
	Возврат Результат;
	
КонецФункции

// Возвращает склад, если он единственный у организации
//
// Параметры:
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Склады - основной склад
//
Функция Склад_ОсновнойСклад(Организация) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Склады КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|	И Т.Организация = &Организация");
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		Результат = Выборка.Ссылка;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

