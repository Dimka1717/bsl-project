	КонецЕсли;
	
	Результат = ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор;
	ЭтоАнонимныйПользователь = (Строка(Результат) = "071523a4-516f-4fce-ba4b-0d11ab7a1893");
	
	Если ЭтоАнонимныйПользователь Тогда
		Результат = ИдентификаторПользователяОС();
	КонецЕсли;
	
