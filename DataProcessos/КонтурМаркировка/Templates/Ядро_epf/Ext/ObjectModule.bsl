Функция НаименованиеХарактеристики(Характеристика) Экспорт
	
	Если Не ЗначениеЗаполнено(Характеристика) Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяСправочника = Характеристика.Метаданные().ПолноеИмя();
	
	Если ЕстьМетаданные(ИмяСправочника + ".Реквизиты.НаименованиеПолное") Тогда
		НаименованиеПолное = ЗначениеРеквизитаОбъекта_Марк(Характеристика, "НаименованиеПолное");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НаименованиеПолное) Тогда
		Результат = СокрЛП(НаименованиеПолное);
	Иначе
		Результат = СокрЛП(Характеристика);
	КонецЕсли;
	
	Возврат Результат;
	
