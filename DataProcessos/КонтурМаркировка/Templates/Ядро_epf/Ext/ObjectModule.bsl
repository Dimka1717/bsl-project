Процедура ПоместитьТаблицуВЗапрос(МенеджерВТ, Таблица, ИмяТаблицы, ПоляИндекса = "") Экспорт
	
	Если ВерсияПлатформыНиже("8.3.12.1412") Тогда
		ПоместитьТаблицуВЗапросЧерезНабор(МенеджерВТ, Таблица, ИмяТаблицы, ПоляИндекса);
	Иначе
		ПоместитьТаблицуВЗапросЧерезМенеджер(МенеджерВТ, Таблица, ИмяТаблицы, ПоляИндекса);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПоместитьТаблицуВЗапросЧерезНабор(МенеджерВТ, Таблица, ИмяТаблицы, ПоляИндекса = "")
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.*
	|ПОМЕСТИТЬ ТаблицаЗначений
	|ИЗ
	|	&ТаблицаЗначений КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Т.ИндексСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаЗначений.*,
	|	ТаблицаКлючей.Ключ1 КАК Ключ1,
	|	ТаблицаКлючей.Ключ2 КАК Ключ2,
	|	ТаблицаКлючей.Ключ3 КАК Ключ3,
	|	ТаблицаКлючей.Ключ4 КАК Ключ4,
	|	ТаблицаКлючей.Ключ5 КАК Ключ5
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	ТаблицаЗначений КАК ТаблицаЗначений
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ТаблицаКлючей КАК ТаблицаКлючей
	|		ПО ТаблицаЗначений.ИндексСтроки = ТаблицаКлючей.ИндексСтроки
	|			И (ТаблицаКлючей.ПорцияЗаписей = &ПорцияЗаписей)
	|
	|КолонкиИндекса
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаЗначений";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ Результат", "ПОМЕСТИТЬ " + ИмяТаблицы);
	
	ТипИдентификатор = Тип("УникальныйИдентификатор");
	МассивПолейИндекса = РазделитьСтроку(ПоляИндекса);
	МассивКолонокКлючей = Новый Массив;
	МассивКолонокИндекса = Новый Массив;
	МассивКолонокЗначений = Новый Массив;
	МаксКолонокСКлючами = 5;
	
	Сч = 1;
	Для каждого Колонка Из Таблица.Колонки Цикл
		Если Колонка.ТипЗначения.СодержитТип(ТипИдентификатор) Тогда
			Если Сч = МаксКолонокСКлючами Тогда
				ВызватьИсключение НСтр("ru = 'В таблице достигнуто максимальное количество колонок с ключами'");
			КонецЕсли;
			Если МассивПолейИндекса.Найти(Колонка.Имя) <> Неопределено Тогда
				МассивКолонокИндекса.Добавить(Колонка.Имя);
			КонецЕсли;
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КАК Ключ" + Сч, "КАК " + Колонка.Имя);
			МассивКолонокКлючей.Добавить(Колонка.Имя);
			Сч = Сч + 1;
		Иначе
			Если МассивПолейИндекса.Найти(Колонка.Имя) <> Неопределено Тогда
				МассивКолонокИндекса.Добавить("ТаблицаЗначений." + Колонка.Имя);
			КонецЕсли;
			МассивКолонокЗначений.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	КолонкиКлючей = СоединитьСтроку(МассивКолонокКлючей, ",");
	КолонкиИндекса = СоединитьСтроку(МассивКолонокИндекса, ",");
	КолонкиЗначений = СоединитьСтроку(МассивКолонокЗначений, ",");
	
	Если Не ЗначениеЗаполнено(КолонкиКлючей) Тогда
		ПоместитьТаблицуВЗапросЧерезМенеджер(МенеджерВТ, Таблица, ИмяТаблицы, ПоляИндекса);
		Возврат;
	КонецЕсли;
	
	ТаблицаЗначений_ДобавитьИндексСтроки(Таблица);
	
	ТаблицаКлючей = Таблица.Скопировать(, "ИндексСтроки," + КолонкиКлючей);
	Для Сч = 1 По МассивКолонокКлючей.Количество() Цикл
		ТаблицаКлючей.Колонки.Найти(МассивКолонокКлючей[Сч - 1]).Имя = "Ключ" + Сч;
	КонецЦикла;
	
	ПорцияЗаписей = МодульОбщегоНазначения().НовыйУникальныйИдентификаторПервойВерсии();
	ТаблицаКлючей.Колонки.Добавить("ПорцияЗаписей", Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаКлючей.ЗаполнитьЗначения(ПорцияЗаписей, "ПорцияЗаписей");
	
	Набор = РегистрыСведений.КонтурМаркировка_ТаблицаКлючей.СоздатьНаборЗаписей();
	Набор.Отбор.ПорцияЗаписей.Установить(ПорцияЗаписей);
	Набор.Загрузить(ТаблицаКлючей);
	Набор.ОбменДанными.Загрузка = Истина;
	
	Если ЗначениеЗаполнено(КолонкиИндекса) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КолонкиИндекса", "ИНДЕКСИРОВАТЬ ПО " + КолонкиИндекса);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КолонкиИндекса", "");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ПорцияЗаписей", ПорцияЗаписей);
	Запрос.УстановитьПараметр("ТаблицаЗначений", Таблица.Скопировать(, "ИндексСтроки," + КолонкиЗначений));
	
	Таблица.Колонки.Удалить("ИндексСтроки");
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		Набор.Записать();
		Запрос.Выполнить();
		Набор.Очистить();
		Набор.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ПоместитьТаблицуВЗапросЧерезМенеджер(МенеджерВТ, Таблица, ИмяТаблицы, ПоляИндекса = "")
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.*
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	&Таблица КАК Т
	|
	|КолонкиИндекса";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ Результат", "ПОМЕСТИТЬ " + ИмяТаблицы);
	
	МассивПолейИндекса = РазделитьСтроку(ПоляИндекса);
	МассивКолонокИндекса = Новый Массив;
	
	Для каждого Колонка Из Таблица.Колонки Цикл
		Если МассивПолейИндекса.Найти(Колонка.Имя) <> Неопределено Тогда
			МассивКолонокИндекса.Добавить("Т." + Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	КолонкиИндекса = СоединитьСтроку(МассивКолонокИндекса, ",");
	
	Если ЗначениеЗаполнено(КолонкиИндекса) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КолонкиИндекса", "ИНДЕКСИРОВАТЬ ПО " + КолонкиИндекса);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КолонкиИндекса", "");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("Таблица", Таблица);
	Запрос.Выполнить();
	
КонецПроцедуры

