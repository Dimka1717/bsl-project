// Читает из базы все статусы операции
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция, по которой нужно прочитать статусы
// 
// Возвращаемое значение:
//  Структура - содержит:
//   * Ключ - Строка - тип статуса
//   * Значение - Строка - статус, см. Перечисление_СтатусыОпераций()
//
Функция СтатусыОперации_Прочитать(Операция)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.ТипСтатуса КАК ТипСтатуса,
	|	Т.Статус КАК Статус,
	|	Т.ДатаСтатуса КАК ДатаСтатуса
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК Т
	|ГДЕ
	|	Т.Операция = &Операция");
	
	Запрос.УстановитьПараметр("Операция", Операция);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Структура;
	
	Пока Выборка.Следующий() Цикл
		
		ТипСтатуса	 = Выборка.ТипСтатуса;
		Статус		 = Выборка.Статус;
		ДатаСтатуса	 = Выборка.ДатаСтатуса;
		
		Результат.Вставить(ТипСтатуса, Статус);
		Результат.Вставить(ИмяПоляДатаСтатуса(ТипСтатуса), ДатаСтатуса);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Записывает в базу все статусы операции
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - владелец статусов;
//  СтатусыОперации - Структура - все статусы операции;
//
Процедура СтатусыОперации_Записать(Операция, СтатусыОперации) Экспорт
	
	ДатаНовыхСтатусов = ТекущаяДатаСеанса();
	
	Для каждого Элемент Из СтатусыОперации Цикл
		
		ТипСтатуса = Элемент.Ключ;
		НовыйСтатус = Элемент.Значение;
		
		Если Лев(ТипСтатуса, 11) = "ДатаСтатуса" Тогда
			Продолжить;
		КонецЕсли;
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК Т
		|ГДЕ
		|	Т.ТипСтатуса = &ТипСтатуса
		|	И Т.Операция = &Операция");
		Запрос.УстановитьПараметр("ТипСтатуса", ТипСтатуса);
		Запрос.УстановитьПараметр("Операция", Операция);
		
		СтарыйСтатус = ПолучитьРезультатЗапроса(Запрос, "Статус");
		
		Если СтарыйСтатус = НовыйСтатус
			Или (Не ЗначениеЗаполнено(СтарыйСтатус)
				И Не ЗначениеЗаполнено(НовыйСтатус)) Тогда
			Продолжить;
		КонецЕсли;
		
		Запись = РегистрыСведений.КонтурМаркировка_СтатусыОпераций.СоздатьМенеджерЗаписи();
		Запись.Операция		 = Операция;
		Запись.ТипСтатуса	 = ТипСтатуса;
		Запись.Статус		 = НовыйСтатус;
		Запись.ДатаСтатуса	 = ДатаНовыхСтатусов;
		
		Если ЗначениеЗаполнено(НовыйСтатус) Тогда
			Запись.Записать();
		Иначе
			Запись.Удалить();
		КонецЕсли;
		
		СтатусыОперации[ИмяПоляДатаСтатуса(ТипСтатуса)] = ДатаНовыхСтатусов;
		
	КонецЦикла;
	
КонецПроцедуры

// Записывает в базу основной статус операции
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - владелец статуса;
//  Статус - Строка - значение статуса;
//  ДатаСтатуса - Дата - дата статуса операции;
//
Процедура СтатусыОперации_ЗаписатьОсновнойСтатус(Операция, Статус, ДатаСтатуса = Неопределено) Экспорт
	
	ТипСтатуса = "ОсновнойСтатус";
	Если СтатусыОперации_СтатусУжеУстановлен(Операция, ТипСтатуса, Статус) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДатаСтатуса = Неопределено Тогда
		ДатаСтатуса = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Набор = РегистрыСведений.КонтурМаркировка_СтатусыОпераций.СоздатьНаборЗаписей();
	Набор.Отбор.ТипСтатуса.Установить(ТипСтатуса);
	Набор.Отбор.Операция.Установить(Операция);
	
	Если ЗначениеЗаполнено(Статус) Тогда
		Запись = Набор.Добавить();
		Запись.ТипСтатуса = ТипСтатуса;
		Запись.Операция = Операция;
		Запись.Статус = Статус;
		Запись.ДатаСтатуса = ДатаСтатуса;
	КонецЕсли;
	
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();
	
	Если Операция_ВлияетНаТребуемоеДействиеДокумента(Операция) Тогда
		ДокументУчета_ОбновитьТребуемоеДействие(Операция.ДокументУчета);
	КонецЕсли;
	
КонецПроцедуры

Функция СтатусыОперации_СтатусУжеУстановлен(Операция, ТипСтатуса, Статус)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Поле1
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК Т
	|ГДЕ
	|	Т.Операция = &Операция
	|	И Т.ТипСтатуса = &ТипСтатуса
	|	И Т.Статус = &Статус");
	
	Запрос.УстановитьПараметр("Операция", Операция);
	Запрос.УстановитьПараметр("ТипСтатуса", ТипСтатуса);
	Запрос.УстановитьПараметр("Статус", Статус);
	
	Результат = Не Запрос.Выполнить().Пустой();
	
	Возврат Результат;
	
КонецФункции

Процедура СтатусыОперации_Удалить(Операция)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		СтатусыОперации_Заблокировать(Операция);
		
		Набор = РегистрыСведений.КонтурМаркировка_СтатусыОпераций.СоздатьНаборЗаписей();
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Отбор.Операция.Установить(Операция);
		Набор.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Устанавливает исключительную блокировку регистра статусов операций
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция , по которой нужно заблокировать статусы
//
Процедура СтатусыОперации_Заблокировать(Операция)
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КонтурМаркировка_СтатусыОпераций");
	ЭлементБлокировки.УстановитьЗначение("Операция", Операция);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

// #КонецОбласти // СтатусыОпераций

// #Область ТоварыАгрегатов

Функция ТоварыАгрегатов_Прочитать(КлючиКодов) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.Товар КАК Товар,
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	Т.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Т.Количество КАК Количество
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ТоварыАгрегатов КАК Т
	|ГДЕ
	|	Т.КлючКода В(&КлючиКодов)");
	Запрос.УстановитьПараметр("КлючиКодов", ЗначениеВМассиве(КлючиКодов));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ТоварыАгрегатов_Записать(ТоварыАгрегатов) Экспорт
	
	Если Не ЗначениеЗаполнено(ТоварыАгрегатов) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТоварыАгрегатов.Количество() <= НебольшоеКоличествоЗаписейРегистра() Тогда
		ТоварыАгрегатов_ЗаписатьЧерезМенеджерЗаписи(ТоварыАгрегатов);
		Возврат;
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Если Не ТоварыАгрегатов_ВТ_СформироватьТаблицуИзменений(ТоварыАгрегатов, МенеджерВТ) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТабИзменений.КлючКода КАК КлючКода,
	|	ЕСТЬNULL(ТоварыАгрегатов.ПорцияЗаписей, &ПустойКлюч) КАК ПорцияЗаписей
	|ИЗ
	|	ТаблицаИзменений КАК ТабИзменений
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ТоварыАгрегатов КАК ТоварыАгрегатов
	|		ПО ТабИзменений.КлючКода = ТоварыАгрегатов.КлючКода
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорцияЗаписей
	|ИТОГИ ПО
	|	ПорцияЗаписей");
	Запрос.УстановитьПараметр("ПустойКлюч", ПустойУникальныйИдентификатор());
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	РезультатЗапроса = Запрос.Выполнить();
	МенеджерВТ.Закрыть();
	
	Отбор = Новый Структура("КлючКода");
	ИндексТоварыАгрегатов = ТоварыАгрегатов.Индексы.Добавить("КлючКода");
	ТоварыАгрегатов.Колонки.Добавить("Записан", Новый ОписаниеТипов("Булево"));
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		// BSLLS:NestedStatements-off
		
		ТоварыАгрегатов_ЗаблокироватьПоТаблице(РезультатЗапроса);
		
		ВыборкаПорция = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПорция.Следующий() Цикл
			
			Если ЗначениеЗаполнено(ВыборкаПорция.ПорцияЗаписей) Тогда
				ПорцияЗаписей = ВыборкаПорция.ПорцияЗаписей;
			Иначе
				ПорцияЗаписей = МодульОбщегоНазначения().НовыйУникальныйИдентификаторПервойВерсии();
			КонецЕсли;
			
			Набор = РегистрыСведений.КонтурМаркировка_ТоварыАгрегатов.СоздатьНаборЗаписей();
			Набор.Отбор.ПорцияЗаписей.Установить(ПорцияЗаписей);
			Набор.Прочитать();
			
			ТаблицаНабора = Набор.Выгрузить();
			ТаблицаНабора.Индексы.Добавить("КлючКода");
			
			Выборка = ВыборкаПорция.Выбрать();
			Пока Выборка.Следующий() Цикл
				
				Отбор.КлючКода = Выборка.КлючКода;
				СтрокиТовара = ТоварыАгрегатов.НайтиСтроки(Отбор);
				СтрокиНабора = ТаблицаНабора.НайтиСтроки(Отбор);
				
				Для каждого СтрНабора Из СтрокиНабора Цикл
					ТаблицаНабора.Удалить(СтрНабора);
				КонецЦикла;
				
				Для каждого СтрТовара Из СтрокиТовара Цикл
					Если Не СтрТовара.Записан Тогда
						СтрНабора = ТаблицаНабора.Добавить();
						ЗаполнитьЗначенияСвойств(СтрНабора, СтрТовара);
						СтрНабора.ПорцияЗаписей = ПорцияЗаписей;
						СтрТовара.Записан = Истина;
					КонецЕсли;
				КонецЦикла;
				
			КонецЦикла;
			
			Набор.Загрузить(ТаблицаНабора);
			Набор.Записать();
			
		КонецЦикла;
		
		// BSLLS:NestedStatements-on
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	ТоварыАгрегатов.Индексы.Удалить(ИндексТоварыАгрегатов);
	ТоварыАгрегатов.Колонки.Удалить("Записан");
	
КонецПроцедуры

Процедура ТоварыАгрегатов_ЗаписатьЧерезМенеджерЗаписи(ТоварыАгрегатов)
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Если Не ТоварыАгрегатов_ВТ_СформироватьТаблицуИзменений(ТоварыАгрегатов, МенеджерВТ) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТабИзменений.КлючКода КАК КлючКода,
	|	ЕСТЬNULL(ТоварыАгрегатов.ПорцияЗаписей, НЕОПРЕДЕЛЕНО) КАК ПорцияЗаписей
	|ИЗ
	|	ТаблицаИзменений КАК ТабИзменений
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ТоварыАгрегатов КАК ТоварыАгрегатов
	|		ПО ТабИзменений.КлючКода = ТоварыАгрегатов.КлючКода");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	ТаблицаИзменений = Запрос.Выполнить().Выгрузить();
	МенеджерВТ.Закрыть();
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ТоварыАгрегатов_ЗаблокироватьПоТаблице(ТаблицаИзменений);
		
		Для Каждого СтрИзменений Из ТаблицаИзменений Цикл
			// Удаляем все записи по порции и ключу кода
			ПорцияЗаписей = СтрИзменений.ПорцияЗаписей;
			Набор = РегистрыСведений.КонтурМаркировка_ТоварыАгрегатов.СоздатьНаборЗаписей();
			Набор.Отбор.ПорцияЗаписей.Установить(СтрИзменений.ПорцияЗаписей);
			Набор.Отбор.КлючКода.Установить(СтрИзменений.КлючКода);
			Набор.Записать();
		КонецЦикла;
		
		НоваяПорция = МодульОбщегоНазначения().НовыйУникальныйИдентификаторПервойВерсии();
		НаборНовыхЗаписей = РегистрыСведений.КонтурМаркировка_ТоварыАгрегатов.СоздатьНаборЗаписей();
		НаборНовыхЗаписей.Отбор.ПорцияЗаписей.Установить(НоваяПорция);
		
		Для каждого СтрТовара Из ТоварыАгрегатов Цикл
			
			Если ТаблицаИзменений.Найти(СтрТовара.КлючКода, "КлючКода") = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ПорцияЗаписей) Тогда
				Запись = РегистрыСведений.КонтурМаркировка_ТоварыАгрегатов.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись, СтрТовара);
				Запись.ПорцияЗаписей = ПорцияЗаписей;
				Запись.Записать();
			Иначе
				Запись = НаборНовыхЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(Запись, СтрТовара);
				Запись.ПорцияЗаписей = НоваяПорция;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(НаборНовыхЗаписей) Тогда
			НаборНовыхЗаписей.Записать();
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ТоварыАгрегатов_ЗаблокироватьПоТаблице(Таблица, ИмяКолонки = "ПорцияЗаписей")
	
	Если ТипЗнч(Таблица) = Тип("ТаблицаЗначений") Тогда
		ТаблицаДляБлокировки = Таблица.Скопировать( , ИмяКолонки);
		ТаблицаДляБлокировки.Свернуть(ИмяКолонки);
		ТаблицаЗначений_УдалитьПустыеСтроки(ТаблицаДляБлокировки, ИмяКолонки);
	Иначе
		ТаблицаДляБлокировки = Таблица;
	КонецЕсли;
	
	Поле = "ПорцияЗаписей";
	Объект = "РегистрСведений.КонтурМаркировка_ТоварыАгрегатов";
	ЗаблокироватьПоТаблице(Объект, Поле, ТаблицаДляБлокировки, ИмяКолонки);
	
КонецПроцедуры

Процедура ТоварыАгрегатов_ВТ_Удалить(МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТоварыАгрегатов.КлючКода КАК КлючКода,
	|	ТоварыАгрегатов.ПорцияЗаписей КАК ПорцияЗаписей
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ТоварыАгрегатов КАК ТоварыАгрегатов
	|		ПО ТаблицаКодов.КлючКода = ТоварыАгрегатов.КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Результат.ПорцияЗаписей КАК ПорцияЗаписей
	|ИЗ
	|	Результат КАК Результат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Результат.КлючКода КАК КлючКода
	|ИЗ
	|	Результат КАК Результат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Результат");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	РезультатЗапросаПорцииКодов = РезультатыЗапроса[1];
	РезультатЗапросаКлючиКодов = РезультатыЗапроса[2];
	Если РезультатЗапросаКлючиКодов.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов = РезультатЗапросаКлючиКодов.Выгрузить();
	ТаблицаКодов.Индексы.Добавить("КлючКода");
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ТоварыАгрегатов_ЗаблокироватьПоТаблице(РезультатЗапросаПорцииКодов);
		
		Выборка = РезультатЗапросаПорцииКодов.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Набор = РегистрыСведений.КонтурМаркировка_ТоварыАгрегатов.СоздатьНаборЗаписей();
			Набор.Отбор.ПорцияЗаписей.Установить(Выборка.ПорцияЗаписей);
			Набор.Прочитать();
			
			Для Сч = -(Набор.Количество() - 1) По 0 Цикл
				Если ТаблицаКодов.Найти(Набор[-Сч].КлючКода, "КлючКода") <> Неопределено Тогда
					Набор.Удалить(-Сч);
				КонецЕсли;
			КонецЦикла;
			
			Если Набор.Модифицированность() Тогда
				Набор.Записать();
			КонецЕсли;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция ТоварыАгрегатов_ВТ_СформироватьТаблицуИзменений(ТоварыАгрегатов, МенеджерВТ)
	
	ПоляИндекса = "КлючКода, Товар, КлючНоменклатуры1С, Количество, КоличествоУпаковок";
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ТоварыАгрегатов, "ТабТоваров", ПоляИндекса);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.КлючКода КАК КлючКода
	|ПОМЕСТИТЬ ТаблицаИзменений
	|ИЗ
	|	(ВЫБРАТЬ
	|		Т.КлючКода КАК КлючКода,
	|		Т.Товар КАК Товар,
	|		Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|		Т.КоличествоУпаковок КАК КоличествоУпаковок,
	|		Т.Количество КАК Количество,
	|		СУММА(Т.ЕстьОтличия) КАК ЕстьОтличия
	|	ИЗ
	|		(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			ТабТоваров.КлючКода КАК КлючКода,
	|			ТабТоваров.Товар КАК Товар,
	|			ТабТоваров.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|			ТабТоваров.КоличествоУпаковок КАК КоличествоУпаковок,
	|			ТабТоваров.Количество КАК Количество,
	|			1 КАК ЕстьОтличия
	|		ИЗ
	|			ТабТоваров КАК ТабТоваров
	|		
	|		ОБЪЕДИНИТЬ ВСЕ
	|		
	|		ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			ТоварыАгрегатов.КлючКода,
	|			ТоварыАгрегатов.Товар,
	|			ТоварыАгрегатов.КлючНоменклатуры1С,
	|			ТоварыАгрегатов.КоличествоУпаковок,
	|			ТоварыАгрегатов.Количество,
	|			-1
	|		ИЗ
	|			РегистрСведений.КонтурМаркировка_ТоварыАгрегатов КАК ТоварыАгрегатов
	|		ГДЕ
	|			ТоварыАгрегатов.КлючКода В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ТабТоваров.КлючКода КАК КлючКода
	|					ИЗ
	|						ТабТоваров)) КАК Т
	|	
	|	СГРУППИРОВАТЬ ПО
	|		Т.КлючКода,
	|		Т.КлючНоменклатуры1С,
	|		Т.Товар,
	|		Т.КоличествоУпаковок,
	|		Т.Количество
	|	
	|	ИМЕЮЩИЕ
	|		СУММА(Т.ЕстьОтличия) <> 0) КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТабТоваров");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Выборка = Запрос.ВыполнитьПакет()[0].Выбрать();
	Выборка.Следующий();
	
	Возврат ЗначениеЗаполнено(Выборка.Количество);
	
КонецФункции

Процедура ТоварыАгрегатов_ЗаполнитьИзГИСМТ(ТаблицаКодов, Организация) Экспорт
	
	// BSLLS:CognitiveComplexity-off
	// BSLLS:NestedStatements-off
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	ТаблицаКодов.Колонки.Добавить("ТоварыИзСервиса");
	
	ТаблицаКИТУ = Новый_ТаблицаКодов();
	ТаблицаКИТУ.Колонки.Добавить("СтрАгрегата");
	
	КлючиАгрегатов = Новый Массив;
	
	ОтборКИТУ = Новый Структура("ОбщийТипУпаковки", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	
	Для каждого СтрАгрегата Из ТаблицаКодов.НайтиСтроки(ОтборКИТУ) Цикл
		СтрАгрегата.ТоварыИзСервиса = Новый Соответствие;
		СтрКИТУ = ТаблицаКИТУ.Добавить();
		СтрКИТУ.КодМаркировки = СтрАгрегата.КодМаркировки;
		СтрКИТУ.ВидПродукции = СтрАгрегата.ВидПродукции;
		СтрКИТУ.СтрАгрегата = СтрАгрегата;
		КлючиАгрегатов.Добавить(СтрАгрегата.КлючКода);
	КонецЦикла;
	
	КэшТоваров = Новый Соответствие;
	
	Пока ЗначениеЗаполнено(ТаблицаКИТУ) Цикл
		
		Для каждого ЧастьТаблицы Из ТаблицаЗначений_Разбить(ТаблицаКИТУ, "ВидПродукции") Цикл
			
			ВидПродукции = ЧастьТаблицы.ВидПродукции;
			СтрокиТаблицы = ЧастьТаблицы.МассивСтрок;
			
			КодыМаркировки = Новый Массив;
			Для каждого СтрАгрегата Из СтрокиТаблицы Цикл
				КодыМаркировки.Добавить(СтрАгрегата.КодМаркировки);
			КонецЦикла;
			
			Ответ = Маркировка_СтатусыКодов(КодыМаркировки, Организация, ВидПродукции);
			
			ЭтоНикотиносодержащаяПродукция = ЭтоНикотиносодержащаяПродукция(ВидПродукции);
			
			Для Сч = 0 По СтрокиТаблицы.ВГраница() Цикл
				
				СтрКИТУ = СтрокиТаблицы[Сч];
				СтрАгрегата = СтрКИТУ.СтрАгрегата;
				КодМаркировки = СтрКИТУ.КодМаркировки;
				ТаблицаКИТУ.Удалить(СтрКИТУ);
				
				Если Не ЗначениеЗаполнено(Ответ) Тогда
					Продолжить;
				КонецЕсли;
				
				CisInfo = Ответ[Сч];
				Если Не ЗначениеЗаполнено(CisInfo) Тогда
					Продолжить;
				КонецЕсли;
				
				value = CisInfo["value"];
				Если Не ЗначениеЗаполнено(value) Тогда
					Продолжить;
				КонецЕсли;
				
				childrenCodes = value["childrenCodes"];
				Если Не ЗначениеЗаполнено(childrenCodes) Тогда
					
					Если ЭтоНикотиносодержащаяПродукция Тогда
						GTIN = GTINИзКодаМаркировки(КодМаркировки, ВидПродукции);
						
						Если ЗначениеЗаполнено(GTIN) Тогда
							Товар = Товар_НайтиСоздатьПоИнформацииИзСервиса(GTIN, КэшТоваров);
							СтрАгрегата.ТоварыИзСервиса[Товар] = ЗначениеСоответствия(СтрАгрегата.ТоварыИзСервиса, Товар, 0) + 1;
						КонецЕсли;
						
					КонецЕсли;
					
					Продолжить;
					
				КонецЕсли;
				
				Для каждого ВложенныйКод Из childrenCodes Цикл
					
					GTIN = GTINИзКодаМаркировки(ВложенныйКод);
					
					Если ЗначениеЗаполнено(GTIN) Тогда
						Товар = Товар_НайтиСоздатьПоИнформацииИзСервиса(GTIN, КэшТоваров);
						СтрАгрегата.ТоварыИзСервиса[Товар] = ЗначениеСоответствия(СтрАгрегата.ТоварыИзСервиса, Товар, 0) + 1;
					Иначе
						СтрКИТУ = ТаблицаКИТУ.Добавить();
						СтрКИТУ.КодМаркировки = ВложенныйКод;
						СтрКИТУ.ВидПродукции = ВидПродукции;
						СтрКИТУ.СтрАгрегата = СтрАгрегата;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ТоварыАгрегатов = Новый_ТоварыАгрегатов();
	ТекТоварыАгрегатов = ТоварыАгрегатов_Прочитать(КлючиАгрегатов);
	ТекТоварыАгрегатов.Индексы.Добавить("КлючКода, Товар");
	
	ОтборКлючТовар = Новый Структура("КлючКода, Товар");
	
	Для каждого СтрАгрегата Из ТаблицаКодов.НайтиСтроки(ОтборКИТУ) Цикл
		
		Если Не ЗначениеЗаполнено(СтрАгрегата.ТоварыИзСервиса) Тогда
			Продолжить;
		КонецЕсли;
		
		ОтборКлючТовар.КлючКода = СтрАгрегата.КлючКода;
		
		Для каждого Элемент Из СтрАгрегата.ТоварыИзСервиса Цикл
			
			Товар = Элемент.Ключ;
			КоличествоУпаковок = Элемент.Значение;
			
			ТекКоличествоУпаковок = 0;
			ОтборКлючТовар.Товар = Товар;
			СтрокиТекТоваров = ТекТоварыАгрегатов.НайтиСтроки(ОтборКлючТовар);
			Для Каждого СтрТекТоваров Из СтрокиТекТоваров Цикл
				ТекКоличествоУпаковок = ТекКоличествоУпаковок + СтрТекТоваров.КоличествоУпаковок;
			КонецЦикла;
			
			Если КоличествоУпаковок >= ТекКоличествоУпаковок Тогда
				Для Каждого СтрТекТоваров Из СтрокиТекТоваров Цикл
					ЗаполнитьЗначенияСвойств(ТоварыАгрегатов.Добавить(), СтрТекТоваров);
				КонецЦикла;
				КоличествоУпаковок = КоличествоУпаковок - ТекКоличествоУпаковок;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(КоличествоУпаковок) Тогда
				Стр = ТоварыАгрегатов.Добавить();
				Стр.Товар = Товар;
				Стр.КлючКода = СтрАгрегата.КлючКода;
				Стр.КоличествоУпаковок = КоличествоУпаковок;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	КэшНоменклатуры1С = Новый Соответствие;
	Для Каждого Стр Из ТоварыАгрегатов Цикл
		
		Если ЗначениеЗаполнено(Стр.КлючНоменклатуры1С) Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаНоменклатуры = Товар_НайтиНоменклатуру1С(Стр.Товар, КэшНоменклатуры1С);
		Если ТаблицаНоменклатуры.Количество() = 1 Тогда
			Стр.КлючНоменклатуры1С = ТаблицаНоменклатуры[0].КлючНоменклатуры1С;
		КонецЕсли;
		
	КонецЦикла;
	
	ТоварыАгрегатов.Свернуть("КлючКода, Товар, КлючНоменклатуры1С", "КоличествоУпаковок, Количество");
	
	ТаблицаКодов.Колонки.Удалить("ТоварыИзСервиса");
	
	ТаблицаКодов_УточнитьДанныеАгрегатовПоТоварам(ТаблицаКодов, ТоварыАгрегатов);
	
	ТоварыАгрегатов_Записать(ТоварыАгрегатов);
	ТаблицаКодов_ЗаписатьИнформациюОКодах(ТаблицаКодов);
	
	// BSLLS:CognitiveComplexity-on
	// BSLLS:NestedStatements-on
	
КонецПроцедуры

Функция Новый_ТоварыАгрегатов() Экспорт
	
	КлючКэш = "ШаблонТоварыАгрегатов";
	Шаблон = Кэш_Прочитать(КлючКэш);
	Если Шаблон <> Неопределено Тогда
		Возврат Шаблон.СкопироватьКолонки();
	КонецЕсли;
	
	ТипЧисло = Новый ОписаниеТипов("Число");
	ТипИдентификатор = Новый ОписаниеТипов("УникальныйИдентификатор");
	ТипТовар = Новый ОписаниеТипов("СправочникСсылка.КонтурМаркировка_Товары");
	ТипКлючНоменклатуры = Новый ОписаниеТипов("СправочникСсылка.КонтурМаркировка_КлючиНоменклатуры1С");
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("КлючКода", ТипИдентификатор);
	Результат.Колонки.Добавить("Товар", ТипТовар);
	Результат.Колонки.Добавить("КлючНоменклатуры1С", ТипКлючНоменклатуры);
	Результат.Колонки.Добавить("КоличествоУпаковок", ТипЧисло);
	Результат.Колонки.Добавить("Количество", ТипЧисло);
	
	Кэш_Поместить(Результат.СкопироватьКолонки(), КлючКэш);
	
	Возврат Результат;
	
КонецФункции

