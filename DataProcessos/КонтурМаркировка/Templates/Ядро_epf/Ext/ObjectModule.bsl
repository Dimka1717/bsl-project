Процедура ТаблицаКодов_ДобавитьКлючиТранспортныхУпаковокПоДеревуАгрегатов(ТаблицаКодов, СтрокиДерева, КлючАгрегата = Неопределено) Экспорт
	
	Отбор = Новый Структура("КлючАгрегата, Товар, КлючНоменклатуры1С");
	Отбор.КлючАгрегата = ПустойУникальныйИдентификатор();
	
	Для Каждого Стр Из СтрокиДерева Цикл
		Если ЗначениеЗаполнено(Стр.ВидАгрегата) Тогда
			// Строка агрегата
			Для Сч = 1 По Стр.КоличествоАгрегатов Цикл
				СтрАгрегата = ТаблицаКодов.Добавить();
				СтрАгрегата.КлючКода = МодульОбщегоНазначения().НовыйУникальныйИдентификаторПервойВерсии();
				СтрАгрегата.КлючСтрокиОперации = Новый УникальныйИдентификатор;
				СтрАгрегата.ВидАгрегата = Стр.ВидАгрегата;
				СтрАгрегата.ТипШтрихкода = Стр.ВидАгрегата.ТипШтрихкода;
				СтрАгрегата.ТипУпаковки = Перечисления.КонтурМаркировка_ТипыУпаковок.МонотоварнаяУпаковка;
				СтрАгрегата.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка;
				СтрАгрегата.КлючАгрегата = КлючАгрегата;
				ТаблицаКодов_ДобавитьКлючиТранспортныхУпаковокПоДеревуАгрегатов(ТаблицаКодов, Стр.Строки, СтрАгрегата.КлючКода);
			КонецЦикла;
		Иначе
			// Строка товара
			КоличествоКодовПодобрано = 0;
			ЗаполнитьЗначенияСвойств(Отбор, Стр);
			Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
				Если КоличествоКодовПодобрано = Стр.КоличествоКодов Тогда
					Прервать;
				КонецЕсли;
				СтрКода.КлючАгрегата = КлючАгрегата;
				КоличествоКодовПодобрано = КоличествоКодовПодобрано + 1;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

