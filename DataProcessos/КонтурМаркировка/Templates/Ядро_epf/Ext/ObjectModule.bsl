			Результат.Вставить("documentType", ТипПервичногоДокументаВСервисе(ВидПервичногоДокумента));
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.БезвозмезднаяПередача Тогда
		Результат.Вставить("buyerInn", ДопРеквизиты.ИННПолучателя);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.ДляСобственныхНужд
		Или ПричинаВыводаИзОборота = ПричиныВывода.ДляПроизводственныхЦелей Тогда
		Если ЗначениеЗаполнено(ДопРеквизиты.ИННПолучателя) Тогда
			Результат.Вставить("buyerInn", ДопРеквизиты.ИННПолучателя);
		КонецЕсли;
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.ЭкспортЕАЭС Тогда
		Результат.Вставить("ImporterId", ДопРеквизиты.ИННПолучателя);
		Результат.Вставить("DestinationCountryCode", ДопРеквизиты.КодСтраныПолучателя);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.ПродажаПоГосКонтракту Тогда
		Результат.Вставить("stateContractId", ДопРеквизиты.ИдентификаторГосКонтракта);
	КонецЕсли;
	
	Если ВидПервичногоДокумента = ВидыДокументов.Прочее Тогда
		Результат.Вставить("customDocumentName", ДопРеквизиты.НаименованиеПервичногоДокумента);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.Прочее Тогда
		Результат.Вставить("customActionName", ДопРеквизиты.НаименованиеПричиныВыводаИзОборота);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.ПродажаПоСделкеСГосударственнойТайной Тогда
		Результат.Вставить("stateContractId", ДопРеквизиты.ИдентификаторГосКонтракта);
	КонецЕсли;
	
	МожноУказатьЦену = Операция_ВыводИзОборота_МожноУказатьЦену(ПричинаВыводаИзОборота);
	УказыватьНулевуюСтоимость = (ПричинаВыводаИзОборота = ПричиныВывода.БезвозмезднаяПередача
	И ЗначениеЗаполнено(ДопРеквизиты.ИННПолучателя));
	
	products = Новый Массив;
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		
		product = Новый Структура;
		product.Вставить("name", Стр.Товар.Наименование);
		product.Вставить("gtin", Стр.Товар.GTIN);
		product.Вставить("quantity", Стр.КоличествоУпаковок);
		
		Если УказыватьНулевуюСтоимость Тогда
			СтоимостьСНДСВКопейках = 0;
			product.Вставить("cost", СтоимостьСНДСВКопейках);
		ИначеЕсли МожноУказатьЦену И ЗначениеЗаполнено(Стр.Цена) Тогда
			СтоимостьСНДСВКопейках = РублиВКопейки(Стр.Цена);
			product.Вставить("cost", СтоимостьСНДСВКопейках);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.НомерПартии) Тогда
			НомерПартии = Стр.НомерПартии;
		ИначеЕсли ЗначениеЗаполнено(ДопРеквизиты.НомерПартии) Тогда
			НомерПартии = ДопРеквизиты.НомерПартии;
		Иначе
			НомерПартии = Неопределено;
		КонецЕсли;
		
		ДобавитьЗаполненноеЗначениеВСтруктуру(product, "partNumber", НомерПартии);
		
		ДобавитьЗаполненноеЗначениеВСтруктуру(product, "gtinWeightGram", (Стр.Количество * ГраммВКилограмме()));
		
		products.Добавить(product);
		
	КонецЦикла;
	
	МассивСтруктур_Свернуть(products, "gtin, cost", "quantity");
	
	Результат.Вставить("products", products);
	
	Возврат Результат;
	
