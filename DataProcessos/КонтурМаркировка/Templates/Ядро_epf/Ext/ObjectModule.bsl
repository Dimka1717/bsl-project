Процедура ТаблицаКодов_ВТ_ДобавитьКлючиАгрегатовВерхнегоУровня(МенеджерВТ) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Таб.КлючКода КАК КлючКода,
	|	СвязиКлючейКодов.КлючАгрегата КАК КлючАгрегата
	|ПОМЕСТИТЬ Таб1
	|ИЗ
	|	ТаблицаКодов КАК Таб
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО Таб.КлючКода = СвязиКлючейКодов.КлючКода
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючАгрегата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода
	|ПОМЕСТИТЬ Итог1
	|ИЗ
	|	Таб1 КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаКодов");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СвязиКлючейКодов.КлючКода КАК КлючКода,
	|	СвязиКлючейКодов.КлючАгрегата КАК КлючАгрегата
	|ПОМЕСТИТЬ Таб2
	|ИЗ
	|	Таб1 КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО Таб.КлючАгрегата = СвязиКлючейКодов.КлючКода
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючАгрегата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода
	|ПОМЕСТИТЬ Итог2
	|ИЗ
	|	Итог1 КАК Т
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Т.КлючКода
	|ИЗ
	|	Таб2 КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Таб1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Итог1";
	
	Пока Истина Цикл
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
		Выборка = Запрос.ВыполнитьПакет().Получить(0).Выбрать();
		Выборка.Следующий();
		Если Выборка.Количество = 0 Тогда
			Прервать;
		КонецЕсли;
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Таб1", "Таб2");
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Итог1", "Итог2");
	КонецЦикла;
	
	ЕстьИтог1 = Найти(ТекстЗапроса, "ПОМЕСТИТЬ Итог1") > 0;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	Итог2 КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Таб2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Итог2";
	
	Если ЕстьИтог1 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Итог2", "Итог1");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Таб2", "Таб1");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры

