	ТипыВСервисе.Вставить(ВидыДокументов.ТаможеннаяДекларация, "CustomsDeclaration");
	ТипыВСервисе.Вставить(ВидыДокументов.АктУничтожения, "DestructionAct");
	ТипыВСервисе.Вставить(ВидыДокументов.Прочее, "Other");
	ТипыВСервисе.Вставить(ВидыДокументов.ЭлектронныйCертификат, "DigitalCertificate");
