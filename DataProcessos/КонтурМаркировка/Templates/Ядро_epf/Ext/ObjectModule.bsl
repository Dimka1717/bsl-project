// Записывает в доп справочник маркируемые товарные группы
//
// Параметры:
//  ОписаниеМаркируемойТГ	 - Структура - см. Новый_МаркируемаяТоварнаяГруппа()
//
Процедура МаркируемаяТоварнаяГруппа_Записать(ОписаниеМаркируемойТГ)
	
	ИмяСправочника = ИмяСправочникаМаркируемыеТоварныеГруппы();
	ДопСправочник = Новый_ЭлементДопСправочника(ИмяСправочника);
	ДопСправочник.Ссылка = ОписаниеМаркируемойТГ.Ссылка;
	ДопСправочник.Наименование = Строка(ОписаниеМаркируемойТГ.ВидПродукции);
	
	Для Каждого Элемент Из ОписаниеМаркируемойТГ Цикл
		
		Ключ     = Элемент.Ключ;
		Значение = Элемент.Значение;
		
		Если Ключ = "Ссылка" Или Ключ = "Наименование" Тогда
			Продолжить;
		КонецЕсли;
		
		ДопСправочник.ДопРеквизиты.Вставить(Ключ, Значение);
		
	КонецЦикла;
	
	ДопСправочник_Записать(ДопСправочник);
	
	ОписаниеМаркируемойТГ.Ссылка = ДопСправочник.Ссылка;
	
	КлючКэш = ИмяСправочникаМаркируемыеТоварныеГруппы();
	Кэш_Поместить(КлючКэш, Неопределено);
	
КонецПроцедуры

// Возвращает указанное в настройках правило для отражение в ЭДО для вида продукции
//
// Параметры:
//  ВидПродукции - ПеречислениеСсылка.КонтурМаркировка_ВидыПродукции - вид продукции
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.КонтурМаркировка_ПравилаОтраженияВЭДО, Неопределено - правило отражения в ЭДО для ТГ
//
Функция МаркируемыеТоварныеГруппы_ОтражениеВЭДО(ВидПродукции)
	
	Результат = Неопределено;
	
	МаркируемаяТГ = МаркируемаяТоварнаяГруппа_ПоВидуПродукции(ВидПродукции);
	
	Если ЗначениеЗаполнено(МаркируемаяТГ) Тогда
		Результат = МаркируемаяТоварнаяГруппа_Прочитать(МаркируемаяТГ).ОтражениеВЭДО;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Находит параметры маркируемой товарной группы по виду продукции
//
// Параметры:
//  ВидПродукции - Перечисление.КонтурМаркировка_ВидыПродукции - вид продукции
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_ДопСправочники - маркируемая товарная группа
//
Функция МаркируемаяТоварнаяГруппа_ПоВидуПродукции(ВидПродукции)
	
	КлючКэш = ИмяСправочникаМаркируемыеТоварныеГруппы();
	КэшПараметров = Кэш_Прочитать(КлючКэш);
	Если КэшПараметров = Неопределено Тогда
		КэшПараметров = Новый Соответствие;
		Кэш_Поместить(КлючКэш, КэшПараметров);
	КонецЕсли;
	
	Результат = КэшПараметров[ВидПродукции];
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяРеквизита = "ВидПродукции";
	ИмяСправочника = ИмяСправочникаМаркируемыеТоварныеГруппы();
	МассивСсылок = ДопСправочник_НайтиПоДопРеквизиту(ИмяСправочника, ИмяРеквизита, ВидПродукции);
	
	Результат = Неопределено;
	Если ЗначениеЗаполнено(МассивСсылок) Тогда
		Результат = МассивСсылок[0];
	КонецЕсли;
	
	КэшПараметров.Вставить(ВидПродукции, Результат);
	
	Возврат Результат;
	
КонецФункции

// Записывает в доп справочник маркируемые товарные группы из массива и удаляет неиспользуемые
//
// Параметры:
//  ОписанияМаркируемыхТГ - Структура - см. Новый_МаркируемаяТоварнаяГруппа()
// 
Процедура МаркируемыеТоварныеГруппы_ПерезаписатьНастройки(ОписанияМаркируемыхТГ) Экспорт
	
	Для Каждого МаркируемаяТГ Из ОписанияМаркируемыхТГ Цикл
		МаркируемаяТоварнаяГруппа_Записать(МаркируемаяТГ);
	КонецЦикла;
	
	ВсеЭлементы = МаркируемыеТоварныеГруппы_ВсеЭлементы();
	
	Для Каждого Ссылка Из ВсеЭлементы Цикл
		Если Не ЗначениеЗаполнено(МассивСтруктур_Найти(ОписанияМаркируемыхТГ, Ссылка, "Ссылка")) Тогда
			ДопСправочник_Удалить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Получает из базы список всех параметров маркируемых товарных групп
// 
