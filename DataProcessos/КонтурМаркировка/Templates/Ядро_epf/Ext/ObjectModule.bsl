		НовоеДействие = Неопределено;
		НовыйСтатус = СтатусыОпераций.СозданВСервисе;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		НовыйСтатус = СтатусыОпераций.ОтправленВАрхив;
		
	//ИначеЕсли НРег(СтатусДокумента) = НРег("ReadyForSend") Тогда
	//	
	//	НовоеДействие = ТребуемыеДействия.ПолучитьКонтентДляПодписиВозвратаВОборот;
	//	НовыйСтатус = СтатусыОпераций.ГотовКОтправкеВГИС;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Processing")
		Или НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПроверитьСтатусТрансформацииАгрегатов;
		НовыйСтатус = СтатусыОпераций.ОбрабатываетсяВГИС;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedSuccess") Тогда
		
		НовоеДействие = ТребуемыеДействия.ОбновитьСоставАгрегата;
		НовыйСтатус = СтатусыОпераций.ОжиданиеГотовности;
		
	ИначеЕсли Задача_ТрансформацияАгрегатов_СтатусОшибка(СтатусДокумента) Тогда
		
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Sending")
		Или НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПроверитьСтатусТрансформацииАгрегатов;
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус трансформации агрегата: %1'"), СтатусДокумента);
		
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ТрансформацияАгрегата_ОбновитьСоставАгрегата(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	ИдентификаторДокумента = ОписаниеЗадачи.ИдентификаторДокумента;
	КлючАгрегата = Операция_КлючКода(Операция);
	КодАгрегата = КодМаркировки_НайтиПоКлючу(КлючАгрегата);
	
	Попытка
		ВложенныеКоды = Маркировка_ВложенныеКодыАгрегата(КодАгрегата, Организация);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	ТаблицаКодов.Добавить().КлючКода = КлючАгрегата;
	ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	Для каждого Стр Из ТаблицаКодов Цикл
		Если Стр.КодМаркировки <> КодАгрегата Тогда
			Стр.КодАгрегата = "";
			Стр.КлючАгрегата = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаНовыхКодов = ТаблицаКодов_ЗагрузитьКодыМаркировки(ВложенныеКоды);
	
	Если Не ТаблицаКодов_НормализоватьКоды(ТаблицаНовыхКодов, Организация) Тогда
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, НСтр("ru = 'Не удалось нормализовать коды при обновлении состава агрегата'"));
	КонецЕсли;
	ТаблицаКодов_ДополнитьИнформациейИБ(ТаблицаНовыхКодов);
	
	ИндексКодМаркировки = ТаблицаКодов.Индексы.Добавить("КодМаркировки");
	Для каждого Стр Из ТаблицаНовыхКодов Цикл
		СтрКода = ТаблицаКодов.Найти(Стр.КодМаркировки, "КодМаркировки");
		Если СтрКода = Неопределено Тогда
			СтрКода = ТаблицаКодов.Добавить();
			ЗаполнитьЗначенияСвойств(СтрКода, Стр);
		КонецЕсли;
		СтрКода.КодАгрегата = КодАгрегата;
	КонецЦикла;
	ТаблицаКодов.Индексы.Удалить(ИндексКодМаркировки);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
		Задача_Завершить(ОписаниеЗадачи);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция Задача_ТрансформацияАгрегатов_СтатусОшибка(Статус)
	
	ПодходящиеСтатусы = Новый Соответствие;
	ПодходящиеСтатусы.Вставить(НРег("ProcessedError"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("CrptProcessedError"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("SendingError"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("CrptSendingError"), Истина);
	
	Возврат (ПодходящиеСтатусы[НРег(Статус)] = Истина);
	
КонецФункции

// #КонецОбласти // ТрансформацияАгрегатов

// #Область ФормированиеАТК

Функция ОчередьОбмена_ФормированиеАТК_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеФормированиеАТК);
	Результат.Добавить(ТребуемыеДействия.ПолучитьКонтентДляПодписиФормированияАТК);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьСтатусФормированияАТК);
	Результат.Добавить(ТребуемыеДействия.ПолучитьАТКИзСервиса);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_ФормированиеАТК_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьВСервисеФормированиеАТК Тогда
		Задача_ФормированиеАТК_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьКонтентДляПодписиФормированияАТК Тогда
		Задача_ФормированиеАТК_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_ФормированиеАТК_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьСтатусФормированияАТК Тогда
		Задача_ФормированиеАТК_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьАТКИзСервиса Тогда
		Задача_ФормированиеАТК_ПолучитьАТКИзСервиса(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ФормированиеАТК_СоздатьВСервисе(ОписаниеЗадачи)
	
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_ФормированиеАТК(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_ФормированиеАТК_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьКонтентДляПодписиФормированияАТК;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ГотовКОтправкеВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_ФормированиеАТК(Организация);
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_ФормированиеАТК_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_ФормированиеАТК_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.id;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ФормированиеАТК_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_ФормированиеАТК_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьСтатусФормированияАТК;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_ФормированиеАТК_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовоеДействие = Неопределено;
		НовыйСтатус = СтатусыОпераций.СозданВСервисе;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		НовыйСтатус = СтатусыОпераций.ОтправленВАрхив;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Processing")
		Или НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПроверитьСтатусФормированияАТК;
		НовыйСтатус = СтатусыОпераций.ОбрабатываетсяВГИС;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedSuccess") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПолучитьАТКИзСервиса;
		НовыйСтатус = СтатусыОпераций.ПолучениеАТК;
		
	ИначеЕсли Задача_ФормированиеАТК_СтатусОшибка(СтатусДокумента) Тогда
		
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Sending")
		Или НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПроверитьСтатусФормированияАТК;
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус формирования АТК: %1'"), СтатусДокумента);
		
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ФормированиеАТК_ПолучитьАТКИзСервиса(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	
	Попытка
		Ответ = Маркировка_ФормированиеАТК_КонтентДокумента(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	КодАТК = Ответ.Результат.atkCode;
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	КлючСтрокиДокумента = ТаблицаКодов[0].КлючСтрокиДокумента;
	
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	ТаблицаКодов.ЗаполнитьЗначения(КодАТК, "КодАгрегата");
	ТаблицаКодов.ЗаполнитьЗначения(Истина, "УдалитьИзДокумента");
	
	СтрАТК = ТаблицаКодов.Добавить();
	СтрАТК.КодМаркировки = КодАТК;
	СтрАТК.КлючСтрокиДокумента = КлючСтрокиДокумента;
	СтрАТК.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.АТК;
	СтрАТК.ТипУпаковки = Перечисления.КонтурМаркировка_ТипыУпаковок.МонотоварнаяУпаковка;
	СтрАТК.ТипШтрихкода = Перечисления.КонтурМаркировка_ТипыШтрихкодов.GS1_128;
	ТаблицаКодов_ОбновитьСтатусы(ТаблицаКодов, Организация);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
		КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, Ложь);
		ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета);
		
		ОписаниеОперации.ДопРеквизиты.КлючКода = СтрАТК.КлючКода;
		Операция_Записать(ОписаниеОперации);
		
		Задача_Завершить(ОписаниеЗадачи);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция Задача_ФормированиеАТК_СтатусОшибка(Статус)
	
	ПодходящиеСтатусы = Новый Соответствие;
	ПодходящиеСтатусы.Вставить(НРег("ProcessedError"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("CrptProcessedError"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("SendingError"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("CrptSendingError"), Истина);
	
	Возврат (ПодходящиеСтатусы[НРег(Статус)] = Истина);
	
КонецФункции

// #КонецОбласти // ФормированиеАТК

// #Область РасформированиеАТК

Функция ОчередьОбмена_РасформированиеАТК_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеРасформированиеАТК);
	Результат.Добавить(ТребуемыеДействия.ПолучитьКонтентДляПодписиРасформированияАТК);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьСтатусРасформированияАТК);
	Результат.Добавить(ТребуемыеДействия.РасформироватьАТКПослеРегистрации);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_РасформированиеАТК_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьВСервисеРасформированиеАТК Тогда
		Задача_РасформированиеАТК_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьКонтентДляПодписиРасформированияАТК Тогда
		Задача_РасформированиеАТК_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_РасформированиеАТК_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьСтатусРасформированияАТК Тогда
		Задача_РасформированиеАТК_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.РасформироватьАТКПослеРегистрации Тогда
		Задача_РасформированиеАТК_РасформироватьАТКПослеРегистрации(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_РасформированиеАТК_СоздатьВСервисе(ОписаниеЗадачи)
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	СтатусыКодов = Перечисление_СтатусыКодов();
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	ВидПродукции = ЗначениеРеквизитаОбъекта_Марк(Операция, "ВидПродукции");
	
	УдалосьОбновить = Операция_ОбновитьСтатусыКодов(Операция);
	Если Не УдалосьОбновить Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	МассивКодов = Новый Массив;
	Для каждого Стр Из ТаблицаКодов Цикл
		Если Стр.Статус <> СтатусыКодов.Разагрегирован
			И Стр.Статус <> СтатусыКодов.НеНайден Тогда
			МассивКодов.Добавить(Стр.КодМаркировки);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(МассивКодов) Тогда
		НовоеДействие = ТребуемыеДействия.РасформироватьАТКПослеРегистрации;
		НовыйСтатус = СтатусыОпераций.ОжиданиеГотовности;
		Задача_Записать(ОписаниеЗадачи);
		Возврат;
	КонецЕсли;
	
	Контент = Контент_РасформированиеАТК(ВидПродукции, МассивКодов);
	
	Попытка
		Ответ = Маркировка_РасформированиеАТК_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ПолучитьКонтентДляПодписиРасформированияАТК;
	ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ГотовКОтправкеВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	Метрика_Функциональность_РасформированиеАТК(Организация);
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_РасформированиеАТК_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_РасформированиеАТК_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.id;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_РасформированиеАТК_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_РасформированиеАТК_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьСтатусРасформированияАТК;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_РасформированиеАТК_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовоеДействие = Неопределено;
		НовыйСтатус = СтатусыОпераций.СозданВСервисе;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		НовыйСтатус = СтатусыОпераций.ОтправленВАрхив;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Processing")
		Или НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПроверитьСтатусРасформированияАТК;
		НовыйСтатус = СтатусыОпераций.ОбрабатываетсяВГИС;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedSuccess") Тогда
		
		НовоеДействие = ТребуемыеДействия.РасформироватьАТКПослеРегистрации;
		НовыйСтатус = СтатусыОпераций.ОжиданиеГотовности;
		
	ИначеЕсли Задача_ФормированиеАТК_СтатусОшибка(СтатусДокумента) Тогда
		
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Sending")
		Или НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПроверитьСтатусРасформированияАТК;
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус расформирования АТК: %1'"), СтатусДокумента);
		
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_РасформированиеАТК_РасформироватьАТКПослеРегистрации(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	ДокументУчета = ЗначениеРеквизитаОбъекта_Марк(Операция, "ДокументУчета");
	ОбщийТипУпаковкиАТК = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.АТК;
	
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	ТаблицаКодов.ЗаполнитьЗначения(Истина, "УдалитьИзДокумента");
	
	ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьИнформациюИСтатусыКодов(ТаблицаКодов);
	ТаблицаКодов_ОбновитьСтатусы(ТаблицаКодов, Организация);
	
	Отбор = Новый Структура("КлючАгрегата");
	ОтборАТК = Новый Структура("ОбщийТипУпаковки", ОбщийТипУпаковкиАТК);
	Для каждого СтрАТК Из ТаблицаКодов.НайтиСтроки(ОтборАТК) Цикл
		Отбор.КлючАгрегата = СтрАТК.КлючКода;
		Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
			СтрКода.КлючСтрокиДокумента = СтрАТК.КлючСтрокиДокумента;
			СтрКода.КлючАгрегата = Неопределено;
			СтрКода.КодАгрегата = Неопределено;
		КонецЦикла;
	КонецЦикла;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		ТаблицаКодов_ЗаписатьИнформациюИСтатусыКодов(ТаблицаКодов);
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, Ложь);
			ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета);
		КонецЕсли;
		Задача_Завершить(ОписаниеЗадачи);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// #КонецОбласти // РасформированиеАТК

// #Область ТрансформацияАТК

Функция ОчередьОбмена_ТрансформацияАТК_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеТрансформациюАТК);
	Результат.Добавить(ТребуемыеДействия.ПолучитьКонтентДляПодписиТрансформацииАТК);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьСтатусТрансформацииАТК);
	Результат.Добавить(ТребуемыеДействия.ОбновитьСоставАТК);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_ТрансформацияАТК_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьВСервисеТрансформациюАТК Тогда
		Задача_ТрансформацияАТК_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьКонтентДляПодписиТрансформацииАТК Тогда
		Задача_ТрансформацияАТК_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_ТрансформацияАТК_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьСтатусТрансформацииАТК Тогда
		Задача_ТрансформацияАТК_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОбновитьСоставАТК Тогда
		Задача_ТрансформацияАТК_ОбновитьСоставАТК(ОписаниеЗадачи);
		
	Иначе
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ТрансформацияАТК_СоздатьВСервисе(ОписаниеЗадачи)
	
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	ИдентификаторСклада = ОписаниеОперации.Склад.Идентификатор;
	Контент = Контент_ТрансформацияАТК(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_ТрансформацияАТК_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьКонтентДляПодписиТрансформацииАТК;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ГотовКОтправкеВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_ТрансформацияАТК(Организация, ОписаниеОперации);
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_ТрансформацияАТК_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_ТрансформацияАТК_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.id;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ТрансформацияАТК_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_ТрансформацияАТК_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьСтатусТрансформацииАТК;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_ТрансформацияАТК_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовоеДействие = Неопределено;
		НовыйСтатус = СтатусыОпераций.СозданВСервисе;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		НовыйСтатус = СтатусыОпераций.ОтправленВАрхив;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Processing")
		Или НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПроверитьСтатусТрансформацииАТК;
		НовыйСтатус = СтатусыОпераций.ОбрабатываетсяВГИС;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedSuccess") Тогда
		
		НовоеДействие = ТребуемыеДействия.ОбновитьСоставАТК;
		НовыйСтатус = СтатусыОпераций.ОжиданиеГотовности;
		
	ИначеЕсли Задача_ТрансформацияАТК_СтатусОшибка(СтатусДокумента) Тогда
		
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Sending")
		Или НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПроверитьСтатусТрансформацииАТК;
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус трансформации АТК: %1'"), СтатусДокумента);
		
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ТрансформацияАТК_ОбновитьСоставАТК(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	КлючКодаАТК = Операция_КлючКода(Операция);
	КодАТК = КодМаркировки_НайтиПоКлючу(КлючКодаАТК);
	ВидПродукции = ЗначениеРеквизитаОбъекта_Марк(Операция, "ВидПродукции");
	
	Попытка
		ВложенныеКоды = Маркировка_ВложенныеКодыАгрегата(КодАТК, Организация, ВидПродукции);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	ТаблицаКодов.Добавить().КлючКода = КлючКодаАТК;
	ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	ТаблицаВложенныхКодов = ТаблицаКодов_ЗагрузитьКодыМаркировки(ВложенныеКоды);
	
	Если Не ТаблицаКодов_НормализоватьКоды(ТаблицаВложенныхКодов, Организация) Тогда
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, НСтр("ru = 'Не удалось нормализовать коды при обновлении состава АТК'"));
	КонецЕсли;
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаВложенныхКодов);
	
	ИндексКодМаркировки = ТаблицаКодов.Индексы.Добавить("КодМаркировки");
	Для каждого Стр Из ТаблицаВложенныхКодов Цикл
		СтрКода = ТаблицаКодов.Найти(Стр.КодМаркировки, "КодМаркировки");
		Если СтрКода = Неопределено Тогда
			СтрКода = ТаблицаКодов.Добавить();
			ЗаполнитьЗначенияСвойств(СтрКода, Стр);
		КонецЕсли;
		СтрКода.КлючАгрегата = КлючКодаАТК;
	КонецЦикла;
	ТаблицаКодов.Индексы.Удалить(ИндексКодМаркировки);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
		Задача_Завершить(ОписаниеЗадачи);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция Задача_ТрансформацияАТК_СтатусОшибка(Статус)
	
	Результат = НРег(Статус) = НРег("ProcessedError")
	Или НРег(Статус) = НРег("CrptProcessedError")
	Или НРег(Статус) = НРег("SendingError")
	Или НРег(Статус) = НРег("CrptSendingError");
	
	Возврат Результат;
	
КонецФункции

