// Получает описание новой версии из сервиса обновлений
//
// Параметры:
//  Контент - Структура - см. КонтентДляПроверкиОбновления()
// 
// Возвращаемое значение:
//  Структура - содержит:
//   * status- Строка - статус ответа;
//   * links- Массив - содержит ссылки на новую версию модуля и другой контент;
//   * description- Строка- описание новой версии;
//
Функция СервисОбновлений_ПроверитьОбновления(Контент, Продукт) Экспорт
	
	Результат = Мок_СервисОбновлений_ПроверитьОбновления(Контент, Продукт);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	СервисОбновлений_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	
	Запрос.Метод = "POST";
	Запрос.ПутьНаСервере = ПараметрыВСтроку("/1c/v3/%1/check", Продукт);
	Запрос.ТелоЗапроса = ЗначениеВСтрокуJSON(Контент);
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	
	Результат = Неопределено;
	Если Ответ.КодОтвета = КодОтвета_Успешно() Тогда
		Результат = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает список версий, начиная с указанной в параметрах
//
// Параметры:
//  ТекущаяВерсия - Строка - старшая версия продукта
//  Продукт - Строка - старшая версия продукта
// 
// Возвращаемое значение:
//  Структура - содержит:
//   * status- Строка - статус ответа;
//   * links- Массив - содержит ссылки на новую версию модуля и другой контент;
//   * description- Строка- описание новой версии;
//
Функция СервисОбновлений_СписокВерсий(ТекущаяВерсия, Продукт) Экспорт
	
	Результат = Мок_СервисОбновлений_СписокВерсий(ТекущаяВерсия, Продукт);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	СервисОбновлений_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	
	Запрос.Метод = "GET";
	Запрос.ПутьНаСервере = ПараметрыВСтроку("/1c/v4/products/%1/versions", Продукт);
	Запрос.Параметры.Вставить("from_version", ТекущаяВерсия);
	Запрос.Параметры.Вставить("order", "desc");
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	
	Результат = Неопределено;
	Если Ответ.КодОтвета = 200 Тогда
		Результат = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает описание версии продукта
//
// Параметры:
//  Продукт - Строка - имя продукта в сервисе обновлений;
//  Версия - Строка - версия продукта, которую необходимо получить;
// 
// Возвращаемое значение:
//  Структура - содержит:
//  * version - Строка - версия;
//  * description- Строка - описание;
//  * release_date- Строка- дата публикации;
//  * content - Соответствие - содержит:
//  ** name - Строка - тип контента;
//  ** filename - Строка - имя файла;
//  ** md5hash - Строка - MD5 хэш;
//  ** src_checksum - Строка - контрольная сумма исходников;
//  ** drive_public_link - Строка - публичная ссылка для скачивания;
//
Функция СервисОбновлений_ОписаниеВерсииПродукта(Продукт, Версия) Экспорт
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	СервисОбновлений_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	
	Запрос.Метод = "GET";
	Запрос.ПутьНаСервере = ПараметрыВСтроку("/1c/v4/products/%1/versions/%2", Продукт, Версия);
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	
	Результат = Неопределено;
	Если Ответ.КодОтвета = 200 Тогда
		Результат = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Заполняет в описании запроса HTTP параметры сервиса и настройки прокси
//
// Параметры:
//  ОписаниеЗапроса - Структура - см. Новый_ОписаниеЗапросаHTTP()
//
Процедура СервисОбновлений_ЗаполнитьОбщиеНастройкиHTTP(ОписаниеЗапроса)
	
	ОписаниеСервиса = СервисОбновлений_ОписаниеСервиса();
	ЗаполнитьЗначенияСвойств(ОписаниеЗапроса, ОписаниеСервиса);
	
	UserAgent = ПараметрыВСтроку("Kontur.Mark 1C %1 (%2)"
								, ВерсияОбработки()
								, ВариантРасположенияМодуляДляUserAgent());
	
	ОписаниеЗапроса.Заголовки.Вставить("Accept", "application/json");
	ОписаниеЗапроса.Заголовки.Вставить("Content-Type", "application/json;charset=utf-8");
	ОписаниеЗапроса.Заголовки.Вставить("User-Agent", UserAgent);
	
	ЗаполнитьНастройкиПроксиСервера(ОписаниеЗапроса);
	
КонецПроцедуры

