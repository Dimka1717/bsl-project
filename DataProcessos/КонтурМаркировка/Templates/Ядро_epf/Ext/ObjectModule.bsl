Функция УстаревшиеОперацииСКодами(АктуальнаяДатаХранения)
	
	ТипыСтатусов = Перечисление_ТипыСтатусов();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Операция КАК Операция
	|ПОМЕСТИТЬ ОперацииСКодами
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КоличествоКодовОпераций КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Операция
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОперацииСКодами.Операция КАК Операция
	|ИЗ
	|	ОперацииСКодами КАК ОперацииСКодами
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК СтатусыОпераций
	|		ПО ОперацииСКодами.Операция = СтатусыОпераций.Операция
	|			И (СтатусыОпераций.ТипСтатуса = &ТипСтатусаОсновнойСтатус)
	|ГДЕ
	|	СтатусыОпераций.Статус В(&ЗавершенныеСтатусы)
	|	И СтатусыОпераций.ДатаСтатуса < &АктуальнаяДатаХранения");
	
	Запрос.УстановитьПараметр("ТипСтатусаОсновнойСтатус", ТипыСтатусов.ОсновнойСтатус);
	Запрос.УстановитьПараметр("АктуальнаяДатаХранения", АктуальнаяДатаХранения);
	Запрос.УстановитьПараметр("ЗавершенныеСтатусы", ЗавершенныеСтатусыОпераций());
	
	Возврат МассивИзРезультатаЗапроса(Запрос, "Операция");
	
КонецФункции

