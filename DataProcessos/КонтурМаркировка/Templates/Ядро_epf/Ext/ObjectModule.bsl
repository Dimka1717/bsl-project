Процедура Операция_СоздатьРегистрациюСтрокиУведомленияОСостоянииКодов(ОписаниеОснования, СтрокаТоваров)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ОписаниеОперации = Новый_Операция();
		ОписаниеОперации.ТипОперации = Перечисление_ТипыОпераций().РегистрацияСтрокиУведомленияОСостоянииКодов;
		ОписаниеОперации.КлючСтрокиОперацииОснования = СтрокаТоваров.КлючСтрокиОперации;
		ОписаниеОперации.ОперацияОснование = ОписаниеОснования.Ссылка;
		ЗаполнитьЗначенияСвойств(ОписаниеОперации, ОписаниеОснования, "ДокументУчета, Организация, Склад, ВидПродукции");
		
		Операция = Операция_Записать(ОписаниеОперации);
		
		Задача_Создать(Операция);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Присваивает объекту операции код с префиксом номера года
// и префиксом информационной базы
//
// Параметры:
//  ОперацияОбъект - СправочникОбъект.КонтурМаркировка_Операции
//
Процедура Операция_УстановитьНовыйКод(ОбъектОперации)
	
	ОбъектОперации.УстановитьНовыйКод(ПрефиксНомера(ОбъектОперации.Дата));
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТовары(ОбъектОперации, ОписаниеОперации)
	
	Операция_ДополнитьТовары(ОписаниеОперации.Товары);
	
	ВсеКолонкиТоваров = ОписаниеОперации.Товары.Колонки;
	КолонкиТЧ = ОбъектОперации.Товары.ВыгрузитьКолонки().Колонки;
	
	ОбъектОперации.Товары.Очистить();
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		
		Если Не ЗначениеЗаполнено(Стр.КлючСтрокиОперации) Тогда
			Стр.КлючСтрокиОперации = Новый УникальныйИдентификатор;
		КонецЕсли;
		
		СтрТовара = ОбъектОперации.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрТовара, Стр);
		
		ДопРеквизитыИБ = Новый Структура;
		Для Каждого Колонка Из ВсеКолонкиТоваров Цикл
			ИмяКолонки = Колонка.Имя;
			ЗначениеВКолонке = Стр[ИмяКолонки];
			Если КолонкиТЧ.Найти(ИмяКолонки) = Неопределено Тогда
				ДобавитьЗаполненноеЗначениеВСтруктуру(ДопРеквизитыИБ, ИмяКолонки, ЗначениеВКолонке);
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ДопРеквизитыИБ) Тогда
			СтрТовара.ДопРеквизиты = ЗначениеВХранилище(ДопРеквизитыИБ);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ДополнитьТовары(Товары)
	
	Если Не ЗначениеЗаполнено(Товары) Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоСтрок = Товары.Количество();
	ЕстьНомераСтрок = ЗначениеЗаполнено(Товары[0].НомерСтроки);
	КэшКлючаНоменклатуры = Новый Соответствие;
	
	Для Сч = 1 По КоличествоСтрок Цикл
		
		Стр = Товары[Сч - 1];
		
		Если Не ЕстьНомераСтрок Тогда
			Стр.НомерСтроки = Сч;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.КлючНоменклатуры1С) Тогда
			Стр.КлючНоменклатуры1С = КлючНоменклатуры1С_Подобрать(Стр, КэшКлючаНоменклатуры);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// #Область Чтение

// Читает операцию и связанные с ней данные из базы
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция, которую нужно прочитать;
// 
// Возвращаемое значение:
//  Структура - см. Новый_Операция()
//
Функция Операция_ПрочитатьОперацию(Операция) Экспорт
	
	Результат = Новый_Операция();
	
	ОбъектОперации = Операция.ПолучитьОбъект();
	Если ОбъектОперации = Неопределено Тогда
		Возврат Результат; // Битая ссылка
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Результат, ОбъектОперации, , "Товары");
	Результат.Ссылка = Операция;
	Результат.Номер = ОбъектОперации.Код;
	
	Операция_ПрочитатьТовары(Результат, ОбъектОперации);
	Операция_ПрочитатьСтатусы(Результат);
	Операция_ПрочитатьДопРеквизиты(Результат);
	
	Замер_МаксКодовВОперации_Поместить(Результат);
	
	Возврат Результат;
	
КонецФункции

// Заполняет доп реквизиты операции из регистров
//
// Параметры:
//  Операция - Структура - см. Новый_Операция()
// 
Процедура Операция_ПрочитатьДопРеквизиты(ОписаниеОперации)
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ДопРеквизитыИБ = ДопРеквизиты_Прочитать(ОписаниеОперации.Ссылка);
	
	Если ЗначениеЗаполнено(ДопРеквизитыИБ) Тогда
		ЗаполнитьЗначенияСвойств(ДопРеквизиты, ДопРеквизитыИБ);
	КонецЕсли;
	
КонецПроцедуры

// Безопасно читает статусы операции
//
// Параметры:
//  Операция - Структура - см. Новый_Операция()
// 
Процедура Операция_ПрочитатьСтатусы(Операция)
	
	СтатусыИБ = СтатусыОперации_Прочитать(Операция.Ссылка);
	
	ЗаполнитьЗначенияСвойств(Операция.Статусы, СтатусыИБ);
	
КонецПроцедуры

// Заполняет таб часть товары из справочника
//
// Параметры:
//  ОписаниеОперации - Структура - см. Новый_Операция();
//  ОбъектОперации - СправочникОбъект.КонтурМаркировка_Операции - объект операции;
//
Процедура Операция_ПрочитатьТовары(ОписаниеОперации, ОбъектОперации)
	
	ОписаниеОперации.Товары.Очистить();
	КэшАналитики = Новый Соответствие;
	
	Для Каждого СтрТов Из ОбъектОперации.Товары Цикл
		
		Стр = ОписаниеОперации.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, СтрТов);
		
		ДопРеквизиты = СтрТов.ДопРеквизиты.Получить();
		Если ЗначениеЗаполнено(ДопРеквизиты) Тогда
			ЗаполнитьЗначенияСвойств(Стр, ДопРеквизиты);
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Стр, АналитикаНоменклатуры1С(Стр.КлючНоменклатуры1С, КэшАналитики));
		
	КонецЦикла;
	
	ОписаниеОперации.Товары.Сортировать("НомерСтроки");
	
КонецПроцедуры

