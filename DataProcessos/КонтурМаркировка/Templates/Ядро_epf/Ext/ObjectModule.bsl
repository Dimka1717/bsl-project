// Обрабатывает новые события ленты по организации
//
// Параметры:
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация
// 
// Возвращаемое значение:
//  Булево - Истина, если в ленте были обработаны новые события
//
Функция Лента_ОбработатьНовыеСобытия(Организация)
		
	ТипыСобытий = Перечисление_ТипыСобытийЛенты();
	НастройкиЛенты = НастройкиЧтенияЛенты(Организация);
	НачальнаяГраница = ГраницаЧтенияЛенты(Организация);
	
	СобытияЛенты = Новый Массив;
	ТекущаяГраница = НачальнаяГраница;
	ПолучитьНовыеСобытия = Истина;
	
	Пока ПолучитьНовыеСобытия Цикл
		
		Попытка
			ПорцияСобытий = Маркировка_Лента_НовыеСобытия(Организация, ТекущаяГраница);
		Исключение
			Ошибка = ИнформацияОбОшибке();
			Лента_ОбработатьОшибку_ПолучениеСобытий(Ошибка, Организация);
			Возврат Ложь;
		КонецПопытки;
		
		Если ЗначениеЗаполнено(ПорцияСобытий) Тогда
			ДополнитьМассив(СобытияЛенты, ПорцияСобытий);
			ТекущаяГраница = ПорцияСобытий[ПорцияСобытий.ВГраница()].eventId;
		Иначе
			ПолучитьНовыеСобытия = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(СобытияЛенты) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Лента_СвернутьСобытия(СобытияЛенты);
	
	Отказ = Ложь;
	РазмерПорции = 500;
	ОбработаныНовыеСобытия = Ложь;
	ТекущаяГраница = НачальнаяГраница;
	ТипыБизнесПроцессов = Перечисление_ТипыБизнесПроцессовЛенты();
	
	ПроцессыАгрегации = Новый Массив;
	ПроцессыАгрегации.Добавить(ТипыБизнесПроцессов.ТранспортныеАгрегаты);
	ПроцессыАгрегации.Добавить(ТипыБизнесПроцессов.РасформированиеАгрегатов);
	ПроцессыАгрегации.Добавить(ТипыБизнесПроцессов.ФормированиеНаборов);
	
	ПодходящиеБП = Новый Массив;
	ПодходящиеБП.Добавить(ТипыБизнесПроцессов.Сверка);
	ПодходящиеБП.Добавить(ТипыБизнесПроцессов.УведомлениеОПриемке);
	ПодходящиеБП.Добавить(ТипыБизнесПроцессов.УведомлениеОСостоянииКодов);
	ДополнитьМассив(ПодходящиеБП, ПроцессыАгрегации);
	
	СтатусыНовыйДокумент = Новый Массив;
	СтатусыНовыйДокумент.Добавить("draft");
	СтатусыНовыйДокумент.Добавить("created");
	
	Для Каждого ЧастьСобытий Из РазбитьМассив(СобытияЛенты, РазмерПорции) Цикл
		
		Для Каждого СобытиеЛенты Из ЧастьСобытий Цикл
			
			ОписаниеСобытия = Новый_ОписаниеСобытияЛенты(СобытиеЛенты);
			
			Если ОписаниеСобытия.ТипСобытия <> ТипыСобытий.ИзменениеСтатусаДокумента
				Или Не МассивСодержитЗначение(ПодходящиеБП, ОписаниеСобытия.ТипБизнесПроцесса) Тогда
				ТекущаяГраница = ОписаниеСобытия.ИдентификаторСобытия;
				Продолжить;
			КонецЕсли;
			
			Если МассивСодержитЗначение(ПроцессыАгрегации, ОписаниеСобытия.ТипБизнесПроцесса)
				И МассивСодержитЗначение(СтатусыНовыйДокумент, ОписаниеСобытия.СтатусДокумента) Тогда
				ТекущаяГраница = ОписаниеСобытия.ИдентификаторСобытия;
				Продолжить;
			КонецЕсли;
			
			Попытка
				
				Лента_ОбработатьСобытие(Организация, ОписаниеСобытия, НастройкиЛенты, Отказ);
				
				Если Отказ Тогда
					Прервать;
				КонецЕсли;
				
				ТекущаяГраница = ОписаниеСобытия.ИдентификаторСобытия;
				ОбработаныНовыеСобытия = Истина;
				
			Исключение
				
				Ошибка = ИнформацияОбОшибке();
				
				ИдентификаторСобытия = ОписаниеСобытия.ИдентификаторСобытия;
				ИдентификаторСобытияОшибкиЛенты = ИдентификаторСобытияОшибкиЛенты(Организация);
				
				ПоказыватьСообщение = Ложь;
				Если Не ЗначениеЗаполнено(ИдентификаторСобытияОшибкиЛенты) Тогда
					ИдентификаторСобытияОшибкиЛенты_Записать(Организация, ИдентификаторСобытия);
					ГраницаОшибкиЧтенияЛенты_Записать(Организация, ТекущаяГраница);
					ПоказыватьСообщение = Истина;
				КонецЕсли;
				
				Лента_ОбработатьОшибку_ОбработкаСобытия(Ошибка, СобытиеЛенты, Организация, ПоказыватьСообщение);
				
			КонецПопытки;
			
		КонецЦикла;
		
		ГраницаЧтенияЛенты_Записать(Организация, ТекущаяГраница);
		
		Если Отказ Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОбработаныНовыеСобытия;
	
КонецФункции

Процедура Лента_ОбработатьСобытие(Организация, ОписаниеСобытия, НастройкиЛенты, Отказ)
	
	ТипыБизнесПроцессов = Перечисление_ТипыБизнесПроцессовЛенты();
	
	Если ОписаниеСобытия.ТипБизнесПроцесса = ТипыБизнесПроцессов.ТранспортныеАгрегаты Тогда
		Лента_ОбработатьСобытие_ТранспортныеАгрегаты(Организация, ОписаниеСобытия, Отказ);
	КонецЕсли;
	
	Если ОписаниеСобытия.ТипБизнесПроцесса = ТипыБизнесПроцессов.РасформированиеАгрегатов Тогда
		Лента_ОбработатьСобытие_РасформированиеАгрегатов(Организация, ОписаниеСобытия, Отказ);
	КонецЕсли;
	
	Если ОписаниеСобытия.ТипБизнесПроцесса = ТипыБизнесПроцессов.ФормированиеНаборов Тогда
		Лента_ОбработатьОчередьОбмена(Организация, ОписаниеСобытия, Отказ);
	КонецЕсли;
	
	Если ОписаниеСобытия.ТипБизнесПроцесса = ТипыБизнесПроцессов.УведомлениеОСостоянииКодов Тогда
		Лента_ОбработатьОчередьОбмена(Организация, ОписаниеСобытия, Отказ);
	КонецЕсли;
	
	Если Не НастройкиЛенты.ОтключитьУведомленияОПриемке
		И ОписаниеСобытия.ТипБизнесПроцесса = ТипыБизнесПроцессов.УведомлениеОПриемке Тогда
		Лента_ОбработатьСобытие_УведомлениеОПриемке(Организация, ОписаниеСобытия, Отказ);
	КонецЕсли;
	
	Если Не НастройкиЛенты.ОтключитьВходящиеУПД
		И ОписаниеСобытия.ТипБизнесПроцесса = ТипыБизнесПроцессов.Сверка Тогда
		Лента_ОбработатьСобытие_ВходящийУПД(Организация, ОписаниеСобытия, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура Лента_ОбработатьСобытие_ТранспортныеАгрегаты(Организация, ОписаниеСобытия, Отказ)
	
	ОписаниеСобытия.Объект = ОчередьОбмена_НайтиОперациюПоИдентификаторуДокумента(ОписаниеСобытия.ИдентификаторДокумента);
	Если Не ЗначениеЗаполнено(ОписаниеСобытия.Объект)
		Или Не ОчередьОбмена_ОперациюМожноОбработатьВЭтомУзлеРИБ(ОписаниеСобытия.Объект)
		Или Лента_СобытиеОбработано(ОписаниеСобытия) Тогда
		Возврат;
	КонецЕсли;
	
	Действия = Перечисление_ТребуемыеДействия();
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	ТипОперации = ЗначениеРеквизитаОбъекта_Марк(ОписаниеСобытия.Объект, "ТипОперации");
	
	Если ТипОперации = ТипыОпераций.НаполнениеОдногоАгрегатаНаТСД Тогда
		ОписаниеЗадачи = Задача_Прочитать(ОписаниеСобытия.Объект);
		Если ОписаниеЗадачи.ТребуемоеДействие = Действия.ОперацияЗавершена Тогда
			ОписаниеЗадачи.ТребуемоеДействие = Действия.ПолучитьРезультатНаполненияАгрегатаНаТСД;
			Задача_Записать(ОписаниеЗадачи);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Лента_ОбработатьОчередьОбмена(Организация, ОписаниеСобытия, Отказ);
	
КонецПроцедуры

Процедура Лента_ОбработатьСобытие_РасформированиеАгрегатов(Организация, ОписаниеСобытия, Отказ)
	
	ОписаниеСобытия.Объект = ОчередьОбмена_НайтиОперациюПоИдентификаторуДокумента(ОписаниеСобытия.ИдентификаторДокумента);
	
	Если ЗначениеЗаполнено(ОписаниеСобытия.Объект) Тогда
		
		Лента_ОбработатьОчередьОбмена(Организация, ОписаниеСобытия, Отказ);
		
	Иначе
		
		Если НРег(ОписаниеСобытия.СтатусДокумента) = НРег("CrptProcessedSuccess") Тогда
			
			Если Не НастройкиМодуля().РежимРИБ Или ЭтоГлавныйУзелРИБ() Тогда
				ОписаниеСобытия.Объект = Лента_РасформироватьАгрегат(Организация, ОписаниеСобытия);
			КонецЕсли;
			Если ЗначениеЗаполнено(ОписаниеСобытия.Объект) Тогда
				Лента_Записать(ОписаниеСобытия);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Лента_ОбработатьСобытие_УведомлениеОПриемке(Организация, ОписаниеСобытия, Отказ)
	
	Если Лента_СобытиеОбработано(ОписаниеСобытия) Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ТипОперации = Перечисление_ТипыОпераций().УведомлениеОПриемке;
		ИдентификаторДокумента = ОписаниеСобытия.ИдентификаторДокумента;
		
		Операция = Операция_НайтиПоДопРеквизиту(ТипОперации, "ИдентификаторДокумента", ИдентификаторДокумента);
		Если ЗначениеЗаполнено(Операция) Тогда
			ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
		Иначе
			ОписаниеОперации = Новый_Операция();
			ОписаниеОперации.Организация = Организация;
			ОписаниеОперации.ТипОперации = ТипОперации;
			ОписаниеОперации.ДопРеквизиты.ИдентификаторДокумента = ИдентификаторДокумента;
		КонецЕсли;
		
		Контент = Операция_УведомлениеОПриемке_КонтентДокумента(ОписаниеОперации);
		Операция_УведомлениеОПриемке_ЗаполнитьПоКонтенту(ОписаниеОперации, Контент);
		Операция = Операция_Записать(ОписаниеОперации);
		ОписаниеСобытия.Объект = Операция;
		
		СведенияОТоварах = Операция_УведомлениеОПриемке_СведенияОТоварахИзКонтента(Контент, ОписаниеОперации);
		Операция_УведомлениеОПриемке_СведенияОТоварах_СохранитьВФайл(Операция, СведенияОТоварах);
		
		ДатаСтатуса = ДатаИзОтметкиВремениВСекундах(Контент.updatedDate);
		СтатусОперации = СтатусУведомленияОПриемкеПоСтатусуИзСервиса(Контент.documentStatus);
		СтатусыОперации_ЗаписатьОсновнойСтатус(Операция, СтатусОперации, ДатаСтатуса);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Создание операции уведомление о приемке'");
		ТекстСообщения = НСтр("ru = 'Не удалось создать операцию уведомление о приемке'");
		ДопИнформация = Новый Структура;
		ДопИнформация.Вставить("Организация", Организация);
		ДопИнформация.Вставить("ИдентификаторДокумента", ИдентификаторДокумента);
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация, ТекстСообщения);
		
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ОписаниеСобытия.Объект) Тогда
		Лента_Записать(ОписаниеСобытия);
	КонецЕсли;
	
КонецПроцедуры

Процедура Лента_ОбработатьСобытие_ВходящийУПД(Организация, ОписаниеСобытия, Отказ)
	
	Если Лента_СобытиеОбработано(ОписаниеСобытия) Тогда
		Возврат;
	КонецЕсли;
	
	ТипОперации = Перечисление_ТипыОпераций().ВходящийУПД;
	ИдентификаторДокумента = ОписаниеСобытия.ИдентификаторДокумента;
	
	ОписаниеЗадачи = Новый_ЗадачаОбмена();
	ОписаниеЗадачи.Вставить("ИдентификаторДокумента", ИдентификаторДокумента);
	ОписаниеЗадачи.Вставить("Организация", Организация);
	ОписаниеЗадачи.Вставить("Склад", Склад_НайтиПоИдентификатору(ОписаниеСобытия.ИдентификаторСклада));
	ОписаниеЗадачи.Вставить("Операция", Операция_НайтиПоДопРеквизиту(ТипОперации, "ИдентификаторДокумента", ИдентификаторДокумента));
	
	Попытка
		Контент = Маркировка_ВходящийУПД_КонтентДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Получение контента входящего УПД'");
		ТекстСообщения = НСтр("ru = 'Не удалось получить из сервиса контент входящего УПД'");
		ДопИнформация = Новый Структура;
		ДопИнформация.Вставить("Организация", Организация);
		ДопИнформация.Вставить("ИдентификаторДокумента", ИдентификаторДокумента);
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация, ТекстСообщения);
		Возврат;
	КонецПопытки;
	
	Если Операция_ВходящийУПД_ЕстьКоды(Контент) Тогда
		ОписаниеСобытия.Объект = Операция_ВходящийУПД_Сохранить(Контент, Организация);
	Иначе
		ОписаниеСобытия.Объект = Операция_НайтиПоДопРеквизиту(ТипОперации, "ИдентификаторДокумента", ИдентификаторДокумента);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеСобытия.Объект) Тогда
		Лента_Записать(ОписаниеСобытия);
	КонецЕсли;
	
КонецПроцедуры

Процедура Лента_ОбработатьОчередьОбмена(Организация, ОписаниеСобытия, Отказ)
	
	Если Не ЗначениеЗаполнено(ОписаниеСобытия.Объект) Тогда
		ОписаниеСобытия.Объект = ОчередьОбмена_НайтиОперациюПоИдентификаторуДокумента(ОписаниеСобытия.ИдентификаторДокумента);
		Если Не ЗначениеЗаполнено(ОписаниеСобытия.Объект) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если Лента_СобытиеОбработано(ОписаниеСобытия) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ОчередьОбмена_ОперациюМожноОбработатьВЭтомУзлеРИБ(ОписаниеСобытия.Объект) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ОчередьОбмена_ЗанятьОперациюДляОбмена(ОписаниеСобытия.Объект) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Попытка
		Лента_ОбработатьЗадачу(Задача_Прочитать(ОписаниеСобытия.Объект));
	Исключение
		ОчередьОбмена_ОсвободитьОперациюПослеОбмена();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	ОчередьОбмена_ОсвободитьОперациюПослеОбмена();
	
	Лента_Записать(ОписаниеСобытия);
	
КонецПроцедуры

Процедура Лента_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.ПроверитьСтатусФормированияНаборов
		Или Действие = Действия.ПроверитьГотовностьНаполненияНаборовНаТСД Тогда
		Задача_ФормированиеНаборов_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьГотовностьАгрегата Тогда
		Задача_Агрегация_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьГотовностьРасформированияАгрегата Тогда
		Задача_Разагрегация_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьГотовностьНаполненияАгрегатаНаТСД Тогда
		Задача_НаполнениеАгрегатовНаТСД_ПроверитьГотовность(ОписаниеЗадачи);
	
	ИначеЕсли Действие = Действия.ПроверитьГотовностьУведомленияОСостоянииКодов Тогда
		Задача_УведомлениеОСостоянииКодов_ПроверитьСтатус(ОписаниеЗадачи);
		
	Иначе
		
		// Обработка не требуется
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Лента_СвернутьСобытия(СобытияЛенты)
	
	ИзменениеСтатусаДокумента = Новый Соответствие;
	
	ТипыСобытий = Перечисление_ТипыСобытийЛенты();
	
	Сч = СобытияЛенты.ВГраница();
	Пока Сч >= 0 Цикл
		
		СобытиеЛенты = СобытияЛенты[Сч];
		Если СобытиеЛенты.eventType = ТипыСобытий.ИзменениеСтатусаДокумента Тогда
			
			Если ИзменениеСтатусаДокумента[СобытиеЛенты.data.documentId] = Неопределено Тогда
				ИзменениеСтатусаДокумента.Вставить(СобытиеЛенты.data.documentId, Истина);
			Иначе
				СобытияЛенты.Удалить(Сч);
			КонецЕсли;
			
		КонецЕсли;
		
		Сч = Сч - 1;
		
	КонецЦикла;
	
КонецПроцедуры

Функция Лента_РасформироватьАгрегат(Организация, ОписаниеСобытия)
	
	Если Лента_СобытиеОбработано(ОписаниеСобытия) Тогда
		Возврат Лента_НайтиОбъектПоИдентификаторуДокумента(ОписаниеСобытия);
	КонецЕсли;
	
	ОписаниеЗадачи = Новый_ЗадачаОбмена();
	ОписаниеЗадачи.Вставить("ИдентификаторДокумента", ОписаниеСобытия.ИдентификаторДокумента);
	ОписаниеЗадачи.Вставить("Организация", Организация);
	ОписаниеЗадачи.Вставить("Склад", Склад_НайтиПоИдентификатору(ОписаниеСобытия.ИдентификаторСклада));
	ОписаниеЗадачи.Вставить("Операция", ОчередьОбмена_НайтиОперациюПоИдентификаторуДокумента(ОписаниеСобытия.ИдентификаторДокумента));
	
	Попытка
		Ответ = Маркировка_Разагрегация_ДокументРазагрегации(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Лента_ОбработатьОшибку_РасформированиеАгрегатов_ПолучениеДокументаРасформированияАгрегата(Ошибка, ОписаниеСобытия, Организация);
		ВызватьИсключение;
	КонецПопытки;
	
	КлючАгрегата = КодМаркировки_НайтиКлюч(Ответ.aggregateCode);
	Если Не ЗначениеЗаполнено(КлючАгрегата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Операция = Операция_НайтиПоДопРеквизиту(Перечисление_ТипыОпераций().РасформированиеАгрегатаВГИС, "КлючКода", КлючАгрегата);
	Если Операция = Неопределено Тогда
		ОписаниеОперации = Новый_Операция();
		ОписаниеОперации.ТипОперации = Перечисление_ТипыОпераций().РасформированиеАгрегатаВГИС;
		ОписаниеОперации.ДопРеквизиты.КлючКода = КлючАгрегата;
		ОписаниеОперации.Организация = Организация;
		Операция = Операция_Записать(ОписаниеОперации);
		СтатусыОперации_ЗаписатьОсновнойСтатус(Операция, Перечисление_СтатусыОпераций().ОперацияЗавершена);
	КонецЕсли;
	
	КодМаркировки_РасформироватьАгрегат(КлючАгрегата);
	
	Возврат Операция;
	
КонецФункции

Функция Лента_СобытиеОбработано(ОписаниеСобытия)
	
	Объект = ОписаниеСобытия.Объект;
	ИдентификаторСобытия = ОписаниеСобытия.ИдентификаторСобытия;
	ИдентификаторДокумента = ОписаниеСобытия.ИдентификаторДокумента;
	
	Если Не ЗначениеЗаполнено(Объект)
		И Не ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ЛентаСобытий КАК Т
	|ГДЕ
	|	&Объект
	|	И &ИдентификаторДокумента
	|	И Т.ИдентификаторСобытия >= &ИдентификаторСобытия";
	
	Если ЗначениеЗаполнено(Объект) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Объект", "Т.Объект = &Объект");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Объект", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИдентификаторДокумента", "Т.ИдентификаторДокумента = &ИдентификаторДокумента");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИдентификаторДокумента", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("ИдентификаторСобытия", ИдентификаторСобытия);
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция Лента_НайтиОбъектПоИдентификаторуДокумента(ИдентификаторДокумента)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ЛентаСобытий КАК Т
	|ГДЕ
	|	Т.ИдентификаторДокумента = &ИдентификаторДокумента");
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "Объект");
	
КонецФункции

Процедура Лента_Записать(ОписаниеСобытия)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Запись = РегистрыСведений.КонтурМаркировка_ЛентаСобытий.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, ОписаниеСобытия);
		Запись.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура Лента_Удалить(Объект)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Лента_Заблокировать(Объект);
		
		Набор = РегистрыСведений.КонтурМаркировка_ЛентаСобытий.СоздатьНаборЗаписей();
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Отбор.Объект.Установить(Объект);
		Набор.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура Лента_Заблокировать(Операция)
	
	Объект = "РегистрСведений.КонтурМаркировка_ЛентаСобытий";
	Значения = Новый Структура("Объект", Операция);
	ЗаблокироватьПоЗначениям(Объект, Значения);
	
КонецПроцедуры

// Настройки чтения ленты
//
// Параметры:
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
// 
// Возвращаемое значение:
//  Структура - см. тело метода;
//
Функция НастройкиЧтенияЛенты(Организация)
	
	СервисыПодписок = Перечисление_СервисыПодписок();
	ДопРеквизиты = Организация_Прочитать(Организация).ДопРеквизиты;
	ПриемкаДоступна = СервисДоступенПоТарифу(СервисыПодписок.Приемка, Тариф(Организация));
	
	Результат = Новый Структура;
	Результат.Вставить("ОтключитьВходящиеУПД", Не ПриемкаДоступна Или ДопРеквизиты.ОтключитьЧтениеВходящихУПД);
	Результат.Вставить("ОтключитьУведомленияОПриемке", Не ПриемкаДоступна Или ДопРеквизиты.ОтключитьЧтениеУведомленийОПриемке);
	
	Возврат Результат;
	
КонецФункции

// Возвращает описание события ленты
//
// Параметры:
//  СобытиеЛенты - Структура - см ApiEvent https://marking-api.testkontur.ru/api/swagger/index.html
// 
// Возвращаемое значение:
//  Структура - описание события ленты:
//   * Объект - СправочникСсылка.КонтурМаркировка_Операции, СправочникСсылка.КонтурМаркировка_КодыУпаковок - объект с которым связано событие
//   * ИдентификаторСобытия - Строка - идентификатор события
//   * ТипСобытия - Строка - тип события
//   * ИдентификаторДокумента - Строка - идентификатор документа
//   * СтатусДокумента - Строка - новый статус документа
//   * ИдентификаторСклада - Строка - идентификатор склада
//   * ТипБизнесПроцесса - Строка - тип бизнес процесса
//
Функция Новый_ОписаниеСобытияЛенты(СобытиеЛенты = Неопределено)
	
	Ключи = "Объект, ИдентификаторДокумента, СтатусДокумента,
	|ТипСобытия, ТипБизнесПроцесса, ИдентификаторСобытия,
	|ИдентификаторСклада";
	
	Результат = Новый Структура(Ключи);
	
	Если ЗначениеЗаполнено(СобытиеЛенты) Тогда
		
		Результат.ИдентификаторСобытия = СобытиеЛенты.eventId;
		Результат.ТипСобытия = СобытиеЛенты.eventType;
		
		ТипыСобытий = Перечисление_ТипыСобытийЛенты();
		Если СобытиеЛенты.eventType = ТипыСобытий.ИзменениеСтатусаДокумента Тогда
			СобытиеЛенты.data.Свойство("documentId", Результат.ИдентификаторДокумента);
			СобытиеЛенты.data.Свойство("newStatus", Результат.СтатусДокумента);
			СобытиеЛенты.data.Свойство("warehouseId", Результат.ИдентификаторСклада);
			СобытиеЛенты.data.Свойство("workflowType", Результат.ТипБизнесПроцесса);
		КонецЕсли;
		
	КонецЕсли;
	
	Результат.СтатусДокумента = НРег(Результат.СтатусДокумента);
	
	Возврат Результат;
	
КонецФункции

