// Возвращает значение в хранилище с максимальным сжатием
//
// Параметры:
//  Значение - Произвольный - значение
//
// Возвращаемое значение:
//  ХранилищеЗначения
Функция ЗначениеВХранилище(Значение) Экспорт
	
	Если ТипЗнч(Значение) = Тип("ХранилищеЗначения") Тогда
		Результат = Значение;
	Иначе
		Результат = Новый ХранилищеЗначения(Значение, Новый СжатиеДанных(9));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение в массиве
//
// Параметры:
//  Значение - Произвольный - значение
//
// Возвращаемое значение:
//  Массив
Функция ЗначениеВМассиве(Значение)
	
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Значение;
	Иначе
		Результат = Новый Массив;
		Результат.Добавить(Значение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Безопасно получает значение из массива по его индексу
//
// Параметры:
//  Массив              - Массив       - массив, из которого нужно получить значение
//  ИндексЗначения      - Число        - индекс значения
//  ЗначениеПоУмолчанию - Произвольный - значение, которое нужно вернуть
//                                       если указанный индекс выходит за границу массива
// 
// Возвращаемое значение:
//  Произвольный - значение из массива. ЗначениеПоУмолчанию если индекс выходит за границы массива
//
Функция ЗначениеИзМассива(Массив, ИндексЗначения, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Результат = ЗначениеПоУмолчанию;
	
	Если ИндексЗначения <= Массив.ВГраница() Тогда
		Результат = Массив[ИндексЗначения];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Дополняет массив значениями из другого массива
//
// Параметры:
//  МассивПриемник - Массив - массив, в который необходимо добавить значения;
//  МассивИсточник - Массив - массив, из которого нужно взять значения;
//  ТолькоНовыеЗначения - Булево - (необязательный) Истина, если в приемник нужно добавить только новые значения;
//  ДобавлятьПустыеЗначения - Булево - (необязательный) Ложь, если пустые значения в приемник добавлять не нужно;
//
Процедура ДополнитьМассив(МассивПриемник, МассивИсточник, ТолькоНовыеЗначения = Ложь, ДобавлятьПустыеЗначения = Истина) Экспорт
	
	Если ТолькоНовыеЗначения Тогда
		
		ЗначенияПриемника = Новый Соответствие;
		Для Каждого Значение Из МассивПриемник Цикл
			ЗначенияПриемника.Вставить(Значение, Истина);
		КонецЦикла;
		
		Для Каждого Значение Из МассивИсточник Цикл
			Если Не ДобавлятьПустыеЗначения
				И Не ЗначениеЗаполнено(Значение) Тогда
				Продолжить;
			КонецЕсли;
			Если ЗначенияПриемника[Значение] = Неопределено Тогда
				МассивПриемник.Добавить(Значение);
				ЗначенияПриемника.Вставить(Значение, Истина);
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		Для Каждого Значение Из МассивИсточник Цикл
			МассивПриемник.Добавить(Значение);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Удаляет значение из массива, если оно в нем есть
//
// Параметры:
//  Массив - Массив - массив, из которого нужно удалить значение;
//  Значение - Значение - значение, которое нужно удалить;
//
Процедура УдалитьЗначениеИзМассива(Массив, Значение) Экспорт
	
	ИндексЗначения = Массив.Найти(Значение);
	
	Если ИндексЗначения <> Неопределено Тогда
		Массив.Удалить(ИндексЗначения);
	КонецЕсли;
	
КонецПроцедуры

// Добавляет значение в массив, если его там еще нет
//
// Параметры:
//  Массив - Массив - массив, в который нужно добавить значение;
//  Значение - Значение - значение, которое нужно добавить;
//
Процедура ДобавитьЗначениеВМассив(Массив, Значение) Экспорт
	
	Если Не МассивСодержитЗначение(Массив, Значение) Тогда
		Массив.Добавить(Значение);
	КонецЕсли;
	
КонецПроцедуры

// Выгружает значения поля из массива структур в новый массив
//
// Параметры:
//  МассивСтруктур - Массив - массив содержит структуры;
//  ИмяПоля - Строка - поле, значения которого нужно выгрузить;
// 
// Возвращаемое значение:
//  Массив - массив значений из структур
//
Функция МассивСтруктур_Выгрузить(МассивСтруктур, ИмяПоля) Экспорт
	
	Результат = Новый Массив;
	
	Для каждого Элемент Из МассивСтруктур Цикл
		Результат.Добавить(Элемент[ИмяПоля]);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Ищет первую подходящую структуру в массиве структур с одинаковым набором свойств
//
// Параметры:
//  МассивСтруктур  - Массив    - содержит структуры;
//  ПараметрыОтбора - Структура - параметры отбора, где:
//   * Ключ     - имя свойства в структурах массива;
//   * Значение - подходящее значение;
//
// Возвращаемое значение:
//  Структура    - первая найденная структура;
//  Неопределено - если строку найти не удалось;
//
Функция МассивСтруктур_НайтиСтроку(МассивСтруктур, ПараметрыОтбора) Экспорт
	
	МассивСтрок = МассивСтруктур_НайтиСтроки(МассивСтруктур, ПараметрыОтбора);
	
	Если ЗначениеЗаполнено(МассивСтрок) Тогда
		Результат = МассивСтрок[0];
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Ищет подходящие структуры в массиве структур с одинаковым набором свойств
//
// Параметры:
//  МассивСтруктур  - Массив    - содержит структуры с одинаковым набором свойств;
//  ПараметрыОтбора - Структура - параметры отбора, где:
//   * Ключ     - имя свойства в структурах массива;
//   * Значение - подходящее значение;
//
// Возвращаемое значение:
//  Массив - содержит подходящие структуры
//
Функция МассивСтруктур_НайтиСтроки(МассивСтруктур, ПараметрыОтбора) Экспорт
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(МассивСтруктур) Тогда
		
		Для Каждого Структура Из МассивСтруктур Цикл
			
			СтруктураСоответствуетОтбору = Истина;
			
			Для Каждого ЭлементОтбора Из ПараметрыОтбора Цикл
				
				Если Структура[ЭлементОтбора.Ключ] <> ЭлементОтбора.Значение Тогда
					СтруктураСоответствуетОтбору = Ложь;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
			Если СтруктураСоответствуетОтбору Тогда
				Результат.Добавить(Структура);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Выполняет запрос и получает значение поля из первой строки результата
//
// Параметры:
//  Запрос - Запрос - запрос который нужно выполнить;
//  ИмяПоля - Строка - (необязательный) имя поля, значение которого нужно получить;
//  ЗначениеПоУмолчанию - Произвольный - (необязательный) значение, которое нужно вернуть
//                                        если результат запроса пустой;
// 
// Возвращаемое значение:
//  Произвольный - значение из результата запроса или значение по умолчанию
//
Функция ПолучитьРезультатЗапроса(Запрос, ИмяПоля = "Ссылка", ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка[ИмяПоля];
	Иначе
		Результат = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Выполняет запрос и получает массив значений из поля результата
//
// Параметры:
//  Запрос - Запрос - запрос который нужно выполнить;
//  ИмяПоля - Строка - (необязательный) имя поля, значения которого нужно получить;
// 
// Возвращаемое значение:
//  Массив - значения из результата запроса
//
Функция МассивИзРезультатаЗапроса(Запрос, ИмяПоля = "Ссылка")
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(ИмяПоля);
	
	Возврат Результат;
	
КонецФункции

// Проверяет что значение есть в массиве
//
// Параметры:
//  Массив - Массив - массив, в котором нужно найти значение;
//  Значение - Произвольный - значение, которое нужно найти в массиве;
// 
// Возвращаемое значение:
//  Булево - Истина, если значение есть в массиве
//
Функция МассивСодержитЗначение(Массив, Значение) Экспорт
	
	Результат = Массив.Найти(Значение) <> Неопределено;
	
	Возврат Результат;
	
КонецФункции

// Выгружает массив в таблицу значений
//
// Параметры:
//  Массив - Массив - массив;
//  ИмяКолонки - Строка - (необязательный) имя колонки;
// 
// Возвращаемое значение:
//  ТаблицаЗначений - содержит одну колонку и значения из массива
//
Функция ТаблицаИзМассива(Массив, ИмяКолонки = "Ссылка")
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить(ИмяКолонки);
	
	Для каждого Значение Из Массив Цикл
		Стр = Результат.Добавить();
		Стр[ИмяКолонки] = Значение;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Добавляет в таблицу приемник строки из таблицы источника
//
// Параметры:
//  Приемник - ТаблицаЗначений - таблица, в которую нужно добавить строки;
//  Источник - ТаблицаЗначений - таблица, из которой нужно взять строки;
//
Процедура ТаблицаЗначений_Дополнить(Приемник, Источник) Экспорт
	
	Если Не ЗначениеЗаполнено(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	Если Приемник = Источник Тогда
		ВызватьИсключение НСтр("ru = 'Ошибка дополнения таблицы значений: приемник равен источнику'");
	КонецЕсли;
	
	Для каждого СтрИсточник Из Источник Цикл
		СтрПриемник = Приемник.Добавить();
		ЗаполнитьЗначенияСвойств(СтрПриемник, СтрИсточник);
	КонецЦикла;
	
КонецПроцедуры

// Добавляет в таблицу приемник колонки из таблицы источника
//
// Параметры:
//  Приемник - ТаблицаЗначений - таблица, в которую нужно добавить строки;
//  Источник - ТаблицаЗначений - таблица, из которой нужно взять строки;
//
Процедура ТаблицаЗначений_ДополнитьКолонки(Приемник, Источник) Экспорт
	
	Для каждого Колонка Из Источник.Колонки Цикл
		Если Приемник.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
			Приемник.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ТаблицаЗначений_ВыгрузитьКолонку(ТаблицаЗначений, ИмяКолонки, УдалитьПустыеЗначения = Ложь) Экспорт
	
	Таб = ТаблицаЗначений.Скопировать(, ИмяКолонки);
	Таб.Свернуть(ИмяКолонки);
	
	Если УдалитьПустыеЗначения Тогда
		ТаблицаЗначений_УдалитьПустыеСтроки(Таб, ИмяКолонки);
	КонецЕсли;
	
	Возврат Таб.ВыгрузитьКолонку(ИмяКолонки);
	
КонецФункции

Процедура ТаблицаЗначений_ЗагрузитьМассив(ТаблицаЗначений, Массив, ИмяКолонки) Экспорт
	
	Для каждого Значение Из Массив Цикл
		ТаблицаЗначений.Добавить()[ИмяКолонки] = Значение;
	КонецЦикла;
	
КонецПроцедуры

// Разбивает таблицу значений на части по значению поля
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - таблица значений;
//  ИменаКолонок - Строка - имена колонок, по которым нужно разбить таблицу;
//  РазмерПорции - Число - максимальное количество строк в одной части;
// 
// Возвращаемое значение:
//  ТаблицаЗначений - содержит МассивСтрок и колонки, по которым была разбита таблица;
//
Функция ТаблицаЗначений_Разбить(ТаблицаЗначений, ИменаКолонок, РазмерПорции = 0) Экспорт
	
	Результат = ТаблицаЗначений.СкопироватьКолонки(ИменаКолонок);
	Результат.Колонки.Добавить("МассивСтрок");
	Результат.Колонки.Добавить("ЗначениеКолонки"); // Для обратной совместимости
	
	ЗначенияКолонок = Новый Структура(ИменаКолонок);
	
	ТабКолонок = ТаблицаЗначений.Скопировать(, ИменаКолонок);
	ТабКолонок.Свернуть(ИменаКолонок);
	
	Для каждого СтрКолонки Из ТабКолонок Цикл
		
		ЗаполнитьЗначенияСвойств(ЗначенияКолонок, СтрКолонки);
		ПодходящиеСтроки = ТаблицаЗначений.НайтиСтроки(ЗначенияКолонок);
		
		Если ЗначениеЗаполнено(РазмерПорции) Тогда
			Для Каждого МассивСтрок Из РазбитьМассив(ПодходящиеСтроки, РазмерПорции) Цикл
				Стр = Результат.Добавить();
				ЗаполнитьЗначенияСвойств(Стр, ЗначенияКолонок);
				Стр.МассивСтрок = МассивСтрок;
				Стр.ЗначениеКолонки = СтрКолонки[0];
			КонецЦикла;
		Иначе
			Стр = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(Стр, ЗначенияКолонок);
			Стр.МассивСтрок = ПодходящиеСтроки;
			Стр.ЗначениеКолонки = СтрКолонки[0];
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Разбивает таблицу значений на новые таблицы по значению колонок
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - таблица значений;
//  ИменаКолонок - Строка - имена колонок, по которым нужно разбить таблицу;
//  РазмерПорции - Число - максимальное количество строк в одной части;
// 
// Возвращаемое значение:
//  ТаблицаЗначений - содержит колонку ЧастьТаблицы и колонки, по которым была разбита таблица;
//
Функция ТаблицаЗначений_РазбитьНаТаблицы(ТаблицаЗначений, ИменаКолонок, РазмерПорции = 0)
	
	ЗначенияКолонок = Новый Структура(ИменаКолонок);
	
	ТаблицаРазбиения = ТаблицаЗначений.Скопировать(, ИменаКолонок);
	ТаблицаРазбиения.Свернуть(ИменаКолонок);
	
	Результат = ТаблицаРазбиения.Скопировать();
	Результат.Очистить();
	Результат.Колонки.Добавить("ЧастьТаблицы");
	
	Для каждого Стр Из ТаблицаРазбиения Цикл
		
		ЗаполнитьЗначенияСвойств(ЗначенияКолонок, Стр);
		ПодходящиеСтроки = ТаблицаЗначений.НайтиСтроки(ЗначенияКолонок);
		
		Если ЗначениеЗаполнено(РазмерПорции) Тогда
			Для Каждого МассивСтрок Из РазбитьМассив(ПодходящиеСтроки, РазмерПорции) Цикл
				НоваяСтрока = Результат.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр, ИменаКолонок);
				НоваяСтрока.ЧастьТаблицы = ТаблицаЗначений.Скопировать(МассивСтрок);
			КонецЦикла;
		Иначе
			НоваяСтрока = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр, ИменаКолонок);
			НоваяСтрока.ЧастьТаблицы = ТаблицаЗначений.Скопировать(ЗначенияКолонок);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Удаляет из таблицы значений строки с пустым значением колонки
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - таблица значений;
//  ИмяКолонки - Строка - имя колонки, которую нужно проверить;
//
Процедура ТаблицаЗначений_УдалитьПустыеСтроки(ТаблицаЗначений, ИмяКолонки)
	
	Для Сч = -(ТаблицаЗначений.Количество() - 1) По 0 Цикл
		Значение = ТаблицаЗначений[-Сч][ИмяКолонки];
		Если Значение = Ложь Или Не ЗначениеЗаполнено(Значение) Тогда
			ТаблицаЗначений.Удалить(-Сч);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Добавляет в таблицу колонку ИндексСтроки и заполняет ее
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - таблица значений;
//
Процедура ТаблицаЗначений_ДобавитьИндексСтроки(ТаблицаЗначений) Экспорт
	
	Если ТаблицаЗначений.Колонки.Найти("ИндексСтроки") = Неопределено Тогда
		ТаблицаЗначений.Колонки.Добавить("ИндексСтроки", Новый ОписаниеТипов("Число"));
	КонецЕсли;
	
	Для Сч = 0 По ТаблицаЗначений.Количество() - 1 Цикл
		ТаблицаЗначений[Сч].ИндексСтроки = Сч;
	КонецЦикла;
	
КонецПроцедуры

Функция ТаблицаЗначений_МассивКолонок(ТаблицаЗначений, Исключения = Неопределено) Экспорт
	
	МассивИсключений = Новый Массив;
	Если ЗначениеЗаполнено(Исключения) Тогда
		Если ТипЗнч(Исключения) = Тип("Строка") Тогда
			МассивИсключений = РазделитьСтроку(Исключения);
		Иначе
			МассивИсключений = ЗначениеВМассиве(Исключения);
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Массив;
	Для каждого Колонка Из ТаблицаЗначений.Колонки Цикл
		Если МассивИсключений.Найти(Колонка.Имя) = Неопределено Тогда
			Результат.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаЗначений_УдалитьЛишниеКолонки(ТаблицаЗначений, НужныеКолонки) Экспорт
	
	Для каждого ИмяКолонки Из ТаблицаЗначений_МассивКолонок(ТаблицаЗначений, НужныеКолонки) Цикл
		ТаблицаЗначений.Колонки.Удалить(ИмяКолонки);
	КонецЦикла;
	
	Возврат ТаблицаЗначений;
	
КонецФункции

// Определяет, является ли переданное значение соответствием
// или фиксированным соответствием
// 
// Параметры:
//  Значение - Произвольный - значение, которое нужно проверить
// 
// Возвращаемое значение:
//  Булево - Истина, если переданое значение является соответствием или фиксированным соответствием
//
Функция ЭтоСоответствие(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Соответствие")
		Или ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет, является ли переданное значение массивом
// или фиксированным массивом
// 
// Параметры:
//  Значение - Произвольный - значение, которое нужно проверить
// 
// Возвращаемое значение:
//  Булево - Истина, если переданое значение является структрой или фиксированной структурой
//
Функция ЭтоМассив(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Массив")
		Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет является ли переданное значение ссылкой
//
// Параметры:
//  Значение - Произвольный - значение, которое нужно проверить
// 
// Возвращаемое значение:
//  Булево - Истина, если переданое значение является ссылкой
//
Функция ЭтоСсылка(Значение) Экспорт
	
	ТипЗначения = ТипЗнч(Значение);
	
	КлючКэш = "ЭтоСсылка";
	Результаты = Кэш_Прочитать(КлючКэш);
	Если Результаты = Неопределено Тогда
		Результаты = Новый Соответствие;
		Кэш_Поместить(КлючКэш, Результаты);
	КонецЕсли;
	Результат = Результаты[ТипЗначения];
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = МассивСодержитЗначение(ВсеТипыСсылокСправочников(), ТипЗначения)
	Или МассивСодержитЗначение(ВсеТипыСсылокДокументов(), ТипЗначения)
	Или МассивСодержитЗначение(ВсеТипыСсылокПеречислений(), ТипЗначения)
	Или МассивСодержитЗначение(ВсеТипыСсылокПлановВидовХарактеристик(), ТипЗначения)
	Или МассивСодержитЗначение(ВсеТипыСсылокПлановОбменаРИБ(), ТипЗначения);
	
	Результаты.Вставить(ТипЗначения, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ВсеТипыСсылокСправочников()
	
