// Проверяет доступна ли указанная роль документу учета 
//
// Параметры:
//  ДокументУчета - СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ учета;
//  Роль - Строка - см. Перечисление_РолиДокументовУчета();
