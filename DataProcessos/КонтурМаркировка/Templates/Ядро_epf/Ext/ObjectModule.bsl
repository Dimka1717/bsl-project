// Возвращает таблицу с номенклатурой связанной с товаром маркировки по GTIN
//
// Параметры:
//  Товар - СправочникСсылка.КонтурМаркировка_Товары - товар;
//  ВызыватьИсключение - Булево - Ложь, если нужно отключить ошибки;
// 
// Возвращаемое значение:
//  ТаблицаЗначений - см. функцию Новый_ТаблицаНоменклатуры()
//
Функция Номенклатура1С_НайтиПоGTIN(Товар, ВызыватьИсключение = Истина)
	
	Результат = Новый_ТаблицаНоменклатуры();
	
	ТипыОбъектов = ТипыОбъектовИС();
	Если Не ЗначениеЗаполнено(ТипыОбъектов.РегистрШтрихкодов.ПолноеИмя) Тогда
		Если ВызыватьИсключение Тогда
			ВызватьИсключение НСтр("ru = 'Не определен тип регистра штрихкодов'");
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	GTIN = ЗначениеРеквизитаОбъекта_Марк(Товар, "GTIN");
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика
	|ИЗ
	|	РегистрШтрихкодов КАК Т
	|ГДЕ
	|	Т.Штрихкод В(&ВариантыШтрихкода)";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РегистрШтрихкодов", ТипыОбъектов.РегистрШтрихкодов.ПолноеИмя);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Т.Штрихкод", "Т." + ТипыОбъектов.РегистрШтрихкодов.ПолеШтрихкод);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Т.Номенклатура", "Т." + ТипыОбъектов.РегистрШтрихкодов.ПолеНоменклатура);
	
	Если ЗначениеЗаполнено(ТипыОбъектов.РегистрШтрихкодов.ПолеХарактеристика) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Т.Характеристика", "Т." + ТипыОбъектов.РегистрШтрихкодов.ПолеХарактеристика);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Т.Характеристика", "НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	
	ВариантыШтрихкода = Новый Массив;
	ВариантыШтрихкода.Добавить(ШтрихкодEAN13ИзGTIN(GTIN));
	ВариантыШтрихкода.Добавить(GTIN);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ВариантыШтрихкода", ВариантыШтрихкода);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Стр = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Выборка);
		Стр.КлючНоменклатуры1С = КлючНоменклатуры1С_Подобрать(Стр);
		Стр.Товар = Товар;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ТаблицаНоменклатуры() Экспорт
	
	ТипТовар = ОписаниеТипа_Товар();
	ТипСправочники = Справочники.ТипВсеСсылки();
	ТипКлючНоменклатуры1С = ОписаниеТипа_КлючиНоменклатуры1С();
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Товар", ТипТовар);
	Результат.Колонки.Добавить("КлючНоменклатуры1С", ТипКлючНоменклатуры1С);
	Результат.Колонки.Добавить("Номенклатура", ТипСправочники);
	Результат.Колонки.Добавить("Характеристика", ТипСправочники);
	Результат.Колонки.Добавить("Упаковка", ТипСправочники);
	Результат.Колонки.Добавить("Серия", ТипСправочники);
	
	Возврат Результат;
	
КонецФункции

