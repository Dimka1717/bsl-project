// #Область ОтчетОВыбытии

Функция ОчередьОбмена_ОтчетОВыбытии_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеОтчетОВыбытииНаТСД);
	Результат.Добавить(ТребуемыеДействия.ПолучитьКодыОтчетаОВыбытииНаТСД);
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеВыбытиеКодов);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлДляПодписиВыбытияКодов);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьГотовностьВыбытияКодов);
	Результат.Добавить(ТребуемыеДействия.ОбновитьСтатусыКодовПослеВыбытия);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_ОтчетОВыбытии_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьВСервисеОтчетОВыбытииНаТСД Тогда
		Задача_ОтчетОВыбытииНаТСД_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьКодыОтчетаОВыбытииНаТСД Тогда
		Задача_ОтчетОВыбытииНаТСД_ПолучитьКоды(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьВСервисеВыбытиеКодов Тогда
		Задача_ОтчетОВыбытии_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлДляПодписиВыбытияКодов Тогда
		Задача_ОтчетОВыбытии_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_ОтчетОВыбытии_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьГотовностьВыбытияКодов Тогда
		Задача_ОтчетОВыбытии_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОбновитьСтатусыКодовПослеВыбытия Тогда
		Задача_ОбновитьСтатусыКодовЗавершитьОперацию(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ОтчетОВыбытии_СоздатьВСервисе(ОписаниеЗадачи)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_ОтчетОВыбытии(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_ОтчетОВыбытии_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьФайлДляПодписиВыбытияКодов;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_ОтчетОВыбытии_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_ОтчетОВыбытии_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.documentId;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ОтчетОВыбытии_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_ОтчетОВыбытии_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьВыбытияКодов;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_ОтчетОВыбытии_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьВыбытияКодов;
		
		ТипОперации = ЗначениеРеквизитаОбъекта_Марк(ОписаниеЗадачи.Операция, "ТипОперации");
		
		Если ТипОперации = ТипыОпераций.ОтчетОВыбытииНаТСД Тогда
			НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
		Иначе
			НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		КонецЕсли;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("TsdProcessStart") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьВыбытияКодов;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ReadyForSend") Тогда
		
		НовыйСтатус = СтатусыОпераций.НаполненНаТСД;
		НовоеДействие = ТребуемыеДействия.ПолучитьКодыОтчетаОВыбытииНаТСД;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSending")
		Или НРег(СтатусДокумента) = НРег("Sending") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьВыбытияКодов;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing")
		Или НРег(СтатусДокумента) = НРег("Processing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьВыбытияКодов;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("ProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОбновлениеСтатусовКодов;
		НовоеДействие = ТребуемыеДействия.ОбновитьСтатусыКодовПослеВыбытия;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSendingError")
		Или НРег(СтатусДокумента) = НРег("SendingError")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedError") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус выбытия кодов: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

// #КонецОбласти // ОтчетОВыбытии

// #Область ОтчетОВыбытииНаТСД

Процедура Задача_ОтчетОВыбытииНаТСД_СоздатьВСервисе(ОписаниеЗадачи)
	
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_ОтчетОВыбытииНаТСД(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_ОтчетОВыбытии_Создать(ОписаниеЗадачи, Контент, Истина);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьВыбытияКодов;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_ОтчетОВыбытииНаТСД(Организация);
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_ОтчетОВыбытииНаТСД_ПолучитьКоды(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	
	Попытка
		Ответ = Маркировка_ОтчетОВыбытииНаТСД_Результат(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	Контент = Ответ.Результат;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	ТаблицаКодов = Задача_ОтчетОВыбытииНаТСД_ТаблицаКодов(Операция, Контент.positions);
	
	Если ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация, Ложь) Тогда
		Задача_ОтчетОВыбытииНаТСД_ЗавершитьПолучениеКодов(ОписаниеЗадачи, ТаблицаКодов);
	Иначе
		Задача_ЗаписатьКодыВРедакторДляРаспознавания(ОписаниеЗадачи, ТаблицаКодов);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ОтчетОВыбытииНаТСД_ЗавершитьПолучениеКодов(ОписаниеЗадачи, ТаблицаКодов)
	
	Операция = ОписаниеЗадачи.Операция;
	ДокументУчета = ЗначениеРеквизитаОбъекта_Марк(Операция, "ДокументУчета");
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ТаблицаКодов_ЗаполнитьПоДокументуКлючиНоменклатуры1С(ТаблицаКодов, ДокументУчета);
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
		КодыОпераций_Записать(ТаблицаКодов, Операция);
		КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, Ложь);
		ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета);
		
		ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьФайлДляПодписиВыбытияКодов;
		Задача_Записать(ОписаниеЗадачи);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция Задача_ОтчетОВыбытииНаТСД_ТаблицаКодов(Операция, positions)
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	
	НомерСтроки = 0;
	Для Каждого position Из positions Цикл
		
		НомерСтроки = НомерСтроки + 1;
		СтрТовара = ОписаниеОперации.Товары.Найти(НомерСтроки, "НомерСтроки");
		Если СтрТовара = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		codes = СвойствоСтруктуры(position, "codes");
		Если Не ЗначениеЗаполнено(codes) Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого code Из codes Цикл
			Стр = ТаблицаКодов.Добавить();
			Стр.ПолныйКод = code;
			Стр.КодМаркировки = code;
			Стр.КлючНоменклатуры1С = СтрТовара.КлючНоменклатуры1С;
			Стр.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
			Стр.КлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаЗначений_СвернутьПоВсемКолонкам(ТаблицаКодов);
	
	Возврат ТаблицаКодов;
	
КонецФункции

// #КонецОбласти // ОтчетОВыбытииНаТСД

// #Область Перемаркировка

Функция ОчередьОбмена_Перемаркировка_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьСтрокиПеремаркировки);
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеПеремаркировку);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлДляПодписиПеремаркировки);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьГотовностьПеремаркировки);
	Результат.Добавить(ТребуемыеДействия.ПроверитьРегистрациюСтрокПеремаркировки);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_Перемаркировка_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьСтрокиПеремаркировки Тогда
		Задача_Перемаркировка_СоздатьСтрокиПеремаркировки(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьВСервисеПеремаркировку Тогда
		Задача_Перемаркировка_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлДляПодписиПеремаркировки Тогда
		Задача_Перемаркировка_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_Перемаркировка_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьГотовностьПеремаркировки Тогда
		Задача_Перемаркировка_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьРегистрациюСтрокПеремаркировки Тогда
		Задача_Перемаркировка_ПроверитьСтатусыСтрок(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_Перемаркировка_СоздатьСтрокиПеремаркировки(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	
	Если Не КодыОпераций_ЕстьКоды(Операция) Тогда
		ТекстОшибки = НСтр("ru = 'Перемаркировка не содержит кодов'");
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ТипОпераций = Перечисление_ТипыОпераций().РегистрацияСтрокиПеремаркировки;
	СтарыеОперации = Операция_НайтиПодчиненныеОперации(Операция, ТипОпераций, Истина);
	Операции_Удалить(СтарыеОперации);
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Если КодыОпераций_ЕстьКоды(Операция, Стр.КлючСтрокиОперации) Тогда
			Операция_СоздатьРегистрациюСтрокиПеремаркировки(ОписаниеОперации, Стр);
		КонецЕсли;
	КонецЦикла;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьРегистрациюСтрокПеремаркировки;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправляетсяВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_Перемаркировка(Организация);
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации);
	
КонецПроцедуры

Процедура Задача_Перемаркировка_ПроверитьСтатусыСтрок(ОписаниеЗадачи)
	
	ТипОпераций = Перечисление_ТипыОпераций().РегистрацияСтрокиПеремаркировки;
	ВсеЗадачиЗавершены = Задача_ВсеПодчиненныеОперацииЗавершены(ОписаниеЗадачи.Операция, ТипОпераций);
	Если Не ВсеЗадачиЗавершены Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОшибкиВПодчиненных = Задача_ЕстьОшибкиВПодчиненныхОперациях(ОписаниеЗадачи.Операция, ТипОпераций);
	
	Если ЕстьОшибкиВПодчиненных Тогда
		
		ВсеОшибки = Задача_ОшибкиВПодчиненныхОперациях(ОписаниеЗадачи.Операция, ТипОпераций);
		ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ИсправитьОшибку;
		ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОшибкаОбработки;
		ОписаниеЗадачи.ОписаниеОшибки = СоединитьСтроку(ВсеОшибки, Символы.ПС);
		Задача_Записать(ОписаниеЗадачи);
		
	Иначе
		Задача_Завершить(ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_Перемаркировка_СоздатьВСервисе(ОписаниеЗадачи)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_Перемаркировка(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_Перемаркировка_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьФайлДляПодписиПеремаркировки;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_Перемаркировка_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_Перемаркировка_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.documentId;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_Перемаркировка_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_Перемаркировка_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьПеремаркировки;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_Перемаркировка_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = Неопределено;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("SentForApprove") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленНаПодтверждение;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьПеремаркировки;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing")
		Или НРег(СтатусДокумента) = НРег("Processing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьПеремаркировки;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Approved")
		Или НРег(СтатусДокумента) = НРег("Archived")
		Или НРег(СтатусДокумента) = НРег("crptProcessedSuccess")Тогда
		
		НовыйСтатус = СтатусыОпераций.ОперацияЗавершена;
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("crptProcessedError") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус перемаркировки: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

// #КонецОбласти // Перемаркировка

// #Область ФормированиеНаборов

Функция ОчередьОбмена_НаполнениеНаборовНаТСД_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеДокументФормированияНаборов);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлДляПодписиФормированияНаборов);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПолучитьРезультатНаполненияНаборовНаТСД);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_НаполнениеНаборовНаТСД_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьВСервисеДокументФормированияНаборов Тогда
		Задача_ФормированиеНаборов_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлДляПодписиФормированияНаборов Тогда
		Задача_ФормированиеНаборов_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_ФормированиеНаборов_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьРезультатНаполненияНаборовНаТСД Тогда
		Задача_ФормированиеНаборов_ПолучениеРезультатаНаполнения(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ФормированиеНаборов_СоздатьВСервисе(ОписаниеЗадачи)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	
	Если ОписаниеОперации.ТипОперации = ТипыОпераций.НаполнениеНаборовНаТСД Тогда
		Контент = Контент_НаполнениеНаборовНаТСД(ОписаниеОперации);
		НаполнитьНаТСД = Истина;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьНаполненияНаборовНаТСД;
		НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленНаТСД;
	Иначе
		Контент = Контент_РегистрацияНаборов(ОписаниеОперации);
		НаполнитьНаТСД = Ложь;
		НовоеДействие = ТребуемыеДействия.ПолучитьФайлДляПодписиФормированияНаборов;
		НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	КонецЕсли;
	
	Попытка
		Ответ = Маркировка_ФормированиеНаборов_Создать(ОписаниеЗадачи, Контент, НаполнитьНаТСД);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатусОперации;
	Задача_Записать(ОписаниеЗадачи);
	
	Если ОписаниеОперации.ТипОперации = ТипыОпераций.НаполнениеНаборовНаТСД Тогда
		Метрика_Функциональность_НаполнениеНаборовНаТСД(Организация);
	Иначе
		Метрика_Функциональность_РегистрацияНаборов(Организация);
	КонецЕсли;
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_ФормированиеНаборов_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_ФормированиеНаборов_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.id;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ФормированиеНаборов_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_ФормированиеНаборов_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьСтатусФормированияНаборов;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_ФормированиеНаборов_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	СтатусДокумента = Ответ.Результат.Статус;
	ТекстОшибки = Ответ.Результат.Комментарий;
	
	ТипОперации = ОписаниеЗадачи.ТипОперации;
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	НовыйСтатус = "";
	НовоеДействие = "";
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		Если ТипОперации = ТипыОпераций.НаполнениеНаборовНаТСД Тогда
			НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
			НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьНаполненияНаборовНаТСД;
		Иначе
			НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		КонецЕсли;
	
	ИначеЕсли НРег(СтатусДокумента) = НРег("tsdProcessStart") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьНаполненияНаборовНаТСД;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Completed") Тогда
		
		НовыйСтатус = СтатусыОпераций.НаполненНаТСД;
		НовоеДействие = ТребуемыеДействия.ПолучитьФайлДляПодписиФормированияНаборов;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("readyForSend") Тогда
		
		Если ТипОперации = ТипыОпераций.НаполнениеНаборовНаТСД Тогда
			НовыйСтатус = СтатусыОпераций.НаполненНаТСД;
		Иначе
			НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		КонецЕсли;
		
		НовоеДействие = ТребуемыеДействия.ПолучитьФайлДляПодписиФормированияНаборов;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьСтатусФормированияНаборов;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("crptProcessedSuccess") Тогда
		
		Если ТипОперации = ТипыОпераций.НаполнениеНаборовНаТСД Тогда
			НовыйСтатус = СтатусыОпераций.ОжиданиеГотовности;
			НовоеДействие = ТребуемыеДействия.ПолучитьРезультатНаполненияНаборовНаТСД;
		Иначе
			НовыйСтатус = СтатусыОпераций.ОперацияЗавершена;
			НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		КонецЕсли;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedError")
		Или НРег(СтатусДокумента) = НРег("Failed") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус формирования наборов: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ФормированиеНаборов_ПолучениеРезультатаНаполнения(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	ДокументУчета = Операция.ДокументУчета;
	ОбщийТипУпаковкиНабор = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Набор;
	
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	Для каждого Стр Из ТаблицаКодов Цикл
		Если Стр.ОбщийТипУпаковки <> ОбщийТипУпаковкиНабор Тогда
			Стр.КодАгрегата = Неопределено;
			Стр.КлючАгрегата = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаНовыхКодов = Новый_ТаблицаКодов();
	
	ИндексКодМаркировки = ТаблицаКодов.Индексы.Добавить("КодМаркировки");
	
	Для каждого СтрНабора Из ТаблицаКодов Цикл
		
		Если СтрНабора.ОбщийТипУпаковки <> ОбщийТипУпаковкиНабор Тогда
			Продолжить;
		КонецЕсли;
		
		КодНабора = СтрНабора.КодМаркировки;
		
		Попытка
			ВложенныеКоды = Маркировка_ВложенныеКодыАгрегата(КодНабора, Организация);
		Исключение
			Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
			Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
			Продолжить;
		КонецПопытки;
		
		Если Не ЗначениеЗаполнено(ВложенныеКоды) Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаНовыхКодовНабора = ТаблицаКодов_ЗагрузитьКодыМаркировки(ВложенныеКоды);
		
		Если Не ТаблицаКодов_НормализоватьКоды(ТаблицаНовыхКодовНабора, Организация) Тогда
			Задача_ЗаписатьОшибку(ОписаниеЗадачи, НСтр("ru = 'Не удалось нормализовать коды набора'"));
			Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
		КонецЕсли;
		
		ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаНовыхКодовНабора);
		
		Для каждого Стр Из ТаблицаНовыхКодовНабора Цикл
			СтрКода = ТаблицаКодов.Найти(Стр.КодМаркировки, "КодМаркировки");
			Если СтрКода = Неопределено Тогда
				СтрКода = ТаблицаНовыхКодов.Добавить();
				ЗаполнитьЗначенияСвойств(СтрКода, Стр);
			КонецЕсли;
			СтрКода.КодАгрегата = КодНабора;
			СтрКода.УдалитьИзДокумента = Истина;
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаКодов.Индексы.Удалить(ИндексКодМаркировки);
	ТаблицаЗначений_Дополнить(ТаблицаКодов, ТаблицаНовыхКодов);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
		
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, Ложь);
			ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета);
		КонецЕсли;
		
		Задача_Завершить(ОписаниеЗадачи);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура Задача_ФормированиеНаборов_ВернутьНаТСД(ОписаниеЗадачи, Комментарий)
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если ОписаниеЗадачи.ТребуемоеДействие <> ТребуемыеДействия.ИсправитьОшибку Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = ОписаниеЗадачи.ИдентификаторДокумента;
	Если Не ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_ВозвратНаполненияНаборовНаТСД(Комментарий);
	
	Попытка
		Ответ = Маркировка_ФормированиеНаборов_ВернутьНаТСД(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьНаполненияНаборовНаТСД;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ВозвращенНаТСД;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_ВозвратНаполненияНаборовНаТСД(Организация);
	
КонецПроцедуры

// #КонецОбласти // ФормированиеНаборов

// #Область РегистрацияКИГУ

Функция ОчередьОбмена_РегистрацияКИГу_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьСтрокиРегистрацииКИГУ);
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеДокументРегистрацииКИГУ);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлДляПодписиРегистрацииКИГУ);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьГотовностьРегистрацииКИГУ);
	Результат.Добавить(ТребуемыеДействия.ПроверитьРегистрациюСтрокКИГУ);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_РегистрацияКИГу_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьСтрокиРегистрацииКИГУ Тогда
		Задача_РегистрацияКИГУ_СоздатьСтрокиРегистрацииКИГУ(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьВСервисеДокументРегистрацииКИГУ Тогда
		Задача_РегистрацияКИГу_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлДляПодписиРегистрацииКИГУ Тогда
		Задача_РегистрацияКИГу_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_РегистрацияКИГу_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьГотовностьРегистрацииКИГУ Тогда
		Задача_РегистрацияКИГу_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьРегистрациюСтрокКИГУ Тогда
		Задача_РегистрацияКИГУ_ПроверитьСтатусыСтрок(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_РегистрацияКИГУ_СоздатьСтрокиРегистрацииКИГУ(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	
	ТипОпераций = Перечисление_ТипыОпераций().РегистрацияСтрокиКИГУ;
	СтарыеОперации = Операция_НайтиПодчиненныеОперации(Операция, ТипОпераций, Истина);
	Операции_Удалить(СтарыеОперации);
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Если КодыОпераций_ЕстьКоды(Операция, Стр.КлючСтрокиОперации) Тогда
			Операция_СоздатьРегистрациюСтрокиКИГУ(ОписаниеОперации, Стр);
		КонецЕсли;
	КонецЦикла;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьРегистрациюСтрокКИГУ;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправляетсяВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации);
	Метрика_Функциональность_РегистрацияКИГУ(Организация);
	
КонецПроцедуры

Процедура Задача_РегистрацияКИГУ_ПроверитьСтатусыСтрок(ОписаниеЗадачи)
	
	ТипОпераций = Перечисление_ТипыОпераций().РегистрацияСтрокиКИГУ;
	ВсеЗадачиЗавершены = Задача_ВсеПодчиненныеОперацииЗавершены(ОписаниеЗадачи.Операция, ТипОпераций);
	Если Не ВсеЗадачиЗавершены Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОшибкиВПодчиненных = Задача_ЕстьОшибкиВПодчиненныхОперациях(ОписаниеЗадачи.Операция, ТипОпераций);
	
	Если ЕстьОшибкиВПодчиненных Тогда
		
		ВсеОшибки = Задача_ОшибкиВПодчиненныхОперациях(ОписаниеЗадачи.Операция, ТипОпераций);
		ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ИсправитьОшибку;
		ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОшибкаОбработки;
		ОписаниеЗадачи.ОписаниеОшибки = СоединитьСтроку(ВсеОшибки, Символы.ПС);
		Задача_Записать(ОписаниеЗадачи);
		
	Иначе
		Задача_Завершить(ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_РегистрацияКИГу_СоздатьВСервисе(ОписаниеЗадачи)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_РегистрацияКИГУ(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_ФормированиеКИГУ_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьФайлДляПодписиРегистрацииКИГУ;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации);
	
КонецПроцедуры

Процедура Задача_РегистрацияКИГу_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_ФормированиеКИГУ_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.id;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_РегистрацияКИГу_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_ФормированиеКИГу_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьРегистрацииКИГУ;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_РегистрацияКИГу_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = Неопределено;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьРегистрацииКИГУ;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("crptProcessedSuccess") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОперацияЗавершена;
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedError") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус перемаркировки: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

