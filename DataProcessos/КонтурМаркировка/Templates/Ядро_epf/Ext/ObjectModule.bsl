Функция Часовой_ОписаниеОшибкиПлагин(ПараметрыЧасового, Действие, ТекстОшибки, ДопИнформация)
	
	Результат = Новый_ОписаниеОшибкиДляЧасового();
	Результат.timestamp = ТекущийTimestamp();
	Результат.logger = ПараметрыЧасового.project_name;
	Результат.platform = "Other";
	Результат.release = ВерсияОбработки();
	Результат.environment = МодульОбщегоНазначения().ВерсияПлатформы();
	Результат.user = НастройкиМодуля().ИдентификаторЭкземпляраМодуля;
	Результат.level = Перечисление_УровниОшибокЧасового().Предупреждение;
	
	Результат.exception["values"].Добавить(Новый Структура("type, value", Действие, ТекстОшибки));
	
	Результат.extra.Вставить("ИдентификаторЭкземпляраМодуля", НастройкиМодуля().ИдентификаторЭкземпляраМодуля);
	Результат.extra.Вставить("РасположениеМодуля", РасположениеМодуля());
	
	Если ЗначениеЗаполнено(ДопИнформация) Тогда
		
		Если ТипЗнч(ДопИнформация) = Тип("СписокЗначений") Тогда
			Для каждого Элемент Из ДопИнформация Цикл
				Результат.extra.Вставить(Элемент.Представление, Элемент.Значение);
			КонецЦикла;
		КонецЕсли;

		Если ЭтоСтруктура(ДопИнформация) Тогда
			Для каждого Элемент Из ДопИнформация Цикл
				Результат.extra.Вставить(Элемент.Ключ, Элемент.Значение);
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтоСтруктура(ДопИнформация)
		И ДопИнформация.Свойство("КраткийТекстОшибки") Тогда
		Результат.message = ДопИнформация.КраткийТекстОшибки;
	Иначе
		Результат.message = ТекстОшибки;
	КонецЕсли;
	
	Часовой_ДополнитьКонтентКонтекстом(Результат);
	
	Возврат Результат;
	
КонецФункции

Процедура Часовой_ОтправитьОписаниеОшибкиПлагин(Действие, ТекстОшибки, ДопИнформация)
	
	ПараметрыЧасового = Часовой_ПолучитьПараметры();
	Если Не ЗначениеЗаполнено(ПараметрыЧасового) Тогда
		Возврат;
	КонецЕсли;
	
	Контент = Часовой_ОписаниеОшибкиПлагин(ПараметрыЧасового, Действие, ТекстОшибки, ДопИнформация);
	
	Попытка
		Часовой_ОтправитьВСервис(Контент, ПараметрыЧасового);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Отправка информации в сервис сбора ошибок'");
		ОбработатьОшибку(Действие, Ошибка);
	КонецПопытки;
	
КонецПроцедуры

