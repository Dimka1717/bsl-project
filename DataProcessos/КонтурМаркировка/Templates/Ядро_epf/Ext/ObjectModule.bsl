	ТаблицаКодов.ЗаполнитьЗначения(ПустойКлюч, ПолеКлюча);
	
	Пока Истина Цикл
		
		Стр = ТаблицаКодов.Найти(ПустойКлюч, ПолеКлюча);
		Если Стр = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		КлючСтатусаКода = КлючСтатусаКода_Подобрать(Стр);
		
		ЗаполнитьЗначенияСвойств(Отбор, Стр, , ПолеКлюча);
		Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
			СтрКода.КлючСтатусаКода = КлючСтатусаКода;
		КонецЦикла;
		
