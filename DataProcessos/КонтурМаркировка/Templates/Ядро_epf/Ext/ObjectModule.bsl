//
Функция ИдентификаторИнформационнойБазыБСП()
	
	Если Не ЕстьМетаданные("ОбщиеМодули.СтандартныеПодсистемыСервер") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Результат = МодульСтандартныеПодсистемыСервер().ИдентификаторИнформационнойБазы();
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Возвращает идентификатор информационной базы
// вычисленный бизнес-логикой библиотеки
//
// Возвращаемое значение:
//  УникальныйИдентификатор - Идентификатор информационной базы
//
Функция ИдентификаторИнформационнойБазыКонтур()
	
	ВариантыХранения = Перечисление_ВариантыХраненияИдентификатораИБ();
	ВариантХранения = ВариантХраненияИдентификатораИБ();
	
	Если ВариантХранения = ВариантыХранения.КонстантаКонтура Тогда
		
		Результат = ИдентификаторИнформационнойБазыИзКонстанты();
		
	ИначеЕсли ВариантХранения = ВариантыХранения.ДополнительныеСведения Тогда
		
		Результат = ИдентификаторИнформационнойБазыИзРегистраДополнительныеСведения();
		
	ИначеЕсли ВариантХранения = ВариантыХранения.ЗначенияСвойствОбъектов Тогда
		
		Результат = ИдентификаторИнформационнойБазыИзРегистраЗначенияСвойствОбъектов();
		
	ИначеЕсли ВариантХранения = ВариантыХранения.Файл Тогда
		
		Результат = ИдентификаторИнформационнойБазыИзФайла();
		
	Иначе
		
		Результат = ИдентификаторИнформационнойБазыНеОпределен();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

