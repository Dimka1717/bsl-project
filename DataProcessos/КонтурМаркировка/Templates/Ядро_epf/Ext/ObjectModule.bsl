Процедура Часовой_ОтправитьВСервис(Контент, ПараметрыЧасового) Экспорт

	Если ВерсияПлатформыНиже("8.3") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	Часовой_ЗаполнитьОбщиеНастройкиHTTP(Запрос, ПараметрыЧасового);
	
	Запрос.Метод = "POST";
	Запрос.ПутьНаСервере = "/api/{project_number}/store/";
	Запрос.Параметры.Вставить("project_number", ПараметрыЧасового.project_number);
	Запрос.Заголовки.Вставить("X-Sentry-Auth", Часовой_ЗаголовокАвторизации(ПараметрыЧасового));
	Запрос.Заголовки.Вставить("User-Agent", Часовой_ЗаголовокКлиент(ПараметрыЧасового.project_name));
	Запрос.ТелоЗапроса = ЗначениеВСтрокуJSON(Контент);
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	
КонецПроцедуры

Функция Часовой_ЗаголовокАвторизации(ПараметрыЧасового)
	
	timestamp = Формат(ТекущийTimestamp(), "ЧРД=.; ЧН=0; ЧГ=0");
	
	Заголовок = ПараметрыВСтроку("Sentry sentry_timestamp=%1, sentry_client=%2, sentry_version=%3, sentry_key=%4"
									, timestamp
									, Часовой_ЗаголовокКлиент(ПараметрыЧасового.project_name)
									, Часовой_ВерсияФормата()
									, ПараметрыЧасового.sentry_key);

	Возврат Заголовок; 

КонецФункции

Функция Часовой_ЗаголовокКлиент(ИмяПроекта)
	
	Возврат ИмяПроекта + "/" + ВерсияОбработки();
	
КонецФункции

Функция Часовой_ВерсияФормата()
	
	Возврат "7";
	
КонецФункции

Функция Часовой_ОписаниеОшибкиHTTP(ОписаниеОтвета, ОписаниеЗапроса, ПараметрыЧасового)
	
	Метод = ОписаниеЗапроса.Метод;
	Сервер = ОписаниеЗапроса.Хост;
	ПутьНаСервере = ОписаниеЗапроса.ПутьНаСервере;
	ПараметрыЗапроса = ОписаниеЗапроса.Параметры;
	ЗаголовкиЗапроса = ОписаниеЗапроса.Заголовки;
	TraceID = ОписаниеОтвета.Заголовки["x-kontur-trace-id"];
	Authorization = ЗаголовкиЗапроса["Authorization"];
	
	ТелоОтвета = "";
	ОписаниеОтвета.Свойство("ТелоОтвета", ТелоОтвета);
	
	ТекстОшибки = ПараметрыВСтроку(НСтр("ru = 'Ошибка сервиса %1'"), ОписаниеОтвета.КодОтвета);
	
	Результат = Новый_ОписаниеОшибкиДляЧасового();
	Результат.timestamp = ТекущийTimestamp();
	Результат.logger = ПараметрыЧасового.project_name;
	Результат.platform = "Other";
	Результат.release = ВерсияОбработки();
	Результат.environment = МодульОбщегоНазначения().ВерсияПлатформы();
	Результат.user = НастройкиМодуля().ИдентификаторЭкземпляраМодуля;
	Результат.level = Перечисление_УровниОшибокЧасового().Предупреждение;
	
	Результат.exception["values"].Добавить(Новый Структура("type, value", ТекстОшибки, ПутьНаСервере));
	
	Результат.extra.Вставить("Метод", Метод);
	Результат.extra.Вставить("Сервер", Сервер);
	Результат.extra.Вставить("ПутьНаСервере", ПутьНаСервере);
	Результат.extra.Вставить("ТелоОтветаСервиса", ТелоОтвета);
	Результат.extra.Вставить("ИдентификаторЭкземпляраМодуля", НастройкиМодуля().ИдентификаторЭкземпляраМодуля);
	
	Если ЗначениеЗаполнено(TraceID) Тогда
		Результат.extra.Вставить("TraceID", TraceID);
	КонецЕсли;
	
	Результат.extra.Вставить("РасположениеМодуля", РасположениеМодуля());
	
	Если ЗначениеЗаполнено(Authorization) Тогда
		Результат.extra.Вставить("Authorization", ПредставлениеАвторизацииHTTP(Authorization));
	КонецЕсли;
	
	Для каждого Эл Из ПараметрыЗапроса Цикл
		Результат.extra.Вставить(Эл.Ключ, СокрЛП(Эл.Значение));
	КонецЦикла;
	
	Попытка
		ВызватьИсключение ТекстОшибки;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		ПодробныйТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		МодульОшибки = Ошибка.ИмяМодуля;
	КонецПопытки;
	
	Результат.extra.Вставить("МодульОшибки", МодульОшибки);
	
	Результат.message = ПодробныйТекстОшибки + Символы.ПС + ТелоОтвета;
	
	Часовой_ДополнитьКонтентКонтекстом(Результат);
	
	Возврат Результат;
	
КонецФункции

// Заполняет в описании запроса HTTP параметры сервиса и настройки прокси
//
// Параметры:
//  ОписаниеЗапроса - Структура - см. Новый_ОписаниеЗапросаHTTP()
//  ПараметрыЧасового - Структура - см. Новый_ПараметрыЧасового()
//
Процедура Часовой_ЗаполнитьОбщиеНастройкиHTTP(ОписаниеЗапроса, ПараметрыЧасового)
	
	ОписаниеСервиса = Часовой_ОписаниеСервиса(ПараметрыЧасового);
	ЗаполнитьЗначенияСвойств(ОписаниеЗапроса, ОписаниеСервиса);
	
	ОписаниеЗапроса.Заголовки.Вставить("Content-Type", "application/json;charset=utf-8");
	
	ЗаполнитьНастройкиПроксиСервера(ОписаниеЗапроса);
	
КонецПроцедуры

Функция Часовой_ОписаниеСервиса(ПараметрыЧасового)
	
	АдресСервиса = ПараметрыЧасового.sentry_server;
	Результат = СтруктураURI(АдресСервиса);
	
	Возврат Результат;
	
КонецФункции

Функция Часовой_ПолучитьПараметры()
	
	КлючКэш = "ПараметрыЧасового";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТекущаяДатаПроверки = ТекущаяДата();
	
	ОбщиеПараметры = Неопределено;
	Параметры = БезопасноеХранилище_Прочитать(ОбщиеПараметры, КлючКэш);
	Если Параметры <> Неопределено Тогда
		Результат = Новый_ПараметрыЧасового();
		ЗаполнитьЗначенияСвойств(Результат, Параметры);
		Если НачалоДня(Результат.checking_date) = НачалоДня(ТекущаяДатаПроверки) Тогда
			Кэш_Поместить(КлючКэш, Результат);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Контент = КонтентДляПроверкиОбновления();
	Продукт = Перечисление_ПродуктыВСервисеОбновлений().ПараметрыЧасового;
	
	Попытка
		Ответ = СервисОбновлений_ПроверитьОбновления(Контент, Продукт);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Чтение параметров сервиса сбора ошибок'");
		ОбработатьОшибку(Действие, Ошибка);
		Возврат Неопределено;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или Не ЗначениеЗаполнено(Ответ.description) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый_ПараметрыЧасового();
	Параметры = ЗначениеИзСтрокиJSON(Ответ.description);
	ЗаполнитьЗначенияСвойств(Результат, Параметры);
	Результат.checking_date = ТекущаяДатаПроверки;
	
	БезопасноеХранилище_Записать(ОбщиеПараметры, Результат, КлючКэш);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Процедура Часовой_ОтправитьОписаниеОшибкиHTTP(ОписаниеОтвета, ОписаниеЗапроса)
	
	ПараметрыЧасового = Часовой_ПолучитьПараметры();
	Если Не ЗначениеЗаполнено(ПараметрыЧасового) Тогда
		Возврат;
	КонецЕсли;
	
	Если ОписаниеЗапроса.Хост = Часовой_ОписаниеСервиса(ПараметрыЧасового).Хост Тогда
		Возврат;
	КонецЕсли;
	
	Контент = Часовой_ОписаниеОшибкиHTTP(ОписаниеОтвета, ОписаниеЗапроса, ПараметрыЧасового);
	
	Попытка
		Часовой_ОтправитьВСервис(Контент, ПараметрыЧасового);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Отправка информации в сервис сбора ошибок'");
		ОбработатьОшибку(Действие, Ошибка);
	КонецПопытки;
	
КонецПроцедуры

Процедура Часовой_ДополнитьКонтентКонтекстом(Контент)
	
	ИнформацияОКонфигурации = ИнформацияОКонфигурации();
	ИнформацияОСистеме = ИнформацияОСистеме();
	
	Контент["contexts"].Вставить("device", Новый Соответствие);
	Контент["contexts"]["device"].Вставить("type", "device");
	Контент["contexts"]["device"].Вставить("name", ИмяКомпьютера());
	Контент["contexts"]["device"].Вставить("memory_size", ИнформацияОСистеме.ОперативнаяПамять);
	Контент["contexts"]["device"].Вставить("processor", ИнформацияОСистеме.Процессор);
	
	Контент["contexts"].Вставить("os", Новый Соответствие);
	Контент["contexts"]["os"].Вставить("name", "windows");
	Контент["contexts"]["os"].Вставить("version", ИнформацияОСистеме.ВерсияОС);
	
	Контент["contexts"].Вставить("app", Новый Соответствие);
	Контент["contexts"]["app"].Вставить("name", ИнформацияОКонфигурации.Конфигурация);
	Контент["contexts"]["app"].Вставить("type", "runtime");
	Контент["contexts"]["app"].Вставить("version", ИнформацияОКонфигурации.ВерсияКонфигурации);
	
	Контент["contexts"].Вставить("platform", Новый Соответствие);
	Контент["contexts"]["platform"].Вставить("type", "app");
	Контент["contexts"]["platform"].Вставить("name", "1С");
	Контент["contexts"]["platform"].Вставить("raw_description", Строка(ИнформацияОКонфигурации.ОсновнойРежимЗапуска));
	Контент["contexts"]["platform"].Вставить("version", ИнформацияОСистеме.ВерсияПриложения);

КонецПроцедуры

Функция КонтентДляПроверкиОбновления(ТекущаяВерсия = Неопределено) Экспорт
	
	Настройки = НастройкиМодуля();
	ТестовоеОкружение = Настройки.ТестовоеОкружение;
	ИдентификаторЭкземпляра = Настройки.ИдентификаторЭкземпляраМодуля;
	
	Результат = Новый Структура;
	
	Результат.Вставить("client_id", ИдентификаторЭкземпляра);
	Результат.Вставить("client_is_test", ТестовоеОкружение);
	
	Результат.Вставить("conf_name", Метаданные.Имя);
	Результат.Вставить("conf_version", Метаданные.Версия);
	Результат.Вставить("platform_version", МодульОбщегоНазначения().ВерсияПлатформы());
	
	Если ЗначениеЗаполнено(ТекущаяВерсия) Тогда
		Результат.Вставить("version", ТекущаяВерсия);
	Иначе
		Результат.Вставить("version", ПустаяВерсия());
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

