Функция Контент_РегистрацияНаборов(ОписаниеОперации)
	
	Операция = ОписаниеОперации.Ссылка;
	ОперацияОснование = Операция.ОперацияОснование;
	ОписаниеОснования = Операция_ПрочитатьОперацию(ОперацияОснование);
	КлючСтрокиОперации = ОписаниеОперации.КлючСтрокиОперацииОснования;
	
	Результат = Новый Структура;
	Результат.Вставить("documentNumber", ОписаниеОперации.Номер);
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ОписаниеОперации.ВидПродукции));
	
	aggregationUnits = Новый Массив;
	
	КэшТоваров = Новый Соответствие;
	КэшСоставаНаборов = Новый Соответствие;
	
	Стр = ОписаниеОснования.Товары.Найти(КлючСтрокиОперации, "КлючСтрокиОперации");
	
	Наименование = НаименованиеПозицииДляКонтента(Стр);
	КодыМаркировки = КодыОпераций_КодыМаркировки(ОперацияОснование, КлючСтрокиОперации, Ложь);
	
	ТаблицаКодов = КодыОпераций_Прочитать(ОперацияОснование, КлючСтрокиОперации);
	ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	СоставНабора = КэшСоставаНаборов.Получить(Стр.Товар);
	Если СоставНабора = Неопределено Тогда
		
		setItems = Новый Массив;
		
		КоличествоВложений = 0;
		ОписаниеТовара = Товар_Прочитать(Стр.Товар, КэшТоваров);
		Для Каждого Элемент Из ОписаниеТовара.СоставНабора Цикл
			
			item = Новый Структура;
			item.Вставить("name", Элемент.ВложенныйТовар.Наименование);
			item.Вставить("codesCapacity", Элемент.КоличествоВложений);
			setItems.Добавить(item);
			
			КоличествоВложений = КоличествоВложений + Элемент.КоличествоВложений;
			
		КонецЦикла;
		
		СоставНабора = Новый Структура;
		СоставНабора.Вставить("setCodesCapacity", КоличествоВложений);
		СоставНабора.Вставить("setItems", setItems);
		
		КэшСоставаНаборов.Вставить(Стр.Товар, СоставНабора);
		
	КонецЕсли;
	
	Для каждого КодМаркировки Из КодыМаркировки Цикл
		
		unit = Новый Структура;
		unit.Вставить("setName", Наименование);
		unit.Вставить("kinCode", КодМаркировки);
		unit.Вставить("setCodesCapacity", СоставНабора.setCodesCapacity);
		unit.Вставить("setItems", СоставНабора.setItems);
		
		ПараметрыОтбора = Новый Структура("КодАгрегата", КодМаркировки);
		СтрокиКодов = ТаблицаКодов.НайтиСтроки(ПараметрыОтбора);
		sntins = Новый Массив;
		Для Каждого СтрКода Из СтрокиКодов Цикл
			sntins.Добавить(СтрКода.КодМаркировки);
		КонецЦикла;
		
		unit.Вставить("sntins", sntins);
		
		aggregationUnits.Добавить(unit);
		
	КонецЦикла;
	
	Результат.Вставить("aggregationUnits", aggregationUnits);
	
	Возврат Результат;
	
КонецФункции

Функция Контент_ВозвратВОборотНаТСД(ОписаниеОперации)
	
	ВидыДокументов = Перечисление_ВидыПервичныхДокументов();
	ПричиныВозвратаВОборот = Перечисление_ПричиныВозвратаВОборот();
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ПричинаВозвратаВОборот = ДопРеквизиты.ПричинаВозвратаВОборот;
	ВидПервичногоДокумента = ДопРеквизиты.ВидПервичногоДокумента;
	
	Результат = Новый Структура;
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ОписаниеОперации.ВидПродукции));
	Результат.Вставить("documentNumber", ОписаниеОперации.Номер);
	
	Если ПричинаВозвратаВОборот = ПричиныВозвратаВОборот.ДистанционныйСпособПродажи Тогда
		Результат.Вставить("isPaid", ДопРеквизиты.ТоварОплачен);
	КонецЕсли;
	
	Результат.Вставить("returnType", ВидВозвратаВОборотВСервисе(ПричинаВозвратаВОборот));
	
	Если ПричинаВозвратаВОборот = ПричиныВозвратаВОборот.ГосТайна Тогда
		Результат.Вставить("stateContractId", ДопРеквизиты.ИдентификаторГосКонтракта);
	КонецЕсли;
	
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "primaryDocumentNumber", ДопРеквизиты.НомерДокумента);
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "primaryDocumentDate", ДопРеквизиты.ДатаДокумента);
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "comment", ОписаниеОперации.Комментарий);
	
	Если ЗначениеЗаполнено(ВидПервичногоДокумента) Тогда
		Результат.Вставить("primaryDocumentType", ТипПервичногоДокументаВСервисе(ВидПервичногоДокумента));
	КонецЕсли;
	
	Если ВидПервичногоДокумента = ВидыДокументов.Прочее Тогда
		Результат.Вставить("primaryDocumentName", ДопРеквизиты.НаименованиеПервичногоДокумента);
	КонецЕсли;
	
	products = Новый Массив;
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		
		ВидДокументаСертификации = Стр.ВидДокументаСертификации;
		НомерДокументаСертификации = Стр.НомерДокументаСертификации;
		ДатаДокументаСертификации = Стр.ДатаДокументаСертификации;
		
		product = Новый Структура;
		product.Вставить("name", НаименованиеПозицииДляКонтента(Стр));
		product.Вставить("quantity", Стр.КоличествоУпаковок);
		
		certificate = Новый Структура;
		ДобавитьЗаполненноеЗначениеВСтруктуру(certificate, "type", СертификатВСервисе(ВидДокументаСертификации));
		ДобавитьЗаполненноеЗначениеВСтруктуру(certificate, "number", НомерДокументаСертификации);
		ДобавитьЗаполненноеЗначениеВСтруктуру(certificate, "date", ДатаДокументаСертификации);
		ДобавитьЗаполненноеЗначениеВСтруктуру(product, "certificate", certificate);
		
		products.Добавить(product);
		
	КонецЦикла;
	
	Результат.Вставить("products", products);
	
	Возврат Результат;
	
КонецФункции

Функция Контент_ВозвратВОборот(ОписаниеОперации)
	
	ВидыДокументов = Перечисление_ВидыПервичныхДокументов();
	ПричиныВозвратаВОборот = Перечисление_ПричиныВозвратаВОборот();
	
	Операция = ОписаниеОперации.Ссылка;
