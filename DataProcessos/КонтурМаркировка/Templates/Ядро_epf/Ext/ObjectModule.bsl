// Опеределяет тип корректировки сведений о кодах в терминах сервиса
//
// Параметры:
//  ТипКоррректировки - Строка - см. Перечисление_ТипыКорректировокСведенийОКодах()
// 
// Возвращаемое значение:
//  Строка - тип корректировки сведений о кодах в терминах сервиса
//
Функция ТипКорректировкиСведенийОКодахВСервисе(ТипКоррректировки)
	
	ТипыКорректировок = Перечисление_ТипыКорректировокСведенийОКодах();
	
	Если ТипКоррректировки = ТипыКорректировок.ДобавлениеСведений Тогда
		Результат = "Add";
	ИначеЕсли ТипКоррректировки = ТипыКорректировок.ЗаменаВсехСведений Тогда
		Результат = "Replace";
	Иначе
		ТекстСообщения = НСтр("ru = 'Неизвестный тип корректировки сведений о кодах: %1'");
		ТекстСообщения = ПараметрыВСтроку(ТекстСообщения, ТипКоррректировки);
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТипШтрихкодаПоТипуКодаМаркировкиИзСервиса(ТипКодаМаркировкиВСервисе)
	
	КлючКэш = "ТипШтрихкодаПоТипуКодаМаркировкиИзСервиса: " + ТипКодаМаркировкиВСервисе;
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СоответствиеТипов = Новый Соответствие;
	СоответствиеТипов.Вставить(НРег("TtisAggregate"), Перечисления.КонтурМаркировка_ТипыШтрихкодов.Code128);
	СоответствиеТипов.Вставить(НРег("Transport"), Перечисления.КонтурМаркировка_ТипыШтрихкодов.GS1_128);
	СоответствиеТипов.Вставить(НРег("Sscc"), Перечисления.КонтурМаркировка_ТипыШтрихкодов.SSCC);
	СоответствиеТипов.Вставить(НРег("Uit"), Перечисления.КонтурМаркировка_ТипыШтрихкодов.GS1_DataMatrix);
	СоответствиеТипов.Вставить(НРег("Group"), Перечисления.КонтурМаркировка_ТипыШтрихкодов.GS1_DataMatrix);
	СоответствиеТипов.Вставить(НРег("Consumer"), Перечисления.КонтурМаркировка_ТипыШтрихкодов.GS1_DataMatrix);
	
	Результат = СоответствиеТипов[НРег(ТипКодаМаркировкиВСервисе)];
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

// Опеределяет вид упаковки в терминах 1С по типу кода маркировки из сервиса
//
// Параметры:
//  ВидУпаковки - ПеречислениеСсылка.КонтурМаркировка_ВидыУпаковок - вид упаковки
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.КонтурМаркировка_ТипыУпаковок - тип упаковки
//
Функция ТипУпаковкиПоВидуУпаковки(ВидУпаковки)
	
	Если ВидУпаковки = Перечисления.КонтурМаркировка_ВидыУпаковок.Логистическая
		Или ВидУпаковки = Перечисления.КонтурМаркировка_ВидыУпаковок.Групповая Тогда
		
		Результат = Перечисления.КонтурМаркировка_ТипыУпаковок.МонотоварнаяУпаковка;
		
	ИначеЕсли ВидУпаковки = Перечисления.КонтурМаркировка_ВидыУпаковок.Потребительская Тогда
		
		Результат = Перечисления.КонтурМаркировка_ТипыУпаковок.МаркированныйТовар;
		
	Иначе
		
		Результат = Неопределено;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НаименованиеПозицииДляКонтента(СтрокаТовара, ВзятьИзТовара = Ложь)
	
	НаименованиеТовара = "";
	Если ЗначениеЗаполнено(СтрокаТовара.Товар) Тогда
		НаименованиеТовара = СтрокаТовара.Товар.НаименованиеТовара;
	КонецЕсли;
	
	НаименованиеНоменклатуры = "";
	Если ЗначениеЗаполнено(СтрокаТовара.КлючНоменклатуры1С) Тогда
		НаименованиеНоменклатуры = КлючНоменклатуры1С_Представление(СтрокаТовара.КлючНоменклатуры1С);
	КонецЕсли;
	
	Если ВзятьИзТовара И ЗначениеЗаполнено(НаименованиеТовара) Тогда
		Результат = НаименованиеТовара;
	ИначеЕсли ЗначениеЗаполнено(НаименованиеНоменклатуры) Тогда
		Результат = НаименованиеНоменклатуры;
	Иначе
		Результат = НаименованиеТовара;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет статус кода маркировки в терминах 1С по статусу из сервиса
//
// Параметры:
//  CisInfo - Соответствие - см. элементы результата функции Маркировка_СтатусыКодов();
// 
// Возвращаемое значение:
//  Строка - см. Перечисление_СтатусыКодов()
//
Функция СтатусКодаПоСтатусуИзСервиса(CisInfo) Экспорт
	
	Если Не ЗначениеЗаполнено(CisInfo) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	error = CisInfo["error"];
	Если СтатусКодаСодержитОшибкуНеНайден(error) Тогда
		Возврат Перечисление_СтатусыКодов().НеНайден;
	КонецЕсли;
	Если СтатусКодаСодержитОшибкуНетДоступа(error) Тогда
		Возврат Перечисление_СтатусыКодов().НетДоступа;
	КонецЕсли;
	
	value = CisInfo["value"];
	Если Не ЗначениеЗаполнено(value) Тогда
		Возврат Неопределено;
	КонецЕсли;
	status = value["status"];
	Если Не ЗначениеЗаполнено(status) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = СоответствиеСтатусовКодов().Получить(НРег(status));
	Если Не ЗначениеЗаполнено(Результат) Тогда
		ТекстОшибки = НСтр("ru = 'Неизвестный статус кода в сервисе: %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, status);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтатусКодаСодержитОшибкуНеНайден(error)
	
	Возврат Найти(НРег(error), НРег("Не найден")) > 0;
	
КонецФункции

Функция СтатусКодаСодержитОшибкуНетДоступа(error)
	
	Возврат Найти(НРег(error), НРег("Нет доступа")) > 0;
	
КонецФункции

// Опеределяет вид продукции по товарной группе в терминах сервиса
//
// Параметры:
//  ТоварнаяГруппа - Строка - товарная группа;
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.КонтурМаркировка_ВидыПродукции - вид продукции
//
Функция ВидПродукцииПоТоварнойГруппеИзСервиса(ТоварнаяГруппа) Экспорт
	
	Если Не ЗначениеЗаполнено(ТоварнаяГруппа) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КлючКэш = "ВидПродукцииПоТоварнойГруппеИзСервиса: " + ТоварнаяГруппа;
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТГ = ТоварнаяГруппа;
	Если НРег(ТГ) = НРег("Bicycle") Тогда
		ТГ = "Bikes";
	КонецЕсли;
	
	Результат = СоответствиеТоварныхГруппИВидовПродукции().Получить(НРег(ТГ));
	
	Если Результат = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось определить вид продукции по товарной группе из сервиса: %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ТоварнаяГруппа);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ТипУпаковкиГИСМТПоТипуУпаковкиИзСервиса(ТипУпаковкиВСервисе)
	
	КлючКэш = "ТипУпаковкиПоТипуКодаМаркировкиИзСервиса: " + ТипУпаковкиВСервисе;
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипыУпаковок = Перечисление_ТипыУпаковокГИСМТ();
	
	СоответствиеТипов = Новый Структура;
	СоответствиеТипов.Вставить(НРег("BUNDLE"), ТипыУпаковок.Комплект);
	СоответствиеТипов.Вставить(НРег("UNIT")	 , ТипыУпаковок.ЕдиницаТовара);
	СоответствиеТипов.Вставить(НРег("ATK")	 , ТипыУпаковок.АТК);
	СоответствиеТипов.Вставить(НРег("SET")	 , ТипыУпаковок.Набор);
	СоответствиеТипов.Вставить(НРег("GROUP") , ТипыУпаковок.ГрупповаяУпаковка);
	
	СоответствиеТипов.Вставить(НРег("LEVEL1"), ТипыУпаковок.Упаковка1Уровня);
	СоответствиеТипов.Вставить(НРег("LEVEL2"), ТипыУпаковок.Упаковка2Уровня);
	СоответствиеТипов.Вставить(НРег("LEVEL3"), ТипыУпаковок.Упаковка3Уровня);
	СоответствиеТипов.Вставить(НРег("LEVEL4"), ТипыУпаковок.Упаковка4Уровня);
	СоответствиеТипов.Вставить(НРег("LEVEL5"), ТипыУпаковок.Упаковка5Уровня);
	
	СоответствиеТипов.Вставить("Unknown", ТипыУпаковок.НеОпределен);
	
	Результат = СоответствиеТипов[НРег(ТипУпаковкиВСервисе)];
	
	Если Результат = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Неизвестный тип упаковки в сервисе: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, ТипУпаковкиВСервисе);
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

// Определяет общий тип упаковки терминах 1С по общему типу упаковки из сервиса
//
// Параметры:
//  ОбшийТипУпаковкиВСервисе - Строка - общий тип упаковки из сервиса
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.КонтурМаркировка_ОбщиеТипыУпаковок
//
Функция ОбщийТипУпаковкиПоОбщемуТипуУпаковкиИзСервиса(ОбшийТипУпаковкиВСервисе) Экспорт
	
	Если Не ЗначениеЗаполнено(ОбшийТипУпаковкиВСервисе) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КлючКэш = "ОбщийТипУпаковкиПоОбщемуТипуУпаковкиИзСервиса: " + ОбшийТипУпаковкиВСервисе;
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОбщиеТипыУпаковок = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок;
	
	СоответствиеТипов = Новый Структура;
	СоответствиеТипов.Вставить(НРег("Unit"), ОбщиеТипыУпаковок.ЕдиницаТовара);
	СоответствиеТипов.Вставить(НРег("Group"), ОбщиеТипыУпаковок.ГрупповаяУпаковка);
	СоответствиеТипов.Вставить(НРег("Bundle"), ОбщиеТипыУпаковок.Комплект);
	СоответствиеТипов.Вставить(НРег("Set"), ОбщиеТипыУпаковок.Набор);
	СоответствиеТипов.Вставить(НРег("Atk"), ОбщиеТипыУпаковок.АТК);
	СоответствиеТипов.Вставить(НРег("Box"), ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	
	Результат = СоответствиеТипов[НРег(ОбшийТипУпаковкиВСервисе)];
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		ТекстОшибки = НСтр("ru = 'Неизвестный тип упаковки кода маркировки в сервисе: %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ОбшийТипУпаковкиВСервисе);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

// Определяет способ выпуска товаров в терминах 1С по способу выпуска из сервиса
//
// Параметры:
//  СпособВыпускаВСервисе - Строка	 - способ выпуска товаров из сервиса
// 
// Возвращаемое значение:
//  Строка - см. Перечисление_СпособыВыпускаТоваров()
//
Функция СпособВыпускаТоваровПоСпособуВыпускаИзСервиса(СпособВыпускаВСервисе) Экспорт
	
	Если Не ЗначениеЗаполнено(СпособВыпускаВСервисе) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КлючКэш = "СпособВыпускаТоваровПоСпособуВыпускаИзСервиса: " + СпособВыпускаВСервисе;
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = СоответствиеСпособовВыпускаТоваров().Получить(НРег(СпособВыпускаВСервисе));
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

// Опеределяет товарную группу в терминах сервиса по виду продукции
//
// Параметры:
//  ВидПродукции - ПеречислениеСсылка.КонтурМаркировка_ВидыПродукции - вид продукции
// 
// Возвращаемое значение:
//  Строка - товарная группа в терминах сервиса
//
Функция ТоварнаяГруппаВСервисе(ВидПродукции) Экспорт
	
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		Возврат "";
	КонецЕсли;
	
	Результат = СоответствиеВидовПродукцииИТоварныхГрупп().Получить(ВидПродукции);
	
	Если Результат = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось определить товарную группу в сервисе по виду продукции: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, ВидПродукции);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Соответствие между видами продукции в 1С и товарными группами в сервисе
// 
// Возвращаемое значение:
//  Соответствие - содержит:
//   * Ключ - ПеречислениеСсылка.Перечисления.КонтурМаркировка_ВидыПродукции - вид продукции;
//   * Значение - Строка - товарная группа;
//
Функция СоответствиеВидовПродукцииИТоварныхГрупп()
	
	КлючКэш = "СоответствиеВидовПродукцииИТоварныхГрупп";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Новый Соответствие;
	Для каждого Элемент Из СоответствиеТоварныхГруппИВидовПродукции() Цикл
		Результат.Вставить(Элемент.Значение, Элемент.Ключ);
	КонецЦикла;
	
	Результат = Новый ФиксированноеСоответствие(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
