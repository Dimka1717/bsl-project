// #Область Контрагенты

Функция Контрагент_Подобрать(ИНН, КПП = "", Наименование = "", КэшРезультатов = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		Возврат Справочники.КонтурМаркировка_Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		Результат = КэшРезультатов[ИНН+КПП];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Наименование КАК Наименование,
	|	Т.Ссылка КАК Ссылка,
	|	Т.КПП КАК КПП
	|ИЗ
	|	Справочник.КонтурМаркировка_Контрагенты КАК Т
	|ГДЕ
	|	Т.ИНН = &ИНН
	|	И Т.КПП = &КПП
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Наименование,
	|	Т.Ссылка,
	|	Т.КПП
	|ИЗ
	|	Справочник.КонтурМаркировка_Контрагенты КАК Т
	|ГДЕ
	|	Т.ИНН = &ИНН
	|	И Т.КПП = """"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Наименование,
	|	Т.Ссылка,
	|	Т.КПП
	|ИЗ
	|	Справочник.КонтурМаркировка_Контрагенты КАК Т
	|ГДЕ
	|	Т.ИНН = &ИНН
	|	И &КПП = """"");
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Результат = Выборка.Ссылка;
		
		Если ЗначениеЗаполнено(Наименование)
			И Не ЗначениеЗаполнено(Выборка.Наименование) Тогда
			КонтрагентОбъект = Результат.ПолучитьОбъект();
			КонтрагентОбъект.Наименование = Наименование;
			КонтрагентОбъект.Записать();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КПП)
			И Не ЗначениеЗаполнено(Выборка.КПП) Тогда
			КонтрагентОбъект = Результат.ПолучитьОбъект();
			КонтрагентОбъект.КПП = КПП;
			КонтрагентОбъект.Записать();
		КонецЕсли;
		
	Иначе
		Результат = Контрагент_Записать(Наименование, ИНН, КПП);
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(ИНН+КПП, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Контрагент_Записать(Наименование, ИНН, КПП)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Контрагенты_Заблокировать(ИНН, КПП);
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурМаркировка_Контрагенты КАК Т
		|ГДЕ
		|	Т.ИНН = &ИНН
		|	И Т.КПП = &КПП");
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Запрос.УстановитьПараметр("КПП", КПП);
		
		Ссылка = ПолучитьРезультатЗапроса(Запрос);
		
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Объект = Ссылка.ПолучитьОбъект();
		Иначе
			Объект = Справочники.КонтурМаркировка_Контрагенты.СоздатьЭлемент();
		КонецЕсли;
		
		Объект.Наименование = Наименование;
		Объект.ИНН = ИНН;
		Объект.КПП = КПП;
		Объект.Записать();
		
		Результат = Объект.Ссылка;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура Контрагенты_Заблокировать(ИНН, Знач КПП)
	
	Если Не ЗначениеЗаполнено(КПП) Тогда
		КПП = "";
	КонецЕсли;
	
	Значения = Новый Структура;
	Значения.Вставить("ИНН", ИНН);
	Значения.Вставить("КПП", КПП);
	Объект = "Справочник.КонтурМаркировка_Контрагенты";
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		ЗаблокироватьПоЗначениямДляИзменения(Объект, Значения);
		Возврат;
	КонецЕсли;
	
	Если Не ПоддерживаютсяПоляБлокировкиДанных() Тогда
		Возврат;
	КонецЕсли;
	
	ЗаблокироватьПоЗначениям(Объект, Значения);
	
КонецПроцедуры

// #КонецОбласти // Контрагенты

// #Область ОчисткаУстаревшихДанных

// Выполняет отчистку устаревших кодов в пуле, операциях и т.п.
//
Процедура ОчиститьУстаревшиеДанные() Экспорт
	
	Если НастройкиМодуля().РежимТестирования Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		УдалитьКодыУстаревшихЗаказов();
		УдалитьКодыУстаревшихОпераций();
		АрхивироватьКодыУстаревшихДокументов();
		УдалитьУстаревшиеПолныеКоды();
		УдалитьУстаревшиеКоды();
		УдалитьУстаревшиеПриемкиИВходящиеУПД();
		УдалитьУстаревшиеАрхивыСКодамиДокументов();
		УдалитьУстаревшуюИсториюЗапросовВСервис();
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Действие = Перечисление_ПредставленияКомандОбработки().ОчисткаУстаревшихДанных;
		ТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		ОбработатьОшибку(Действие, ТекстОшибки);
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура УдалитьКодыУстаревшихЗаказов()
	
	Для каждого ЗаказКодов Из ЗаказыСИстекшимСрокомЖизниКодов() Цикл
		КодыЗаказов_Удалить(ЗаказКодов)
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьКодыУстаревшихОпераций()
	
	ПериодХранения = НастройкиМодуля().ПериодХраненияКодовВЗавершенныхОперациях;
	Если Не ЗначениеЗаполнено(ПериодХранения) Тогда
		Возврат;
	КонецЕсли;
	
	АктуальнаяДатаХранения = НачалоДня(ТекущаяДата()) - ПериодХранения * СекундВСутках();
	ЗавершенныеОперации = УстаревшиеОперацииСКодами(АктуальнаяДатаХранения);
	
	Для Каждого Операция Из ЗавершенныеОперации Цикл
		НачатьТранзакцию(РежимУправленияБлокировкой());
		Попытка
			
			КодыОпераций_Заблокировать(Операция);
			
			Набор = РегистрыСведений.КонтурМаркировка_КодыОпераций.СоздатьНаборЗаписей();
			Набор.Отбор.Операция.Установить(Операция);
			Набор.Прочитать();
			
			КлючиКодов = Набор.ВыгрузитьКолонку("КлючКода");
			
			Набор.Очистить();
			Набор.Записать();
			
			Набор = РегистрыСведений.КонтурМаркировка_КоличествоКодовОпераций.СоздатьНаборЗаписей();
			Набор.Отбор.Операция.Установить(Операция);
			Набор.Записать();
			
			УстаревшиеКоды_Записать(КлючиКодов);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			Ошибка = ИнформацияОбОшибке();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Процедура АрхивироватьКодыУстаревшихДокументов()
	
	ПериодХраненияКодов = НастройкиМодуля().ПериодХраненияКодовВЗавершенныхДокументах;
	Если Не ЗначениеЗаполнено(ПериодХраненияКодов) Тогда
		Возврат;
	КонецЕсли;
	
	АктуальнаяДатаХранения = НачалоДня(ТекущаяДата()) - ПериодХраненияКодов * СекундВСутках();
	ЗавершенныеДокументы = УстаревшиеДокументыСКодами(АктуальнаяДатаХранения);
	
	Для Каждого ДокументУчета Из ЗавершенныеДокументы Цикл
		НачатьТранзакцию(РежимУправленияБлокировкой());
		Попытка
			КодыДокументов_Заблокировать(ДокументУчета);
			КодыДокументов_ПереместитьВАрхив(ДокументУчета);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			Ошибка = ИнформацияОбОшибке();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьУстаревшиеПолныеКоды()
	
	Настройки = НастройкиМодуля();
	ТипыСтатусов = Перечисление_ТипыСтатусов();
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыДокументовУчета = Перечисление_СтатусыДокументовУчета();
	СобытияДляОчистки = Перечисление_СобытияДляУдаленияПолныхКодов();
	
	Если Не ЗначениеЗаполнено(Настройки.ПериодХраненияПолныхКодов)
		Или Не ЗначениеЗаполнено(Настройки.СобытиеДляУдаленияПолныхКодов) Тогда
		Возврат;
	КонецЕсли;
	
	АктуальнаяДатаПечати = НачалоДня(ТекущаяДата()) - Настройки.ПериодХраненияПолныхКодов * СекундВСутках();
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	Если Настройки.СобытиеДляУдаленияПолныхКодов = СобытияДляОчистки.ПослеЗавершенияПечати Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	СвязиКлючейКодов.КлючКода КАК КлючКода,
		|	КодыМаркировки.ПорцияЗаписей КАК ПорцияЗаписей,
		|	КодыМаркировки.ФайлСПолнымКодом КАК ФайлСПолнымКодом
		|ПОМЕСТИТЬ КлючиКодов
		|ИЗ
		|	РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
		|		ПО ИнформацияОКодах.КлючИнформацииОКоде = СвязиКлючейКодов.КлючИнформацииОКоде
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
		|		ПО (СвязиКлючейКодов.КлючКода = КодыМаркировки.КлючКода)
		|ГДЕ
		|	ИнформацияОКодах.ДатаПечати МЕЖДУ &НачДата И &КонДата
		|	И КодыМаркировки.ФайлСПолнымКодом <> &ПустойФайл
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	КлючКода";
		
	Иначе
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	СвязиКлючейКодов.КлючКода КАК КлючКода,
		|	КодыМаркировки.ПорцияЗаписей КАК ПорцияЗаписей,
		|	КодыМаркировки.ФайлСПолнымКодом КАК ФайлСПолнымКодом
		|ПОМЕСТИТЬ КлючиКодов
		|ИЗ
		|	РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
		|		ПО СтатусыКодов.КлючСтатусаКода = СвязиКлючейКодов.КлючСтатусаКода
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
		|		ПО (СвязиКлючейКодов.КлючКода = КодыМаркировки.КлючКода)
		|ГДЕ
		|	СтатусыКодов.ДатаВводаВОборот МЕЖДУ &НачДата И &КонДата
		|	И КодыМаркировки.ФайлСПолнымКодом <> &ПустойФайл
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	КлючКода";
		
		
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("НачДата", '00010101' + 1);
	Запрос.УстановитьПараметр("КонДата", АктуальнаяДатаПечати - 1);
	Запрос.УстановитьПараметр("ПустойФайл", Справочники.КонтурМаркировка_Файлы.ПустаяСсылка());
	Запрос.Выполнить();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КлючиКодов.КлючКода КАК КлючКода,
	|	КлючиКодов.ПорцияЗаписей КАК ПорцияЗаписей,
	|	КлючиКодов.ФайлСПолнымКодом КАК ФайлСПолнымКодом
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	КлючиКодов КАК КлючиКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ПО КлючиКодов.КлючКода = КодыОпераций.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции КАК Операции
	|		ПО (КодыОпераций.Операция = Операции.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО КлючиКодов.КлючКода = КодыДокументов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета КАК СтатусыДокументов
	|		ПО (КодыДокументов.ДокументУчета = СтатусыДокументов.ДокументУчета)
	|			И (СтатусыДокументов.ТипСтатуса = &ОсновнойСтатус)
	|
	|СГРУППИРОВАТЬ ПО
	|	КлючиКодов.КлючКода,
	|	КлючиКодов.ПорцияЗаписей,
	|	КлючиКодов.ФайлСПолнымКодом
	|
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА Операции.ТипОперации = &ТипОперацииПечатьКодов
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) = ЛОЖЬ И
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА КодыДокументов.ДокументУчета ЕСТЬ NULL
	|					ИЛИ СтатусыДокументов.Статус = &СтатусДокументаЗавершен
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ) = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ КлючиКодов");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ОсновнойСтатус", ТипыСтатусов.ОсновнойСтатус);
	Запрос.УстановитьПараметр("ТипОперацииПечатьКодов", ТипыОпераций.ПечатьКодов);
	Запрос.УстановитьПараметр("СтатусДокументаЗавершен", СтатусыДокументовУчета.Завершен);
	Запрос.Выполнить();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.ФайлСПолнымКодом КАК ФайлСПолнымКодом
	|ИЗ
	|	Результат КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.ПорцияЗаписей КАК ПорцияЗаписей
	|ИЗ
	|	Результат КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.КлючКода КАК КлючКода
	|ИЗ
	|	Результат КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Результат");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	МенеджерВТ.Закрыть();
	
	РезультатЗапросаФайлы = РезультатыЗапроса[0];
	РезультатЗапросаПорцииКодов = РезультатыЗапроса[1];
	РезультатЗапросаКлючиКодов = РезультатыЗапроса[2];
	Если РезультатЗапросаКлючиКодов.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов = РезультатЗапросаКлючиКодов.Выгрузить();
	ТаблицаКодов.Индексы.Добавить("КлючКода");
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Файлы_ЗаблокироватьПоТаблице(РезультатЗапросаФайлы, "ФайлСПолнымКодом");
		КодыМаркировки_ЗаблокироватьПоТаблице(РезультатЗапросаПорцииКодов, "ПорцияЗаписей");
		
		// Удаление полных кодов
		Выборка = РезультатЗапросаФайлы.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ОписаниеФайла = Файл_Прочитать(Выборка.ФайлСПолнымКодом);
			ТаблицаФайла = ОписаниеФайла.ДанныеФайла;
			
			Для Сч = -(ТаблицаФайла.Количество() - 1) По 0 Цикл
				Если ТаблицаКодов.Найти(ТаблицаФайла[-Сч].КлючКода, "КлючКода") <> Неопределено Тогда
					ТаблицаФайла.Удалить(-Сч);
				КонецЕсли;
			КонецЦикла;
			
			Если ЗначениеЗаполнено(ТаблицаФайла) Тогда
				Файл_Записать(ОписаниеФайла);
			Иначе
				Файлы_Удалить(Выборка.ФайлСПолнымКодом);
			КонецЕсли;
			
		КонецЦикла;
		
		// Удаление ссылки на файл из кодов маркировки
		Выборка = РезультатЗапросаПорцииКодов.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Набор = РегистрыСведений.КонтурМаркировка_КодыМаркировки.СоздатьНаборЗаписей();
			Набор.Отбор.ПорцияЗаписей.Установить(Выборка.ПорцияЗаписей);
			Набор.Прочитать();
			
			Для Сч = -(Набор.Количество() - 1) По 0 Цикл
				Стр = Набор.Получить(-Сч);
				Если ТаблицаКодов.Найти(Стр.КлючКода, "КлючКода") <> Неопределено Тогда
					Стр.ФайлСПолнымКодом = Неопределено;
				КонецЕсли;
			КонецЦикла;
			
			Если Набор.Модифицированность() Тогда
				Набор.Записать();
			КонецЕсли;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура УдалитьУстаревшиеКоды()
	
	Неделя = 7; // Чтобы избежать ошибок когда коды удаляются и сразу добавляются в документ или операцию
	АктуальнаяДатаЗаписей = НачалоДня(ТекущаяДата()) - Неделя * СекундВСутках();
	ЕстьУстаревшиеКоды = Истина;
	
	// BSLLS:CreateQueryInCycle-off
	
	Пока ЕстьУстаревшиеКоды Цикл
		
		МенеджерВТ = Новый МенеджерВременныхТаблиц;
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КодыМаркировки.ПорцияЗаписей КАК ПорцияЗаписей
		|ПОМЕСТИТЬ ПерваяПорция
		|ИЗ
		|	РегистрСведений.КонтурМаркировка_УстаревшиеКоды КАК УстаревшиеКоды
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
		|		ПО УстаревшиеКоды.КлючКода = КодыМаркировки.КлючКода
		|ГДЕ
		|	УстаревшиеКоды.ДатаЗаписи < &АктуальнаяДатаЗаписей
		|
		|УПОРЯДОЧИТЬ ПО
		|	УстаревшиеКоды.ДатаЗаписи
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УстаревшиеКоды.КлючКода КАК КлючКода
		|ПОМЕСТИТЬ ТаблицаКодов
		|ИЗ
		|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_УстаревшиеКоды КАК УстаревшиеКоды
		|		ПО КодыМаркировки.КлючКода = УстаревшиеКоды.КлючКода
		|ГДЕ
		|	УстаревшиеКоды.ДатаЗаписи < &АктуальнаяДатаЗаписей
		|	И КодыМаркировки.ПорцияЗаписей В
		|			(ВЫБРАТЬ ПЕРВЫЕ 1
		|				ПерваяПорция.ПорцияЗаписей
		|			ИЗ
		|				ПерваяПорция)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	КлючКода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ПерваяПорция");
		Запрос.УстановитьПараметр("АктуальнаяДатаЗаписей", АктуальнаяДатаЗаписей);
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
		
		Выборка = Запрос.ВыполнитьПакет().Получить(1).Выбрать();
		Выборка.Следующий();
		ЕстьУстаревшиеКоды = Выборка.Количество > 0;
		
		Если ЕстьУстаревшиеКоды Тогда
			УдалитьПорциюУстаревшихКодов(МенеджерВТ);
		КонецЕсли;
		
		МенеджерВТ.Закрыть();
		
	КонецЦикла;
	
	// BSLLS:CreateQueryInCycle-on
	
	ИнформацияОКодах_УдалитьУстаревшие();
	СтатусыКодовГИСМТ_УдалитьУстаревшие();
	
	// На случай, если предыдущая очистка не удалила порцию кодов после проверки
	УстаревшиеКоды_УдалитьУстаревшие(АктуальнаяДатаЗаписей);
	
КонецПроцедуры

Процедура УдалитьПорциюУстаревшихКодов(МенеджерВТ)
	
	ТаблицаКодов_ВТ_ДобавитьКлючиАгрегатовВерхнегоУровня(МенеджерВТ);
	ТаблицаКодов_ВТ_ДобавитьКлючиВсехВложенныхКодов(МенеджерВТ);
	ТаблицаКодов_ВТ_ДобавитьКолонкуМожноУдалить(МенеджерВТ);
	
	СвязиКлючейКодов_ВТ_ПрочитатьКлючиАгрегатов(МенеджерВТ);
	ТаблицаКодов_ВТ_УточнитьВозможностьУдаленияАгрегатов(МенеджерВТ);
	ТаблицаКодов_ВТ_УточнитьВозможностьУдаленияВложенныхКодов(МенеджерВТ);
	
	Если ТаблицаКодов_ВТ_ЕстьКодыКоторыеМожноУдалить(МенеджерВТ) Тогда
		
		НачатьТранзакцию(РежимУправленияБлокировкой());
		Попытка
			КодыМаркировки_ВТ_Удалить(МенеджерВТ);
			ТоварыАгрегатов_ВТ_Удалить(МенеджерВТ);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			Ошибка = ИнформацияОбОшибке();
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЕсли;
	
	// Не требуется обеспечивать консистентность данных
	УстаревшиеКоды_ВТ_Удалить(МенеджерВТ);
	
КонецПроцедуры

Процедура УдалитьУстаревшиеПриемкиИВходящиеУПД()
	
	ПериодХранения = НастройкиМодуля().ПериодХраненияПриемокИВходящихУПД;
	Если Не ЗначениеЗаполнено(ПериодХранения) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	АктуальнаяДатаХранения = НачалоДня(ТекущаяДата()) - ПериодХранения * СекундВСутках();
	
	Для Каждого Операция Из УстаревшиеОперации(ТипыОпераций.ВходящийУПД, АктуальнаяДатаХранения) Цикл
		Операции_Удалить(Операция);
	КонецЦикла;
	
	Для Каждого Операция Из УстаревшиеОперации(ТипыОпераций.УведомлениеОПриемке, АктуальнаяДатаХранения) Цикл
		Операции_Удалить(Операция);
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьУстаревшиеАрхивыСКодамиДокументов()
	
	ПериодХранения = НастройкиМодуля().ПериодХраненияКодовДокументовВАрхиве;
	Если Не ЗначениеЗаполнено(ПериодХранения) Тогда
		Возврат;
	КонецЕсли;
	
	АктуальнаяДатаСоздания = НачалоДня(ТекущаяДата()) - ПериодХранения * СекундВСутках();
	ТипФайла = Перечисление_ТипыФайлов().КодыДокумента;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Файлы КАК Т
	|ГДЕ
	|	Т.ТипФайла = &ТипФайла
	|	И Т.ДатаСоздания < &АктуальнаяДатаСоздания");
	Запрос.УстановитьПараметр("ТипФайла", ТипФайла);
	Запрос.УстановитьПараметр("АктуальнаяДатаСоздания", АктуальнаяДатаСоздания);
	
	Файлы_Удалить(МассивИзРезультатаЗапроса(Запрос));
	
КонецПроцедуры

Процедура УдалитьУстаревшуюИсториюЗапросовВСервис()
	
	СрокХраненияЛогов = 7;
	
	ТипФайла = Перечисление_ТипыФайлов().ДеталиЗапросаВСервис;
	ГраницаХраненияЛогов = НачалоДня(ТекущаяДата()) - (СрокХраненияЛогов * СекундВСутках());
	УдалитьЛогиУспешныхОпераций = НастройкиМодуля().НеХранитьЛогиУспешныхОпераций;
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	СтатусыУспешнойОперации = Новый Массив;
	СтатусыУспешнойОперации.Добавить(СтатусыОпераций.ОперацияЗавершена);
	СтатусыУспешнойОперации.Добавить(СтатусыОпераций.ОперацияОтменена);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Файлы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Файлы КАК Файлы
	|ГДЕ
	|	Файлы.ВладелецФайла ССЫЛКА Справочник.КонтурМаркировка_Операции
	|	И Файлы.ДатаСоздания < &ГраницаХраненияЛогов
	|	И Файлы.ТипФайла = &ТипФайла
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Файлы.Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Файлы КАК Файлы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК УспешныеОперации
	|		ПО Файлы.ВладелецФайла = УспешныеОперации.Операция
	|			И (УспешныеОперации.Статус В (&СтатусыУспешнойОперации))
	|ГДЕ
	|	&УдалитьЛогиУспешныхОпераций
	|	И Файлы.ВладелецФайла ССЫЛКА Справочник.КонтурМаркировка_Операции
	|	И Файлы.ДатаСоздания >= &ГраницаХраненияЛогов
	|	И Файлы.ТипФайла = &ТипФайла");
	Запрос.УстановитьПараметр("УдалитьЛогиУспешныхОпераций", УдалитьЛогиУспешныхОпераций);
	Запрос.УстановитьПараметр("СтатусыУспешнойОперации", СтатусыУспешнойОперации);
	Запрос.УстановитьПараметр("ГраницаХраненияЛогов", ГраницаХраненияЛогов);
	Запрос.УстановитьПараметр("ТипФайла", ТипФайла);
	
	Файлы_Удалить(МассивИзРезультатаЗапроса(Запрос));
	
КонецПроцедуры

Функция ЗаказыСИстекшимСрокомЖизниКодов()
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ПоместитьТаблицуВЗапрос(МенеджерВТ, СрокиЖизниКодовПоВидамПродукции(), "СрокиЖизниКодов", "ВидПродукции");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КодыЗаказов.ЗаказКодов КАК ЗаказКодов,
	|	КодыЗаказов.ЗаказКодов.ВидПродукции КАК ВидПродукции
	|ПОМЕСТИТЬ ПодходящиеЗаказы
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыЗаказов КАК КодыЗаказов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ТипОплатыКодов
	|		ПО КодыЗаказов.ЗаказКодов = ТипОплатыКодов.Объект
	|			И (ТипОплатыКодов.ИмяРеквизита = &ТипОплатыКодов)
	|			И (ТипОплатыКодов.Значение = &ПоНанесению)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВидПродукции
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПодходящиеЗаказы.ЗаказКодов КАК ЗаказКодов
	|ИЗ
	|	ПодходящиеЗаказы КАК ПодходящиеЗаказы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СрокиЖизниКодов КАК СрокиЖизниКодов
	|		ПО ПодходящиеЗаказы.ВидПродукции = СрокиЖизниКодов.ВидПродукции
	|ГДЕ
	|	СрокиЖизниКодов.СрокЖизни - РАЗНОСТЬДАТ(ПодходящиеЗаказы.ЗаказКодов.Дата, &ТекущаяДата, ДЕНЬ) < 1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	БитыеЗаказы.ЗаказКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыЗаказов КАК БитыеЗаказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции КАК Операции
	|		ПО БитыеЗаказы.ЗаказКодов = Операции.Ссылка
	|ГДЕ
	|	Операции.Ссылка ЕСТЬ NULL");
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ТипОплатыКодов", Перечисление_ИменаДопРеквизитов().ТипОплатыКодов);
	Запрос.УстановитьПараметр("ПоНанесению", Перечисление_ТипыОплатыКодов().ПоНанесению);
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДата()));
	
	Возврат МассивИзРезультатаЗапроса(Запрос, "ЗаказКодов");
	
КонецФункции

Функция СрокиЖизниКодовПоВидамПродукции()
	
	КлючКэш = "СрокиЖизниКодовПоВидамПродукции";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("СрокЖизни", ОписаниеТипа_Число());
	Результат.Колонки.Добавить("ВидПродукции", ОписаниеТипа_ВидыПродукции());
	
	УдалятьДоАннулирования = НастройкиМодуля().ПериодУдаленияКодовДляПечатиДоАннулирования;
	
	СрокЖизни = 60;
	Для каждого ВидПродукции Из ВидыПродукцииСоСрокомЖизниКода60Дней() Цикл
		Стр = Результат.Добавить();
		Стр.СрокЖизни = СрокЖизни - УдалятьДоАннулирования;
		Стр.ВидПродукции = ВидПродукции;
	КонецЦикла;
	
	СрокЖизни = 30;
	Для каждого ВидПродукции Из ВидыПродукцииСоСрокомЖизниКода30Дней() Цикл
		Стр = Результат.Добавить();
		Стр.СрокЖизни = СрокЖизни - УдалятьДоАннулирования;
		Стр.ВидПродукции = ВидПродукции;
	КонецЦикла;
	
	СрокЖизни = 999; // Без срока жизни
	Для каждого ВидПродукции Из ВсеВидыПродукции() Цикл
		Если Результат.Найти(ВидПродукции, "ВидПродукции") = Неопределено Тогда
			Стр = Результат.Добавить();
			Стр.СрокЖизни = СрокЖизни;
			Стр.ВидПродукции = ВидПродукции;
		КонецЕсли;
	КонецЦикла;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

