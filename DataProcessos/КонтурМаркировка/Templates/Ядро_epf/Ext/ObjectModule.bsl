// Скачивает файл из интернета по ссылке
//
// Параметры:
//  СсылкаНаФаил - Строка - URL адрес файла в интернете
// 
// Возвращаемое значение:
//  ДвоичныеДанные - скаченный файл
//
Функция СкачатьФайлИзИнтернета(СсылкаНаФаил) Экспорт
	
	Результат = Мок_СкачатьФайлИзИнтернета(СсылкаНаФаил);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОписаниеЗапроса = Новый_ОписаниеЗапросаHTTP();
	СтруктураURI = СтруктураURI(СсылкаНаФаил);
	ЗаполнитьЗначенияСвойств(ОписаниеЗапроса, СтруктураURI);
	ЗаполнитьНастройкиПроксиСервера(ОписаниеЗапроса);
	
	ОписаниеЗапроса.ТелоОтветаКакДвоичныеДанные = Истина;
	
	ОшибкиФайлПеремещен = Новый Массив;
	ОшибкиФайлПеремещен.Добавить(301);
	ОшибкиФайлПеремещен.Добавить(302);
	ОшибкиФайлПеремещен.Добавить(303);
	ОшибкиФайлПеремещен.Добавить(307);
	ОшибкиФайлПеремещен.Добавить(308);
	ДополнитьМассив(ОписаниеЗапроса.ДопустимыеКодыОтвета, ОшибкиФайлПеремещен);
	
	Пока Истина Цикл
		
		Ответ = ВыполнитьHTTPЗапрос(ОписаниеЗапроса);
		ОбработатьОшибкуHTTP(Ответ, ОписаниеЗапроса);
		
		Если Не МассивСодержитЗначение(ОшибкиФайлПеремещен, Ответ.КодОтвета) Тогда
			Прервать;
		КонецЕсли;
		
		НовыйАдрес = Ответ.Заголовки["location"];
		
		Если Найти(НовыйАдрес, "://") Тогда
			СтруктураURI = СтруктураURI(НовыйАдрес);
			ЗаполнитьЗначенияСвойств(ОписаниеЗапроса, СтруктураURI);
		Иначе
			ОписаниеЗапроса.ПутьНаСервере = НовыйАдрес;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = Ответ.ТелоОтвета;
	
	Возврат Результат;
	
КонецФункции

// #Область API_Портала

// Получает ключ зашифрованный открытой частью сертификата
//
// Параметры:
//  ФайлСертификата - ДвоичныеДанные - файл сертификата в формате DER
// 
// Возвращаемое значение:
//  ДвоичныеДанные - зашифрованный ключ
//
Функция Портал_ЗапроситьАвторизацию(ФайлСертификата) Экспорт
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	Портал_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	
	Запрос.Метод = "POST";
	Запрос.ПутьНаСервере = "/auth/v5.17/authenticate-by-cert";
	Запрос.ТелоЗапроса = ФайлСертификата;
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	ОбработатьОшибкуHTTP(Ответ, Запрос);
	
	Контент = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета);
	Результат = Base64Значение(Контент.EncryptedKey);
	
	Возврат Результат;
	
КонецФункции

// Отправляет метрики в сервис без проверки результата
//
// Параметры:
//  Топик - Строка - см. Перечисление_ТопикиМетрики();
//  ПакетСобытий - Массив - содержит Новый_СобытиеМетрики();
//
Процедура Портал_ОтправитьМетрики(Топик, ПакетСобытий)
	
	Если Топик = Перечисление_ТопикиМетрики().Здоровье Тогда
		ТестовоеОкружение = Ложь;
	Иначе
		ТестовоеОкружение = НастройкиМодуля().ТестовоеОкружение;
	КонецЕсли;
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	Портал_ЗаполнитьОбщиеНастройкиHTTPДляМетрик(Запрос, ТестовоеОкружение);
	
	Запрос.Метод = "POST";
	Запрос.ПутьНаСервере = "/metrika-pipe/v1/sources/1CModule/topics/{topic}/events";
	Запрос.Параметры.Вставить("topic", Топик);
	Запрос.ТелоЗапроса = ЗначениеВСтрокуJSON(ПакетСобытий);
	
	ВыполнитьHTTPЗапрос(Запрос);
	
КонецПроцедуры

// Получает новый портальный идентификатор сессии отдавая расшифрованную часть ключа
//
// Параметры:
//  РасшифрованныйКлюч - Строка - base64 строка расшированного ключа, см. Портал_ЗапроситьАвторизацию();
//  ОтпечатокСертификата - Строка - отпечаток сертификата, которым был расшифрован ключ;
// 
// Возвращаемое значение:
//  Строка - новый портальный идентификатор сессии
//
Функция Портал_ПодтвердитьАвторизацию(РасшифрованныйКлюч, ОтпечатокСертификата)
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	Портал_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	
	Запрос.Метод = "POST";
	Запрос.ПутьНаСервере = "/auth/v5.17/approve-cert";
	Запрос.ТелоЗапроса = РасшифрованныйКлюч;
	Запрос.Параметры.Вставить("thumbprint", ОтпечатокСертификата);
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	ОбработатьОшибкуHTTP(Ответ, Запрос);
	
	Возврат ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета);
	
КонецФункции

// Продляет сессию с помощью токена продления
//
// Параметры:
//  Токен - Строка - старый токен;
//  ТокенПродления - Строка - токен продления;
// 
// Возвращаемое значение:
//  Строка - новый портальный идентификатор сессии
//
Функция Портал_ПродлитьАвторизацию(Токен, ТокенПродления)
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	Портал_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	
	Запрос.Метод = "POST";
	Запрос.ПутьНаСервере = "/auth/v5.17/sessions/refresh";
	Запрос.Параметры.Вставить("auth.sid", Токен);
	Запрос.Параметры.Вставить("refresh-token", ТокенПродления);
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	ОбработатьОшибкуHTTP(Ответ, Запрос);
	
	Возврат ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета);
	
