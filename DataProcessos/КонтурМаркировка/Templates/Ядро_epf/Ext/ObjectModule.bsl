	// Настройки отображения в списке
	Результат.Вставить("ПоказатьВСпискеЕслиТоварыНеПодлежатМаркировке", Ложь);
	Результат.Вставить("ПоказатьВСпискеЕслиТоварыНеЗаполнены", Ложь);
	Результат.Вставить("ПоказатьВСпискеЕслиНеПроведен", Ложь);
	
	// Настройки дополнительных колонок
	Результат.Вставить("ДопКолонка1_Формула", "");
	Результат.Вставить("ДопКолонка2_Формула", "");
	Результат.Вставить("ДопКолонка3_Формула", "");
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // НастройкиДокументов

// #Область СтатусыДокументаУчета

Функция СтатусыДокументаУчета_Прочитать(ДокументУчета) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Статус КАК Статус,
	|	Т.ТипСтатуса КАК ТипСтатуса,
	|	Т.ДатаСтатуса КАК ДатаСтатуса
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета КАК Т
	|ГДЕ
	|	Т.ДокументУчета = &ДокументУчета");
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Структура;
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ТипСтатуса, Выборка.Статус);
		Результат.Вставить(ИмяПоляДатаСтатуса(Выборка.ТипСтатуса), Выборка.ДатаСтатуса);
	КонецЦикла;
	
	Если Не Результат.Свойство("ОсновнойСтатус") Тогда
		Результат.Вставить("ОсновнойСтатус", Перечисление_СтатусыДокументовУчета().Новый);
	КонецЕсли;
	
	Если Не Результат.Свойство("ТребуемоеДействие") Тогда
		Результат.Вставить("ТребуемоеДействие", Перечисление_ТребуемыеДействияДокументовУчета().НачатьРаботу);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура СтатусыДокументаУчета_Записать(ДокументУчета, СтатусыДокумента) Экспорт
	
	ДатаНовыхСтатусов = ТекущаяДатаСеанса();
	
	Для каждого Элемент Из СтатусыДокумента Цикл
		
		ТипСтатуса = Элемент.Ключ;
		НовыйСтатус = Элемент.Значение;
		
		Если Лев(ТипСтатуса, 11) = "ДатаСтатуса" Тогда
			Продолжить;
		КонецЕсли;
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета КАК Т
		|ГДЕ
		|	Т.ТипСтатуса = &ТипСтатуса
		|	И Т.ДокументУчета = &ДокументУчета");
		Запрос.УстановитьПараметр("ТипСтатуса", ТипСтатуса);
		Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
		
		СтарыйСтатус = ПолучитьРезультатЗапроса(Запрос, "Статус");
		
		Если СтарыйСтатус = НовыйСтатус
			Или (Не ЗначениеЗаполнено(СтарыйСтатус)
				И Не ЗначениеЗаполнено(НовыйСтатус)) Тогда
			Продолжить;
		КонецЕсли;
		
		Запись = РегистрыСведений.КонтурМаркировка_СтатусыДокументовУчета.СоздатьМенеджерЗаписи();
		Запись.ДокументУчета = ДокументУчета;
		Запись.ТипСтатуса	 = ТипСтатуса;
		Запись.Статус		 = НовыйСтатус;
		Запись.ДатаСтатуса	 = ДатаНовыхСтатусов;
		
		Если ЗначениеЗаполнено(НовыйСтатус) Тогда
			Запись.Записать();
		Иначе
			Запись.Удалить();
		КонецЕсли;
		
		СтатусыДокумента.Вставить(ИмяПоляДатаСтатуса(ТипСтатуса), ДатаНовыхСтатусов);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СтатусыДокументаУчета_ЗаписатьСтатус(ДокументУчета, ТипСтатуса, НовыйСтатус) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета КАК Т
	|ГДЕ
	|	Т.ТипСтатуса = &ТипСтатуса
	|	И Т.ДокументУчета = &ДокументУчета");
	Запрос.УстановитьПараметр("ТипСтатуса", ТипСтатуса);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	
	СтарыйСтатус = ПолучитьРезультатЗапроса(Запрос, "Статус");
	
	Если СтарыйСтатус = НовыйСтатус
		Или (Не ЗначениеЗаполнено(СтарыйСтатус)
		И Не ЗначениеЗаполнено(НовыйСтатус)) Тогда
		Возврат;
	КонецЕсли;
	
	Запись = РегистрыСведений.КонтурМаркировка_СтатусыДокументовУчета.СоздатьМенеджерЗаписи();
	Запись.ДокументУчета = ДокументУчета;
	Запись.ТипСтатуса	 = ТипСтатуса;
	Запись.Статус		 = НовыйСтатус;
	Запись.ДатаСтатуса	 = ТекущаяДатаСеанса();
	
	Если ЗначениеЗаполнено(НовыйСтатус) Тогда
		Запись.Записать();
	Иначе
		Запись.Удалить();
	КонецЕсли;
	
КонецПроцедуры

Процедура СтатусыДокументаУчета_Удалить(ДокументУчета) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		СтатусыДокументаУчета_Заблокировать(ДокументУчета);
		
		Набор = РегистрыСведений.КонтурМаркировка_СтатусыДокументовУчета.СоздатьНаборЗаписей();
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Отбор.ДокументУчета.Установить(ДокументУчета);
		Набор.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура СтатусыДокументаУчета_Заблокировать(ДокументУчета) Экспорт
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета");
	ЭлементБлокировки.УстановитьЗначение("ДокументУчета", ДокументУчета);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

// #КонецОбласти // СтатусыДокументаУчета

// #Область Операции

// Удаляет операции из справочника и все связаные с ними данные
//
// Параметры:
//  УдаляемыеОперации - Массив, СправочникСсылка.КонтурМаркировка_Операции - операции, которые надо удалить
//
Процедура Операции_Удалить(УдаляемыеОперации) Экспорт
	
	Если Не ЗначениеЗаполнено(УдаляемыеОперации) Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		МассивОпераций = ЗначениеВМассиве(УдаляемыеОперации);
		
		СвернутьМассив_Марк(МассивОпераций);
		МассивСлужебныхОпераций = Новый Массив;
		МассивДокументов = Новый Массив;
		Для Каждого Операция Из МассивОпераций Цикл
			
			ДополнитьМассив(МассивСлужебныхОпераций, Операция_НайтиПодчиненныеОперации(Операция, ТипыСлужебныхОпераций()));
			
			ДокументУчета = Операция.ДокументУчета;
			Если Операция_ВлияетНаТребуемоеДействиеДокумента(Операция)
				И Не МассивСодержитЗначение(МассивДокументов, ДокументУчета) Тогда
				МассивДокументов.Добавить(ДокументУчета);
			КонецЕсли;
			
		КонецЦикла;
		
		ДополнитьМассив(МассивОпераций, МассивСлужебныхОпераций);
		
		Операции_ЗаблокироватьПоТаблице(ТаблицаИзМассива(МассивОпераций));
		
		Для каждого Операция Из МассивОпераций Цикл
			
			Файлы_Удалить(Файлы_Найти(Операция));
			Задача_Удалить(Операция);
			Лента_Удалить(Операция);
			ДопРеквизиты_Удалить(Операция);
			ДопСвойства_Удалить(Операция);
			СтатусыОперации_Удалить(Операция);
			КодыЗаказов_Удалить(Операция);
			КодыОпераций_Записать(Новый_ТаблицаКодов(), Операция);
			
			ОбъектОперации = Операция.ПолучитьОбъект();
			Если ОбъектОперации <> Неопределено Тогда
				ОбъектОперации.ОбменДанными.Загрузка = Истина;
				ОбъектОперации.Удалить();
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого ДокументУчета Из МассивДокументов Цикл
			ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета);
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура Операции_ЗаблокироватьПоТаблице(Таблица, ИмяКолонки = "Ссылка")
	
	Поле = "Ссылка";
	Объект = "Справочник.КонтурМаркировка_Операции";
	ЗаблокироватьПоТаблице(Объект, Поле, Таблица, ИмяКолонки);
	
КонецПроцедуры

Процедура Операция_Заблокировать(ОперацияСсылка)
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("Справочник.КонтурМаркировка_Операции");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", ОперацияСсылка);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

// Записывает операцию в базу
//
// Параметры:
//  ОписаниеОперации - Структура - см. Новый_Операция()
// 
// Возвращаемое значение:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - записанная операция
//
Функция Операция_Записать(ОписаниеОперации) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Если ЗначениеЗаполнено(ОписаниеОперации.Ссылка) Тогда
			
			Если ОбъектВПроцессеОбновления(ОписаниеОперации.Ссылка) Тогда
				ВызватьИсключение_ОбъектВПроцессеОбновления(ОписаниеОперации.Ссылка);
			КонецЕсли;
			
			Операция_Заблокировать(ОписаниеОперации.Ссылка);
			СтатусыОперации_Заблокировать(ОписаниеОперации.Ссылка);
			ОбъектОперации = ОписаниеОперации.Ссылка.ПолучитьОбъект();
			
			Если СокрЛП(ОписаниеОперации.ВерсияДанных) <> СокрЛП(ОбъектОперации.ВерсияДанных) Тогда
				ВызватьИсключение НСтр("ru = 'Версия операции в базе изменилась, текущую версию записать невозможно!'");
			КонецЕсли;
			
		Иначе
			
			ОбъектОперации = Справочники.КонтурМаркировка_Операции.СоздатьЭлемент();
			
			ТипыОпераций = Перечисление_ТипыОпераций();
			Если ОписаниеОперации.ТипОперации = ТипыОпераций.ВходящийУПД
				Или ОписаниеОперации.ТипОперации = ТипыОпераций.УведомлениеОПриемке Тогда
				
				УникальныйИдентификатор = Новый УникальныйИдентификатор(ОписаниеОперации.ДопРеквизиты.ИдентификаторДокумента);
				Ссылка = Справочники.КонтурМаркировка_Операции.ПолучитьСсылку(УникальныйИдентификатор);
				ОбъектОперации.УстановитьСсылкуНового(Ссылка);
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ОбъектОперации, ОписаниеОперации, , "Ссылка, Товары");
		ОбъектОперации.Код = ОписаниеОперации.Номер;
		
		Если Не ЗначениеЗаполнено(ОбъектОперации.Дата) Тогда
			ОбъектОперации.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ОбъектОперации.Код) Тогда
			Операция_УстановитьНовыйКод(ОбъектОперации);
		КонецЕсли;
		
		Операция_ЗаполнитьТовары(ОбъектОперации, ОписаниеОперации);
		
		ОбъектОперации.Записать();
		ОписаниеОперации.Дата = ОбъектОперации.Дата;
		ОписаниеОперации.Номер = ОбъектОперации.Код;
		ОписаниеОперации.Ссылка = ОбъектОперации.Ссылка;
		ОписаниеОперации.ВерсияДанных = ОбъектОперации.ВерсияДанных;
		
		ДопРеквизиты_Записать(ОписаниеОперации.Ссылка, ОписаниеОперации.ДопРеквизиты);
		СтатусыОперации_Записать(ОписаниеОперации.Ссылка, ОписаниеОперации.Статусы);
		Если Операция_ВлияетНаТребуемоеДействиеДокумента(ОписаниеОперации.Ссылка) Тогда
			ДокументУчета_ОбновитьТребуемоеДействие(ОписаниеОперации.ДокументУчета);
		КонецЕсли;
		
		Метрики_ПриЗаписиОперации(ОписаниеОперации);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат ОписаниеОперации.Ссылка;
	
КонецФункции

// Находит все операции подходящие по параметрам
//
// Параметры:
//  ТипыОпераций - Строка, Массив - (необязательный) см. Перечисление_ТипыОпераций();
//  ДокументУчетаСсылка - СправочникСсылка.КонтурМаркировка_ДокументыУчета - (необязательный);
//  ОперацияОснованиеСсылка - СправочникСсылка.КонтурМаркировка_Операции - (необязательный);
// 
// Возвращаемое значение:
//  Массив - содержит СправочникСсылка.КонтурМаркировка_Операции
//
Функция Операция_НайтиОперации(ТипыОпераций = Неопределено, ДокументУчета = Неопределено, ОперацияОснование = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ТипыОпераций)
		И Не ЗначениеЗаполнено(ДокументУчета)
		И Не ЗначениеЗаполнено(ОперацияОснование) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнены параметры поиска операций'");
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Т
	|ГДЕ
	|	&ТипОперации И &ДокументУчета И &ОперацияОснование";
	
	Если ЗначениеЗаполнено(ТипыОпераций) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипОперации", "Т.ТипОперации В (&ТипыОпераций)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипОперации", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументУчета", "Т.ДокументУчета = &ДокументУчета");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументУчета", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОперацияОснование) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперацияОснование", "Т.ОперацияОснование = &ОперацияОснование");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперацияОснование", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТипыОпераций", ЗначениеВМассиве(ТипыОпераций));
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("ОперацияОснование", ОперацияОснование);
	
	Результат = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Операция_НайтиПодчиненныеОперации(ОперацияОснование, ТипыОпераций = Неопределено, Рекурсивно = Ложь) Экспорт
	
	Результат = Операция_НайтиОперации(ТипыОпераций, , ОперацияОснование);
	
	Если Рекурсивно Тогда
		Для каждого ПодчиненнаяОперация Из Результат Цикл
			ПодчиненныеОперации = Операция_НайтиПодчиненныеОперации(ПодчиненнаяОперация, ТипыОпераций, Рекурсивно);
			ДополнитьМассив(Результат, ПодчиненныеОперации);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Находит первую операцию по значению доп реквизита
//
// Параметры:
//  ТипОперации       - Строка       - см. Перечисление_ТипыОпераций();
//  ИмяРеквизита      - Строка       - имя реквизита;
//  ЗначениеРеквизита - Произвольный - значение реквизита;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Операции;
//  Неопределено - если подходящая операция не найдена;
//
Функция Операция_НайтиПоДопРеквизиту(ТипОперации, ИмяРеквизита, ЗначениеРеквизита)
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Операция.Ссылка КАК Ссылка
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ДопРеквизиты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции КАК Операция
	|		ПО ДопРеквизиты.Объект = Операция.Ссылка
	|ГДЕ
	|	&ОтборПоЗначению
	|	И ДопРеквизиты.ИмяРеквизита = &ИмяРеквизита
	|	И Операция.ТипОперации = &ТипОперации";
	
	ЗначениеКлюч = Неопределено;
	ТипКлючаЗначения = Неопределено;
	
	Если ЭтоПростойТип(ЗначениеРеквизита) Тогда
		ОтборПоЗначению = "ДопРеквизиты.Значение = &Значение";
	ИначеЕсли ТипЗнч(ЗначениеРеквизита) = Тип("УникальныйИдентификатор") Тогда
		ОтборПоЗначению = "ДопРеквизиты.ЗначениеКлюч = &ЗначениеКлюч";
		ЗначениеКлюч = ЗначениеРеквизита;
	ИначеЕсли ЭтоОбъектКонтурМаркировки(ЗначениеРеквизита) Тогда
		ОтборПоЗначению = "ДопРеквизиты.ЗначениеКлюч = &ЗначениеКлюч И ДопРеквизиты.ТипКлючаЗначения = &ТипКлючаЗначения";
		ЗначениеКлюч = КлючОбъекта1С(ЗначениеРеквизита);
		ТипКлючаЗначения = ТипКлючаОбъекта1С(ЗначениеРеквизита);
	Иначе
		ОтборПоЗначению = "ДопРеквизиты.ЗначениеСсылка = &Значение";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоЗначению", ОтборПоЗначению);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТипОперации", ТипОперации);
	Запрос.УстановитьПараметр("ИмяРеквизита", ИмяРеквизита);
	Запрос.УстановитьПараметр("Значение", ЗначениеРеквизита);
	Запрос.УстановитьПараметр("ЗначениеКлюч", ЗначениеКлюч);
	Запрос.УстановитьПараметр("ТипКлючаЗначения", ТипКлючаЗначения);
	
	Возврат ПолучитьРезультатЗапроса(Запрос);
	
КонецФункции

// Возвращает статусы операции
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция, по которой нужно прочитать статусы
// 
// Возвращаемое значение:
//  Структура - см. Новый_Операция_Статусы()
//
Функция Операция_СтатусыОперации(Операция) Экспорт
	
	Результат = Новый_Операция_Статусы();
	
	СтатусыИБ = СтатусыОперации_Прочитать(Операция);
	
	ЗаполнитьЗначенияСвойств(Результат, СтатусыИБ);
	
	Возврат Результат;
	
КонецФункции

Функция Операция_ВводВОборот_ПодходящиеСтатусыКодов() Экспорт
	
	СтатусыКодов = Перечисление_СтатусыКодов();
	
	Результат = Новый Массив;
	Результат.Добавить(""); // Не запрашивали статус в ГИС МТ
	Результат.Добавить(СтатусыКодов.Выпущен);
	Результат.Добавить(СтатусыКодов.Нанесен);
	Результат.Добавить(СтатусыКодов.НеНайден); // Возможно СУЗ не успел передать коды в ГИС МТ
	
	Возврат Результат;
	
КонецФункции

Функция Операция_ВлияетНаТребуемоеДействиеДокумента(Операция)
	
	Если Не ЗначениеЗаполнено(Операция.ДокументУчета) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	ПодходящиеТипыОпераций = Новый Массив;
	ПодходящиеТипыОпераций.Добавить(ТипыОпераций.ПечатьКодов);
	ПодходящиеТипыОпераций.Добавить(ТипыОпераций.ВводВОборот);
	ПодходящиеТипыОпераций.Добавить(ТипыОпераций.ОтчетОНанесении);
	ПодходящиеТипыОпераций.Добавить(ТипыОпераций.ОтчетОНанесенииНаТСД);
	ПодходящиеТипыОпераций.Добавить(ТипыОпераций.ПодборКодовНаТСД);
	ПодходящиеТипыОпераций.Добавить(ТипыОпераций.ПодборТоваровИКодовНаТСД);
	
	Возврат МассивСодержитЗначение(ПодходящиеТипыОпераций, Операция.ТипОперации);
	
КонецФункции

Процедура Операция_СоздатьНаполнениеАгрегатаНаТСД(ОписаниеОснования, КлючСтрокиОперацииОснования, КлючАгрегата)
	
	ПолучатьПолныеКоды = ОписаниеОснования.ДопРеквизиты.ПолучатьПолныеКодыПриНаполненииАгрегатаНаТСД;
	РегистрироватьПослеНаполнения = ОписаниеОснования.ДопРеквизиты.РегистрироватьАгрегатыПослеНаполнения;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ОписаниеОперации = Новый_Операция();
		ОписаниеОперации.ТипОперации = Перечисление_ТипыОпераций().НаполнениеОдногоАгрегатаНаТСД;
		ОписаниеОперации.КлючСтрокиОперацииОснования = КлючСтрокиОперацииОснования;
		ОписаниеОперации.ОперацияОснование = ОписаниеОснования.Ссылка;
		ОписаниеОперации.ДопРеквизиты.КлючКода = КлючАгрегата;
		ЗаполнитьЗначенияСвойств(ОписаниеОперации, ОписаниеОснования, "ДокументУчета, Организация, Склад, ВидПродукции");
		
		ОписаниеОперации.ДопРеквизиты.ПолучатьПолныеКодыПриНаполненииАгрегатаНаТСД = ПолучатьПолныеКоды;
		ОписаниеОперации.ДопРеквизиты.РегистрироватьАгрегатыПослеНаполнения = РегистрироватьПослеНаполнения;
		
		Операция = Операция_Записать(ОписаниеОперации);
		
		Задача_Создать(Операция);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

