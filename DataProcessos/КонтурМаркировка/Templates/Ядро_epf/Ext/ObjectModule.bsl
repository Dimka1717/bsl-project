// #КонецОбласти // Интеграция

// #Область МобильныеУстройства

Процедура СинхронизироватьМобильныеУстройства(Организация) Экспорт
	
	Действие = НСтр("ru = 'Синхронизация мобильных устройств'");
	
	Попытка
		Ответ = Маркировка_СписокМобильныхУстройств(Организация);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		ШаблонСообщения = НСтр("ru = 'Не удалось синхронизировать мобильные устройства по организации: %1'");
		ТекстСообщения = ПараметрыВСтроку(ШаблонСообщения, Организация);
		ОбработатьОшибку(Действие, Ошибка, Организация, ТекстСообщения);
		Возврат;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ["tsds"]) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого tsd Из Ответ["tsds"] Цикл
		
		id = СвойствоСтруктуры(tsd, "id");
		МобильноеУстройство = МобильноеУстройство_НайтиПоИдентификатору(id);
		
		Если ЗначениеЗаполнено(МобильноеУстройство) Тогда
			ОписаниеУстройства = МобильноеУстройство_Прочитать(МобильноеУстройство);
		Иначе
			ОписаниеУстройства = Новый_МобильноеУстройство();
			ОписаниеУстройства.Идентификатор = id;
		КонецЕсли;
		
		ОписаниеУстройства.Наименование = СвойствоСтруктуры(tsd, "name", "");
		ОписаниеУстройства.Организация = Организация;
		СкладID = СвойствоСтруктуры(tsd, "warehouseId");
		Если ЗначениеЗаполнено(СкладID) Тогда
			ОписаниеУстройства.Склад = Склад_НайтиПоИдентификатору(СкладID);
		КонецЕсли;
		
		Попытка
			СтатусУстройства           = СтатусМобильногоУстройстваПоСтатусуИзСервиса(tsd);
			ТипИспользованияУстройства = ТипИспользованияУстройстваПоТипуИспользованияИзСервиса(tsd);
			СпособПолученияДокументов  = СпособПолученияДокументовНаТСДПоТипуИспользованияИзСервиса(ТипИспользованияУстройства);
		Исключение
			Ошибка = ИнформацияОбОшибке();
			ОбработатьОшибку(Действие, Ошибка, Организация);
			Продолжить;
		КонецПопытки;
		
		ОписаниеУстройства.ТипИспользованияУстройства = ТипИспользованияУстройства;
		ОписаниеУстройства.Статус                     = СтатусУстройства;
		ОписаниеУстройства.СпособПолученияДокументов  = СпособПолученияДокументов;
		
		МобильноеУстройство_Записать(ОписаниеУстройства);
		
	КонецЦикла;
	
КонецПроцедуры

// Описание мобильного устройства
// 
// Возвращаемое значение:
//  Структура - описание мобильного устройства:
//   * Ссылка - КонтурМаркировка_СервисПровайдеры - ссылка на элемент;
//   * Наименование - Строка - наименование сервис-провайдера;
//   * Организация  - СправочникСсылка.КонтурМаркировка_Организации - Организация - владелец мобильного устройства;
//   * Склад - СправочникСсылка.КонтурМаркировка_Склады - склад, к которому привязано устройство в сервисе;
//   * Идентификатор - Строка - идентификатор мобильного устройства в сервисе;
//   * Статус  - Строка - см. Перечисление_СтатусыМобильныхУстройств();
//   * ТипИспользованияУстройства  - Строка - см. Перечисление_ТипыИспольщованияМобильныхУстройств();
//   * СпособПолученияДокументов  - Строка - см. Перечисление_СпособыПолученияДокументовДляМобильныхУстройств();
//
Функция Новый_МобильноеУстройство() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ссылка");
	Результат.Вставить("Наименование", "");
	Результат.Вставить("Организация");
	Результат.Вставить("Склад");
	Результат.Вставить("Идентификатор", "");
	Результат.Вставить("Статус", "");
	Результат.Вставить("ТипИспользованияУстройства", "");
	Результат.Вставить("СпособПолученияДокументов", "");
	Результат.Вставить("ВерсияДанных", "");
	
	Возврат Результат;
	
КонецФункции

// Читает мобильное устройство из базы
//
// Параметры:
//  Ссылка - СправочникСсылка.КонтурМаркировка_МобильныеУстройства - Ссылка на мобильное устройство
// 
// Возвращаемое значение:
//  Структура - см. Новый_МобильноеУстройство()
//
Функция МобильноеУстройство_Прочитать(Ссылка) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.*
	|ИЗ
	|	Справочник.КонтурМаркировка_МобильныеУстройства КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый_МобильноеУстройство();
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	Результат.Организация = Выборка.Владелец;
	
	Возврат Результат;
	
КонецФункции

// Обновляет существующий или создает новый элемент в справочнике
// КонтурМаркировка_МобильныеУстройства
// При создании нового элемента записывает ссылку на созданный элемент в поле ОписаниеМобильногоУстройства.Ссылка.
//
// Параметры:
//  ОписаниеМобильногоУстройства - Структура - см. фунцию Новый_МобильноеУстройство();
//
Процедура МобильноеУстройство_Записать(ОписаниеМобильногоУстройства) Экспорт
	
	Ссылка = ОписаниеМобильногоУстройства.Ссылка;
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Ссылка = МобильноеУстройство_НайтиПоИдентификатору(ОписаниеМобильногоУстройства.Идентификатор);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		
		Если ОбъектВПроцессеОбновления(Ссылка) Тогда
			ВызватьИсключение_ОбъектВПроцессеОбновления(Ссылка);
		КонецЕсли;
		
		Объект = Ссылка.ПолучитьОбъект();
		
	Иначе
		Объект = Справочники.КонтурМаркировка_МобильныеУстройства.СоздатьЭлемент();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеМобильногоУстройства.Ссылка)
		И ОписаниеМобильногоУстройства.ВерсияДанных <> Объект.ВерсияДанных Тогда
		ВызватьИсключение НСтр(
		"ru = 'В базе изменилась версия мобильного устройства, текущую версию записать невозможно!'");
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект, ОписаниеМобильногоУстройства,, "Ссылка");
	Объект.Владелец = ОписаниеМобильногоУстройства.Организация;
	
	Объект.Записать();
	
	ОписаниеМобильногоУстройства.Ссылка = Объект.Ссылка;
	ОписаниеМобильногоУстройства.ВерсияДанных = Объект.ВерсияДанных;
	
КонецПроцедуры

Функция СтатусМобильногоУстройстваПоСтатусуИзСервиса(tsd)
	
	Результат = "";
	
	Статусы = Перечисление_СтатусыМобильногоУстройства();
	
	statusInfo = СвойствоСтруктуры(tsd, "statusInfo");
	Если ЗначениеЗаполнено(statusInfo) Тогда
		
		status = СвойствоСтруктуры(statusInfo, "status");
		Если НРег(status) = НРег("active") Тогда
			Результат = Статусы.Привязано;
		ИначеЕсли НРег(status) = НРег("inactive") Тогда
			Результат = Статусы.НеПривязано;
		Иначе
			ТекстОшибки = НСтр("ru = 'Не удалось определить статус мобильного устройства по статусу из сервиса: %1'");
			ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, status);
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		
	Иначе
		ТекстОшибки = НСтр("ru = 'В сервисе не указан статус мобильного устройства'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТипИспользованияУстройстваПоТипуИспользованияИзСервиса(tsd)
	
	Результат = "";
	
	ТипыИспользования = Перечисление_ТипыИспользованияМобильногоУстройства();
	
	settings = СвойствоСтруктуры(tsd, "settings");
	Если ЗначениеЗаполнено(settings) Тогда
		
		usageType = СвойствоСтруктуры(settings, "usageType");
		Если НРег(usageType) = НРег("vanselling") Тогда
			Результат = ТипыИспользования.Отгрузка;
		ИначеЕсли НРег(usageType) = НРег("warehouse") Тогда
			Результат = ТипыИспользования.Склад;
		Иначе
			ТекстОшибки = НСтр("ru = 'Не удалось определить тип использования устройства по типу использования из сервиса: %1'");
			ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, usageType);
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		
	Иначе
		ТекстОшибки = НСтр("ru = 'В сервисе не указан тип использования мобильного устройства'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СпособПолученияДокументовНаТСДПоТипуИспользованияИзСервиса(ТипИспользованияУстройства)
	
	Результат = "";
	
	ТипыИспользования = Перечисление_ТипыИспользованияМобильногоУстройства();
	СпособыПолученияДокументов = Перечисление_СпособыПолученияДокументовМобильнымУстройством();
	
	Если ТипИспользованияУстройства = ТипыИспользования.Отгрузка Тогда
		Результат = СпособыПолученияДокументов.ТолькоНазначенныеЗадания;
	ИначеЕсли ТипИспользованияУстройства = ТипыИспользования.Склад Тогда
		Результат = СпособыПолученияДокументов.ВсеЗадания;
	Иначе
		ТекстОшибки = НСтр("ru = 'Не удалось определеить способ получения документов на ТСД'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция МобильноеУстройство_НайтиПоИдентификатору(Идентификатор)
	
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_МобильныеУстройства КАК Т
	|ГДЕ
	|	Т.Идентификатор = &Идентификатор");
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	Результат = ПолучитьРезультатЗапроса(Запрос);
	
	Возврат Результат;
	
КонецФункции

Функция МобильныеУстройства_МассивId(МобильноеУстройство)
	
	Результат = Новый Массив;
	Результат.Добавить(Новый Структура("id", МобильноеУстройство.Идентификатор));
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // МобильныеУстройства

// #Область Товары

Функция Товар_Прочитать(Ссылка, КэшРезультатов = Неопределено) Экспорт
	
	Если КэшРезультатов <> Неопределено Тогда
		Результат = КэшРезультатов[Ссылка];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый_Товар();
	ЗаполнитьЗначенияСвойств(Результат, Ссылка, , "Наименование, СоставНабора, УсловияХранения");
	Результат.Наименование = Ссылка.НаименованиеТовара;
	
	Если Ссылка.ТипКодаМаркировки = Перечисления.КонтурМаркировка_ТипыКодовМаркировки.Набор Тогда
		Товар_ПрочитатьСоставНабора(Результат);
	КонецЕсли;
	
	Товар_ПрочитатьУсловияХранения(Результат);
	
	Товар_ПрочитатьДопРеквизиты(Результат);
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(Ссылка, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Заполняет из базы доп реквизиты товара
//
// Параметры:
//  Товар - Структура - см. Новый_Товар()
// 
Процедура Товар_ПрочитатьДопРеквизиты(ОписаниеТовара)
	
	ДопРеквизитыИБ = ДопРеквизиты_Прочитать(ОписаниеТовара.Ссылка);
	
	ЗаполнитьПоляСтруктуры(ОписаниеТовара.ДопРеквизиты, ДопРеквизитыИБ);
	
КонецПроцедуры

// Записывает в базу товар и связанные с ним данные и возвращает ссылку на товар
//
// Параметры:
//  ОписаниеТовара - Структура - см. Новый_Товар()
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Товары - записанный товар
//
Функция Товар_Записать(ОписаниеТовара) Экспорт
	
	Если Не ЗначениеЗаполнено(ОписаниеТовара.GTIN) Тогда
		ТекстОшибки = НСтр("ru = 'Не заполнен код товара (GTIN)'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Товар_Заблокировать(ОписаниеТовара.GTIN);
		Товар_ПроверитьФорматGTIN(ОписаниеТовара.GTIN);
		Товар_ПроверитьУникальностьGTIN(ОписаниеТовара.GTIN, ОписаниеТовара.Ссылка);
		
		Если ЗначениеЗаполнено(ОписаниеТовара.Ссылка) Тогда
			
			Если ОбъектВПроцессеОбновления(ОписаниеТовара.Ссылка) Тогда
				ВызватьИсключение_ОбъектВПроцессеОбновления(ОписаниеТовара.Ссылка);
			КонецЕсли;
			
			ОбъектТовара = ОписаниеТовара.Ссылка.ПолучитьОбъект();
			
		Иначе
			ОбъектТовара = Справочники.КонтурМаркировка_Товары.СоздатьЭлемент();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ОбъектТовара, ОписаниеТовара, , "Ссылка");
		
		Товар_ЗаписатьТабЧасти(ОбъектТовара, ОписаниеТовара);
		
		ОбъектТовара.НаименованиеТовара = ОписаниеТовара.Наименование;
		
		ОбъектТовара.Записать();
		
		ОписаниеТовара.Ссылка = ОбъектТовара.Ссылка;
		
		ДопРеквизиты_Записать(ОписаниеТовара.Ссылка, ОписаниеТовара.ДопРеквизиты);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат ОбъектТовара.Ссылка;
	
КонецФункции

// Заполняет табличные части объекта Товар для записи в базу
//
// Параметры:
//  ОбъектТовара - СправочникОбъект.КонтурМаркировка_Товары - объект операции;
//  ОписаниеТовара - Структура - см. Новый_Товар();
//
Процедура Товар_ЗаписатьТабЧасти(ОбъектТовара, ОписаниеТовара)
	
	Товар_ЗаписатьТабЧасть_СоставНабора(ОбъектТовара, ОписаниеТовара);
	Товар_ЗаписатьТабЧасть_УсловияХранения(ОбъектТовара, ОписаниеТовара);
	
КонецПроцедуры

Процедура Товар_ЗаписатьТабЧасть_УсловияХранения(ОбъектТовара, ОписаниеТовара)
	
	ОбъектТовара.УсловияХранения.Очистить();
	
	Для каждого Стр Из ОписаниеТовара.УсловияХранения Цикл
		ЗаполнитьЗначенияСвойств(ОбъектТовара.УсловияХранения.Добавить(), Стр);
	КонецЦикла

КонецПроцедуры

Процедура Товар_ЗаписатьТабЧасть_СоставНабора(ОбъектТовара, ОписаниеТовара)
	
	ОбъектТовара.СоставНабора.Очистить();
	
	Для каждого Стр Из ОписаниеТовара.СоставНабора Цикл
		Если Не ЗначениеЗаполнено(Стр.ВложенныйТовар) Тогда
			ОбъектТовара.СоставНабора.Очистить();
			Прервать;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ОбъектТовара.СоставНабора.Добавить(), Стр);
	КонецЦикла;
	
КонецПроцедуры

// Находит товар маркировки по GTIN
//
// Параметры:
//  GTIN - Строка - GTIN, по которому нужно найти товар маркировки;
//  КэшРезультатов - Соответствие - (необязательный) кэш результатов функции;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Товары - товары маркировки;
//  Неопределено - если найти товар не удалось;
//
Функция Товар_Найти(GTIN, КэшРезультатов = Неопределено) Экспорт
	
	Если КэшРезультатов <> Неопределено Тогда
		Результат = КэшРезультатов[GTIN];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Результат = Справочники.КонтурМаркировка_Товары.НайтиПоРеквизиту("GTIN", GTIN);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = Неопределено;
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено
		И ЗначениеЗаполнено(Результат) Тогда
		КэшРезультатов.Вставить(GTIN, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Находит всю номенклатуру 1С связанную с товаром маркировки
//
// Параметры:
//  Товар - СправочникСсылка.КонтурМаркировка_Товары - товар маркировки;
//  КэшРезультатов - Соответствие - (необязательный) кэш результатов функции;
// 
// Возвращаемое значение:
//  ТаблицаЗначений - см. функцию Новый_ТаблицаНоменклатуры();
//
Функция Товар_НайтиНоменклатуру1С(Товар, КэшРезультатов = Неопределено) Экспорт
	
	Если КэшРезультатов <> Неопределено Тогда
		Результат = КэшРезультатов[Товар];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Результат = СвязиНоменклатуры_Прочитать(Товар);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = Номенклатура1С_НайтиПоGTIN(Товар, Ложь);
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено
		И ЗначениеЗаполнено(Результат) Тогда
		КэшРезультатов.Вставить(Товар, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает порцию GTIN в виде массива
//
// Параметры:
//  РазмерПорции - Число - размер проции GTIN
//  МеньшеТовара - СправочникСсылка.КонтурМаркировка_Товары - (необязательный) если указан,
//                 то ссылки товаров, по ним упорядочить, должны быть меньше чем указанная
//  ВидыПродукции - Массив - содержит виды продукции товаров, которые необходимо обновить
// 
// Возвращаемое значение:
//  Массив - содержит строки GTIN;
//
Функция Товары_ПорцияGTIN(РазмерПорции, МеньшеТовара = Неопределено, ВидыПродукции = Неопределено)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Т.GTIN КАК GTIN
	|ИЗ
	|	Справочник.КонтурМаркировка_Товары КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|	И &ВидыПродукции
	|	И &МеньшеТовара
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Ссылка УБЫВ";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ", ТекстЗапросаВыбратьПервые(РазмерПорции));
	
	Если ЗначениеЗаполнено(МеньшеТовара) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&МеньшеТовара", "Т.Ссылка <= &МеньшеТовара");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&МеньшеТовара", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидыПродукции) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидыПродукции", "Т.ВидПродукции В (&ВидыПродукции)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидыПродукции", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("МеньшеТовара", МеньшеТовара);
	Запрос.УстановитьПараметр("ВидыПродукции", ВидыПродукции);
	
	Возврат МассивИзРезультатаЗапроса(Запрос, "GTIN");
	
КонецФункции

// Заполняет описание товара данными из сервиса
//
// Параметры:
//  ОписаниеТовара - Структура - см. Новый_Товар();
// 
// Возвращаемое значение:
//  Структура - содержит информацию о количестве созданных и обновленных товаров;
//
Функция Товар_ЗаполнитьИзСервиса(ОписаниеТовара) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЕстьИзменения", Ложь);
	Результат.Вставить("СозданоТоваров", 0);
	Результат.Вставить("ОбновленоТоваров", 0);
	
	ИнформацияОТоварахИзСервиса = Товары_ИнформацияИзСервиса(ЗначениеВМассиве(ОписаниеТовара.GTIN));
	Если Не ЗначениеЗаполнено(ИнформацияОТоварахИзСервиса) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДанныеСервиса = ИнформацияОТоварахИзСервиса.Получить(ОписаниеТовара.GTIN);
	
	error = ДанныеСервиса["error"];
	Если ЗначениеЗаполнено(error) Тогда
		ОписаниеТовара.ДопРеквизиты.ОшибкаГИСМТ = error;
		Возврат Результат;
	КонецЕсли;
	
	value = ДанныеСервиса["value"];
	level = value["level"];
	ЭтоНабор = value["isSet"];
	ЭтоЕдиницаТовара = (НРег(level) = НРег("trade-unit"));
	ЭтоГрупповаяУпаковка = (НРег(level) = НРег("inner-pack"));
	
	МассивВложенныхGTIN = Новый Массив;
	
	Если ЭтоГрупповаяУпаковка Тогда
		МассивВложенныхGTIN.Добавить(value["mainGtin"]);
	КонецЕсли;
	
	Если ЭтоЕдиницаТовара И ЭтоНабор Тогда
		setGtin = value["setGtin"];
		Для Каждого Элемент Из setGtin Цикл
			МассивВложенныхGTIN.Добавить(Элемент["gtin"]);
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МассивВложенныхGTIN) Тогда
		РезультатСоздания = Товары_СоздатьОбновитьПоИнформацииИзСервиса(МассивВложенныхGTIN);
		Результат.СозданоТоваров = РезультатСоздания.СозданоТоваров;
		Результат.ОбновленоТоваров = РезультатСоздания.ОбновленоТоваров;
	КонецЕсли;
	
	Результат.ЕстьИзменения = Товар_ЗаполнитьДаннымиСервиса(ОписаниеТовара, ДанныеСервиса);
	
	Возврат Результат;
	
КонецФункции

// Создает и обновляет товары по данным сервиса на основании переданного массива GTIN
//
// Параметры:
//  МассивGTIN - Массив - содержит строки GTIN;
//  ТолькоСоздаватьНовые - Булево - (необязательный) Истина, если нужно только создавать новые товары;
// 
// Возвращаемое значение:
//  Структура - содержит количество созданных и обновленных товаров;
//
Функция Товары_СоздатьОбновитьПоИнформацииИзСервиса(МассивGTIN, ТолькоСоздаватьНовые = Ложь) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("СозданоТоваров", 0);
	Результат.Вставить("ОбновленоТоваров", 0);
	Результат.Вставить("НеНайденоТоваров", 0);
	Результат.Вставить("КоличествоGTIN", МассивGTIN.Количество());
	
	ИнформацияОТоварахИзСервиса = Товары_ИнформацияИзСервиса(МассивGTIN);
	Если Не ЗначениеЗаполнено(ИнформацияОТоварахИзСервиса) Тогда
		Возврат Результат;
	КонецЕсли;
	
	КэшНоменклатуры = Новый Соответствие;
	ДанныеСервисаПоGTIN = Новый Соответствие;
	МассивВложенныхGTIN = Новый Массив;
	
	Для Каждого GTIN Из МассивGTIN Цикл
		
		ДанныеСервиса = ИнформацияОТоварахИзСервиса[GTIN];
		
		error = ДанныеСервиса["error"];
		Если ЗначениеЗаполнено(error) Тогда
			Товар = Товар_Найти(GTIN, КэшНоменклатуры);
			Если ЗначениеЗаполнено(Товар) Тогда
				ОписаниеТовара = Товар_Прочитать(Товар);
				ОписаниеТовара.ДопРеквизиты.ОшибкаГИСМТ = error;
				Товар_Записать(ОписаниеТовара);
				Результат.НеНайденоТоваров = Результат.НеНайденоТоваров + 1;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		ДанныеСервисаПоGTIN.Вставить(GTIN, ДанныеСервиса);
		
		value = ДанныеСервиса["value"];
		level = value["level"];
		ЭтоНабор = value["isSet"];
		ЭтоЕдиницаТовара = (НРег(level) = НРег("trade-unit"));
		ЭтоГрупповаяУпаковка = (НРег(level) = НРег("inner-pack"));
		
		Если ЭтоГрупповаяУпаковка Тогда
			МассивВложенныхGTIN.Добавить(value["mainGtin"]);
		КонецЕсли;
		Если ЭтоНабор И ЭтоЕдиницаТовара Тогда
			setGtin = value["setGtin"];
			Для Каждого Элемент Из setGtin Цикл
				МассивВложенныхGTIN.Добавить(Элемент["gtin"]);
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(МассивВложенныхGTIN) Тогда
		СвернутьМассив_Марк(МассивВложенныхGTIN);
		РезультатСоздания = Товары_СоздатьОбновитьПоИнформацииИзСервиса(МассивВложенныхGTIN);
		Результат.СозданоТоваров = РезультатСоздания.СозданоТоваров;
		Результат.ОбновленоТоваров = РезультатСоздания.ОбновленоТоваров;
	КонецЕсли;
	
	Для Каждого Элемент Из ДанныеСервисаПоGTIN Цикл
		
		GTIN = Элемент.Ключ;
		ДанныеСервиса = Элемент.Значение;
		Товар = Товар_Найти(GTIN, КэшНоменклатуры);
		
		Если ЗначениеЗаполнено(Товар) Тогда
			Если ТолькоСоздаватьНовые Тогда
				Продолжить;
			КонецЕсли;
			ОписаниеТовара = Товар_Прочитать(Товар);
		Иначе
			ОписаниеТовара = Новый_Товар();
		КонецЕсли;
		
		ЕстьИзменения = Товар_ЗаполнитьДаннымиСервиса(ОписаниеТовара, ДанныеСервиса);
		Если Не ЕстьИзменения Тогда
			Продолжить;
		КонецЕсли;
		
		ЭтоНовыйТовар = Не ЗначениеЗаполнено(ОписаниеТовара.Ссылка);
		
		Если ЗначениеЗаполнено(ОписаниеТовара.ДопРеквизиты.ОшибкаГИСМТ) Тогда
			Если Не ЭтоНовыйТовар Тогда
				Товар_Записать(ОписаниеТовара);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Товар_Записать(ОписаниеТовара);
		
		Если ЭтоНовыйТовар Тогда
			Результат.СозданоТоваров = Результат.СозданоТоваров + 1;
		Иначе
			Результат.ОбновленоТоваров = Результат.ОбновленоТоваров + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Товары_ИнформацияИзСервиса(МассивGTIN)
	
	Результат = Новый Соответствие;
	
	ОрганизацииДляОбмена = Организация_ВсеОрганизацииСАвторизацией();
	Если Не ЗначениеЗаполнено(ОрганизацииДляОбмена) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СвернутьМассив_Марк(МассивGTIN, Истина);
	
	ТаблицаGTIN = Товары_ИнформацияИзСервиса_ТаблицаGTINСВладельцами(МассивGTIN);
	
	КэшОрганизаций = Новый Соответствие;
	РазмерПорции = 1000;
	
	Для Каждого Стр Из ТаблицаЗначений_РазбитьНаТаблицы(ТаблицаGTIN, "Владелец", РазмерПорции) Цикл
		
		ОрганизацияВладелец = Организация_НайтиПоИНН(Стр.Владелец.ИНН, КэшОрганизаций);
		ЕстьОрганизацияВладелец = МассивСодержитЗначение(ОрганизацииДляОбмена, ОрганизацияВладелец);
		
		Если ЕстьОрганизацияВладелец Тогда
			Товары_ИнформацияИзСервиса_ЗаполнитьСВладельцем(Результат, Стр.ЧастьТаблицы, ОрганизацияВладелец);
		Иначе
			Товары_ИнформацияИзСервиса_ЗаполнитьБезВладельца(Результат, Стр.ЧастьТаблицы, ОрганизацииДляОбмена);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Товары_ИнформацияИзСервиса_ТаблицаGTINСВладельцами(МассивGTIN)
	
	ТаблицаGTIN = Новый ТаблицаЗначений;
	ТаблицаGTIN.Колонки.Добавить("GTIN", ОписаниеТипа_Строка());
	ТаблицаЗначений_ЗагрузитьМассив(ТаблицаGTIN, МассивGTIN, "GTIN");
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаGTIN, "ТаблицаGTIN", "GTIN");
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.GTIN КАК GTIN,
	|	ЕСТЬNULL(Товары.ВладелецКарточкиТовара, &ПустойВладелец) КАК Владелец
	|ИЗ
	|	ТаблицаGTIN КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Товары КАК Товары
	|		ПО Т.GTIN = Товары.GTIN");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ПустойВладелец", Справочники.КонтурМаркировка_Контрагенты.ПустаяСсылка());
	РезультатЗапроса = Запрос.Выполнить();
	МенеджерВТ.Закрыть();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

Процедура Товары_ИнформацияИзСервиса_ЗаполнитьСВладельцем(ИнформацияИзСервиса, ТаблицаGTIN, Организация)
	
	МассивGTIN = ТаблицаGTIN.ВыгрузитьКолонку("GTIN");
	
	Ответ = Маркировка_ИнформацияОТоварах(МассивGTIN, Организация);
	
	Для Каждого GTIN Из МассивGTIN Цикл
		ИнформацияИзСервиса.Вставить(GTIN, Ответ[GTIN]);
	КонецЦикла;
	
КонецПроцедуры

Процедура Товары_ИнформацияИзСервиса_ЗаполнитьБезВладельца(ИнформацияИзСервиса, ТаблицаGTIN, ОрганизацииДляОбмена)
	
	ПервыйЗапрос = Истина;
	
	ТаблицаGTIN.Индексы.Добавить("GTIN");
	
	МассивGTIN = ТаблицаGTIN.ВыгрузитьКолонку("GTIN");
	
	Для Каждого Организация Из ОрганизацииДляОбмена Цикл
		
		Ответ = Маркировка_ИнформацияОТоварах(МассивGTIN, Организация);
		
		Для Сч = -МассивGTIN.ВГраница() По 0 Цикл
		
			GTIN = МассивGTIN[-Сч];
			
			ДанныеСервиса = Ответ[GTIN];
			Если ПервыйЗапрос Тогда
				ИнформацияИзСервиса.Вставить(GTIN, ДанныеСервиса);
			КонецЕсли;
			
			Стр = ТаблицаGTIN.Найти(GTIN, "GTIN");
			ПовторитьЗапрос = Не ЗначениеЗаполнено(Стр.Владелец);
			
			error = ДанныеСервиса["error"];
			Если ЗначениеЗаполнено(error) Тогда
				ПовторитьЗапрос = Ложь;
			КонецЕсли;
			
			value = ДанныеСервиса["value"];
			Если ЗначениеЗаполнено(value) И ЗначениеЗаполнено(value["inn"]) Тогда
				ТекущиеДанныеСервиса = ИнформацияИзСервиса[GTIN].Получить("value");
				ТекущиеДанныеСервиса.Вставить("inn", value["inn"]);
				ПовторитьЗапрос = Ложь;
			КонецЕсли;
			
			Если Не ПовторитьЗапрос Тогда
				МассивGTIN.Удалить(-Сч);
			КонецЕсли;
			
		КонецЦикла;
		
		ПервыйЗапрос = Ложь;
		
		Если Не ЗначениеЗаполнено(МассивGTIN) Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

// Обновляет поля порции товаров по данным из сервиса
//
// Параметры:
//  ИменаПолей - Массив - содержит имена полей, которые нужно обновить;
//  ПоследнийТовар - СправочникСсылка.КонтурМаркировка_Товары - последний товар в порции, который обновили в прошлый раз;
//  ВидыПродукции - Массив - содержит виды продукции товаров, которые необходимо обновить
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Товары - последний товар в порции, который был обновлен
//
Функция Товары_ОбновитьПоляТоваровПоИнформацииИзСервиса(ИменаПолей, ПоследнийТовар, ВидыПродукции = Неопределено)
	
	РазмерПорции = 1000;
	
	ПорцияGTIN = Товары_ПорцияGTIN(РазмерПорции, ПоследнийТовар, ВидыПродукции);
	
	Если Не ЗначениеЗаполнено(ПорцияGTIN) Тогда
		Возврат ПоследнийТовар;
	КонецЕсли;
	
	ИнформацияОТоварахИзСервиса = Товары_ИнформацияИзСервиса(ПорцияGTIN);
	
	Для Каждого GTIN Из ПорцияGTIN Цикл
		
		Товар = Товар_Найти(GTIN);
		
		ДанныеСервиса = ИнформацияОТоварахИзСервиса[GTIN];
		
		error = ДанныеСервиса["error"];
		Если ЗначениеЗаполнено(error) Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеИзСервиса = Товар_Прочитать(Товар);
		ЕстьИзменения = Товар_ЗаполнитьДаннымиСервиса(ОписаниеИзСервиса, ДанныеСервиса);
		Если Не ЕстьИзменения Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеТовара = Товар_Прочитать(Товар);
		ЕстьИзменения = Товар_СравнитьСДаннымиСервиса(ИменаПолей, ОписаниеТовара, ОписаниеИзСервиса);
		Если ЕстьИзменения Тогда
			Товар_Записать(ОписаниеТовара);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Товар;
	
КонецФункции

Функция Товар_СравнитьСДаннымиСервиса(ИменаПолей, ОписаниеТовара, ОписаниеИзСервиса)
	
	Результат = Ложь;
	
	Для каждого ИмяПоля Из ИменаПолей Цикл
		Если ОписаниеТовара.Свойство(ИмяПоля)
			И ОписаниеТовара[ИмяПоля] <> ОписаниеИзСервиса[ИмяПоля] Тогда
			ОписаниеТовара[ИмяПоля] = ОписаниеИзСервиса[ИмяПоля];
			Результат = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого ИмяПоля Из ИменаПолей Цикл
		Если ОписаниеТовара.ДопРеквизиты.Свойство(ИмяПоля)
			И ОписаниеТовара.ДопРеквизиты[ИмяПоля] <> ОписаниеИзСервиса.ДопРеквизиты[ИмяПоля] Тогда
			ОписаниеТовара.ДопРеквизиты[ИмяПоля] = ОписаниеИзСервиса.ДопРеквизиты[ИмяПоля];
			Результат = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Заполняет описание товара информацией из сервиса
//
// Параметры:
//  ОписаниеТовара - Структура - см. Новый_Товар();
//  ДанныеСервиса - Структура - информация о товаре из сервиса;
// 
// Возвращаемое значение:
//  Булево - Истина, если в описание товара внесены изменения
//
Функция Товар_ЗаполнитьДаннымиСервиса(ОписаниеТовара, ДанныеСервиса)
	
	ТоварСтрокойДо = ЗначениеВСтрокуВнутр(ОписаниеТовара);
	
	ТипыКодовМаркировки = Перечисления.КонтурМаркировка_ТипыКодовМаркировки;
	ВидыПродукции = Перечисления.КонтурМаркировка_ВидыПродукции;
	
	error = ДанныеСервиса["error"];
	Если ЗначениеЗаполнено(error) Тогда
		ОписаниеТовара.ДопРеквизиты.ОшибкаГИСМТ = error;
		Возврат Истина;
	Иначе
		ОписаниеТовара.ДопРеквизиты.ОшибкаГИСМТ = "";
	КонецЕсли;
	
	value = ДанныеСервиса["value"];
	producer = value["producer"];
	extraFields = value["extraFields"];
	productGroup = value["productGroup"];
	packageType = value["packageType"];
	isReasonCertMissing = value["isReasonCertMissing"];
	
	Попытка
		ОписаниеТовара.ВидПродукции = ВидПродукцииПоТоварнойГруппеИзСервиса(productGroup);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Заполнение карточки товара данными из сервиса'");
		ТекстСообщения = НСтр("ru = 'Не удалось заполнить карточку товара данными из сервиса GTIN %1'");
		ТекстСообщения = ПараметрыВСтроку(ТекстСообщения, ОписаниеТовара.GTIN);
		ДопИнформация = Новый Структура;
		ДопИнформация.Вставить("GTIN", ОписаниеТовара.GTIN);
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация, ТекстСообщения);
	КонецПопытки;
	
	ЭтоНабор = value["isSet"];
	ЭтоКомплект = value["isKit"];
	ЭтоГрупповаяУпаковка = (НРег(value["level"]) = НРег("inner-pack"));
	
	Если ЭтоГрупповаяУпаковка Тогда
		ОписаниеТовара.ТипКодаМаркировки = ТипыКодовМаркировки.ГрупповаяУпаковка;
	ИначеЕсли ЭтоНабор Тогда
		ОписаниеТовара.ТипКодаМаркировки = ТипыКодовМаркировки.Набор;
	ИначеЕсли ЭтоКомплект Тогда
		ОписаниеТовара.ТипКодаМаркировки = ТипыКодовМаркировки.Комплект;
	Иначе
		ОписаниеТовара.ТипКодаМаркировки = ТипыКодовМаркировки.ЕдиницаТовара;
	КонецЕсли;
	
	Если ЭтоГрупповаяУпаковка Тогда
		ОписаниеТовара.ВложенныйТовар = Товар_Найти(value["mainGtin"]);
		ОписаниеТовара.КоличествоВложений = value["multiplier"];
	ИначеЕсли ЭтоНабор Тогда
		ОписаниеТовара.СоставНабора.Очистить();
		setGtin = value["setGtin"];
		Для Каждого Элемент Из setGtin Цикл
			СтрокаНабора = Новый_Товар_СтрокаНабора();
			СтрокаНабора.ВложенныйТовар = Товар_Найти(Элемент["gtin"]);
			СтрокаНабора.КоличествоВложений = Элемент["quantity"];
			ОписаниеТовара.СоставНабора.Добавить(СтрокаНабора);
		КонецЦикла;
	КонецЕсли;
	
	ОписаниеТовара.GTIN = value["gtin"];
	ОписаниеТовара.Наименование = value["name"];
	ОписаниеТовара.ПеременныйВес = value["isVarQuantity"];
	
	КодТНВЭД = Строка(value["tnVed10"]);
	Если ЗначениеЗаполнено(КодТНВЭД) Тогда
		ОписаниеТовара.КодТНВЭД = КодТНВЭД;
	КонецЕсли;
	
	ГруппаТНВЭД = Строка(value["tnVedCode"]);
	Если ЗначениеЗаполнено(ГруппаТНВЭД) Тогда
		ОписаниеТовара.ДопРеквизиты.ГруппаТНВЭД = ГруппаТНВЭД;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписаниеТовара.ВладелецКарточкиТовара) Тогда
		ОписаниеТовара.ВладелецКарточкиТовара = Контрагент_Подобрать(value["inn"]);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписаниеТовара.Производитель) Тогда
		Если ЗначениеЗаполнено(producer) Тогда
			ОписаниеТовара.Производитель = Контрагент_Подобрать(producer["inn"], producer["kpp"], producer["name"]);
		Иначе
			ОписаниеТовара.Производитель = Контрагент_Подобрать(value["inn"]);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(extraFields) Тогда
		
		regNumber = extraFields["regNumber"];
		declNumber = extraFields["declNumber"];
		certNumber = extraFields["certNumber"];
		veterinaryControl = extraFields["veterinaryControl"];
		okpd2Group = extrafields["okpd2Group"];
		serviceLifeCharacteristic = extrafields["serviceLifeCharacteristic"];
		groundwaterUtilizationFlag = extrafields["groundwaterUtilizationFlag"];
		groundwaterUtilization = extrafields["groundwaterUtilization"];
		volumeFractionEthylAlcohol = extrafields["volumeFractionEthylAlcohol"];
		paymentGroup = extrafields["paymentGroup"];
		
		// Молоко
		ОписаниеТовара.ПодлежитВетеринарномуКонтролю = (НРег(veterinaryControl) = НРег("true"));
		ВидыДокументовСертификации = Перечисление_ВидыДокументовОбязательнойСертификации();
		
		Если ЗначениеЗаполнено(declNumber) Тогда
			ОписаниеТовара.ВидДокументаСертификации = ВидыДокументовСертификации.ДекларацияСоответствия;
			ОписаниеТовара.НомерДокументаСертификации = СокрЛП(declNumber);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(certNumber) Тогда
			ОписаниеТовара.ВидДокументаСертификации = ВидыДокументовСертификации.СертификатСоответствия;
			ОписаниеТовара.НомерДокументаСертификации = СокрЛП(certNumber);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(regNumber) Тогда
			ОписаниеТовара.ВидДокументаСертификации = ВидыДокументовСертификации.СвидетельствоГосРегистрации;
			ОписаниеТовара.НомерДокументаСертификации = СокрЛП(regNumber);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(okpd2Group) Тогда
			ОписаниеТовара.ДопРеквизиты.ОКПД2 = okpd2Group;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(groundwaterUtilizationFlag) Тогда
			ОписаниеТовара.ДопРеквизиты.НеДобываетсяИзПодземныхВод = (НРег(groundwaterUtilization) = НРег("ДА"));
		КонецЕсли;
			
		Если ОписаниеТовара.ВидПродукции = ВидыПродукции.Пиво
			Или ОписаниеТовара.ВидПродукции = ВидыПродукции.БезалкогольноеПиво Тогда
			consumerPackageVolume = extraFields["consumerPackageVolume"];
			ОписаниеТовара.ДопРеквизиты.ЭтоКег = (НРег(packageType) = НРег("КЕГ"));
			ОписаниеТовара.ДопРеквизиты.НоминальныйОбъем = ЧислоИзСтроки(consumerPackageVolume);
		КонецЕсли;
		
		Если ОписаниеТовара.ВидПродукции = ВидыПродукции.БезалкогольныеНапитки Тогда
			volumeProduct = extraFields["volumeProduct"];
			ОписаниеТовара.ДопРеквизиты.ЭтоКег = (НРег(packageType) = НРег("КЕГ"));
			ОписаниеТовара.ДопРеквизиты.НоминальныйОбъем = ЧислоИзСтроки(volumeProduct);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(serviceLifeCharacteristic) Тогда
			ОписаниеТовара.ДопРеквизиты.ХарактеристикаСрокаИспользования = ХарактеристикаСрокаИспользованияПоЗначениюИзСервиса(
			serviceLifeCharacteristic);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(volumeFractionEthylAlcohol) Тогда
			ОписаниеТовара.ДопРеквизиты.ОбъемнаяДоляЭтиловогоСпирта = ЧислоИзСтроки(volumeFractionEthylAlcohol);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(paymentGroup) Тогда
			ОписаниеТовара.ДопРеквизиты.ГруппаПлатности = ЧислоИзСтроки(paymentGroup);
		КонецЕсли;
		
	КонецЕсли;
	
	storageConditions = value["storageConditions"];
	Если ЗначениеЗаполнено(storageConditions) Тогда
		
		УсловияХранения = Новый Массив;
		ДополнитьМассив(УсловияХранения, ОписаниеТовара.УсловияХранения, , Ложь);
		ОписаниеТовара.УсловияХранения.Очистить();
		
		Для каждого storageCondition Из storageConditions Цикл
			
			СтрокаУсловия = Новый_Товар_СтрокаУсловияХранения();
			СтрокаУсловия.Тип = storageCondition["id"];
			СтрокаУсловия.Описание = storageCondition["name"];
			
			Отбор = Новый Структура("Тип", СтрокаУсловия.Тип);
			ПредыдущиеУсловия = МассивСтруктур_НайтиСтроку(УсловияХранения, Отбор);
			Если ПредыдущиеУсловия = Неопределено Тогда
				СтрокаУсловия.Использовать = Истина;
			Иначе
				СтрокаУсловия.Использовать = ПредыдущиеУсловия.Использовать;
				СтрокаУсловия.СрокХранения = ПредыдущиеУсловия.СрокХранения;
			КонецЕсли;
			
			ОписаниеТовара.УсловияХранения.Добавить(СтрокаУсловия);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(isReasonCertMissing) Тогда
		ОписаниеТовара.ДопРеквизиты.ОтсутствуютТребованияРД = isReasonCertMissing;
	КонецЕсли;
	
	model = value["model"];
	Если ЗначениеЗаполнено(model) Тогда
		ОписаниеТовара.Артикул = АртикулПоЗначениюИзСервиса(model);
	КонецЕсли;
	
	ТоварСтрокойПосле = ЗначениеВСтрокуВнутр(ОписаниеТовара);
	ЕстьИзменения = (ТоварСтрокойДо <> ТоварСтрокойПосле);
	
	Возврат ЕстьИзменения;
	
КонецФункции

// Заполняет структуру данных состава набора
//
// Параметры:
//  ОписаниеТовара - Структура - см. Новый_Товар();
//
Процедура Товар_ПрочитатьСоставНабора(ОписаниеТовара)
	
	Для каждого Стр Из ОписаниеТовара.Ссылка.СоставНабора Цикл
		НоваяСтрока = Новый_Товар_СтрокаНабора();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		ОписаниеТовара.СоставНабора.Добавить(НоваяСтрока);
	КонецЦикла;
	
КонецПроцедуры

// Заполняет структуру данных условий хранения
//
// Параметры:
//  ОписаниеТовара - Структура - см. Новый_Товар();
//
Процедура Товар_ПрочитатьУсловияХранения(ОписаниеТовара)
	
	Для каждого Стр Из ОписаниеТовара.Ссылка.УсловияХранения Цикл
		НоваяСтрока = Новый_Товар_СтрокаУсловияХранения();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		ОписаниеТовара.УсловияХранения.Добавить(НоваяСтрока);
	КонецЦикла;
	
КонецПроцедуры

// Устанавливает исключительную блокировку номенклатуры по GTIN
//
// Параметры:
//  GTIN - Строка- GTIN, по которому нужно заблокировать номенклатуру
//
Процедура Товар_Заблокировать(GTIN)
	
	Объект = "Справочник.КонтурМаркировка_Товары";
	Значения = Новый Структура("GTIN", GTIN);
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		ЗаблокироватьПоЗначениямДляИзменения(Объект, Значения);
		Возврат;
	КонецЕсли;
	
	Если Не ПоддерживаютсяПоляБлокировкиДанных() Тогда
		Возврат;
	КонецЕсли;
	
	ЗаблокироватьПоЗначениям(Объект, Значения);
	
КонецПроцедуры

// Проверяет что GTIN не записан в другой карточке товара
//
// Параметры:
//  Товар - Строка - GTIN;
//  Товар - СправочникСсылка.КонтурМаркировка_Товары - товар;
//
Процедура Товар_ПроверитьУникальностьGTIN(GTIN, Товар)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Товары КАК Т
	|ГДЕ
	|	Т.GTIN = &GTIN
	|	И Т.Ссылка <> &Товар");
	Запрос.УстановитьПараметр("GTIN", GTIN);
	Запрос.УстановитьПараметр("Товар", Товар);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ТекстОшибки = НСтр("ru = 'GTIN %1 уже указан в карточке товара: %2'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, GTIN, Выборка.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

// Проверяет что GTIN соответствует формату
//
// Параметры:
//  GTIN - Строка - код товара GTIN
//
Процедура Товар_ПроверитьФорматGTIN(GTIN)
	
	Если СтрДлина(GTIN) <> 14 Тогда
		ТекстОшибки = НСтр("ru = 'Код товара (GTIN) ""%1"" должен содержать 14 символов'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, GTIN);
	КонецЕсли;
	
	Если Не ВСтрокеТолькоЦифры(GTIN) Тогда
		ТекстОшибки = НСтр("ru = 'Код товара (GTIN) ""%1"" должен содержать только цифры'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, GTIN);
	КонецЕсли;
	
КонецПроцедуры

Функция Товар_ПоследнийДобавленныйВСправочник()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(Т.Ссылка), НЕОПРЕДЕЛЕНО) КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Товары КАК Т");
	
	Возврат ПолучитьРезультатЗапроса(Запрос);
	
КонецФункции

Функция Товар_ГруппаПлатности(Товар) Экспорт
	
	Возврат ДопРеквизит_Прочитать(Товар, "ГруппаПлатности", 0);
	
КонецФункции

Функция Товар_ОтсутствуютТребованияРД(Товар) Экспорт
	
	Возврат ДопРеквизит_Прочитать(Товар, "ОтсутствуютТребованияРД", Ложь);
	
