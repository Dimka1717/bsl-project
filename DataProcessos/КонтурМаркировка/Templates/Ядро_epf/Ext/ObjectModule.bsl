Функция ВерсияМетрики() Экспорт
	
	Возврат "1.0.0";
	
КонецФункции

Функция Новый_СтекМетрик() Экспорт
	
	Топики = Новый Структура;
	
	Для Каждого Элемент Из Перечисление_ТопикиМетрики() Цикл
		Топики.Вставить(Элемент.Значение, Новый Массив);
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("Топики", Топики);
	Результат.Вставить("РазмерСтека", 0);
	Результат.Вставить("ДатаПервогоСобытия", '00010101');
	Результат.Вставить("ДатаПоследнейОтправки", '00010101');
	Результат.Вставить("ФункциональностьПоОрганизациям", Новый Соответствие);
	Результат.Вставить("ЗамерыПроизводительности", Новый Соответствие);
	Результат.Вставить("ПаузыЗамеровПроизводительности", Новый Соответствие);
	Результат.Вставить("КонтекстПриложенияНаСервере", КонтекстПриложения());
	Результат.Вставить("КонтекстПриложенияНаКлиенте");
	
	Возврат Результат;
	
КонецФункции

Функция Новый_СессияМетрики(Топик, Организация, Сертификат, КэшРезультатов = Неопределено)
	
	Если КэшРезультатов <> Неопределено Тогда
		Результат = КэшРезультатов[Организация];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура;
	
	Если Топик <> Перечисление_ТопикиМетрики().ОбщепродуктоваяСтатистика Тогда
		Результат.Вставить("CustomSessionId", Строка(ПараметрыСессии_Прочитать("ИдентификаторСеанса")));
	КонецЕсли;
	
	Результат.Вставить("KeSession", Новый Структура);
	Результат.KeSession.Вставить("AbonId", Строка(ИдентификаторИнформационнойБазы()));
	Результат.KeSession.Вставить("UserId", Строка(ИдентификаторПользователяОС()));
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		Если Не ЗначениеЗаполнено(Сертификат) Тогда
			Сертификат = НастройкаПодписания_ПодобратьСертификат(Организация);
		КонецЕсли;
		
		РеквизитыОрганизации = ЗначенияРеквизитовОбъекта_Марк(Организация, "Идентификатор, ИНН, КПП");
		AccountId = РеквизитыОрганизации.Идентификатор;
		Marker = ПараметрыВСтроку("%1-%2", РеквизитыОрганизации.ИНН, РеквизитыОрганизации.КПП);
		PortalUserId = ПортальныйИдентификаторПользователя_Прочитать(Сертификат);
		
		Если ЗначениеЗаполнено(AccountId) Тогда
			Результат.Вставить("NormativeSession", Новый Структура);
			Результат.NormativeSession.Вставить("Marker", Marker);
			Результат.NormativeSession.Вставить("AccountId", AccountId);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(PortalUserId) Тогда
			Результат.Вставить("PortalSession", Новый Структура("PortalUserId", PortalUserId));
		КонецЕсли;
		
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(Организация, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ОписаниеМетрики(Категория, Действие, ДопСведения = Неопределено
	, Метка = Неопределено
	, Представление = Неопределено) Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Метка", Метка);
	Результат.Вставить("Действие", Действие);
	Результат.Вставить("Категория", Категория);
	Результат.Вставить("ДопСведения", ДопСведения);
	Результат.Вставить("Представление", Представление);
	Результат.Вставить("ОтметкаВремени", ТекущаяУниверсальнаяДатаВМиллисекундах());
	
	Результат.Вставить("НаКлиенте", Ложь);
	Результат.Вставить("ПервыйЗапускМодуля", Ложь);
	Результат.Вставить("Организация", Справочники.КонтурМаркировка_Организации.ПустаяСсылка());
	
	Результат.Вставить("Сертификат");
	Результат.Вставить("ДокументУчета");
	Результат.Вставить("ИдентификаторТрассировки");
	
	Возврат Результат;
	
КонецФункции

Функция Новый_СобытиеМетрики(ОписаниеМетрики, ДатаОтправки, КонтекстПриложения)
	
	Результат = Новый Структура;
	Результат.Вставить("Session");
	Результат.Вставить("ClientInfo");
	Результат.Вставить("ClientInstanceId");
	
	Результат.Вставить("Id", Строка(Новый УникальныйИдентификатор));
	Результат.Вставить("Time", Новый_ДатаМетрики(ОписаниеМетрики.ОтметкаВремени, ДатаОтправки));
	Результат.Вставить("AppContext", КонтекстПриложения);
	
	Результат.Вставить("Path", Новый Структура);
	Результат.Path.Вставить("Action", ОписаниеМетрики.Действие);
	Результат.Path.Вставить("Category", ОписаниеМетрики.Категория);
	
	Если ЗначениеЗаполнено(ОписаниеМетрики.Метка) Тогда
		Результат.Path.Вставить("Label", ОписаниеМетрики.Метка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеМетрики.Представление) Тогда
		Результат.Path.Вставить("View", ОписаниеМетрики.Представление);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеМетрики.ИдентификаторТрассировки) Тогда
		Результат.Вставить("TraceId", Строка(ОписаниеМетрики.ИдентификаторТрассировки));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеМетрики.ДопСведения) Тогда
		Результат.Вставить("Variables", Новый_ПеременныеМетрики(ОписаниеМетрики.ДопСведения));
	КонецЕсли;
	
	Если ОписаниеМетрики.ПервыйЗапускМодуля Тогда
		// Контекст приложения общий для всех метрик, чтобы его изменить нужно скопировать
		Результат.AppContext = СкопироватьОбъект(Результат.AppContext);
		Результат.AppContext.Hardware.Вставить("CoresCount", 1);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ИнформацияОКлиентеМетрики()
	
	Результат = Новый Структура;
	Результат.Вставить("ClientName", "mark");
	Результат.Вставить("ClientVersion", ВерсияОбработки());
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ПеременныеМетрики(ДопСведения)
	
	Если ТипЗнч(ДопСведения) = Тип("Соответствие") Тогда
		Результат = Новый Соответствие;
	Иначе
		Результат = Новый Структура;
	КонецЕсли;
	
	Для Каждого Элемент Из ДопСведения Цикл
		Если Элемент.Значение <> Ложь И ЗначениеЗаполнено(Элемент.Значение) Тогда
			Результат.Вставить(Элемент.Ключ, ОписаниеЗначенияПеременнойМетрики(Элемент.Значение));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ДатаМетрики(ОтметкаВремени, ДатаОтправки)
	
	ДатаСобытия = ДатаИзДатыВМиллиСекундах(ОтметкаВремени);
	
	Результат = Новый Структура;
	Результат.Вставить("ClientTime", СтрокаУниверсальнойДатыXML(ДатаСобытия));
	Результат.Вставить("SendFromClientTime", УниверсальнаяДатаXML(ДатаОтправки));
	
	Возврат Результат;
	
КонецФункции

