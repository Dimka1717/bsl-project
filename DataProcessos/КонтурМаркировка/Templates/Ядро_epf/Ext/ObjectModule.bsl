// Добавляет в функциональность использование мест осуществления деятельности
//
// Параметры:
//  ОписаниеОперации - СправочникСсылка.КонтурМаркировка_СервисПровайдеры - сервис-провайдер;
//
Процедура Метрика_Функциональность_Площадки(ОписаниеОперации)
	
	Если Не ЭтоОтчетОНанесении(ОписаниеОперации.ТипОперации) Тогда
		Возврат;
	КонецЕсли;
	
	Площадка = ОписаниеОперации.ДопРеквизиты.Площадка;
	Если Не ЗначениеЗаполнено(Площадка) Тогда
		Возврат;
	КонецЕсли;
	
	Если Площадка.ТипПлощадки = Перечисления.КонтурМаркировка_ТипыПлощадок.МОД Тогда
		Функциональность = Перечисление_ФункциональностьМодуля().МестаОсуществленияДеятельности;
	Иначе
		Функциональность = Перечисление_ФункциональностьМодуля().ПроизводственныеПлощадки;
	КонецЕсли;
	
	СтекМетрик_ДобавитьФункциональность(Функциональность, ОписаниеОперации.Организация);
	
КонецПроцедуры

// Добавляет в метрики событие об использовании уведомления об отгрузке
//
// Параметры:
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - Организация;
//  ТипОтгрузки - Строка - см. Перечисление_ТипыОтгрузок();
//  ОбъемноСортовойУчет - Булево - признак объемно-сортового учета;
//
Процедура Метрика_Функциональность_Отгрузка(ТипОтгрузки, Организация, ОбъемноСортовойУчет)
	
	ТипыОтгрузок = Перечисление_ТипыОтгрузок();
	
	Если ТипОтгрузки = ТипыОтгрузок.ТрансграничнаяТорговля Тогда
		Если ОбъемноСортовойУчет Тогда
			Функциональность = Перечисление_ФункциональностьМодуля().СообщениеОбОтгрузкеОСУ;
		Иначе
			Функциональность = Перечисление_ФункциональностьМодуля().ТрансграничнаяТорговля;
		КонецЕсли;
	ИначеЕсли ТипОтгрузки = ТипыОтгрузок.ОтгрузкаСВыводомИзОборота Тогда
		Функциональность = Перечисление_ФункциональностьМодуля().ОтгрузкаСВыводомИзОборота;
	Иначе
		ТекстОшибки = НСтр("ru = 'Неизвестный тип отгрузки: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, ТипОтгрузки);
	КонецЕсли;
	
	СтекМетрик_ДобавитьФункциональность(Функциональность, Организация);
	
КонецПроцедуры

