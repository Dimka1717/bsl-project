Функция РазрешенаЗаписьВКаталогИнформационнойБазы()
	
	Результат = Истина;
	
	Префикс = "Mark_WriteTest_";
	Расширение = ".txt";
	УникальнаяЧасть = Строка(Новый УникальныйИдентификатор);
	Каталог = КаталогИнформационнойБазыЛок();
	
	ИмяТестовогоФайла = Префикс + УникальнаяЧасть + Расширение;
	ПутьКТестовомуФайлу = МодульОбщегоНазначения().ОбъединитьПути(Каталог, ИмяТестовогоФайла);
	
	Попытка
		ЗаписатьТекстВФайл("Тест записи файла", ПутьКТестовомуФайлу);
	Исключение
		Результат = Ложь;
	КонецПопытки;
	
	Попытка
		// BSLLS:FileSystemAccess-off
		// BSLLS:UsingSynchronousCalls-off
		УдалитьФайлы(ПутьКТестовомуФайлу);
		// BSLLS:UsingSynchronousCalls-on
		// BSLLS:FileSystemAccess-on
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ВалютаРуб()
	
	Если Не ЕстьМетаданные("Справочники.Валюты") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Валюты КАК Т
	|ГДЕ
	|	Т.Код В(&Код)
	|	И НЕ Т.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Код");
	
	ПодходящиеКодыВалюты = Новый Массив;
	ПодходящиеКодыВалюты.Добавить("643");
	ПодходящиеКодыВалюты.Добавить("810");
	Запрос.УстановитьПараметр("Код", ПодходящиеКодыВалюты);
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	Результат = ПолучитьРезультатЗапроса(Запрос, , Справочники.Валюты.ПустаяСсылка());
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

