// Записывает данные редактора кодов в справочник файл
//
// Параметры:
//  ВладелецФайла - СправочникСсылка.КонтурМаркировка_Файлы - владелец файла;
//  ДанныеРедактора - Структура - см. Новый_ДанныеРедактораКодов();
//
Процедура РедакторКодов_ЗаписатьФайл(ВладелецФайла, ДанныеРедактора) Экспорт
	
	ТипФайла = Перечисление_ТипыФайлов().КодыРедактора;
	ФайлКодов = Файл_Найти(ВладелецФайла, ТипФайла);
	
	Если ЗначениеЗаполнено(ФайлКодов) Тогда
		ОписаниеФайла = Файл_Прочитать(ФайлКодов);
		ОписаниеФайла.ДанныеФайла = ДанныеРедактора;
		Файл_Записать(ОписаниеФайла);
	Иначе
		Файл_Добавить(ДанныеРедактора, ТипФайла, ВладелецФайла);
	КонецЕсли;
	
КонецПроцедуры

// Удаляет файл, содержащий данные редактора кодов.
//
// Параметры:
//  ВладелецФайла - СправочникСсылка.КонтурМаркировка_Файлы - владелец файла;
//
Процедура РедакторКодов_УдалитьФайл(ВладелецФайла) Экспорт
	
	ТипФайла = Перечисление_ТипыФайлов().КодыРедактора;
	Файлы_Удалить(Файлы_Найти(ВладелецФайла, ТипФайла));
	
КонецПроцедуры

// Получает данные редактора кодов из файла
//
// Параметры:
//  ВладелецФайла - СправочникСсылка.КонтурМаркировка_Файлы - владелец файла;
// 
// Возвращаемое значение:
//  Неопределено - нет записанных данных;
//  Структура - см. Новый_ДанныеРедактораКодов();
//
Функция РедакторКодов_ПолучитьИзФайла(ВладелецФайла) Экспорт
	
	ТипФайла = Перечисление_ТипыФайлов().КодыРедактора;
	ФайлКодов = Файл_Найти(ВладелецФайла, ТипФайла);
	
	Результат = Неопределено;
	Если ЗначениеЗаполнено(ФайлКодов) Тогда
		Результат = Новый_ДанныеРедактораКодов();
		ОписаниеФайла = Файл_Прочитать(ФайлКодов);
		ЗаполнитьЗначенияСвойств(Результат, ОписаниеФайла.ДанныеФайла);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ДанныеРедактораКодов(ТаблицаКодов = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ТаблицаКодов", ТаблицаКодов);
	Результат.Вставить("УдалитьСтарыеКоды", Ложь);
	Результат.Вставить("ЗагружатьПолныеКоды", Ложь);
	Результат.Вставить("ЗаполнитьТоварыАгрегатов", Ложь);
	Результат.Вставить("УдалитьИзДокументаКодыВАгрегатах", Ложь);
	
	Возврат Результат;
	
КонецФункции

