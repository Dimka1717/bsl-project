// Возвращает объект обработки tests/mock.epf
// 
// Возвращаемое значение:
//  ОбработкаОбъект
//
Функция Мок() Экспорт
	
	Если Не НастройкиМодуля().РежимТестирования Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если МодульЯдроОткрытИзКонфигурации() Тогда
		Возврат ОбъектВложеннойОбработкиИзКонфигурации(Мок_ИмяФайла());
	КонецЕсли;
	
	КлючКэш = "ОбъектОбработки_Мок";
	КэшОбработки = Кэш_Прочитать(КлючКэш);
	Если КэшОбработки <> Неопределено
		И КэшОбработки.ОбъектОбработки <> Неопределено
		И КэшОбработки.ДатаИзмененияФайла = МодульОбщегоНазначения().ДатаИзмененияФайла(КэшОбработки.ПутьКФайлу) Тогда
		Возврат КэшОбработки.ОбъектОбработки;
	КонецЕсли;
	
	Если РасположениеМодуля() <> Перечисление_ВариантыРасположенияОбработки().НаДиске Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КаталогМодуля = МодульОбщегоНазначения().КаталогОбработки(ЭтотОбъект);
	КаталогМодуля = МодульОбщегоНазначения().УдалитьЧастьПути(КаталогМодуля, "include");
	ПутьКФайлу = МодульОбщегоНазначения().ОбъединитьПути(КаталогМодуля, "tests", Мок_ИмяФайла());
	Если Не МодульОбщегоНазначения().ФайлСуществует(ПутьКФайлу) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		ОбъектОбработки = МодульОбщегоНазначения().СоздатьВнешнююОбработкуБезПредупреждений(ПутьКФайлу);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	КэшОбработки = Новый Структура;
	КэшОбработки.Вставить("ПутьКФайлу", ПутьКФайлу);
	КэшОбработки.Вставить("ОбъектОбработки", ОбъектОбработки);
	КэшОбработки.Вставить("ДатаИзмененияФайла", МодульОбщегоНазначения().ДатаИзмененияФайла(ПутьКФайлу));
	Кэш_Поместить(КлючКэш, КэшОбработки);
	
	Возврат ОбъектОбработки;
	
КонецФункции

Функция МокДоступен() Экспорт
	
	КлючКэш = "МокДоступен";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = (Мок() <> Неопределено);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

