Функция Новый_ОписаниеЗапросаHTTP() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Хост");
	Результат.Вставить("Порт");
	Результат.Вставить("Схема");
	Результат.Вставить("Логин");
	Результат.Вставить("Пароль");
	Результат.Вставить("Таймаут");
	Результат.Вставить("НастройкиПрокси", Новый_НастройкиПрокси());
	Результат.Вставить("ДатаЗапроса");
	
	Результат.Вставить("Метод");
	Результат.Вставить("ПутьНаСервере");
	Результат.Вставить("ТелоЗапроса");
	Результат.Вставить("Параметры"					, Новый Соответствие);
	Результат.Вставить("Заголовки"					, Новый Соответствие);
	Результат.Вставить("ДопустимыеКодыОтвета"		, Новый Массив);
	Результат.Вставить("ТелоОтветаКакДвоичныеДанные", Ложь);
	
	Результат.Метод = "GET";
	Результат.Таймаут = 180;
	
	Результат.ДопустимыеКодыОтвета.Добавить(200); // Хорошо
	Результат.ДопустимыеКодыОтвета.Добавить(201); // Создано
	Результат.ДопустимыеКодыОтвета.Добавить(202); // Принято
	Результат.ДопустимыеКодыОтвета.Добавить(204); // Успешно обработано
	
	Возврат Результат;
	
КонецФункции

