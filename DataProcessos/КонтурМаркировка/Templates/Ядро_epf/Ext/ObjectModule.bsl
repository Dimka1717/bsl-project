// Читает из базы данные площадки
//
// Параметры:
//  Ссылка - СправочникСсылка.КонтурМаркировка_Площадки - площадка;
// 
// Возвращаемое значение:
//  Структура - см. Новый_Площадка()
//
Функция Площадка_Прочитать(Ссылка) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.*
	|ИЗ
	|	Справочник.КонтурМаркировка_Площадки КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый_Площадка();
	ЗаполнитьЗначенияСвойств(Результат, Выборка, , "ВидыПродукции");
	Результат.Организация = Выборка.Владелец;
	
	ВыборкаВидыПродукции = Выборка.ВидыПродукции.Выбрать();
	Пока ВыборкаВидыПродукции.Следующий() Цикл
		Результат.ВидыПродукции.Добавить(ВыборкаВидыПродукции.ВидПродукции);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Записывает площадку в справочник
//
// Параметры:
//  ОписаниеМОД - Структура - см. фунцию Новый_Площадка();
//
Процедура Площадка_Записать(ОписаниеМОД) Экспорт
	
	Ссылка = ОписаниеМОД.Ссылка;
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		
		Если ОбъектВПроцессеОбновления(Ссылка) Тогда
			ВызватьИсключение_ОбъектВПроцессеОбновления(Ссылка);
		КонецЕсли;
		
		Объект = Ссылка.ПолучитьОбъект();
		
	Иначе
		Объект = Справочники.КонтурМаркировка_Площадки.СоздатьЭлемент();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеМОД.Ссылка)
		И ОписаниеМОД.ВерсияДанных <> Объект.ВерсияДанных Тогда
		ВызватьИсключение НСтр(
		"ru = 'В базе изменилась версия места осуществления деятельности, текущую версию записать невозможно!'");
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект, ОписаниеМОД,, "Ссылка, ВидыПродукции");
	Объект.Владелец = ОписаниеМОД.Организация;
	
	Объект.ВидыПродукции.Очистить();
	Для Каждого ВидПродукции Из ОписаниеМОД.ВидыПродукции Цикл
		Стр = Объект.ВидыПродукции.Добавить();
		Стр.ВидПродукции = ВидПродукции;
	КонецЦикла;
	
	Объект.Записать();
	
	ОписаниеМОД.Ссылка = Объект.Ссылка;
	ОписаниеМОД.ВерсияДанных = Объект.ВерсияДанных;
	
КонецПроцедуры

// Синхронизирует с сервисом список мест осуществления деятельности
//
// Параметры:
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация
//
Процедура СинхронизироватьПлощадки(Организация) Экспорт
	
	ОбработанныеПлощадки = Новый Массив;
	
	Для каждого ВидПродукции Из ДопустимыеВидыПродукцииДляЗагрузкиПлощадок() Цикл
		
		Попытка
			ManufactureInfos = Маркировка_СписокПлощадок(Организация, ВидПродукции);
		Исключение
			Ошибка = ИнформацияОбОшибке();
			Действие = НСтр("ru = 'Синхронизация списка площадок'");
			ДопИнформация = Новый Структура;
			ДопИнформация.Вставить("Организация", Организация);
			ДопИнформация.Вставить("ВидПродукции", ВидПродукции);
			ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
			Продолжить;
		КонецПопытки;
		
		Для Каждого ManufactureInfo Из ManufactureInfos Цикл
			
			name = СвойствоСтруктуры(ManufactureInfo, "name");
			address = СвойствоСтруктуры(ManufactureInfo, "address");
			countryCode = СвойствоСтруктуры(ManufactureInfo, "countryCode");
			productGroups = СвойствоСтруктуры(ManufactureInfo, "productGroups");
			id = СвойствоСтруктуры(ManufactureInfo, "id");
			vetisGuid = СвойствоСтруктуры(ManufactureInfo, "vetisGuid", "");
			fiasId = СвойствоСтруктуры(ManufactureInfo, "fiasId", "");
			kpp = СвойствоСтруктуры(ManufactureInfo, "kpp", "");
			isMod = СвойствоСтруктуры(ManufactureInfo, "isMod", Ложь);
			
			Если ЭтоСтрокаПустогоИдентификатора(fiasId) Тогда
				fiasId = "";
			КонецЕсли;
			Если ЭтоСтрокаПустогоИдентификатора(vetisGuid) Тогда
				vetisGuid = "";
			КонецЕсли;
			
			Если isMod Тогда
				ТипПлощадки = Перечисления.КонтурМаркировка_ТипыПлощадок.МОД;
			Иначе
				ТипПлощадки = Перечисления.КонтурМаркировка_ТипыПлощадок.ПроизводственнаяПлощадка;
			КонецЕсли;
			
			Ссылка = Площадка_Найти(ТипПлощадки, id, vetisGuid, fiasId, kpp);
			
			Если ЗначениеЗаполнено(Ссылка) Тогда
				ОписаниеМОД = Площадка_Прочитать(Ссылка);
				Если ОбработанныеПлощадки.Найти(Ссылка) = Неопределено Тогда
					ОписаниеМОД.ВидыПродукции.Очистить();
				КонецЕсли;
			Иначе
				ОписаниеМОД = Новый_Площадка();
			КонецЕсли;
			
			ОписаниеМОД.Организация = Организация;
			ОписаниеМОД.ТипПлощадки = ТипПлощадки;
			ОписаниеМОД.КодСтраны = countryCode;
			ОписаниеМОД.Адрес = address;
			ОписаниеМОД.КПП = kpp;
			ОписаниеМОД.ИдентификаторФИАС = fiasId;
			ОписаниеМОД.ИдентификаторВЕТИС = vetisGuid;
			ОписаниеМОД.КодГИСМТ = id;
			
			Если Не ЗначениеЗаполнено(ОписаниеМОД.Наименование) Тогда
				Если ЗначениеЗаполнено(name) Тогда
					ОписаниеМОД.Наименование = name;
				Иначе
					ОписаниеМОД.Наименование = address;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(productGroups) Тогда
				Для Каждого productGroup Из productGroups Цикл
					ВидПродукции = ВидПродукцииПоТоварнойГруппеИзСервиса(productGroup);
					Если ОписаниеМОД.ВидыПродукции.Найти(ВидПродукции) = Неопределено Тогда
						ОписаниеМОД.ВидыПродукции.Добавить(ВидПродукции);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Площадка_Записать(ОписаниеМОД);
			
			Если ОбработанныеПлощадки.Найти(Ссылка) = Неопределено Тогда
				ОбработанныеПлощадки.Добавить(ОписаниеМОД.Ссылка);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Метрика_Функциональность_СинхронизацияМОД(Организация);
	
КонецПроцедуры

// Находит в базе площадку по идентификаторам
// Идентификатор ГИС МТ является приоритетным
//
// Параметры:
//  ТипПлощадки - ПеречислениеСсылка.КонтурМаркировка_ТипыПлощадок - тип площадки;
//  КодГИСМТ - Строка - код ГИС МТ;
//  ИдентификаторВЕТИС - Строка - идентификатор ВетИС;
//  ИдентификаторФИАС - Строка - идентификатор ФИАС;
//  КПП - Строка - КПП;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Площадки
//
Функция Площадка_Найти(ТипПлощадки, КодГИСМТ, ИдентификаторВЕТИС, ИдентификаторФИАС, КПП)
	
	ДопустимыеТипыПлощадки = Новый Массив;
	ДопустимыеТипыПлощадки.Добавить(ТипПлощадки);
	ДопустимыеТипыПлощадки.Добавить(Перечисления.КонтурМаркировка_ТипыПлощадок.ПустаяСсылка());

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Площадки КАК Т
	|ГДЕ
	|	Т.КодГИСМТ = &КодГИСМТ
	|	И Т.ТипПлощадки В(&ДопустимыеТипыПлощадки)");
	Запрос.УстановитьПараметр("ДопустимыеТипыПлощадки", ДопустимыеТипыПлощадки);
	Запрос.УстановитьПараметр("КодГИСМТ", КодГИСМТ);
	Результат = ПолучитьРезультатЗапроса(Запрос);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Площадки КАК Т
	|ГДЕ
	|	Т.КодГИСМТ = &ПустойКодГИСМТ
	|	И &ИдентификаторФИАС И &КПП
	|	И &ИдентификаторВЕТИС
	|	И Т.ТипПлощадки В(&ДопустимыеТипыПлощадки)";
	
	Если ЗначениеЗаполнено(КПП) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КПП", "Т.КПП = &КПП");
	Иначе
		Если ЗначениеЗаполнено(ИдентификаторФИАС) Тогда
			// Идентификатор ФИАС используется в паре с КПП
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КПП", "Т.КПП = """"");
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КПП", "ИСТИНА");
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторФИАС) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИдентификаторФИАС", "Т.ИдентификаторФИАС = &ИдентификаторФИАС");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИдентификаторФИАС", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторВЕТИС) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИдентификаторВЕТИС", "Т.ИдентификаторВЕТИС = &ИдентификаторВЕТИС");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИдентификаторВЕТИС", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ПустойКодГИСМТ", 0);
	Запрос.УстановитьПараметр("ДопустимыеТипыПлощадки", ДопустимыеТипыПлощадки);
	Запрос.УстановитьПараметр("ИдентификаторВЕТИС", ИдентификаторВЕТИС);
	Запрос.УстановитьПараметр("ИдентификаторФИАС", ИдентификаторФИАС);
	Запрос.УстановитьПараметр("КПП", КПП);
	
	Результат = ПолучитьРезультатЗапроса(Запрос);
	
	Возврат Результат;
	
КонецФункции

// Описание площадки
// 
// Возвращаемое значение:
//  Структура - описание сервис-провайдера:
//   * Ссылка - КонтурМаркировка_СервисПровайдеры - ссылка на элемент;
//   * Наименование - Строка - наименование сервис-провайдера;
//   * ИНН - Строка - ИНН;
//   * Роль - ПеречислениеСсылка.КонтурМаркировка_РолиСервисПровайдеров - роль сервис-провайдера;
//   * Страна - Строка - наименование страны;
//   * Идентификатор - Строка - идентификатор сервис-провайдера в сервисе;
//   * Площадка - Строка - наименование площадки;
//   * Адрес - Строка - адрес сервис-провайдера;
//   * КонтактноеЛицо - Строка - контактное лицо;
//   * АдресЭП - Строка - электронный адрес;
//   * ВидыПродукции - Массив из ПеречислениеСсылка.КонтурМаркировка_ВидыПродукции - виды продукции;
//
Функция Новый_Площадка() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ссылка");
	Результат.Вставить("Организация");
	Результат.Вставить("ТипПлощадки");
	Результат.Вставить("Наименование");
	Результат.Вставить("КодСтраны");
	Результат.Вставить("Адрес");
	Результат.Вставить("КПП");
	Результат.Вставить("ИдентификаторФИАС");
	Результат.Вставить("ИдентификаторВЕТИС");
	Результат.Вставить("КодГИСМТ", 0);
	Результат.Вставить("ВидыПродукции", Новый Массив);
	Результат.Вставить("ВерсияДанных");
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // Площадки

// #Область Организации

// Возвращает массив всех организации не помеченных на удаление
// 
// Возвращаемое значение:
//  Массив - содержит СправочникСсылка.КонтурМаркировка_Организации
//
Функция Организация_ВсеОрганизации() Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Организации КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления");
	
	Результат = МассивИзРезультатаЗапроса(Запрос);
	
	Возврат Результат;
	
КонецФункции

Процедура Организация_Записать(ОписаниеОрганизации) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Если ЗначениеЗаполнено(ОписаниеОрганизации.Ссылка) Тогда
			Если ОбъектВПроцессеОбновления(ОписаниеОрганизации.Ссылка) Тогда
				ВызватьИсключение_ОбъектВПроцессеОбновления(ОписаниеОрганизации.Ссылка);
			КонецЕсли;
			ОрганизацияОбъект = ОписаниеОрганизации.Ссылка.ПолучитьОбъект();
		Иначе
			ОрганизацияОбъект = Справочники.КонтурМаркировка_Организации.СоздатьЭлемент();
		КонецЕсли;
		
		ОписаниеОрганизации.КлючОрганизации1С = КлючОбъекта1С(ОписаниеОрганизации.Организация1С);
		ОписаниеОрганизации.ТипКлючаОрганизации1С = ТипКлючаОбъекта1С(ОписаниеОрганизации.Организация1С);
		
		ЗаполнитьЗначенияСвойств(ОрганизацияОбъект, ОписаниеОрганизации, , "Ссылка");
		
		ОрганизацияОбъект.Записать();
		
		ОписаниеОрганизации.Ссылка = ОрганизацияОбъект.Ссылка;
		
		ДопРеквизиты_Записать(ОписаниеОрганизации.Ссылка, ОписаниеОрганизации.ДопРеквизиты);
		
		// Отражение организации в справочнике контрагентов
		Контрагент_Подобрать(ОписаниеОрганизации.ИНН, ОписаниеОрганизации.КПП, ОписаниеОрганизации.Наименование);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция Организация_Прочитать(Организация) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка,
	|	Т.Наименование КАК Наименование,
	|	Т.ИНН КАК ИНН,
	|	Т.КПП КАК КПП,
	|	Т.КлючОрганизации1С КАК КлючОрганизации1С,
	|	Т.ТипКлючаОрганизации1С КАК ТипКлючаОрганизации1С,
	|	Т.ОтпечатокСертификата КАК ОтпечатокСертификата,
	|	Т.Идентификатор КАК Идентификатор,
	|	Т.Комментарий КАК Комментарий
	|ИЗ
	|	Справочник.КонтурМаркировка_Организации КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый_Организация();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		Результат.Организация1С = МодульОбщегоНазначения().СсылкаПоИдентификатору(
		Выборка.КлючОрганизации1С, Выборка.ТипКлючаОрганизации1С);
	КонецЕсли;
	
	Организация_ПрочитатьДопРеквизиты(Результат);
	
	Возврат Результат;
	
КонецФункции

// Заполняет из базы доп реквизиты организации
//
// Параметры:
//  Организация - Структура - см. Новый_Организация()
// 
Процедура Организация_ПрочитатьДопРеквизиты(Организация)
	
	ДопРеквизитыИБ = ДопРеквизиты_Прочитать(Организация.Ссылка);
	
	ЗаполнитьПоляСтруктуры(Организация.ДопРеквизиты, ДопРеквизитыИБ);
	
КонецПроцедуры

// Возвращает организацию маркировки по организации учета
//
// Параметры:
//  Организация1С - СправочникСсылка - организация 1С;
//  ВызыватьИсключение - Булево - Истина, если нужно вызвать исключение когда организацию найти не удалось;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Организации - организация маркировки
//
Функция Организация_НайтиПоОрганизации1С(Организация1С, ВызыватьИсключение = Ложь) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Организации КАК Т
	|ГДЕ
	|	Т.КлючОрганизации1С = &КлючОрганизации1С
	|	И Т.ТипКлючаОрганизации1С = &ТипКлючаОрганизации1С
	|	И НЕ Т.ПометкаУдаления");
	Запрос.УстановитьПараметр("КлючОрганизации1С", КлючОбъекта1С(Организация1С));
	Запрос.УстановитьПараметр("ТипКлючаОрганизации1С", ТипКлючаОбъекта1С(Организация1С));
	
	Результат = ПолучитьРезультатЗапроса(Запрос);
	
	Если Не ЗначениеЗаполнено(Результат) И ВызыватьИсключение Тогда
		ШаблонОшибки = НСтр("ru = 'Не удалось найти организацию маркировки по организации 1С: %1'");
		ВызватьИсключение ПараметрыВСтроку(ШаблонОшибки, Организация1С);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Ищет организацию по ИНН
//
// Параметры:
//  ИНН - Стока - ИНН организации, которую нужно найти
//  КэшРезультатов - Соответствие - (необязательный) кэш результатов функции;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Организации - найденная организация;
//  Неопределено - если организацию найти не удалось;
//
Функция Организация_НайтиПоИНН(ИНН, КэшРезультатов = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		Результат = КэшРезультатов[ИНН];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Ссылка = Справочники.КонтурМаркировка_Организации.НайтиПоРеквизиту("ИНН", ИНН);
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Результат = Ссылка;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(ИНН, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает массив организаций, по которым можно выполнять обмен
// 
// Возвращаемое значение:
//  Массив - содержит СправочникСсылка.КонтурМаркировка_Организации
//
Функция Организация_ВсеОрганизацииДляОбмена() Экспорт
	
	Результат = Организация_ВсеОрганизации();
	
	Для Сч = -Результат.ВГраница() По 0 Цикл
		
		Организация = Результат[-Сч];
		
		КонтекстОбмена = Новый_КонтекстОбмена(Организация);
		КонтекстОбмена_ЗаполнитьСертификат(КонтекстОбмена);
		КонтекстОбмена_ПроверитьОрганизацию(КонтекстОбмена);
		
		Если Не КонтекстОбмена.ОбменВозможен Тогда
			Результат.Удалить(-Сч);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает первую организацию, по которой выполнена авторизация в сервисе
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Организации - организация;
//  Неопределено - если не нашли организаций с авторизацией;
//
Функция Организация_ЛюбаяСДоступомВСервис()
	
	Для каждого Организация Из Организация_ВсеОрганизации() Цикл
		
		КонтекстОбмена = Новый_КонтекстОбмена(Организация);
		КонтекстОбмена_ЗаполнитьСертификат(КонтекстОбмена);
		КонтекстОбмена_ПроверитьОрганизацию(КонтекстОбмена);
		АвторизацияМаркировка_Проверить(КонтекстОбмена);
		
		Если КонтекстОбмена.ОбменВозможен
			И Не КонтекстОбмена.ТребуетсяАвторизацияПортала Тогда
			Возврат Организация;
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция Организация_ВсеОрганизацииСАвторизацией()
	
	Результат = Новый Массив;
	
	Для каждого Организация Из Организация_ВсеОрганизации() Цикл
		
		КонтекстОбмена = КонтекстОбменаССервисом(Организация);
		Если Не КонтекстОбмена.ОбменВозможен Тогда
			Продолжить;
		КонецЕсли;
		
		Если Авторизация_Выполнить(КонтекстОбмена) Тогда
			Результат.Добавить(Организация);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция Новый_Организация() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ссылка");
	Результат.Вставить("Наименование");
	Результат.Вставить("ИНН");
	Результат.Вставить("КПП");
	Результат.Вставить("Организация1С");
	Результат.Вставить("КлючОрганизации1С");
	Результат.Вставить("ТипКлючаОрганизации1С");
	Результат.Вставить("ОтпечатокСертификата");
	Результат.Вставить("Идентификатор");
	Результат.Вставить("Комментарий");
	
	Результат.Вставить("ДопРеквизиты", Новый_Организация_ДопРеквизиты());
	
	Возврат Результат;
	
КонецФункции

Функция Новый_Организация_ДопРеквизиты()
	
	Результат = Новый Структура;
	
	Результат.Вставить("ОтключитьОбмен", Ложь);
	Результат.Вставить("ОтключитьЧтениеВходящихУПД", Ложь);
	Результат.Вставить("ОтключитьЧтениеУведомленийОПриемке", Ложь);
	Результат.Вставить("ИдентификаторGS1");
	
	Возврат Результат;
	
КонецФункции

Функция Организация_ПрефиксВидаАгрегатаИзИдентификатораGS1(Организация) Экспорт
	
	МаксДлинаПрефикса = 12;
	
	ИдентификаторGS1 = ДопРеквизит_Прочитать(Организация, "ИдентификаторGS1");
	
	Результат = Неопределено;
	Если ЗначениеЗаполнено(ИдентификаторGS1) Тогда
		Результат = Лев(ИдентификаторGS1, МаксДлинаПрефикса);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьДатуПоследнегоОбмена(Организация)
	
	Реквизит = Перечисление_ДопСвойства().ДатаПоследнегоОбмена;
	ДопСвойство_Записать(Организация, Реквизит, ТекущаяУниверсальнаяДата());
	
КонецПроцедуры

Функция Организация_ИдентификаторИзСервиса(Организация) Экспорт
	
	Результат = Неопределено;
	
	РеквизитыОрганизации = ЗначенияРеквизитовОбъекта_Марк(Организация, Новый Структура("ИНН, КПП"));
	ИНН = РеквизитыОрганизации.ИНН;
	КПП = РеквизитыОрганизации.КПП;
	ДлинаИдентификатора = 36;
	
	ОрганизацииСервиса = Маркировка_СписокОрганизаций(Организация);
	
	Отбор = Новый Структура("inn", ИНН);
	Если ЗначениеЗаполнено(КПП) Тогда
		Отбор.Вставить("kpp", КПП);
	КонецЕсли;
	
	НайденныеСтроки = МассивСтруктур_НайтиСтроки(ОрганизацииСервиса, Отбор);
	
	Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
		
		Для Каждого Стр Из НайденныеСтроки Цикл
			Если СтрДлина(Стр.id) = ДлинаИдентификатора Тогда
				Результат = Стр.id;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Результат = Неопределено Тогда
			ТекстОшибки = ПараметрыВСтроку(НСтр(
			"ru = 'Не удалось найти идентификатор Организации в сервисе'")
			, Организация, ИНН, КПП);
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		
	Иначе
		
		Если ЗначениеЗаполнено(КПП) Тогда
			ТекстОшибки = ПараметрыВСтроку(НСтр(
			"ru = 'Не удалось найти в сервисе организацию ""%1"" по ИНН/КПП: %2/%3'")
			, Организация, ИНН, КПП);
		Иначе
			ТекстОшибки = ПараметрыВСтроку(НСтр(
			"ru = 'Не удалось найти в сервисе организацию ""%1"" по ИНН: %2'")
			, Организация, ИНН);
		КонецЕсли;
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Организация_ИдентификаторGS1ИзСервиса(Организация) Экспорт
	
	Результат = Неопределено;
	
	АнкетаОрганизации = Маркировка_АнкетаОрганизации(Организация);
	
	АнкетаОрганизации.Свойство("gs1CompanyPrefix", Результат);
	
	Возврат Результат;
	
КонецФункции

