	Контент = Контент_ВозвратНаТСД(Комментарий, ОписаниеОперации.ДопРеквизиты);
	
	Попытка
		Ответ = Маркировка_ВозвратНаТСД_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьПодбораКодов;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_ВозвратНаполненияНаТСД(Организация);
	
КонецПроцедуры

Процедура Задача_НазначитьДругоеУстройство_СоздатьВСервисе(ОписаниеЗадачи)
	
	ИдентификаторДокумента = ОписаниеЗадачи.ИдентификаторДокумента;
