// Получает значение дополнительного реквизита "Размер" одной из связанных с товаром номенклатуры
//
// Параметры:
//  ИмяПараметра - Строка - имя параметра;
//  ПараметрыЭтикетки - СтрокаТаблицыЗначений - параметры этикетки;
//  КэшЗначений - Соответствие - кэш значений;
// 
// Возвращаемое значение:
//  Произвольное - значение дополнительного реквизита "Размер" или Неопределено
//
Функция ПримерКакЗаполнитьДополнительныйПараметрЭтикеткиРазмер(ИмяПараметра, ПараметрыЭтикетки, КэшЗначений)
	
	Результат = Неопределено;
	
	Если ИмяПараметра <> "ДопПараметрПечати1" Тогда
		Возврат Результат;
	КонецЕсли;
	
	Товар = ПараметрыЭтикетки.Товар;
	Результат = КэшЗначений[Товар];
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого СтрокаТЗ Из НоменклатураТовара(Товар) Цикл
		
		Результат = ЗначениеДопРеквизитаОбъекта(СтрокаТЗ.Номенклатура, ИмяПараметра);
		Если ЗначениеЗаполнено(Результат) Тогда
			КэшЗначений.Вставить(Товар, Результат);
			Возврат Результат;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Пример загрузки кодов маркировки из csv файла.
// Файл имеет следующую структуру:
// <КодМаркировки>Табуляция<GTIN>Табуляция<Наименование>
//
// Параметры:
//  ТаблицаКодов - Таблица значений - см. ТаблицаНовыхКодов()
//  Расширение - Строка - расширение файла;
//  ДвоичныеДанные - ДвоичныеДанные - данные файла;
//
Процедура ПримерКакЗагрузитьКодыИзCsvФайла(ТаблицаКодов, Расширение, ДвоичныеДанные)
	
	// BSLLS:FileSystemAccess-off
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	
	КоличествоКолонок = 3;
	Чтение = Новый ЧтениеТекста(ИмяВременногоФайла, КодировкаТекста.UTF8);
	Пока Истина Цикл
		
		СтрокаТекста = Чтение.ПрочитатьСтроку();
		Если СтрокаТекста = Неопределено Тогда
			// дошли до конца файла
			Прервать;
		КонецЕсли;
		
		ЧастиТекста = РазделитьСтроку(СтрокаТекста, Символы.Таб);
		Если ЧастиТекста.Количество() <> КоличествоКолонок Тогда
			// строка имеет неверный формат
			// можно вызвать исключение или продолжить загрузку без этой строки
			Продолжить;
		КонецЕсли;
		
		СтрокаКода = ТаблицаКодов.Добавить();
		СтрокаКода.КодМаркировки = ЧастиТекста[0];
		СтрокаКода.ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Молоко;
		
	КонецЦикла;
	
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	// BSLLS:FileSystemAccess-on
	
КонецПроцедуры

