Процедура Пример_ПриЗаполненииДокументаУчета_ВСО(ОписаниеДокумента, Документ1С)
	
	Если ТипЗнч(Документ1С) = Тип("ДокументСсылка.КонтурМаркировкаВСО_ЗаказКодов")
		Или ТипЗнч(Документ1С) = Тип("ДокументСсылка.КонтурМаркировкаВСО_ЗаданиеНаПроизводство") Тогда
		
		ЗаполнитьДокументУчетаПоДокументуВСО(ОписаниеДокумента, Документ1С);
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет операцию данными из документа ВСО
//
Процедура Пример_ПриЗаполненииОперации_ВСО(ОписаниеОперации, Документ1С)
	
	ТипДокумента1С = ТипЗнч(Документ1С);
	
	Если ТипДокумента1С = Тип("ДокументСсылка.КонтурМаркировкаВСО_ЗаказКодов")
		И ОписаниеОперации.ТипОперации = Перечисление_ТипыОпераций().ЗаказКодов Тогда
		
		ТипОплатыКодовВСО = ЗначениеРеквизитаОбъекта_Марк(Документ1С, "ТипОплатыКодов");
		Если ТипОплатыКодовВСО = Перечисления.КонтурМаркировкаВСО_ТипыОплатыКодов.ПоНанесению Тогда
			ТипОплатыКодов = Перечисление_ТипыОплатыКодов().ПоНанесению;
		Иначе
			ТипОплатыКодов = Перечисление_ТипыОплатыКодов().ПоЭмиссии;
		КонецЕсли;
		
		ОписаниеОперации.ДопРеквизиты.ТипОплатыКодов = ТипОплатыКодов;
		ОписаниеОперации.ДопРеквизиты.СпособВыпускаТоваров = Перечисление_СпособыВыпускаТоваров().ПроизводствоРФ;
		
	ИначеЕсли ТипДокумента1С = Тип("ДокументСсылка.КонтурМаркировкаВСО_ЗаданиеНаПроизводство") Тогда
		
		Если ОписаниеОперации.ТипОперации = Перечисление_ТипыОпераций().ОтчетОНанесении Тогда
			
			ДатаСрокаГодности = ЗначениеРеквизитаОбъекта_Марк(Документ1С, "СрокГодности");
			ОписаниеОперации.ДопРеквизиты.ТипИспользования = Перечисление_ТипыИспользованияКодов().Нанесен;
			
			Для Каждого Стр Из ОписаниеОперации.Товары Цикл
				Стр.ДатаСрокаГодности = ДатаСрокаГодности;
			КонецЦикла;
			
		ИначеЕсли ОписаниеОперации.ТипОперации = Перечисление_ТипыОпераций().ВводВОборот Тогда
			
			ДатаПроизводства = ЗначениеРеквизитаОбъекта_Марк(Документ1С, "ДатаПроизводства");
			
			ОписаниеОперации.ДопРеквизиты.ДатаПроизводства = ДатаПроизводства;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

