Процедура ПримерДозаполненияСпискаДокументовНужнымДопСвойством(СписокДокументовУчета, НужноеСвойство, ИмяДопКолонки)
	
	Если Не ЗначениеЗаполнено(СписокДокументовУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ЗАпрос.Текст = 
	"ВЫБРАТЬ
	|	ТабДок.Документ1С КАК Документ1С,
	|	ТабДок.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ТабДок
	|ИЗ
	|	&СписокДокументовУчета КАК ТабДок
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Документ1С
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабДок.Документ1С КАК Документ1С,
	|	ТабДок.НомерСтроки КАК НомерСтроки,
	|	ДопСведения.Значение КАК Значение
	|ИЗ
	|	ТабДок КАК ТабДок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДопСведения
	|		ПО ТабДок.Документ1С = ДопСведения.Объект
	|			И (ДопСведения.Свойство = &НужноеСвойство)";
	Запрос.УстановитьПараметр("СписокДокументовУчета", СписокДокументовУчета);
	Запрос.УстановитьПараметр("НужноеСвойство", НужноеСвойство);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СписокДокументовУчета[Выборка.НомерСтроки - 1][ИмяДопКолонки] = Выборка.Значение;
	КонецЦикла;
	
КонецПроцедуры

// Выбирает из базы документы Реализация товаров и услуг по сопоставленным организациям
// 
// Возвращаемое значение:
//  Массив из ДокументСсылка.РеализацияТоваровУслуг - документы реализации
//
Функция ПримерКакПолучитьДокументы1С()
	
	Результат = Новый Массив;
	
	НачалоПериода = НачалоДня(ТекущаяДатаСеанса());
	КонецПериода = КонецДня(НачалоПериода);
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Организации КАК КонтурМаркировка_Организации
	|		ПО Т.Организация = КонтурМаркировка_Организации.Организация1С
	|ГДЕ
	|	Т.Дата МЕЖДУ &НачалоПериода И &КонецПериода");
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Создает по документу 1С документ учета и начинает по нему работу
// Если документ учета уже был создан - вернет ссылку на него
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ учета
//
Функция ПримерКакСоздатьДокументУчета(Документ1С)
	
	ДокументУчета = НайтиДокументУчетаПоДокументу1С(Документ1С);
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		// по переданному документу 1С уже создан документ учета
		Возврат ДокументУчета;
	КонецЕсли;
	
	НачатьРаботуСДокументом = Истина;
	ДокументУчета = СоздатьДокументУчетаПоДокументу1С(Документ1С, НачатьРаботуСДокументом);
	
	ОшибкиЗаполнения = ПроверитьЗаполнениеДокументаУчета(ДокументУчета);
	Если ЗначениеЗаполнено(ОшибкиЗаполнения) Тогда
		
		МассивОшибок = Новый Массив;
		Для Каждого ОписаниеОшибки Из ОшибкиЗаполнения Цикл
			Если ЗначениеЗаполнено(ОписаниеОшибки.ИмяТаблицы) Тогда
				ШаблонСообщения = ("ru = 'В таб. части ""%1"" в строке %2: %3'");
				ТекстСообщения = ПараметрыВСтроку(ШаблонСообщения, ОписаниеОшибки.ИмяТаблицы, ОписаниеОшибки.НомерСтроки, ОписаниеОшибки.ТекстОшибки);
				МассивОшибок.Добавить(ТекстСообщения);
			Иначе
				МассивОшибок.Добавить(ОписаниеОшибки.ТекстОшибки);
			КонецЕсли;
		КонецЦикла;
		
		ТекстОшибки = СоединитьСтроку(МассивОшибок, Символы.ПС);
		Действие = НСтр("ru = 'Создание документа учета через ПМ'");
		ШаблонСообщения = Нстр("ru = 'Не удалось создать документ учета по документу %1'");
		ТекстСообщения = ПараметрыВСтроку(ШаблонСообщения, Документ1С);
		ОбработатьОшибку(Действие, ТекстОшибки, Документ1С, ТекстСообщения);
		
	КонецЕсли;
	
	Возврат ДокументУчета;
	
КонецФункции

