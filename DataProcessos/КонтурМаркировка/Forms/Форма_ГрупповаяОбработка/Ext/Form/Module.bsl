// #Область Метрики

&НаСервере
Функция ОписаниеДанныхГрупповойОбработкиДляМетрики(Действие)
	
	Результат = Новый Структура;
	
	ДействияМетрики = МодульОбъекта().Перечисление_ДействияМетрики();
	
	Операции = Новый Массив;
	ДокументыУчета = Новый Массив;
	ВидыПродукции = Новый Массив;
	Для каждого Стр Из ТаблицаОпераций Цикл
		Если Действие = ДействияМетрики.ОтправкаВСервис И Не Стр.ОтправленаВСервис Тогда
			Продолжить;
		КонецЕсли;
		Операции.Добавить(Стр.Операция);
		ДокументыУчета.Добавить(Стр.ДокументУчета);
		ВидыПродукции.Добавить(Стр.Операция.ВидПродукции);
	КонецЦикла;
	
	МодульОбъекта().СвернутьМассив_Марк(Операции);
	МодульОбъекта().СвернутьМассив_Марк(ДокументыУчета);
	МодульОбъекта().СвернутьМассив_Марк(ВидыПродукции);
	
	Результат.Вставить("ТипОперации", ТипОперации);
	Результат.Вставить("КоличествоДокументовУчета", ДокументыУчета.Количество());
	Результат.Вставить("КоличествоОпераций", Операции.Количество());
	Результат.Вставить("ВидПродукции", МодульОбъекта().СоединитьСтроку(ВидыПродукции, ";"));
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура Метрика_ГрупповаяОбработка_СозданиеОпераций()
	
	Если Не ЗначениеЗаполнено(ТаблицаОпераций) Тогда
		Возврат;
	КонецЕсли;
	
	Действие = МодульОбъекта().Перечисление_ДействияМетрики().ЗаписьВБазу;
	ОписаниеДляМетрики = ОписаниеДанныхГрупповойОбработкиДляМетрики(Действие);
	
	МодульОбъекта().Метрика_ГрупповаяОбработка(Действие, Организация, ОписаниеДляМетрики);
	
КонецПроцедуры

&НаСервере
Процедура Метрика_ГрупповаяОбработка_ОтправкаВСервис()
	
	ТаблицаОтправленныхОпераций = Таблицаопераций.Выгрузить(Новый Структура("ОтправленаВСервис", Истина));
	Если Не ЗначениеЗаполнено(ТаблицаОтправленныхОпераций) Тогда
		Возврат;
	КонецЕсли;
	
	Действие = МодульОбъекта().Перечисление_ДействияМетрики().ОтправкаВСервис;
	ОписаниеДляМетрики = ОписаниеДанныхГрупповойОбработкиДляМетрики(Действие);
	
	МодульОбъекта().Метрика_ГрупповаяОбработка(Действие, Организация, ОписаниеДляМетрики);
	
КонецПроцедуры

// #КонецОбласти // Метрики

