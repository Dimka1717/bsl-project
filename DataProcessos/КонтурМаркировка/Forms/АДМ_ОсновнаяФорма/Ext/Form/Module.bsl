// #Область ОписаниеПеременных

&НаКлиенте
Перем КэшМодуляКлиента;

&НаСервере
Функция МодульОбъекта()
	
	Возврат ВзаимодействиеКонтурМаркировка.МодульКонтурМаркировка();
	
КонецФункции

&НаКлиенте
Функция МодульКлиента() Экспорт
	
	Если КэшМодуляКлиента <> Неопределено Тогда
		Возврат КэшМодуляКлиента;
	КонецЕсли;
	
	Если ТипЗнч(ВладелецФормы) = ТипЗнч(ЭтаФорма) Тогда
		Результат = ВладелецФормы.МодульКлиента();
	Иначе
		ПутьКФорме = ПутьКФормеМодуляКлиента();
		Результат = ОткрытьФорму(ПутьКФорме);
	КонецЕсли;
	
	КэшМодуляКлиента = Результат;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПутьКФормеМодуляКлиента()
	
	Возврат МодульОбъекта().ПутьКФормеМодуляКлиента();
	
КонецФункции

// #КонецОбласти

// #Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастроитьДоступностьФормы();
	
	УстановитьЗаголовкиГиперссылок();
	ЗаполнитьИнформациюОМодуле();
	
КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПослеВыбораКоманды(Результат, ДопПараметры = Неопределено) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Значение = "ОткрытьРедакторДокументаУчета" Тогда
		ОткрытьРедакторДокументаУчета();
	ИначеЕсли Результат.Значение = "ОткрытьРедакторКодаМаркировки" Тогда
		ОткрытьРедакторКодаМаркировки();
	ИначеЕсли Результат.Значение = "ПроверитьДублиСвязейКодов" Тогда
		ПроверитьДублиСвязейКодов();
	ИначеЕсли Результат.Значение = "ПросмотретьТаблицуКодовОтчетаВСО" Тогда
		ПросмотретьТаблицуКодовОтчетаВСО();
	ИначеЕсли Результат.Значение = "ОткрытьРедакторОперации" Тогда
		ОткрытьРедакторОперации();
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Коды маркировки

&НаКлиенте
Процедура ОткрытьПодменюКодовМаркировки(Команда)
	
	СписокКоманд = СписокКомандКодыМаркировки();
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("ПослеВыбораКоманды", ЭтаФорма);
	МодульКлиента().ПоказатьДиалогВыбораИзМеню(ЭтаФорма, ОписаниеОбработчика
	, СписокКоманд
	, Элементы["Кнопка_ПодменюКодыМаркировки"]);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРедакторКодаМаркировки()
	
	МодульКлиента().ОткрытьФормуРедактораКодаМаркировки();
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьДублиСвязейКодов()
	
	АдресХранилища = ДублиСвязейКодов();
	
	Если ЗначениеЗаполнено(АдресХранилища) Тогда
		
		ТекстВопроса = НСтр("ru='Удалить дубли связей кодов?'");
		
		КнопкиОтвета = Новый СписокЗначений;
		КнопкиОтвета.Добавить("Удалить", "Удалить дубли");
		КнопкиОтвета.Добавить("Открыть", "Открыть таблицу дублей");
		
		ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("ПослеВыбораДействияДублейСвязей"
		, ЭтаФорма
		, Новый Структура("АдресХранилища", АдресХранилища));
		
		МодульКлиента().ПоказатьДиалогВопроса(ОписаниеОбработчика, ТекстВопроса, КнопкиОтвета);
		
	Иначе
		МодульКлиента().СообщитьПользователюЛок(НСтр("ru='Дубли не найдены'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораДействияДублейСвязей(Ответ, ДопПараметры = Неопределено) Экспорт
	
	Если Ответ = "Удалить" Тогда
		УдалитьДублиСвязейКодовНаСервере(ДопПараметры.АдресХранилища);
	ИначеЕсли Ответ = "Открыть" Тогда
		МодульКлиента().ОткрытьФормуПросмотраТаблицы(ЭтаФорма, ДопПараметры.АдресХранилища);
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Документы учета

&НаКлиенте
