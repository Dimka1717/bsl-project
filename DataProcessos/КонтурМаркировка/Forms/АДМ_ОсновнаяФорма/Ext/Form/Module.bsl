	, , БиблиотекаКартинок.КонтурМаркировка_СвязанныеДокументы);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция СписокКомандВСО()
	
	Результат = Новый СписокЗначений;
	
	Результат.Добавить("ПросмотретьТаблицуКодовОтчетаВСО"
	, "Таблица кодов отчета"
	, , БиблиотекаКартинок.Документ);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ОписаниеОбъектаДляВыбора(ТипОбъекта)
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипОбъекта);
	
	Результат = МодульОбъекта().НовоеОписаниеВидаДокументаДляВыбора();
	
	Если ОбъектМетаданных <> Неопределено Тогда
		Результат.Представление = ОбъектМетаданных.Синоним;
		Результат.ПолноеИмяОбъекта = ОбъектМетаданных.ПолноеИмя();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура НастроитьДоступностьФормы()
	
	Элементы.Кнопка_ПодменюВСО.Доступность = МодульОбъекта().ЕстьПодсистемаВСО();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовкиГиперссылок()
	
	СписокВременныхФункций = СписокВременныхФункций();
	ВерсияВременныхФункций = СписокВременныхФункций.ВерсияСписка;
	
	ШаблонЗаголовка = НСтр("ru='Список временных функций (вер.%1)'");
	Элементы.СписокВременныхФункций.Заголовок = МодульОбъекта().ПараметрыВСтроку(ШаблонЗаголовка, ВерсияВременныхФункций);
	
	СписокОтложенныхФункций = СписокОтложенныхФункций();
	ВерсияОтложенныхФункций = СписокОтложенныхФункций.ВерсияСписка;
	
	ШаблонЗаголовка = НСтр("ru='Список отложенных функций (вер.%1)'");
	Элементы.СписокОтложенныхФункций.Заголовок = МодульОбъекта().ПараметрыВСтроку(ШаблонЗаголовка, ВерсияВременныхФункций);
	
КонецПроцедуры

&НаСервере
Функция СписокОтложенныхФункций()
	
	Возврат МодульОбъекта().СписокОтложенныхФункций();
	
КонецФункции

&НаСервере
Функция СписокВременныхФункций()
	
	Возврат МодульОбъекта().СписокВременныхФункций();
	
КонецФункции

&НаСервере
Процедура ЗаполнитьИнформациюОМодуле()
	
	ДанныеДляТехподдержки = МодульОбъекта().ИнформацияДляТехПоддержки();
	
	ИнформацияОМодуле 		= ДанныеДляТехподдержки.ИнформацияОМодуле;
	ИнформацияОНастройках 	= ДанныеДляТехподдержки.ИнформацияОНастройкахМодуля;
	
	ВерсияМодуля 		= ИнформацияОМодуле.ВерсияМодуля;
	ПодключаемыеМодуль 	= ИнформацияОНастройках.ПодключаемыйМодуль;
	ИспользуетсяРИБ 	= Формат(ЗначениеЗаполнено(ПланыОбмена.ГлавныйУзел()), "БЛ='Не используется (либо центральный узел)'; БИ=Используется");
	
	Если ПодключаемыеМодуль = "Подключен" Тогда
		ПодключаемыеМодуль = МодульОбъекта().ПМ_ВерсияОбработки();
	КонецЕсли;
	
	ШаблонИнформацииОМодуле = НСтр("ru='Версия модуля: %1
	|Подключаемые модуль: %2
	|РИБ: %3'");
	
	ТекстИнформацияОМодуле = МодульОбъекта().ПараметрыВСтроку(ШаблонИнформацииОМодуле, ВерсияМодуля, ПодключаемыеМодуль, ИспользуетсяРИБ);
	
КонецПроцедуры

&НаСервере
Функция ДублиСвязейКодов()
	
	Результат = Неопределено;
	ТаблицаДублей = Новый ТаблицаЗначений;
	
	СхемаКомпоновкиДанных = МодульОбъекта().МакетОбработки("МакетСКДОтчетаОДублированииСвязейКодов");
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	
	// Из схемы возьмем настройки по умолчанию
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных
	, КомпоновщикНастроек.ПолучитьНастройки()
	,,
	, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(Макет);
	
	// Выводим результат в табличный документ
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаДублей);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Если ЗначениеЗаполнено(ТаблицаДублей) Тогда
		Результат = ПоместитьВоВременноеХранилище(ТаблицаДублей, ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура УдалитьДублиСвязейКодовНаСервере(АдресХранилища)
	
	ТаблицаДублей = ПолучитьИзВременногоХранилища(АдресХранилища);
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	МодульОбъекта().ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаДублей, "ТаблицаДублей", "КлючКода");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	СвязиКлючейКодов.КлючКода КАК КлючКода,
	|	СвязиКлючейКодов.ПорцияЗаписей КАК ПорцияЗаписей
	|ИЗ
	|	ТаблицаДублей КАК ТаблицаДублей
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО ТаблицаДублей.КлючКода = СвязиКлючейКодов.КлючКода
	|			И ТаблицаДублей.ПорцияЗаписей = СвязиКлючейКодов.ПорцияЗаписей
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорцияЗаписей
	|ИТОГИ ПО
	|	ПорцияЗаписей");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	РезультатЗапроса = Запрос.Выполнить();
	
	МенеджерВТ.Закрыть();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	МодульОбщегоНазначения = МодульОбъекта().МодульОбщегоНазначения();
	НачатьТранзакцию(МодульОбъекта().РежимУправленияБлокировкой());
	
	Попытка
		
		СвязиКлючейКодов_ЗаблокироватьПоТаблице(РезультатЗапроса);
		
		ВыборкаПорция = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПорция.Следующий() Цикл
			
			ПорцияЗаписей = ВыборкаПорция.ПорцияЗаписей;
			Если Не ЗначениеЗаполнено(ПорцияЗаписей) Тогда
				ПорцияЗаписей = МодульОбщегоНазначения.НовыйУникальныйИдентификаторПервойВерсии();
			КонецЕсли;
			
			Набор = РегистрыСведений.КонтурМаркировка_СвязиКлючейКодов.СоздатьНаборЗаписей();
			Набор.Отбор.ПорцияЗаписей.Установить(ПорцияЗаписей);
			Набор.Прочитать();
			
			ТаблицаНабора = Набор.Выгрузить();
			ТаблицаНабора.Индексы.Добавить("КлючКода");
			
			Выборка = ВыборкаПорция.Выбрать();
			Пока Выборка.Следующий() Цикл
				СтрНабора = ТаблицаНабора.Найти(Выборка.КлючКода, "КлючКода");
				Если СтрНабора <> Неопределено Тогда
					ТаблицаНабора.Удалить(СтрНабора);
				КонецЕсли;
			КонецЦикла;
			
			Если ТаблицаНабора.Количество() < Набор.Количество() Тогда
				Набор.Загрузить(ТаблицаНабора);
				Набор.Записать();
			КонецЕсли;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение Ошибка;
		
	КонецПопытки;
	
	УдалитьИзВременногоХранилища(АдресХранилища);
	МодульОбъекта().СообщитьПользователюЛок(НСтр("ru='Дубли связей удалены'"));
	
КонецПроцедуры

&НаСервере
Процедура СвязиКлючейКодов_ЗаблокироватьПоТаблице(Таблица, ИмяКолонки = "ПорцияЗаписей")
	
	Поле = "ПорцияЗаписей";
	ИмяОбъекта = "РегистрСведений.КонтурМаркировка_СвязиКлючейКодов";
	МодульОбъекта().ЗаблокироватьПоТаблице(ИмяОбъекта, Поле, Таблица, ИмяКолонки);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьКодыОтчетаВСОВХранилище(ОтчетСОборудования)
	
	ДанныеДляХранилища = Документы.КонтурМаркировкаВСО_ОтчетСОборудования.ПрочитатьДанныеИзХранилища(ОтчетСОборудования.ДанныеОтчета);
	
	Возврат ПоместитьВоВременноеХранилище(ДанныеДляХранилища, ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

// #КонецОбласти