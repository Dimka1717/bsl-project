КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРедакторОперации()
	
	МодульКлиента().ОткрытьФормуРедактораОперации();
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

// ВСО

&НаКлиенте
Процедура ОткрытьПодменюВСО(Команда)
	
	СписокКоманд = СписокКомандВСО();
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("ПослеВыбораКоманды", ЭтаФорма);
	МодульКлиента().ПоказатьДиалогВыбораИзМеню(ЭтаФорма, ОписаниеОбработчика
	, СписокКоманд
	, Элементы["Кнопка_ПодменюВСО"]);
	
КонецПроцедуры

&НаКлиенте
Процедура ПросмотретьТаблицуКодовОтчетаВСО()
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("ПослеВыбораОтчетаСОборудования", ЭтаФорма);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	
	ОписаниеОбъектаДляВыбора = ОписаниеОбъектаДляВыбора(Тип("ДокументСсылка.КонтурМаркировкаВСО_ОтчетСОборудования"));
	ОписаниеОбъектаДляВыбора.ПараметрыФормы = ПараметрыФормы;
	
	МодульКлиента().ОткрытьФормуВыбораОбъектаИС(ОписаниеОбъектаДляВыбора, ЭтаФорма, ОписаниеОбработчика);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораОтчетаСОборудования(Результат, ДопПараметры = Неопределено) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	АдресТаблицы = ПоместитьКодыОтчетаВСОВХранилище(Результат);
	
	МодульКлиента().ОткрытьФормуПросмотраТаблицы(ЭтаФорма, АдресТаблицы, Истина);
	
КонецПроцедуры

// Прочее

&НаКлиенте
Процедура ВыполнитьРегламентныеДействия(Команда)
	
	ВзаимодействиеКонтурМаркировка.ВыполнитьРегламентныеДействия(Новый Структура());
	
КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СписокОтложенныхФункцийНажатие(Элемент)
	
	СписокОтложенныхФункций = СписокОтложенныхФункций();
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
	"ПослеИзмененияСпискаОтложенныхФункций"
	, ЭтаФорма
	, СписокОтложенныхФункций.ВерсияСписка);
	
	МодульКлиента().ОткрытьФормуПросмотраСтруктуры(ЭтаФорма
	, СписокОтложенныхФункций.ДатыВключения
	, Элемент.Заголовок
	, Истина
	, ОписаниеОбработчика);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеИзмененияСпискаОтложенныхФункций(Результат, ВерсияСписка = Неопределено) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокФункций = МодульКлиента().Новый_СписокОтложенныхФункций();
	СписокФункций.ВерсияСписка = ВерсияСписка;
	СписокФункций.ДатыВключения = Результат;
	
	МодульКлиента().СписокОтложенныхФункций_Записать(СписокФункций);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВременныхФункцийНажатие(Элемент)
	
	СписокВременныхФункций = СписокВременныхФункций();
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
	"ПослеИзмененияСпискаВременныхФункций"
	, ЭтаФорма
	, СписокВременныхФункций.ВерсияСписка);
	
	МодульКлиента().ОткрытьФормуПросмотраСтруктуры(ЭтаФорма
	, СписокВременныхФункций.ДатыОтключения
	, Элемент.Заголовок
	, Истина
	, ОписаниеОбработчика);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеИзмененияСпискаВременныхФункций(Результат, ВерсияСписка = Неопределено) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокФункций = МодульКлиента().Новый_СписокВременныхФункций();
	СписокФункций.ВерсияСписка = ВерсияСписка;
	СписокФункций.ДатыОтключения = Результат;
	
	МодульКлиента().СписокВременныхФункций_Записать(СписокФункций);
	
КонецПроцедуры

// #КонецОбласти

// #Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция СписокКомандКодыМаркировки()
	
	Результат = Новый СписокЗначений;
	
	Результат.Добавить("ОткрытьРедакторКодаМаркировки"
	, "Редактор кода маркировки"
	, , БиблиотекаКартинок.КонтурМаркировка_Датаматрикс);
	
	Результат.Добавить("ПроверитьДублиСвязейКодов"
	, "Проверить дубли связей кодов"
	, , БиблиотекаКартинок.КонтурМаркировка_КолокольчикКрасный);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция СписокКомандДокументыУчета()
	
	Результат = Новый СписокЗначений;
	
	Результат.Добавить("ОткрытьРедакторДокументаУчета"
	, "Редактор документа учета"
	, , БиблиотекаКартинок.КонтурМаркировка_СвязанныеДокументы);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция СписокКомандОперации()
	
