&НаСервере
Процедура СписокДокументовУчета_ДобавитьКолонку_УчетныйДокумент()
	
	ТипПоля = Новый ОписаниеТипов(Документы.ТипВсеСсылки());
	НовыйРеквизит = Новый РеквизитФормы("Документ1С", ТипПоля, "СписокДокументовУчета", "Документ 1С");
	ИзменитьРеквизиты(МодульОбъекта().НовыйМассив(НовыйРеквизит));
	
	НовыйЭлемент = Элементы.Добавить("СписокДокументовУчетаДокумент1С"
	, Тип("ПолеФормы"), Элементы.СписокДокументовУчета);
	
	НовыйЭлемент.ПутьКДанным = "СписокДокументовУчета.Документ1С";
	
КонецПроцедуры

&НаСервере
Процедура СписокДокументовУчета_СформироватьДополнительныеКолонки()
	
	НастройкиДопКолонок = МодульОбъекта().НастройкиДополнительныхКолонокСпискаДокументов();
	
	СписокДокументовУчета_УдалитьДопКолонку("ДопКолонка1");
	СписокДокументовУчета_УдалитьДопКолонку("ДопКолонка2");
	СписокДокументовУчета_УдалитьДопКолонку("ДопКолонка3");
	
	СписокДокументовУчета_ДобавитьКолонку("ДопКолонка1", НастройкиДопКолонок.ДопКолонка1);
	СписокДокументовУчета_ДобавитьКолонку("ДопКолонка2", НастройкиДопКолонок.ДопКолонка2);
	СписокДокументовУчета_ДобавитьКолонку("ДопКолонка3", НастройкиДопКолонок.ДопКолонка3);
	
	ТребуетсяВызватьПМ_ПриЗаполненияСпискаДокументов = НастройкиДопКолонок.ТребуетсяОбработкаПриЗаполненияСписка;
	
КонецПроцедуры

&НаСервере
Процедура СписокДокументовУчета_ДобавитьКолонку(ИмяКолонки, НастройкиКолонки)
	
	ИмяЭлемента = "СписокДокументовУчета" + ИмяКолонки;
	ПутьКДанным = "СписокДокументовУчета." + ИмяКолонки;
	
	НовыйРеквизит = Новый РеквизитФормы(ИмяКолонки, Новый ОписаниеТипов(НастройкиКолонки.ТипКолонки), "СписокДокументовУчета", НастройкиКолонки.Заголовок);
	ИзменитьРеквизиты(МодульОбъекта().НовыйМассив(НовыйРеквизит));
	
	НовыйЭлемент = Элементы.Вставить(ИмяЭлемента, Тип("ПолеФормы"), Элементы.СписокДокументовУчета, Элементы["СписокДокументовУчетаКомментарий"]);
	
	НовыйЭлемент.ПутьКДанным = ПутьКДанным;
	НовыйЭлемент.Видимость = НастройкиКолонки.Видимость;
	
КонецПроцедуры

&НаСервере
Процедура СписокДокументовУчета_УдалитьДопКолонку(ИмяКолонки)
	
	ИмяЭлемента = "СписокДокументовУчета" + ИмяКолонки;
	ПутьКДанным = "СписокДокументовУчета." + ИмяКолонки;
	
	СуществующаяКолонка = Элементы.Найти(ИмяЭлемента);
	Если СуществующаяКолонка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.Удалить(СуществующаяКолонка);
	
	МассивУдаляемыхРеквизитов = Новый Массив;
	МассивУдаляемыхРеквизитов.Добавить(ПутьКДанным);
	ИзменитьРеквизиты(, МассивУдаляемыхРеквизитов);
	
КонецПроцедуры

