	УстановитьПараметрыПериодаДинамическогоСписка(СписокВходящихУПД, ПериодВходящихУПД);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьСписокАгрегатов()
	
	СписокОперацийАгрегатов.ТекстЗапроса = ТекстЗапроса_СписокАгрегатов();
	СписокОперацийАгрегатов.ОсновнаяТаблица = "Справочник.КонтурМаркировка_Операции";
	СписокОперацийАгрегатов.ДинамическоеСчитываниеДанных = Истина;
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	ПодходящиеТипы = Новый Массив;
	ПодходящиеТипы.Добавить(ТипыОпераций.НаполнениеАгрегатовНаТСД);
	ПодходящиеТипы.Добавить(ТипыОпераций.РегистрацияАгрегатов);
	ПодходящиеТипы.Добавить(ТипыОпераций.ДобавлениеВАгрегат);
	ПодходящиеТипы.Добавить(ТипыОпераций.ИзъятиеИзАгрегата);
	
	СписокОперацийАгрегатов.Параметры.УстановитьЗначениеПараметра("ПодходящиеТипы", ПодходящиеТипы);
	
	УстановитьПараметрыПериодаДинамическогоСписка(СписокОперацийАгрегатов, ПериодОперацийАгрегатов);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьСписокОпераций()
	
	УстановитьОтборСпискаОпераций();
	
	СписокОпераций.ТекстЗапроса = ТекстЗапроса_СписокОпераций();
	СписокОпераций.ОсновнаяТаблица = "Справочник.КонтурМаркировка_Операции";
	СписокОпераций.ДинамическоеСчитываниеДанных = Истина;
	
	ТипыИнтерактивныхОпераций = МодульОбъекта().ТипыИнтерактивныхОпераций();
	СтатусыОпераций = МодульОбъекта().Перечисление_СтатусыОпераций();
	
	СписокОпераций.Параметры.УстановитьЗначениеПараметра("ПодходящиеТипы", ТипыИнтерактивныхОпераций);
	СписокОпераций.Параметры.УстановитьЗначениеПараметра("Новый", СтатусыОпераций.Новый);
	СписокОпераций.Параметры.УстановитьЗначениеПараметра("ОперацияЗавершена", СтатусыОпераций.ОперацияЗавершена);
	СписокОпераций.Параметры.УстановитьЗначениеПараметра("ОперацияОтменена", СтатусыОпераций.ОперацияОтменена);
	СписокОпераций.Параметры.УстановитьЗначениеПараметра("ОшибкаОбработки", СтатусыОпераций.ОшибкаОбработки);
	СписокОпераций.Параметры.УстановитьЗначениеПараметра("ОшибкаЗаполнения", СтатусыОпераций.ОшибкаЗаполнения);
	СписокОпераций.Параметры.УстановитьЗначениеПараметра("ОшибкаОтменыОперации", СтатусыОпераций.ОшибкаОтменыОперации);
	
	УстановитьПараметрыПериодаДинамическогоСписка(СписокОпераций, ПериодСпискаОпераций);
	
