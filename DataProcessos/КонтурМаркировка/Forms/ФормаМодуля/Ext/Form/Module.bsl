// Отчет по виртуальному складу

&НаСервере
Функция КонтекстОтчетаПоВиртуальномуСкладу()
	
	Результат = МодульОбъекта().Новый_ОтчетПоВиртуальномуСкладу_Контекст();
	
	Результат.ФормаИнициатор = "ФормаМодуля";
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОтчетПоВиртуальномуСкладу(Команда)
	Контекст = КонтекстОтчетаПоВиртуальномуСкладу();
	МодульКлиента().ОткрытьФормуОтчетаПоВиртуальномуСкладу(ЭтаФорма, Контекст);
КонецПроцедуры

// #Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПроверитьКорректностьУстановки()
	
	Если Метаданные.ОбщиеМодули.Найти("ВзаимодействиеКонтурМаркировка") = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Для работы модуля необходимо скачать и установить подсистему ""Контур.Маркировка""'");
	КонецЕсли;
	
	Если ТипЗнч(СписокОпераций_ОтборТовар) = Тип("Строка") Тогда
		ВызватьИсключение НСтр("ru = 'Нарушены типы реквизитов модуля!
		|Необходимо повторно скачать и установить модуль ""Контур.Маркировка""'");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВыполнениеОбменаССервисом()
	
	Если МодульКлиента().ОбменССервисомВыполняется() Тогда
		НастроитьКнопкиОбменаССервисом(Истина);
		ПодключитьОбработчикОжидания("ОбновитьСтатусОбменаССервисом", 5, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусОбменаССервисом() Экспорт
	
	ОбменССервисомВыполняется = МодульКлиента().ОбменССервисомВыполняется();
	
	НастроитьКнопкиОбменаССервисом(ОбменССервисомВыполняется);
	
	Если ОбменССервисомВыполняется Тогда
		ПодключитьОбработчикОжидания("ОбновитьСтатусОбменаССервисом", 5, Истина);
	Иначе
		ОбновитьКонтекстПослеВыполненияОбмена();
		ОбновитьТекстУведомления();
		ОбновитьСписокОпераций();
		ОбновитьСписокВходящихУПД();
		ОбновитьСписокОперацийАгрегатов();
		ОбновитьСписокУведомленийОПриемке();
		НастроитьКартинкиКомандФормы();
		МодульКлиента().ОбработатьОшибкиОбменаССервисом(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти // СлужебныеПроцедурыИФункции
