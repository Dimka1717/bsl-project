&НаКлиенте
Процедура ОткрытьСвязанныеДокументы(Команда)
	
	ЭтоСписокДокументов = Ложь;
	
	Если Элементы.Закладки.ТекущаяСтраница = Элементы.ЗакладкаДокументыУчета Тогда
		ТекущиеДанные = Элементы.СписокДокументовУчета.ТекущиеДанные;
		ЭтоСписокДокументов = Истина;
	ИначеЕсли Элементы.Закладки.ТекущаяСтраница = Элементы.ЗакладкаОперации Тогда
		ТекущиеДанные = Элементы.СписокОпераций.ТекущиеДанные;
	ИначеЕсли Элементы.Закладки.ТекущаяСтраница = Элементы.ЗакладкаТранспортныеУпаковки Тогда
		ТекущиеДанные = Элементы.СписокОперацийАгрегатов.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	Если ЭтоСписокДокументов Тогда
		ПараметрыФормы.Вставить("ДокументУчета", ТекущиеДанные.ДокументУчета);
	Иначе
		ПараметрыФормы.Вставить("Операция", ТекущиеДанные.Ссылка);
	КонецЕсли;
	
	МодульКлиента().ОткрытьФормуОбработки("Форма_СвязанныеДокументы", ЭтаФорма, ПараметрыФормы);
	
КонецПроцедуры

