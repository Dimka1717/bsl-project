	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если Поле = Элементы.СписокОперацийИдентификаторВСервисе Тогда
		МодульКлиента().ОткрытьОперациюВСервисе(ТекущиеДанные.ТипОперации, ТекущиеДанные.ИдентификаторВСервисе);
	Иначе
		МодульКлиента().ОткрытьФормуОперации(ТекущиеДанные.Ссылка, ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокОперацийПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено 
		ИЛИ ТекущиеДанные.Свойство("ГруппировкаСтроки") Тогда
		МожноУдалитьОперацию = Ложь;
	Иначе
		МожноУдалитьОперацию = МожноУдалитьОперацию(ТекущиеДанные.Статус);
	КонецЕсли;
	
	Элементы.Кнопка_УдалитьОперациюВСпискеОпераций.Доступность = МожноУдалитьОперацию;
	Элементы.КонтекстноеМеню_УдалитьОперацию.Доступность = МожноУдалитьОперацию;
	
КонецПроцедуры

