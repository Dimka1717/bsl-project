&НаКлиенте
Процедура ОбновитьТекстУведомления()
	
	Элемент = Элементы.СсылкаУведомления;
	
	ТипУведомления = ПоследнееУведомление();
	Если Не ЗначениеЗаполнено(ТипУведомления) Тогда
		Элемент.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	ОформлениеУведомлений = МодульКлиента().ОформлениеУведомлений();
	Оформление = ОформлениеУведомлений[ТипУведомления];
	ЗаполнитьЗначенияСвойств(Элемент, Оформление);
	
КонецПроцедуры

&НаКлиенте
Функция ПоследнееУведомление()
	
	Если Не ЗначениеЗаполнено(ОчередьУведомлений) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Индекс = ОчередьУведомлений.Количество() - 1;
	Элемент = ОчередьУведомлений.Получить(Индекс);
	Результат = Элемент.Значение;
	
	Возврат Результат;
	
КонецФункции

