&НаСервере
Процедура НастроитьКартинкиКомандФормы()
	
	ОрганизацияДляПроверки = МодульОбъекта().Организация_ЕдинственнаяОрганизацияДляОбмена();
	ОписаниеТарифа = МодульОбъекта().Тариф(ОрганизацияДляПроверки);
	
	Для Каждого Элемент Из СоответствиеКомандИТиповОперацийДляПодписок() Цикл
		
		Команда = Элемент.Ключ;
		ТипОперации = Элемент.Значение;
		
		Если ТипОперации = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если МодульОбъекта().СозданиеОперацииОграниченоТарифом(ТипОперации, ОписаниеТарифа) Тогда
			Команда.Картинка = Элементы.КартинкаЗамок.Картинка;
		Иначе
			Команда.Картинка = Элементы.КартинкаПустая.Картинка;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СоответствиеКомандИТиповОперацийДляПодписок()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	
	Результат = Новый Соответствие;
	
	Результат.Вставить(Команды.НоваяОперация_ЗаказКодов,               ТипыОпераций.ЗаказКодов);
	Результат.Вставить(Команды.НоваяОперация_НаполнениеАгрегатовНаТСД, ТипыОпераций.НаполнениеАгрегатовНаТСД);
	Результат.Вставить(Команды.НоваяОперация_ВозвратВОборотНаТСД,      ТипыОпераций.ВозвратВОборотНаТСД);
	Результат.Вставить(Команды.ДобавитьВАгрегат,                       ТипыОпераций.ДобавлениеВАгрегат);
	Результат.Вставить(Команды.ИзъятьИзАгрегата,                       ТипыОпераций.ИзъятиеИзАгрегата);
	Результат.Вставить(Команды.ДобавитьВАТК,                           ТипыОпераций.ДобавлениеВАТК);
	Результат.Вставить(Команды.ИзъятьИзАТК,                            ТипыОпераций.ИзъятиеИзАТК);
	
	Результат = Новый ФиксированноеСоответствие(Результат);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьСписокДокументовУчета(ИзмененыНастройки = Ложь)
	
	ОбновитьСписокДокументовУчетаНаСервере(ИзмененыНастройки);
	
	УстановитьДатуПоследнегоОбмена();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокДокументовУчетаНаСервере(ИзмененыНастройки = Ложь)
	
	Если ЗначениеЗаполнено(КлючНазначенияИспользования)
		И Не Найти(КлючНазначенияИспользования, "Документы") Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийДокумент = Неопределено;
	ТекущийДокумент1С = Неопределено;
	ТекущаяСтрока = Элементы.СписокДокументовУчета.ТекущаяСтрока;
	Если ЗначениеЗаполнено(ТекущаяСтрока) Тогда
		ТекущийДокумент = СписокДокументовУчета.НайтиПоИдентификатору(ТекущаяСтрока).ДокументУчета;
		ТекущийДокумент1С = СписокДокументовУчета.НайтиПоИдентификатору(ТекущаяСтрока).Документ1С;
	КонецЕсли;
	
	ЗаполнитьТаблицуДокументов();
	
	ТаблицаДокументов = СписокДокументовУчета.Выгрузить();
	
	Если ТребуетсяВызватьПМ_ПриЗаполненияСпискаДокументов Тогда
		МодульОбъекта().ПМ_ОбработатьСобытие_ПриЗаполненииСпискаДокументов(ТаблицаДокументов);
	КонецЕсли;
	
	ТаблицаДокументов_УстановитьСхемуСКД(ТаблицаДокументов, ИзмененыНастройки);
	
	ВосстановитьНастройкуОтбораСКД();
	СформироватьОписаниеОтборов();
	
	ТаблицаДокументов_ПрименитьОтборы(ТаблицаДокументов);
	
	СписокДокументовУчета.Загрузить(ТаблицаДокументов);
	
	ВосстановитьПозициюНаСтрокеСпискаДокументовУчета(ТекущийДокумент, ТекущийДокумент1С);
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьПозициюНаСтрокеСпискаДокументовУчета(ТекущийДокумент, ТекущийДокумент1С)
	
	Если ЗначениеЗаполнено(ТекущийДокумент1С) Тогда
		
		СтрДок = СписокДокументовУчета.НайтиСтроки(Новый Структура("Документ1С", ТекущийДокумент1С));
		Если ЗначениеЗаполнено(СтрДок) Тогда
			Элементы.СписокДокументовУчета.ТекущаяСтрока = СтрДок[0].ПолучитьИдентификатор();
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущийДокумент) Тогда
		
		СтрДок = СписокДокументовУчета.НайтиСтроки(Новый Структура("ДокументУчета", ТекущийДокумент));
		Если ЗначениеЗаполнено(СтрДок) Тогда
			Элементы.СписокДокументовУчета.ТекущаяСтрока = СтрДок[0].ПолучитьИдентификатор();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокВходящихУПД()
	
	УстановитьПараметрыПериодаДинамическогоСписка(СписокВходящихУПД, ПериодВходящихУПД);
	
	Элементы.СписокВходящихУПД.Обновить();
	
