&НаСервере
Процедура Документы_СортироватьНаСервере(Направление)
	
	Если Не ЗначениеЗаполнено(СписокДокументовУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Элемент = Элементы.СписокДокументовУчета.ТекущийЭлемент;
	Если Элемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Элемент.ПутьКДанным) Тогда
		ИмяКолонки = СтрЗаменить(Элемент.ПутьКДанным, "СписокДокументовУчета.", "");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИмяКолонки) Тогда
		ИмяКолонки = СтрЗаменить(Элемент.Имя, "СписокДокументовУчета", "");
	КонецЕсли;
	
	СписокДокументовУчета.Сортировать(ИмяКолонки + " " + Направление, Новый СравнениеЗначений);
	
КонецПроцедуры

