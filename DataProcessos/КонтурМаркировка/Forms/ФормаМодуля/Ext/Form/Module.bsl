&НаКлиенте
Процедура СписокОпераций_Удалить_ПослеСогласия(Ответ, ДопПараметры = Неопределено) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.СписокОпераций.ТекущиеДанные;
	
	Если МожноУдалитьОперацию(ТекущиеДанные.Статус) Тогда
		УдалитьОперациюНаСервере(ТекущиеДанные.Ссылка);
		Оповестить("КонтурМаркировка_Операция_Изменен", ТекущиеДанные.ДокументУчета);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьОперациюНаСервере(Операция)
	
	ДокументУчета = Операция.ДокументУчета;
	ТипОперации = Операция.ТипОперации;
	
	НачатьТранзакцию(МодульОбъекта().РежимУправленияБлокировкой());
	
	Попытка
		
		ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
		ТребуемыеДействия = МодульОбъекта().Перечисление_ТребуемыеДействияДокументовУчета();
		СтатусыДокументовУчета = МодульОбъекта().Перечисление_СтатусыДокументовУчета();
		
		МодульОбъекта().Операции_Удалить(Операция);
		
		Если ТипОперации = ТипыОпераций.ПодборТоваровИКодовНаТСД Тогда
			СтатусыДокумента = МодульОбъекта().ДокументУчета_Статусы(ДокументУчета);
			СтатусыДокумента.ОсновнойСтатус = СтатусыДокументовУчета.Новый;
			СтатусыДокумента.ТребуемоеДействие = ТребуемыеДействия.НачатьРаботу;
			МодульОбъекта().СтатусыДокументаУчета_Записать(ДокументУчета, СтатусыДокумента);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция МожноУдалитьОперацию(Статус)
	
	УдаляемыеСтатусы = МодульКлиента().УдаляемыеСтатусыОпераций();
	
