Процедура СписокДокументовУчета_ДобавитьКолонку_Контрагент()
	
	ТипКонтрагента = МодульОбъекта().ТипыОбъектовИС().Контрагент;
	
	Если Не ЗначениеЗаполнено(ТипКонтрагента) Тогда
		Возврат;
	КонецЕсли;
	
	ТипПоля = Новый ОписаниеТипов(ТипКонтрагента);
	НовыйРеквизит = Новый РеквизитФормы("Контрагент", ТипПоля, "СписокДокументовУчета", "Контрагент");
	ИзменитьРеквизиты(МодульОбъекта().НовыйМассив(НовыйРеквизит));
	
	НовыйЭлемент = Элементы.Вставить("СписокДокументовУчетаКонтрагент", Тип("ПолеФормы")
	, Элементы.СписокДокументовУчета, Элементы.СписокДокументовУчетаСумма);
	
	НовыйЭлемент.ПутьКДанным = "СписокДокументовУчета.Контрагент";
	
КонецПроцедуры

