// Список уведомлений о приемке

&НаКлиенте
Процедура СписокУведомленийОПриемке_Период(Команда)
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
	"ПослеВыбораПериодаСпискаУведомленийОПриемке", ЭтаФорма);
	МодульКлиента().ПоказатьДиалогРедактированияСтандартногоПериода(ОписаниеОбработчика, ПериодУведомленийОПриемке);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПериодаСпискаУведомленийОПриемке(Результат, ДопПараметры = Неопределено) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПериодУведомленийОПриемке = Результат;
	
	ЗаполнитьПустыеЗначенияПериода(ПериодУведомленийОПриемке);
	
	УстановитьЗаголовокПериодаСписка(Элементы.Кнопка_ПериодСпискаУведомленийОПриемке, ПериодУведомленийОПриемке);
	
	ОбновитьСписокУведомленийОПриемке();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокУведомленийОПриемке()
	
	УстановитьПараметрыПериодаДинамическогоСписка(СписокУведомленийОПриемке, ПериодУведомленийОПриемке);
	
	Элементы.СписокУведомленийОПриемке.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьСписокУведомленийОПриемке()
	
	УстановитьОтборСпискаУведомленийОПриемке();
	
	СписокУведомленийОПриемке.ТекстЗапроса = ТекстЗапроса_СписокУведомленийОПриемке();
	СписокУведомленийОПриемке.ОсновнаяТаблица = "Справочник.КонтурМаркировка_Операции";
	СписокУведомленийОПриемке.ДинамическоеСчитываниеДанных = Истина;
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	СтатусыОпераций = МодульОбъекта().Перечисление_СтатусыОпераций();
	ПоказыватьЗавершенные = Элементы.Кнопка_ПоказатьЗавершенныеВСпискеУведомленийОПриемке.Пометка;
	
	СписокУведомленийОПриемке.Параметры.УстановитьЗначениеПараметра("УведомлениеОПриемке", ТипыОпераций.УведомлениеОПриемке);
	СписокУведомленийОПриемке.Параметры.УстановитьЗначениеПараметра("ОтправленВАрхив", СтатусыОпераций.ОтправленВАрхив);
	СписокУведомленийОПриемке.Параметры.УстановитьЗначениеПараметра("ПоказыватьЗавершенные", ПоказыватьЗавершенные);
	
	УстановитьПараметрыПериодаДинамическогоСписка(СписокУведомленийОПриемке, ПериодУведомленийОПриемке);
	
КонецПроцедуры

&НаСервере
Функция ТекстЗапроса_СписокУведомленийОПриемке()
	
	Результат =
	"ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка,
	|	Спр.ТипОперации КАК ТипОперации,
	|	Спр.Организация КАК Организация,
	|	Спр.Склад КАК Склад,
	|	Спр.ВидПродукции КАК ВидПродукции,
	|	Спр.ДокументУчета КАК ДокументУчета,
	|	Спр.ОперацияОснование КАК ОперацияОснование,
	|	Спр.Ответственный КАК Ответственный,
	|	Спр.Комментарий КАК Комментарий,
	|	ВЫРАЗИТЬ(ЕСТЬNULL(НомераДокументов.Значение, """") КАК СТРОКА(1000)) КАК НомерЗаказаНаОтгрузку,
	|	ВЫРАЗИТЬ(ДатыДокументов.Значение КАК ДАТА) КАК ДатаОтгрузки,
	|	ВЫРАЗИТЬ(ЕСТЬNULL(НаименованиеКонтрагентов.Значение, """") КАК СТРОКА(1000)) КАК НаименованиеКонтрагента,
	|	ВЫРАЗИТЬ(ЕСТЬNULL(ИННКонтрагентов.Значение, """") КАК СТРОКА(1000)) КАК ИНН_Контрагента,
	|	ВЫРАЗИТЬ(ЕСТЬNULL(НомераДокументовОснования.Значение, """") КАК СТРОКА(1000)) КАК ДокументОснованиеНомер,
	|	ВЫРАЗИТЬ(ДатыДокументовОснования.Значение КАК ДАТА) КАК ДокументОснованиеДата,
	|	Статусы.Статус КАК Статус,
	|	Статусы.ДатаСтатуса КАК ДатаИзмененияСтатуса,
	|	ВЫРАЗИТЬ(ЕСТЬNULL(СтатусыСверкиНаТСД.Значение, """") КАК СТРОКА(1000)) КАК СтатусСверкиНаТСД,
	|	ВЫРАЗИТЬ(ДатыПриемок.Значение КАК ДАТА) КАК ДатаПриемки,
	|	ВЫРАЗИТЬ(ЕСТЬNULL(СтатусыПриемки.Значение, """") КАК СТРОКА(1000)) КАК СтатусПриемки,
	|	5 КАК НомерКартинки
	|{ВЫБРАТЬ
	|	Ссылка.*,
	|	ТипОперации,
	|	Организация.*,
	|	Склад.*,
	|	ВидПродукции.*,
	|	ДокументУчета.*,
	|	ОперацияОснование.*,
	|	Ответственный.*,
	|	Комментарий,
	|	НомерЗаказаНаОтгрузку,
	|	ДатаОтгрузки,
	|	НаименованиеКонтрагента,
	|	ИНН_Контрагента,
	|	ДокументОснованиеНомер,
	|	ДокументОснованиеДата,
	|	Статус,
	|	ДатаИзмененияСтатуса,
	|	СтатусСверкиНаТСД,
	|	ДатаПриемки,
	|	СтатусПриемки,
	|	НомерКартинки}
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Спр
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК Статусы
	|		ПО Спр.Ссылка = Статусы.Операция
	|			И (Статусы.ТипСтатуса = ""ОсновнойСтатус"")}
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК НомераДокументов
	|		ПО Спр.Ссылка = НомераДокументов.Объект
	|			И (НомераДокументов.ИмяРеквизита = ""НомерДокумента"")}
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ДатыДокументов
	|		ПО Спр.Ссылка = ДатыДокументов.Объект
	|			И (ДатыДокументов.ИмяРеквизита = ""ДатаДокумента"")}
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК НаименованиеКонтрагентов
	|		ПО Спр.Ссылка = НаименованиеКонтрагентов.Объект
	|			И (НаименованиеКонтрагентов.ИмяРеквизита = ""КонтрагентНаименование"")}
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ИННКонтрагентов
	|		ПО Спр.Ссылка = ИННКонтрагентов.Объект
	|			И (ИННКонтрагентов.ИмяРеквизита = ""КонтрагентИНН"")}
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК НомераДокументовОснования
	|		ПО Спр.Ссылка = НомераДокументовОснования.Объект
	|			И (НомераДокументовОснования.ИмяРеквизита = ""ДокументОснованиеНомер"")}
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ДатыДокументовОснования
	|		ПО Спр.Ссылка = ДатыДокументовОснования.Объект
	|			И (ДатыДокументовОснования.ИмяРеквизита = ""ДокументОснованиеДата"")}
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК СтатусыСверкиНаТСД
	|		ПО Спр.Ссылка = СтатусыСверкиНаТСД.Объект
	|			И (СтатусыСверкиНаТСД.ИмяРеквизита = ""СтатусСверкиНаТСД"")}
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ДатыПриемок
	|		ПО Спр.Ссылка = ДатыПриемок.Объект
	|			И (ДатыПриемок.ИмяРеквизита = ""ДатаПриемки"")}
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК СтатусыПриемки
	|		ПО Спр.Ссылка = СтатусыПриемки.Объект
	|			И (СтатусыПриемки.ИмяРеквизита = ""СтатусПриемки"")}
	|ГДЕ
	|	Спр.ТипОперации = &УведомлениеОПриемке
	|	И ВЫРАЗИТЬ(ДатыДокументов.Значение КАК ДАТА) МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ВЫБОР
	|			КОГДА &ПоказыватьЗавершенные
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ НЕ Статусы.Статус = &ОтправленВАрхив
	|		КОНЕЦ
	|{ГДЕ
	|	Спр.Ссылка.*,
	|	Спр.ТипОперации,
	|	Спр.Организация.*,
	|	Спр.Склад.*,
	|	Спр.ВидПродукции.*,
	|	Спр.ДокументУчета.*,
	|	Спр.ОперацияОснование.*,
	|	Спр.Ответственный.*,
	|	Спр.Комментарий,
	|	(ВЫРАЗИТЬ(ЕСТЬNULL(НомераДокументов.Значение, """") КАК СТРОКА(1000))) КАК НомерЗаказаНаОтгрузку,
	|	(ВЫРАЗИТЬ(ДатыДокументов.Значение КАК ДАТА)) КАК ДатаОтгрузки,
	|	(ВЫРАЗИТЬ(ЕСТЬNULL(НаименованиеКонтрагентов.Значение, """") КАК СТРОКА(1000))) КАК НаименованиеКонтрагента,
	|	(ВЫРАЗИТЬ(ЕСТЬNULL(ИННКонтрагентов.Значение, """") КАК СТРОКА(1000))) КАК ИНН_Контрагента,
	|	(ВЫРАЗИТЬ(ЕСТЬNULL(НомераДокументовОснования.Значение, """") КАК СТРОКА(1000))) КАК ДокументОснованиеНомер,
	|	(ВЫРАЗИТЬ(ДатыДокументовОснования.Значение КАК ДАТА)) КАК ДокументОснованиеДата,
	|	Статусы.Статус КАК Статус,
	|	Статусы.ДатаСтатуса КАК ДатаИзмененияСтатуса,
	|	(ВЫРАЗИТЬ(ЕСТЬNULL(СтатусыСверкиНаТСД.Значение, """") КАК СТРОКА(1000))) КАК СтатусСверкиНаТСД,
	|	(ВЫРАЗИТЬ(ДатыПриемок.Значение КАК ДАТА)) КАК ДатаПриемки,
	|	(ВЫРАЗИТЬ(ЕСТЬNULL(СтатусыПриемки.Значение, """") КАК СТРОКА(1000))) КАК СтатусПриемки}";
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СписокУведомленийОПриемке_ПоказатьЗавершенные(Команда)
	
	Элемент = Элементы.Кнопка_ПоказатьЗавершенныеВСпискеУведомленийОПриемке;
	Элемент.Пометка = Не Элемент.Пометка;
	
	ПоказыватьЗавершенные = Элемент.Пометка;
	СписокУведомленийОПриемке.Параметры.УстановитьЗначениеПараметра("ПоказыватьЗавершенные", ПоказыватьЗавершенные);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокУведомленийОПриемкеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.СписокУведомленийОПриемке.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не МодульКлиента().ВыполнитьАвторизацию(ТекущиеДанные.Организация, ЭтаФорма) Тогда
		Возврат;
	КонецЕсли;
	
	МодульКлиента().ОткрытьФормуОперации(ТекущиеДанные.Ссылка, ЭтаФорма);
	
КонецПроцедуры

