&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурМаркировка_ДокументУчета_Изменен"
		Или ИмяСобытия = "КонтурМаркировка_ДокументУчета_Удален" 
		Или ИмяСобытия = "КонтурМаркировка_ДокументУчета_Перезаполнен" Тогда
		
		ОбновитьСписокДокументовУчета();
		
	КонецЕсли;
		
	Если ИмяСобытия = "КонтурМаркировка_Операция_Изменен" Тогда
		
		Элементы.СписокОперацийАгрегатов.Обновить();
		ОбновитьСписокОпераций();
		ОбновитьСписокУведомленийОПриемке();
		
	КонецЕсли;
		
	Если ИмяСобытия = "КонтурМаркировка_НастройкиМодуля_Загружены" Тогда
		
		ОбновитьКэш = Истина;
		МодульКлиента().НастройкиМодуля(ОбновитьКэш);
		
	КонецЕсли;
	
	Если ИмяСобытия = "КонтурМаркировка_НастройкиМодуля_Обновлены" И Источник <> ЭтаФорма Тогда
		
		УстановитьЗаголовок();
		СписокДокументовУчета_СформироватьДополнительныеКолонки();
		СформироватьДополнительныеКнопки();
		
		ОбновленыНастройки = Истина;
		ОбновитьСписокДокументовУчета(ОбновленыНастройки);
		
	КонецЕсли;
	
	Если ИмяСобытия = "КонтурМаркировка_ИстекаетСрокДействияСертификата" Тогда
		
		ДобавитьУведомление(МодульКлиента().Перечисление_ТипыУведомлений().ИстекаетСрокДействияСертификата);
		
	КонецЕсли;
	
	Если ИмяСобытия = "КонтурМаркировка_ИзмененРежимТехническогоСпециалиста" Тогда
		НастроитьВидимостьПодменюТехническогоСпециалиста(Параметр);
	КонецЕсли;
	
	Если ИмяСобытия = "КонтурМаркировка_ПринудительноЗакрытьМодуль" Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

