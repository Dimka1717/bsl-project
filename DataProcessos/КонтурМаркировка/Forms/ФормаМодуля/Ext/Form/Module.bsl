&НаКлиенте
Процедура СписокДокументовУчетаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.СписокДокументовУчета.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не МодульКлиента().ПроверитьУстановленнуюВерсиюМодуля() Тогда
		Возврат;
	КонецЕсли;
	
	Действие = МодульКлиента().Перечисление_ДействияМетрики().Замер_ОткрытиеФормыДокументаУчета;
	МодульКлиента().НачатьЗамерПроизводительности(Действие);
	
	ДокументУчета = ТекущиеДанные.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		ДокументУчета = МодульКлиента().ДокументУчета_НайтиИлиСоздать(ТекущиеДанные.Документ1С, ЭтаФорма);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		МодульКлиента().ОткрытьФормуДокументаУчета(ДокументУчета, ЭтаФорма);
	КонецЕсли;
	
