
&НаКлиенте
Перем КэшМодуляКлиента;

&НаСервере
Функция МодульОбъекта()
	
	Возврат Вычислить("ВзаимодействиеКонтурМаркировка.МодульКонтурМаркировка()");
	
КонецФункции

&НаКлиенте
Функция МодульКлиента() Экспорт
	
	Если КэшМодуляКлиента <> Неопределено Тогда
		Возврат КэшМодуляКлиента;
	КонецЕсли;
	
	Если ТипЗнч(ВладелецФормы) = ТипЗнч(ЭтаФорма) Тогда
		Результат = ВладелецФормы.МодульКлиента();
	Иначе
		ПутьКФорме = ПутьКФормеМодуляКлиента();
		Результат = ОткрытьФорму(ПутьКФорме);
	КонецЕсли;
	
	КэшМодуляКлиента = Результат;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПутьКФормеМодуляКлиента()
	
	Возврат МодульОбъекта().ПутьКФормеМодуляКлиента();
	
КонецФункции

&НаСервере
Функция МодульКорректноУстановлен()
	
	Возврат ТипЗнч(СписокОпераций_ОтборТовар) <> Тип("Строка");
	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ЗапрещеноСозданиеНовойФормы") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ПроверитьКорректностьУстановки();
	
	ИдентификаторСеанса = Неопределено;
	Параметры.Свойство("ИдентификаторСеанса", ИдентификаторСеанса);
	Если Не ЗначениеЗаполнено(ИдентификаторСеанса) Тогда
		ИдентификаторСеанса = УникальныйИдентификатор;
	КонецЕсли;
	
	Модуль = РеквизитФормыВЗначение("Объект");
	Если Не Модуль.МодульИнициализирован(ИдентификаторСеанса) Тогда
		Модуль.ИнициализироватьИзОсновнойФормы(ИдентификаторСеанса);
	КонецЕсли;
	
	НастроитьЭлементыФормы();
	ЗаполнитьПериодыСписковПоУмолчанию();
	УстановитьОтборСпискаДокументов();
	НастроитьСписокВходящихУПД();
	НастроитьСписокАгрегатов();
	НастроитьСписокОпераций();
	НастроитьСписокУведомленийОПриемке();
	УстановитьЗаголовок();
	ЗаполнитьСписокВыбораОтборТипОперации();
	ЗаполнитьСписокВыбораОтборСтатусОперации();
	ПроверитьНаличиеНовостей();
	НастроитьКартинкиКомандФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ВладелецФормы = Неопределено Тогда
		МодульКлиента().ПриОткрытииОсновнойФормы();
	КонецЕсли;
	
	УстановитьВидимость();
	УстановитьПериодРабочегоСтола();
	УстановитьДатуПоследнегоОбмена();
	
	ПроверитьВыполнениеОбменаССервисом();
	ПроверитьЗаполнениеАнкеты();
	
	ОбновитьСписокДокументовУчета();
	ОбновитьСписокОпераций();
	ОбновитьСписокВходящихУПД();
	ОбновитьСписокОперацийАгрегатов();
	ОбновитьСписокУведомленийОПриемке();
	
	Если ВладелецФормы = Неопределено Тогда
		ПроверитьОбновление(Истина);
	Иначе
		ПродолжитьОткрытие();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ВладелецФормы <> Неопределено И ВладелецФормы.Открыта() Тогда
		Оповестить("КонтурМаркировка_СменитьВладельца", ВладелецФормы, ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы = Ложь)
	
	Если Не ЗавершениеРаботы И ВладелецФормы = Неопределено Тогда
		МодульКлиента().ПриЗакрытииОсновнойФормы();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСпискаДокументов()
	
	Если Не Найти(КлючНазначенияИспользования, "Документы") Тогда
		Возврат;
	КонецЕсли;
	
	ПериодДокументовУчета = Параметры.Период;
	
	СписокДокументов_ОчиститьОтборыНаСервере();
	ТекущийОтборСпискаДокументов = МодульОбъекта().Перечисление_СлужебныеОтборы().ОтборБезНазвания;
	ТаблицаДокументов_УстановитьСхемуСКД(СписокДокументовУчета.Выгрузить());
	
	ОтборКомпоновки = КомпоновщикНастроек.Настройки.Отбор;
	ОтборКомпоновки.Элементы.Очистить();
	ЗаполнитьОтборКомпоновкиДанных(ОтборКомпоновки, Параметры.ПараметрыОтбора);
	
	МодульОбъекта().СохранитьОтборСпискаДокументов(ТекущийОтборСпискаДокументов, КомпоновщикНастроек);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборДинамическогоСпискаПоПараметрамФормы(ДинамическийСписок)
	
	Если Не Параметры.Свойство("ПараметрыОтбора") Тогда
		Возврат;
	КонецЕсли;
	
	Если МодульОбъекта().ВерсияПлатформыНиже("8.3") Тогда
		ОтборКомпоновки = ДинамическийСписок.Отбор;
	ИначеЕсли МодульОбъекта().ВерсияРежимаСовместимостиНиже("8.3") Тогда
		ОтборКомпоновки = ДинамическийСписок.КомпоновщикНастроек.Настройки.Отбор;
	Иначе
		Для каждого Элемент Из ДинамическийСписок.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
			Если ТипЗнч(Элемент) = Тип("ОтборКомпоновкиДанных") Тогда
				ОтборКомпоновки = Элемент;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ЗаполнитьОтборКомпоновкиДанных(ОтборКомпоновки, Параметры.ПараметрыОтбора);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтборКомпоновкиДанных(Приемник, Источник)
	
	Для каждого ЭлементИсточник Из Источник.Элементы Цикл
		
		ЭлементПриемник = Приемник.Элементы.Добавить(ТипЗнч(ЭлементИсточник));
		ЗаполнитьЗначенияСвойств(ЭлементПриемник, ЭлементИсточник);
		
		Если ТипЗнч(ЭлементИсточник) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ЗаполнитьОтборКомпоновкиДанных(ЭлементПриемник, ЭлементИсточник);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСпискаОпераций()
	
	Если Не Найти(КлючНазначенияИспользования, "Операции") Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьОтборДинамическогоСпискаПоПараметрамФормы(СписокОпераций);
	
	ПериодСпискаОпераций = Параметры.Период;
	Элементы.Закладки.ТекущаяСтраница = Элементы.ЗакладкаОперации;
	
	Если Не МодульОбъекта().ВерсияПлатформыНиже("8.3") Тогда
		СписокОпераций.АвтоматическоеСохранениеПользовательскихНастроек = Ложь;
	КонецЕсли;
	
	Если МодульОбъекта().ВерсияРежимаСовместимостиНиже("8.3") Тогда
		СформироватьОписаниеОтборов();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСпискаВходящихУПД()
	
	Если Не Найти(КлючНазначенияИспользования, "ПриемкаУПД") Тогда
		Возврат;
	КонецЕсли;
	
	ПериодВходящихУПД = Параметры.Период;
	Элементы.Закладки.ТекущаяСтраница = Элементы.ЗакладкаПриемкаУПД;
	
	Если Не МодульОбъекта().ВерсияПлатформыНиже("8.3") Тогда
		СписокВходящихУПД.АвтоматическоеСохранениеПользовательскихНастроек = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСпискаУведомленийОПриемке()
	
	Если Не Найти(КлючНазначенияИспользования, "УведомленияОПриемке") Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьОтборДинамическогоСпискаПоПараметрамФормы(СписокУведомленийОПриемке);
	
	ПериодУведомленийОПриемке = Параметры.Период;
	Элементы.Закладки.ТекущаяСтраница = Элементы.ЗакладкаУведомленияОПриемке;
	
	Если Не МодульОбъекта().ВерсияПлатформыНиже("8.3") Тогда
		СписокУведомленийОПриемке.АвтоматическоеСохранениеПользовательскихНастроек = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимость()
	
	РежимТехническогоСпециалиста = МодульКлиента().ВключенРежимТехническогоСпециалиста();
	НастроитьВидимостьПодменюТехническогоСпециалиста(РежимТехническогоСпециалиста);
	
	Если Не ЗначениеЗаполнено(КлючНазначенияИспользования) Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ГруппаЗаголовок.Видимость = Ложь;
	
	Если Найти(КлючНазначенияИспользования, "Документы") Тогда
		ОтображаемаяСтраница = Элементы.ЗакладкаДокументыУчета;
		Элементы.Кнопка_ПоказатьЗавершенныеДокументы.Видимость = Ложь;
	ИначеЕсли Найти(КлючНазначенияИспользования, "ПриемкаУПД") Тогда
		ОтображаемаяСтраница = Элементы.ЗакладкаПриемкаУПД;
	ИначеЕсли Найти(КлючНазначенияИспользования, "УведомленияОПриемке") Тогда
		ОтображаемаяСтраница = Элементы.ЗакладкаУведомленияОПриемке;
	Иначе
		ОтображаемаяСтраница = Элементы.ЗакладкаОперации;
		Элементы.СписокОперацийБыстрыеОтборы.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.Закладки.ТекущаяСтраница = ОтображаемаяСтраница;
	Элементы.Закладки.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВидимостьПодменюТехническогоСпециалиста(РежимТехническогоСпециалиста)
	
	Элементы.Группа_ФункцииТехническогоСпециалиста.Видимость = РежимТехническогоСпециалиста;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОбновление(ПриОткрытии = Ложь)
	
	КонтекстОбновления = МодульКлиента().КонтекстОбновления();
	КонтекстОбновления.ВыполняетсяОткрытиеМодуля = ПриОткрытии;
	
	Если ПриОткрытии И КонтекстОбновления.ОбновлениеВыполнено Тогда
		ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("ПослеУведомленияОбУстановкеНовойВерсии", ЭтаФорма);
		МодульКлиента().ОткрытьФормуИнформацииОбОбновлении(ЭтаФорма, КонтекстОбновления, ОписаниеОбработчика);
		Возврат;
	КонецЕсли;
	
	МодульКлиента().ПроверитьДоступностьФайлаМодуляНаКлиенте(КонтекстОбновления);
	
	Если ПриОткрытии И Не КонтекстОбновления.ЕстьОбновлениеМодуля Тогда
		ПродолжитьОткрытиеПослеПроверкиОбновления();
		Возврат;
	КонецЕсли;
	
	Если ПриОткрытии Тогда
		
		Если КонтекстОбновления.ЕстьОбновлениеМодуля
			И Не КонтекстОбновления.ЕстьПодсистемаВСО Тогда
			ДобавитьУведомление(МодульКлиента().Перечисление_ТипыУведомлений().ОбновитесьДоНовойВерсии);
		КонецЕсли;
		
		Если КонтекстОбновления.НевозможноВыполнитьОбновление
			Или КонтекстОбновления.ПолученаОшибкаСервисаОбновлений
			Или КонтекстОбновления.НельзяПоказыватьУведомлениеОНовойВерсии Тогда
			МодульКлиента().Метрики_НевозможноВыполнитьОбновление(КонтекстОбновления);
			ПродолжитьОткрытиеПослеПроверкиОбновления();
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("Обновление_ОбработатьРешениеПользователя", ЭтаФорма);
	МодульКлиента().ОткрытьФормуИнформацииОбОбновлении(ЭтаФорма, КонтекстОбновления, ОписаниеОбработчика);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОткрытиеПослеПроверкиОбновления()
	
	Если МодульКлиента().НеобходимоПерейтиНаНовуюВерсиюДанных() Тогда
		ПерейтиНаНовуюВерсиюДанных();
		Возврат;
	КонецЕсли;
	
	ПродолжитьОткрытие();
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаНовуюВерсиюДанных()
	
	ТребуемаяВерсия = МодульКлиента().ТребуемаяВерсияДанныхПодсистемы();
	ЗаголовокВопроса = НСтр("ru = 'Обновление подсистемы Контур.Маркировка'");
	
	ТекстВопроса = НСтр(
	"ru = 'Необходимо обновить данные подсистемы до версии %1
	|Обновление может занять от нескольких минут до нескольких часов.
	|Продолжить?'");
	ТекстВопроса = МодульКлиента().ПараметрыВСтроку(ТекстВопроса, ТребуемаяВерсия);
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
	"ПерейтиНаНовуюВерсиюДанных_ПослеСогласия", ЭтаФорма, ТребуемаяВерсия);
	
	МодульКлиента().ПоказатьДиалогВопроса(ОписаниеОбработчика, ТекстВопроса, РежимДиалогаВопрос.ДаНет, ЗаголовокВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаНовуюВерсиюДанных_ПослеСогласия(Ответ, НоваяВерсия) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Закрыть();
		Возврат;
	КонецЕсли;
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
	"ПерейтиНаНовуюВерсиюДанных_ПослеОбновленияДанных", ЭтаФорма, НоваяВерсия);
	
	МодульКлиента().ОткрытьФормуПереходаНаНовуюВерсиюДанных(ЭтаФорма, ОписаниеОбработчика);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаНовуюВерсиюДанных_ПослеОбновленияДанных(ОбновлениеВыполнено, НоваяВерсия) Экспорт
	
	Если ОбновлениеВыполнено <> Истина Тогда
		Закрыть();
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = НСтр("ru = 'Обновление на новую версию данных %1 успешно завершено'");
	ТекстСообщения = МодульКлиента().ПараметрыВСтроку(ТекстСообщения, НоваяВерсия);
	МодульКлиента().СообщитьПользователюЛок(ТекстСообщения);
	
	ПродолжитьОткрытие();
	
КонецПроцедуры

&НаКлиенте
Процедура Обновление_ОбработатьРешениеПользователя(КонтекстОбновления, ДопПараметры = Неопределено) Экспорт
	
	Если КонтекстОбновления.ПолученОтказ Тогда
		МодульКлиента().ЗафиксироватьОтказОтОбновленияПриОткрытииМодуля(КонтекстОбновления);
	КонецЕсли;
	
	Если КонтекстОбновления.ПолученоСогласие Тогда
		Обновление_ПредложениеЗавершитьРаботуНаВсехУстройствах(КонтекстОбновления);
		Возврат;
	КонецЕсли;
	
	Если КонтекстОбновления.ВыполняетсяОткрытиеМодуля Тогда
		ПродолжитьОткрытиеПослеПроверкиОбновления();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Обновление_ПредложениеЗавершитьРаботуНаВсехУстройствах(КонтекстОбновления)
	
	ЗаголовокВопроса = НСтр("ru = 'Обновление модуля'");
	
	ТекстВопроса = НСтр(
	"ru = 'Для корректного обновления необходимо
	|завершить работу с текущей версией на всех устройствах.
	|Выполнить обновление?'");
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
	"Обновление_ПредложениеЗавершитьРаботуНаВсехУстройствах_ПослеСогласия", ЭтаФорма, КонтекстОбновления);
	
	МодульКлиента().ПоказатьДиалогВопроса(ОписаниеОбработчика, ТекстВопроса, РежимДиалогаВопрос.ДаНет, ЗаголовокВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура Обновление_ПредложениеЗавершитьРаботуНаВсехУстройствах_ПослеСогласия(Ответ, КонтекстОбновления) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОбновитьИПерезапуститьМодуль(КонтекстОбновления);
	Иначе
		Если КонтекстОбновления.ВыполняетсяОткрытиеМодуля Тогда
			ПродолжитьОткрытиеПослеПроверкиОбновления();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИПерезапуститьМодуль(КонтекстОбновления)
	
	Попытка
		МодульКлиента().ВыполнитьОбновлениеМодуля(КонтекстОбновления);
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Выполнение обновления'");
		ТекстСообщения = НСтр("ru = 'Не удалось выполнить обновление'");
		
		МодульКлиента().ОбработатьОшибку(Действие, Ошибка,, ТекстСообщения);
		
		КонтекстОбновления.ОписаниеОшибки = Ошибка;
		
	КонецПопытки;
	
	МодульКлиента().Метрики_АвтоматическоеОбновление(КонтекстОбновления);
	
	Если КонтекстОбновления.ОбновлениеВыполнено Тогда
		
		ВариантыРасположения = МодульКлиента().Перечисление_ВариантыРасположенияОбработки();
		Если КонтекстОбновления.РасположениеМодуля = ВариантыРасположения.ВРасширении Тогда
			УведомитьПользователяОбУспешномОбновленииРасширенияКонфигурации();
		Иначе
			ПодключитьНовуюВерсиюПерезапуститьМодуль(КонтекстОбновления);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УведомитьПользователяОбУспешномОбновленииРасширенияКонфигурации()
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
			"ОбработатьДействиеПользователяПослеОбновленияРасширения",
			ЭтаФорма);
	
	ЗаголовокВопроса = НСтр("ru = 'Обновление модуля'");
	ТекстСообщения = НСтр("ru = 'Модуль автоматически обновлен до актуальной версии. Для работы с модулем перезапустите программу.'");
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Закрыть'"));
	Кнопки.Добавить(КодВозвратаДиалога.ОК, НСтр("ru = 'Перезапустить'"));
	
	МодульКлиента().ПоказатьДиалогВопроса(
		ОписаниеОбработчика,
		ТекстСообщения,
		Кнопки,
		ЗаголовокВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьДействиеПользователяПослеОбновленияРасширения(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Результат = КодВозвратаДиалога.ОК Тогда
		ЗавершитьРаботуСистемы(Ложь, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОткрытие()
	
	Если МодульКлиента().ВерсияПлатформыНиже("8.3") Тогда
		// В событии ПриОткрытии ЭтаФорма.Открыта() для 8.2 = Ложь
		// Чтобы избежать ошибок продолжаем через обработчик ожидания
		ПодключитьОбработчикОжидания("ПослеОткрытия", 0.1, Истина);
	Иначе
		ПослеОткрытия();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОткрытия() Экспорт
	
	ОбновитьТекстУведомления();
	
	УстановитьОтборПоказатьЗавершенныеСпискаДокументовУчета();
	
	УстановитьЗаголовокПериодаСписка(Элементы.Кнопка_ПериодСпискаДокументов, ПериодДокументовУчета);
	УстановитьЗаголовокПериодаСписка(Элементы.Кнопка_ПериодСпискаВходящихУПД, ПериодВходящихУПД);
	УстановитьЗаголовокПериодаСписка(Элементы.Кнопка_ПериодОперацийАгрегатов, ПериодОперацийАгрегатов);
	УстановитьЗаголовокПериодаСписка(Элементы.Кнопка_ПериодСпискаОпераций, ПериодСпискаОпераций);
	УстановитьЗаголовокПериодаСписка(Элементы.Кнопка_ПериодСпискаУведомленийОПриемке, ПериодУведомленийОПриемке);
	
	Если ВладелецФормы = Неопределено Тогда
		МодульКлиента().ЗапуститьУдалениеУстаревшихДанных();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДатуПоследнегоОбмена()
	
	ДатаПоследнегоОбмена = ДатаПоследнегоОбмена();
	
	Если ЗначениеЗаполнено(ДатаПоследнегоОбмена) Тогда
		
		ДатаПоследнегоОбмена = МестноеВремя(ДатаПоследнегоОбмена);
		
		МинутВЧасе = 60;
		СекундВЧасе = 3600;
		ПрошлоМинут = Цел((ТекущаяДата() - ДатаПоследнегоОбмена) / МинутВЧасе);
		ПрошлоЧасов = Цел((ТекущаяДата() - ДатаПоследнегоОбмена) / СекундВЧасе);
		
		Если НачалоДня(ДатаПоследнегоОбмена) < НачалоДня(ТекущаяДата()) Тогда
			
			ДатаСтрокой = Строка(ДатаПоследнегоОбмена);
			
		ИначеЕсли ЗначениеЗаполнено(ПрошлоЧасов) Или ЗначениеЗаполнено(ПрошлоМинут) Тогда
			
			Если ЗначениеЗаполнено(ПрошлоЧасов) Тогда
				ПараметрыИсчисления = "час, часа, часов, м,,,,, 0";
				ДатаСтрокой = МодульКлиента().ЧислоСЕдиницейИзмерения(ПрошлоЧасов, ПараметрыИсчисления);
			Иначе
				ПараметрыИсчисления = "минута, минуты, минут, ж,,,,, 0";
				ДатаСтрокой = МодульКлиента().ЧислоСЕдиницейИзмерения(ПрошлоМинут, ПараметрыИсчисления);
			КонецЕсли;
			
			ДатаСтрокой = ДатаСтрокой + " " + НСтр("ru = 'назад'");
			
		Иначе
			ДатаСтрокой = НСтр("ru = 'только что'");
		КонецЕсли;
		
	Иначе
		ДатаСтрокой = НСтр("ru = 'никогда'");
	КонецЕсли;
	
	ТекстДатаОбмена = НСтр("ru = 'Обмен с сервисом: %1'");
	ТекстДатаОбмена = МодульКлиента().ПараметрыВСтроку(ТекстДатаОбмена, ДатаСтрокой);
	
	ЭтаФорма.Элементы.Ссылка_ДатаОбменаССервисом.Заголовок = ТекстДатаОбмена;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовок()
	
	Если Параметры.Свойство("Заголовок", Заголовок) Тогда
		Возврат;
	КонецЕсли;
	
	ВерсияМодуля = МодульОбъекта().ВерсияОбработки();
	ЭтоБетаВерсия = МодульОбъекта().ЭтоБетаВерсия();
	НастройкиМодуля = МодульОбъекта().НастройкиМодуля();
	ОписаниеДоработокМодуля = МодульОбъекта().ОписаниеДоработокМодуля();
	НаименованиеМодуля = МодульОбъекта().СведенияОВнешнейОбработке().Наименование;
	
	Если ЭтоБетаВерсия Тогда
		СтрокаБетаВерсия = "b";
	КонецЕсли;
	
	ДополнительноеОписаниеМодуля = Новый Массив;
	Если НастройкиМодуля.ТестовоеОкружение Тогда
		ДополнительноеОписаниеМодуля.Добавить("тестовое окружение");
	КонецЕсли;
	Если НастройкиМодуля.РежимТестирования Тогда
		ДополнительноеОписаниеМодуля.Добавить("режим тестирования");
	КонецЕсли;
	Если ЗначениеЗаполнено(ОписаниеДоработокМодуля) Тогда
		ДополнительноеОписаниеМодуля.Добавить("модуль доработан");
	КонецЕсли;
	Если НастройкиМодуля.РежимОтладки Тогда
		ДополнительноеОписаниеМодуля.Добавить("режим отладки");
	КонецЕсли;
	
	СтрокаДополнительноеОписание = "";
	Если ЗначениеЗаполнено(ДополнительноеОписаниеМодуля) Тогда
		СтрокаДополнительноеОписание = МодульОбъекта().СоединитьСтроку(ДополнительноеОписаниеМодуля, ", ");
		СтрокаДополнительноеОписание = МодульОбъекта().ПараметрыВСтроку(" (%1)", СтрокаДополнительноеОписание);
	КонецЕсли;
	
	ТекстЗаголовка = НаименованиеМодуля
	+ " "
	+ ВерсияМодуля
	+ СтрокаБетаВерсия
	+ СтрокаДополнительноеОписание;
	
	ЭтаФорма.Заголовок = ТекстЗаголовка;
	
КонецПроцедуры

&НаСервере
Функция ДатаПоследнегоОбмена()
	
	ВсеОрганизацииДляОбмена = МодульОбъекта().Организация_ВсеОрганизацииДляОбмена();
	
	Результат = '00010101';
	
	Для Каждого ОрганизацияДляОбмена Из ВсеОрганизацииДляОбмена Цикл
		
		Свойство = МодульОбъекта().Перечисление_ДопСвойства().ДатаПоследнегоОбмена;
		ДатаПоследнегоОбмена = МодульОбъекта().ДопСвойство_Прочитать(ОрганизацияДляОбмена, Свойство);
		Если Не ЗначениеЗаполнено(ДатаПоследнегоОбмена) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Результат)
			Или Результат > ДатаПоследнегоОбмена Тогда
			Результат = ДатаПоследнегоОбмена;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПериодыСписковПоУмолчанию()
	
	ЗаполнитьПустыеЗначенияПериода(ПериодДокументовУчета);
	ЗаполнитьПустыеЗначенияПериода(ПериодВходящихУПД);
	ЗаполнитьПустыеЗначенияПериода(ПериодОперацийАгрегатов);
	ЗаполнитьПустыеЗначенияПериода(ПериодСпискаОпераций);
	ЗаполнитьПустыеЗначенияПериода(ПериодУведомленийОПриемке);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодРабочегоСтола()
	
	ПериодРабочегоСтола = МодульКлиента().СвойствоОбъекта(ВладелецФормы, "Период");
	Если Не ЗначениеЗаполнено(ПериодРабочегоСтола) Тогда
		Возврат;
	КонецЕсли;
	
	ПериодДокументовУчета = ПериодРабочегоСтола;
	ПериодВходящихУПД = ПериодРабочегоСтола;
	ПериодОперацийАгрегатов = ПериодРабочегоСтола;
	ПериодСпискаОпераций = ПериодРабочегоСтола;
	ПериодУведомленийОПриемке = ПериодРабочегоСтола;
	
КонецПроцедуры

&НаКлиенте
Функция ПредставлениеПериодаСтрокой(Период)
	
	Если Период.Вариант = ВариантСтандартногоПериода.Месяц
		Или Период.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод Тогда
		СтрокаПериода = ПредставлениеПериода(Период.ДатаНачала, Период.ДатаОкончания);
	Иначе
		СтрокаПериода = Строка(Период);
	КонецЕсли;
	
	Возврат СтрокаПериода;
	
КонецФункции

&НаКлиенте
Процедура УстановитьЗаголовокПериодаСписка(Элемент, Период)
	
	Элемент.Заголовок = ПредставлениеПериодаСтрокой(Период);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьСписокВходящихУПД()
	
	УстановитьОтборСпискаВходящихУПД();
	
	СписокВходящихУПД.ТекстЗапроса = ТекстЗапроса_СписокВходящихУПД();
	СписокВходящихУПД.ОсновнаяТаблица = "Справочник.КонтурМаркировка_Операции";
	СписокВходящихУПД.ДинамическоеСчитываниеДанных = Истина;
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
