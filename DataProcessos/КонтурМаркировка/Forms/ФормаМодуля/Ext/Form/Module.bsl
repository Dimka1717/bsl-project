&НаСервере
Процедура ЗаполнитьТаблицуДокументов()
	
	СписокДокументовУчета.Очистить();
	
	НастройкиДокументов = МодульОбъекта().ДействующиеНастройкиДокументовУчета();
	Если Не ЗначениеЗаполнено(НастройкиДокументов) Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	МодульОбъекта().ТаблицаДокументов_ВТ_ДобавитьОрганизации1С(МенеджерВТ);
	МодульОбъекта().ТаблицаДокументов_ВТ_ДобавитьСклады1С(МенеджерВТ);
	
	ИменаТаблицДокументов = МодульОбъекта().ТаблицаДокументов_ВТ_ИменаТаблицДокументовУчета(
	МенеджерВТ, НастройкиДокументов, ПериодДокументовУчета, Истина);
	
	ТребуемыеДействия = МодульОбъекта().Перечисление_ТребуемыеДействияДокументовУчета();
	Статусы = МодульОбъекта().Перечисление_СтатусыДокументовУчета();
	ЗавершенныеСтатусы = Новый Массив;
	ЗавершенныеСтатусы.Добавить(Статусы.Завершен);
	ЗавершенныеСтатусы.Добавить(Статусы.Пропущен);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_ОбщаяТаблицаДокументов(ИменаТаблицДокументов);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("СтатусНовый", Статусы.Новый);
	Запрос.УстановитьПараметр("ДействиеНачатьРаботу", ТребуемыеДействия.НачатьРаботу);
	Запрос.УстановитьПараметр("ЗавершенныеСтатусы", ЗавершенныеСтатусы);
	
	НомерСтроки = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НомерСтроки = НомерСтроки + 1;
		Стр = СписокДокументовУчета.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Выборка);
		Стр.НомерСтроки = НомерСтроки;
	КонецЦикла;
	
	МенеджерВТ.Закрыть();
	
КонецПроцедуры

&НаСервере
Функция ТекстЗапроса_СписокВходящихУПД()
	
	Результат =
	"ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка,
	|	Спр.ПометкаУдаления КАК ПометкаУдаления,
	|	Спр.Код КАК Код,
	|	Спр.Дата КАК Дата,
	|	Спр.ТипОперации КАК ТипОперации,
	|	Спр.Организация КАК Организация,
	|	Спр.Склад КАК Склад,
	|	Спр.ВидПродукции КАК ВидПродукции,
	|	Спр.ДокументУчета КАК ДокументУчета,
	|	Спр.ОперацияОснование КАК ОперацияОснование,
	|	Спр.Ответственный КАК Ответственный,
	|	Спр.Комментарий КАК Комментарий,
	|	Статусы.Статус КАК Статус,
	|	Статусы.ДатаСтатуса КАК ДатаИзмененияСтатуса,
	|	ВЫРАЗИТЬ(ЕСТЬNULL(НомераДокументов.Значение, """") КАК СТРОКА(1000)) КАК НомерДокумента,
	|	ВЫРАЗИТЬ(ДатыДокументов.Значение КАК ДАТА) КАК ДатаДокумента,
	|	ВЫРАЗИТЬ(ЕСТЬNULL(НаименованиеКонтрагентов.Значение, """") КАК СТРОКА(1000)) КАК НаименованиеКонтрагента,
	|	ВЫРАЗИТЬ(ЕСТЬNULL(ИННКонтрагентов.Значение, """") КАК СТРОКА(1000)) КАК ИНН_Контрагента,
	|	ВЫРАЗИТЬ(ЕСТЬNULL(СодержитОшибки.Значение, ЛОЖЬ) КАК БУЛЕВО) КАК СодержитОшибки,
	|	ВЫБОР
	|		КОГДА СодержитОшибки.Значение = ИСТИНА
	|			ТОГДА 2
	|		ИНАЧЕ 5
	|	КОНЕЦ КАК НомерКартинки
	|{ВЫБРАТЬ
	|	Ссылка.*,
	|	Код,
	|	Дата,
	|	ТипОперации,
	|	Организация.*,
	|	Склад.*,
	|	ВидПродукции.*,
	|	ДокументУчета.*,
	|	ОперацияОснование.*,
	|	Ответственный.*,
	|	Комментарий,
	|	Статус,
	|	ДатаИзмененияСтатуса,
	|	НомерДокумента,
	|	ДатаДокумента,
	|	НаименованиеКонтрагента,
	|	ИНН_Контрагента,
	|	СодержитОшибки,
	|	НомерКартинки}
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Спр
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК Статусы
	|		ПО Спр.Ссылка = Статусы.Операция
	|			И (Статусы.ТипСтатуса = ""ОсновнойСтатус"")}
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК НомераДокументов
	|		ПО Спр.Ссылка = НомераДокументов.Объект
	|			И (НомераДокументов.ИмяРеквизита = ""НомерДокумента"")}
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ДатыДокументов
	|		ПО Спр.Ссылка = ДатыДокументов.Объект
	|			И (ДатыДокументов.ИмяРеквизита = ""ДатаДокумента"")}
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК НаименованиеКонтрагентов
	|		ПО Спр.Ссылка = НаименованиеКонтрагентов.Объект
	|			И (НаименованиеКонтрагентов.ИмяРеквизита = ""КонтрагентНаименование"")}
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ИННКонтрагентов
	|		ПО Спр.Ссылка = ИННКонтрагентов.Объект
	|			И (ИННКонтрагентов.ИмяРеквизита = ""КонтрагентИНН"")}
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК СодержитОшибки
	|		ПО Спр.Ссылка = СодержитОшибки.Объект
	|			И (СодержитОшибки.ИмяРеквизита = ""СодержитОшибки"")}
	|ГДЕ
	|	Спр.ТипОперации = &ВходящийУПД
	|	И ВЫРАЗИТЬ(ДатыДокументов.Значение КАК ДАТА) МЕЖДУ &ДатаНачала И &ДатаОкончания
	|{ГДЕ
	|	Спр.Ссылка.*,
	|	Спр.Код,
	|	Спр.Дата,
	|	Спр.ТипОперации,
	|	Спр.Организация.*,
	|	Спр.Склад.*,
	|	Спр.ВидПродукции.*,
	|	Спр.ДокументУчета.*,
	|	Спр.ОперацияОснование.*,
	|	Спр.Ответственный.*,
	|	Спр.Комментарий,
	|	Статусы.Статус,
	|	Статусы.ДатаСтатуса,
	|	(ВЫРАЗИТЬ(ЕСТЬNULL(НомераДокументов.Значение, """") КАК СТРОКА(1000))) КАК НомерДокумента,
	|	(ВЫРАЗИТЬ(ДатыДокументов.Значение КАК ДАТА)) КАК ДатаДокумента,
	|	(ВЫРАЗИТЬ(ЕСТЬNULL(НаименованиеКонтрагентов.Значение, """") КАК СТРОКА(1000))) КАК НаименованиеКонтрагента,
	|	(ВЫРАЗИТЬ(ЕСТЬNULL(ИННКонтрагентов.Значение, """") КАК СТРОКА(1000))) КАК ИНН_Контрагента,
	|	(ВЫРАЗИТЬ(ЕСТЬNULL(СодержитОшибки.Значение, ЛОЖЬ) КАК БУЛЕВО)) КАК СодержитОшибки}";
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ТекстЗапроса_СписокАгрегатов()
	
	Результат =
	"ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка,
	|	Спр.Дата КАК Дата,
	|	Спр.ТипОперации КАК ТипОперации,
	|	Спр.Организация КАК Организация,
	|	Спр.Склад КАК Склад,
	|	Спр.ВидПродукции КАК ВидПродукции,
	|	Спр.ОперацияОснование КАК ОперацияОснование,
	|	Спр.ДокументУчета КАК ДокументУчета,
	|	Статусы.Статус КАК Статус,
	|	Статусы.ДатаСтатуса КАК ДатаИзмененияСтатуса,
	|	Спр.Комментарий КАК Комментарий,
	|	Спр.Ответственный КАК Ответственный
	|{ВЫБРАТЬ
	|	Ссылка.*,
	|	Дата,
	|	ТипОперации,
	|	Организация.*,
	|	Склад.*,
	|	ВидПродукции.*,
	|	ОперацияОснование.*,
	|	ДокументУчета.*,
	|	Статус,
	|	ДатаИзмененияСтатуса,
	|	Комментарий,
	|	Ответственный.*}
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Спр
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК Статусы
	|		ПО Спр.Ссылка = Статусы.Операция
	|			И (Статусы.ТипСтатуса = ""ОсновнойСтатус"")}
	|ГДЕ
	|	Спр.ТипОперации В(&ПодходящиеТипы)
	|	И Спр.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|{ГДЕ
	|	Спр.Ссылка.*,
	|	Спр.Дата,
	|	Спр.ТипОперации,
	|	Спр.Организация.*,
	|	Спр.Склад.*,
	|	Спр.ВидПродукции.*,
	|	Спр.ОперацияОснование.*,
	|	Спр.ДокументУчета.*,
	|	Статусы.Статус,
	|	Статусы.ДатаСтатуса,
	|	Спр.Комментарий,
	|	Спр.Ответственный.*}";
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ТекстЗапроса_СписокОпераций()
	
	Результат =
	"ВЫБРАТЬ
	|	Операции.Ссылка КАК Ссылка,
	|	Операции.Код КАК Номер,
	|	Операции.Дата КАК Дата,
	|	Операции.ТипОперации КАК ТипОперации,
	|	Операции.Организация КАК Организация,
	|	Операции.Склад КАК Склад,
	|	Операции.ДокументУчета КАК ДокументУчета,
	|	Операции.ОперацияОснование КАК ОперацияОснование,
	|	Операции.Комментарий КАК Комментарий,
	|	Статусы.Статус КАК Статус,
	|	ВЫБОР
	|		КОГДА Статусы.Статус ЕСТЬ NULL
	|				ИЛИ Статусы.Статус = &Новый
	|			ТОГДА 0
	|		КОГДА Статусы.Статус = &ОшибкаОбработки
	|				ИЛИ Статусы.Статус = &ОшибкаЗаполнения
	|				ИЛИ Статусы.Статус = &ОшибкаОтменыОперации
	|			ТОГДА 2
	|		КОГДА Статусы.Статус = &ОперацияОтменена
	|				ИЛИ Статусы.Статус = &ОперацияЗавершена
	|			ТОГДА 4
	|		ИНАЧЕ 3
	|	КОНЕЦ КАК ИндексКартинки,
	|	ОчередьОбмена.ТребуемоеДействие КАК ТребуемоеДействие,
	|	ОчередьОбмена.ИдентификаторДокумента КАК ИдентификаторВСервисе,
	|	ЕСТЬNULL(НастройкиДокументов.Наименование, """") КАК ТипДокумента
	|{ВЫБРАТЬ
	|	Ссылка.*,
	|	Дата,
	|	Номер,
	|	ТипОперации,
	|	Организация.*,
	|	Склад.*,
	|	ОперацияОснование.*,
	|	ДокументУчета.*,
	|	Статус,
	|	Комментарий,
	|	ИндексКартинки,
	|	ТребуемоеДействие,
	|	ИдентификаторВСервисе}
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Операции
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК Статусы
	|		ПО Операции.Ссылка = Статусы.Операция
	|			И (Статусы.ТипСтатуса = ""ОсновнойСтатус"")}
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ОчередьОбмена КАК ОчередьОбмена
	|		ПО Операции.Ссылка = ОчередьОбмена.Операция
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета КАК ДокументыУчета
	|		ПО Операции.ДокументУчета = ДокументыУчета.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДопСправочники.ДопРеквизиты КАК НастройкиТиповДокументов
	|		ПО (ДокументыУчета.ТипДокумента = НастройкиТиповДокументов.Значение)
	|			И (НастройкиТиповДокументов.ИмяРеквизита = ""ТипДокумента"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДопСправочники КАК НастройкиДокументов
	|		ПО (НастройкиТиповДокументов.Ссылка = НастройкиДокументов.Ссылка)
	|ГДЕ
	|	Операции.ТипОперации В(&ПодходящиеТипы)
	|	И Операции.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ЕСТЬNULL(НастройкиДокументов.ИмяСправочника, """") В ("""", ""НастройкиДокументаУчета"")
	|{ГДЕ
	|	Операции.Ссылка.*,
	|	Операции.Дата,
	|	Операции.Код КАК Номер,
	|	Операции.ТипОперации,
	|	Операции.Организация.*,
	|	Операции.Склад.*,
	|	Операции.ОперацияОснование.*,
	|	Операции.ДокументУчета.*,
	|	Операции.Комментарий,
	|	Статусы.Статус,
	|	ОчередьОбмена.ТребуемоеДействие,
	|	ОчередьОбмена.ИдентификаторДокумента КАК ИдентификаторВСервисе,
	|	(ЕСТЬNULL(НастройкиДокументов.Наименование, """")) КАК ТипДокумента}";
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ТекстЗапроса_ОбщаяТаблицаДокументов(ИменаТаблицДокументов)
	
	Результат = "";
	Разделитель = "";
	ТекстЗапроса = "";
	ПерваяНастройка = Истина;
	
	Для Каждого ИмяТаблицы Из ИменаТаблицДокументов Цикл
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ТабДок.Организация КАК Организация,
		|	ТабДок.Документ1С КАК Документ1С,
		|	ТабДок.ДокументУчета КАК ДокументУчета,
		|	ТабДок.Номер КАК Номер,
		|	ТабДок.Дата КАК Дата,
		|	ТабДок.Склад КАК Склад,
		|	ТабДок.Контрагент КАК Контрагент,
		|	ТабДок.Сумма КАК Сумма,
		|	ТабДок.ТипДокумента КАК ТипДокумента,
		|	ТабДок.Комментарий КАК Комментарий,
		|	ЕСТЬNULL(ОсновныеСтатусы.Статус, &СтатусНовый) КАК Статус,
		|	ЕСТЬNULL(ТребуемыеДействия.Статус, &ДействиеНачатьРаботу) КАК ТребуемоеДействие,
		|	ТабДок.ТипПоследнейОперации КАК ТипПоследнейОперации,
		|	ТабДок.СтатусПоследнейОперации КАК СтатусПоследнейОперации,
		|	ВЫБОР
		|		КОГДА ОсновныеСтатусы.Статус В (&ЗавершенныеСтатусы)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК РаботаЗавершена,
		|	ТабДок.ДопКолонка1 КАК ДопКолонка1,
		|	ТабДок.ДопКолонка2 КАК ДопКолонка2,
		|	ТабДок.ДопКолонка3 КАК ДопКолонка3
		|ИЗ
		|	ТекущаяТаблица КАК ТабДок
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета КАК ОсновныеСтатусы
		|		ПО (ОсновныеСтатусы.ДокументУчета = ТабДок.ДокументУчета)
		|			И (ОсновныеСтатусы.ТипСтатуса = ""ОсновнойСтатус"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета КАК ТребуемыеДействия
		|		ПО (ТребуемыеДействия.ДокументУчета = ТабДок.ДокументУчета)
		|			И (ТребуемыеДействия.ТипСтатуса = ""ТребуемоеДействие"")";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТекущаяТаблица", ИмяТаблицы);
		
		Если ПерваяНастройка Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ", "ВЫБРАТЬ РАЗРЕШЕННЫЕ");
		КонецЕсли;
		
		ПерваяНастройка = Ложь;
		
		Результат = Результат + Разделитель + ТекстЗапроса;
		
		Разделитель = "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|";
		
	КонецЦикла;
	
	Результат = Результат + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ,
	|	Номер УБЫВ";
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура УстановитьОтборПоказатьЗавершенныеСпискаДокументовУчета()
	
	Если Элементы.Кнопка_ПоказатьЗавершенныеДокументы.Пометка Тогда
		Элементы.СписокДокументовУчета.ОтборСтрок = Неопределено;
	Иначе
		Элементы.СписокДокументовУчета.ОтборСтрок = Новый ФиксированнаяСтруктура("РаботаЗавершена", Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПараметрыПериодаДинамическогоСписка(Список, Период)
	
	Список.Параметры.УстановитьЗначениеПараметра("ДатаНачала", Период.ДатаНачала);
	Список.Параметры.УстановитьЗначениеПараметра("ДатаОкончания", Период.ДатаОкончания);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьПустыеЗначенияПериода(Период)
	
	Если Не ЗначениеЗаполнено(Период.ДатаНачала)
		И Не ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		
		Период.Вариант = ВариантСтандартногоПериода.ЭтаНеделя;
		
	ИначеЕсли Не ЗначениеЗаполнено(Период.ДатаНачала) Тогда
		
		Период.ДатаНачала = НачалоНедели(Период.ДатаОкончания);
		
	ИначеЕсли Не ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		
		Период.ДатаОкончания = КонецНедели(Период.ДатаНачала);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДокументовУчета_Период(Команда)
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
	"ПослеВыбораПериодаСпискаДокументовУчета", ЭтаФорма);
	МодульКлиента().ПоказатьДиалогРедактированияСтандартногоПериода(ОписаниеОбработчика, ПериодДокументовУчета);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПериодаСпискаДокументовУчета(Результат, ДопПараметры = Неопределено) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПериодДокументовУчета = Результат;
	
	ЗаполнитьПустыеЗначенияПериода(ПериодДокументовУчета);
	
	УстановитьЗаголовокПериодаСписка(Элементы.Кнопка_ПериодСпискаДокументов, ПериодДокументовУчета);
	
	ОбновитьСписокДокументовУчета();
	
