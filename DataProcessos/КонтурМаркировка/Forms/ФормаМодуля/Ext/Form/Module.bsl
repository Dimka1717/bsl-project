Процедура СписокДокументов_ОчиститьОтборыНаСервере()
	
	ТекущийОтборСпискаДокументов = "";
	СохранитьДействующийОтборСпискаДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьОтборСпискаДокументов(НаименованиеОтбора, ДопПараметры = Неопределено) Экспорт
	
	Если НаименованиеОтбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьКомандыМенюОтборов();
	
	ДействующийОтбор = ДействующийОтборСпискаДокументов();
	
	Если ДействующийОтбор = ""
		И Не ЗначениеЗаполнено(НаименованиеОтбора) Тогда
		НаименованиеОтбора = "";
	КонецЕсли;
	
	ТекущийОтборСпискаДокументов = НаименованиеОтбора;
	СохранитьДействующийОтборСпискаДокументов();
	ОбновитьСписокДокументовУчета();
	
КонецПроцедуры

&НаСервере
Процедура СохранитьДействующийОтборСпискаДокументов()
	
	МодульОбъекта().СохранитьДействующийОтборСпискаДокументов(ТекущийОтборСпискаДокументов);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьОписаниеОтборов()
	
	Если Элементы.Закладки.ТекущаяСтраница = Элементы.ЗакладкаДокументыУчета Тогда
		
		СлужебныеОтборы = МодульОбъекта().Перечисление_СлужебныеОтборы();
		Если ТекущийОтборСпискаДокументов = СлужебныеОтборы.ОтборБезНазвания Тогда
			ОписаниеНастроекОтбора = Строка(КомпоновщикНастроек.ПолучитьНастройки().Отбор);
		Иначе
			ОписаниеНастроекОтбора = ТекущийОтборСпискаДокументов;
		КонецЕсли;
		
	Иначе
		
		Если Элементы.Закладки.ТекущаяСтраница = Элементы.ЗакладкаОперации Тогда
			ДинамическийСписок = СписокОпераций;
		ИначеЕсли Элементы.Закладки.ТекущаяСтраница = Элементы.ЗакладкаПриемкаУПД Тогда
			ДинамическийСписок = СписокВходящихУПД;
		ИначеЕсли Элементы.Закладки.ТекущаяСтраница = Элементы.ЗакладкаУведомленияОПриемке Тогда
			ДинамическийСписок = СписокУведомленийОПриемке;
		ИначеЕсли Элементы.Закладки.ТекущаяСтраница = Элементы.ЗакладкаТранспортныеУпаковки Тогда
			ДинамическийСписок = СписокОперацийАгрегатов;
		КонецЕсли;
		
		Если МодульОбъекта().ВерсияПлатформыНиже("8.3") Тогда
			ОписаниеНастроекОтбора = Строка(ДинамическийСписок.Отбор);
		Иначе
			ОписаниеНастроекОтбора = Строка(ДинамическийСписок.КомпоновщикНастроек.ПолучитьНастройки().Отбор);
		КонецЕсли;
		
	КонецЕсли;
	
	ОписаниеУсловий = "";
	Если ЗначениеЗаполнено(ОписаниеНастроекОтбора) Тогда
		ВидимостьОписания = Истина;
		Текст = НСтр("ru = 'Отбор: %1'");
		ОписаниеУсловий = МодульОбъекта().ПараметрыВСтроку(Текст, ОписаниеНастроекОтбора);
	КонецЕсли;
	
	ЭтаФорма.Элементы.УсловияОтбора.Заголовок = ОписаниеУсловий;
	
КонецПроцедуры

&НаСервере
Процедура ТаблицаДокументов_ПрименитьОтборы(ТаблицаДокументов)
	
	Если Не ЗначениеЗаполнено(ТекущийОтборСпискаДокументов) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТаблицаДокументов) Тогда
		Возврат;
	КонецЕсли;
	
	СхемаСКД = ПолучитьИзВременногоХранилища(АдресСхемыСКД);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	Макет = КомпоновщикМакета.Выполнить(СхемаСКД,
								КомпоновщикНастроек.ПолучитьНастройки(),,,
								Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ИсточникДанных = Новый Структура("ТаблицаДанных", ТаблицаДокументов);
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(Макет, ИсточникДанных);
	
	ПодходящиеСтроки = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ПодходящиеСтроки);
	процессорВывода.Вывести(ПроцессорКомпоновки);
	
	УдаляемыеСтроки = Новый Массив;
	
	Для Каждого Стр Из ТаблицаДокументов Цикл
		УдаляемыеСтроки.Добавить(Стр.НомерСтроки - 1);
	КонецЦикла;
	
	Для Сч = -(ПодходящиеСтроки.Количество() - 1) По 0 Цикл
		УдаляемыеСтроки.Удалить(ПодходящиеСтроки[-Сч].НомерСтроки - 1);
	КонецЦикла;
	
	Для Сч = -УдаляемыеСтроки.ВГраница() По 0 Цикл
		ТаблицаДокументов.Удалить(УдаляемыеСтроки[-Сч]);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ТаблицаДокументов_УстановитьСхемуСКД(ТаблицаДокументов, ИзмененыНастройки = Ложь)
	
	Если ЗначениеЗаполнено(АдресСхемыСКД) Тогда
		
		Если ИзмененыНастройки Тогда
			ПоместитьВоВременноеХранилище(ТаблицаДокументов_СформироватьСКД(ТаблицаДокументов), АдресСхемыСКД);
			КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыСКД));
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	СхемаСКД = ТаблицаДокументов_СформироватьСКД(ТаблицаДокументов);
	АдресСхемыСКД = ПоместитьВоВременноеХранилище(СхемаСКД, УникальныйИдентификатор);
	
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыСКД));
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаСКД.НастройкиПоУмолчанию);
	
КонецПроцедуры

&НаСервере
Функция ТаблицаДокументов_СформироватьСКД(ТаблицаДокументов)
	
	Результат = МодульОбъекта().ПолучитьМакет("МакетОтбораДокументыУчета");
	
	Настройки = Результат.НастройкиПоУмолчанию;
	НаборДанных = Результат.НаборыДанных.Найти("НаборДанных1");
	ПоляНабора = НаборДанных.Поля;
	ПоляНабора.Очистить();
	
	ТаблицаДокументов_УстановитьОтборыКолонок(ТаблицаДокументов, ПоляНабора, Результат);
	ТаблицаДокументов_УстановитьОтборыДопКолонок(ПоляНабора, Результат);
	ТаблицаОтборов_ДобавитьПоле_НомерСтроки(Настройки, ПоляНабора);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ТаблицаДокументов_УстановитьОтборыКолонок(ТаблицаДокументов, ПоляНабора, МакетОтбора)
	
	Для Каждого Колонка Из ТаблицаДокументов.Колонки Цикл
		
		ИмяКолонки = Колонка.Имя;
		
		Если Найти(ИмяКолонки, "ДопКолонка") > 0
			Или ИмяКолонки = "НомерСтроки"
			Или ИмяКолонки = "Дата" Тогда
			Продолжить;
		КонецЕсли;
		
		ПолеНабора = ПоляНабора.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ПолеНабора.Поле = ИмяКолонки;
		ПолеНабора.ПутьКДанным = ИмяКолонки;
		ПолеНабора.Заголовок = Колонка.Заголовок;
		ПолеНабора.ТипЗначения = Колонка.ТипЗначения;
		
		Список = Новый СписокЗначений;
		
		Если ИмяКолонки = "ТипДокумента" Тогда
			
			ВсеНастройкиДокументов = МодульОбъекта().НастройкиДокументовУчета_ВсеЭлементы();
			
			Для Каждого НастройкаДокумента Из ВсеНастройкиДокументов Цикл
				Список.Добавить(НастройкаДокумента);
			КонецЦикла;
			
			Список.СортироватьПоПредставлению();
			ПолеНабора.УстановитьДоступныеЗначения(Список);
			
		ИначеЕсли ИмяКолонки = "Статус" Тогда
			
			ЗаполнитьСписокВыбора(Список, МодульОбъекта().Перечисление_СтатусыДокументовУчета());
			ПолеНабора.УстановитьДоступныеЗначения(Список);
			
		ИначеЕсли ИмяКолонки = "ТребуемоеДействие" Тогда
			
			ЗаполнитьСписокВыбора(Список, МодульОбъекта().Перечисление_ТребуемыеДействияДокументовУчета());
			ПолеНабора.УстановитьДоступныеЗначения(Список);
			
		ИначеЕсли ИмяКолонки = "ТипПоследнейОперации" Тогда
			
			ЗаполнитьСписокВыбора(Список, МодульОбъекта().Перечисление_ТипыОпераций());
			ПолеНабора.УстановитьДоступныеЗначения(Список);
			
		ИначеЕсли ИмяКолонки = "СтатусПоследнейОперации" Тогда
			
			ЗаполнитьСписокВыбора(Список, МодульОбъекта().Перечисление_СтатусыОпераций());
			ПолеНабора.УстановитьДоступныеЗначения(Список);
			
		ИначеЕсли ИмяКолонки = "Документ1С" Тогда
			
			ПолеНабора.Заголовок = "Документ 1С";
			
		КонецЕсли;
		
		ТаблицаДокументов_ДобавитьЭлементОтбора(ИмяКолонки, МакетОтбора);
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ТаблицаДокументов_УстановитьОтборыДопКолонок(ПоляНабора, МакетОтбора)
	
	НастройкиДопКолонок = МодульОбъекта().НастройкиДополнительныхКолонокСпискаДокументов();
	
	Для Каждого Настройка Из НастройкиДопКолонок Цикл
		
		Если Не МодульОбъекта().СтрокаНачинаетсяС(Настройка.Ключ, "ДопКолонка")
			Или Не Настройка.Значение.Видимость Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяКолонки = Настройка.Ключ;
		
		ПолеНабора = ПоляНабора.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ПолеНабора.Поле = ИмяКолонки;
		ПолеНабора.ПутьКДанным = ИмяКолонки;
		ПолеНабора.Заголовок = Настройка.Значение.Заголовок;
		ПолеНабора.ТипЗначения = Новый ОписаниеТипов(Настройка.Значение.ТипКолонки);
		
		ТаблицаДокументов_ДобавитьЭлементОтбора(ИмяКолонки, МакетОтбора);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ТаблицаОтборов_ДобавитьПоле_НомерСтроки(Настройки, ПоляНабора)
	
	НовПоле = ПоляНабора.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
	НовПоле.Поле 		= "НомерСтроки";
	НовПоле.ПутьКДанным	= "НомерСтроки";
	НовПоле.Заголовок	= "НомерСтроки";
	НовПоле.ТипЗначения	= Новый ОписаниеТипов("Число");
	
	ГруппировкаСтрока 				= Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ГруппировкаСтрока.Использование = Истина;
	
	ПолеСтрока = ГруппировкаСтрока.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеСтрока.Использование = Истина;
	ПолеСтрока.Поле = Новый ПолеКомпоновкиДанных("НомерСтроки");
	
	ВыбранныеПоляДляСтроки = ГруппировкаСтрока.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	ВыбранныеПоляДляСтроки.Использование = Истина;
	
	ПорядокДляСтроки = ГруппировкаСтрока.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	ПорядокДляСтроки.Использование = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ТаблицаДокументов_ДобавитьЭлементОтбора(ИмяКолонки, МакетОтбора)
	
	ЭлементОтбора = МакетОтбора.НастройкиПоУмолчанию.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ВидСравнения  = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяКолонки);
	ЭлементОтбора.Использование = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьКомандыМенюОтборов()
	
	Действие = "СписокДокументов_УстановитьПользовательскийОтбор";
	ГруппаКнопок = Элементы.ГруппаКнопок_ПользовательскиеОтборыСпискаДокументов;
	
	СохраненныеОтборы = МодульОбъекта().СписокСохраненныхОтборовБезСлужебных();
	
	Для Сч = 0 По МодульОбъекта().МаксимальноеКоличествоСохраненныхОтборов() - 1 Цикл
		
		ИмяКнопки =МодульОбъекта().ПараметрыВСтроку(НСтр("ru = 'СохраненныйОтбор_%1'"), Сч);
		
		КомандаКнопки = Команды.Найти(ИмяКнопки);
		Кнопка = Элементы.Найти(ИмяКнопки);
		
		Если КомандаКнопки = Неопределено Тогда
			
			КомандаКнопки = Команды.Добавить(ИмяКнопки);
			КомандаКнопки.Действие = Действие;
			
			Кнопка = Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), ГруппаКнопок);
			Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
			Кнопка.ИмяКоманды = ИмяКнопки;
			
		КонецЕсли;
		
		Кнопка.Видимость = Ложь;
		
		Если СохраненныеОтборы.Количество() > Сч Тогда
			СохраненныйОтбор = СохраненныеОтборы[Сч];
			КомандаКнопки.Заголовок = СохраненныйОтбор.Значение;
			Кнопка.Видимость = Истина
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДокументов_УстановитьПользовательскийОтбор(Команда)
	
	ПрименитьОтборСпискаДокументов(ЗаголовокКоманды(Команда.Имя));
	
КонецПроцедуры

&НаСервере
Функция ЗаголовокКоманды(ИмяКоманды)
	
	Команда = Команды.Найти(ИмяКоманды);
	
	Возврат Команда.Заголовок;
	
КонецФункции

&НаСервере
Процедура ВосстановитьНастройкуОтбораСКД()
	
	Если Не ЗначениеЗаполнено(ТекущийОтборСпискаДокументов) Тогда
		ТекущийОтборСпискаДокументов = ДействующийОтборСпискаДокументов();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущийОтборСпискаДокументов) Тогда
		МодульОбъекта().ВосстановитьНастройкуОтбораСКД(ТекущийОтборСпискаДокументов, КомпоновщикНастроек)
	Иначе
		СхемаСКД = ПолучитьИзВременногоХранилища(АдресСхемыСКД);
		КомпоновщикНастроек.ЗагрузитьНастройки(СхемаСКД.НастройкиПоУмолчанию);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДействующийОтборСпискаДокументов()
	
	Возврат МодульОбъекта().ДействующийОтборСпискаДокументов();

КонецФункции

// #КонецОбласти //ОтборыСпискаДокументов

// Дополнительные кнопки

&НаСервере
Процедура СформироватьДополнительныеКнопки()
	
	РазмещенияКнопок = МодульОбъекта().Перечисление_РазмещениеДополнительныхКнопок();
	
	Действие = "СписокДокументов_ДополнительнаяКнопкаНажатие";
	ГруппаКнопок = Элементы.ГруппаДопКнопокСпискаДокументов;
	НастройкиКнопок = МодульОбъекта().НастройкиДополнительныхКнопок(РазмещенияКнопок.ОсновнаяФормаСписокДокументов);
	МодульОбъекта().ДобавитьНаФормуДополнительныеКнопки(ЭтаФорма, НастройкиКнопок, ГруппаКнопок, Действие);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДокументов_ДополнительнаяКнопкаНажатие(Команда)
	
	РазмещенияКнопок = МодульКлиента().Перечисление_РазмещениеДополнительныхКнопок();
	
	ПараметрыНажатия = МодульКлиента().Новый_ПараметрыНажатияДопКнопки();
	ПараметрыНажатия.Размещение = РазмещенияКнопок.ОсновнаяФормаСписокДокументов;
	ПараметрыНажатия.ВызывающаяФорма = ЭтаФорма;
	
	Для каждого Ид Из Элементы.СписокДокументовУчета.ВыделенныеСтроки Цикл
		
		Строка = СписокДокументовУчета.НайтиПоИдентификатору(Ид);
		
		Если ЗначениеЗаполнено(Строка.ДокументУчета) Тогда
			ПараметрыНажатия.ДопСведения.ВыбранныеДокументы.Добавить(Строка.ДокументУчета);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Строка.Документ1С) Тогда
			ПараметрыНажатия.ДопСведения.ВыбранныеДокументы1С.Добавить(Строка.Документ1С);
		КонецЕсли;
		
	КонецЦикла;
	
	МодульКлиента().ПриНажатииДополнительнойКнопки(ПараметрыНажатия, Команда);
	
КонецПроцедуры

