
&НаКлиенте
Перем КэшМодуляКлиента;

&НаСервере
Функция МодульОбъекта()
	
	Возврат ВзаимодействиеКонтурМаркировка.МодульКонтурМаркировка();
	
КонецФункции

&НаКлиенте
Функция МодульКлиента() Экспорт
	
	Если КэшМодуляКлиента <> Неопределено Тогда
		Возврат КэшМодуляКлиента;
	КонецЕсли;
	
	Если ТипЗнч(ВладелецФормы) = ТипЗнч(ЭтаФорма) Тогда
		Результат = ВладелецФормы.МодульКлиента();
	Иначе
		ПутьКФорме = ПутьКФормеМодуляКлиента();
		Результат = ОткрытьФорму(ПутьКФорме);
	КонецЕсли;
	
	КэшМодуляКлиента = Результат;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПутьКФормеМодуляКлиента()
	
	Возврат МодульОбъекта().ПутьКФормеМодуляКлиента();
	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьФорму();
	
	ТекущаяСтраница = Параметры.ТекущаяСтраница;
	Если ТекущаяСтраница = "НастройкиДокументовУчета" Тогда
		Элементы.Закладки.ТекущаяСтраница = Элементы.Закладка_НастройкиДокументовУчета;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ ВладелецФормы = Неопределено Тогда
		Если Найти(ВладелецФормы.ИмяФормы,"Форма_ШаблонЭтикетки")>0 Тогда
			Элементы.Закладки.ТекущаяСтраница = Элементы.Закладка_ПараметрыЭтикеток;
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьСтатусОчисткиУстаревшихДанных();
	ОбновитьНадписьРасписанияОчисткиУстаревшихДанных();
	ОбновитьСтатусВыполненияРегламентныхДействий();
	ОбновитьНадписьРасписаниеРегламентныхДействий();
	ОбновитьНадписьРасписаниеОбновленияМодуля();
	ОбновитьОписаниеСортировкиЭтикеток();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	МодульКлиента().СохранитьИзмененияНаФорме("ЗаписатьИЗакрыть", ЭтаФорма, Отказ, ЗавершениеРаботы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурМаркировка_НастройкаДокументаУчета_Изменен" Тогда
		ОбновитьНастройкиДокументовУчета();
	КонецЕсли;
	
	Если ИмяСобытия = "КонтурМаркировка_НастройкиМодуля_Обновлены" И Источник <> ЭтаФорма Тогда
		ЗаполнитьФорму();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ВариантыРасположения = МодульОбъекта().Перечисление_ВариантыРасположенияОбработки();
	
	Если Прокси_Использовать Тогда
		ПроверяемыеРеквизиты.Добавить("Прокси_Адрес");
		ПроверяемыеРеквизиты.Добавить("Прокси_Порт");
		Если ЗначениеЗаполнено(Прокси_Логин) Тогда
			ПроверяемыеРеквизиты.Добавить("Прокси_Пароль");
		КонецЕсли;
	КонецЕсли;
	
	Если ПМ_Использовать Тогда
		Если ПМ_Расположение = ВариантыРасположения.НаДиске Тогда
			ПроверяемыеРеквизиты.Добавить("ПМ_Путь");
		ИначеЕсли ПМ_Расположение = ВариантыРасположения.ВСправочнике Тогда
			ПроверяемыеРеквизиты.Добавить("ПМ_Ссылка");
		ИначеЕсли ПМ_Расположение = ВариантыРасположения.ВКонфигурации Тогда
			ПроверяемыеРеквизиты.Добавить("ПМ_ИмяОбработки");
		Иначе
			ПроверяемыеРеквизиты.Добавить("ПМ_Расположение");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСлужебныеНастройки(Команда)
	
	Элементы.Закладка_СлужебныеНастройки.Видимость = Истина;
	
	Элементы.Закладки.ТекущаяСтраница = Элементы.Закладка_СлужебныеНастройки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда = Неопределено, ДопПараметры = Неопределено) Экспорт
	
	Если ЗаписатьНастройки() Тогда
		ПровестиОпросПользователяИЗакрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЗаписатьНастройки()
	
	Если Не ПроверитьЗаполнение()
		Или Не ПроверитьПодключениеПМ()
		Или Не ПроверитьЗаполнениеРеквизитов() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОписаниеНастроек = ОписаниеНастроекПоКонтексту();
	
	МодульКлиента().НастройкиМодуля_Записать(ОписаниеНастроек, ЭтаФорма);
	
	Если ОбновленаПериодичностьОчисткиУстаревшихДанных Тогда
		СохранитьПериодичностьОчисткиУстаревшихДанных();
	КонецЕсли;
	
	Если ОбновленоРасписаниеРегламентныхДействий
		Или ОбновленоИмяПользователяДляЗапускаРегламентныхДействий Тогда
		СохранитьПараметрыРегламентныхДействий();
	КонецЕсли;

	Если ОбновленоРасписаниеОбновленияМодуля Тогда
		СохранитьРасписаниеОбновленияМодуля();
	КонецЕсли;
	
	Если ИзмененыМаркируемыеТоварныеГруппы Тогда
		СохранитьМаркируемыеТоварныеГруппы();
	КонецЕсли;
	
	Модифицированность = Ложь;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура СохранитьПериодичностьОчисткиУстаревшихДанных()
	
	ПериодичностьЗаданий = МодульОбъекта().Перечисление_ПериодичностьВыполненияЗаданий();
	ИспользоватьЗадание = (ПериодичностьОчисткиУстаревшихДанных = ПериодичностьЗаданий.ПоРасписанию);
	МодульОбъекта().ОбновитьЗаданиеОчисткиУстаревшихДанных(ИспользоватьЗадание, РасписаниеОчисткиУстаревшихДанных);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьПараметрыРегламентныхДействий()
	
	МодульОбъекта().ОбновитьЗаданиеВыполнитьРегламентныеДействия(РасписаниеРегламентныхДействий, ИмяПользователяДляЗапускаРегламентныхДействий);
	ОбновленоРасписаниеРегламентныхДействий = Ложь;
	ОбновленоИмяПользователяДляЗапускаРегламентныхДействий = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьРасписаниеОбновленияМодуля()
	
	МодульОбъекта().ОбновитьЗаданиеОбновлениеМодуля(РасписаниеОбновленияМодуля, ОбновлятьАвтоматически);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьМаркируемыеТоварныеГруппы()
	
	МассивМаркируемыхТГ = Новый Массив;
	
	Для каждого Стр Из МаркируемыеТоварныеГруппы Цикл
		МаркируемаяТГ = МодульОбъекта().Новый_МаркируемаяТоварнаяГруппа();
		ЗаполнитьЗначенияСвойств(МаркируемаяТГ, Стр);
		МассивМаркируемыхТГ.Добавить(МаркируемаяТГ);
	КонецЦикла;
	
	МодульОбъекта().МаркируемыеТоварныеГруппы_ПерезаписатьНастройки(МассивМаркируемыхТГ);
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьПодключениеПМ()
	
	Результат = Истина;
	
	Если ПМ_Использовать Тогда
		Результат = ПроверитьПодключениеПМНаСервере(ОписаниеНастроекПоКонтексту());
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПроверитьПодключениеПМНаСервере(Настройки)
	
	Возврат МодульОбъекта().ПМ_ПроверитьПодключение(Настройки);
	
КонецФункции

&НаСервере
Функция ОписаниеНастроекПоКонтексту()
	
	Результат = МодульОбъекта().НастройкиМодуля();
	ЗаполнитьЗначенияСвойств(Результат, ЭтаФорма);
	
	Результат.ДопПараметрыПечатиШаблонаЭтикеток.Очистить();
	Для Каждого Стр Из ДопПараметрыЭтикеток Цикл
		ДопПараметр = Новый Структура("Имя,Формула", Стр.Имя, Стр.Формула);
		Результат.ДопПараметрыПечатиШаблонаЭтикеток.Добавить(ДопПараметр);
	КонецЦикла;
	
	Результат.ПМ_ДопПараметры.Очистить();
	Результат.ПМ_БезопасныеДопПараметры.Очистить();
	Для Каждого Стр Из ДопПараметрыПМ Цикл
		Если Стр.ЭтоБезопасноеЗначение Тогда
			Результат.ПМ_БезопасныеДопПараметры.Вставить(Стр.Ключ, Стр.БезопасноеЗначение);
		Иначе
			Результат.ПМ_ДопПараметры.Вставить(Стр.Ключ, Стр.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Если РежимРИБ Тогда
		ЗаполнитьЗначенияСвойств(Результат.НастройкиУзлаРИБ, ЭтаФорма);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьФорму()
	
	ЗаполнитьКонтекстФормы();
	НастроитьТипыЭлементовФормы();
	НастроитьЭлементыФормы(ЭтаФорма, МодульОбъекта());
	НастроитьГруппуПериодичностиОчистки();
	ПоказатьОбработкуВыполненияФоновыхЗаданий82();
	ЗаполнитьСпискиВыбораЭлементовФормы();
	ОбновитьНастройкиДокументовУчета();
	ОбновитьМаркируемыеТоварныеГруппы();
	ЗаполнитьИнструкциюКакПисатьФормулу();
	СкрытьЗакладкуСлужебныхНастроек();
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКонтекстФормы()
	
	ОбновитьКэш = Истина;
	Настройки = МодульОбъекта().НастройкиМодуля(ОбновитьКэш);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Настройки);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Настройки.НастройкиУзлаРИБ);
	
	ДопПараметрыПечатиШаблонаЭтикеток = Настройки.ДопПараметрыПечатиШаблонаЭтикеток;
	Если ТипЗнч(ДопПараметрыПечатиШаблонаЭтикеток) = Тип("Массив") Тогда
		Для Каждого Стр Из ДопПараметрыПечатиШаблонаЭтикеток Цикл
			НоваяСтрока = ДопПараметрыЭтикеток.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		КонецЦикла;
	КонецЕсли;
	
	ЗаполнитьТаблицуДопПараметрыПМ(Настройки.ПМ_ДопПараметры, Настройки.ПМ_БезопасныеДопПараметры);
	
	ОписаниеДоработокМодуля = МодульОбъекта().ОписаниеДоработокМодуля();
	РасписаниеОчисткиУстаревшихДанных = МодульОбъекта().РасписаниеОчисткиУстаревшихДанных();
	РасписаниеРегламентныхДействий = МодульОбъекта().РасписаниеРегламентныхДействий();
	ИмяПользователяДляЗапускаРегламентныхДействий = МодульОбъекта().ИмяПользователяДляЗапускаРегламентныхДействий();
	РасписаниеОбновленияМодуля = МодульОбъекта().РасписаниеОбновленияМодуля();
	ИдентификаторИнформационнойБазы = МодульОбъекта().ИдентификаторИнформационнойБазы();
	ЭтоГлавныйУзел = ПланыОбмена.ГлавныйУзел() = Неопределено;
	
	Модифицированность = Ложь;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьЭлементыФормы(Форма, МодульОбработки)
	
	Элементы		 = Форма.Элементы;
	ПМ_Расположение	 = Форма.ПМ_Расположение;
	ПМ_Использовать	 = Форма.ПМ_Использовать;
	Прокси_Использовать = Форма.Прокси_Использовать;
	
	ВариантыРасположения = МодульОбработки.Перечисление_ВариантыРасположенияОбработки();
	
	Элементы.ПМ_Путь.Видимость = (ПМ_Расположение = ВариантыРасположения.НаДиске);
	Элементы.ПМ_Ссылка.Видимость = (ПМ_Расположение = ВариантыРасположения.ВСправочнике);
	Элементы.ПМ_ИмяОбработки.Видимость = (ПМ_Расположение = ВариантыРасположения.ВКонфигурации);
	Элементы.Группа_РасположениеПМ.Доступность = ПМ_Использовать;
	Элементы.Группа_ДопПараметрыПМ.Доступность = ПМ_Использовать;
	
	Элементы.МаркируемыеТоварныеГруппыВидПродукции1С.Видимость = Форма.ОпределенТипВидовПродукции1С;
	
	Элементы.Группа_НастройкиПрокси.Доступность = Прокси_Использовать;
	
	МодульДоработан = ЗначениеЗаполнено(Форма.ОписаниеДоработокМодуля);
	Элементы.Закладка_ОписаниеДоработокМодуля.Видимость = МодульДоработан;
	
	Элементы.АдресТестовогоСервиса.Доступность = Форма.ТестовоеОкружение;
	
	НастроитьЗакладкуОчисткиУстаревшихДанных(Форма, МодульОбработки);
	
	ИспользоватьПлагины = Форма.ИспользоватьПлагины;
	Элементы.ОткрытьСписокПлагинов.Видимость = ИспользоватьПлагины;
	
	РежимОтладки = Форма.РежимОтладки;
	Элементы.КаталогОтладки.Видимость = РежимОтладки;
	Элементы.Кнопка_ВыгрузитьВложенныеОбработки.Видимость = РежимОтладки;
	Элементы.ОписаниеВыгрузкиОбработок.Видимость = РежимОтладки;
	
	Элементы.НадписьРасписаниеОбновленияМодуля.Видимость = Форма.ОбновлятьАвтоматически;
	
	Элементы.ГруппаРИБ.Доступность = Форма.РежимРИБ;
	Элементы.РазрешитьОбменПоВсемОбъектамВГлавномУзле.Доступность = Форма.ЭтоГлавныйУзел;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписьРасписанияОчисткиУстаревшихДанных()
	
	Элементы.НадписьРасписанияОчисткиУстаревшихДанных.Заголовок = Строка(РасписаниеОчисткиУстаревшихДанных);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписьРасписаниеРегламентныхДействий()
	
	Элементы.НадписьРасписаниеРегламентныхДействий.Заголовок = Строка(РасписаниеРегламентныхДействий);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписьРасписаниеОбновленияМодуля()
	
	Элементы.НадписьРасписаниеОбновленияМодуля.Заголовок = Строка(РасписаниеОбновленияМодуля);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьКнопкуВыполненияРегламентныхДействий(РегламентныеДействияВыполняются)
	
	Кнопка = Элементы.Кнопка_ВыполнитьРегламентныеДействия;
	
	Если РегламентныеДействияВыполняются Тогда
		Кнопка.Заголовок = НСтр("ru = 'Выполняются регламентные действия...'");
		Кнопка.Доступность = Ложь;
	Иначе
		Кнопка.Заголовок = НСтр("ru = 'Выполнить регламентные действия'");
		Кнопка.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьКнопкуОчисткиУстаревшихДанных(ОчисткаДанныхВыполняется)
	
	Кнопка = Элементы.Кнопка_ОчисткиУстаревшихДанных;
	
	Если ОчисткаДанныхВыполняется Тогда
		Кнопка.Заголовок = НСтр("ru = 'Выполняется удаление...'");
		Кнопка.Доступность = Ложь;
	Иначе
		Кнопка.Заголовок = НСтр("ru = 'Удалить устаревшие данные сейчас'");
		Кнопка.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьТипыЭлементовФормы()
	
	ТипыОбъектов = МодульОбъекта().ТипыОбъектовИС();
	
	Если ЗначениеЗаполнено(ТипыОбъектов.ВнешняяОбработка) Тогда
		МодульОбъекта().УстановитьОграничениеПоТипу(Элементы.ПМ_Ссылка, ТипыОбъектов.ВнешняяОбработка);
	КонецЕсли;
	
	ТипВидПродукции = ТипыОбъектов.ВидПродукции;
	Если ЗначениеЗаполнено(ТипВидПродукции) Тогда
		ОпределенТипВидовПродукции1С = Истина;
		МодульОбъекта().УстановитьОграничениеПоТипу(Элементы.МаркируемыеТоварныеГруппыВидПродукции1С, ТипВидПродукции);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокЗначениямиПеречисления(Список,СтруктураПеречисления)
	
	Список.Очистить();
	
	Для Каждого Зн Из СтруктураПеречисления Цикл
		Список.Добавить(Зн.Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиВыбораЭлементовФормы()
	
