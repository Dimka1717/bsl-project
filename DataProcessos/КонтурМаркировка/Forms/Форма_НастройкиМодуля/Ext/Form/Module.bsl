&НаСервере
Процедура ДопПараметрыПМЗаполнитьНаСервере()
	
	Если Не ПМ_Использовать
		Или Не ЗаполненПутьКФайлуПМ() Тогда
		Возврат;
	КонецЕсли;
	
	Настройки = ОписаниеНастроекПоКонтексту();
	
	ПМ_ДопПараметры = МодульОбъекта().ПМ_ДополнительныеПараметры(Настройки);
	МодульОбъекта().ЗаполнитьПоляСтруктуры(ПМ_ДопПараметры, Настройки.ПМ_ДопПараметры);
	
	ПМ_БезопасныеДопПараметры = МодульОбъекта().ПМ_БезопасныеДополнительныеПараметры(Настройки);
	МодульОбъекта().ЗаполнитьПоляСтруктуры(ПМ_БезопасныеДопПараметры, Настройки.ПМ_БезопасныеДопПараметры);
	
	ЗаполнитьТаблицуДопПараметрыПМ(ПМ_ДопПараметры, ПМ_БезопасныеДопПараметры);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуДопПараметрыПМ(ДопПараметры, БезопасныеДопПараметры)
	
	ДопПараметрыПМ.Очистить();
	
	Для Каждого Элемент Из ДопПараметры Цикл
		ЗаполнитьЗначенияСвойств(ДопПараметрыПМ.Добавить(), Элемент);
	КонецЦикла;
	
	Для Каждого Элемент Из БезопасныеДопПараметры Цикл
		Стр = ДопПараметрыПМ.Добавить();
		Стр.Ключ = Элемент.Ключ;
		Стр.БезопасноеЗначение = Элемент.Значение;
		Стр.ЭтоБезопасноеЗначение = Истина;
	КонецЦикла;
	
	ДопПараметрыПМ.Сортировать("Ключ");
	
КонецПроцедуры

