	ПроверитьМаркируемыеТоварныеГруппы(ЕстьОшибки);
	ПроверитьПараметрыОчисткиУстаревшихДанных(ЕстьОшибки);
	ПроверитьВидПродукции1С(ЕстьОшибки);
	ПроверитьНастройкиРИБ(ЕстьОшибки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНастройкиДопКолонок(ЕстьОшибки)
	
	ШаблонОшибки = НСтр("ru = 'Неверный тип колонки: %1'");
	
	Если ДопКолонка1_Видимость 
		И ЗначениеЗаполнено(ДопКолонка1_ТипКолонки)
		И Не ПроверитьТипДопКолонки(ДопКолонка1_ТипКолонки) Тогда
		ТекстСообщения = МодульКлиента().ПараметрыВСтроку(ШаблонОшибки, ДопКолонка1_ТипКолонки);
		МодульКлиента().СообщитьПользователюЛок(ТекстСообщения, УникальныйИдентификатор, "ДопКолонка1_ТипКолонки");
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если ДопКолонка2_Видимость 
		И ЗначениеЗаполнено(ДопКолонка2_ТипКолонки)
		И Не ПроверитьТипДопКолонки(ДопКолонка2_ТипКолонки) Тогда
		ТекстСообщения = МодульКлиента().ПараметрыВСтроку(ШаблонОшибки, ДопКолонка2_ТипКолонки);
		МодульКлиента().СообщитьПользователюЛок(ТекстСообщения, УникальныйИдентификатор, "ДопКолонка2_ТипКолонки");
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если ДопКолонка3_Видимость 
		И ЗначениеЗаполнено(ДопКолонка3_ТипКолонки)
		И Не ПроверитьТипДопКолонки(ДопКолонка3_ТипКолонки) Тогда
		ТекстСообщения = МодульКлиента().ПараметрыВСтроку(ШаблонОшибки, ДопКолонка3_ТипКолонки);
		МодульКлиента().СообщитьПользователюЛок(ТекстСообщения, УникальныйИдентификатор, "ДопКолонка3_ТипКолонки");
		ЕстьОшибки = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьМаркируемыеТоварныеГруппы(ЕстьОшибки)
	
	ТекстОшибки = НСтр("ru = 'Необходимо заполнить вид продукции.'");
	Для каждого Стр Из МаркируемыеТоварныеГруппы Цикл
		Если Не ЗначениеЗаполнено(Стр.ВидПродукции) Тогда
			МодульКлиента().СообщитьОбОшибкеВСтрокеТабЧасти(ТекстОшибки
			, УникальныйИдентификатор, Элементы.МаркируемыеТоварныеГруппы
			, "ВидПродукции", МаркируемыеТоварныеГруппы.Индекс(Стр));
			ЕстьОшибки = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьУникальностьМаркируемыхТоварныхГрупп(ЕстьОшибки)
	
	ШаблонОшибки = НСтр("ru = 'Удалите дублируемый вид продукции в таблице маркируемых товаров: %1'");
	
	Для каждого Стр Из МаркируемыеТоварныеГруппы Цикл
		
		ВидПродукции = Стр.ВидПродукции;
		
		ПараметрыОтбора = Новый Структура("ВидПродукции", ВидПродукции);
		НайденныеСтроки = МаркируемыеТоварныеГруппы.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() > 1 Тогда
			ТекстОшибки = МодульКлиента().ПараметрыВстроку(ШаблонОшибки, ВидПродукции);
			МодульКлиента().СообщитьОбОшибкеВСтрокеТабЧасти(ТекстОшибки
				, УникальныйИдентификатор, Элементы.МаркируемыеТоварныеГруппы
				, "ВидПродукции", МаркируемыеТоварныеГруппы.Индекс(Стр));
			ЕстьОшибки = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПараметрыОчисткиУстаревшихДанных(ЕстьОшибки)
	
	МинимальныйСрокЖизниКода = 30;
	Если ПериодУдаленияКодовДляПечатиДоАннулирования > МинимальныйСрокЖизниКода Тогда
		ЕстьОшибки = Истина;
		Поле = "ПериодУдаленияКодовДляПечатиДоАннулирования";
		ТекстОшибки = НСтр("ru = 'Удалять коды для печати можно не раньше чем за 29 дней до аннулирования ГИС МТ'");
		МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, Поле);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВидПродукции1С(ЕстьОшибки)
	
	ТекстОшибки = НСтр("ru = 'Необходимо заполнить вид продукции 1С.'");
	
	ЕстьЗаполненныйВидПродукции1С = Ложь;
	Для Каждого Стр Из МаркируемыеТоварныеГруппы Цикл
		Если ЗначениеЗаполнено(Стр.ВидПродукции1С) Тогда
			ЕстьЗаполненныйВидПродукции1С = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьЗаполненныйВидПродукции1С Тогда
		Для Каждого Стр Из МаркируемыеТоварныеГруппы Цикл
			Если Не ЗначениеЗаполнено(Стр.ВидПродукции1С) Тогда
				МодульКлиента().СообщитьОбОшибкеВСтрокеТабЧасти(ТекстОшибки
				, УникальныйИдентификатор, Элементы.МаркируемыеТоварныеГруппы
				, "ВидПродукции1С", МаркируемыеТоварныеГруппы.Индекс(Стр));
				ЕстьОшибки = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНастройкиРИБ(ЕстьОшибки)
	
	Если Не РежимРИБ Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПланОбмена) Тогда
		ЕстьОшибки = Истина;
		ТекстОшибки = НСтр("ru = 'Необходимо заполнить план обмена'");
		Поле = "ПланОбмена";
		МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, Поле);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Узел) Тогда
		ЕстьОшибки = Истина;
		ТекстОшибки = НСтр("ru = 'Необходимо заполнить узел плана обмена'");
		Поле = "Узел";
		МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, Поле);
	КонецЕсли;
	
	КодУзла = МодульКлиента().ЗначениеРеквизитаОбъекта_Марк(Узел, "Код");
	Если Не ЗначениеЗаполнено(КодУзла) Тогда
		ЕстьОшибки = Истина;
		ТекстОшибки = НСтр("ru = 'Необходимо заполнить код узла плана обмена'");
		Поле = "Узел";
		МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, Поле);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПрефиксИБ) Тогда
		ЕстьОшибки = Истина;
		ТекстОшибки = НСтр("ru = 'Необходимо заполнить префикс информационной базы'");
		Поле = "ПрефиксИБ";
		МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, Поле);
	КонецЕсли;
	
КонецПроцедуры

