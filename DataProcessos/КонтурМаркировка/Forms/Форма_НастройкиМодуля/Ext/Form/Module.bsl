	ЗаполнитьСписокВыбораИмяПользователяДляЗапускаРегламентныхДействий();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораРасположенияПМ()
	
	ВариантыРасположения = МодульОбъекта().Перечисление_ВариантыРасположенияОбработки();
	
	СписокВыбора = Элементы.ПМ_Расположение.СписокВыбора;
	
	ЗначенияСписка = Новый СписокЗначений;
	ЗначенияСписка.Добавить(ВариантыРасположения.НаДиске);
	ЗначенияСписка.Добавить(ВариантыРасположения.ВСправочнике);
	ЗначенияСписка.Добавить(ВариантыРасположения.ВКонфигурации);
	
	МодульОбъекта().ЗаполнитьСписокВыбора(СписокВыбора, ЗначенияСписка);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораАдресаТестовогоСервиса()
	
	Адреса = МодульОбъекта().ИнтернетАдреса();
	СписокВыбора = Элементы.АдресТестовогоСервиса.СписокВыбора;
	СписокВыбора.Добавить("", Адреса.СервисКонтурМаркировкаТестовый);
	
	Для каждого Эл Из Адреса Цикл
		Если Найти(Эл.Ключ, "СервисКонтурМаркировкаТестовый") > 0
			И Эл.Значение <> Адреса.СервисКонтурМаркировкаТестовый Тогда
			СписокВыбора.Добавить(Эл.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

