// Выполнение регламентных действий

&НаКлиенте
Процедура ВыполнитьРегламентныеДействия(Команда)
	
	ЗапускатьРегламентныеДействияВФоновомРежиме = (РежимЗапускаРегламентныхДействий = 0);
	
	Если ЗапускатьРегламентныеДействияВФоновомРежиме Тогда

		Если ОбновленоИмяПользователяДляЗапускаРегламентныхДействий Тогда
			ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
			"ВыполнитьРегламентныеДействияВФоновомРежиме_ПослеСогласия", ЭтаФорма);
			
			ТекстВопроса = НСтр("ru = 'Было изменено имя пользователя для запуска регламентных действий. Сохранить настройки перед запуском?'");
			МодульКлиента().ПоказатьДиалогВопроса(ОписаниеОбработчика, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
			
		Иначе
			ВыполнитьРегламентныеДействияВФоновомРежиме_ПослеСогласия(КодВозвратаДиалога.Да);
		КонецЕсли;
		
	Иначе
		
		ВыполнитьРегламентныеДействияВТекущемСеансеНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьЭлементыФормы_ВыполнитьРегламентныеДействия()

	ЗапускатьРегламентныеДействияВФоновомРежиме = (РежимЗапускаРегламентныхДействий = 0);
	
	Если ЗапускатьРегламентныеДействияВФоновомРежиме Тогда
		Элементы.ГруппаВыполнениеРегламентныхДействийПараметры.Видимость = Истина;
		Элементы.Кнопка_ВыполнитьРегламентныеДействия.РасширеннаяПодсказка.Заголовок = "Событие будет вызвано в фоновом режиме";
	Иначе
		Элементы.ГруппаВыполнениеРегламентныхДействийПараметры.Видимость = Ложь;
		Элементы.Кнопка_ВыполнитьРегламентныеДействия.РасширеннаяПодсказка.Заголовок = "Событие будет вызвано в текущем сеансе пользователя";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РежимЗапускаРегламентныхДействийПриИзменении(Элемент)

	НастроитьЭлементыФормы_ВыполнитьРегламентныеДействия();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРегламентныеДействияВФоновомРежиме_ПослеСогласия(Ответ, ДопПараметры = Неопределено) Экспорт

	Если Ответ = КодВозвратаДиалога.Да
		Или Ответ = КодВозвратаДиалога.Нет Тогда
		
		Если Ответ = КодВозвратаДиалога.Да Тогда
			ЗаписатьНастройки();
		КонецЕсли;
		
		ВыполнитьРегламентныеДействияВФоновомРежимеНаСервере();
		ОбновитьСтатусВыполненияРегламентныхДействий();
	КонецЕсли;
	
КонецПроцедуры

