&НаКлиенте
Процедура ПМ_ИмяОбработкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ЗначенияСписка = МодульКлиента().СписокОбработокВСоставеКонфигурации();
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("ПМ_ИмяОбработки_ПослеВыбора", ЭтаФорма);
	
	Если ЗначениеЗаполнено(ПМ_ИмяОбработки) Тогда
		ТекЗначение = ПМ_ИмяОбработки;
	Иначе
		ТекЗначение = "КонтурМаркировкаПМ";
	КонецЕсли;
	
	МодульКлиента().ПоказатьДиалогВыбораИзСписка(ОписаниеОбработчика
	, ЗначенияСписка
	, Элемент
	, ЭтаФорма
	, ТекЗначение);
	
КонецПроцедуры

