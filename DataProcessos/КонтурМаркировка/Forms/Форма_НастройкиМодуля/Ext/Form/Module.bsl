		И Не ЗаписатьНастройки() Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	
	СписокФайлов = ВыгрузитьВсеВложенныеОбработкиВКаталогОтладки();
	Если Не ЗначениеЗаполнено(СписокФайлов) Тогда
		Возврат;
	КонецЕсли;
	
	МодульКлиента().СообщитьПользователюЛок(НСтр("ru = 'Записаны на диск:'"), УникальныйИдентификатор);
	Для каждого ПутьКФайлу Из СписокФайлов Цикл
		МодульКлиента().СообщитьПользователюЛок(ПутьКФайлу, УникальныйИдентификатор);
	КонецЦикла;
	
КонецПроцедуры

