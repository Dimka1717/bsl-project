
// #Область СлужебныеПеременныеИМетодыФормы

&НаКлиенте
Перем КэшМодуляКлиента;

&НаСервере
Функция МодульОбъекта()
	
	Возврат ВзаимодействиеКонтурМаркировка.МодульКонтурМаркировка();
	
КонецФункции

&НаКлиенте
Функция МодульКлиента() Экспорт
	
	Если КэшМодуляКлиента <> Неопределено Тогда
		Возврат КэшМодуляКлиента;
	КонецЕсли;
	
	Если ТипЗнч(ВладелецФормы) = ТипЗнч(ЭтаФорма) Тогда
		Результат = ВладелецФормы.МодульКлиента();
	Иначе
		ПутьКФорме = ПутьКФормеМодуляКлиента();
		Результат = ОткрытьФорму(ПутьКФорме);
	КонецЕсли;
	
	КэшМодуляКлиента = Результат;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПутьКФормеМодуляКлиента()
	
	Возврат МодульОбъекта().ПутьКФормеМодуляКлиента();
	
КонецФункции

// #КонецОбласти

// #Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВерсияПлагина = МодульОбъекта().СвойствоСтруктуры(Параметры, "ВерсияПлагина");
	ИдентификаторПлагина = МодульОбъекта().СвойствоСтруктуры(Параметры, "ИдентификаторПлагина");
	
	ОбновитьНастройкиДокументовУчета();
	ЗаполнитьДанныеДляПереносаКоэффициентовПересчета();
	НастроитьТипыЭлементовФормы();
	ЗаполнитьСписокВыбораВидМаркируемойПродукции();
	ОбновитьМаркируемыеТоварныеГруппы();

	Пользователь = МодульОбъекта().Пользователи_ТекущийПользователь();
	ЗаполнитьНастройкиОрганизаций();
	УстановитьОформлениеСписокОрганизаций();
	
	ПоказатьЭтап(ЭтапыСтартовогоПомощника().ПерваяСтраница);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ДанныеНастроек = ДанныеНастроекДляМетрики();
	ДанныеПлагина = ДанныеПлагинаДляМетрики();
	
	МодульКлиента().Метрики_БыстраяНастройка(ДанныеНастроек, ДанныеПлагина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурМаркировка_НастройкаДокументаУчета_Изменен" Тогда
		ОбновитьНастройкиДокументовУчета();
	КонецЕсли;
	
КонецПроцедуры
// #КонецОбласти

// #Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СертификатНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("СертификатПослеВыбора", ЭтаФорма);
	
	МодульКлиента().ОткрытьФормуВыбораСертификата(ОтпечатокСертификата
	, , ЭтаФорма
	, ОписаниеОбработчика);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиОрганизацийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Стр = Элемент.ДанныеСтроки(ВыбраннаяСтрока);
	
	Если Поле = Элементы.СписокОрганизацийСсылкаЗапуститьНастройку Тогда
		
		Организация1С = Стр.Организация1С;
		ИНН = Стр.ИНН;
		КПП = Стр.КПП;
		Организация = Стр.Организация;
		Идентификатор = Стр.Идентификатор;
		НаименованиеОрганизации = СокрЛП(Организация1С);
		Сертификат = Стр.Сертификат;
		
		Если ЗначениеЗаполнено(Организация) Тогда
			ЗаполнитьНастройкиСкладов();
		КонецЕсли;
		
		ПоказатьЭтап("НастройкаОрганизации");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Прокси_ИспользоватьПриИзменении(Элемент)
	
	УправлениеФормой();
	
КонецПроцедуры


// #КонецОбласти

// #Область КомандыФормы

&НаКлиенте
Процедура НачатьНастройку(Команда)
	
	Этапы = ЭтапыСтартовогоПомощника();
	ТекущийЭтап = Этапы.ПерваяСтраница;
	ПоказатьСледующийЭтап();
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаСледующийЭтап(Команда)
	
	СохранитьТекущиеНастройки();
	
	Если ЭтоПоследнийЭтап() Тогда
		НастройкаЗавершена = Истина;
		Закрыть();
		Возврат;
	КонецЕсли;
	
	ПоказатьСледующийЭтап();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбщиеНастройки(Команда)
	
	СохранитьТекущиеНастройки();
	ПоказатьСледующийЭтап();
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаПредыдущийЭтап(Команда)
	
	ПоказатьЭтап(ПредыдущийЭтап());
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИдентификаторИзСервиса(Команда)
	
	Если Не ЗначениеЗаполнено(Сертификат) Тогда
		ТекстОшибки = НСтр("ru = 'Необходимо выбрать сертификат.'");
		МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "СертификатГиперссылка");
		Возврат;
	КонецЕсли;
	
	ЗаписатьОрганизацию();
	ЗаписатьНастройкиПодписания();
	
	НовыйИдентификатор = МодульКлиента().Организация_ИдентификаторИзСервиса(Организация, ЭтаФорма);
	Модифицированность = (НовыйИдентификатор <> Идентификатор);
	Идентификатор = НовыйИдентификатор;
	
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;
	
	Организация_ЗаписатьИдентификатор();
	
	ОбновитьИнформациюОТарифах();
	
	Попытка
		СинхронизироватьСклады();
	Исключение
		ТекстСообщения = НСтр("ru = 'Не удалось выполнить синхронизацию складов. Подробности в журнале регистрации.'");
		МодульКлиента().СообщитьПользователюЛок(ТекстСообщения);
		Возврат;
	КонецПопытки;
	
	ЗаполнитьНастройкиСкладов();
	
	ЗаполнитьНастройкиОрганизаций();
	
	УправлениеФормой();
	
	Попытка
		СинхронизироватьСправочники();
	Исключение
		ТекстСообщения = НСтр("ru = 'Не удалось выполнить синхронизацию справочников. Подробности в журнале регистрации.'");
		МодульКлиента().СообщитьПользователюЛок(ТекстСообщения);
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодключение(Команда)
	
	ПроверитьПодключениеНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкиСети(Команда)
	
	ЗаполнитьНастройкиСети();
	ПоказатьЭтап(ЭтапыСтартовогоПомощника().НастройкиСети);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРегистр_КонтурМаркировкаОСУ_СведенияОбУпаковках(Команда)
	
	ОткрытьФорму("РегистрСведений.КонтурМаркировкаОСУ_СведенияОбУпаковках.ФормаСписка");
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокКоэффициентыПересчета(Команда)
	
	МодульКлиента().ОткрытьФормуСпискаКоэффициентовПересчета(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНастройкуДокумента(Команда)
	
	МодульКлиента().ОткрытьФормуНастройкиДокумента(Неопределено, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьНастройкуДокумента(Команда)
	
	ТекущиеДанные = Элементы.НастройкиДокументовУчета.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Настройка = ТекущиеДанные.Ссылка;
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
	"УдалитьНастройкуДокумента_ПослеСогласия", ЭтаФорма, Настройка);
	
	Если ЕстьДокументыПоТипу(Настройка) Тогда
		ТекстВопроса = НСтр("ru = 'По выбранной настройке есть документы. Продолжить?'");
	Иначе
		ТекстВопроса = НСтр("ru = 'Удалить настройку документа?'");
	КонецЕсли;
	
	МодульКлиента().ПоказатьДиалогВопроса(ОписаниеОбработчика, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаСервере
Функция ЕстьДокументыПоТипу(Настройка)
	
	ТипДокумента = МодульОбъекта().НастройкиДокументаУчета_Прочитать(Настройка).ТипДокумента;
	
	Возврат МодульОбъекта().НастройкиДокументовУчета_ЕстьДокументыПоТипу(ТипДокумента);
	
КонецФункции

&НаКлиенте
Процедура УдалитьНастройкуДокумента_ПослеСогласия(Ответ, Настройка) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		УдалитьНастройкуДокументаНаСервере(Настройка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьНастройкуДокументаНаСервере(Настройка)
	
	ОбъектНастройки = Настройка.ПолучитьОбъект();
	ОбъектНастройки.Удалить();
	
	ОбновитьНастройкиДокументовУчета();
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиВЛичныйКабинетКонтурМаркировка(Команда)
	
	МодульКлиента().ОткрытьЛичныйКабинетКонтурМаркировка();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСправкуКакДобавитьЯщикДиадок(Команда)
	
	МодульКлиента().ОткрытьСправкуКакДобавитьЯщикДиадок();
	
КонецПроцедуры

// #КонецОбласти

// #Область НастройкиОрганизации

&НаСервере
Процедура ЗаписатьОрганизацию()
	
	Организация = МодульОбъекта().Организация_НайтиПоИНН(ИНН);
	Если ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОрганизации = ОписаниеОрганизацииПоКонтекстуФормы();
	
	МодульОбъекта().Организация_Записать(ОписаниеОрганизации);
	
	Организация = ОписаниеОрганизации.Ссылка;
	
	Действие = МодульОбъекта().Перечисление_ДействияМетрики().ЗаписьВБазу;
	МодульОбъекта().Метрика_ОписаниеОрганизации(Действие, Организация);
	
КонецПроцедуры

&НаСервере
Процедура Организация_ЗаписатьИдентификатор()
	
	ОписаниеОрганизации = МодульОбъекта().Организация_Прочитать(Организация);
	ОписаниеОрганизации.Идентификатор = Идентификатор;
	МодульОбъекта().Организация_Записать(ОписаниеОрганизации);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиПодписания()
	
	ПользовательНастройки = Неопределено;
	
	ВидыСертификатов = МодульОбъекта().Перечисление_ВидыСертификатов();
	ВидСертификата = МодульОбъекта().ЗначениеРеквизитаОбъекта_Марк(Сертификат, "ВидСертификата");
	
	Если ВидСертификата = ВидыСертификатов.НаФизЛицо Тогда
		ПользовательНастройки = Пользователь;
	КонецЕсли;
	
	МодульОбъекта().НастройкаПодписания_Записать(Сертификат, Организация, ПользовательНастройки);
	
КонецПроцедуры

&НаСервере
Функция ОписаниеОрганизацииПоКонтекстуФормы()
	
	Результат = МодульОбъекта().Новый_Организация();
	
	ЗаполнитьЗначенияСвойств(Результат, ЭтаФорма);
	ЗаполнитьЗначенияСвойств(Результат.ДопРеквизиты, ЭтаФорма);
	
	Результат.Наименование = НаименованиеОрганизации;
	
	Результат.ДопРеквизиты.ОтключитьЧтениеВходящихУПД = Ложь;
	Результат.ДопРеквизиты.ОтключитьЧтениеУведомленийОПриемке = Ложь;
	Результат.ДопРеквизиты.ОтключитьОбмен = Ложь;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура НастроитьОтображениеСрокаТарифа()
	
	Если Не ЗначениеЗаполнено(Идентификатор)
		Или Не ЗначениеЗаполнено(Организация) Тогда
		Элементы.ГруппаИнформацияОТарифе.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	МодульОбъекта().НастроитьОтображениеСрокаТарифа(ЭтаФорма, Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура СсылкаТарифНажатие(Элемент)
	
	Если Не ЗначениеЗаполнено(Идентификатор)
		Или Не ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	МодульКлиента().ОткрытьСтраницуТарифовОрганизации(Организация);
	
КонецПроцедуры

// #КонецОбласти

// #Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УправлениеФормой()
	
	Этапы = ЭтапыСтартовогоПомощника();
	
	Элементы.ПерваяСтраница.Видимость = Ложь;
	Элементы.НастройкиДокументов.Видимость = Ложь;
	Элементы.НастройкаОрганизаций.Видимость = Ложь;
	Элементы.НастройкаОрганизации.Видимость = Ложь;
	Элементы.НастройкаСкладов.Видимость = Ложь;
	Элементы.НастройкаОтраженияЭДО.Видимость = Ложь;
	Элементы.НастройкиСети.Видимость = Ложь;
	Элементы.НастройкиПереноса.Видимость = Ложь;
	
	Элементы[ТекущийЭтап].Видимость = Истина;
	
	Элементы.КнопкиНавигации.Видимость = Истина;
	Элементы.ОбщиеНастройки.Видимость = Ложь;
	
	Элементы.Группа_НастройкиПрокси.Видимость = Прокси_Использовать;
	
	Если ТекущийЭтап = Этапы.ПерваяСтраница Тогда
		Элементы.КнопкиНавигации.Видимость = Ложь;
	ИначеЕсли ТекущийЭтап = Этапы.НастройкаОрганизаций Тогда
		
		НастройкиВыполнены = (КоличествоНастроенныхОрганизаций() > 0);
		
		Элементы.КнопкиНавигации.Видимость = НастройкиВыполнены;
		Элементы.СледующийШаг.Видимость = Ложь;
		Элементы.ОбщиеНастройки.Видимость = НастройкиВыполнены;
		Элементы.ГруппаНастройкиОрганизацийВыполнены.Видимость = НастройкиВыполнены;
		Элементы.ГруппаНастройкиОрганизацийНеВыполнены.Видимость = Не НастройкиВыполнены;
		
	ИначеЕсли ТекущийЭтап = Этапы.НастройкаОрганизации Тогда
		
		Элементы.СледующийШаг.Видимость = Истина;
		
		Если ЗначениеЗаполнено(Сертификат) Тогда
			СертификатГиперссылка = Строка(Сертификат);
			Элементы.СледующийШаг.Доступность = Истина;
		Иначе
			СертификатГиперссылка = НСтр("ru = 'Выбрать'");
			Элементы.СледующийШаг.Доступность = Ложь;
		КонецЕсли;
		
		НастроитьОтображениеСрокаТарифа();
		
	ИначеЕсли ТекущийЭтап = Этапы.НастройкиСети Тогда
		
		Элементы.СледующийШаг.Видимость = Истина;
		Элементы.СледующийШаг.Доступность = Истина;
		
	ИначеЕсли ТекущийЭтап = Этапы.НастройкиПереноса Тогда
		
		Элементы.СледующийШаг.Видимость = Истина;
		Элементы.СледующийШаг.Доступность = Истина;
		
		Элементы.ПеренестиКоэффициентыПересчетаИДанныеНоменклатуры1С.Доступность = ПеренестиКоэффициентыПересчета И Не ПереносВыполнен;
		Элементы.ПеренестиДанныеПлагинаОСУДД.Доступность = Не ПереносВыполнен;
		
	ИначеЕсли ТекущийЭтап = Этапы.НастройкаОтраженияЭДО Тогда
		Элементы.СледующийШаг.Видимость = Истина;
		Элементы.МаркируемыеТоварныеГруппыВидПродукции1С.Видимость = ОпределенТипВидовПродукции1С;
	КонецЕсли;
	
	Если ЭтоПоследнийЭтап() Тогда
		Элементы.СледующийШаг.Заголовок = НСтр("ru = 'Приступить к работе'");
	ИначеЕсли ТекущийЭтап = Этапы.НастройкиСети Тогда
		Элементы.СледующийШаг.Заголовок = НСтр("ru = 'Сохранить и продолжить'");
	Иначе
		Элементы.СледующийШаг.Заголовок = НСтр("ru = 'Далее'");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьСледующийЭтап()
	
	СледующийЭтап = СледующийЭтап();
	ПоказатьЭтап(СледующийЭтап);
	
КонецПроцедуры

