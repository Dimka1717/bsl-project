Процедура ОбновитьНастройкиДокументовУчета()
	
	НастройкиДокументовУчета.Очистить();
	НастройкиДокументов = МодульОбъекта().НастройкиДокументовУчета_ВсеЭлементы();
	
	Для каждого Настройка Из НастройкиДокументов Цикл
		НоваяСтрока = НастройкиДокументовУчета.Добавить();
