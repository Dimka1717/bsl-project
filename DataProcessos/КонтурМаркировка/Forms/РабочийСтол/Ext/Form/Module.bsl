&НаКлиенте
Процедура ПодключитьНовуюВерсиюПерезапуститьМодуль(КонтекстОбновления)
	
	ЭтаФорма.Закрыть();
	
	МодульКлиента().ПодключитьНовуюВерсиюМодуля(КонтекстОбновления);
	
	ОткрытьФорму(ИмяФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОбновление(ПриОткрытии = Ложь)
	
	КонтекстОбновления = МодульКлиента().КонтекстОбновления();
	КонтекстОбновления.ВыполняетсяОткрытиеМодуля = ПриОткрытии;
	
	НастроитьГиперссылкуОбновления(КонтекстОбновления);
	
	Если ПриОткрытии И КонтекстОбновления.ОбновлениеВыполнено Тогда
		ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("ПослеУведомленияОбУстановкеНовойВерсии", ЭтаФорма);
		МодульКлиента().ОткрытьФормуИнформацииОбОбновлении(ЭтаФорма, КонтекстОбновления, ОписаниеОбработчика);
		Возврат;
	КонецЕсли;
	
	МодульКлиента().ПроверитьДоступностьФайлаМодуляНаКлиенте(КонтекстОбновления);
	
	Если ПриОткрытии И Не КонтекстОбновления.ЕстьОбновлениеМодуля Тогда
		ПродолжитьОткрытиеПослеПроверкиОбновления();
		Возврат;
	КонецЕсли;
	
	Если ПриОткрытии Тогда
		
		Если КонтекстОбновления.ЕстьОбновлениеМодуля
			И Не КонтекстОбновления.ЕстьПодсистемаВСО Тогда
			ДобавитьУведомление(МодульКлиента().Перечисление_ТипыУведомлений().ОбновитесьДоНовойВерсии);
		КонецЕсли;
		
		Если КонтекстОбновления.НевозможноВыполнитьОбновление
			Или КонтекстОбновления.ПолученаОшибкаСервисаОбновлений
			Или КонтекстОбновления.НельзяПоказыватьУведомлениеОНовойВерсии Тогда
			МодульКлиента().Метрики_НевозможноВыполнитьОбновление(КонтекстОбновления);
			ПродолжитьОткрытиеПослеПроверкиОбновления();
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	МодульКлиента().ОстановитьЗамерПроизводительности(
	МодульКлиента().Перечисление_ДействияМетрики().Замер_ОткрытиеРабочегоСтола);
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("Обновление_ОбработатьРешениеПользователя", ЭтаФорма);
	МодульКлиента().ОткрытьФормуИнформацииОбОбновлении(ЭтаФорма, КонтекстОбновления, ОписаниеОбработчика);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОткрытиеПослеПроверкиОбновления()
	
	Если МодульКлиента().НеобходимоПерейтиНаНовуюВерсиюДанных() Тогда
		ПерейтиНаНовуюВерсиюДанных();
	Иначе
		ПродолжитьОткрытие();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеУведомленияОбУстановкеНовойВерсии(Ответ, ДопПараметры = Неопределено) Экспорт
	
	ПродолжитьОткрытиеПослеПроверкиОбновления();
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаНовуюВерсиюДанных()
	
	МодульКлиента().ОстановитьЗамерПроизводительности(
	МодульКлиента().Перечисление_ДействияМетрики().Замер_ОткрытиеРабочегоСтола);
	
	ТребуемаяВерсия = МодульКлиента().ТребуемаяВерсияДанныхПодсистемы();
	ЗаголовокВопроса = НСтр("ru = 'Обновление подсистемы Контур.Маркировка'");
	
	ТекстВопроса = НСтр(
	"ru = 'Необходимо обновить данные подсистемы до версии %1
	|Обновление может занять от нескольких минут до нескольких часов.
	|Продолжить?'");
	ТекстВопроса = МодульКлиента().ПараметрыВСтроку(ТекстВопроса, ТребуемаяВерсия);
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
	"ПерейтиНаНовуюВерсиюДанных_ПослеСогласия", ЭтаФорма, ТребуемаяВерсия);
	
	МодульКлиента().ПоказатьДиалогВопроса(ОписаниеОбработчика, ТекстВопроса, РежимДиалогаВопрос.ДаНет, ЗаголовокВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаНовуюВерсиюДанных_ПослеСогласия(Ответ, НоваяВерсия) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Закрыть();
		Возврат;
	КонецЕсли;
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
	"ПерейтиНаНовуюВерсиюДанных_ПослеОбновленияДанных", ЭтаФорма, НоваяВерсия);
	
	МодульКлиента().ОткрытьФормуПереходаНаНовуюВерсиюДанных(ЭтаФорма, ОписаниеОбработчика);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаНовуюВерсиюДанных_ПослеОбновленияДанных(ОбновлениеВыполнено, НоваяВерсия) Экспорт
	
	Если ОбновлениеВыполнено <> Истина Тогда
		Закрыть();
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = НСтр("ru = 'Обновление на новую версию данных %1 успешно завершено'");
	ТекстСообщения = МодульКлиента().ПараметрыВСтроку(ТекстСообщения, НоваяВерсия);
	МодульКлиента().СообщитьПользователюЛок(ТекстСообщения);
	
	ПродолжитьОткрытие();
	
КонецПроцедуры

&НаКлиенте
Процедура Обновление_ОбработатьРешениеПользователя(КонтекстОбновления, ДопПараметры = Неопределено) Экспорт
	
	Если КонтекстОбновления.ПолученОтказ Тогда
		МодульКлиента().ЗафиксироватьОтказОтОбновленияПриОткрытииМодуля(КонтекстОбновления);
	КонецЕсли;
	
	Если КонтекстОбновления.ПолученоСогласие Тогда
		Обновление_ПредложениеЗавершитьРаботуНаВсехУстройствах(КонтекстОбновления);
		Возврат;
	КонецЕсли;
	
	Если КонтекстОбновления.ВыполняетсяОткрытиеМодуля Тогда
		ПродолжитьОткрытиеПослеПроверкиОбновления();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Обновление_ПредложениеЗавершитьРаботуНаВсехУстройствах(КонтекстОбновления)
	
	ЗаголовокВопроса = НСтр("ru = 'Обновление модуля'");
	
	ТекстВопроса = НСтр(
	"ru = 'Для корректного обновления необходимо
	|завершить работу с текущей версией на всех устройствах.
	|Выполнить обновление?'");
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
	"Обновление_ПредложениеЗавершитьРаботуНаВсехУстройствах_ПослеСогласия", ЭтаФорма, КонтекстОбновления);
	
	МодульКлиента().ПоказатьДиалогВопроса(ОписаниеОбработчика, ТекстВопроса, РежимДиалогаВопрос.ДаНет, ЗаголовокВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура Обновление_ПредложениеЗавершитьРаботуНаВсехУстройствах_ПослеСогласия(Ответ, КонтекстОбновления) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОбновитьИПерезапуститьМодуль(КонтекстОбновления);
	Иначе
		Если КонтекстОбновления.ВыполняетсяОткрытиеМодуля Тогда
			ПродолжитьОткрытиеПослеПроверкиОбновления();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИПерезапуститьМодуль(КонтекстОбновления)
	
	Попытка
		МодульКлиента().ВыполнитьОбновлениеМодуля(КонтекстОбновления);
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Выполнение обновления'");
		ТекстСообщения = НСтр("ru = 'Не удалось выполнить обновление'");
		
		МодульКлиента().ОбработатьОшибку(Действие, Ошибка,, ТекстСообщения);
		
		КонтекстОбновления.ОписаниеОшибки = Ошибка;
		
	КонецПопытки;
	
	МодульКлиента().Метрики_АвтоматическоеОбновление(КонтекстОбновления);
	
	Если КонтекстОбновления.ОбновлениеВыполнено Тогда
		
		ВариантыРасположения = МодульКлиента().Перечисление_ВариантыРасположенияОбработки();
		Если КонтекстОбновления.РасположениеМодуля = ВариантыРасположения.ВРасширении Тогда
			УведомитьПользователяОбУспешномОбновленииРасширенияКонфигурации();
		Иначе
			ПодключитьНовуюВерсиюПерезапуститьМодуль(КонтекстОбновления);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УведомитьПользователяОбУспешномОбновленииРасширенияКонфигурации()
	
	ЗаголовокДиалога = НСтр("ru = 'Обновление модуля'");
	ТекстСообщения = НСтр("ru = 'Модуль обновлен до актуальной версии. Для работы с модулем необходимо перезапустить программу.'");
	ПослеЗакрытия = МодульКлиента().ОписаниеОбработчикаОповещения("ПерезапуститьПрограммуПослеОбновленияРасширения", ЭтаФорма);
	МодульКлиента().ПоказатьДиалогПредупреждения(ТекстСообщения, ЗаголовокДиалога, ПослеЗакрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерезапуститьПрограммуПослеОбновленияРасширения(Результат) Экспорт
	
	ЗавершитьРаботуСистемы(Ложь, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОткрытие()
	
	Если МодульКлиента().ВерсияПлатформыНиже("8.3") Тогда
		// В событии ПриОткрытии ЭтаФорма.Открыта() для 8.2 = Ложь
		// Чтобы избежать ошибок продолжаем через обработчик ожидания
		ПодключитьОбработчикОжидания("ПослеОткрытия", 0.1, Истина);
	Иначе
		ПослеОткрытия();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОткрытия() Экспорт
	
	МодульКлиента().ЗапуститьПодключениеКонтурПлагина();
	МодульКлиента().ЗапуститьОтложенноеОбновлениеДанных();
	МодульКлиента().ЗапуститьУдалениеУстаревшихДанных();
	МодульКлиента().ОбновитьПлагины();
	
	МодульКлиента().ПродолжитьЗамерПроизводительности(
	МодульКлиента().Перечисление_ДействияМетрики().Замер_ОткрытиеРабочегоСтола);
	
	НастроитьОтображениеБлокаОбратнойСвязи();
	
	МодульКлиента().ЗавершитьЗамерПроизводительности(
	МодульКлиента().Перечисление_ДействияМетрики().Замер_ОткрытиеРабочегоСтола);
	
КонецПроцедуры

// #КонецОбласти // АвтоматическоеОбновление

