&НаСервере
Процедура ПоказатьБлокОбратнойСвязи(ПоказатьБлок)
	
	Элементы.БлокОбратнаяСвязь.Доступность = ПоказатьБлок;
	Элементы.БлокОбратнаяСвязь.ОтображатьЗаголовок = ПоказатьБлок;
	Элементы.Кнопка_ОтправитьОтзыв.Видимость = ПоказатьБлок;
	Элементы.ГруппаОпрос.Видимость = ПоказатьБлок;
	Элементы.ПустойБлокОбратнойСвязи.Видимость = Не ПоказатьБлок;
	
	Если Не МодульОбъекта().ВерсияПлатформыНиже("8.3") Тогда
		Если ПоказатьБлок Тогда
			Элементы.БлокОбратнаяСвязь.ЦветФона = Новый Цвет(224, 255, 255);
		Иначе
			Элементы.БлокОбратнаяСвязь.ЦветФона = Новый Цвет;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВыполнениеОбменаССервисом()
	
	Если МодульКлиента().ОбменССервисомВыполняется(Организация) Тогда
		МодульКлиента().НастроитьКнопкуОбменаССервисом(Элементы.Кнопка_ВыполнитьОбмен, Истина);
		ПодключитьОбработчикОжидания("ОбновитьСтатусОбменаССервисом", 5, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусОбменаССервисом() Экспорт
	
	ОбменССервисомВыполняется = МодульКлиента().ОбменССервисомВыполняется(Организация);
	
	МодульКлиента().НастроитьКнопкуОбменаССервисом(Элементы.Кнопка_ВыполнитьОбмен, ОбменССервисомВыполняется);
	
	Если ОбменССервисомВыполняется Тогда
		ПодключитьОбработчикОжидания("ОбновитьСтатусОбменаССервисом", 5, Истина);
	Иначе
		ОбновитьРабочийСтолПослеОбмена();
		МодульКлиента().ОбработатьОшибкиОбменаССервисом(ЭтаФорма, Организация);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьГрупповуюОбработку(ТипОперации)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Период", Период);
	ПараметрыФормы.Вставить("Организация", Организация);
	ПараметрыФормы.Вставить("ТипОперации", ТипОперации);
	
	МодульКлиента().ОткрытьФормуОбработки("Форма_ГрупповаяОбработка", ЭтаФорма, ПараметрыФормы);
	
КонецПроцедуры

&НаСервере
Функция ЕстьОграничениеПоТарифу(ТипОперации = Неопределено, Сервис = Неопределено)
	
	Результат = Ложь;
	
	ОписаниеТарифа = МодульОбъекта().Тариф(Организация);
	
	Если ЗначениеЗаполнено(ТипОперации) Тогда
		Результат = Не МодульОбъекта().ОперацияДоступнаПоТарифу(ТипОперации, ОписаниеТарифа);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сервис) Тогда
		Результат = Не МодульОбъекта().СервисДоступенПоТарифу(Сервис, ОписаниеТарифа);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

