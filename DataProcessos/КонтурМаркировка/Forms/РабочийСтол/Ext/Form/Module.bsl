Функция КлючНазначенияИспользованияФормыМодуля(ТипОперации = Неопределено)
	
	ТипыОпераций = МодульКлиента().Перечисление_ТипыОпераций();
	
	Если ТипОперации = Неопределено Тогда
		Результат = "Документы";
	ИначеЕсли ТипОперации = ТипыОпераций.ВходящийУПД Тогда
		Результат = "ПриемкаУПД";
	ИначеЕсли ТипОперации = ТипыОпераций.УведомлениеОПриемке Тогда
		Результат = "УведомленияОПриемке";
	Иначе
		Результат = "Операции_" + СтрЗаменить(ТипОперации, " ", "_");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
