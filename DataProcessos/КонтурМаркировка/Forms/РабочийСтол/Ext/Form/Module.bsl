
&НаКлиенте
Перем КэшМодуляКлиента;

&НаСервере
Функция МодульОбъекта()
	
	Возврат Вычислить("ВзаимодействиеКонтурМаркировка.МодульКонтурМаркировка()");
	
КонецФункции

&НаКлиенте
Функция МодульКлиента() Экспорт
	
	Если КэшМодуляКлиента <> Неопределено Тогда
		Возврат КэшМодуляКлиента;
	КонецЕсли;
	
	ПутьКФорме = ПутьКФормеМодуляКлиента();
	
	Результат = ОткрытьФорму(ПутьКФорме);
	
	КэшМодуляКлиента = Результат;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПутьКФормеМодуляКлиента()
	
	Возврат МодульОбъекта().ПутьКФормеМодуляКлиента();
	
КонецФункции

// #Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ЗапрещеноСозданиеНовойФормы") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ПроверитьКорректностьУстановки();
	
	Модуль = РеквизитФормыВЗначение("Объект");
	Если Не Модуль.МодульИнициализирован(УникальныйИдентификатор) Тогда
		Модуль.ИнициализироватьИзОсновнойФормы(УникальныйИдентификатор);
	КонецЕсли;
	
	ПараметрыПМ = Новый Структура("ОтключитьРабочийСтол", Ложь);
	МодульОбъекта().ПМ_ОбработатьСобытие_ПередОткрытиемРабочегоСтола(ПараметрыПМ);
	РабочийСтолОтключен = ПараметрыПМ.ОтключитьРабочийСтол;
	
	Если РабочийСтолОтключен Тогда
		МодульОбъекта().Метрика_Функциональность_РабочийСтолОтключен();
		Возврат;
	КонецЕсли;
	
	МодульОбъекта().НачатьЗамерПроизводительности(
	МодульОбъекта().Перечисление_ДействияМетрики().Замер_ОткрытиеРабочегоСтола);
	
	ЗаполнитьОрганизациюПоУмолчанию();
	ПрочитатьНастройкиРабочегоСтола();
	НастроитьОтображениеБлоков();
	НастроитьЭлементыФормыДля82();
	УстановитьЗаголовокФормы();
	ЗаполнитьСпискиЗначений();
	СформироватьДополнительныеКнопки();
	
	ОбновитьИнформациюОТарифах();
	ПроверитьНаличиеНовостей();
	ПроверитьНаличиеОпросов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если РабочийСтолОтключен Тогда
		Отказ = Истина;
		МодульКлиента().ОткрытьФормуМодуля();
		Возврат;
	КонецЕсли;
	
	МодульКлиента().ПриОткрытииОсновнойФормы();
	
	ПроверитьВыполнениеОбменаССервисом();
	ЗаполнитьПустыеЗначенияПериода();
	УстановитьЗаголовокПериода();
	ПроверитьЗаполнениеАнкеты();
	ОбновитьРабочийСтол(Ложь, Истина);
	
	ПроверитьОбновление(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы = Ложь)
	
	Если Не ЗавершениеРаботы Тогда
		МодульКлиента().ПриЗакрытииОсновнойФормы();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурМаркировка_ИзмененыНастройкиРабочегоСтола" Тогда
		ПриИзмененииНастроекРабочегоСтола();
	КонецЕсли;
	
	Если ИмяСобытия = "КонтурМаркировка_ИзмененРежимТехническогоСпециалиста" Тогда
		НастроитьВидимостьПодменюТехническогоСпециалиста(Параметр);
	КонецЕсли;
	
	Если ИмяСобытия = "КонтурМаркировка_НастройкиМодуля_Обновлены" И Источник <> ЭтаФорма Тогда
		ПриИзмененииНастроекМодуля();
	КонецЕсли;
	
	Если ИмяСобытия = "КонтурМаркировка_ПринудительноЗакрытьМодуль" Тогда
		Закрыть();
	КонецЕсли;
	
	Если ИмяСобытия = "КонтурМаркировка_Операция_Изменен"
		Или ИмяСобытия = "КонтурМаркировка_ДокументУчета_Изменен"
		Или ИмяСобытия = "КонтурМаркировка_ДокументУчета_Удален" 
		Или ИмяСобытия = "КонтурМаркировка_ДокументУчета_Перезаполнен" Тогда
		ОбновитьИнформациюВБлоках();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииНастроекРабочегоСтола()
	
	ПрочитатьНастройкиРабочегоСтола();
	НастроитьОтображениеБлоков();
	ОбновитьИнформациюВБлоках();
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииНастроекМодуля()
	
	УстановитьЗаголовокФормы();
	ОбновитьИнформациюВБлоках();
	СформироватьДополнительныеКнопки();
	
КонецПроцедуры

// #КонецОбласти // ОбработчикиСобытийФормы

// #Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОбновитьРабочийСтол();
	
	Метрика_Поведение_Шапка(Перечисление_ДействияРабочегоСтола().ВыбратьОрганизацию);
	
КонецПроцедуры

// #КонецОбласти // ОбработчикиСобытийЭлементовФормы

// #Область НастройкаЭлементовФормы

&НаСервере
Процедура НастроитьЭлементыФормыДля82()
	
	Если Не МодульОбъекта().ПоддерживаетсяАвтоОбработкаФоновыхЗаданий() Тогда
		Элементы.Кнопка_ЗапуститьВыполнениеФоновыхЗаданий82.Видимость = Истина;
	КонецЕсли;
	
	Если Не МодульОбъекта().ВерсияРежимаСовместимостиНиже("8.3") Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.РабочаяОбласть_Строка1.Высота = 10;
	Элементы.РабочаяОбласть_Строка2.Высота = 10;
	Элементы.РабочаяОбласть_Строка3.Высота = 10;
	
	Элементы.Кнопка_ОтправитьОтзыв.Ширина = 16;
	
	Элементы.РазделительСтроки1.Видимость = Истина;
	Элементы.РазделительСтроки2.Видимость = Истина;
	
	Элементы.Строка1_РазделительКолонки1.Видимость = Истина;
	Элементы.Строка1_РазделительКолонки2.Видимость = Истина;
	Элементы.Строка2_РазделительКолонки1.Видимость = Истина;
	Элементы.Строка2_РазделительКолонки2.Видимость = Истина;
	Элементы.Строка3_РазделительКолонки1.Видимость = Истина;
	Элементы.Строка3_РазделительКолонки2.Видимость = Истина;
	
	Элементы.ГруппаРабочийСтол.РастягиватьПоВертикали = Ложь;
	Элементы.ГруппаРабочийСтол.РастягиватьПоГоризонтали = Ложь;
	
	Элементы.РабочаяОбласть_Строка1.РастягиватьПоГоризонтали = Ложь;
	Элементы.РабочаяОбласть_Строка2.РастягиватьПоГоризонтали = Ложь;
	Элементы.РабочаяОбласть_Строка3.РастягиватьПоГоризонтали = Ложь;
	
	Элементы.БлокДокументыУчета.РастягиватьПоВертикали = Ложь;
	Элементы.БлокДокументыУчета.РастягиватьПоГоризонтали = Ложь;
	
	Элементы.БлокЗаказПечатьКодов.РастягиватьПоВертикали = Ложь;
	Элементы.БлокЗаказПечатьКодов.РастягиватьПоГоризонтали = Ложь;
	
	Элементы.БлокМаркировка.РастягиватьПоВертикали = Ложь;
	Элементы.БлокМаркировка.РастягиватьПоГоризонтали = Ложь;
	
	Элементы.БлокТовары.РастягиватьПоВертикали = Ложь;
	Элементы.БлокТовары.РастягиватьПоГоризонтали = Ложь;
	
	Элементы.БлокПриемка.РастягиватьПоВертикали = Ложь;
	Элементы.БлокПриемка.РастягиватьПоГоризонтали = Ложь;
	
	Элементы.БлокТовародвижение.РастягиватьПоВертикали = Ложь;
	Элементы.БлокТовародвижение.РастягиватьПоГоризонтали = Ложь;
	
	Элементы.БлокТранспортныеУпаковки.РастягиватьПоВертикали = Ложь;
	Элементы.БлокТранспортныеУпаковки.РастягиватьПоГоризонтали = Ложь;
	
	Элементы.БлокНовости.РастягиватьПоВертикали = Ложь;
	Элементы.БлокНовости.РастягиватьПоГоризонтали = Ложь;
	
	Элементы.БлокОбратнаяСвязь.РастягиватьПоВертикали = Ложь;
	Элементы.БлокОбратнаяСвязь.РастягиватьПоГоризонтали = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	ВерсияМодуля = МодульОбъекта().ВерсияОбработки();
	ЭтоБетаВерсия = МодульОбъекта().ЭтоБетаВерсия();
	НастройкиМодуля = МодульОбъекта().НастройкиМодуля();
	ОписаниеДоработокМодуля = МодульОбъекта().ОписаниеДоработокМодуля();
	НаименованиеМодуля = МодульОбъекта().СведенияОВнешнейОбработке().Наименование;
	НаименованиеФормы = "Рабочий стол";
	
	Если ЭтоБетаВерсия Тогда
		СтрокаБетаВерсия = "b";
	КонецЕсли;
	
	ДополнительноеОписаниеМодуля = Новый Массив;
	Если НастройкиМодуля.ТестовоеОкружение Тогда
		ДополнительноеОписаниеМодуля.Добавить("тестовое окружение");
	КонецЕсли;
	Если НастройкиМодуля.РежимТестирования Тогда
		ДополнительноеОписаниеМодуля.Добавить("режим тестирования");
	КонецЕсли;
	Если ЗначениеЗаполнено(ОписаниеДоработокМодуля) Тогда
		ДополнительноеОписаниеМодуля.Добавить("модуль доработан");
	КонецЕсли;
	Если НастройкиМодуля.РежимОтладки Тогда
		ДополнительноеОписаниеМодуля.Добавить("режим отладки");
	КонецЕсли;
	
	СтрокаДополнительноеОписание = "";
	Если ЗначениеЗаполнено(ДополнительноеОписаниеМодуля) Тогда
		СтрокаДополнительноеОписание = МодульОбъекта().СоединитьСтроку(ДополнительноеОписаниеМодуля, ", ");
		СтрокаДополнительноеОписание = МодульОбъекта().ПараметрыВСтроку(" (%1)", СтрокаДополнительноеОписание);
	КонецЕсли;
	
	ТекстЗаголовка = НаименованиеФормы
	+ " "
	+ НаименованиеМодуля
	+ " "
	+ ВерсияМодуля
	+ СтрокаБетаВерсия
	+ СтрокаДополнительноеОписание;
	
	ЭтаФорма.Заголовок = ТекстЗаголовка;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовокПериода()
	
	Элементы.Кнопка_УстановитьПериод.Заголовок = ПредставлениеПериодаСтрокой(Период);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовкиКомандБлоков()
	
	Элементы.Маркировка_Перемаркировать.Заголовок = МодульОбъекта().ПараметрыВСтроку(
	НСтр("ru = 'Перемаркировать товары (%1)'"), ЗаказКодов_КоличествоОжидаетПеремаркировку);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимость()
	
	Элементы.БлокДокументыУчета_Строка1_Действия.Видимость = ЗначениеЗаполнено(ДокументыУчета_КоличествоИсправить);
	
	Элементы.БлокЗаказПечатьКодов_Строка1_Действия.Видимость = ЗначениеЗаполнено(ЗаказКодов_КоличествоИсправить);
	
	Элементы.БлокМаркировка_Строка1_Действие2.Видимость = ЗначениеЗаполнено(ОтчетОНанесении_КоличествоИсправить);
	Элементы.БлокМаркировка_Строка2_Действие2.Видимость = ЗначениеЗаполнено(ВводВОборот_КоличествоИсправить);
	Элементы.БлокМаркировка_Строка3_Действия.Видимость = ЗначениеЗаполнено(Перемаркировка_КоличествоИсправить);
	
	Элементы.БлокПриемка_Строка3_Действие2.Видимость = ЗначениеЗаполнено(УведомлениеОПриемке_КоличествоИсправить);
	
	Элементы.БлокТовародвижение_Строка1_Действия.Видимость = ЗначениеЗаполнено(ВыводИзОборота_КоличествоИсправить);
	Элементы.БлокТовародвижение_Строка2_Действия.Видимость = ЗначениеЗаполнено(ОтчетОВыбытии_КоличествоИсправить);
	Элементы.БлокТовародвижение_Строка3_Действия.Видимость = ЗначениеЗаполнено(ВозвратВОборот_КоличествоИсправить);
	Элементы.БлокТовародвижение_Строка4_Действия.Видимость = ЗначениеЗаполнено(СообщениеОбОтгрузке_КоличествоИсправить);
	Элементы.БлокТовародвижение_Строка5_Действия.Видимость = ЗначениеЗаполнено(УведомлениеОСостоянииКодов_КоличествоИсправить);
	Элементы.ГруппаМаркировка_Перемаркировать.Видимость = ЗначениеЗаполнено(ЗаказКодов_КоличествоОжидаетПеремаркировку);
	
	ЕстьОперацииСОшибками = ЗначениеЗаполнено(РегистрацияАгрегатовВГИСМТ_КоличествоИсправить);
	Элементы.БлокТранспортныеУпаковки_Строка1_Действия.Видимость = ЕстьОперацииСОшибками;
	
	ЕстьОперацииСОшибками = ЗначениеЗаполнено(НаполнениеАгрегатовНаТСД_КоличествоИсправить);
	Элементы.БлокТранспортныеУпаковки_Строка2_Действия.Видимость = ЕстьОперацииСОшибками;
	
	РежимТехническогоСпециалиста = МодульОбъекта().ВключенРежимТехническогоСпециалиста();
	НастроитьВидимостьПодменюТехническогоСпециалиста(РежимТехническогоСпециалиста);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьПодменюТехническогоСпециалиста(РежимТехническогоСпециалиста)
	
	Элементы.Группа_ФункцииТехническогоСпециалиста.Видимость = РежимТехническогоСпециалиста;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиЗначений()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	СтатусыОпераций = МодульОбъекта().Перечисление_СтатусыОпераций();
	
	СписокСтатусовЗавершенныхОпераций.ЗагрузитьЗначения(МодульОбъекта().ЗавершенныеСтатусыОпераций());
	
	СписокСтатусовОперацийСОшибками.Добавить(СтатусыОпераций.ОшибкаЗаполнения);
	СписокСтатусовОперацийСОшибками.Добавить(СтатусыОпераций.ОшибкаОбработки);
	СписокСтатусовОперацийСОшибками.Добавить(СтатусыОпераций.ОтГИСПолученоСообщениеОбОшибке);
	СписокСтатусовОперацийСОшибками.Добавить(СтатусыОпераций.ОшибкаОтправкиЗапросаСФайломВГИС);
	
	СписокТиповОперацийОтчетаОНанесении.Добавить(ТипыОпераций.ОтчетОНанесении);
	СписокТиповОперацийОтчетаОНанесении.Добавить(ТипыОпераций.ОтчетОНанесенииНаТСД);
	
	СписокТиповОперацийВозвратаВОборот.Добавить(ТипыОпераций.ВозвратВОборот);
	СписокТиповОперацийВозвратаВОборот.Добавить(ТипыОпераций.ВозвратВОборотНаТСД);
	
	СписокТиповОперацийОтчетаОВыбытии.Добавить(ТипыОпераций.ОтчетОВыбытии);
	СписокТиповОперацийОтчетаОВыбытии.Добавить(ТипыОпераций.ОтчетОВыбытииНаТСД);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьОтображениеБлоков()
	
	Для Каждого НастройкаБлока Из НастройкиРабочегоСтола.БлокиРабочегоСтола Цикл
		
		ГруппаБлока = ЭтаФорма.Элементы.Найти(НастройкаБлока.Ключ);
		
		Если ГруппаБлока = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ГруппаБлока, НастройкаБлока.Значение);
		
		Для Каждого НастройкаЭлементаБлока Из НастройкаБлока.Значение.ЭлементыБлока Цикл
			ИмяЭлементаБлока = ГруппаБлока.Имя + "_" + НастройкаЭлементаБлока.Ключ;
			ГруппаЭлементаБлока = ЭтаФорма.Элементы.Найти(ИмяЭлементаБлока);
			Если ГруппаЭлементаБлока = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ГруппаЭлементаБлока, НастройкаЭлементаБлока.Значение);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьОтображениеБлокаОбратнойСвязи()
	
	КлючиСценариев = МодульКлиента().Перечисление_КлючиСценариевДляОпросов();
	
	ОпросНаРабочемСтоле = МодульКлиента().ОпросПользователяПоСценарию(КлючиСценариев.РабочийСтол);
	Если Не ЗначениеЗаполнено(ОпросНаРабочемСтоле) Тогда
		ПоказатьБлокОбратнойСвязи(Ложь);
		Возврат;
	КонецЕсли;
	
	ОпросНаРабочемСтоле.Свойство("ИдентификаторОпроса", ИдентификаторОпроса);
	ОпросНаРабочемСтоле.Свойство("КлючСценария", КлючСценария);
	ОпросНаРабочемСтоле.Свойство("ТекстОпроса", ТекстОпроса);
	
	Элементы.ТекстОпроса.Заголовок = ТекстОпроса;
	ПоказатьБлокОбратнойСвязи(Истина);
	
	НастроитьДоступностьЭлементовБлокаОбратнойСвязи();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьДоступностьЭлементовБлокаОбратнойСвязи()
	
	ЕстьОценка = ЗначениеЗаполнено(Оценка);
	Элементы.Комментарий.Доступность = ЕстьОценка;
	Элементы.Кнопка_ОтправитьОтзыв.Доступность = ЕстьОценка;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьГиперссылкуОбновления(КонтекстОбновления)
	
	Если КонтекстОбновления.ЕстьОбновлениеМодуля
		И Не КонтекстОбновления.ЕстьПодсистемаВСО Тогда
		ТекстЗаголовка = НСтр("ru = 'Доступна новая версия: %1'");
		ТекстЗаголовка = МодульКлиента().ПараметрыВСтроку(ТекстЗаголовка, КонтекстОбновления.НоваяВерсияМодуля);
		Элементы.Ссылка_ИнформацияОбОбновлении.Заголовок = ТекстЗаголовка;
		Элементы.Ссылка_ИнформацияОбОбновлении.Видимость = Истина;
	Иначе
		Элементы.Ссылка_ИнформацияОбОбновлении.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыОграниченияПоТарифу(ПриОткрытии)
	
	ОписаниеТарифа = МодульОбъекта().Тариф(Организация);
	
	ПоказатьОграниченияПоТарифу(ОписаниеТарифа);
	ПоказатьБаннерОЗавершенииПодписки(ОписаниеТарифа, ПриОткрытии);
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьБаннерОЗавершенииПодписки(ОписаниеТарифа, ПриОткрытии = Ложь)
	
	ТекДата = НачалоДня(ТекущаяДатаСеанса());
	ДатаОкончания = ОписаниеТарифа.ДатаОкончания;
	ПериодПредупреждения = 40 * МодульОбъекта().СекундВСутках();
	ДатаНачалаПредупреждения = ДатаОкончания - ПериодПредупреждения;
	
	Если Не ЗначениеЗаполнено(ДатаОкончания)
		Или ТекДата < ДатаНачалаПредупреждения Тогда
		Элементы.ГруппаИнформацияОТарифе.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Если ТекДата > ДатаОкончания Тогда
		
		ЦветБаннера = МодульОбъекта().ЦветБаннераОплаченныйПериодЗакончился();
		
		// BSLLS:LineLength-off
		ТекстБаннера = НСтр("ru = 'Закончился оплаченный период. Чтобы восстановить доступ к сервису выберите тариф, оплатите на сайте и продолжайте пользоваться Контур.Маркировкой.'");
		// BSLLS:LineLength-on
		
		Если ПриОткрытии Тогда
			МодульОбъекта().Метрика_Функциональность_БаннерПериодЗакончился(ОписаниеТарифа.Организация);
		КонецЕсли;
		
	Иначе
		
		ЦветБаннера = МодульОбъекта().ЦветБаннераОплаченныйПериодЗаканчивается();
		
		// BSLLS:LineLength-off
		ТекстБаннера = НСтр("ru = 'Оплаченный период заканчивается %1. Выберите тариф, оплатите на сайте и продолжайте пользоваться Контур.Маркировкой.'");
		ТекстБаннера = МодульОбъекта().ПараметрыВСтроку(ТекстБаннера, Формат(ДатаОкончания, "ДФ=dd.MM.yyyy"));
		// BSLLS:LineLength-on
		
		Если ПриОткрытии Тогда
			МодульОбъекта().Метрика_Функциональность_БаннерПериодЗаканчивается(ОписаниеТарифа.Организация);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не МодульОбъекта().ВерсияПлатформыНиже("8.3") Тогда
		Элементы.ГруппаИнформацияОТарифе.ЦветФона = ЦветБаннера;
	КонецЕсли;
	
	Элементы.ТекстИнформацииПоПодписке.Заголовок = ТекстБаннера;
	Элементы.ГруппаИнформацияОТарифе.Видимость = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьОграниченияПоТарифу(ОписаниеТарифа)
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	СервисыПодписок = МодульОбъекта().Перечисление_СервисыПодписок();
	
	Если МодульОбъекта().СозданиеОперацииОграниченоТарифом(ТипыОпераций.ЗаказКодов, ОписаниеТарифа) Тогда
		Элементы.Замок_ЗаказПечатьКодов_ЗаказатьКоды.Видимость = Истина;
	Иначе
		Элементы.Замок_ЗаказПечатьКодов_ЗаказатьКоды.Видимость = Ложь;
	КонецЕсли;
	
	Если МодульОбъекта().СозданиеОперацииОграниченоТарифом(ТипыОпераций.НаполнениеАгрегатовНаТСД, ОписаниеТарифа) Тогда
		Элементы.Замок_Агрегаты_НаполнитьНаТСД.Видимость = Истина;
	Иначе
		Элементы.Замок_Агрегаты_НаполнитьНаТСД.Видимость = Ложь;
	КонецЕсли;
	
	Если МодульОбъекта().СозданиеОперацииОграниченоТарифом(ТипыОпераций.ДобавлениеВАгрегат, ОписаниеТарифа) Тогда
		Элементы.Замок_Агрегаты_ДобавитьВАгрегат.Видимость = Истина;
	Иначе
		Элементы.Замок_Агрегаты_ДобавитьВАгрегат.Видимость = Ложь;
	КонецЕсли;
	
	Если МодульОбъекта().СозданиеОперацииОграниченоТарифом(ТипыОпераций.ИзъятиеИзАгрегата, ОписаниеТарифа) Тогда
		Элементы.Замок_Агрегаты_ИзъятьИзАгрегата.Видимость = Истина;
	Иначе
		Элементы.Замок_Агрегаты_ИзъятьИзАгрегата.Видимость = Ложь;
	КонецЕсли;
	
	Если МодульОбъекта().СозданиеОперацииОграниченоТарифом(ТипыОпераций.ВыводИзОборота, ОписаниеТарифа) Тогда
		Элементы.Замок_Товародвижение_ВывестиИзОборота.Видимость = Истина;
	Иначе
		Элементы.Замок_Товародвижение_ВывестиИзОборота.Видимость = Ложь;
	КонецЕсли;
	
	Если МодульОбъекта().СозданиеОперацииОграниченоТарифом(ТипыОпераций.ВозвратВОборотНаТСД, ОписаниеТарифа) Тогда
		Элементы.Замок_Товародвижение_ВернутьВОборотНаТСД.Видимость = Истина;
	Иначе
		Элементы.Замок_Товародвижение_ВернутьВОборотНаТСД.Видимость = Ложь;
	КонецЕсли;
	
	Если Не МодульОбъекта().СервисДоступенПоТарифу(СервисыПодписок.ЗаказКодовПеремаркировка, ОписаниеТарифа) Тогда
		Элементы.Замок_Маркировка_Перемаркировать.Видимость = Истина;
	Иначе
		Элементы.Замок_Маркировка_Перемаркировать.Видимость = Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Элементы.Замок_Агрегаты_НаполнитьНаТСД.Картинка) Тогда
		Замок = Элементы.КартинкаЗамок.Картинка;
		Элементы.Замок_Агрегаты_НаполнитьНаТСД.Картинка = Замок;
		Элементы.Замок_Агрегаты_ДобавитьВАгрегат.Картинка = Замок;
		Элементы.Замок_Агрегаты_ИзъятьИзАгрегата.Картинка = Замок;
		Элементы.Замок_Маркировка_Перемаркировать.Картинка = Замок;
		Элементы.Замок_ЗаказПечатьКодов_ЗаказатьКоды.Картинка = Замок;
		Элементы.Замок_Товародвижение_ВывестиИзОборота.Картинка = Замок;
		Элементы.Замок_Товародвижение_ВернутьВОборотНаТСД.Картинка = Замок;
	КонецЕсли;
	
КонецПроцедуры

