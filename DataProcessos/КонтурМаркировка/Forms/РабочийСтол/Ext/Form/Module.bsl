	// Подвал
	Результат.Вставить("ОбновитьДатуОбменаССервисом", "Обновить дату обмена с сервисом");
	Результат.Вставить("ОткрытьИнформациюОбОбновлении", "Открыть информацию об обновлении");
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Возврат Результат;
	
