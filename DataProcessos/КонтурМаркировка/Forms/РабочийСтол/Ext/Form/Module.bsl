&НаСервере
Функция ДатаПоследнегоОбмена()
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ОрганизацииДляОбмена = МодульОбъекта().ЗначениеВМассиве(Организация);
	Иначе
		ОрганизацииДляОбмена = МодульОбъекта().Организация_ВсеОрганизацииДляОбмена();
	КонецЕсли;
	
	Результат = '00010101';
	
	Для Каждого ОрганизацияДляОбмена Из ОрганизацииДляОбмена Цикл
		
		Свойство = МодульОбъекта().Перечисление_ДопСвойства().ДатаПоследнегоОбмена;
		ДатаПоследнегоОбмена = МодульОбъекта().ДопСвойство_Прочитать(ОрганизацияДляОбмена, Свойство);
		Если Не ЗначениеЗаполнено(ДатаПоследнегоОбмена) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Результат)
			Или Результат > ДатаПоследнегоОбмена Тогда
			Результат = ДатаПоследнегоОбмена;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура УстановитьДатуПоследнегоОбмена()
	
	ДатаПоследнегоОбмена = ДатаПоследнегоОбмена();
	
	Если ЗначениеЗаполнено(ДатаПоследнегоОбмена) Тогда
		
		ДатаПоследнегоОбмена = МестноеВремя(ДатаПоследнегоОбмена);
		
		МинутВЧасе = 60;
		СекундВЧасе = 3600;
		ПрошлоМинут = Цел((ТекущаяДата() - ДатаПоследнегоОбмена) / МинутВЧасе);
		ПрошлоЧасов = Цел((ТекущаяДата() - ДатаПоследнегоОбмена) / СекундВЧасе);
		
		Если НачалоДня(ДатаПоследнегоОбмена) < НачалоДня(ТекущаяДата()) Тогда
			
			ДатаСтрокой = Строка(ДатаПоследнегоОбмена);
			
		ИначеЕсли ЗначениеЗаполнено(ПрошлоЧасов) Или ЗначениеЗаполнено(ПрошлоМинут) Тогда
			
			Если ЗначениеЗаполнено(ПрошлоЧасов) Тогда
				ПараметрыИсчисления = "час, часа, часов, м,,,,, 0";
				ДатаСтрокой = МодульОбъекта().ЧислоСЕдиницейИзмерения(ПрошлоЧасов, ПараметрыИсчисления);
			Иначе
				ПараметрыИсчисления = "минута, минуты, минут, ж,,,,, 0";
				ДатаСтрокой = МодульОбъекта().ЧислоСЕдиницейИзмерения(ПрошлоМинут, ПараметрыИсчисления);
			КонецЕсли;
			
			ДатаСтрокой = ДатаСтрокой + " " + НСтр("ru = 'назад'");
			
		Иначе
			ДатаСтрокой = НСтр("ru = 'только что'");
		КонецЕсли;
		
	Иначе
		ДатаСтрокой = НСтр("ru = 'никогда'");
	КонецЕсли;
	
	ТекстДатаОбмена = НСтр("ru = 'Обмен с сервисом: %1'");
	ТекстДатаОбмена = МодульОбъекта().ПараметрыВСтроку(ТекстДатаОбмена, ДатаСтрокой);
	
	ЭтаФорма.Элементы.Ссылка_ДатаОбменаССервисом.Заголовок = ТекстДатаОбмена;
	
КонецПроцедуры

