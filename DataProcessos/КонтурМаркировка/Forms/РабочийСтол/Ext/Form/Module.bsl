&НаСервере
Функция ОпросПользователя_ОбщаяОценка()
	
	КлючиСценариев = МодульОбъекта().Перечисление_КлючиСценариевДляОпросов();
	
	Результат = МодульОбъекта().Новый_ОпросПользователя();
	Результат.КлючСценария = КлючиСценариев.ОбщаяОценка;
	
	Возврат Результат;
	
