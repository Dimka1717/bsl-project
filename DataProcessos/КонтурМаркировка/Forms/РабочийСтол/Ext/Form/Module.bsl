&НаСервере
Процедура СохранитьРезультатОпроса()
	
	ОписаниеРезультата = МодульОбъекта().Новый_РезультатОпросаПользователя();
	ЗаполнитьЗначенияСвойств(ОписаниеРезультата, ЭтаФорма);
	
	МодульОбъекта().Метрика_РезультатОпросаПользователя(ОписаниеРезультата);
	
	Если ЗначениеЗаполнено(ИдентификаторОпроса) Тогда
		МодульОбъекта().ЗафиксироватьИдентификаторПройденногоОпроса(ОписаниеРезультата.ИдентификаторОпроса);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИнформациюВБлоках(ВызыватьИсключение = Истина)
	
	Попытка
		ОбнулитьКоличественныеПоказатели();
		ОбновитьПоказателиДокументов();
		ОбновитьПоказателиОпераций();
		ОбновитьПоказателиСправочников();
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Если ВызыватьИсключение Тогда
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ОбнулитьКоличественныеПоказатели()
	
	РеквизитыФормы = ПолучитьРеквизиты();
	Для Каждого РеквизитФормы Из РеквизитыФормы Цикл
		Если Строка(РеквизитФормы.ТипЗначения) <> "Число" Тогда
			Продолжить;
		КонецЕсли;
		Если Найти(РеквизитФормы.Имя, "_Количество") Тогда
			ЭтаФорма[РеквизитФормы.Имя] = Неопределено;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОбновитьПоказателиСправочников()
	
	Товары_Количество = МодульОбъекта().Товары_ВсегоТоваров();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоказателиОпераций()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	СтатусыОпераций = МодульОбъекта().Перечисление_СтатусыОпераций();
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Операции.ТипОперации КАК ТипОперации,
	|	СУММА(ВЫБОР
	|			КОГДА Статусы.Статус В (&СтатусыЗавершенныхОпераций)
	|				ТОГДА 0
	|			КОГДА Операции.ТипОперации = &ПечатьКодов
	|					И Статусы.Статус <> &СтатусНовый
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК Количество,
	|	СУММА(ВЫБОР
	|			КОГДА Статусы.Статус В (&СтатусыОшибок)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоИсправить,
	|	СУММА(ВЫБОР
	|			КОГДА Статусы.Статус = &СтатусОжидаетПеремаркировку
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоОжидаетПеремаркировку,
	|	0 КАК КоличествоПринять
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Операции
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК Статусы
	|		ПО Операции.Ссылка = Статусы.Операция
	|			И (Статусы.ТипСтатуса = &ОсновнойСтатус)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета КАК ДокументыУчета
	|		ПО Операции.ДокументУчета = ДокументыУчета.Ссылка
	|			И &ЕстьОтборПоТипамДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДопСправочники.ДопРеквизиты КАК НастройкиТиповДокументов
	|		ПО (ДокументыУчета.ТипДокумента = НастройкиТиповДокументов.Значение)
	|			И (НастройкиТиповДокументов.ИмяРеквизита = ""ТипДокумента"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДопСправочники КАК НастройкиДокументов
	|		ПО (НастройкиТиповДокументов.Ссылка = НастройкиДокументов.Ссылка)
	|ГДЕ
	|	&Организация
	|	И Операции.ТипОперации В(&ТипыИсходящихОпераций)
	|	И Операции.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ЕСТЬNULL(НастройкиДокументов.ИмяСправочника, """") В ("""", ""НастройкиДокументаУчета"")
	|	И &ТипДокумента
	|
	|СГРУППИРОВАТЬ ПО
	|	Операции.ТипОперации
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Операции.ТипОперации,
	|	СУММА(ВЫБОР
	|			КОГДА Статусы.Статус В (&СтатусыЗавершенныхВходящихОпераций)
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ),
	|	СУММА(ВЫБОР
	|			КОГДА Статусы.Статус В (&СтатусыОшибок)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ),
	|	0,
	|	СУММА(ВЫБОР
	|			КОГДА Статусы.Статус = &СтатусДокументОПриемкеОжидаетПодтверждения
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ)
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Операции
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК Статусы
	|		ПО Операции.Ссылка = Статусы.Операция
	|			И (Статусы.ТипСтатуса = &ОсновнойСтатус)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ДатыДокументов
	|		ПО Операции.Ссылка = ДатыДокументов.Объект
	|			И (ДатыДокументов.ИмяРеквизита = ""ДатаДокумента"")
	|ГДЕ
	|	&Организация
	|	И Операции.ТипОперации В(&ТипыВходящихОпераций)
	|	И ДатыДокументов.Значение МЕЖДУ &ДатаНачала И &ДатаОкончания
	|
	|СГРУППИРОВАТЬ ПО
	|	Операции.ТипОперации";
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ТекстУсловия = "Операции.Организация = &Организация";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Организация", ТекстУсловия);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Организация", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастройкиРабочегоСтола.ТипыДокументов) Тогда
		ТекстУсловия = "ЕСТЬNULL(НастройкиДокументов.Наименование, """") В (&ТипыДокументов)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипДокумента", ТекстУсловия);
		ЕстьОтборПоТипамДокументов = Истина;
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипДокумента", "ИСТИНА");
		ЕстьОтборПоТипамДокументов = Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаНачала", Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ТипыВходящихОпераций", ТипыВходящихОпераций());
	Запрос.УстановитьПараметр("ТипыИсходящихОпераций", ТипыИсходящихОпераций());
	Запрос.УстановитьПараметр("ЕстьОтборПоТипамДокументов", ЕстьОтборПоТипамДокументов);
	Запрос.УстановитьПараметр("ТипыДокументов", СписокТиповДокументовИзНастроек(НастройкиРабочегоСтола, Истина));
	Запрос.УстановитьПараметр("ПечатьКодов", ТипыОпераций.ПечатьКодов);
	Запрос.УстановитьПараметр("ОсновнойСтатус", "ОсновнойСтатус");
	Запрос.УстановитьПараметр("СтатусыЗавершенныхОпераций", МодульОбъекта().ЗавершенныеСтатусыОпераций());
	Запрос.УстановитьПараметр("СтатусыЗавершенныхВходящихОпераций", ЗавершенныеСтатусыВходящихОпераций());
	Запрос.УстановитьПараметр("СтатусыОшибок", СписокСтатусовОперацийСОшибками);
	Запрос.УстановитьПараметр("СтатусНовый", СтатусыОпераций.Новый);
	Запрос.УстановитьПараметр("СтатусОжидаетПеремаркировку", СтатусыОпераций.ОжидаетПеремаркировку);
	Запрос.УстановитьПараметр("СтатусДокументОПриемкеОжидаетПодтверждения", СтатусыОпераций.ДокументОПриемкеОжидаетПодтверждения);
	
	СброситьКоличественныеПоказатели();
	
	Показатели = КоличественныеПоказателиРабочегоСтола();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ИмяТипаОперации = ИмяОсновногоТипаОперации(Выборка.ТипОперации);
		
		Для Каждого ИмяПоказателя Из Показатели Цикл
			ИмяРеквизита = ИмяТипаОперации + "_" + ИмяПоказателя;
			Если МодульОбъекта().ЕстьРеквизитИлиСвойствоОбъекта_Марк(ЭтаФорма, ИмяРеквизита) Тогда
				ТекущееЗначение = ЭтаФорма[ИмяРеквизита];
				ЗначениеВыборки = Выборка[ИмяПоказателя];
				ЭтаФорма[ИмяРеквизита] = ТекущееЗначение + ЗначениеВыборки;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СписокТиповДокументовИзНастроек(НастройкиРабочегоСтола, ДобавитьПустойТип = Ложь)
	
	Результат = Новый СписокЗначений;
	
	Для Каждого НастройкаДокумента Из НастройкиРабочегоСтола.ТипыДокументов Цикл
		Результат.Добавить(Строка(НастройкаДокумента));
	КонецЦикла;
	
	Если ДобавитьПустойТип Тогда
		Результат.Добавить("");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура СброситьКоличественныеПоказатели()
	
	Показатели = КоличественныеПоказателиРабочегоСтола();
	
	ПодходящиеТипыОпераций = Новый Массив();
	МодульОбъекта().ДополнитьМассив(ПодходящиеТипыОпераций, ТипыВходящихОпераций());
	МодульОбъекта().ДополнитьМассив(ПодходящиеТипыОпераций, ТипыИсходящихОпераций());
	
	Для Каждого ТипОперации Из ПодходящиеТипыОпераций Цикл
		ИмяТипаОперации = ИмяОсновногоТипаОперации(ТипОперации);
		Для Каждого ИмяПоказателя Из Показатели Цикл
			ИмяРеквизита = ИмяТипаОперации + "_" +ИмяПоказателя;
			Если МодульОбъекта().ЕстьРеквизитИлиСвойствоОбъекта_Марк(ЭтаФорма, ИмяРеквизита) Тогда
				ЭтаФорма[ИмяРеквизита] = 0;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ИмяОсновногоТипаОперации(ТипОперации)
	
	Если СписокТиповОперацийОтчетаОНанесении.НайтиПоЗначению(ТипОперации) <> Неопределено Тогда
		Результат = "ОтчетОНанесении";
	ИначеЕсли СписокТиповОперацийОтчетаОВыбытии.НайтиПоЗначению(ТипОперации) <> Неопределено Тогда
		Результат = "ОтчетОВыбытии";
	ИначеЕсли СписокТиповОперацийВозвратаВОборот.НайтиПоЗначению(ТипОперации) <> Неопределено Тогда
		Результат = "ВозвратВОборот";
	Иначе
		Результат = СтрЗаменить(ТРег(ТипОперации), " ", "");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЗавершенныеСтатусыВходящихОпераций()
	
	Результат = Новый Массив;
	
	СтатусыОпераций = МодульОбъекта().Перечисление_СтатусыОпераций();
	Результат.Добавить(СтатусыОпераций.ОтправленВАрхив);
	Результат.Добавить(СтатусыОпераций.ОтГИСПолученоСообщениеОбОшибке);
	Результат.Добавить(СтатусыОпераций.ОшибкаОтправкиЗапросаСФайломВГИС);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ТипыВходящихОпераций()
	
	Результат = Новый Массив;
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	Результат.Добавить(ТипыОпераций.ВходящийУПД);
	Результат.Добавить(ТипыОпераций.УведомлениеОПриемке);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ТипыИсходящихОпераций()
	
	Результат = Новый Массив;
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	Результат.Добавить(ТипыОпераций.ЗаказКодов);
	Результат.Добавить(ТипыОпераций.ВводВОборот);
	Результат.Добавить(ТипыОпераций.РегистрацияАгрегатов);
	Результат.Добавить(ТипыОпераций.НаполнениеАгрегатовНаТСД);
	Результат.Добавить(ТипыОпераций.ПечатьКодов);
	Результат.Добавить(ТипыОпераций.ОтчетОНанесенииНаТСД);
	Результат.Добавить(ТипыОпераций.ОтчетОНанесении);
	Результат.Добавить(ТипыОпераций.СообщениеОбОтгрузке);
	Результат.Добавить(ТипыОпераций.ВыводИзОборота);
	Результат.Добавить(ТипыОпераций.ОтчетОВыбытии);
	Результат.Добавить(ТипыОпераций.ОтчетОВыбытииНаТСД);
	Результат.Добавить(ТипыОпераций.Перемаркировка);
	Результат.Добавить(ТипыОпераций.ВозвратВОборот);
	Результат.Добавить(ТипыОпераций.ВозвратВОборотНаТСД);
	Результат.Добавить(ТипыОпераций.КорректировкаСведенийОКодах);
	Результат.Добавить(ТипыОпераций.УведомлениеОСостоянииКодов);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбновитьПоказателиДокументов()
	
	НастройкиДокументов = МодульОбъекта().ДействующиеНастройкиДокументовУчета();
	
	Если ЗначениеЗаполнено(НастройкиРабочегоСтола.ТипыДокументов) Тогда
		Для Сч = -НастройкиДокументов.ВГраница() По 0 Цикл
			Настройка = НастройкиДокументов[-Сч];
			Если НастройкиРабочегоСтола.ТипыДокументов.Найти(Настройка.Ссылка) = Неопределено Тогда
				НастройкиДокументов.Удалить(-Сч);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиДокументов) Тогда
		Возврат;
	КонецЕсли;
	
	ТребуемыеДействия = МодульОбъекта().Перечисление_ТребуемыеДействияДокументовУчета();
	Статусы = МодульОбъекта().Перечисление_СтатусыДокументовУчета();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	МодульОбъекта().ТаблицаДокументов_ВТ_ДобавитьОрганизации1С(МенеджерВТ, Организация);
	МодульОбъекта().ТаблицаДокументов_ВТ_ДобавитьСклады1С(МенеджерВТ, Организация);
	
	ИменаТаблицДокументов = МодульОбъекта().ТаблицаДокументов_ВТ_ИменаТаблицДокументовУчета(
	МенеджерВТ, НастройкиДокументов, Период);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_КоличествоДокументовПоСтатусам(ИменаТаблицДокументов);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ТребуемоеДействие", ТребуемыеДействия.НачатьРаботу);
	Запрос.УстановитьПараметр("Статус", Статусы.Новый);
	
	ВыборкаТребуемыхДействий = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаТребуемыхДействий.Следующий() Цикл
		
		ОбновитьПоказателиДокументов_ЗаполнитьПоТребуемомуДействию(ВыборкаТребуемыхДействий, ТребуемыеДействия);
		
		ВыборкаСтатусов = ВыборкаТребуемыхДействий.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаСтатусов.Следующий() Цикл
			Если ВыборкаСтатусов.Статус = Статусы.Новый Тогда
				ДокументыУчета_КоличествоНовых = ДокументыУчета_КоличествоНовых + ВыборкаСтатусов.КоличествоДокументов;
				Продолжить;
			КонецЕсли;
			Если ВыборкаСтатусов.Статус = Статусы.ВРаботе Тогда
				ДокументыУчета_КоличествоВРаботе = ДокументыУчета_КоличествоВРаботе + ВыборкаСтатусов.КоличествоДокументов;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	МенеджерВТ.Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоказателиДокументов_ЗаполнитьПоТребуемомуДействию(ЗначенияВыборки, ТребуемыеДействия)
	
	ТребуемоеДействие = ЗначенияВыборки.ТребуемоеДействие;
	
	Если ТребуемоеДействие = ТребуемыеДействия.ИсправитьОшибку Тогда
		ДокументыУчета_КоличествоИсправить = ЗначенияВыборки.КоличествоДокументов;
	КонецЕсли;
		
	Если ТребуемоеДействие = ТребуемыеДействия.ПодобратьТовары Тогда
		ДокументыУчета_КоличествоПодобратьТовары = ЗначенияВыборки.КоличествоДокументов;
	КонецЕсли;
		
	Если ТребуемоеДействие = ТребуемыеДействия.НаполнитьКодами Тогда
		ДокументыУчета_КоличествоНаполнитьКодами = ЗначенияВыборки.КоличествоДокументов;
	КонецЕсли;
		
	Если ТребуемоеДействие = ТребуемыеДействия.ВвестиВОборот Тогда
		ДокументыУчета_КоличествоВвестиВОборот = ЗначенияВыборки.КоличествоДокументов;
	КонецЕсли;
		
	Если ТребуемоеДействие = ТребуемыеДействия.НапечататьЭтикетки Тогда
		ДокументыУчета_КоличествоНапечатать = ЗначенияВыборки.КоличествоДокументов;
	КонецЕсли;
		
	Если ТребуемоеДействие = ТребуемыеДействия.ОтчитатьсяОНанесении Тогда
		ДокументыУчета_КоличествоНанести = ЗначенияВыборки.КоличествоДокументов;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ТекстЗапроса_КоличествоДокументовПоСтатусам(ИменаТаблицДокументов)
	
	Результат = "";
	Разделитель = "";
	ТекстЗапроса = "";
	ПерваяНастройка = Истина;
	
	Для Каждого ИмяТаблицы Из ИменаТаблицДокументов Цикл
		
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(*) КАК КоличествоДокументов,
		|	ЕСТЬNULL(ОсновныеСтатусы.Статус, &Статус) КАК Статус,
		|	ЕСТЬNULL(ТребуемыеДействия.Статус, &ТребуемоеДействие) КАК ТребуемоеДействие
		|ИЗ
		|	ТекущаяТаблица КАК ТабДок
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета КАК ОсновныеСтатусы
		|		ПО (ОсновныеСтатусы.ДокументУчета = ТабДок.ДокументУчета)
		|			И (ОсновныеСтатусы.ТипСтатуса = ""ОсновнойСтатус"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета КАК ТребуемыеДействия
		|		ПО (ТребуемыеДействия.ДокументУчета = ТабДок.ДокументУчета)
		|			И (ТребуемыеДействия.ТипСтатуса = ""ТребуемоеДействие"")
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕСТЬNULL(ОсновныеСтатусы.Статус, &Статус),
		|	ЕСТЬNULL(ТребуемыеДействия.Статус, &ТребуемоеДействие)";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТекущаяТаблица", ИмяТаблицы);
		
		Если Не ПерваяНастройка Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ РАЗРЕШЕННЫЕ", "ВЫБРАТЬ");
		КонецЕсли;
		
		ПерваяНастройка = Ложь;
		Результат = Результат + Разделитель + ТекстЗапроса;
		Разделитель = МодульОбъекта().РазделительОбъединенияЗапроса();
		
	КонецЦикла;
	
	Результат = Результат + "
	|
	|ИТОГИ
	|	СУММА(КоличествоДокументов)
	|ПО
	|	ТребуемоеДействие,
	|	Статус";
	
	Возврат Результат;
	
КонецФункции

