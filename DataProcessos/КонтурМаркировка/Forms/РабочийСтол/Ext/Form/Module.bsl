	Результат = Результат + " (Контур.Маркировка)";
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПараметрыОткрытияСпискаДокументов(Статус = Неопределено, ТребуемоеДействие = Неопределено)
	
	Результат = Новый_ПараметрыОткрытияСписка();
	
	НастройкиКомпоновки = Новый НастройкиКомпоновкиДанных;
	Результат.ПараметрыОтбора = НастройкиКомпоновки.Отбор;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ЭлементОтбора = Результат.ПараметрыОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация");
		ЭлементОтбора.ПравоеЗначение = Организация;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Статус) Тогда
		ЭлементОтбора = Результат.ПараметрыОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Статус");
		ЭлементОтбора.ПравоеЗначение = Статус;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТребуемоеДействие) Тогда
		ЭлементОтбора = Результат.ПараметрыОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТребуемоеДействие");
		ЭлементОтбора.ПравоеЗначение = ТребуемоеДействие;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастройкиРабочегоСтола.ТипыДокументов) Тогда
		СписокТиповДокументов = СписокТиповДокументовИзНастроек(НастройкиРабочегоСтола);
		ЭлементОтбора = Результат.ПараметрыОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТипДокумента");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.ПравоеЗначение = СписокТиповДокументов;
	КонецЕсли;
	
	Результат.Период = Период;
	Результат.Заголовок = ЗаголовокФормыМодуля();
	Результат.КлючНазначенияИспользования = КлючНазначенияИспользованияФормыМодуля();
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПараметрыОткрытияСпискаОпераций(Знач ТипОперации
	, Статус = Неопределено
	, ВидСравненияСтатуса = Неопределено
	, ТребуемоеДействие = Неопределено
	, ВидСравненияТребуемогоДействия = Неопределено)
	
	Результат = Новый_ПараметрыОткрытияСписка();
	
	НастройкиКомпоновки = Новый НастройкиКомпоновкиДанных;
	Результат.ПараметрыОтбора = НастройкиКомпоновки.Отбор;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ЭлементОтбора = Результат.ПараметрыОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация");
		ЭлементОтбора.ПравоеЗначение = Организация;
	КонецЕсли;
	
	ЭлементОтбора = Результат.ПараметрыОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТипОперации");
	ЭлементОтбора.ПравоеЗначение = ТипОперации;
	Если ТипЗнч(ТипОперации) = Тип("СписокЗначений") Тогда
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ТипОперации = ТипОперации[0].Значение;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Статус) Тогда
		ЭлементОтбора = Результат.ПараметрыОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Статус");
		ЭлементОтбора.ПравоеЗначение = Статус;
		Если ВидСравненияСтатуса <> Неопределено Тогда
			ЭлементОтбора.ВидСравнения = ВидСравненияСтатуса;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТребуемоеДействие) Тогда
		ЭлементОтбора = Результат.ПараметрыОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТребуемоеДействие");
		ЭлементОтбора.ПравоеЗначение = ТребуемоеДействие;
		Если ВидСравненияТребуемогоДействия <> Неопределено Тогда
			ЭлементОтбора.ВидСравнения = ВидСравненияТребуемогоДействия;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастройкиРабочегоСтола.ТипыДокументов) Тогда
		
		СписокТиповДокументов = СписокТиповДокументовИзНастроек(НастройкиРабочегоСтола, Истина);
		
		ЭлементОтбора = Результат.ПараметрыОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТипДокумента");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.ПравоеЗначение = СписокТиповДокументов;
		
	КонецЕсли;
	
	Результат.Период = Период;
	Результат.Заголовок = ЗаголовокФормыМодуля(ТипОперации);
	Результат.КлючНазначенияИспользования = КлючНазначенияИспользованияФормыМодуля(ТипОперации);
	Результат.Вставить("КлючУникальности", Заголовок);
	
	Возврат Результат;
	
КонецФункции

