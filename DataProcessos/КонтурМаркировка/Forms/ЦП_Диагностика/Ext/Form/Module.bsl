&НаКлиентеНаСервереБезКонтекста
Функция РазбитьURL(URL)
	
	Результат = Новый Структура;
	Результат.Вставить("Сервер");
	Результат.Вставить("Путь", "");
	КоличествоСлеш = 2;
	
	Если Найти(URL, "://") > 0 Тогда
		Адрес = Прав(URL, СтрДлина(URL) - (Найти(URL, "://") + КоличествоСлеш));
	Иначе
		Адрес = URL;
	КонецЕсли;	
	
	Если Найти(Адрес, "/") > 0 Тогда
		Результат.Сервер = Лев(Адрес, Найти(Адрес, "/") - 1);
		Результат.Путь = Прав(Адрес, СтрДлина(Адрес) - Найти(Адрес, "/"));
	Иначе
		Результат.Сервер = Адрес;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // РазбитьURL

