&НаКлиенте
Функция СформироватьОтчетДиагностики(Диагностика)
	
	Результат = "";
	
	Результат = Результат + "Ошибок: " + Диагностика.КоличествоОшибок + Символы.ПС;
	Результат = Результат + "Предупреждений: " + Диагностика.КоличествоПредупреждений + Символы.ПС + Символы.ПС;
	
	// Метаданные
	
	Результат = Результат + "Метаданные:" + Символы.ПС + _ОтчетМетаданные(Диагностика);
	Результат = Результат + Символы.ПС + Символы.ПС;
	
	// Необходимые роли
	
	Результат = Результат + _СформироватьОтчетНедоступныхМетаданных(Диагностика);
	Результат = Результат + Символы.ПС + Символы.ПС;
	
	// СоединениеHTTP
	
	Результат = Результат + "СоединениеHTTP:" + Символы.ПС + _ОтчетСоединениеHTTP(Диагностика);
	Результат = Результат + Символы.ПС + Символы.ПС;
	
	// МенеджерКриптографии
	
	Результат = Результат + "МенеджерКриптографии:" + Символы.ПС + _ОтчетМенеджерКриптографии(Диагностика);
	Результат = Результат + Символы.ПС + Символы.ПС;
	
	Возврат Результат;
	
КонецФункции // СформироватьОтчетДиагностики

&НаКлиентеНаСервереБезКонтекста
Функция _СформироватьОтчетНедоступныхМетаданных(Диагностика)
	
	ЗаголовокОтчета = "Недостаточно прав для работы Контур.Экстерн" + Символы.ПС + Символы.ПС;
	ПодвалОтчета = "Обратитесь к администратору, для добавление прав";
	Отчет = "";
	
	Для Каждого Элемент Из Диагностика.Протокол Цикл
		
		Если Элемент.Тип <> "Метаданные" Или ПравДостаточно(Элемент) Тогда
			Продолжить;
		КонецЕсли;
		
		УведомлениеПоПравам = """" + Элемент.ОбъектПроверки + """" + Символы.ПС + УведомлениеПоНеобходимымРолям(Элемент);
		Отчет = Отчет + УведомлениеПоПравам;
		
	КонецЦикла;
	
	Если Отчет <> "" Тогда
		Отчет = ЗаголовокОтчета + Отчет + ПодвалОтчета;
	КонецЕсли;
	
	Возврат Отчет;
	
КонецФункции // _СформироватьОтчетНедоступныхМетаданных

&НаКлиентеНаСервереБезКонтекста
Функция ПравДостаточно(Диагностика)
	
	Результат = Ложь;
	
	Для Каждого Право Из Диагностика.ПраваДоступа Цикл
		Результат = Право.Результат = Истина;
		Если Результат = Ложь Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ПравДостаточно

&НаКлиентеНаСервереБезКонтекста
Функция УведомлениеПоНеобходимымРолям(Диагностика)
	
	ПроверяемыеПраво = "";
	ЛишниеСимволы = 2;
	Для Каждого Право Из Диагностика.ПраваДоступа Цикл
		ПроверяемыеПраво = ПроверяемыеПраво + Право.Имя + ", ";
	КонецЦикла;
	ПроверяемыеПраво = Лев(ПроверяемыеПраво, СтрДлина(ПроверяемыеПраво) - ЛишниеСимволы);
	
	Результат =  "Роли с правами " + ПроверяемыеПраво + ":" + Символы.ПС;	
	НеобходимыеРоли = "";
	
	Для Каждого Роль Из Диагностика.Роли Цикл
		НеобходимыеРоли = НеобходимыеРоли + "- " + Роль + Символы.ПС;
	КонецЦикла;
	
	Результат = Результат + НеобходимыеРоли + Символы.ПС;
	
	Возврат Результат;
	
КонецФункции // УведомлениеПоНеобходимымРолям

//#КонецОбласти

