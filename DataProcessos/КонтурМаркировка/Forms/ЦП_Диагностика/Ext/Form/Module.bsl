&НаКлиенте
Функция ДиагностикаБазовая() Экспорт
	
	Модель = Новый Структура;
	Модель.Вставить("Тип");
	Модель.Вставить("Контекст");
	
	Возврат Модель;
	
КонецФункции // ДиагностикаБазовая

