&НаКлиенте
Функция ДиагностикаМенеджераКриптографииКлиент(Диагностика)
	
	МенеджерКриптографии = Неопределено;
	Результат = РезультатДиагностикиКлиентСервер();
	Результат.Вставить("Контекст", Диагностика.Контекст);
	Результат.Вставить("ХранилищеСертификатов");
	
	Результат.Тип = "МенеджерКриптографии";
	Результат.ОбъектПроверки = Диагностика.ИмяМодуляКриптографии;
	
	Попытка
		МенеджерКриптографии = Новый МенеджерКриптографии(Диагностика.ИмяМодуляКриптографии, 
			Диагностика.ПутьМодуляКриптографии,
			Диагностика.ТипМодуляКриптографии);
		Результат.РезультатПроверки = Истина;
	Исключение
		Результат.РезультатПроверки = Ложь;
		Результат.Ошибка = Истина;
		Результат.Примечание = ОписаниеОшибки();
	КонецПопытки;
	
	Если МенеджерКриптографии = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипХранилища 		  = ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты;	
	РасположениеХранилища = РасположениеХранилищаСертификатовКриптографии.ДанныеПользователяОС;
	
	Попытка
		ХранилищеСертификатов_ = МенеджерКриптографии.ПолучитьХранилищеСертификатов(ТипХранилища, РасположениеХранилища);
		Сертификаты = ХранилищеСертификатов_.ПолучитьВсе();
		Результат.ХранилищеСертификатов = Истина;
	Исключение
		Результат.ХранилищеСертификатов = Ложь;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции // ДиагностикаМенеджераКриптографииКлиент

