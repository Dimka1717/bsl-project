&НаКлиенте
Функция КоличествоОшибокПротокола(Протокол)
	
	Результат = 0;
	
	Для Каждого Элемент Из Протокол Цикл
		Если Элемент.Ошибка = Истина Тогда
			Результат = Результат + 1;
		КонецЕсли;
		Если Элемент.Тип = "Метаданные" Тогда
			Результат = Результат + Число(Не ПравДостаточно(Элемент));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // КоличествоОшибокПротокола

