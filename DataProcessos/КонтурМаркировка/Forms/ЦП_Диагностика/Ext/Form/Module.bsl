&НаСервере
Функция ДиагностикаМетаданных(Диагностика)
	
	Метаданные_ = Метаданные.НайтиПоПолномуИмени(Диагностика.ПолныйПуть);
	
	Если Метаданные_ = Неопределено Тогда
		Для Каждого Синоним Из Диагностика.Синонимы Цикл
			Метаданные_ = Метаданные.НайтиПоПолномуИмени(Синоним);	
			Если Метаданные_ <> Неопределено Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Результат = РезультатДиагностикиКлиентСервер();
	Результат.Вставить("ПраваДоступа", Новый Массив);
	Результат.Вставить("Роли", Новый Массив);
	
	Результат.Тип = "Метаданные";
	Результат.ОбъектПроверки = Диагностика.ПолныйПуть;	
	Результат.РезультатПроверки = Метаданные_ <> Неопределено;
	Результат.Ошибка = Метаданные_ = Неопределено; 
	
	Если Метаданные_ = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Право Из Диагностика.ПраваДоступа Цикл
		РезультатПрава = РезультатПроверкиПрав(Право);
		Попытка
			РезультатПрава.Результат = ПравоДоступа(Право, Метаданные_);	 
		Исключение
			РезультатПрава.Результат = "Права не существует: """ + Право + """";
		КонецПопытки;
		Если РезультатПрава.Результат = Ложь Тогда
			Результат.Роли = ПраваМетаданныхНаСервере(Метаданные_, Диагностика.ПраваДоступа);
		КонецЕсли;
		Результат.ПраваДоступа.Добавить(РезультатПрава);
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции // ДиагностикаМетаданных

&НаКлиенте
Функция ДиагностикаСоединенийHTTP(Диагностика)
	
	// TODO Сделать прокси
	Если Диагностика.Контекст = "Клиент" Тогда
		Результат = ДиагностикаСоединенийHTTPКлиент(Диагностика);
	ИначеЕсли Диагностика.Контекст = "Сервер" Тогда
		Результат = ДиагностикаСоединенийHTTPСервер(Диагностика);
	Иначе
		ВызватьИсключение "Не предполагаемый контекст диагностики: " + Диагностика.Контекст;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ДиагностикаСоединенийHTTP

&НаКлиенте
Функция ДиагностикаСоединенийHTTPКлиент(Диагностика)
	
	КодОшибкаСервере = 500;
	СтруктураURL = РазбитьURL(Диагностика.Адрес);
	
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	Соединение = Новый HTTPСоединение(СтруктураURL.Сервер,,,,, Диагностика.Таймаут, 
		ЗащищенноеСоединение);
		
	HTTPЗапрос = Новый HTTPЗапрос(СтруктураURL.Путь);
	
	Результат = РезультатДиагностики();
	Результат.Вставить("Контекст", Диагностика.Контекст);
	Результат.Тип = "СоединениеHTTP";
	Результат.ОбъектПроверки = Диагностика.Адрес;
	
	Попытка
		Ответ = Соединение.ВызватьHTTPМетод(Диагностика.Метод, HTTPЗапрос);
		Результат.РезультатПроверки = "Успешно";
		Результат.Примечание = "Код: " + Ответ.КодСостояния;
		Если Ответ.КодСостояния >= КодОшибкаСервере Тогда
			Результат.РезультатПроверки = "Успешно. Сервер не доступен";
			Результат.Предупреждение = Истина;
		КонецЕсли;
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		Результат.РезультатПроверки = "Ошибка";
		результат.Ошибка = Истина;
		Результат.Примечание = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции // ДиагностикаСоединенийHTTPКлиент

