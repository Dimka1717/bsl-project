&НаСервереБезКонтекста
Функция ПраваМетаданныхНаСервере(Метаданные_, МассивПрав) Экспорт
	
	Результат = Новый Массив;
	
	Для Каждого Роль Из Метаданные.Роли Цикл
		ПравоДоступно = Истина;
		Для Каждого Право Из МассивПрав Цикл
			Попытка
				ПравоДоступно = ПравоДоступа(Право, Метаданные_, Роль);
			Исключение
				ПравоДоступа = Ложь;
			КонецПопытки;
			Если ПравоДоступно = Ложь Тогда 
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ПравоДоступно = Истина Тогда 
			Результат.Добавить(Роль.Представление());
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ПраваМетаданныхНаСервере

