&НаКлиенте
Функция ВыполнитьДиагностики(МассивДиагностик) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Протокол", Новый Массив);
	Результат.Вставить("КоличествоОшибок", 0);
	Результат.Вставить("КоличествоПредупреждений", 0);
	
	Для Каждого Диагностика Из МассивДиагностик Цикл
		
		Если Диагностика.Тип = "Метаданные" Тогда
			Результат.Протокол.Добавить(ДиагностикаМетаданных(Диагностика));
		ИначеЕсли Диагностика.Тип = "СоединениеHTTP" Тогда
			Результат.Протокол.Добавить(ДиагностикаСоединенийHTTP(Диагностика));
		ИначеЕсли Диагностика.Тип = "МенеджерКриптографии" Тогда
			Результат.Протокол.Добавить(ДиагностикаМенеджераКриптографии(Диагностика));	
		Иначе
			Результат.Протокол.Добавить(ДиагностикаОтсутствует(Диагностика));
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.КоличествоОшибок = КоличествоОшибокПротокола(Результат.Протокол);
	Результат.КоличествоПредупреждений = КоличествоПредупрежденийПротокола(Результат.Протокол);
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции // ВыполнитьДиагностики

&НаКлиенте
Функция ПраваМетаданных(Метаданные_, МассивПрав) Экспорт
	
 	Возврат ПраваМетаданныхНаСервере(Метаданные_ , МассивПрав);
	
КонецФункции // ПраваМетаданных

&НаКлиенте
Функция СформироватьОтчет(Диагностика, ВариантОтчета) Экспорт
	
	Если ВариантОтчета = "Текстовый" Тогда
		
		Результат = СформироватьОтчетДиагностики(Диагностика);
		
	ИначеЕсли ВариантОтчета = "НедоступныеМетаданные" Тогда
		
		Результат = _СформироватьОтчетНедоступныхМетаданных(Диагностика);
				
	Иначе
		
		ВызватьИсключение "Непредполагаемый вариант отчета";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // СформироватьОтчет

