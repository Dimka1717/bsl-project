	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТоварыДокумента.ПредставлениеСтроки КАК СтрокаДокумента,
	|	КодыМаркировки.КодМаркировки КАК КодМаркировки,
	|	ЕСТЬNULL(ТоварыАгрегатов.Товар, ИнформацияОКодах.Товар) КАК Товар,
	|	ЕСТЬNULL(ТоварыАгрегатов.КлючНоменклатуры1С, ИнформацияОКодах.КлючНоменклатуры1С) КАК КлючНоменклатуры1С,
	|	ЕСТЬNULL(ТоварыАгрегатов.КоличествоУпаковок, 0) КАК КоличествоУпаковок,
	|	КодыДокументов.КлючКода КАК КлючКода,
	|	КодыДокументов.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	СтатусыКодов.Владелец КАК Владелец,
	|	СтатусыКодов.Статус КАК СтатусКода,
	|	ВЫБОР
	|		КОГДА ИнформацияОКодах.ДатаПечати > &ПустаяДата
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Напечатан,
	|	ЛОЖЬ КАК УровеньАгрегата,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ТоварыДокумента.КлючСтрокиДокумента, &ПустойКлюч) = &ПустойКлюч
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьСтрокаДокумента
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ПО КодыДокументов.КлючСтрокиДокумента = ТоварыДокумента.КлючСтрокиДокумента
	|			И (ТоварыДокумента.Ссылка = &ДокументУчета)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ТоварыАгрегатов КАК ТоварыАгрегатов
	|		ПО КодыДокументов.КлючКода = ТоварыАгрегатов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО КодыДокументов.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО КодыДокументов.КлючКода = СвязиКлючейКодов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (СвязиКлючейКодов.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|		ПО (СвязиКлючейКодов.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода)
	|ГДЕ
	|	КодыДокументов.ДокументУчета = &ДокументУчета
	|	И ИнформацияОКодах.ОбщийТипУпаковки = &ТранспортнаяУпаковка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕстьСтрокаДокумента УБЫВ,
	|	СтрокаДокумента,
	|	КодМаркировки
	|ИТОГИ
	|	МАКСИМУМ(ЕстьСтрокаДокумента),
	|	МАКСИМУМ(СтрокаДокумента),
	|	МАКСИМУМ(КодМаркировки),
	|	СУММА(КоличествоУпаковок),
	|	МАКСИМУМ(КлючСтрокиДокумента),
	|	МАКСИМУМ(Владелец),
	|	МАКСИМУМ(СтатусКода),
	|	МАКСИМУМ(Напечатан)
	|ПО
	|	КлючКода");
	
	Запрос.УстановитьПараметр("ДокументУчета", Ссылка);
	Запрос.УстановитьПараметр("ПустаяДата", МодульОбъекта().ПустаяДата());
	Запрос.УстановитьПараметр("ПустойКлюч", МодульОбъекта().ПустойУникальныйИдентификатор());
	Запрос.УстановитьПараметр("ТранспортнаяУпаковка", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	
	АгрегатыСТоварами = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	Для Каждого СтрАгрегата Из АгрегатыСТоварами.Строки Цикл
		СтрАгрегата.УровеньАгрегата = Истина;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(АгрегатыСТоварами, "Агрегаты");
	
	ПосчитатьКоличествоСтрокТаблицФормы();
	
	СписокАгрегатовЗаполнен = Истина;
	
КонецПроцедуры

