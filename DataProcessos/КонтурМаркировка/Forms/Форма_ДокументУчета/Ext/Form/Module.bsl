
// #Область СлужебныеПеременныеИМетодыФормы

&НаКлиенте
Перем КэшМодуляКлиента;

&НаСервере
Функция МодульОбъекта()
	
	Возврат ВзаимодействиеКонтурМаркировка.МодульКонтурМаркировка();
	
КонецФункции

&НаКлиенте
Функция МодульКлиента() Экспорт
	
	Если КэшМодуляКлиента <> Неопределено Тогда
		Возврат КэшМодуляКлиента;
	КонецЕсли;
	
	Если ТипЗнч(ВладелецФормы) = ТипЗнч(ЭтаФорма) Тогда
		Результат = ВладелецФормы.МодульКлиента();
	Иначе
		ПутьКФорме = ПутьКФормеМодуляКлиента();
		Результат = ОткрытьФорму(ПутьКФорме);
	КонецЕсли;
	
	КэшМодуляКлиента = Результат;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПутьКФормеМодуляКлиента()
	
	Возврат МодульОбъекта().ПутьКФормеМодуляКлиента();
	
КонецФункции

// #КонецОбласти // СлужебныеПеременныеИМетодыФормы

// #Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Ссылка = Параметры.Ссылка;
	
	МодульОбъекта().ДокументУчета_ИзвлечьКодыИзАрхива(Ссылка);
	
	ЗаполнитьКонтекстФормы();
	НастроитьЭлементыФормы();
	УстановитьЗаголовки();
	ЗаполнитьСпискиВыбораЭлементовФормы();
	НастроитьКартинкиКомандФормы();
	НастроитьВидимостьКомандФормы();
	НастроитьВидимостьЭлементовФормы(Истина);
	НастроитьСписокКодыМаркировки();
	ПроверитьТоварыМаркировки();
	УстановитьУсловноеОФормление();
	ОбновитьРезультатПроверкиКодов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьПодсказку();
	УстановитьОтборПоказатьСписанныеКодыМаркировки();
	ПроверитьВыполнениеОбменаССервисом();
	ОбновитьСтатусОбновленияСтатусовКодовПриОткрытии();
	ОбновитьСтатусПроверкиКодовПриОткрытии();
	
	ПодключитьОбработчикОжидания("ПослеОткрытия", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОткрытия() Экспорт
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("КоличествоКодов", КоличествоКодов);
	ДопПараметры.Вставить("КоличествоАгрегатов", КоличествоАгрегатов);
	ДопПараметры.Вставить("КоличествоОпераций", КоличествоОпераций);
	ДопПараметры.Вставить("КоличествоТоваровДокумента", КоличествоТоваровДокумента);
	Действие = МодульКлиента().Перечисление_ДействияМетрики().Замер_ОткрытиеФормыДокументаУчета;
	МодульКлиента().ЗавершитьЗамерПроизводительности(Действие, ДопПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	МодульКлиента().СохранитьИзмененияНаФорме("ЗаписатьИЗакрыть", ЭтаФорма, Отказ, ЗавершениеРаботы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурМаркировка_Операция_Изменен" Тогда
		ЗаполнитьКонтекстФормы();
		ПроверитьТоварыМаркировки();
		НастроитьВидимостьЭлементовФормы();
	КонецЕсли;
		
	Если ИмяСобытия = "КонтурМаркировка_КодыВДокументах_Изменен" И Параметр = Ссылка Тогда
		УдалитьРезультатыПроверкиКодов();
		ПосчитатьКоличествоСтрокТаблицФормы();
		ОбновитьСпискиКодовИАгрегатов();
	КонецЕсли;
	
	Если ИмяСобытия = "КонтурМаркировка_Операция_КоличествоЗСНИзменено" И Параметр = Ссылка Тогда
		ОбновитьСписокКодовМаркировки();
	КонецЕсли;
	
	Если ИмяСобытия = "КонтурМаркировка_ПринудительноЗакрытьМодуль" Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
	
	Если ИмяСобытия = "КонтурМаркировка_ИзмененРежимТехническогоСпециалиста" Тогда
		НастроитьВидимостьПодменюТехническогоСпециалиста(Параметр);
	КонецЕсли;
	
	Если ИмяСобытия = "КонтурМаркировка_СменитьВладельца" И Источник = ВладелецФормы Тогда
		ВладелецФормы = Параметр;
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти // ОбработчикиСобытийФормы

// #Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ТоварыМаркировки_Добавить(Команда)
	
	ПараметрыФормы = Новый Структура;
	МодульКлиента().ОткрытьФормуОбработки("Форма_Товары_Список", ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыМаркировки_НайтиПоРеквизитам(Команда)
	
	СтрокаДокумента = Элементы.ТоварыДокумента.ТекущиеДанные;
	Если СтрокаДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПодобратьТоварыМаркировки(СтрокаДокумента.КлючСтрокиДокумента) Тогда
		Элементы.ТоварыМаркировки.Обновить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КодыМаркировки_УказатьСтрокуДокумента(Команда)
	
	ТекущиеДанные = Элементы.КодыМаркировки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
	"КодыМаркировки_ПослеВыбораСтрокиДокумента", ЭтаФорма);
	
	МодульКлиента().ПоказатьДиалогВыбораИзСписка(ОписаниеОбработчика
	, СписокСтрокДокумента()
	, Элементы.КодыМаркировкиСтрокаДокумента
	, ЭтаФорма
	, ТекущиеДанные.КлючСтрокиДокумента);
	
КонецПроцедуры

&НаСервере
Процедура КодыМаркировки_УстановитьКлючСтрокиДокументаНаСервере(НовыйКлючСтрокиДокумента)
	
	ТаблицаКодов = МодульОбъекта().Новый_ТаблицаКодов();
	Для каждого Стр Из Элементы.КодыМаркировки.ВыделенныеСтроки Цикл
		ТаблицаКодов.Добавить().КлючКода = Стр.КлючКода;
	КонецЦикла;
	ТаблицаКодов.ЗаполнитьЗначения(НовыйКлючСтрокиДокумента, "КлючСтрокиДокумента");
	
	МодульОбъекта().КодыДокументов_Записать(ТаблицаКодов, Ссылка, Ложь, Истина);
	
	ОбновитьСписокКодовМаркировки();
	
КонецПроцедуры

&НаКлиенте
Процедура Агрегаты_УказатьСтрокуДокумента(Команда)
	
	ТекДанные = Элементы.Агрегаты.ТекущиеДанные;
	Если ТекДанные = Неопределено
		Или Не ТекДанные.УровеньАгрегата Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
	"Агрегаты_ПослеВыбораСтрокиДокумента", ЭтаФорма);
	
	МодульКлиента().ПоказатьДиалогВыбораИзСписка(ОписаниеОбработчика
	, СписокСтрокДокумента()
	, Элементы.АгрегатыСтрокаДокумента
	, ЭтаФорма
	, ТекДанные.КлючСтрокиДокумента);
	
КонецПроцедуры

&НаКлиенте
Процедура Агрегаты_УказатьНоменклатуру1С(Команда)
	
	ТекДанные = Элементы.Агрегаты.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("Агрегаты_ПослеВыбораКлючаНоменклатуры1С", ЭтаФорма);
	
	МодульКлиента().ОткрытьФормуВыбораКлючаНоменклатуры1С(ОписаниеОбработчика, ТекДанные.КлючНоменклатуры1С, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура Агрегаты_Обновить(Команда)
	
	ОбновитьСписокАгрегатов();
	ПосчитатьКоличествоСтрокТаблицФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура Агрегаты_СортироватьПоВозрастанию(Команда)
	
	Если Не ЗначениеЗаполнено(Агрегаты.ПолучитьЭлементы()) Тогда
		Возврат;
	КонецЕсли;
	
	Элемент = Элементы.Агрегаты.ТекущийЭлемент;
	Если Элемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКолонки = СтрЗаменить(Элемент.Имя, "Агрегаты", "");
	
	Агрегаты_Сортировать(ИмяКолонки, "Возр");
	
КонецПроцедуры

&НаКлиенте
Процедура Агрегаты_СортироватьПоУбыванию(Команда)
	
	Если Не ЗначениеЗаполнено(Агрегаты.ПолучитьЭлементы()) Тогда
		Возврат;
	КонецЕсли;
	
	Элемент = Элементы.Агрегаты.ТекущийЭлемент;
	Если Элемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКолонки = СтрЗаменить(Элемент.Имя, "Агрегаты", "");
	
	Агрегаты_Сортировать(ИмяКолонки, "Убыв");
	
КонецПроцедуры

&НаКлиенте
Процедура Товары_НеПодлежитМаркировке(Команда)
	
	СтрокаДокумента = Элементы.ТоварыДокумента.ТекущиеДанные;
	Если СтрокаДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НеПодлежитМаркировке = Не СтрокаДокумента.НеПодлежитМаркировке;
	Элементы.Кнопка_ТоварНеПодлежитМаркировке.Пометка = НеПодлежитМаркировке;
	
	Для каждого ИдентификаторСтроки Из Элементы.ТоварыДокумента.ВыделенныеСтроки Цикл
		Стр = ТоварыДокумента.НайтиПоИдентификатору(ИдентификаторСтроки);
		Стр.НеПодлежитМаркировке = НеПодлежитМаркировке;
		МодульКлиента().УстановитьПризнакНоменклатурыНеПодлежитМаркировке(Стр.Номенклатура, НеПодлежитМаркировке);
	КонецЦикла;
	
	ОбновитьТекстОстатка();
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументУчета_Перезаполнить(Команда)
	
	ДокументУчета_ПерезаполнитьНаСервере();
	
	УстановитьПодсказку();
	
	Оповестить("КонтурМаркировка_ДокументУчета_Перезаполнен", Документ1С);
	
	Элементы.КодыМаркировки.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура ДокументУчета_ПерезаполнитьНаСервере()
	
	МодульОбъекта().ДокументУчета_Перезаполнить(Ссылка, Документ1С);
	
	ЗаполнитьКонтекстФормы();
	ОбновитьСписокАгрегатов();
	ПроверитьТоварыМаркировки();
	
	НастроитьВидимостьЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда = Неопределено, ДопПараметры = Неопределено) Экспорт
	
	Записать();
	ПровестиОпросПользователяИЗакрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументУчета_ЗавершитьРаботу(Команда)
	
	Если Не ПроверитьВозможностьЗавершитьРаботу() Тогда
		ТоварыДокумента_СообщитьОбОшибках();
		Возврат;
	КонецЕсли;
	
	Статусы.ОсновнойСтатус = МодульКлиента().Перечисление_СтатусыДокументовУчета().Завершен;
	
	ЗаписатьИЗакрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументУчета_ЗавершитьРаботуПропустить(Команда)
	
	Статусы.ОсновнойСтатус = МодульКлиента().Перечисление_СтатусыДокументовУчета().Пропущен;
	Статусы.ТребуемоеДействие = МодульКлиента().Перечисление_ТребуемыеДействияДокументовУчета().РаботаЗавершена;
	
	ЗаписатьИЗакрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументУчета_ВозобновитьРаботу(Команда)
	
	СтатусыДокументовУчета = МодульКлиента().Перечисление_СтатусыДокументовУчета();
	
	Если Статусы.ОсновнойСтатус = СтатусыДокументовУчета.Пропущен Тогда
		Статусы.ОсновнойСтатус = СтатусыДокументовУчета.Новый;
	ИначеЕсли Статусы.ОсновнойСтатус = СтатусыДокументовУчета.Завершен Тогда
		Статусы.ОсновнойСтатус = СтатусыДокументовУчета.ВРаботе;
	Иначе
		ВызватьИсключение НСтр("ru = 'Невозможно возобновить работу документа со статусом: '") + Статусы.ОсновнойСтатус;
	КонецЕсли;
	
	Записать();
	
	НастроитьВидимостьКомандФормы();
	НастроитьВидимостьЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументУчета_НачатьРаботу(Команда)
	
	Если Не ПроверитьЗаполнениеПолей() Тогда
		Возврат;
	КонецЕсли;
	
	Статусы.ОсновнойСтатус = МодульКлиента().Перечисление_СтатусыДокументовУчета().ВРаботе;
	
	Записать();
	
	НастроитьВидимостьКомандФормы();
	НастроитьВидимостьЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументУчета_Удалить(Команда)
	
	Если ЕстьКодыВДокументе() Или ЗначениеЗаполнено(СписокОпераций) Тогда
		ТекстВопроса = НСтр("ru = 'Документ, операции и коды товаров будут удалены, продолжить?'");
		ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("ДокументУчета_УдалитьПослеСогласия", ЭтаФорма);
		МодульКлиента().ПоказатьДиалогВопроса(ОписаниеОбработчика, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ДокументУчета_УдалитьПослеСогласия(КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументУчета_УдалитьПослеСогласия(Ответ, ДопПараметры = Неопределено) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	МодульКлиента().ДокументУчета_Удалить(Ссылка);
	
	Ссылка = Неопределено;
	Модифицированность = Ложь;
	
	Оповестить("КонтурМаркировка_ДокументУчета_Удален", Документ1С);
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура НаполнитьКодамиНаТСДНачатьРаботу(Команда)
	
	Если ЕстьКодыВДокументе() Или ЗначениеЗаполнено(ТоварыМаркировки) Тогда
		ТекстВопроса = НСтр("ru = 'Сопоставленные товары маркировки будут очищены, продолжить?'");
		ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
		"НаполнитьКодамиНаТСДНачатьРаботуПослеСогласия", ЭтаФорма);
		МодульКлиента().ПоказатьДиалогВопроса(ОписаниеОбработчика, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		НаполнитьКодамиНаТСДНачатьРаботуПослеСогласия(КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Задачи_Обновить(Команда)
	
	ОбновитьСписокОпераций();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбменССервисом(Команда)
	
	Если Модифицированность Тогда
		ТекстВопроса = НСтр("ru = 'Необходимо сохранить изменения, продолжить?'");
		Обработчик = МодульКлиента().ОписаниеОбработчикаОповещения("ВыполнитьОбменПослеСогласияСохранения", ЭтаФорма);
		МодульКлиента().ПоказатьДиалогВопроса(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗапуститьОбменССервисом();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбменПослеСогласияСохранения(Ответ, ДопПараметры = Неопределено) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Записать();
	
	ЗапуститьОбменССервисом();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьОбменССервисом()
	
	Если Не МодульКлиента().ПроверитьУстановленнуюВерсиюМодуля() Тогда
		Возврат;
	КонецЕсли;
	
	МодульКлиента().ЗапуститьОбменПоОрганизации(ЭтаФорма, Организация, Ссылка);
	
	ОбновитьСтатусОбменаССервисом();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВыполнениеОбменаССервисом()
	
	Если МодульКлиента().ОбменССервисомВыполняется(Ссылка) Тогда
		МодульКлиента().НастроитьКнопкуОбменаССервисом(Элементы.Кнопка_ВыполнитьОбмен, Истина);
		ПодключитьОбработчикОжидания("ОбновитьСтатусОбменаССервисом", 5, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусОбменаССервисом() Экспорт
	
	ОбменССервисомВыполняется = МодульКлиента().ОбменССервисомВыполняется(Ссылка);
	
	МодульКлиента().НастроитьКнопкуОбменаССервисом(Элементы.Кнопка_ВыполнитьОбмен, ОбменССервисомВыполняется);
	
	Если ОбменССервисомВыполняется Тогда
		ПодключитьОбработчикОжидания("ОбновитьСтатусОбменаССервисом", 5, Истина);
	Иначе
		ЗаполнитьКонтекстФормы();
		ОбновитьСписокАгрегатов();
		ПроверитьТоварыМаркировки();
		НастроитьКартинкиКомандФормы();
		НастроитьВидимостьЭлементовФормы();
		МодульКлиента().ОбработатьОшибкиОбменаССервисом(ЭтаФорма, Организация, Ссылка);
	КонецЕсли;
	
КонецПроцедуры

