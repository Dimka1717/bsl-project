Процедура ОбновитьСтатусПроверкиКодов() Экспорт
	
	ПроверкаКодовВыполняется = МодульКлиента().ПроверкаКодовДокументаВыполняется(Ссылка);
	
	НастроитьКнопкуПроверкиКодов(ПроверкаКодовВыполняется);
	
	Если ПроверкаКодовВыполняется Тогда
		ИнтервалОжидания = 5;
		ПодключитьОбработчикОжидания("ОбновитьСтатусПроверкиКодов", ИнтервалОжидания, Истина);
	Иначе
		ОбновитьРезультатПроверкиКодов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОтчетОбОшибкахРД(Команда)
	
	ОтчетОбОшибкахРД = ОтчетОбОшибкахРазрешительнойДокументации();
	
	Если ОтчетОбОшибкахРД = Неопределено Тогда
		ТекстПредупреждения = НСтр("ru = 'Не найдено результатов проверки.'");
		МодульКлиента().ПоказатьДиалогПредупреждения(ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	ОтчетОбОшибкахРД.ОтображатьСетку = Ложь;
	ОтчетОбОшибкахРД.ОтображатьЗаголовки = Ложь;
	ОтчетОбОшибкахРД.ТолькоПросмотр = Истина;
	ОтчетОбОшибкахРД.Показать("Коды с ошибками разрешительной документации (Контур.Маркировка)");
	
КонецПроцедуры

&НаСервере
Функция ОтчетОбОшибкахРазрешительнойДокументации()
	
	ТипыФайлов = МодульОбъекта().Перечисление_ТипыФайлов();
	ФайлРезультата = МодульОбъекта().Файл_Найти(Ссылка, ТипыФайлов.РезультатПроверкиРД);
	
	Если ЗначениеЗаполнено(ФайлРезультата) Тогда
		ОписаниеФайла = МодульОбъекта().Файл_Прочитать(ФайлРезультата);
		КодыСОшибками = ОписаниеФайла.ДанныеФайла;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ФайлРезультата) Или Не ЗначениеЗаполнено(КодыСОшибками) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый ТабличныйДокумент;
	
	Макет = МодульОбъекта().ПолучитьМакет("ОтчетОбОшибкахРазрешительнойДокументации");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.ПредставлениеДокумента = Ссылка;
	Результат.Вывести(ОбластьШапка);
	
	ОбластьСтрокаКода = Макет.ПолучитьОбласть("СтрокаКода");
	Для Каждого КодМаркировки Из КодыСОшибками Цикл
		ОбластьСтрокаКода.Параметры.КодМаркировки = КодМаркировки;
		Результат.Вывести(ОбластьСтрокаКода);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // ОбработчикиКомандФормы

