	КонецЕсли;
	
	КодыДобавлены = ЗагрузитьКодыИзДругогоДокументаНаСервере(РезультатВыбора);
	
	Если Не КодыДобавлены Тогда
		Возврат;
	КонецЕсли;
	
	Если ДопПараметры.НачатьРаботу Тогда
		Документ_НачатьРаботу();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьКодыИзДругогоДокументаНаСервере(ДругойДокумент1C)
	
	КодыДобавлены = МодульОбъекта().КодыДокументов_ПодобратьИзДругогоДокумента(Ссылка, ДругойДокумент1C);
	
	Если КодыДобавлены Тогда
		УдалитьРезультатыПроверкиКодов();
		ПосчитатьКоличествоСтрокТаблицФормы();
		ОбновитьСпискиКодовИАгрегатов();
	КонецЕсли;
	
	Возврат КодыДобавлены;
	
КонецФункции

&НаКлиенте
Процедура УстановитьНовоеКоличествоТоваровМаркировки(СтрокаДокумента)
	
	КлючСтрокиДокумента = СтрокаДокумента.КлючСтрокиДокумента;
	
	ПодходящиеСтроки = ТоварыМаркировки.НайтиСтроки(Новый Структура("КлючСтрокиДокумента", КлючСтрокиДокумента));
	Если ПодходящиеСтроки.Количество() <> 1 Тогда
		Возврат;
	КонецЕсли;
	
	Стр = ПодходящиеСтроки[0];
	Стр.КоличествоУпаковок = СтрокаДокумента.КоличествоУпаковок;
	СтрокаДокумента.КоличествоПодобрано = КоличествоУпаковокТоваровМаркировки(КлючСтрокиДокумента, ЭтаФорма);
	
	ОбновитьТекстОстатка();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьКодыИзФайлов(НачатьРаботу = Ложь)
	
	Если Не МодульКлиента().ВыполнитьАвторизацию(Организация, ЭтаФорма) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыВыбораФайлов = МодульКлиента().Новый_ПараметрыДиалогаВыбораФайла();
	ПараметрыВыбораФайлов.Заголовок = НСтр("ru = 'Выберите файл(ы) для загрузки кодов маркировки в документ учета'");
	ДополнитьПараметрыВыбораПередЗагрузкойКодовИзФайлов(ПараметрыВыбораФайлов);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("НачатьРаботу", НачатьРаботу);
	ДопПараметры.Вставить("ПараметрыДиалогаВыбора", ПараметрыВыбораФайлов);
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
	"ЗагрузитьКодыИзФайловПослеВыбораФайлов", ЭтаФорма, ДопПараметры);
	
	МодульКлиента().ПоказатьДиалогВыбораФайла(ОписаниеОбработчика, ПараметрыВыбораФайлов);
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьПараметрыВыбораПередЗагрузкойКодовИзФайлов(ПараметрыВыбораФайлов)
	
	МодульОбъекта().ДокументУчета_ПередЗагрузкойКодовИзФайлов(ПараметрыВыбораФайлов, Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьКодыИзФайловПослеВыбораФайлов(ВыбранныеФайлы, ДопПараметры) Экспорт 
	
	Если Не ЗначениеЗаполнено(ВыбранныеФайлы) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыДиалога = ДопПараметры.ПараметрыДиалогаВыбора;
	ОписанияФайлов = МодульКлиента().ОписанияФайлов(ВыбранныеФайлы);
	КодыЗагружены = ЗагрузитьКодыИзФайловНаСервере(ОписанияФайлов, ПараметрыДиалога);
	
	Если Не КодыЗагружены Тогда
		Возврат;
	КонецЕсли;
	
	Если ДопПараметры.НачатьРаботу Тогда
		Документ_НачатьРаботу();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьКодыИзФайловНаСервере(ОписанияФайлов, ПараметрыВыбораФайлов)
	
	КодыЗагружены = МодульОбъекта().КодыДокументов_ЗагрузитьИзФайлов(Ссылка, ОписанияФайлов, ПараметрыВыбораФайлов);
	
	Если КодыЗагружены Тогда
		УдалитьРезультатыПроверкиКодов();
		ПосчитатьКоличествоСтрокТаблицФормы();
		ОбновитьСпискиКодовИАгрегатов();
	КонецЕсли;
	
	Возврат КодыЗагружены;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуЗагрузкиКодов(РежимСканера = Ложь, ДляУдаления = Ложь)
	
	Если Не МодульКлиента().ВыполнитьАвторизацию(Организация, ЭтаФорма) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДляУдаления Тогда
		Обработчик = МодульКлиента().ОписаниеОбработчикаОповещения("УдалитьКодыСПомощьюТабличногоДокументаПослеУказанияКодов", ЭтаФорма);
	Иначе
		Обработчик = МодульКлиента().ОписаниеОбработчикаОповещения("НаполнитьКодамиИзТабличногоДокументаПослеУказанияКодов", ЭтаФорма);
	КонецЕсли;
	
	МодульКлиента().ОткрытьФормуЗагрузкиКодов(ЭтаФорма, Обработчик, РежимСканера, ДляУдаления);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьКодыСПомощьюТабличногоДокументаПослеУказанияКодов(Результат, ДопПараметры = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов = ПолучитьИзВременногоХранилища(Результат.АдресТаблицыКодов);
	МодульОбъекта().ТаблицаКодов_ЗаполнитьКлючиКодов(ТаблицаКодов);
	КлючиКодов = ТаблицаКодов.ВыгрузитьКолонку("КлючКода");
	
	МодульОбъекта().КодыДокументов_УдалитьКоды(Ссылка, КлючиКодов);
	
	УдалитьРезультатыПроверкиКодов();
	ПосчитатьКоличествоСтрокТаблицФормы();
	ОбновитьСпискиКодовИАгрегатов();
	
КонецПроцедуры

&НаКлиенте
Процедура НаполнитьКодамиИзТабличногоДокументаПослеУказанияКодов(Результат, ДопПараметры = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	КодыДобавлены = НаполнитьКодамиИзТабличногоДокументаНаСервере(Результат);
	Если Не КодыДобавлены Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Документ", Ссылка);
		
		МодульКлиента().ОткрытьФормуОбработкиМодально("Форма_РедакторКодов", ЭтаФорма, ПараметрыФормы);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НаполнитьКодамиИзТабличногоДокументаНаСервере(Результат) Экспорт
	
	КодыДобавлены = МодульОбъекта().КодыДокументов_ДобавитьИзТабличногоДокумента_Сканера(Ссылка, Результат);
	
	Если КодыДобавлены Тогда
		УдалитьРезультатыПроверкиКодов();
		ПосчитатьКоличествоСтрокТаблицФормы();
		ОбновитьСпискиКодовИАгрегатов();
	КонецЕсли;
	
	Возврат КодыДобавлены;
	
КонецФункции

&НаКлиенте
Процедура ТоварыДокумента_СообщитьОбОшибках()
	
	Для Каждого Стр Из ТоварыДокумента Цикл
		Если ЗначениеЗаполнено(Стр.СообщениеОбОшибке) Тогда
			МодульКлиента().СообщитьОбОшибкеВСтрокеТабЧасти(Стр.СообщениеОбОшибке, УникальныйИдентификатор
			, Элементы.ТоварыДокумента, "Номенклатура", ТоварыДокумента.Индекс(Стр));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПодсказку()
	
	ПодсказкаВыполняетсяОбновленияДанных = ПодсказкаВыполняетсяОбновлениеДанных();
	
	ТекстПодсказки = "";
	Разделитель = "";
	
	Если ЗначениеЗаполнено(ПодсказкаВыполняетсяОбновленияДанных) Тогда
		ТекстПодсказки = ТекстПодсказки + Разделитель + ПодсказкаВыполняетсяОбновленияДанных;
		Разделитель = Символы.ПС;
	КонецЕсли;
	
	ПодсказкаОСУАнтисептики = ПодсказкаОСУАнтисептики1ГруппыПлатности();
	Если ЗначениеЗаполнено(ПодсказкаОСУАнтисептики) Тогда
		ТекстПодсказки = ТекстПодсказки + Разделитель + ПодсказкаОСУАнтисептики;
	КонецЕсли;
	
	Элементы.ТекстПодсказки.Заголовок = ТекстПодсказки;
	Элементы.ГруппаПодсказки.Видимость = ЗначениеЗаполнено(ТекстПодсказки);
	
КонецПроцедуры

&НаКлиенте
Функция ПодсказкаВыполняетсяОбновлениеДанных()
	
	Результат = "";
	
	Если ВыполняетсяОбновлениеДанных Тогда
		Результат = НСтр("ru = 'Работа с объектом заблокирована. Выполняется обновление данных.'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПодсказкаОСУАнтисептики1ГруппыПлатности()
	
	Результат = "";
	
	Если ДокументУчета_СодержитАнтисептикиОСУ() Тогда
		Результат = 
		НСтр("ru='Для антисептиков передача кодов в УПД в объемно-сортовом учете допускается только для товаров, введенных в оборот до 1.09.2025.'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

