	ЕстьЗначения = Ложь;
	
	Для Каждого Стр ИЗ ТоварыДокумента Цикл
		Если ЗначениеЗаполнено(Стр[ИмяКолонки]) Тогда
			ЕстьЗначения = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Элементы["Товары"+ИмяКолонки].Видимость = ЕстьЗначения;
	
КонецПроцедуры

