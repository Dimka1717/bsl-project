&НаКлиенте
Функция СписокСтрокДокумента()
	
	Результат = Новый СписокЗначений;
	
	Результат.Добавить(Неопределено, "<Очистить>");
	
	Для Каждого Стр Из ТоварыДокумента Цикл
		Если Стр.НеПодлежитМаркировке = Ложь Тогда
			Результат.Добавить(Стр.КлючСтрокиДокумента, Стр.ПредставлениеСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЕстьКодыВДокументе()
	
	Возврат МодульОбъекта().КодыДокументов_ЕстьКоды(Ссылка);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция КоличествоУпаковокТоваровМаркировки(КлючСтрокиДокумента, Форма)
	
	МассивСтрок = Форма.ТоварыМаркировки.НайтиСтроки(Новый Структура("КлючСтрокиДокумента", КлючСтрокиДокумента));
	
	Результат = 0;
	Для Каждого Стр Из МассивСтрок Цикл
		Результат = Результат + Стр.КоличествоУпаковок;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СтрокаДокументаПоКлючуСтроки(КлючСтрокиДокумента)
	
	МассивСтрок = ТоварыДокумента.НайтиСтроки(Новый Структура("КлючСтрокиДокумента", КлючСтрокиДокумента));
	
	Если Не ЗначениеЗаполнено(МассивСтрок) Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось найти строку документа по ключу: '") + КлючСтрокиДокумента;
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат МассивСтрок[0];
	
КонецФункции

&НаКлиенте
Процедура ОбновитьТекстОстатка()
	
	ТекСтрока = Элементы.ТоварыДокумента.ТекущиеДанные;
	
	Если НЕ ТекСтрока = Неопределено Тогда
		
		Если ТекСтрока.НеПодлежитМаркировке Тогда
			
			ТекстОстатокПодбора = "Номенклатура не подлежит маркировке";
			//Элементы.ТекстОстатокПодбора.ЦветТекста = Новый Цвет(51,51,51);
			//Элементы.ТекстОстатокПодбора.ЦветФона = Новый Цвет(240,240,240);
			
			Элементы.ТоварыМаркировки.ТолькоПросмотр = Истина;
			Элементы.Кнопка_НайтиТоварПоРеквизитам.Доступность = Ложь;
			
		Иначе
			
			Остаток = ТекСтрока.КоличествоУпаковок - ТекСтрока.КоличествоПодобрано;
			Если Остаток > 0 Тогда
				ТекстОстатокПодбора = "Осталось подобрать: "+Остаток;
				//Элементы.ТекстОстатокПодбора.ЦветТекста = Новый Цвет(83,106,194);
				//Элементы.ТекстОстатокПодбора.ЦветФона = Новый Цвет(255,255,255);
			ИначеЕсли Остаток < 0 Тогда
				ТекстОстатокПодбора = "Уберите лишний товар: "+(-1*Остаток);
				//Элементы.ТекстОстатокПодбора.ЦветТекста = Новый Цвет(255,0,0);
				//Элементы.ТекстОстатокПодбора.ЦветФона = Новый Цвет(255,240,240);
			Иначе
				ТекстОстатокПодбора = "Товары подобраны";
				//Элементы.ТекстОстатокПодбора.ЦветТекста = Новый Цвет(47,80,80);
				//Элементы.ТекстОстатокПодбора.ЦветФона = Новый Цвет(240,255,240);
			КонецЕсли;
			
			Элементы.ТоварыМаркировки.ТолькоПросмотр = Ложь;
			Элементы.Кнопка_НайтиТоварПоРеквизитам.Доступность = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТекстСообщенияОбОшибке()
	
	ТекущиеДанные = Элементы.ТоварыДокумента.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ТекстСообщениеОбОшибке = "";
	Иначе
		ТекстСообщениеОбОшибке = ТекущиеДанные.СообщениеобОшибке;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьСоообщениеОбОшибкеВСтроке(СтрокаДокумента)
	
	СтрокаДокумента.СообщениеОбОшибке = "";
	СтрокаДокумента.ИндексКартинки = -1;
	
КонецПроцедуры

&НаКлиенте
Процедура Записать()
	
	Если Не МодульКлиента().ПроверитьУстановленнуюВерсиюМодуля() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполнениеРеквизитов() Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьНаСервере();
	
	Оповестить("КонтурМаркировка_ДокументУчета_Изменен", Ссылка);
	
	ОповеститьОбИзменении(Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьКодыДокументаИСохранить()
	
	ДокументУчета_СброситьКодыИСохранитьНаСервере();
	
	Модифицированность = Ложь;
	
	Оповестить("КонтурМаркировка_ДокументУчета_Изменен", Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ДокументУчета_СброситьКодыИСохранитьНаСервере()
	
	МодульОбъекта().КодыДокументов_Записать(МодульОбъекта().Новый_ТаблицаКодов(), Ссылка);
	
	ЗаписатьНаСервере();
	
	НастроитьВидимостьКомандФормы();
	НастроитьВидимостьЭлементовФормы();
	
КонецПроцедуры

&НаСервере
Функция ДокументУчета_СодержитАнтисептикиОСУ(КлючСтрокиДокумента = Неопределено)
	
	Результат = Ложь;
	ПравилаОтраженияВЭДО = МодульОбъекта().Перечисление_ПравилаОтраженияВЭДО();
	
	Отбор = Новый Структура("ОтражениеВЭДО, КлючСтрокиДокумента", ПравилаОтраженияВЭДО.ОСУ, "");
	
	Для Каждого СтрДок Из ТоварыМаркировки Цикл
		
		Если Не МодульОбъекта().ЭтоТоварАнтисептикиГруппаПлатности1(СтрДок.Товар) Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента;
		ТоварыСтроки = ТоварыДокумента.НайтиСтроки(Отбор);
		
		Если ЗначениеЗаполнено(ТоварыСтроки) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПроверитьЗаполнениеПолей(Знач ОписаниеДокумента = Неопределено)
	
	Если ОписаниеДокумента = Неопределено Тогда
		ОписаниеДокумента = ОписаниеДокументаПоДаннымФормы();
	КонецЕсли;
	
	ОшибкиЗаполнения = МодульОбъекта().ДокументУчета_ПроверитьЗаполнениеПолей(ОписаниеДокумента);
	МодульОбъекта().СообщитьОбОшибкахЗаполнения(ЭтаФорма, ОшибкиЗаполнения);
	
	Возврат Не ЗначениеЗаполнено(ОшибкиЗаполнения);
	
КонецФункции

&НаКлиенте
Процедура СообщитьОбОшибкахЗаполнения(ОшибкиЗаполнения)
	
	Для Каждого ОписаниеОшибки Из ОшибкиЗаполнения Цикл
		Если ЗначениеЗаполнено(ОписаниеОшибки.ИмяТаблицы) Тогда
			ТаблицаФормы = Элементы[ОписаниеОшибки.ИмяТаблицы];
			ИндексСтроки = ОписаниеОшибки.НомерСтроки - 1;
			МодульКлиента().СообщитьОбОшибкеВСтрокеТабЧасти(ОписаниеОшибки.ТекстОшибки
			, УникальныйИдентификатор, ТаблицаФормы, ОписаниеОшибки.ИмяПоля, ИндексСтроки);
		Иначе
			МодульКлиента().СообщитьПользователюЛок(ОписаниеОшибки.ТекстОшибки, УникальныйИдентификатор, ОписаниеОшибки.ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНаСервере()
	
	ОписаниеДокумента = ОписаниеДокументаПоДаннымФормы();
	
	НачатьТранзакцию(МодульОбъекта().РежимУправленияБлокировкой());
	
	Попытка
		
		СохранитьСвязиНоменклатуры();
		СохранитьКоэффициентыПересчета();
		
		МодульОбъекта().ДокументУчета_Записать(ОписаниеДокумента);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	ЗаполнитьКонтекстФормы();
	
	ПроверитьТоварыМаркировки();
	
	Модифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Функция ОписаниеДокументаПоДаннымФормы()
	
	Результат = МодульОбъекта().Новый_ДокументУчета();
	
	ЗаполнитьЗначенияСвойств(Результат, ЭтаФорма, , "ТоварыДокумента, ТоварыМаркировки");
	ЗаполнитьЗначенияСвойств(Результат.ДопРеквизиты, ЭтаФорма);
	
	Для Каждого Стр Из ТоварыДокумента Цикл
		ЗаполнитьЗначенияСвойств(Результат.ТоварыДокумента.Добавить(), Стр);
	КонецЦикла;
	
	Для Каждого Стр Из ТоварыМаркировки Цикл
		СтрокиДок = ТоварыДокумента.НайтиСтроки(Новый Структура("КлючСтрокиДокумента", Стр.КлючСтрокиДокумента));
		Если ЗначениеЗаполнено(СтрокиДок) И СтрокиДок[0].НеПодлежитМаркировке = Ложь Тогда
			ЗаполнитьЗначенияСвойств(Результат.ТоварыМаркировки.Добавить(), Стр);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПроверитьВозможностьЗавершитьРаботу()
	
	ЕстьОшибки = Ложь;
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	ОперацииПечати = МодульОбъекта().ДокументУчета_СписокОпераций(Ссылка, ТипыОпераций.ПечатьКодов);
	Если ЗначениеЗаполнено(ОперацииПечати) Тогда
		Ошибка = МодульОбъекта().Новый_ОшибкаЗаполнения("СписокОпераций");
		Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо завершить операции печати'");
		МодульОбъекта().СообщитьОбОшибкахЗаполнения(ЭтаФорма, Ошибка);
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	ОписаниеДокумента = ОписаниеДокументаПоДаннымФормы();
	
	Если Не ПроверитьЗаполнениеПолей(ОписаниеДокумента) Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если Не ПроверитьТоварыМаркировки(ОписаниеДокумента) Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если МодульОбъекта().ДокументУчета_ЕстьРольКорректировкаОтгрузки(ОписаниеДокумента)
		И Не МодульОбъекта().ДокументУчета_ПроверитьСопоставлениеКодов(Ссылка) Тогда
		Ошибка = МодульОбъекта().Новый_ОшибкаЗаполнения("КодыМаркировки");
		Ошибка.ТекстОшибки = НСтр("ru = 'Не все коды сопоставлены со строками документа. Выполните сопоставление и затем завершите работу с документом'");
		МодульОбъекта().СообщитьОбОшибкахЗаполнения(ЭтаФорма, Ошибка);
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Возврат Не ЕстьОшибки;
	
КонецФункции

&НаСервере
Функция ПроверитьТоварыМаркировки(Знач ОписаниеДокумента = Неопределено)
	
	Если ОписаниеДокумента = Неопределено Тогда
		ОписаниеДокумента = ОписаниеДокументаПоДаннымФормы();
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	
	ОшибкиGTIN = МодульОбъекта().ДокументУчета_ПроверитьТоварыМаркировки(ОписаниеДокумента);
	Для Каждого СтрокаДокумента Из ТоварыДокумента Цикл
		
		ОписаниеОшибки = МодульОбъекта().МассивСтруктур_Найти(ОшибкиGTIN, СтрокаДокумента.НомерСтроки, "НомерСтроки");
		
		Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
			СтрокаДокумента.СообщениеОбОшибке = ОписаниеОшибки.ТекстОшибки;
			СтрокаДокумента.ИндексКартинки = 2;
			ЕстьОшибки = Истина;
		Иначе
			ОчиститьСоообщениеОбОшибкеВСтроке(СтрокаДокумента);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьОшибки Тогда
		МодульОбъекта().Метрика_Функциональность_ОшибкиПроверкиGTINВДокументеУчета(Организация);
	КонецЕсли;
	
	Возврат Не ЕстьОшибки;
	
КонецФункции

&НаСервере
Процедура СохранитьСвязиНоменклатуры()
	
	Для Каждого Стр Из ТоварыМаркировки Цикл
		
		Если Не Стр.ДобавленВручную Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.Товар)
			Или Не ЗначениеЗаполнено(Стр.КоличествоУпаковок) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиДокумента = ТоварыДокумента.НайтиСтроки(Новый Структура("КлючСтрокиДокумента", Стр.КлючСтрокиДокумента));
		Если Не ЗначениеЗаполнено(СтрокиДокумента) Тогда
			Возврат;
		КонецЕсли;
		
		СтрДок = СтрокиДокумента[0];
		Если СтрДок.НеПодлежитМаркировке Тогда
			Продолжить;
		КонецЕсли;
		
		МодульОбъекта().СвязьНоменклатуры_Добавить(Стр.Товар
		, СтрДок.КлючНоменклатуры1С);
		
		Стр.ДобавленВручную = Ложь;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьКоэффициентыПересчета()
	
	Для Каждого Стр Из ТоварыДокумента Цикл
		
		Если Не Стр.РучнойВводКоличества
			Или Стр.НеПодлежитМаркировке Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.КоличествоУпаковок)
			Или Не ЗначениеЗаполнено(Стр.Количество) Тогда
			Продолжить;
		КонецЕсли;
		
		Числитель = Стр.КоличествоУпаковок;
		Знаменатель = Стр.Количество;
		КлючНоменклатуры1С = Стр.КлючНоменклатуры1С;
		
		МодульОбъекта().КоэффициентПересчета_Записать(КлючНоменклатуры1С, Числитель, Знаменатель);
		МодульОбъекта().Метрика_Функциональность_ЗаписьКоэффициентаПересчетаВДокументе();
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПосчитатьКоличествоСтрокТаблицФормы()
	
	КоличествоОпераций = СписокОпераций.Количество();
	КоличествоТоваровДокумента = ТоварыДокумента.Количество();
	КоличествоКодов = МодульОбъекта().КодыДокументов_ОбщееКоличествоТоварныхКодов(Ссылка);
	КоличествоАгрегатов = МодульОбъекта().КодыДокументов_ОбщееКоличествоТранспортныхУпаковок(Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьКодыИзВходящегоУПД()
	
	Если Не МодульКлиента().ВыполнитьАвторизацию(Организация, ЭтаФорма) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Отбор", Новый Структура);
	ПараметрыФормы.Отбор.Вставить("Организация", Организация);
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
	"ЗагрузитьКодыИзВходящегоУПДПослеВыбораУПД", ЭтаФорма);
	
	МодульКлиента().ОткрытьФормуВыбораВходящегоУПД(ОписаниеОбработчика, ЭтаФорма, ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьКодыИзВходящегоУПДПослеВыбораУПД(РезультатВыбора, ДопПараметры = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(РезультатВыбора) Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьКодыИзВходящегоУПДНаСервере(РезультатВыбора);
	
