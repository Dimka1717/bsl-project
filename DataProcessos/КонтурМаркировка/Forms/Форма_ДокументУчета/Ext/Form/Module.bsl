&НаСервере
Функция ТекстЗапросаКодыМаркировки()
	
	Возврат
	
	"ВЫБРАТЬ
	|	КодыДокументов.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	КодыДокументов.КлючКода КАК КлючКода,
	|	КодыМаркировки.КодМаркировки КАК КодМаркировки,
	|	КодыМаркировки.ЗаводскойСерийныйНомер КАК ЗаводскойСерийныйНомер,
	|	ИнформацияОКодах.Товар КАК Товар,
	|	ИнформацияОКодах.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	ИнформацияОКодах.ОбщийТипУпаковки КАК ОбщийТипУпаковки,
	|	ЕСТЬNULL(ТоварыДокумента.ПредставлениеСтроки, """") КАК СтрокаДокумента,
	|	ЕСТЬNULL(СтатусыКодов.Статус, """") КАК СтатусКода,
	|	ЕСТЬNULL(СтатусыКодов.Владелец, &ПустойКонтрагент) КАК Владелец,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ИнформацияОКодах.ДатаПечати, &ПустаяДата) > &ПустаяДата
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Напечатан,
	|	ЕСТЬNULL(ИнформацияОКодах.НомерПартии, """") КАК НомерПартии
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО КодыДокументов.КлючКода = КодыМаркировки.КлючКода
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО КодыДокументов.КлючКода = СвязиКлючейКодов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|		ПО (СвязиКлючейКодов.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (СвязиКлючейКодов.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)}
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ПО КодыДокументов.КлючСтрокиДокумента = ТоварыДокумента.КлючСтрокиДокумента
	|			И (ТоварыДокумента.Ссылка = &ДокументУчета)
	|ГДЕ
	|	КодыДокументов.ДокументУчета = &ДокументУчета
	|	И ИнформацияОКодах.ОбщийТипУпаковки <> ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка)
	|	И (&ПоказатьСписанные
	|			ИЛИ ЕСТЬNULL(СтатусыКодов.Статус, """") <> &СтатусКода_Списан)";
	
КонецФункции

&НаКлиенте
Функция ПроверитьЗаполнениеРеквизитов()
	
	ЕстьОшибки = Ложь;
	
	ПроверитьФорматНомераПартии(ЕстьОшибки);
	
	Возврат Не ЕстьОшибки;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьФорматНомераПартии(ЕстьОшибки)
	
	// Допустимые символы
	Буквы = МодульКлиента().ВсеБуквыКириллицы() + МодульКлиента().ВсеБуквыЛатиницы();
	Цифры = МодульКлиента().ВсеЦифры();
	СпецСимволы = " .,-/";
	ДопустимыеСимволы = Буквы + Цифры + СпецСимволы;
	ДопустимаяДлинаНомера = 49;
	
	ТекстОшибкиПревышениеДлины = НСтр("ru = 'Длина номера партии не должна превышать %1 символов'");
	ТекстОшибкиПревышениеДлины = МодульКлиента().ПараметрыВСтроку(ТекстОшибкиПревышениеДлины, ДопустимаяДлинаНомера);
	
	ТекстОшибкиНедопустимыеСимволы = НСтр("ru = 'Номер партии содержит недопустимые символы'");
	
	Для каждого СтрТов Из ТоварыМаркировки Цикл
		Если Не СтрТов.ДоступенПартионныйУчет Тогда
			Продолжить;
		КонецЕсли;
		Если СтрДлина(СтрТов.НомерПартии) > ДопустимаяДлинаНомера Тогда
			МодульКлиента().СообщитьОбОшибкеВСтрокеТабЧасти(ТекстОшибкиПревышениеДлины, УникальныйИдентификатор
			, Элементы.ТоварыМаркировки, "НомерПартии", ТоварыМаркировки.Индекс(СтрТов));
			ЕстьОшибки = Истина;
		КонецЕсли;
		Если Не МодульКлиента().СтрокаСодержитТолькоДопустимыеСимволы(СтрТов.НомерПартии, ДопустимыеСимволы) Тогда
			МодульКлиента().СообщитьОбОшибкеВСтрокеТабЧасти(ТекстОшибкиНедопустимыеСимволы, УникальныйИдентификатор
			, Элементы.ТоварыМаркировки, "НомерПартии", ТоварыМаркировки.Индекс(СтрТов));
			ЕстьОшибки = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварыАгрегатовИзГИСМТ()
	
	ТаблицаКодов = МодульОбъекта().КодыДокументов_ТранспортныеУпаковки(Ссылка);
	
	МодульОбъекта().ТоварыАгрегатов_ЗаполнитьИзГИСМТ(ТаблицаКодов, Организация);
	
	ОбновитьСписокАгрегатов();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВложенныеКодыАгрегатовИзГИСМТ()
	
	ТаблицаКодов = МодульОбъекта().КодыДокументов_ТранспортныеУпаковки(Ссылка);
	
	МодульОбъекта().ТаблицаКодов_ЗаполнитьВложенныеКодыИзГИСМТ(ТаблицаКодов, Организация);
	
