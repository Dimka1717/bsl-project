&НаКлиенте
Процедура АгрегатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные;
	
	Если Поле = Элементы.АгрегатыКодМаркировки Тогда
		СтандартнаяОбработка = Ложь;
		Если ЗначениеЗаполнено(ТекДанные.КлючКода) Тогда
			МодульКлиента().ОткрытьФормуКодаМаркировки(ТекДанные.КлючКода, Организация, ЭтаФорма);
		КонецЕсли;
	КонецЕсли;
		
	Если Поле = Элементы.АгрегатыСтрокаДокумента Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если ТолькоПросмотр Тогда
			Возврат;
		КонецЕсли;
		
		Если Не ТекДанные.УровеньАгрегата Тогда
			Возврат;
		КонецЕсли;
		
		ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("Агрегаты_ПослеВыбораСтрокиДокумента", ЭтаФорма);
		
		МодульКлиента().ПоказатьДиалогВыбораИзСписка(ОписаниеОбработчика
		, СписокСтрокДокумента()
		, Элемент
		, ЭтаФорма
		, ТекДанные.КлючСтрокиДокумента);
		
	КонецЕсли;
		
	Если Поле = Элементы.АгрегатыКлючНоменклатуры1С Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если ТолькоПросмотр Тогда
			Возврат;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекДанные.Товар) Тогда
			Возврат;
		КонецЕсли;
		
		ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("Агрегаты_ПослеВыбораКлючаНоменклатуры1С", ЭтаФорма);
		
		МодульКлиента().ОткрытьФормуВыбораКлючаНоменклатуры1С(ОписаниеОбработчика, ТекДанные.КлючНоменклатуры1С, ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

