Процедура УстановитьОтборПоказатьСписанныеКодыМаркировки()
	
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("ПоказатьСписанные"
	, Элементы.Кнопка_ПоказатьСписанныеКоды.Пометка);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьЭлементовФормы(ПриСозданииНаСервере = Ложь)
	
	Если ПриСозданииНаСервере Тогда
		
		Если МодульОбъекта().ДокументУчета_ЕстьРолиДляСведенийОМаркировке(Ссылка) Тогда
			Элементы.ТоварыОтражениеВЭДО.Видимость = Истина;
		КонецЕсли;
		
		Если МодульОбъекта().ДокументУчета_ЕстьРольКорректировкаОтгрузки(Ссылка) Тогда
			Элементы.ГруппаКорректировка.Видимость = Истина;
			Элементы.Кнопка_НаполнитьКодамиИзИсправляемогоДокумента.Видимость = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	СтатусыДокументовУчета = МодульОбъекта().Перечисление_СтатусыДокументовУчета();
	
	Элементы.ТоварыНоменклатура.Ширина = 10;
	
	Элементы.Документ1С.Видимость = ЗначениеЗаполнено(Документ1С);
	
	ТребуютсяЗСН = ТоварыДокумента_ТребуютсяЗаводскиеСерийныеНомера(ЭтаФорма);
	ДоступенПартионныйУчет = ТоварыМаркировки_ДоступенПартионныйУчет(ЭтаФорма);
	
	УстановитьТолькоПросмотр(Ложь);
	
	Если Статусы.ОсновнойСтатус = СтатусыДокументовУчета.Новый Тогда
		
		Элементы.Кнопка_НачатьРаботу.КнопкаПоУмолчанию		= Истина;
		Элементы.Кнопка_НачатьРаботу.Видимость				= Истина;
		
		Элементы.Кнопка_Перезаполнить.Видимость				= ЗначениеЗаполнено(Документ1С);
		Элементы.Кнопка_НеПодлежитМаркировке.Видимость		= Истина;
		Элементы.Кнопка_ЗавершитьРаботу.Видимость			= Ложь;
		Элементы.Кнопка_Записать.Видимость					= Истина;
		Элементы.Кнопка_ВозобновитьРаботу.Видимость			= Ложь;
		
		Элементы.ГруппаТоваровМаркировки.ТолькоПросмотр = Ложь;
		Элементы.ТоварыМаркировкиГруппаКнопок.Доступность = Истина;
		
		Элементы.Закладка_Операции.Видимость = Ложь;
		
		Элементы.Меню_ПодобратьКодыНачатьРаботу.Видимость = Истина;
		Элементы.Меню_ПодобратьКоды.Видимость = Ложь;
		Элементы.Меню_УдалитьКоды.Видимость = Ложь;
		Элементы.Кнопка_ВыполнитьОбмен.Видимость = Ложь;
		Элементы.Кнопка_ОбновитьЗадачи.Видимость = Ложь;
		Элементы.Закладка_КодыМаркировки.Видимость = Ложь;
		Элементы.Закладка_Агрегаты.Видимость = Ложь;
		Элементы.Кнопка_СообщитьОбОтгрузке.Видимость = Ложь;
		Элементы.ТоварыКоличествоКодов.Видимость = Ложь;
		Элементы.ТоварыКоличествоУпаковок.ТолькоПросмотр = Ложь;
		Элементы.ТоварыКоличествоЗСН.Видимость = Ложь;
		Элементы.КодыМаркировкиЗаводскойСерийныйНомер.Видимость = Ложь;
		Элементы.КодыМаркировкиНомерПартии.Видимость = ДоступенПартионныйУчет;
		Элементы.Кнопка_ДобавитьЗСН.Видимость = Ложь;
		Элементы.ТоварыМаркировкиНомерПартии.Видимость = Ложь;
		Элементы.Кнопка_ПроверитьКоды.Видимость = Ложь;
		
	ИначеЕсли Статусы.ОсновнойСтатус = СтатусыДокументовУчета.Пропущен Тогда
		
		Элементы.Кнопка_НачатьРаботу.Видимость				= Ложь;
		Элементы.Кнопка_Перезаполнить.Видимость				= Ложь;
		Элементы.Кнопка_НеПодлежитМаркировке.Видимость = Ложь;
		Элементы.Кнопка_ЗавершитьРаботу.Видимость			= Ложь;
		Элементы.Кнопка_Записать.Видимость					= Ложь;
		Элементы.Кнопка_ВозобновитьРаботу.Видимость			= Истина;
		
		Элементы.ГруппаТоваровМаркировки.ТолькоПросмотр = Истина;
		Элементы.ТоварыМаркировкиГруппаКнопок.Доступность = Ложь;
		
		Элементы.Закладка_Операции.Видимость = Ложь;
		
		Элементы.Меню_ПодобратьКодыНачатьРаботу.Видимость = Ложь;
		Элементы.Меню_ПодобратьКоды.Видимость = Ложь;
		Элементы.Меню_УдалитьКоды.Видимость = Ложь;
		Элементы.Кнопка_ВыполнитьОбмен.Видимость = Ложь;
		Элементы.Кнопка_ОбновитьЗадачи.Видимость = Ложь;
		Элементы.Закладка_КодыМаркировки.Видимость = Ложь;
		Элементы.Закладка_Агрегаты.Видимость = Ложь;
		Элементы.Кнопка_СообщитьОбОтгрузке.Видимость = Ложь;
		Элементы.ТоварыКоличествоКодов.Видимость = Ложь;
		Элементы.ТоварыКоличествоУпаковок.ТолькоПросмотр = Ложь;
		Элементы.ТоварыКоличествоЗСН.Видимость = Ложь;
		Элементы.КодыМаркировкиЗаводскойСерийныйНомер.Видимость = Ложь;
		Элементы.Кнопка_ДобавитьЗСН.Видимость = Ложь;
		Элементы.ТоварыМаркировкиНомерПартии.Видимость = Ложь;
		Элементы.Кнопка_ПроверитьКоды.Видимость = Ложь;
		
	ИначеЕсли Статусы.ОсновнойСтатус = СтатусыДокументовУчета.ВРаботе Тогда
		
		Элементы.Кнопка_НачатьРаботу.Видимость				= Ложь;
