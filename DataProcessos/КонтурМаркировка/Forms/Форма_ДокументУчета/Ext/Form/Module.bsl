&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ТоварыДокумента.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.ТоварыКоличествоЗСН Тогда
		СтандартнаяОбработка = Ложь;
		Если ТекущиеДанные.ТребуетсяЗСН Тогда
			ОткрытьРедакторЗаводскихСерийныхНомеров(ТекущиеДанные);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.ТоварыНоменклатура Тогда
		СсылкаНаОбъект = ТекущиеДанные.Номенклатура;
	ИначеЕсли Поле = Элементы.ТоварыХарактеристика Тогда
		СсылкаНаОбъект = ТекущиеДанные.Характеристика;
	ИначеЕсли Поле = Элементы.ТоварыУпаковка Тогда
		СсылкаНаОбъект = ТекущиеДанные.Упаковка;
	ИначеЕсли Поле = Элементы.ТоварыСерия Тогда
		СсылкаНаОбъект = ТекущиеДанные.Серия;
	Иначе
		Возврат;
	КонецЕсли;
	
	МодульКлиента().ОткрытьФормуОбъектаИС(СсылкаНаОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
	
	СтрокаДокумента = Элементы.ТоварыДокумента.ТекущиеДанные;
	Если СтрокаДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КлючСтрокиДокумента = СтрокаДокумента.КлючСтрокиДокумента;
	НеПодлежитМаркировке = СтрокаДокумента.НеПодлежитМаркировке;
	
	Элементы.Кнопка_ТоварНеПодлежитМаркировке.Пометка = НеПодлежитМаркировке;
	
	Если СтрокаДокумента.НеПодлежитМаркировке Тогда
		ПараметрыОтбора = Новый ФиксированнаяСтруктура("КлючСтрокиДокумента", МодульКлиента().ПустойУникальныйИдентификатор());
	Иначе
		ПараметрыОтбора = Новый ФиксированнаяСтруктура("КлючСтрокиДокумента", КлючСтрокиДокумента);
	КонецЕсли;
	Элементы.ТоварыМаркировки.ОтборСтрок = ПараметрыОтбора;
	
	ОбновитьТекстСообщенияОбОшибке();
	ОбновитьТекстОстатка();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	Стр = Элементы.ТоварыДокумента.ТекущиеДанные;
	Если Стр.КоличествоУпаковок = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Стр.РучнойВводКоличества = Истина;
	УстановитьНовоеКоличествоТоваровМаркировки(Стр);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПравилоОтраженияВЭДОПриИзменении(Элемент)
	
	ПроверитьТоварыМаркировки();
	ОбновитьТекстСообщенияОбОшибке();
	УстановитьПодсказку();
	Модифицированность = Истина;
	
	СтрДок = Элементы.ТоварыДокумента.ТекущиеДанные;
	Если Не СтрДок = Неопределено Тогда
		КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента;
		ЗаполнитьДоступностьПартионногоУчета(КлючСтрокиДокумента);
	КонецЕсли;
	
	НастроитьВидимостьКомандФормы();
	НастроитьВидимостьЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыМаркировкиКоличествоПриИзменении(Элемент)
	
	СтрТов = Элементы.ТоварыМаркировки.ТекущиеДанные;
	Если СтрТов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрДок = Элементы.ТоварыДокумента.ТекущиеДанные;
	Если СтрДок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрТов.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента;
	СтрДок.КоличествоПодобрано = КоличествоУпаковокТоваровМаркировки(СтрДок.КлючСтрокиДокумента, ЭтаФорма);
	
	ОбновитьТекстОстатка();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыМаркировкиПослеУдаления(Элемент)
	
	Стр = Элементы.ТоварыДокумента.ТекущиеДанные;
	Если Стр = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Стр.КоличествоПодобрано = КоличествоУпаковокТоваровМаркировки(Стр.КлючСтрокиДокумента, ЭтаФорма);
	
	ОчиститьСоообщениеОбОшибкеВСтроке(Стр);
	ОбновитьТекстСообщенияОбОшибке();
	ЗаполнитьТребуетсяЗСН(Стр.КлючСтрокиДокумента);
	ЗаполнитьДоступностьПартионногоУчета(Стр.КлючСтрокиДокумента);
	ОбновитьТекстОстатка();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыМаркировкиПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	СтрТов = Элементы.ТоварыМаркировки.ТекущиеДанные;
	Если СтрТов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрДок = Элементы.ТоварыДокумента.ТекущиеДанные;
	Если СтрДок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрТов.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента;
	
	ОчиститьСоообщениеОбОшибкеВСтроке(СтрДок);
	ОбновитьТекстСообщенияОбОшибке();
	ЗаполнитьТребуетсяЗСН(СтрДок.КлючСтрокиДокумента);
	ЗаполнитьДоступностьПартионногоУчета(СтрДок.КлючСтрокиДокумента);
	
КонецПроцедуры

