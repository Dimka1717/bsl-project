Процедура ПМ_ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка = Ложь)
	
	Настройки = НастройкиМодуля();
	ПараметрыСобытия.Вставить("ДопПараметрыПМ", Настройки.ПМ_ДопПараметры);
	
	ВариантыРасположения = Перечисление_ВариантыРасположенияОбработки();
	ЭтоТолстыйКлиент = ЭтоТолстыйКлиентОбычноеПриложение();
	
	Если ЭтоТолстыйКлиент Тогда
		МодульКлиента_Обычная().КонтурПлагины_ОбработатьСобытие_ОФ(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка);
	Иначе
		КонтурПлагины_ОбработатьСобытие_УФ(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка);
	КонецЕсли;
	
	Если ЭтоТолстыйКлиент И Настройки.ПМ_Расположение <> ВариантыРасположения.ВКонфигурации Тогда
		МодульКлиента_Обычная().ПМ_ОбработатьСобытие_ОФ(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка);
	Иначе
		ПМ_ОбработатьСобытие_УФ(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка);
	КонецЕсли
	
КонецПроцедуры

