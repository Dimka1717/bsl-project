&НаКлиенте
Функция ДанныеВыбораЗначенияЗаполненияРеквизита(НастройкиРеквизита) Экспорт
	
	Результат = Новый СписокЗначений();
	
	РеквизитыОпераций = Перечисление_РеквизитыОперацийДляАвтозаполнения();
	
	Если НастройкиРеквизита.ИмяРеквизита = РеквизитыОпераций.ПричинаВыводаИзОборота Тогда
		СтруктураЗначений = Перечисление_ПричиныВыводаИзОборота();
		Результат = СписокЗначенийСтруктуры(СтруктураЗначений);
	КонецЕсли;
	
	Если НастройкиРеквизита.ИмяРеквизита = РеквизитыОпераций.ВидПервичногоДокумента Тогда
		СтруктураЗначений = Перечисление_ВидыПервичныхДокументов();
		Результат = СписокЗначенийСтруктуры(СтруктураЗначений);
	КонецЕсли;
	
	Если НастройкиРеквизита.ИмяРеквизита = РеквизитыОпераций.КодСтраныПолучателя Тогда
		Результат = СписокСтранЕАЭС();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура НастроитьЭлементЗначенияЗаполненияРеквизита(Элемент, НастройкиРеквизита, ЕстьСписокРеквизитов = Ложь) Экспорт
	
	Если НастройкиРеквизита.ПравилоЗаполнения = Перечисление_ПравилаЗаполненияРеквизитов().НеЗаполнять Тогда
		Возврат;
	КонецЕсли;
	
	ОграничениеТипа = ОграничениеТипаЗаполненияРеквизита(НастройкиРеквизита);
	ВыбиратьЗначение = РеквизитуДоступенВыборЗначения(НастройкиРеквизита, ЕстьСписокРеквизитов);
	
	Элемент.ОграничениеТипа = ОграничениеТипа;
	Элемент.РежимВыбораИзСписка = ВыбиратьЗначение;
	Элемент.РедактированиеТекста = Не ВыбиратьЗначение;
	
КонецПроцедуры

&НаКлиенте
Функция ОграничениеТипаЗаполненияРеквизита(НастройкиРеквизита) Экспорт
	
	Результат = НастройкиРеквизита.ТипЗначения;
	
	ПравилаЗаполнения = Перечисление_ПравилаЗаполненияРеквизитов();
	
	Если НастройкиРеквизита.ПравилоЗаполнения = ПравилаЗаполнения.РеквизитДокумента1С
		Или НастройкиРеквизита.ПравилоЗаполнения = ПравилаЗаполнения.Формула Тогда
		Результат = Новый ОписаниеТипов("Строка");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция РеквизитуДоступенВыборЗначения(НастройкиРеквизита, ЕстьСписокРеквизитов = Ложь) Экспорт
	
	Результат = Ложь;
	
	ПравилаЗаполнения = Перечисление_ПравилаЗаполненияРеквизитов();
	РеквизитыОпераций = Перечисление_РеквизитыОперацийДляАвтозаполнения();
	
	РеквизитыПеречислений = Новый Массив;
	РеквизитыПеречислений.Добавить(РеквизитыОпераций.ПричинаВыводаИзОборота);
	РеквизитыПеречислений.Добавить(РеквизитыОпераций.ВидПервичногоДокумента);
	РеквизитыПеречислений.Добавить(РеквизитыОпераций.КодСтраныПолучателя);
	
	Если НастройкиРеквизита.ПравилоЗаполнения = ПравилаЗаполнения.РеквизитДокумента1С
		И ЕстьСписокРеквизитов Тогда
		Результат = Истина;
	КонецЕсли;
	
	Если НастройкиРеквизита.ПравилоЗаполнения = ПравилаЗаполнения.ФиксированноеЗначение
		И РеквизитыПеречислений.Найти(НастройкиРеквизита.ИмяРеквизита) <> Неопределено
		И НастройкиРеквизита.ТипЗначения.СодержитТип(Тип("Строка")) Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ВыборЗначенияИзСправочника(Элемент, ТекущиеДанные, СтандартнаяОбработка) Экспорт
	
	Результат = Ложь;
	
	ПравилаЗаполнения = Перечисление_ПравилаЗаполненияРеквизитов();
	Реквизиты = Перечисление_РеквизитыОперацийДляАвтозаполнения();
	
	Если ТекущиеДанные.ПравилоЗаполнения = ПравилаЗаполнения.ФиксированноеЗначение Тогда
		
		Если ТекущиеДанные.ИмяРеквизита = Реквизиты.МобильноеУстройство Тогда
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("РежимВыбора", Истина);
			ПараметрыФормы.Вставить("ТекущееУстройство", ТекущиеДанные.Значение);
			
			ОткрытьФормуОбработки("Форма_МобильныеУстройства_Список", Элемент, ПараметрыФормы);
			
			СтандартнаяОбработка = Ложь;
			Результат = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

