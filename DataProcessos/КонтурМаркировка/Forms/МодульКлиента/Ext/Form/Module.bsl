// Кэш

&НаКлиенте
Функция Кэш_Прочитать(Ключ)
	
	Если ЗначениеЗаполнено(КэшНаКлиенте) Тогда
		Результат = КэшНаКлиенте.Получить(Ключ);
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура Кэш_Поместить(Ключ, Значение)
	
	Если КэшНаКлиенте = Неопределено Тогда
		КэшНаКлиенте = Новый Соответствие;
	КонецЕсли;
	
	КэшНаКлиенте.Вставить(Ключ, Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура Кэш_Очистить()
	
	Если ЗначениеЗаполнено(КэшНаКлиенте) Тогда
		КэшНаКлиенте.Очистить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьКэш() Экспорт
	
	Кэш_Очистить();
	СброситьКэшНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СброситьКэшНаСервере()
	
	МодульОбъекта().СброситьКэш();
	
КонецПроцедуры

// Настройки модуля

&НаКлиенте
Функция НастройкиМодуля(ОбновитьКэш = Ложь) Экспорт
	
	КлючКэш = "НастройкиМодуля";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено И Не ОбновитьКэш Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = НастройкиМодуляНаСервере(ОбновитьКэш);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Если ОбновитьКэш Тогда
		Оповестить("КонтурМаркировка_НастройкиМодуля_Обновлены");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция НастройкиМодуляНаСервере(ОбновитьКэш)
	
	Возврат МодульОбъекта().НастройкиМодуля(ОбновитьКэш);
	
КонецФункции

&НаКлиенте
Процедура НастройкиМодуля_Записать(НовыеНастройки, ВызывающаяФорма = Неопределено) Экспорт
	
	НастройкиМодуля_ЗаписатьНаСервере(НовыеНастройки);
	
	Кэш_Очистить();
	
	Оповестить("КонтурМаркировка_НастройкиМодуля_Обновлены", , ВызывающаяФорма);
	
КонецПроцедуры

&НаСервере
Процедура НастройкиМодуля_ЗаписатьНаСервере(НовыеНастройки)
	
	МодульОбъекта().НастройкиМодуля_Записать(НовыеНастройки);
	
	Действие = МодульОбъекта().Перечисление_ДействияМетрики().ЗаписьВБазу;
	МодульОбъекта().Метрика_НастройкиМодуля(Действие);
	МодульОбъекта().Метрики_ДопПараметрыЭтикеток(Действие);
	
	Функциональность = МодульОбъекта().Перечисление_ФункциональностьМодуля().ДопКолонокиВСпискеДокументов;
	МодульОбъекта().СтекМетрик_УдалитьФункциональность(Функциональность);
	
КонецПроцедуры

