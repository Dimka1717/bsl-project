&НаКлиенте
Функция ЭтоУправляемаяФормаВыбора(ПутьКФорме)
	
	КлючКэш = "ЭтоУправляемаяФормаВыбора";
	КэшРезультатов = Кэш_Прочитать(КлючКэш);
	Если КэшРезультатов <> Неопределено Тогда
		Результат = КэшРезультатов[ПутьКФорме];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	Иначе
		КэшРезультатов = Новый Соответствие;
	КонецЕсли;
	
	Результат = ЭтоУправляемаяФормаВыбораНаСервере(ПутьКФорме);
	
	КэшРезультатов.Вставить(ПутьКФорме, Результат);
	Кэш_Поместить(КлючКэш, КэшРезультатов);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЭтоУправляемаяФормаВыбораНаСервере(ПутьКФорме)
	
	Форма = Метаданные.НайтиПоПолномуИмени(ПутьКФорме);
	
	Если Форма = Неопределено Тогда
		
		// Попробуем найти основную форму выбора или основную форму списка
		Поз = Найти(ПутьКФорме, ".Форма");
		ИмяОбъекта = Лев(ПутьКФорме, Поз - 1);
		МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ИмяОбъекта);
		
		Форма = МетаданныеОбъекта.ОсновнаяФормаДляВыбора;
		Если Форма = Неопределено Тогда
			Форма = МетаданныеОбъекта.ОсновнаяФормаСписка;
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = (Форма.ТипФормы = Метаданные.СвойстваОбъектов.ТипФормы.Управляемая);
	
	Возврат Результат;
	
КонецФункции

