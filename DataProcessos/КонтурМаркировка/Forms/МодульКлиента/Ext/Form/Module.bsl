Функция СформироватьДвоичныеДанныеДиагностики()
	
	МодульДиагностики = Модуль_Диагностика();
	
	МассивПрав = Новый Массив;
	МассивПрав.Добавить("Добавление");
	МассивПрав.Добавить("Изменение");
	
	МассивПравРС = Новый Массив;
	МассивПравРС.Добавить("Чтение");
	МассивПравРС.Добавить("Изменение");

	Диагностики = Новый Массив;
	
	Диагностика = МодульДиагностики.ДиагностикаМетаданные();
	Диагностика.ПолныйПуть = "Справочник.КонтурМаркировка_ШаблоныЭтикеток";
	Диагностика.ПраваДоступа = МассивПрав;
	Диагностики.Добавить(Диагностика);
	
	Диагностика = МодульДиагностики.ДиагностикаМетаданные();
	Диагностика.ПолныйПуть = "Справочник.Контрагенты";
	Диагностика.ПраваДоступа = МассивПрав;
	Диагностики.Добавить(Диагностика);
	
	Диагностика = МодульДиагностики.ДиагностикаМетаданные();
	Диагностика.ПолныйПуть = "Справочник.Организации";
	Диагностика.ПраваДоступа = МассивПрав;
	Диагностики.Добавить(Диагностика);
	
	Диагностика = МодульДиагностики.ДиагностикаМетаданные();
	Диагностика.ПолныйПуть = "Справочник.Пользователи";
	Диагностика.ПраваДоступа = МассивПрав;
	Диагностики.Добавить(Диагностика);
	
	Диагностика = МодульДиагностики.ДиагностикаМетаданные();
	Диагностика.ПолныйПуть = "Справочник.Номенклатура";
	Диагностика.ПраваДоступа = МассивПрав;
	Диагностики.Добавить(Диагностика);
	
	Диагностика = МодульДиагностики.ДиагностикаМетаданные();
	Диагностика.ПолныйПуть = "Справочник.ХарактеристикиНоменклатуры";
	Диагностика.ПраваДоступа = МассивПрав;
	Диагностики.Добавить(Диагностика);
	
	Диагностика = МодульДиагностики.ДиагностикаМетаданные();
	Диагностика.ПолныйПуть = "Справочник.СерииНоменклатуры";
	Диагностика.ПраваДоступа = МассивПрав;
	Диагностики.Добавить(Диагностика);

	Диагностика = МодульДиагностики.ДиагностикаМетаданные();
	Диагностика.ПолныйПуть = "РегистрСведений.КонтурМаркировка_СтатусыКодов";
	Диагностика.ПраваДоступа = МассивПравРС;
	Диагностики.Добавить(Диагностика);
	
	РезультатДиагностики = МодульДиагностики.ВыполнитьДиагностики(Диагностики);
	Отчет = МодульДиагностики.СформироватьОтчет(РезультатДиагностики, "Текстовый");
	
	Возврат ДвоичныеДанныеИзСтроки(Отчет);
	
