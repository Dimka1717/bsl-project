// Проверяет что значение есть в массиве
//
// Параметры:
//  Массив - Массив - массив, в котором нужно найти значение;
//  Значение - Произвольный - значение, которое нужно найти в массиве;
// 
// Возвращаемое значение:
//  Булево - Истина, если значение есть в массиве
//
&НаКлиенте
Функция МассивСодержитЗначение(Массив, Значение) Экспорт
	
	Результат = Массив.Найти(Значение) <> Неопределено;
	
	Возврат Результат;
	
КонецФункции

// Сравнивает версии между собой
// значения после дефиса или слэша не учитываются
//
// Параметры:
//  Версия1 - Строка - номер версии в формате РР.{П|ПП}.ЗЗ.СС;
//  Версия2 - Строка - второй сравниваемый номер версии;
//
// Возвращаемое значение:
//  Число - возможные значения:
//   * больше 0 - если Версия1 > Версия2;
//   * меньше 0 - если Версия1 < Версия2;
//   * 0 - если версии равны;
//
&НаКлиенте
Функция СравнитьВерсии(Версия1, Версия2)
	
	// Для составных номеров версий берем только первую часть
	Строка1 = Сред(Версия1, 1, Найти(Версия1, "-") - 1);
	Строка2 = Сред(Версия2, 1, Найти(Версия2, "-") - 1);
	Строка1 = Сред(Строка1, 1, Найти(Строка1, "/") - 1);
	Строка2 = Сред(Строка2, 1, Найти(Строка2, "/") - 1);
	
	ОписаниеЧисла = Новый ОписаниеТипов("Число");
	
	Результат = 0;
	
	Пока ЗначениеЗаполнено(Строка1)
		Или ЗначениеЗаполнено(Строка2) Цикл
		
		Поз = Найти(Строка1, ".");
		Если Поз = 0 Тогда
			Подстрока1 = СокрЛП(Строка1);
			Строка1 = "";
		Иначе
			Подстрока1 = СокрЛП(Лев(Строка1, Поз - 1));
			Строка1 = Сред(Строка1, Поз + 1);
		КонецЕсли;
		
		Поз = Найти(Строка2, ".");
		Если Поз = 0 Тогда
			Подстрока2 = СокрЛП(Строка2);
			Строка2 = "";
		Иначе
			Подстрока2 = СокрЛП(Лев(Строка2, Поз - 1));
			Строка2 = Сред(Строка2, Поз + 1);
		КонецЕсли;
		
		НомерВерсии1 = ОписаниеЧисла.ПривестиЗначение(Подстрока1);
		НомерВерсии2 = ОписаниеЧисла.ПривестиЗначение(Подстрока2);
		
		Результат = НомерВерсии1 - НомерВерсии2;
		
		Если Результат <> 0 Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Соединяет массив переданных строк в одну строку с указанным разделителем
// По аналогии с глобальным методом СтрСоединить
// 
// Параметры:
//  Строки - Массив, ФиксированныйМассив - массив, содержащий объединяемые строки;
//  Разделитель - Строка - строка, которая будет вставлена между объединяемыми строками;
//
// Возвращаемое значение:
//  Строка
//
&НаКлиенте
Функция СоединитьСтроку(Строки, Разделитель = "") Экспорт
	
	Если Не ВерсияПлатформыНиже("8.3.6") И Не ВерсияРежимаСовместимостиНиже("8.3.6") Тогда
		Результат = Вычислить("СтрСоединить(Строки, Разделитель)");
		Возврат Результат;
	КонецЕсли;
	
	Результат = "";
	ТекРазделитель = "";
	
	Если ЗначениеЗаполнено(Строки) Тогда
		Для Каждого Строка Из Строки Цикл
			Если ЗначениеЗаполнено(Строка) Тогда
				Результат = Результат + ТекРазделитель + Строка;
				ТекРазделитель = Разделитель;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Подставляет параметры в строку, максимальное число параметров - 5
//
// Параметры:
//  ШаблонСтроки - Строка - шаблон с маркерами подстановки: "%1..%N";
//  Параметр<n>  - Строка - параметры, которые нужно подставить;
//
// Возвращаемое значение:
//   Строка - строка шаблона с подставленными параметрами.
//
&НаКлиенте
Функция ПараметрыВСтроку(ШаблонСтроки, Параметр1
	, Параметр2 = Неопределено
	, Параметр3 = Неопределено
	, Параметр4 = Неопределено
	, Параметр5 = Неопределено) Экспорт
	
	ЕстьПараметрыСПроцентом =
	Найти(Параметр1, "%") > 0
	Или Найти(Параметр2, "%") > 0
	Или Найти(Параметр3, "%") > 0
	Или Найти(Параметр4, "%") > 0
	Или Найти(Параметр5, "%") > 0;
	
	Если ЕстьПараметрыСПроцентом Тогда
		Возврат ПараметрыСПроцентомВСтроку(ШаблонСтроки
		, Параметр1, Параметр2, Параметр3, Параметр4, Параметр5);
	КонецЕсли;
	
	Результат = СтрЗаменить(ШаблонСтроки, "%1", Параметр1);
	Результат = СтрЗаменить(Результат	, "%2", Параметр2);
	Результат = СтрЗаменить(Результат	, "%3", Параметр3);
	Результат = СтрЗаменить(Результат	, "%4", Параметр4);
	Результат = СтрЗаменить(Результат	, "%5", Параметр5);
	
	Возврат Результат;
	
КонецФункции

// Вставляет параметры в строку, с учетом того что в параметрах
// могут использоваться подстановочные слова %1, %2, %3, %4, %5
//
&НаКлиенте
Функция ПараметрыСПроцентомВСтроку(Знач ШаблонСтроки
	, Параметр1 = Неопределено
	, Параметр2 = Неопределено
	, Параметр3 = Неопределено
	, Параметр4 = Неопределено
	, Параметр5 = Неопределено)
	
	Результат = "";
	
	Пока Истина Цикл
		
		Поз = Найти(ШаблонСтроки, "%");
		
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Результат = Результат + Лев(ШаблонСтроки, Поз - 1);
		
		НомерПараметра = Сред(ШаблонСтроки, Поз + 1, 1);
		
		Если НомерПараметра = "1" Тогда
			ЗначениеПараметра = Параметр1;
		ИначеЕсли НомерПараметра = "2" Тогда
			ЗначениеПараметра = Параметр2;
		ИначеЕсли НомерПараметра = "3" Тогда
			ЗначениеПараметра = Параметр3;
		ИначеЕсли НомерПараметра = "4" Тогда
			ЗначениеПараметра = Параметр4;
		ИначеЕсли НомерПараметра = "5" Тогда
			ЗначениеПараметра = Параметр5;
		Иначе
			ЗначениеПараметра = Неопределено;
		КонецЕсли;
		
		Если ЗначениеПараметра = Неопределено Тогда
			Результат = Результат + "%";
			ШаблонСтроки = Сред(ШаблонСтроки, Поз + 1);
		Иначе
			Результат = Результат + ЗначениеПараметра;
			ШаблонСтроки = Сред(ШаблонСтроки, Поз + 2);
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = Результат + ШаблонСтроки;
	
	Возврат Результат;
	
КонецФункции

// Безопасно читает свойство объекта, даже если объект не определен
//
// Параметры:
//  Объект - Произвольное - любой объект;
//  ИмяПоля - Строка - имя поля;
//  ЗначениеПоУмолчанию - Произвольный - (необязательный) возвращается,
//            если у объекта нет такого поля или значение Неопределено;
// 
// Возвращаемое значение:
//  Произвольное - значение поля
//
&НаКлиенте
Функция СвойствоОбъекта(Объект, ИмяПоля, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Попытка
		
		Результат = Объект[ИмяПоля];
		
		Если Результат = Неопределено Тогда
			Результат = ЗначениеПоУмолчанию;
		КонецЕсли;
		
	Исключение
		Результат = ЗначениеПоУмолчанию;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Безопасно читает свойство структуры
// 
// Параметры:
//  Структура - Структура - структура;
//  Ключ      - Строка  - ключ;
//  ЗначениеПоУмолчанию - Произвольный - (необязательный) возвращается,
//                                   если в структуре нет такого ключа;
// 
// Возвращаемое значение:
//   Произвольный - значение свойства
//
&НаКлиенте
Функция СвойствоСтруктуры(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Возврат СвойствоОбъекта(Структура, Ключ, ЗначениеПоУмолчанию);
	
КонецФункции

// Возвращает значение по ключу соответствия или значение по умолчанию,
// если в соответствии нет такого ключа
// 
// Параметры:
//  Соответствие        - Соответствие - соответствие источник;
//  Ключ                - Произвольный - ключ соответствия;
//  ЗначениеПоУмолчанию - Произвольный - (необязательный) возвращается в случае,
//                                       если в соответствии нет указанного ключа;
// 
// Возвращаемое значение:
//  Произвольный - значение из соответствия или ЗначениеПоУмолчанию
//
&НаКлиенте
Функция ЗначениеСоответствия(Соответствие, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Попытка
		Результат = Соответствие[Ключ];
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	
	Если Результат = Неопределено Тогда
		Результат = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет, является ли переданное значение структурой
// или фиксированной структурой
// 
// Параметры:
//  Значение - Произвольный - значение, которое нужно проверить
// 
// Возвращаемое значение:
//  Булево - Истина, если переданое значение является структрой или фиксированной структурой
//
&НаКлиенте
Функция ЭтоСтруктура(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет, является ли переданное значение соответствием
// или фиксированным соответствием
// 
// Параметры:
//  Значение - Произвольный - значение, которое нужно проверить
// 
// Возвращаемое значение:
//  Булево - Истина, если переданое значение является соответствием или фиксированным соответствием
//
&НаКлиенте
Функция ЭтоСоответствие(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Соответствие")
		Или ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет, является ли переданное значение массивом
// или фиксированным массивом
// 
// Параметры:
//  Значение - Произвольный - значение, которое нужно проверить
// 
// Возвращаемое значение:
//  Булево - Истина, если переданое значение является структрой или фиксированной структурой
//
&НаКлиенте
Функция ЭтоМассив(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Массив")
		Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
