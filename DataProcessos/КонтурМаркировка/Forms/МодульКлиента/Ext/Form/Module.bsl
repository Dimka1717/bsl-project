// Открытие форм

&НаКлиенте
Функция ИмяОбработки() Экспорт
	
	ЧастиИмени = РазделитьСтроку(ИмяФормы, ".");
	Результат = ЧастиИмени[0] + "." + ЧастиИмени[1];
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ОткрытьФормуОбработки(ИмяФормыОбработки
	, Знач Владелец = Неопределено
	, ПараметрыФормы = Неопределено
	, ОбработчкиПослеЗакрытия = Неопределено) Экспорт
	
	Если Не ПроверитьУстановленнуюВерсиюМодуля() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПутьКФорме = ИмяОбработки() + ".Форма." + ИмяФормыОбработки;
	
	Если ПараметрыФормы = Неопределено Тогда
		ПараметрыФормы = Новый Структура;
	КонецЕсли;
	
	Если Владелец = Неопределено Тогда
		Владелец = ОткрытаяФормаРабочегоСтола();
		Если Владелец = Неопределено
			И ПутьКФорме <> ПутьКФормеМодуля() Тогда
			Владелец = ОткрытаяФормаМодуля();
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоФорма(Владелец) Тогда
		Если ПутьКФорме = ПутьКФормеМодуля()
			И Владелец.ИмяФормы = ПутьКФормеРабочегоСтола() Тогда
			ПараметрыФормы.Вставить("ИдентификаторСеанса", Владелец.УникальныйИдентификатор);
		КонецЕсли;
		Если Владелец.Открыта() Тогда
			ПараметрыФормы.Вставить("ЗакрыватьПриЗакрытииВладельца", Истина);
		КонецЕсли;
	КонецЕсли;
	
	Если ДоступныАсинхронныеФормы() Тогда
		ОповещениеОЗакрытии = НовоеОписаниеОповещения(ОбработчкиПослеЗакрытия);
		Результат = Вычислить("ОткрытьФорму(ПутьКФорме, ПараметрыФормы, Владелец, , , , ОповещениеОЗакрытии)");
	Иначе
		Если ОбработчкиПослеЗакрытия = Неопределено Тогда
			Результат = ОткрытьФорму(ПутьКФорме, ПараметрыФормы, Владелец, , Окно);
		Иначе
			Результат = ОткрытьФормуМодально(ПутьКФорме, ПараметрыФормы, Владелец);
			ВызватьОбработчикОповещения(ОбработчкиПослеЗакрытия, Результат);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуОбработкиМодально(ИмяФормыОбработки, Владелец
	, ПараметрыФормы = Неопределено
	, ОписаниеОбработчика = Неопределено) Экспорт
	
	Если ПараметрыФормы = Неопределено Тогда
		ПараметрыФормы = Новый Структура;
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ЗакрыватьПриЗакрытииВладельца", Истина);
	
	ПутьКФорме = ИмяОбработки() + ".Форма." + ИмяФормыОбработки;
	
	Если ДоступныАсинхронныеФормы() Тогда
		ОповещениеОЗакрытии = НовоеОписаниеОповещения(ОписаниеОбработчика);
		РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		Выполнить("ОткрытьФорму(ПутьКФорме, ПараметрыФормы, Владелец, , , , ОповещениеОЗакрытии, РежимОткрытияОкна)");
	Иначе
		Результат = ОткрытьФормуМодально(ПутьКФорме, ПараметрыФормы, Владелец);
		ВызватьОбработчикОповещения(ОписаниеОбработчика, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
