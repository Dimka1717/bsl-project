	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Каталог = ТекКаталог;
	Диалог.Заголовок = ЗаголовокДиалога;
	
	Если ДоступныАсинхронныеФормы() Тогда
		ОповещениеОЗакрытии = НовоеОписаниеОповещения(ОписаниеОбработчика);
		Диалог.Показать(ОповещениеОЗакрытии);
	Иначе
		КаталогВыбран = Диалог.Выбрать();
		Если КаталогВыбран Тогда
			Результат = ЗначениеВМассиве(Диалог.Каталог);
			ВызватьОбработчикОповещения(ОписаниеОбработчика, Результат);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

