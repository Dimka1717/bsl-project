// Определяет доступен ли параметр завершения работы в событии формы ПередЗакрытием
// 
// Возвращаемое значение:
//  Булево - Истина, если параметр доступен
//
&НаКлиенте
Функция ДоступенПараметрЗавершенияРаботыПередЗакрытием()
	
	КлючКэш = "ДоступенПараметрЗавершенияРаботыПередЗакрытием";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	НачальнаяВерсия = "8.3.8";
	
	Результат = Не ВерсияПлатформыНиже(НачальнаяВерсия)
	И Не ВерсияРежимаСовместимостиНиже(НачальнаяВерсия);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

// Определяет завершается ли сейчас работа программы
// Вызывается перед закрытием формы
// 
// Возвращаемое значение:
//  Булево - Истина, если выполняется завершение работы программы
//
&НаКлиенте
