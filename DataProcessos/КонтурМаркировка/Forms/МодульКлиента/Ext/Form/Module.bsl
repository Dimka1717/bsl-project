// Опросы пользователей

&НаКлиенте
Функция ОпросПользователяПоСценарию(КлючСценария) Экспорт
	
	ВсеОпросы = ОпросыПользователей();
	
	Результат = МассивСтруктур_Найти(ВсеОпросы, КлючСценария, "КлючСценария");
	
	Если Не ЗначениеЗаполнено(Результат)
		ИЛИ ОпросПользователяПройден(Результат) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ОпросПользователяПройден(ОписаниеОпроса)
	
	КлючКэшПройденныхОпросов = КлючКэш_ИдентификаторыПройденныхОпросов();
	ИдентификаторыПройденныхОпросов = Кэш_Прочитать(КлючКэшПройденныхОпросов);
	Если ЗначениеЗаполнено(ИдентификаторыПройденныхОпросов)
		И ИдентификаторыПройденныхОпросов.Найти(ОписаниеОпроса.ИдентификаторОпроса) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	// На случай если опрос пройден в другом сеансе или кэш еще пустой
	ИдентификаторыПройденныхОпросов = ИдентификаторыПройденныхОпросовПользователяНаСервере();
	Кэш_Поместить(КлючКэшПройденныхОпросов, ИдентификаторыПройденныхОпросов);
	
	Если ЗначениеЗаполнено(ИдентификаторыПройденныхОпросов)
		И ИдентификаторыПройденныхОпросов.Найти(ОписаниеОпроса.ИдентификаторОпроса) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ОпросПодходитПоВидуПродукции(ОписаниеОпроса, ВидПродукции) Экспорт
	
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ВидыПродукцииОпроса = ОписаниеОпроса.ВидыПродукции;
	
	Если Не ЗначениеЗаполнено(ВидыПродукцииОпроса) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат ВидыПродукцииОпроса.Найти(ВидПродукции) <> Неопределено;
	
КонецФункции

