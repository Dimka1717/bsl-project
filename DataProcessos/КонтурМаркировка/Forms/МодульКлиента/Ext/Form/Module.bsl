// Дополнительные кнопки

// Вызывает события ПМ при нажатии дополнительной кнопки
//
// Параметры:
//  ПараметрыНажатия - Структура - см. Новый_ПараметрыНажатияДопКнопки();
//  Команда - КомандаФормы - команда формы;
//
&НаКлиенте
Процедура ПриНажатииДополнительнойКнопки(ПараметрыНажатия, Команда) Экспорт
	
	СтандартнаяОбработка = Истина;
	
	ПрефиксДопКнопки = ПрефиксДополнительнойКнопки();
	ПараметрыНажатия.ИмяКнопки = Сред(Команда.Имя, СтрДлина(ПрефиксДопКнопки) + 1);
	
	ПМ_ОбработатьСобытие("ПриНажатииДопКнопкиНаКлиенте", ПараметрыНажатия, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		ПродолжитьОбработкуНажатияДопКнопки(ПараметрыНажатия);
	КонецЕсли;
	
	Метрика_Функциональность_ДопКнопки();
	Метрика_НажатиеДополнительнойКнопки(ПараметрыНажатия);
	
КонецПроцедуры

