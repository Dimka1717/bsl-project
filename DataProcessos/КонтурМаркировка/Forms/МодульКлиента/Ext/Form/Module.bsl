// Обработка ошибок

// Записывает ошибку в журнал регистрации и сообщает пользователю
//
// Параметры:
//  Действие			 - Строка - действие, при котором возникла ошибка;
//  Ошибка				 - ИнформацияОбОшибке, Строка - информация об ошибке;
//  ДопИнформация		 - Строка, Соответствие - доп информация для записи в журнал регистрации;
//  ТекстСообщения		 - Строка - текст сообщения пользователю;
//  ИдентификаторФормы	 - УникальныйИдентификатор - см. СообщитьПользователюЛок();
//  ПолеФормы			 - Строка                  - см. СообщитьПользователюЛок();
//
&НаКлиенте
Процедура ОбработатьОшибку(Действие, Ошибка
	, ДопИнформация		 = Неопределено
	, ТекстСообщения	 = Неопределено
	, ИдентификаторФормы = Неопределено
	, ПолеФормы			 = Неопределено
	, СсылкаНаОбъект	 = Неопределено) Экспорт
	
	ИнформацияОбОшибке = Ошибка;
	Если ТипЗнч(ИнформацияОбОшибке) = Тип("ИнформацияОбОшибке")
		И ВерсияПлатформыНиже("8.3.16") Тогда
		ИнформацияОбОшибке = ПодробноеПредставлениеОшибки(Ошибка);
	КонецЕсли;
	
	ОбработатьОшибкуНаСервере(Действие, ИнформацияОбОшибке
	, ДопИнформация
	, ТекстСообщения
	, ИдентификаторФормы
	, ПолеФормы
	, СсылкаНаОбъект);
	
КонецПроцедуры

// Записывает ошибку в журнал регистрации и сообщает пользователю
//
// Параметры:
//  Действие			 - Строка - действие, при котором возникла ошибка;
//  Ошибка				 - ИнформацияОбОшибке, Строка - информация об ошибке;
//  ДопИнформация		 - Строка, Соответствие - доп информация для записи в журнал регистрации;
//  ТекстСообщения		 - Строка - текст сообщения пользователю;
//  ИдентификаторФормы	 - УникальныйИдентификатор - см. СообщитьПользователюЛок();
//  ПолеФормы			 - Строка                  - см. СообщитьПользователюЛок();
//
&НаСервере
Процедура ОбработатьОшибкуНаСервере(Действие, Ошибка
	, ДопИнформация		 = Неопределено
	, ТекстСообщения	 = Неопределено
	, ИдентификаторФормы = Неопределено
	, ПолеФормы			 = Неопределено
	, СсылкаНаОбъект	 = Неопределено)
	
	МодульОбъекта().ОбработатьОшибку(Действие, Ошибка
	, ДопИнформация
	, ТекстСообщения
	, ИдентификаторФормы
	, ПолеФормы
	, СсылкаНаОбъект);
	
КонецПроцедуры


// Техническая поддержка

&НаКлиенте
Процедура ОткрытьТелеграмКанал() Экспорт
	
	ПараметрыКанала = ПараметрыКаналаТелеграм();
	
	Попытка
		
		ОткрытьИнтернетСтраницу(ПараметрыКанала.Ссылка);
		
		Функциональность = Перечисление_ФункциональностьМодуля().ТелеграмКанал;
		СтекМетрик_ДобавитьФункциональность(Функциональность);
		
	Исключение
		ТекстСообщения = НСтр(
		"ru = 'К сожалению, нам не удалось открыть Телеграм канал на компьютере
