	Если Не ЗначениеЗаполнено(ВидыДокументовДляВыбора) Тогда
		Возврат;
	КонецЕсли;
	
	СписокВыбора = Новый СписокЗначений;
	Для каждого Элемент Из ВидыДокументовДляВыбора Цикл
		СписокВыбора.Добавить(Элемент, Элемент.Представление);
	КонецЦикла;
	
	Если ВидыДокументовДляВыбора.Количество() = 1 Тогда
		ВызватьОбработчикОповещения(ОписаниеОбработчика, СписокВыбора[0]);
	Иначе
		ЗаголовокВыбора = НСтр("ru = 'Виды документов'");
		ПоказатьДиалогВыбораЗначенияВСписке(ОписаниеОбработчика, СписокВыбора, ЗаголовокВыбора);
	КонецЕсли;
	
