&НаКлиенте
Функция ВСтрокеТолькоЦифры(Строка) Экспорт
	
	Результат = Истина;
	
	КодСимвола0 = КодСимвола("0");
	КодСимвола9 = КодСимвола("9");
	
	ДлинаСтроки = СтрДлина(Строка);
	
	Для Сч = 1 По ДлинаСтроки Цикл
		
		КодСимвола = КодСимвола(Строка, Сч);
		
		Если КодСимвола < КодСимвола0
			Или КодСимвола > КодСимвола9 Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат
	
КонецФункции

// Возвращает массив переданных параметров в порядке их расположения
// 
// Возвращаемое значение:
//  Массив
//
&НаКлиенте
Функция НовыйМассив(Знач1, Знач2 = Null, Знач3 = Null, Знач4 = Null) Экспорт
	
	Результат = Новый Массив;
	
	Результат.Добавить(Знач1);
	
	Если Знач2 <> Null Тогда
		Результат.Добавить(Знач2);
	КонецЕсли;
	Если Знач3 <> Null Тогда
		Результат.Добавить(Знач3);
	КонецЕсли;
	Если Знач4 <> Null Тогда
		Результат.Добавить(Знач4);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция НовыйСоответствие(Ключ1, Знач1
	, Ключ2 = NULL, Знач2 = NULL
	, Ключ3 = NULL, Знач3 = NULL) Экспорт
	
	Результат = Новый Соответствие;
	
	Результат.Вставить(Ключ1, Знач1);
	
	Если Ключ2 <> NULL И Знач2 <> NULL Тогда
		Результат.Вставить(Ключ2, Знач2);
	КонецЕсли;
	
	Если Ключ3 <> NULL И Знач3 <> NULL Тогда
		Результат.Вставить(Ключ3, Знач3);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Добавляет значение в массив
//
// Параметры:
//	Значение - Произвольный - преобразуемое значение
//
// Возвращаемое значение:
//	Массив
&НаКлиенте
Функция ЗначениеВМассиве(Значение) Экспорт
	
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		
		Результат = Значение;
		
	Иначе
		
		Результат = Новый Массив;
		Результат.Добавить(Значение);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Дополняет массив значениями из другого массива
//
// Параметры:
//  МассивПриемник - Массив - массив, в который необходимо добавить значения;
//  МассивИсточник - Массив - массив, из которого нужно взять значения;
//  ТолькоНовыеЗначения - Булево - (необязательный) Истина, если в приемник
//					нужно добавить только те значения, которых там еще нет;
//
&НаКлиенте
Процедура ДополнитьМассив(МассивПриемник, МассивИсточник, ТолькоНовыеЗначения = Ложь, ДобавлятьПустыеЗначения = Истина)
	
	Если ТолькоНовыеЗначения Тогда
		
		ЗначенияПриемника = Новый Соответствие;
		Для Каждого Значение Из МассивПриемник Цикл
			ЗначенияПриемника.Вставить(Значение, Истина);
		КонецЦикла;
		
		Для Каждого Значение Из МассивИсточник Цикл
			Если Не ДобавлятьПустыеЗначения
				И Не ЗначениеЗаполнено(Значение) Тогда
				Продолжить;
			КонецЕсли;
			Если ЗначенияПриемника[Значение] = Неопределено Тогда
				МассивПриемник.Добавить(Значение);
				ЗначенияПриемника.Вставить(Значение, Истина);
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		Для Каждого Значение Из МассивИсточник Цикл
			МассивПриемник.Добавить(Значение);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Сворачивает массив
//
// Параметры:
//  Массив - Массив
//
&НаКлиенте
Процедура СвернутьМассив_Марк(Массив, УдалитьПустыеЗначения = Ложь) Экспорт
	
	Результат = Новый Массив;
	
	ДополнитьМассив(Результат, Массив, Истина, Не УдалитьПустыеЗначения);
	
	Массив = Результат;
	
КонецПроцедуры

