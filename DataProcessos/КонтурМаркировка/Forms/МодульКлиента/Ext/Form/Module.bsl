// Выгрузка кодов в файл

&НаКлиенте
Процедура СохранитьКодыВФайл(ПараметрыСохранения) Экспорт
	
	Настройки = НастройкиМодуля();
	
	Если Настройки.ВыгружатьВФайлКодыСКрипточастью Тогда
		ТекстПредупреждения = НСтр("ru = 'Выгружаемые коды содержат крипточасть и могут быть использованы только для печати с последующим нанесением.
									|После сохранения коды будут помечены напечатанными'");
	Иначе
		ТекстПредупреждения = НСтр("ru = 'Выгружаемые коды без крипточасти не подходят для печати и последующего нанесения.'");
	КонецЕсли;
	
	Обработчик = ОписаниеОбработчикаОповещения("СохранитьКодыВФайл_ПослеСогласия", ЭтаФорма, ПараметрыСохранения);
	ПоказатьДиалогВопроса(Обработчик, ТекстПредупреждения, РежимДиалогаВопрос.ОКОтмена);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьКодыВФайл_ПослеСогласия(Ответ, ПараметрыСохранения) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ФорматыФайловСКодами = Перечисление_ФорматыФайловСКодами();
	Если ПараметрыСохранения.ФорматФайла = ФорматыФайловСКодами.xlsx Тогда
		ЗаголовокВыбора = НСтр("ru = 'Сохранение кодов в Excel'");
	ИначеЕсли ПараметрыСохранения.ФорматФайла = ФорматыФайловСКодами.csv Тогда
		ЗаголовокВыбора = НСтр("ru = 'Сохранение кодов в CSV'");
	Иначе
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Не поддерживается выгрузка кодов в файл с типом: %1'"), ПараметрыСохранения.ФорматФайла);
	КонецЕсли;
	
	ОписаниеОбработчика = ОписаниеОбработчикаОповещения("СохранитьКодыВФайл_ПослеВыбораКаталога"
														, ЭтаФорма
														, ПараметрыСохранения);
	
	ПоказатьДиалогВыбораКаталога(ОписаниеОбработчика, ЗаголовокВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьКодыВФайл_ПослеВыбораКаталога(ВыбранныеФайлы, ПараметрыСохранения) Экспорт
	
	Если Не ЗначениеЗаполнено(ВыбранныеФайлы) Тогда
		Возврат;
	КонецЕсли;
	
	Каталог = ВыбранныеФайлы[0];
	ТипыФайловСКодами = Перечисление_ТипыФайловСКодами();
	
	Ссылка = ПараметрыСохранения.Ссылка;
	ФорматФайла = ПараметрыСохранения.ФорматФайла;
	ТипФайлаСКодами = ПараметрыСохранения.ТипФайлаСКодами;
	
	Если ТипФайлаСКодами = ТипыФайловСКодами.ФайлКодовДокументаУчета Тогда
		МассивФайлов = ВыгрузитьКодыДокументаУчетаВФайл(Ссылка, ФорматФайла);
	ИначеЕсли ТипФайлаСКодами = ТипыФайловСКодами.ФайлКодовОперации Тогда
		МассивФайлов = ВыгрузитьКодыОперацииВФайл(Ссылка, ФорматФайла);
	ИначеЕсли ТипФайлаСКодами = ТипыФайловСКодами.ФайлКодовСОшибками Тогда
		МассивФайлов = ВыгрузитьКодыСОшибкамиВФайл(Ссылка, ФорматФайла);
	Иначе
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Не поддерживается выгрузка кодов в файл с типом: %1'"), ТипФайлаСКодами);
	КонецЕсли;
	
	Для каждого Элемент Из МассивФайлов Цикл
		ПутьКФайлу = ОбъединитьПути(Каталог, Элемент.ИмяФайла);
		Элемент.ДвоичныеДанные.Записать(ПутьКФайлу);
	КонецЦикла;
	
	Если ТипФайлаСКодами = ТипыФайловСКодами.ФайлКодовОперации Тогда
		Оповестить("КонтурМаркировка_КодыВыгружены", Ссылка);
	КонецЕсли;
	
КонецПроцедуры

