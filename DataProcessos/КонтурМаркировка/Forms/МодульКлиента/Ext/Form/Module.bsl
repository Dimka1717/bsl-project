// Проверяет что использование функциональности уже учтено в метриках
//
// Параметры:
//  Функциональность - Строка - см. функцию Перечисление_ФункциональностьМодуля();
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - (необязательный) организация;
// 
// Возвращаемое значение:
//  Булево - Истина, если функциональность уже добавлена
//
&НаКлиенте
Функция Метрики_Функциональность_Учтена(Функциональность, Организация = Неопределено)
	
	Если Организация = Неопределено Тогда
		Организация = ИмяОбщейОрганизацииДляМетрик();
	КонецЕсли;
	
	НаборФункциональности = СтекМетрик_Прочитать().ФункциональностьПоОрганизациям[Организация];
	ЕстьВНаборе = ЗначениеСоответствия(НаборФункциональности, Функциональность) <> Неопределено;
	
	Возврат ЕстьВНаборе;
	
КонецФункции

// Удаляет из сетка данные об использовании функциональности
//
// Параметры:
//  Функциональность - Строка - см. функцию Перечисление_ФункциональностьМодуля();
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - (необязательный) организация;
//
&НаКлиенте
Процедура Метрики_Функциональность_Удалить(Функциональность, Организация = Неопределено) Экспорт
	
	Если Организация = Неопределено Тогда
		Организация = ИмяОбщейОрганизацииДляМетрик();
	КонецЕсли;
	
	СтекМетрик = СтекМетрик_Прочитать();
	
	НаборФункциональности = СтекМетрик.ФункциональностьПоОрганизациям[Организация];
	Если НаборФункциональности = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НаборФункциональности.Удалить(Функциональность);
	
	СтекМетрик_Поместить(СтекМетрик);
	
КонецПроцедуры

