		ОповещениеОЗакрытии = НовоеОписаниеОповещения(ОписаниеОбработчика);
		Форма.ПоказатьВыборИзСписка(ОповещениеОЗакрытии, СписокВыбора, Элемент, НачальноеЗначение);
	Иначе
		ВыбранноеЗначение = Форма.ВыбратьИзСписка(СписокВыбора, Элемент, НачальноеЗначение);
		ВызватьОбработчикОповещения(ОписаниеОбработчика, ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

