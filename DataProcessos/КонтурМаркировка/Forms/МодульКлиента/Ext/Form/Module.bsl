&НаКлиенте
Процедура ПоказатьДиалогВопроса(ОписаниеОбработчика, ТекстВопроса, Кнопки = Неопределено, ЗаголовокДиалога = "") Экспорт
	
	Если Кнопки = Неопределено Тогда
		Кнопки = РежимДиалогаВопрос.ДаНетОтмена;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗаголовокДиалога) Тогда
		ЗаголовокДиалога = НаименованиеМодуля();
	КонецЕсли;
	
	Если ДоступныАсинхронныеФормы() Тогда
		ОповещениеОЗакрытии = НовоеОписаниеОповещения(ОписаниеОбработчика);
		Выполнить("ПоказатьВопрос(ОповещениеОЗакрытии, ТекстВопроса, Кнопки, , , ЗаголовокДиалога)");
	Иначе
		Ответ = Вопрос(ТекстВопроса, Кнопки, , , ЗаголовокДиалога);
		ВызватьОбработчикОповещения(ОписаниеОбработчика, Ответ);
	КонецЕсли;
	
КонецПроцедуры

