&НаКлиенте
Процедура КонтурПлагины_ОбработатьСобытие_УФ(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка = Ложь)
	
	Если Не ИспользоватьПлагины() Тогда
		Возврат;
	КонецЕсли;
	
	СостоянияПлагина = Перечисление_СостоянияПлагина();
	
	МассивПлагинов = КонтурПлагины_СписокПлагинов();
	Если Не ЗначениеЗаполнено(МассивПлагинов) Тогда
		Возврат;
	КонецЕсли;
	
	Если СтандартнаяОбработка Тогда
		ПараметрыСобытия.Вставить("СтандартнаяОбработка", СтандартнаяОбработка);
	КонецЕсли;
	
	Для Каждого ОписаниеПлагина Из МассивПлагинов Цикл
		Если ОписаниеПлагина.Состояние = СостоянияПлагина.Включен
			И ОписаниеПлагина.События.Найти(ИмяСобытия) <> Неопределено Тогда
			КонтурПлагин_ОбработатьСобытие(ОписаниеПлагина, ИмяСобытия, ПараметрыСобытия);
		КонецЕсли;
	КонецЦикла;
	
	Если СтандартнаяОбработка Тогда
		СтандартнаяОбработка = ПараметрыСобытия.СтандартнаяОбработка;
		ПараметрыСобытия.Удалить("СтандартнаяОбработка");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция КонтурПлагины_СписокПлагинов()
	
	КлючКэш = КлючКэш_СписокПлагинов();
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	СлужебныеКоманды = Перечисление_СлужебныеКомандыБиблиотекиПлагинов();
	
	ПараметрыСобытия = Новый Структура;
	ПараметрыСобытия.Вставить("Результат");
	
	КонтурПлагины_ОбработатьСлужебнуюКоманду(
		СлужебныеКоманды.ПолучитьСписокПлагинов,
		ПараметрыСобытия
	);
	
	Результат = ПараметрыСобытия.Результат;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура КонтурПлагин_ОбработатьСобытие(ОписаниеПлагина, ИмяСобытия, ПараметрыСобытия)
	
	СлужебныеКоманды = Перечисление_СлужебныеКомандыБиблиотекиПлагинов();
	ИдентификаторПлагина = ОписаниеПлагина.Идентификатор;
	
	ПараметрыКоманды = Новый Структура;
	ПараметрыКоманды.Вставить("Результат");
	ПараметрыКоманды.Вставить("Идентификатор", ИдентификаторПлагина);
	
	КонтурПлагины_ОбработатьСлужебнуюКоманду(
		СлужебныеКоманды.ПолучитьНастройкиПлагина,
		ПараметрыКоманды
	);
	
	Если ПараметрыКоманды.Результат.Успешно Тогда
		НастройкиПлагина = ПараметрыКоманды.Результат.Данные;
	Иначе
		НастройкиПлагина = Неопределено;
	КонецЕсли;
	
	МодульПлагина = КонтурПлагин_СоздатьОбъект(ИдентификаторПлагина);
	Если МодульПлагина = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		МодульПлагина.ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия, НастройкиПлагина);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Обработка события в плагине'");
		ТекстСообщения = НСтр("ru = 'Не удалось обработать событие ""%1"" в плагине ""%2""'");
		ТекстСообщения = ПараметрыВСтроку(ТекстСообщения, ИдентификаторПлагина);
		
		ДопИнформация = Новый СписокЗначений;
		ДопИнформация.Добавить(ИдентификаторПлагина, "Имя обработки");
		ДопИнформация.Добавить(ИмяСобытия, "Имя события");
		
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация, ТекстСообщения);
		
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция КонтурПлагин_СоздатьОбъект(ИдентификаторПлагина, Владелец = Неопределено)
	
	Если Владелец = Неопределено Тогда
		Владелец = ЭтаФорма;
	КонецЕсли;
	
	ПутьКФорме = "ВнешняяОбработка." + ИдентификаторПлагина + ".Форма.КлиентскиеВызовы";
	
	Попытка
		
		Результат = ПолучитьФорму(ПутьКФорме, , Владелец);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Создание плагина'");
		ТекстСообщения = НСтр("ru = 'Не удалось создать плагин: %1'");
		ТекстСообщения = ПараметрыВСтроку(ТекстСообщения, ИдентификаторПлагина);
		
		ДопИнформация = Новый СписокЗначений;
		ДопИнформация.Добавить(ИдентификаторПлагина, "Имя обработки");
		ДопИнформация.Добавить(ПутьКФорме, "Путь к форме");
		
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация, ТекстСообщения);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

