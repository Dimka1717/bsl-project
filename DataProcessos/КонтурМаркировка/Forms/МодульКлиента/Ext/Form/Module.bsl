// Контракт описания обработчика оповещения
//
// Параметры:
//  Обработчик - Строка - имя обработчика;
//  Модуль - ФормаКлиентскогоПриложения - форма, в которой расположен модуль обработчика;
//  ДопПараметры - Структура - доп параметры для
// 
// Возвращаемое значение:
//  Структура - содержит входящие параметры
//
&НаКлиенте
Функция ОписаниеОбработчикаОповещения(Обработчик, Модуль, ДопПараметры = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Модуль", Модуль);
	Результат.Вставить("Обработчик", Обработчик);
	Результат.Вставить("ДопПараметры", ДопПараметры);
	
	Возврат Результат;
	
КонецФункции

// Проверяет, что в базе можно асинхронно открывать формы с подключением обработчика оповещения
// 
// Возвращаемое значение:
//  Булево - Истина, если использовать асинхронное открытие форм можно
//
&НаКлиенте
Функция ДоступныАсинхронныеФормы() Экспорт
	
	Возврат Не ВерсияРежимаСовместимостиНиже("8.3.3");
	
КонецФункции

// Создает описание оповещения
//
// Параметры:
//  ОписаниеОбработчика - Структура - см. ОписаниеОбработчикаОповещения()
// 
// Возвращаемое значение:
//  ОписаниеОповещения - описание оповещения;
//  Неопределено - если описания обработчика нет;
//
&НаКлиенте
Функция НовоеОписаниеОповещения(ОписаниеОбработчика) Экспорт
	
	Если ОписаниеОбработчика = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ОписаниеОбработчика) = Тип("ОписаниеОповещения") Тогда
		Возврат ОписаниеОбработчика;
	КонецЕсли;
	
	ПараметрыОповещения = Новый Массив;
	ПараметрыОповещения.Добавить(ОписаниеОбработчика.Обработчик);
	ПараметрыОповещения.Добавить(ОписаниеОбработчика.Модуль);
	ПараметрыОповещения.Добавить(ОписаниеОбработчика.ДопПараметры);
	
	Результат = Новый("ОписаниеОповещения", ПараметрыОповещения);
	
	Возврат Результат;
	
КонецФункции

// Вызывает экспортный метод в модуле
//
// Параметры:
//  ОписаниеОбработчика - Структура - см ОписаниеОбработчикаОповещения();
//  Результат - Произвольный - (необязательный) результат, который нужно передать в обработчик;
//
&НаКлиенте
Процедура ВызватьОбработчикОповещения(ОписаниеОбработчика, Результат = NULL) Экспорт
	
	Если ОписаниеОбработчика = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДоступныАсинхронныеФормы() Тогда
		
		Оповещение = НовоеОписаниеОповещения(ОписаниеОбработчика);
		
		Если Результат = NULL Тогда
			СтрокаКоманды = "ВыполнитьОбработкуОповещения(Оповещение)";
		Иначе
			СтрокаКоманды = "ВыполнитьОбработкуОповещения(Оповещение, Результат)";
		КонецЕсли;
		
		Выполнить(СтрокаКоманды);
		
	Иначе
		
		ПараметрыОповещения = Новый Структура;
		ПараметрыОповещения.Вставить("Результат", Результат);
		ПараметрыОповещения.Вставить("ОписаниеОбработчика", ОписаниеОбработчика);
		Кэш_Поместить("ПараметрыВызоваОбработчикаОповещенияОФ", ПараметрыОповещения);
		
		ПодключитьОбработчикОжидания("ВызватьОбработчикОповещенияОФ", 0.1, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВызватьОбработчикОповещенияОФ()
	
	ПараметрыОповещения = Кэш_Прочитать("ПараметрыВызоваОбработчикаОповещенияОФ");
	Кэш_Поместить("ПараметрыВызоваОбработчикаОповещенияОФ", Неопределено);
	
	Результат = ПараметрыОповещения.Результат;
	ОписаниеОбработчика = ПараметрыОповещения.ОписаниеОбработчика;
	
	Модуль = ОписаниеОбработчика.Модуль;
	Обработчик = ОписаниеОбработчика.Обработчик;
	ДопПараметры = ОписаниеОбработчика.ДопПараметры;
	
	Если Результат = NULL Тогда
		СтрокаКоманды = "Модуль." + Обработчик + "(ДопПараметры)";
	Иначе
		СтрокаКоманды = "Модуль." + Обработчик + "(Результат, ДопПараметры)";
	КонецЕсли;
	
	Выполнить(СтрокаКоманды);
	
КонецПроцедуры

// Формирует сообщение об ошибке привязанное к ячейке табличной части
//
// Параметры:
//  ТекстОшибки - Строка - текст ошибки;
//  ИдентификаторФормы - УникальныйИдентификатор - идентификатор формы, к которой должно быть "привязано" сообщение;
//  ТаблицаФормы - ТаблицаФормы - таблица, к которой должно быть "привязано" сообщение;
//  ИмяКолонки   - Строка - имя колонки, к которой должно быть "привязано" сообщение;
//  ИндексСтроки - Число  - индекс строки, к которой должно быть "привязано" сообщение;
//
&НаКлиенте
Процедура СообщитьОбОшибкеВСтрокеТабЧасти(ТекстОшибки
	, ИдентификаторФормы
	, ТаблицаФормы
	, ИмяКолонки
	, ИндексСтроки) Экспорт
	
	Если ВерсияПлатформыНиже("8.3") Тогда
		НомерСтроки = ИндексСтроки + 1;
		ТекстСообщения = ПараметрыВСтроку(НСтр(
		"ru = 'В таб. части ""%1"" в строке %2: %3'"), ТаблицаФормы.Заголовок, НомерСтроки, ТекстОшибки);
		СообщитьПользователюЛок(ТекстСообщения, ИдентификаторФормы);
	Иначе
		Индекс = Формат(ИндексСтроки, "ЧН=0; ЧГ=0");
		ПолеФормы = ПараметрыВСтроку("%1[%2].%3", ТаблицаФормы.Имя, Индекс, ИмяКолонки);
		СообщитьПользователюЛок(ТекстОшибки, ИдентификаторФормы, ПолеФормы);
	КонецЕсли;
	
КонецПроцедуры

