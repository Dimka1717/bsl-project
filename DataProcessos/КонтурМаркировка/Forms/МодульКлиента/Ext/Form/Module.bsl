&НаКлиенте
Процедура НачатьЗамерПроизводительности(Действие) Экспорт
	
	ОписаниеЗамера = Новый_ОписаниеЗамера();
	
	СтекМетрик = СтекМетрик_Прочитать();
	СтекМетрик.ЗамерыПроизводительности.Вставить(Действие, ОписаниеЗамера);
	СтекМетрик_Поместить(СтекМетрик);
	
КонецПроцедуры

&НаКлиенте
Процедура ОстановитьЗамерПроизводительности(Действие) Экспорт
	
	СтекМетрик = СтекМетрик_Прочитать();
	
	ОписаниеЗамера = СтекМетрик.ЗамерыПроизводительности[Действие];
	Если ОписаниеЗамера = Неопределено Тогда
		ОстановитьЗамерПроизводительностиНаСервере(Действие);
		Возврат;
	КонецЕсли;
	
	ОписаниеЗамера.ВремяНачалаПаузы = ТекущийTimestamp();
	
	СтекМетрик_Поместить(СтекМетрик);
	
КонецПроцедуры

&НаСервере
Процедура ОстановитьЗамерПроизводительностиНаСервере(Действие)
	
	МодульОбъекта().ОстановитьЗамерПроизводительности(Действие);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗамерПроизводительности(Действие) Экспорт
	
	СтекМетрик = СтекМетрик_Прочитать();
	
	ОписаниеЗамера = СтекМетрик.ЗамерыПроизводительности[Действие];
	Если ОписаниеЗамера = Неопределено Тогда
		ПродолжитьЗамерПроизводительностиНаСервере(Действие);
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеЗамера.ВремяНачалаПаузы) Тогда
		ДлительностьПаузы = ТекущийTimestamp() - ОписаниеЗамера.ВремяНачалаПаузы;
		ОписаниеЗамера.ДлительностьПаузы = ОписаниеЗамера.ДлительностьПаузы + ДлительностьПаузы;
		ОписаниеЗамера.ВремяНачалаПаузы = Неопределено;
	КонецЕсли;
	
	СтекМетрик_Поместить(СтекМетрик);
	
КонецПроцедуры

&НаСервере
Процедура ПродолжитьЗамерПроизводительностиНаСервере(Действие)
	
	МодульОбъекта().ПродолжитьЗамерПроизводительности(Действие);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьЗамерПроизводительности(Действие, ДопПараметры = Неопределено) Экспорт
	
	СтекМетрик = СтекМетрик_Прочитать();
	ОписаниеЗамера = СтекМетрик.ЗамерыПроизводительности[Действие];
	Если ОписаниеЗамера = Неопределено Тогда
		ЗавершитьЗамерПроизводительностиНаСервере(Действие);
		Возврат;
	КонецЕсли;
	
	СтекМетрик.ЗамерыПроизводительности.Удалить(Действие);
	СтекМетрик_Поместить(СтекМетрик);
	
	Топик = Перечисление_ТопикиМетрики().Здоровье;
	Категория = Перечисление_КатегорииМетрики().ЗамерПроизводительности;
	ДопСведения = ОписаниеЗамераПроизводительности(ОписаниеЗамера, ДопПараметры);
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения);
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

&НаСервере
Процедура ЗавершитьЗамерПроизводительностиНаСервере(Действие, ДопПараметры = Неопределено)
	
	МодульОбъекта().ЗавершитьЗамерПроизводительности(Действие, ДопПараметры);
	
КонецПроцедуры

&НаКлиенте
Функция ОписаниеЗамераПроизводительности(ОписаниеЗамера, ДопПараметры = Неопределено)
	
	ВремяНачалаЗамера = ОписаниеЗамера.ВремяНачалаЗамера;
	ДлительностьПаузы = ОписаниеЗамера.ДлительностьПаузы;
	ВремяОкончанияЗамера = ТекущийTimestamp();
	
	Если ЗначениеЗаполнено(ОписаниеЗамера.ВремяНачалаПаузы) Тогда
		ДлительностьПаузы = ДлительностьПаузы + (ВремяОкончанияЗамера - ОписаниеЗамера.ВремяНачалаПаузы);
	КонецЕсли;
	
	Длительность = (ВремяОкончанияЗамера - ВремяНачалаЗамера) - ДлительностьПаузы;
	
	Результат = Новый Структура;
	Результат.Вставить("Длительность", Длительность);
	Результат.Вставить("ВремяНачалаЗамера", ВремяНачалаЗамера);
	Результат.Вставить("ВремяОкончанияЗамера", ВремяОкончанияЗамера);
	
	Если ЗначениеЗаполнено(ДопПараметры) Тогда
		ДополнитьСтруктуру(Результат, ДопПараметры);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Новый_ОписаниеЗамера()
	
	Результат = Новый Структура;
