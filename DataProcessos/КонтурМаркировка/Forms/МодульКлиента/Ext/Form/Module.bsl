&НаКлиенте
Функция ЭтоСписокЗначений(Значение)
	
	Возврат ТипЗнч(Значение) = Тип("СписокЗначений");
	
КонецФункции

// Безопасно заполняет поля структуры значениями из другой структуры
// Пустые значения источника при этом игнорируются
//
// Параметры:
//  Приемник - Структура - структура, которую надо заполнить;
//  Источник - Структура, ФиксированнаяСтруктура - структура, из которой надо взять значения;
//
&НаКлиенте
Процедура ЗаполнитьПоляСтруктуры(Приемник, Источник)
	
	Если Не ЭтоСтруктура(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Элемент Из Источник Цикл
		
		Ключ	 = Элемент.Ключ;
		Значение = Элемент.Значение;
		
		Если ЗначениеЗаполнено(Значение) И Приемник.Свойство(Ключ) Тогда
			Приемник[Ключ] = Значение;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Записывает строку в двоичные данные
//
// Параметры:
//  Строка - Строка - строка, которую нужно записать в двоичные данные
// 
// Возвращаемое значение:
//  ДвоичныеДанные
//
&НаКлиенте
Функция ДвоичныеДанныеИзСтроки(Строка, Кодировка = "UTF-8") Экспорт
	
	Если ВерсияПлатформыНиже("8.3.10") Тогда
		
		#Если Не ВебКлиент Тогда
			
			ИмяФайла = ПолучитьИмяВременногоФайла();
			Текст = Новый ТекстовыйДокумент;
			Текст.УстановитьТекст(Строка);
			Текст.Записать(ИмяФайла, "UTF-8");
			
			// BSLLS:FileSystemAccess-off
			Результат = Новый ДвоичныеДанные(ИмяФайла);
			УдалитьФайлы(ИмяФайла);
			// BSLLS:FileSystemAccess-on
			
		#КонецЕсли
		
	Иначе
		Результат = Вычислить("ПолучитьДвоичныеДанныеИзСтроки(Строка, Кодировка)");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает строку из двоичных данных
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - двоичные данные, в которых содержится строка;
//  Кодировка - КодировкаТекста, Строка - (необязательный) кодировка текста;
// 
// Возвращаемое значение:
//  Строка
//
&НаКлиенте
Функция СтрокаИзДвоичныхДанных(ДвоичныеДанные, Кодировка = "UTF-8")
	
	Если Не ЗначениеЗаполнено(ДвоичныеДанные) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ВерсияПлатформыНиже("8.3.10") Тогда
		
		#Если Не ВебКлиент Тогда
			
			ИмяФайла = ПолучитьИмяВременногоФайла();
			ДвоичныеДанные.Записать(ИмяФайла);
			Текст = Новый ТекстовыйДокумент;
			Текст.Прочитать(ИмяФайла, Кодировка);
			Результат = Текст.ПолучитьТекст();
			
			// BSLLS:FileSystemAccess-off
			УдалитьФайлы(ИмяФайла);
			// BSLLS:FileSystemAccess-on
			
		#КонецЕсли
		
	Иначе
		Результат = Вычислить("ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, Кодировка)");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Дополняет структуру или соответсвие приемник из данных источника
//
// Параметры:
//  Приемник - Структура, Соответствие
//  Источник - Структура, Соответствие
//
&НаКлиенте
Процедура ДополнитьСтруктуру(Приемник, Источник) Экспорт
	
	Для Каждого КлючИЗначение Из Источник Цикл
		Приемник.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
КонецПроцедуры

// Ищет подходящие строки в массиве структур
//
// Параметры:
//  МассивСтруктур  - Массив	 - содержит структуры с одинаковым набором свойств;
//  ПараметрыОтбора - Структура	 - условия поиска, где:
//   * Ключ		 - имя свойства в структурах массива;
//   * Значение	 - подходящее значение;
//
// Возвращаемое значение:
//  Массив - содержит подходящие структуры
//
&НаКлиенте
Функция МассивСтруктур_НайтиСтроки(МассивСтруктур, ПараметрыОтбора) Экспорт
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(МассивСтруктур) Тогда
		
		Для Каждого Структура Из МассивСтруктур Цикл
			
			СтруктураСоответствуетОтбору = Истина;
			
			Для Каждого ЭлементОтбора Из ПараметрыОтбора Цикл
				
				Если Структура[ЭлементОтбора.Ключ] <> ЭлементОтбора.Значение Тогда
					СтруктураСоответствуетОтбору = Ложь;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
			Если СтруктураСоответствуетОтбору Тогда
				Результат.Добавить(Структура);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Находит в массиве структур первую строку с нужным значением
//
// Параметры:
//  МассивСтруктур - Массив - содержит структуры с одинаковым набором полей;
//  Значение - Произвольный - значение, которое нужно найти;
//  ИмяПоля - Строка - имя поля в котором нужно искать;
// 
// Возвращаемое значение:
//  Структура - структура из массива;
//  Неопределено - если не удалось найти подходящую строку;
//
&НаКлиенте
Функция МассивСтруктур_Найти(МассивСтруктур, Значение, ИмяПоля) Экспорт
	
	Если Не ЗначениеЗаполнено(МассивСтруктур) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отбор = Новый Структура(ИмяПоля, Значение);
	
	НайденныеСтроки = МассивСтруктур_НайтиСтроки(МассивСтруктур, Отбор);
	
	Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
		Результат = НайденныеСтроки[0];
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Выгружает значения поля из массива структур в новый массив
//
// Параметры:
//  МассивСтруктур - Массив - массив содержит структуры;
//  ИмяПоля - Строка - поле, значения которого нужно выгрузить;
// 
// Возвращаемое значение:
//  Массив - массив значений из структур
//
&НаКлиенте
Функция МассивСтруктур_Выгрузить(МассивСтруктур, ИмяПоля)
	
	Результат = Новый Массив;
	
	Для каждого Элемент Из МассивСтруктур Цикл
		Результат.Добавить(Элемент[ИмяПоля]);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Разбивает массив структур на части по значению поля
// и помещяет эти части в соответствие
//
// Параметры:
//  МассивСтруктур - Массив - массив содержит структуры;
//  ИмяПоля        - Строка - имя поля, по которому нужно разбить массив;
// 
// Возвращаемое значение:
//  Соответствие - содержит:
//   Ключ     - Произвольное - значение поля;
//   Значение - Массив       - часть массива, с указанным значением;
//
&НаКлиенте
Функция МассивСтруктур_Разбить(МассивСтруктур, ИмяПоля)
	
	Результат = Новый Соответствие;
	
	Для каждого Элемент Из МассивСтруктур Цикл
		
		ЗначениеПоля = Элемент[ИмяПоля];
		ЧастьМассива = Результат[ЗначениеПоля];
		
		Если ЧастьМассива = Неопределено Тогда
			ЧастьМассива = Новый Массив;
			Результат.Вставить(ЗначениеПоля, ЧастьМассива);
		КонецЕсли;
		
		ЧастьМассива.Добавить(Элемент);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Очищает список и заполняет новыми значениями
// Из структуры добавляет только значения
//
// Параметры:
//  СписокВыбора - СписокЗначений - список, который нужно заполнить;
//  ЗначенияСписка - СписокЗначений, Массив, Структура - новые значения;
//
&НаКлиенте
Процедура ЗаполнитьСписокВыбора(СписокВыбора, ЗначенияСписка) Экспорт
	
	СписокВыбора.Очистить();
	
	Если ЭтоМассив(ЗначенияСписка) Тогда
		Для Каждого Значение Из ЗначенияСписка Цикл
			СписокВыбора.Добавить(Значение);
		КонецЦикла;
	ИначеЕсли ЭтоСтруктура(ЗначенияСписка) Тогда
		Для Каждого Элемент Из ЗначенияСписка Цикл
			СписокВыбора.Добавить(Элемент.Значение, Элемент.Значение);
		КонецЦикла;
	ИначеЕсли ЭтоСписокЗначений(ЗначенияСписка) Тогда
		Для Каждого Элемент Из ЗначенияСписка Цикл
			СписокВыбора.Добавить(Элемент.Значение, Элемент.Представление);
		КонецЦикла;
	Иначе
		СписокВыбора.Добавить(ЗначенияСписка);
	КонецЕсли;
	
КонецПроцедуры

// Объединяет части пути через разделитель
//
&НаКлиенте
Функция ОбъединитьПути(Часть1, Часть2, Часть3 = Неопределено, Часть4 = Неопределено) Экспорт
	
	Результат = "";
	РазделительПути = РазделительПути();
	ЧастиПути = НовыйМассив(Часть1, Часть2, Часть3, Часть4);
	
	Для Каждого Элемент Из ЧастиПути Цикл
		
		Если Не ЗначениеЗаполнено(Элемент) Тогда
			Прервать;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Результат) Тогда
			Результат = Элемент;
			Продолжить;
		КонецЕсли;
		
		Если Прав(Результат, 1) <> РазделительПути Тогда
			Результат = Результат + РазделительПути;
		КонецЕсли;
		
		Результат = Результат + Элемент;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает разделитель пути, используемого в операционной системе
// 
// Возвращаемое значение:
//  Строка
//
&НаКлиенте
Функция РазделительПути()
	
	СисИнфо = ИнформацияОСистеме();
	
	Если Найти(СисИнфо.ТипПлатформы, "Linux") > 0 Тогда
		Результат = "/";
	Иначе
		Результат = "\";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает имя текущего компьютера,
// для вэб-клиента возвращает пустую строку
// 
// Возвращаемое значение:
//  Строка - имя компьютера
//
&НаКлиенте
Функция ИмяТекущегоКомпьютера()
	
	Результат = "";
	
	#Если Не ВебКлиент Тогда
		Результат = ИмяКомпьютера();
	#КонецЕсли
	
	Возврат Результат;
	
КонецФункции

// Возвращает ссылку на общий модуль по его имени
//
// Параметры:
//  ИмяОбщегоМодуля - Строка - имя общего модуля
//
// Возвращаемое значение:
//  ОбщийМодуль - общий модуль
//
&НаКлиенте
Функция ОбщийМодуль(ИмяОбщегоМодуля) Экспорт
	
	КлючКэш = "ОбщийМодуль " + ИмяОбщегоМодуля;
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	МодульСуществует = ЕстьНеобходимыеМетаданные("ОбщиеМодули." + ИмяОбщегоМодуля);
	
	Если Не МодульСуществует Тогда
		ВызватьИсключение ПараметрыВСтроку(
		НСтр("ru = 'Общий модуль ""%1"" не найден.'"), ИмяОбщегоМодуля);
	КонецЕсли;
	
	Результат = Вычислить(ИмяОбщегоМодуля);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЕстьНеобходимыеМетаданные(СтрокаМетаданных)
	
	Результат = МодульОбъекта().ЕстьНеобходимыеМетаданные(СтрокаМетаданных);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЕстьЗначениеВСтруктуре(Структура, Значение)
	
	Для Каждого КлючИЗначение Из Структура Цикл
		Если КлючИЗначение.Значение = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ТекущийTimestamp()
	
	НачалоВремениUNIX = 62135596800000;
	
	МоментВремени = (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВремениUNIX) / МиллисекундВСекунде();
	
	Возврат МоментВремени;
	
КонецФункции

&НаКлиенте
Функция МиллисекундВСекунде()
	
	Возврат 1000;
	
КонецФункции

&НаКлиенте
Функция УниверсальнаяДатаXML(Значение)
	
	УниверсальнаяДата = УниверсальноеВремя(Значение);
	Результат = Формат(УниверсальнаяДата, "ДФ=yyyy-MM-ddTHH:mm:ssZ");
	
	Возврат Результат;
	
КонецФункции

// Разделяет текст на части по указанному разделителю
//
// Параметры:
//  Строка - Строка - разделяемый текст;
//  Разделитель - Строка - (необязательный) значение разделителя;
//  ВключатьПустые - Булево - Истина, если пустые части нужно включить в результат;
// 
// Возвращаемое значение:
//  Массив - содержит части текста
//
&НаКлиенте
Функция РазделитьСтроку(Знач Строка, Разделитель = ",", ВключатьПустые = Ложь) Экспорт
	
	ДлинаРазделителя = СтрДлина(Разделитель);
	
	Если ДлинаРазделителя = 1
		И Не ВерсияПлатформыНиже("8.3.6")
		И Не ВерсияРежимаСовместимостиНиже("8.3.6") Тогда
		
		Результат = Вычислить("СтрРазделить(Строка, Разделитель, ВключатьПустые)");
		
		Для Сч = 0 По Результат.ВГРаница() Цикл
			Результат[Сч] = СокрЛП(Результат[Сч]);
		КонецЦикла;
		
		Возврат Результат;
		
	КонецЕсли;
	
	Результат = Новый Массив;
	
	Пока Истина Цикл
		
		Поз = Найти(Строка, Разделитель);
		
		Если Поз = 0 Тогда
			ЧастьСтроки = СокрЛП(Строка);
			Строка = "";
		Иначе
			ЧастьСтроки = СокрЛП(Лев(Строка, Поз - 1));
			Строка = Сред(Строка, Поз + ДлинаРазделителя);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЧастьСтроки) Или ВключатьПустые Тогда
			Результат.Добавить(ЧастьСтроки);
		КонецЕсли;
		
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Безопасно получает значение из массива по его индексу
//
// Параметры:
//  Массив              - Массив       - массив, из которого нужно получить значение
//  ИндексЗначения      - Число        - индекс значения
//  ЗначениеПоУмолчанию - Произвольный - значение, которое нужно вернуть
//                                       если указанный индекс выходит за границу массива
// 
// Возвращаемое значение:
//  Произвольный - значение из массива. ЗначениеПоУмолчанию если индекс выходит за границы массива
//
&НаКлиенте
Функция ЗначениеИзМассива(Массив, ИндексЗначения, ЗначениеПоУмолчанию = Неопределено)
	
	Результат = ЗначениеПоУмолчанию;
	
	Если ИндексЗначения <= Массив.ВГраница() Тогда
		Результат = Массив[ИндексЗначения];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПустаяВерсия()
	
	Возврат "0.0.0";
	
КонецФункции

// Проверяет что файл существует
// 
// Возвращаемое значение:
//  Булево - Истина, если файл существует
//
&НаКлиенте
Функция ФайлСуществует(ПутьКФайлу)
	
	Файл = НовыйФайл(ПутьКФайлу);
	
	Результат = Файл.Существует();
	
	Возврат Результат;
	
КонецФункции

// Получает описания переданных файлов
//
// Параметры:
//  Файлы - Массив из Строка - полные имена файлов;
// 
// Возвращаемое значение:
//  Массив из Структура - см. функцию Новый_ОписаниеФайла();
//
&НаКлиенте
Функция ОписанияФайлов(Файлы) Экспорт
	
	Результат = Новый Массив;
	
	Для Каждого ПолноеИмя Из Файлы Цикл
		
		Файл = НовыйФайл(ПолноеИмя);
		ОписаниеФайла = Новый_ОписаниеФайла();
		ЗаполнитьЗначенияСвойств(ОписаниеФайла, Файл);
		// BSLLS:FileSystemAccess-off
		ОписаниеФайла.ДвоичныеДанные = Новый ДвоичныеДанные(ПолноеИмя);
		// BSLLS:FileSystemAccess-on
		
		Результат.Добавить(ОписаниеФайла);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает структуру с описанием файла.
// Пример значений полей для файла "c:\temp\test.txt" в описании полей.
// 
// Возвращаемое значение:
//  Структура - описание файла:
//   * Имя - Строка - имя файла (test.txt);
//   * ИмяБезРасширения - Строка - имя файла без расширения (test);
//   * ПолноеИмя - Строка - полное имя файла (c:\temp\test.txt);
//   * Путь - Строка - путь к файлу (c:\temp\);
//   * Расширение - Строка - расширение (.txt);
//   * ДвоичныеДанные - ДвоичныеДанные - двоичные данные файла;
//
&НаКлиенте
Функция Новый_ОписаниеФайла()
	
	Результат = Новый Структура;
	Результат.Вставить("Имя");
	Результат.Вставить("ИмяБезРасширения");
	Результат.Вставить("ПолноеИмя");
	Результат.Вставить("Путь");
	Результат.Вставить("Расширение");
	Результат.Вставить("ДвоичныеДанные");
	
	Возврат Результат;
	
КонецФункции

// Опеределяет доступность PATCH-запроса на текущей версии платформы
//
// Параметры:
//  Действие - Строка - текст ошибки, который будет показан если запрос не доступен;
// 
// Возвращаемое значение:
//  Булево - Истина, если PATCH-запрос доступен;
//
&НаКлиенте
Функция ДоступенPATCHЗапрос(Действие) Экспорт
	
	Результат = Истина;
	
	ДопустимаяВерсияПлатформы = "8.3.6";
	ТекущаяВерсияПлатформы = ВерсияПлатформы();
	
	ШаблонОшибки = НСтр("ru = '%1 можно только в платформе версии %2 и выше.
	|Текущая версия платформы %3, обновите версию платформы.'");
	
	Если ВерсияПлатформыНиже(ДопустимаяВерсияПлатформы) Тогда
		ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, Действие, ДопустимаяВерсияПлатформы, ТекущаяВерсияПлатформы);
		СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор);
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЧислоИзСтроки(Строка)
	
	Если Не ЗначениеЗаполнено(Строка) Тогда
		Возврат 0;
	КонецЕсли;
	
	КодСимвола0 = КодСимвола("0");
	КодСимвола9 = КодСимвола("9");
	ДлинаСтроки = СтрДлина(Строка);
	ЧислоСтрокой = "";
	
	Для Сч = 1 По ДлинаСтроки Цикл
		Символ = Сред(Строка, Сч, 1);
		Если Символ = "," Или Символ = "." Тогда
			ЧислоСтрокой = ЧислоСтрокой + Символ;
			Продолжить;
		КонецЕсли;
		КодСимвола = КодСимвола(Символ);
		Если КодСимвола >= КодСимвола0
			И КодСимвола <= КодСимвола9 Тогда
			ЧислоСтрокой = ЧислоСтрокой + Символ;
		КонецЕсли;
	КонецЦикла;
	
	ОписаниеЧисла = Новый ОписаниеТипов("Число");
	Результат = ОписаниеЧисла.ПривестиЗначение(ЧислоСтрокой);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЧислоСЕдиницейИзмерения(Число, ПараметрыИсчисленияЕдиницы) Экспорт
	
	РодИсчисления = "";
	ЧастиПараметров = РазделитьСтроку(ПараметрыИсчисленияЕдиницы, , Истина);
	ИндексРодаИсчисления = 3;
	Если ЧастиПараметров.ВГраница() >= ИндексРодаИсчисления Тогда
		РодИсчисления = ЧастиПараметров[ИндексРодаИсчисления];
	КонецЕсли;
	
	ПараметрыИсчисленияЧисла = ",,,%1,,,,,0";
	ПараметрыИсчисленияЧисла = ПараметрыВСтроку(ПараметрыИсчисленияЧисла, РодИсчисления);
	
	СтрокаЧислоСЕдиницей = ЧислоПрописью(Число, , ПараметрыИсчисленияЕдиницы);
	СтрокаТолькоЧисло = ЧислоПрописью(Число, , ПараметрыИсчисленияЧисла);
	СтрокаТолькоЕдиница = СокрЛП(СтрЗаменить(СтрокаЧислоСЕдиницей, СтрокаТолькоЧисло, ""));
	
	Результат = ПараметрыВСтроку("%1 %2", Число, СтрокаТолькоЕдиница);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СтрокаСодержитТолькоДопустимыеСимволы(Строка, ДопустимыеСимволы) Экспорт
	
	Для Позиция = 1 По СтрДлина(Строка) Цикл
		ТекущийСимвол = НРег(Сред(Строка, Позиция, 1));
		Если Найти(ДопустимыеСимволы, ТекущийСимвол) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ОбъектСодержитНедопустимыеСимволыXML(Значение)
	
	Результат = Ложь;
	
	Если ЭтоСтруктура(Значение) Или ЭтоСоответствие(Значение) Тогда
		
		Для Каждого КлючЗначение Из Значение Цикл
			Если ОбъектСодержитНедопустимыеСимволыXML(КлючЗначение.Значение) Тогда
				Результат = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ЭтоМассив(Значение) Тогда
		
		Для Каждого Элемент Из Значение Цикл
			Если ОбъектСодержитНедопустимыеСимволыXML(Элемент) Тогда
				Результат = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		
		Результат = НайтиНедопустимыеСимволыXML(Значение) > 0;
		
	Иначе
		
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

