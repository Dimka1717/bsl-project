Функция КонтекстПриложения()
	
	КлючКэш = "КонтекстПриложения";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Новый Структура;
	
	// Заполним при отправке на сервере
	Результат.Вставить("AppVersion");
	Результат.Вставить("Platform");
	
	Результат.Вставить("OS", ОписаниеОС());
	Результат.Вставить("Hardware", ОписаниеАппаратногоОбеспечения());
	
	ОписаниеБраузера = ОписаниеБраузера();
	Если ЗначениеЗаполнено(ОписаниеБраузера) Тогда
		Результат.Вставить("Browser", ОписаниеБраузера);
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

