// Документы учета

&НаКлиенте
Функция ДокументУчета_НайтиИлиСоздать(Документ1С, ВызывающаяФорма) Экспорт
	
	Результат = ДокументУчета_НайтиПоДокументу1СНаСервере(Документ1С);
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = ДокументУчета_СоздатьИЗагрузитьНовыеКоды(Документ1С, ВызывающаяФорма);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ДокументУчета_СоздатьИЗагрузитьНовыеКоды(Документ1С, ВызывающаяФорма)
	
	РезультатСоздания = ДокументУчета_СоздатьИПолучитьКодыИзПМ(Документ1С, ВызывающаяФорма.УникальныйИдентификатор);
	ДокументУчета = РезультатСоздания.ДокументУчета;
	
	Если Не РезультатСоздания.Свойство("АдресРезультатаПМ") Тогда
		Возврат ДокументУчета;
	КонецЕсли;
	
	Если Не ВыполнитьАвторизацию(РезультатСоздания.Организация, ВызывающаяФорма) Тогда
		ДокументУчета_Удалить(ДокументУчета);
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		ДокументУчета_ЗагрузитьКодыВНовыйДокумент(ДокументУчета, РезультатСоздания.АдресРезультатаПМ);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Загрузка кодов маркировки в документ'");
		ДопИнформация = Новый Структура("Документ1С", Документ1С);
		ТекстСообщения = НСтр("ru = 'Не удалось загрузить коды маркировки в документ: %1'");
		ТекстСообщения = ПараметрыВСтроку(ТекстСообщения, Документ1С);
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация, ТекстСообщения, ВызывающаяФорма.УникальныйИдентификатор);
		ДокументУчета_Удалить(ДокументУчета);
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат ДокументУчета;
	
КонецФункции

&НаСервере
Функция ДокументУчета_НайтиПоДокументу1СНаСервере(Документ1С)
	
	Возврат МодульОбъекта().ДокументУчета_НайтиПоДокументу1С(Документ1С);
	
КонецФункции

&НаСервере
Функция ДокументУчета_СоздатьИПолучитьКодыИзПМ(Документ1С, ИдентификаторФормы)
	
	ДокументУчета = МодульОбъекта().ДокументУчета_НайтиПоДокументу1С(Документ1С);
	
	ЭтоНовыйДокумент = Не ЗначениеЗаполнено(ДокументУчета);
	
	Если ЭтоНовыйДокумент Тогда
		ОписаниеДокумента = МодульОбъекта().Новый_ДокументУчета();
		МодульОбъекта().ДокументУчета_Заполнить(ОписаниеДокумента, Документ1С);
	Иначе
		ОписаниеДокумента = МодульОбъекта().ДокументУчета_ПрочитатьДокумент(ДокументУчета);
	КонецЕсли;
	
	РезультатПМ = МодульОбъекта().ПМ_ТаблицаКодовДляНовогоДокумента(ОписаниеДокумента);
	
	Если ЭтоНовыйДокумент Тогда
		МодульОбъекта().ДокументУчета_Записать(ОписаниеДокумента);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ДокументУчета", ОписаниеДокумента.Ссылка);
	Результат.Вставить("Организация", ОписаниеДокумента.Организация);
	
	Если ЗначениеЗаполнено(РезультатПМ.ТаблицаКодов) Тогда
		Результат.Вставить("АдресРезультатаПМ", ПоместитьВоВременноеХранилище(РезультатПМ, ИдентификаторФормы));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ДокументУчета_ЗагрузитьКодыВНовыйДокумент(ДокументУчета, АдресРезультатаПМ)
	
	РезультатПМ = ПолучитьИзВременногоХранилища(АдресРезультатаПМ);
	УдалитьИзВременногоХранилища(АдресРезультатаПМ);
	
	ТаблицаКодов = РезультатПМ.ТаблицаКодов;
	ПараметрыЗагрузки = РезультатПМ.ПараметрыЗагрузкиКодов;
	
	МодульОбъекта().КодыДокументов_ДобавитьНовыеКоды(ТаблицаКодов, ДокументУчета, ПараметрыЗагрузки);
	
	СтатусыДокументаУчета = МодульОбъекта().СтатусыДокументаУчета_Прочитать(ДокументУчета);
	СтатусыДокументаУчета.ОсновнойСтатус = МодульОбъекта().Перечисление_СтатусыДокументовУчета().ВРаботе;
	СтатусыДокументаУчета.ТребуемоеДействие = МодульОбъекта().ДокументУчета_НовоеТребуемоеДействие(ДокументУчета
	, СтатусыДокументаУчета.ОсновнойСтатус);
	
	МодульОбъекта().СтатусыДокументаУчета_Записать(ДокументУчета, СтатусыДокументаУчета);
	
КонецПроцедуры

