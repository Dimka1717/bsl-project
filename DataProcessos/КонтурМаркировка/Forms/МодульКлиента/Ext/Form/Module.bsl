// #Область СтекМетрикНаКлиенте

&НаКлиенте
Функция СтекМетрик_Прочитать()
	
	Если КэшСтекаМетрик = Неопределено Тогда
		КэшСтекаМетрик = Новый_СтекМетрик();
		КэшСтекаМетрик.КонтекстПриложенияНаКлиенте = КонтекстПриложения();
	КонецЕсли;
	
	Возврат КэшСтекаМетрик;
	
КонецФункции

&НаКлиенте
Процедура СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики)
	
	СтекМетрик = СтекМетрик_Прочитать();
	СтекМетрик.Топики[Топик].Добавить(ОписаниеМетрики);
	СтекМетрик.РазмерСтека = СтекМетрик.РазмерСтека + 1;
	
	СтекМетрик_ЗаполнитьДатуПервогоСобытия(СтекМетрик);
	СтекМетрик_Поместить(СтекМетрик);
	
	Если НужноОтправитьМетрики(СтекМетрик) Тогда
		ОтправитьМетрики();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтекМетрик_ДобавитьФункциональность(Функциональность, Организация = Неопределено) Экспорт
	
	Если Организация = Неопределено Тогда
		Организация = ИмяОбщейОрганизацииДляМетрик();
	КонецЕсли;
	
	СтекМетрик = СтекМетрик_Прочитать();
	
	НаборФункциональности = СтекМетрик.ФункциональностьПоОрганизациям[Организация];
	Если НаборФункциональности = Неопределено Тогда
		НаборФункциональности = Новый Соответствие;
		СтекМетрик.ФункциональностьПоОрганизациям.Вставить(Организация, НаборФункциональности);
	КонецЕсли;
	
	КоличествоИспользований = ЗначениеСоответствия(НаборФункциональности, Функциональность, 0) + 1;
	НаборФункциональности.Вставить(Функциональность, КоличествоИспользований);
	
	СтекМетрик_ЗаполнитьДатуПервогоСобытия(СтекМетрик);
	СтекМетрик_Поместить(СтекМетрик);
	
КонецПроцедуры

&НаКлиенте
Процедура СтекМетрик_Поместить(СтекМетрик)
	
	КэшСтекаМетрик = СтекМетрик;
	
КонецПроцедуры

&НаКлиенте
Процедура СтекМетрик_Очистить(СтекМетрик)
	
	Для Каждого Элемент Из СтекМетрик.Топики Цикл
		Элемент.Значение.Очистить();
	КонецЦикла;
	
	СтекМетрик.РазмерСтека = 0;
	СтекМетрик.ДатаПервогоСобытия = '00010101';
	
	Для каждого Элемент1 Из СтекМетрик.ФункциональностьПоОрганизациям Цикл
		НаборФункций = Элемент1.Значение;
		Для каждого Элемент2 Из НаборФункций Цикл
			НаборФункций[Элемент2.Ключ] = 0;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СтекМетрик_ЗаполнитьДатуПервогоСобытия(СтекМетрик)
	
	Если Не ЗначениеЗаполнено(СтекМетрик.ДатаПервогоСобытия) Тогда
		СтекМетрик.ДатаПервогоСобытия = ТекущаяДата();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СтекМетрик_МаксимальныйРазмер()
	
	КлючКэш = "СтекМетрик_МаксимальныйРазмер";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = СтекМетрик_МаксимальныйРазмерНаСервере();
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СтекМетрик_МаксимальныйРазмерНаСервере()
	
	Возврат МодульОбъекта().СтекМетрик_МаксимальныйРазмер();
	
КонецФункции

