&НаКлиенте
Функция РазрешениеЭкрана()
	
	Если ВерсияПлатформыНиже("8.3.3.721") Тогда
		Возврат "";
	КонецЕсли;
	
	ОписаниеЭкранов = Вычислить("ПолучитьИнформациюЭкрановКлиента()");
	Если Не ЗначениеЗаполнено(ОписаниеЭкранов) Тогда
		Возврат "";
	КонецЕсли;
	
	ШиринаЭкрана = Формат(ОписаниеЭкранов[0].Ширина, "ЧГ=");
	ВысотаЭкрана = Формат(ОписаниеЭкранов[0].Высота, "ЧГ=");
	Результат = ПараметрыВСтроку("%1 x %2", ШиринаЭкрана, ВысотаЭкрана);
	
	Возврат Результат;
	
КонецФункции

