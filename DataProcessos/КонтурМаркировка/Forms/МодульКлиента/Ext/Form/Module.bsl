Функция Новый_ПараметрыНажатияДопКнопки() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяКнопки");
	Результат.Вставить("Размещение");
	
	ДопСведения = Новый Структура;
	ДопСведения.Вставить("ВыбранныеДокументы", Новый Массив);
	ДопСведения.Вставить("ВыбранныеДокументы1С", Новый Массив);
	ДопСведения.Вставить("ДокументУчета");
	ДопСведения.Вставить("Документ1С");
	ДопСведения.Вставить("Операция");
	
	Результат.Вставить("ДопСведения", ДопСведения);
	Результат.Вставить("ДопПараметры", Новый Структура);
	Результат.Вставить("ВызывающаяФорма");
	
	Возврат Результат;
	
