		Диалог.Показать(ОповещениеОЗакрытии);
	Иначе
		ФайлВыбран = Диалог.Выбрать();
		Если ФайлВыбран Тогда
			ВызватьОбработчикОповещения(ОписаниеОбработчика, Диалог.ВыбранныеФайлы);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Формирует и выводит сообщение, которое может быть "привязано" к форме.
//
// Параметры:
//  ТекстСообщения     - Строка                  - текст выводимого сообщения.
//  ИдентификаторФормы - УникальныйИдентификатор - идентификатор формы, к которой должно быть "привязано" сообщение.
//                                                 Если не указан, сообщение привязывается к активному окну.
//  ПолеФормы          - Строка                  - путь к реквизиту формы, для которого нужно вывести сообщение.
//
// Варианты вызова:
//   СообщитьПользователюЛок(НСтр("ru = 'Сообщение об ошибке.'")) - Сообщение будет "привязано" к активной форме.
//
//   СообщитьПользователюЛок(НСтр("ru = 'Сообщение об ошибке.'"),
//   ОбщийКонтекстКлиентСервер.ИдентификаторФормы)       - Сообщение будет "привязано" к основной форме.
//
//   СообщитьПользователюЛок(НСтр("ru = 'Сообщение об ошибке.'"),
//   ОбщийКонтекстКлиентСервер.ИдентификаторФормы,
//   "Объект.СписокДокументов[2]")                             - Сообщение выводится в списке документов основной формы
//                                                               рядом со строкой с индексом 2.
//
&НаКлиенте
Процедура СообщитьПользователюЛок(ТекстСообщения, ИдентификаторФормы = Неопределено, ПолеФормы = Неопределено) Экспорт
	
	Сообщение = Новый СообщениеПользователю;
	
	Сообщение.Текст = ТекстСообщения;
	
	Если ЗначениеЗаполнено(ИдентификаторФормы) Тогда
		Сообщение.ИдентификаторНазначения = ИдентификаторФормы;
	КонецЕсли;
	
	Если ПолеФормы <> Неопределено Тогда
		Сообщение.Поле = ПолеФормы;
	КонецЕсли;
	
	Сообщение.Сообщить();
	
КонецПроцедуры

&НаКлиенте
Процедура СообщитьРезультатЗагрузкиТоваров(РезультатЗагрузки, ИдентификаторФормы, СообщениеНетДанных = "") Экспорт
	
	Если Не ЗначениеЗаполнено(РезультатЗагрузки) Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьИзменения = СвойствоСтруктуры(РезультатЗагрузки, "ЕстьИзменения", Ложь);
	СозданоТоваров =РезультатЗагрузки.СозданоТоваров;
	ОбновленоТоваров = РезультатЗагрузки.ОбновленоТоваров;
	
	Если Не ЕстьИзменения
		И Не ЗначениеЗаполнено(СозданоТоваров)
		И Не ЗначениеЗаполнено(ОбновленоТоваров) Тогда
		Если ЗначениеЗаполнено(СообщениеНетДанных) Тогда
			СообщитьПользователюЛок(СообщениеНетДанных, УникальныйИдентификатор);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СозданоТоваров) Тогда
		ТекстСообщения = НСтр("ru = 'Создано новых товаров: %1'");
		ТекстСообщения = ПараметрыВСтроку(ТекстСообщения, СозданоТоваров);
		СообщитьПользователюЛок(ТекстСообщения, ИдентификаторФормы);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбновленоТоваров) Тогда
		ТекстСообщения = НСтр("ru = 'Обновлено товаров: %1'");
		ТекстСообщения = ПараметрыВСтроку(ТекстСообщения, ОбновленоТоваров);
		СообщитьПользователюЛок(ТекстСообщения, ИдентификаторФормы);
	КонецЕсли;
	
КонецПроцедуры

// Показывает вопрос для сохранения изменений в карточке объекта и вызывает нужный обработчик
//
// Параметры:
//  ОбработчикЗаписи - Строка - экспортный метод для записи изменений;
//  ВызывающаяФорма - ФормаКлиентскогоПриложения - форма владелец обработчика;
//  Отказ - Булево - признак отказа от закрытия формы;
//  ЗавершениеРаботы - Булево - признак того, что происходит процесс завершения работы приложения;
//
&НаКлиенте
Процедура СохранитьИзмененияНаФорме(ОбработчикЗаписи, ВызывающаяФорма, Отказ = Ложь, ЗавершениеРаботы = Ложь) Экспорт
	
	Если Не ВызывающаяФорма.Модифицированность Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоЗавершениеРаботыПрограммы(ЗавершениеРаботы) Тогда
		Возврат; // При завершении работы программы серверный вызов недоступен
	КонецЕсли;
	
	Отказ = Истина;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ВызывающаяФорма", ВызывающаяФорма);
	ДопПараметры.Вставить("ОбработчикЗаписи", ОбработчикЗаписи);
	
	ТекстВопроса = НСтр("ru = 'Сохранить изменения?'");
	ОписаниеОбработчика = ОписаниеОбработчикаОповещения("СохранитьИзмененияНаФормеПослеСогласия", ЭтаФорма, ДопПараметры);
	ПоказатьДиалогВопроса(ОписаниеОбработчика, ТекстВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИзмененияНаФормеПослеСогласия(Ответ, ДопПараметры) Экспорт
	
	ВызывающаяФорма = ДопПараметры.ВызывающаяФорма;
	ОбработчикЗаписи = ДопПараметры.ОбработчикЗаписи;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОписаниеОбработчика = ОписаниеОбработчикаОповещения(ОбработчикЗаписи, ВызывающаяФорма);
		ВызватьОбработчикОповещения(ОписаниеОбработчика);
	КонецЕсли;
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		ВызывающаяФорма.Модифицированность = Ложь;
		ВызывающаяФорма.Закрыть();
	КонецЕсли;
	
КонецПроцедуры

// Возвращает структуру параметров формы редактирования списка
// 
// Возвращаемое значение:
//  Структура - параметры диалога выбора файла:
//   * ЗаголовокФормы - Строка - Содержит текст заголовка окна диалога выбора файла (файлов);
//   * Список - СписокЗначений, Массив - Содержит редактируемый или просматриваемый список;
//   * РазрешитьРедактирование - Булево - Истина - список можно редактировать, Ложь - Только просмотр;
//   * ИспользоватьПометки - Булево - Истина - список редактируется только выставлением пометок;
//   * МассивТипов - Массив - Содержит массив возможных типов списка занчений
//
&НаКлиенте
Функция Новый_ПараметрыФормыРедактированияСписка() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Заголовок", "");
	Результат.Вставить("Список", Неопределено);
	Результат.Вставить("РазрешитьРедактирование", Ложь);
	Результат.Вставить("ИспользоватьПометки", Ложь);
	Результат.Вставить("МассивТипов", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура НастроитьКнопкуОбменаССервисом(Кнопка, ОбменССервисомВыполняется) Экспорт
	
	Если ОбменССервисомВыполняется Тогда
		Кнопка.Заголовок = НСтр("ru = 'Выполняется обмен...'");
		Кнопка.Доступность = Ложь;
	Иначе
		Кнопка.Заголовок = НСтр("ru = 'Обмен с сервисом'");
		Кнопка.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Авторизация

&НаСервере
Функция КонтекстОбменаНаСервере(Организация, ПродлеватьДоступГИС = Истина) Экспорт
	
	КонтекстОбмена = МодульОбъекта().КонтекстОбменаССервисом(Организация, , ПродлеватьДоступГИС);
	
	МодульОбъекта().Авторизация_Выполнить(КонтекстОбмена);
	
	Возврат КонтекстОбмена;
	
КонецФункции

&НаКлиенте
Функция Авторизация_Выполнить(КонтекстОбмена) Экспорт
	
	НужнаАвторизацияПортала = КонтекстОбмена.ТребуетсяАвторизацияПортала И Не КонтекстОбмена.ВыполненаАвторизацияПортала;
	НужнаАвторизацияГИС = КонтекстОбмена.ТребуетсяАвторизацияГИС И Не КонтекстОбмена.ВыполненаАвторизацияГИС;
	
	Если Не НужнаАвторизацияПортала И Не НужнаАвторизацияГИС Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПроверитьДоступностьПодписиНаКлиенте(КонтекстОбмена);
	Если Не КонтекстОбмена.ДоступнаПодписьНаКлиенте Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НужнаАвторизацияПортала Тогда
		Если АвторизацияПортал_Выполнить(КонтекстОбмена) Тогда
			// После авторизации на портале дополнительно проверяется доступ в ГИС МТ
			НужнаАвторизацияГИС = КонтекстОбмена.ТребуетсяАвторизацияГИС И Не КонтекстОбмена.ВыполненаАвторизацияГИС;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если НужнаАвторизацияГИС
		И Не АвторизацияГИС_Продлить(КонтекстОбмена) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция АвторизацияПортал_Выполнить(КонтекстОбмена)
	
	Организация = КонтекстОбмена.Организация;
	Сертификат = КонтекстОбмена.Сертификат;
	ОтпечатокСертификата = КонтекстОбмена.ОтпечатокСертификата;
	
	Попытка
		
		ФайлСертификата = Плагин_ФайлСертификата(ОтпечатокСертификата);
		ЗашифрованныйКлюч = Портал_ЗапроситьАвторизацию(ФайлСертификата);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = "Авторизация в сервисе Контур.Маркировка";
		ДопИнформация = Новый Структура;
		ДопИнформация.Вставить("Организация", Организация);
		ДопИнформация.Вставить("Сертификат", Сертификат);
		ТекстСообщения = ПараметрыВСтроку(НСтр(
		"ru = 'Не удалось выполнить авторизацию в сервисе Контур.Маркировка по организации: %1'"), Организация);
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация, ТекстСообщения);
		
		Если КонтекстОбмена.ВызыватьИсключение Тогда
			ВызватьИсключение;
		КонецЕсли;
		
		Возврат Ложь;
		
	КонецПопытки;
	
	Попытка
		
		РасшифрованныйКлюч = Плагин_РасшифроватьКонтент(ЗашифрованныйКлюч);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = "Расшифровка ключа авторизации в сервисе Контур.Маркировка";
		ДопИнформация = Новый Структура;
		ДопИнформация.Вставить("Организация", Организация);
		ДопИнформация.Вставить("Сертификат", Сертификат);
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
		
		КонтекстОбмена.ТекстОшибки = КраткоеПредставлениеОшибки(Ошибка);
		КонтекстОбмена.НеУдалосьРасшифроватьКонтент = Истина;
		
		Если КонтекстОбмена.ВызыватьИсключение Тогда
			ВызватьИсключение;
		КонецЕсли;
		
		Возврат Ложь;
		
	КонецПопытки;
	
	АвторизацияПортал_ВыполнитьПослеРасшифровки(РасшифрованныйКлюч, КонтекстОбмена);
	
	Возврат КонтекстОбмена.ВыполненаАвторизацияПортала;
	
КонецФункции

&НаСервере
Процедура АвторизацияПортал_ВыполнитьПослеРасшифровки(РасшифрованныйКлюч, КонтекстОбмена)
	
	МодульОбъекта().АвторизацияПортал_ВыполнитьПослеРасшифровки(РасшифрованныйКлюч, КонтекстОбмена);
	
КонецПроцедуры

&НаСервере
Процедура АвторизацияГИС_Проверить(КонтекстОбмена)
	
	МодульОбъекта().АвторизацияГИС_Проверить(КонтекстОбмена);
	
КонецПроцедуры

&НаСервере
Функция Портал_ЗапроситьАвторизацию(ФайлСертификата)
	
	Возврат МодульОбъекта().Портал_ЗапроситьАвторизацию(ФайлСертификата);
	
КонецФункции

&НаКлиенте
Функция АвторизацияГИС_Продлить(КонтекстОбмена)
	
	Организация = КонтекстОбмена.Организация;
	Сертификат = КонтекстОбмена.Сертификат;
	ОтпечатокСертификата = КонтекстОбмена.ОтпечатокСертификата;
	
	Попытка
		
		ФайлыДляПодписи = Маркировка_ФайлыАвторизацииГИС(Организация, Сертификат);
		АвторизацияГИС_ПодписатьФайлы(ФайлыДляПодписи, КонтекстОбмена);
		АвторизацияГИС_ПродлитьПослеПодписания(Организация, Сертификат, ФайлыДляПодписи);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = "Продление авторизации в ГИС МТ";
		ДопИнформация = Новый Структура;
		ДопИнформация.Вставить("Организация", Организация);
		ДопИнформация.Вставить("Сертификат", Сертификат);
		ТекстСообщения = ПараметрыВСтроку(НСтр(
		"ru = 'Не удалось продлить авторизацию в ГИС МТ по организации: %1'"), Организация);
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация, ТекстСообщения);
		
		КонтекстОбмена.ТекстОшибки = КраткоеПредставлениеОшибки(Ошибка);
		
		Если КонтекстОбмена.ВызыватьИсключение Тогда
			ВызватьИсключение;
		КонецЕсли;
		
		Возврат Ложь;
		
	КонецПопытки;
	
	КонтекстОбмена.ВыполненаАвторизацияГИС = Истина;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура АвторизацияГИС_ПодписатьФайлы(ФайлыДляПодписи, КонтекстОбмена)
	
	Организация = КонтекстОбмена.ОтпечатокСертификата;
	Сертификат = КонтекстОбмена.Сертификат;
	ОтпечатокСертификата = КонтекстОбмена.ОтпечатокСертификата;
	
	МассивФайлов = Новый Массив;
	Для каждого ОписаниеФайла Из ФайлыДляПодписи Цикл
		ДополнитьМассив(МассивФайлов, МассивСтруктур_Выгрузить(ОписаниеФайла.contents, "content"));
	КонецЦикла;
	
	Попытка
		
		Подписи = Плагин_ПодписатьДанные(МассивФайлов, ОтпечатокСертификата, Истина);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Подписание файлов для продления в ГИС МТ'");
		ДопИнформация = Новый Структура;
		ДопИнформация.Вставить("Организация", Организация);
		ДопИнформация.Вставить("Сертификат", Сертификат);
		ДопИнформация.Вставить("ОтпечатокСертификата", ОтпечатокСертификата);
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
		
		КонтекстОбмена.ТекстОшибки = КраткоеПредставлениеОшибки(Ошибка);
		КонтекстОбмена.НеУдалосьПодписатьФайлы = Истина;
		
		ВызватьИсключение;
		
	КонецПопытки;
	
	Для каждого ОписаниеФайла Из ФайлыДляПодписи Цикл
		Для каждого Элемент Из ОписаниеФайла.contents Цикл
			ИндексПодписи = МассивФайлов.Найти(Элемент.content);
			Элемент.content = Подписи[ИндексПодписи];
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура АвторизацияГИС_ПродлитьПослеПодписания(Организация, Сертификат, ПодписанныеФайлы)
	
	МодульОбъекта().АвторизацияГИС_ПродлитьПослеПодписания(Организация, Сертификат, ПодписанныеФайлы);
	
КонецПроцедуры

&НаСервере
Функция Маркировка_ФайлыАвторизацииГИС(Организация, Сертификат)
	
	Возврат МодульОбъекта().Маркировка_ФайлыАвторизацииГИС(Организация, Сертификат);
	
КонецФункции

// Сертификаты

&НаКлиенте
Процедура ПоказатьОшибкиСертификата(КонтекстОбмена, ВызывающаяФорма)
	
	Сертификат = КонтекстОбмена.Сертификат;
	Организация = КонтекстОбмена.Организация;
	
	Если Не ЗначениеЗаполнено(Сертификат) Тогда
		
		Действие = НСтр("ru = 'Проверка сертификата'");
		ШаблонОшибки = НСтр("ru = 'Не указана настройка подписания для ""%1""'");
		ТекстСообщения = ПараметрыВСтроку(ШаблонОшибки, Организация);
		ОбработатьОшибку(Действие, , Организация, ТекстСообщения, ВызывающаяФорма.УникальныйИдентификатор);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Организация", Организация);
		ОткрытьФормуНастройкиПодписания(ПараметрыФормы, ВызывающаяФорма);
		
		Возврат;
		
	КонецЕсли;
	
	НетДоступаВГИС = 
	КонтекстОбмена.ТребуетсяАвторизацияГИС
	И Не КонтекстОбмена.ВыполненаАвторизацияГИС;
	
	НетДоступаКПорталу = 
	КонтекстОбмена.ТребуетсяАвторизацияПортала
	И Не КонтекстОбмена.ВыполненаАвторизацияПортала;
	
	НеУдалосьПодписать = КонтекстОбмена.НеУдалосьПодписатьФайлы;
	НеУдалосьРасшифровать = КонтекстОбмена.НеУдалосьРасшифроватьКонтент;
	
	Если НетДоступаВГИС
		Или НетДоступаКПорталу
		Или НеУдалосьПодписать
		Или НеУдалосьРасшифровать Тогда
		
		ВидСертификата = ЗначениеРеквизитаОбъекта_Марк(Сертификат, "ВидСертификата");
		Если ВидСертификата = Перечисление_ВидыСертификатов().НаФизЛицо Тогда
			Пользователь = Пользователи_ТекущийПользователь();
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Сертификат", Сертификат);
		ПараметрыФормы.Вставить("Организация", Организация);
		ПараметрыФормы.Вставить("Пользователь", Пользователь);
		ПараметрыФормы.Вставить("КонтекстОбмена", КонтекстОбмена);
		ОткрытьФормуНастройкиПодписания(ПараметрыФормы, ВызывающаяФорма);
		
	КонецЕсли;
	
КонецПроцедуры

// Проверяет сертификат установленный на компьютер клиента
//
// Параметры:
//  КонтекстОбмена - Строка - см. Новый_КонтекстОбмена();
//
&НаКлиенте
Процедура ПроверитьДоступностьПодписиНаКлиенте(КонтекстОбмена)
	
	Если Не КонтекстОбмена.ПроверитьСертификатНаКлиенте Тогда
		Возврат;
	КонецЕсли;
	
	Сертификат = КонтекстОбмена.Сертификат;
	Организация = КонтекстОбмена.Организация;
	ОтпечатокСертификата = КонтекстОбмена.ОтпечатокСертификата;
	
	Если Не ЗначениеЗаполнено(Сертификат) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не МожноИспользоватьКриптографиюНаКлиенте() Тогда
		Возврат;
	КонецЕсли;
	
	КонтекстОбмена.ПроверитьСертификатНаКлиенте = Ложь;
	
	Попытка
		ДанныеСертификата = Плагин_НайтиСертификат(ОтпечатокСертификата);
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Проверка сертификата'");
		ДопИнформация = Новый СписокЗначений;
		ДопИнформация.Добавить(Организация, "Организация");
		ДопИнформация.Добавить(Сертификат, "Сертификат");
		ДопИнформация.Добавить(ОтпечатокСертификата, "Отпечаток сертификата");
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
		
		КонтекстОбмена.ТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		
		Возврат;
		
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(ДанныеСертификата) Тогда
		Возврат;
	КонецЕсли;
	
	КонтекстОбмена.СертификатУстановленНаКлиенте = Истина;
	
	Если ДанныеСертификата.ЕстьЗакрытыйКлюч Тогда
		КонтекстОбмена.ЕстьЗакрытыйКлюч = Истина;
	КонецЕсли;
	
	Если Не СрокДействияСертификатаИстек(ДанныеСертификата.ДатаОкончания) Тогда
		
		КонтекстОбмена.СертификатДействует = Истина;
		
		Если СрокДействияСертификатаЗаканчивается(ДанныеСертификата.ДатаОкончания) Тогда
			КонтекстОбмена.СрокДействияСертификатаИстекает = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если КонтекстОбмена.СертификатУстановленНаКлиенте
		И КонтекстОбмена.СертификатДействует
		И КонтекстОбмена.ЕстьЗакрытыйКлюч Тогда
		КонтекстОбмена.ДоступнаПодписьНаКлиенте = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлыОчередиОбменаНаКлиенте(КонтекстОбмена)
	
	Если КонтекстОбмена.ДоступнаПодписьНаСервере Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьДоступностьПодписиНаКлиенте(КонтекстОбмена);
	Если Не КонтекстОбмена.ДоступнаПодписьНаКлиенте Тогда
		Возврат;
	КонецЕсли;
	
	ПодписатьФайлы = Истина;
	Пока ПодписатьФайлы Цикл
		Если ОчередьОбмена_ПрочитатьНовуюПорциюФайловДляПодписи(КонтекстОбмена)
			И ОчередьОбмена_ПодписатьФайлы(КонтекстОбмена) Тогда
			ОчередьОбмена_ЗаписатьФайлыПодписейУстановитьНовоеДействие(КонтекстОбмена);
		Иначе
			ПодписатьФайлы = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредупредитьЧтоСрокДействияСертификатаИстекает(КонтекстОбмена)
	
	Если КонтекстОбмена.СрокДействияСертификатаИстекает Тогда
		Оповестить("КонтурМаркировка_ИстекаетСрокДействияСертификата");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СрокДействияСертификатаИстек(ДатаОкончания)
	
	Результат = ДатаОкончания < НачалоДня(ТекущаяДата());
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СрокДействияСертификатаЗаканчивается(ДатаОкончания)
	
	ДатаПредупреждения = ДатаОкончания - СрокПредупрежденияОбОкончанииСертификата();
	
	Результат = ДатаПредупреждения < ТекущаяДата();
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СрокПредупрежденияОбОкончанииСертификата()
	
	КлючКэш = "СрокПредупрежденияОбОкончанииСертификата";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = СрокПредупрежденияОбОкончанииСертификатаНаСервере();
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СрокПредупрежденияОбОкончанииСертификатаНаСервере()
	
	Возврат МодульОбъекта().СрокПредупрежденияОбОкончанииСертификата();
	
КонецФункции

// #Область ОбновлениеМодуля

&НаКлиенте
Функция КонтекстОбновления() Экспорт
	
	Возврат КонтекстОбновленияНаСервере();
	
КонецФункции

&НаСервере
Функция КонтекстОбновленияНаСервере()
	
	Возврат МодульОбъекта().КонтекстОбновления();
	
КонецФункции

&НаКлиенте
Процедура ПроверитьДоступностьФайлаМодуляНаКлиенте(КонтекстОбновления) Экспорт
	
	Информация = КонтекстОбновления.ИнформацияОФайлеНаДиске;
	
	Если Не ЗначениеЗаполнено(Информация.ПутьКФайлу) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не КонтекстОбновления.ЕстьОбновлениеМодуля Тогда
		Возврат;
	КонецЕсли;
	
	Файл = НовыйФайл(Информация.ПутьКФайлу);
	
	ДоступенНаКлиенте = Ложь;
	
	Если Файл.Существует() Тогда
		
		Каталог	 = Файл.Путь;
		ИмяФайла = Файл.Имя;
		
		ИмяТестовогоФайла   = "KonturMARK_WriteTest.txt";
		ПутьКТестовомуФайлу = ОбъединитьПути(Каталог, ИмяТестовогоФайла);
		
		Попытка
			// BSLLS:FileSystemAccess-off
			Запись = Новый ЗаписьТекста(ПутьКТестовомуФайлу);
			// BSLLS:FileSystemAccess-on
			Запись.Записать("Тест записи файла перед обновлением " + ИмяФайла);
			Запись.Закрыть();
			ДоступенНаКлиенте = Истина;
		Исключение
			Ошибка = ИнформацияОбОшибке();
		КонецПопытки;
		
		Попытка
			// BSLLS:FileSystemAccess-off
			УдалитьФайлы(ПутьКТестовомуФайлу);
			// BSLLS:FileSystemAccess-on
		Исключение
			Ошибка = ИнформацияОбОшибке();
			ДоступенНаКлиенте = Ложь;
		КонецПопытки;
		
	КонецЕсли;
	
	Информация.ДоступенНаКлиенте = ДоступенНаКлиенте;
	
	Если Не Информация.ДоступенНаСервере
		И Не Информация.ДоступенНаКлиенте Тогда
		КонтекстОбновления.НевозможноВыполнитьОбновление = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Скачивает новую версию модуля и записывает его на диск или в справочник
//
// Параметры:
//  КонтекстОбновления - Структура - см. функцию Новый_КонтекстОбновленияМодуля();
//
&НаКлиенте
Процедура ВыполнитьОбновлениеМодуля(КонтекстОбновления) Экспорт
	
	РасположениеМодуля = КонтекстОбновления.РасположениеМодуля;
	ВариантыРасположения = Перечисление_ВариантыРасположенияОбработки();
	
	// Фиксируем старую версию модуля заранее,
	// чтобы избежать ошибки записи в расширении после обновления подсистемы
	СтараяВерсияМодуля_Записать(КонтекстОбновления.ТекущаяВерсияМодуля);
	
	Если РасположениеМодуля = ВариантыРасположения.НаДиске Тогда
		
		ОбновитьМодульНаДиске(КонтекстОбновления);
		
	ИначеЕсли РасположениеМодуля = ВариантыРасположения.ВСправочнике Тогда
		
		ОбновитьМодульВСправочнике(КонтекстОбновления);
		
	ИначеЕсли РасположениеМодуля = ВариантыРасположения.ВРасширении Тогда
		
		ОбновитьРасширениеКонфигурации(КонтекстОбновления);
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Не удалось обновить модуль!
		|Некорректное расположение модуля: %1'"), РасположениеМодуля);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	КонтекстОбновления.ОбновлениеВыполнено = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьМодульНаДиске(КонтекстОбновления)
	
	ИнформацияОФайле = КонтекстОбновления.ИнформацияОФайлеНаДиске;
	
	Если ИнформацияОФайле.ДоступенНаКлиенте Тогда
		
		ОбновитьМодульНаДискеНаКлиенте(КонтекстОбновления);
		
	ИначеЕсли ИнформацияОФайле.ДоступенНаСервере Тогда
		
		ОбновитьМодульНаДискеНаСервере(КонтекстОбновления);
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Не удалось обновить модуль!
		|Нет доступа к файлу: %1'"), ИнформацияОФайле.ПутьКФайлу);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьМодульНаДискеНаКлиенте(КонтекстОбновления)
	
	СсылкаНаФайл = КонтекстОбновления.АдресОбновления;
	ПутьКФайлу = КонтекстОбновления.ИнформацияОФайлеНаДиске.ПутьКФайлу;
	
	ФайлНовойВерсии = СкачатьФайлИзИнтернета(СсылкаНаФайл);
	
	ФайлНовойВерсии.Записать(ПутьКФайлу);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьМодульНаДискеНаСервере(КонтекстОбновления)
	
	МодульОбъекта().ОбновитьМодульНаДискеНаСервере(КонтекстОбновления);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьМодульВСправочнике(КонтекстОбновления)
	
	МодульОбъекта().ОбновитьМодульВСправочнике(КонтекстОбновления);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьРасширениеКонфигурации(КонтекстОбновления)
	
	МодульОбъекта().ОбновитьРасширениеКонфигурации(КонтекстОбновления);
	
КонецПроцедуры

// Подключает новую версию модуля в метаданные сеанса
//
// Параметры:
//  КонтекстОбновления - Структура - см. функцию Новый_КонтекстОбновленияМодуля();
//
&НаКлиенте
Процедура ПодключитьНовуюВерсиюМодуля(КонтекстОбновления) Экспорт
	
	РасположениеМодуля	 = КонтекстОбновления.РасположениеМодуля;
	ВариантыРасположения = Перечисление_ВариантыРасположенияОбработки();
	
	Если РасположениеМодуля = ВариантыРасположения.НаДиске Тогда
		
		ИнформацияОФайле = КонтекстОбновления.ИнформацияОФайлеНаДиске;
		ПодключитьОбработкуМодуляИзФайла(ИнформацияОФайле.ПутьКФайлу);
		
	ИначеЕсли РасположениеМодуля = ВариантыРасположения.ВСправочнике Тогда
		
		ИнформацияОбОбработке = КонтекстОбновления.ИнформацияОДополнительнойОбработке;
		ПодключитьОбработкуМодуляИзСправочника(ИнформацияОбОбработке.Ссылка);
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Не удалось подключить внешнюю обработку модуля!
		|Некорректное расположение модуля: %1'"), РасположениеМодуля);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПодключитьОбработкуМодуляИзФайла(ПутьКФайлу)
	
	МодульОбъекта().МодульОбщегоНазначения().СоздатьВнешнююОбработкуБезПредупреждений(ПутьКФайлу);
	
КонецПроцедуры 

&НаСервере
Процедура ПодключитьОбработкуМодуляИзСправочника(ВнешняяОбработка)
	
	ДвоичныеДанные = МодульОбъекта().ДвоичныеДанныеИзСправочникаВнешнихОбработок(ВнешняяОбработка);
	АдресОбработки = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	
	МодульОбъекта().МодульОбщегоНазначения().ПодключитьВнешнююОбработкуБезПредупреждений(АдресОбработки);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗафиксироватьОтказОтОбновленияПриОткрытииМодуля(КонтекстОбновления) Экспорт
	
	Если Не КонтекстОбновления.ВыполняетсяОткрытиеМодуля Тогда
		Возврат;
	КонецЕсли;
	
	ЗафиксироватьКоличествоУведомленйОНовойВерсии(КонтекстОбновления.НоваяВерсияМодуля);
	Метрики_ОтсрочкаОбновленияМодуля(КонтекстОбновления);
	
КонецПроцедуры

&НаСервере
Процедура ЗафиксироватьКоличествоУведомленйОНовойВерсии(НоваяВерсияМодуля)
	
	МодульОбъекта().ЗафиксироватьКоличествоУведомленйОНовойВерсии(НоваяВерсияМодуля);
	
КонецПроцедуры

