&НаКлиенте
Функция НужноОтправитьМетрики(СтекМетрик)
	
	Если ЗначениеЗаполнено(СтекМетрик.ДатаПервогоСобытия) Тогда
		ПрошлоСекунд = ТекущаяДата() - СтекМетрик.ДатаПервогоСобытия;
	Иначе
		ПрошлоСекунд = 0;
	КонецЕсли;
	
	Если СтекМетрик.РазмерСтека >= СтекМетрик_МаксимальныйРазмер()
		Или ПрошлоСекунд >= ПериодОтправкиМетрик() Тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПериодОтправкиМетрик()
	
	КлючКэш = "ПериодОтправкиМетрик";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ПериодОтправкиМетрикНаСервере();
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПериодОтправкиМетрикНаСервере()
	
	Возврат МодульОбъекта().ПериодОтправкиМетрик();
	
КонецФункции

