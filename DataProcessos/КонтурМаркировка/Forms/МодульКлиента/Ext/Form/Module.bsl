Функция ОписаниеКонтекстаОбновленияДляМетрики(КонтекстОбновления)
	
	Результат = Новый Структура;
	Результат.Вставить("НоваяВерсияМодуля", КонтекстОбновления.НоваяВерсияМодуля);
	Результат.Вставить("НоваяВерсияДанных", КонтекстОбновления.НоваяВерсияДанных);
	Результат.Вставить("ТекущаяВерсияМодуля", КонтекстОбновления.ТекущаяВерсияМодуля);
	Результат.Вставить("ТекущаяВерсияДанных", КонтекстОбновления.ТекущаяВерсияДанных);
	Результат.Вставить("ЕстьДоработкиМодуля", КонтекстОбновления.ЕстьДоработкиМодуля);
	Результат.Вставить("ЕстьОбновлениеПодсистемы", КонтекстОбновления.ЕстьОбновлениеПодсистемы);
	Результат.Вставить("ТребуетсяОбновлениеДанных", КонтекстОбновления.ТребуетсяОбновлениеДанных);
	Результат.Вставить("ОбновлениеПриОткрытии", КонтекстОбновления.ВыполняетсяОткрытиеМодуля);
	Результат.Вставить("НевозможноВыполнитьОбновление", КонтекстОбновления.НевозможноВыполнитьОбновление);
	Результат.Вставить("ПолученаОшибкаСервисаОбновлений", КонтекстОбновления.ПолученаОшибкаСервисаОбновлений);
	
	Если ТипЗнч(КонтекстОбновления.ОписаниеОшибки) = Тип("ИнформацияОбОшибке") Тогда
		ОписаниеОшибки = ПодробноеПредставлениеОшибки(КонтекстОбновления.ОписаниеОшибки);
	Иначе
		ОписаниеОшибки = КонтекстОбновления.ОписаниеОшибки;
	КонецЕсли;
	Результат.Вставить("ОписаниеОшибки", ОписаниеОшибки);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ОписаниеОС()
	
	СисИнфо = ИнформацияОСистеме();
	ТипОС = НРег(СисИнфо.ТипПлатформы);
	
	Если Найти(ТипОС, НРег("Linux")) > 0 Тогда
		Name = "Linux";
	ИначеЕсли Найти(ТипОС, НРег("MacOS")) > 0 Тогда
		Name = "MacOS";
	ИначеЕсли Найти(ТипОС, НРег("Windows")) > 0 Тогда
		Name = "Windows";
	КонецЕсли;
	
	Если Найти(ТипОС, "64") > 0 Тогда
		BitSet = "x64";
	Иначе
		BitSet = "x86";
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Name", Name);
	Результат.Вставить("BitSet", BitSet);
	
	// Заполним при отправке на сервере
	Результат.Вставить("Version");
	
	Возврат Результат;
	
КонецФункции

