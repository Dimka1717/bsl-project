// Заменяет различные варианты разделителя группы GS к символу ASCII 29
//
// Параметры:
//  Строка - Строка - строка с различными вариантами разделителя GS
// 
// Возвращаемое значение:
//  Строка - строка с разделителем GS (ASCII 29)
//
&НаКлиенте
Функция ВосстановитьРазделительGS1(Знач Строка)
	
	Пробел = " ";
	Эквивалент = ЭквивалентРазделителяGS1();
	ЭквивалентВРег = ВРег(Эквивалент);
	РазделительGS1 = РазделительGS1();
	
	Строка = СтрЗаменить(Строка, Пробел, РазделительGS1);
	Строка = СтрЗаменить(Строка, Эквивалент, РазделительGS1);
	Строка = СтрЗаменить(Строка, ЭквивалентВРег, РазделительGS1);
	
	Возврат Строка;
	
КонецФункции

&НаКлиенте
Функция ЗаменитьРазделительGS1(Строка) Экспорт
	
	Результат = СтрЗаменить(Строка, РазделительGS1(), ЭквивалентРазделителяGS1());
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция РазделительGS1() Экспорт
	
	Возврат Символ(29);
	
КонецФункции

&НаКлиенте
Функция ЭквивалентРазделителяGS1() Экспорт
	
