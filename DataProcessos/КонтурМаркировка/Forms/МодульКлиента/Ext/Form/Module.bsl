		Выполнить("ПоказатьПредупреждение(ОповещениеОЗакрытии, ТекстСообщения, , ЗаголовокДиалога)");
	Иначе
		Предупреждение(ТекстСообщения, , ЗаголовокДиалога);
		ВызватьОбработчикОповещения(ОписаниеОбработчика);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиПредупреждениеСКнопкойПодробно(ТекстСообщения, ТекстПодробно, Форма = Неопределено, ЗаголовокДиалога = "") Экспорт
	
	Если Не ЗначениеЗаполнено(ЗаголовокДиалога) Тогда
		ЗаголовокДиалога = НаименованиеМодуля();
	КонецЕсли;
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить("ОК");
	Кнопки.Добавить("Подробно...");
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Форма", Форма);
	ДопПараметры.Вставить("ТекстПодробно", ТекстПодробно);
	
	ОписаниеОбработчика = ОписаниеОбработчикаОповещения(
	"ВывестиПредупреждениеСКнопкойПодробно_ПослеПредупреждения", ЭтаФорма, ДопПараметры);
	
	ПоказатьДиалогВопроса(ОписаниеОбработчика, ТекстСообщения, Кнопки, ЗаголовокДиалога);
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиПредупреждениеСКнопкойПодробно_ПослеПредупреждения(Ответ, ДопПараметры) Экспорт
	
	Если Ответ <> "Подробно..." Тогда
		Возврат;
	КонецЕсли;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ДопПараметры.ТекстПодробно;
	
	Если ДопПараметры.Форма <> Неопределено Тогда
		Сообщение.ИдентификаторНазначения = ДопПараметры.Форма.УникальныйИдентификатор;
	КонецЕсли;
	
	Сообщение.Сообщить();
	
КонецПроцедуры

