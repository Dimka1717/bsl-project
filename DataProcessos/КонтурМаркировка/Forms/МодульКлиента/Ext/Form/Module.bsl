//  Структура:
//   Отпечаток             - Строка - (необязательный) отпечаток сертификата;
//   СерийныйНомер         - Строка - (необязательный) серийный номер сертификата;
//   ЕстьЗакрытыйКлюч      - Булево - (необязательный) проверять наличие закрытого ключа;
//   ТолькоПервый          - Булево - (необязательный) возвращать первый найденный сертификат;
//   РасположениеХранилища - Строка - (необязательный) см. Перечисление_РасположениеХранилищСертификатов();
//   ТипХранилища          - Строка - (необязательный) см. Перечисление_ТипыХранилищСертификатов();
//
&НаКлиенте
Функция Плагин_ПараметрыПоискаСертификатов()

	Попытка
		Результат = Модуль_Плагин().ПараметрыПоискаСертификатов();
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Метод = "ПараметрыПоискаСертификатов";
		МодульОбъекта().Плагин_ОбработатьОшибку(Метод, Ошибка);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Находит сертификат установленный на компьютере
//
// Параметры:
//  ОтпечатокСертификата - Строка - отпечаток сертификата;
// 
// Возвращаемое значение:
//  Структура - см. Модуль_Плагин().Новый_ОписаниеСертификата()
//
&НаКлиенте
Функция Плагин_НайтиСертификат(ОтпечатокСертификата)
	
	ПараметрыПоиска = Плагин_ПараметрыПоискаСертификатов();
	ПараметрыПоиска.Отпечаток = ОтпечатокСертификата;
	ПараметрыПоиска.ТолькоПервый = Истина;
	
	Попытка
		МассивСертификатов = Модуль_Плагин().СписокСертификатов(ПараметрыПоиска);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Метод = "СписокСертификатов";
		МодульОбъекта().Плагин_ОбработатьОшибку(Метод, Ошибка);
	КонецПопытки;
	
	Результат = Неопределено;
	Если ЗначениеЗаполнено(МассивСертификатов) Тогда
		Результат = МассивСертификатов[0];
		Если ОбъектСодержитНедопустимыеСимволыXML(Результат) Тогда
			Результат = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Этикетки

// Заполняет этикетки картинками штрихкодов на клиенте
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - табличный документ с этикетками;
//  ПараметрыЗаполнения - Структура - см. Этикетки_ПараметрыЗаполненияКартинокШтрихкодовНаКлиенте();
//
&НаКлиенте
Процедура Этикетки_ЗаполнитьКартинкиШтрихкодов(ТабличныйДокумент, ПараметрыЗаполнения) Экспорт
	
	Если Не ЗначениеЗаполнено(ПараметрыЗаполнения)
		Или ТабличныйДокумент.ВысотаТаблицы = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Этикетки_СформироватьКартинкиШтрихкодовПоШаблонам(ПараметрыЗаполнения);
	Этикетки_ЗаполнитьКартинкиШтрихкодовВТабличномДокументе(ТабличныйДокумент, ПараметрыЗаполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура Этикетки_СформироватьКартинкиШтрихкодовПоШаблонам(ПараметрыЗаполнения)
	
	ШтрихкодыПоШаблонам = МассивСтруктур_Разбить(ПараметрыЗаполнения.ОписанияЭтикеток, "ШаблонЭтикетки");
	
	Для каждого Элемент Из ШтрихкодыПоШаблонам Цикл
		
		ШаблонЭтикетки = Элемент.Ключ;
		Если Не ЗначениеЗаполнено(ШаблонЭтикетки) Тогда
			Продолжить;
		КонецЕсли;
		
		МассивШтрихкодов = Элемент.Значение;
		НастройкиШаблона = ПараметрыЗаполнения.НастройкиШаблонов[ШаблонЭтикетки];
		
		Этикетки_СформироватьКартинкиGTIN(МассивШтрихкодов, ШаблонЭтикетки, НастройкиШаблона);
		Этикетки_СформироватьКартинкиАгрегатов(МассивШтрихкодов, ШаблонЭтикетки, НастройкиШаблона);
		Этикетки_СформироватьКартинкиDataMatrix(МассивШтрихкодов, ШаблонЭтикетки, НастройкиШаблона);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Этикетки_СформироватьКартинкиGTIN(ОписанияЭтикеток, ШаблонЭтикетки, НастройкиШаблона)
	
	ТипШтрихкода = ПредопределенноеЗначение("Перечисление.КонтурМаркировка_ТипыШтрихкодов.EAN13");
	
	РазмерыКартинки = НастройкиШаблона.РазмерыКартинок.GTIN;
	ПараметрыШтрихкода = НастройкиШаблона.ПараметрыШтрихкодов.GTIN;
	
	Если РазмерыКартинки.Ширина = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ШаблонЭтикетки", ШаблонЭтикетки);
	СтрокиЭтикеток = МассивСтруктур_НайтиСтроки(ОписанияЭтикеток, Отбор);
	
	Если Не ЗначениеЗаполнено(СтрокиЭтикеток) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыКартинки = Плагин_ПараметрыКартинкиШтрихкода(ТипШтрихкода);
	ЗаполнитьПоляСтруктуры(ПараметрыКартинки, ПараметрыШтрихкода);
	ЗаполнитьПоляСтруктуры(ПараметрыКартинки, РазмерыКартинки);
	
	МассивШтрихкодов = Новый Массив;
	Для Каждого Стр Из СтрокиЭтикеток Цикл
		Если ЗначениеЗаполнено(Стр.GTIN_Штрихкод)
			И МассивШтрихкодов.Найти(Стр.GTIN_Штрихкод) = Неопределено Тогда
			МассивШтрихкодов.Добавить(Стр.GTIN_Штрихкод);
		КонецЕсли;
	КонецЦикла;
	
	КартинкиШтрихкодов = Плагин_КартинкиШтрихкодов(МассивШтрихкодов, ПараметрыКартинки);
	
	Для Каждого Стр Из СтрокиЭтикеток Цикл
		ИндексКартинки = МассивШтрихкодов.Найти(Стр.GTIN_Штрихкод);
		Стр.GTIN_Картинка = КартинкиШтрихкодов[ИндексКартинки];
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Этикетки_СформироватьКартинкиАгрегатов(ОписанияЭтикеток, ШаблонЭтикетки, НастройкиШаблона)
	
	НужныеТипыШтрихкодов = Новый Массив;
	НужныеТипыШтрихкодов.Добавить(ПредопределенноеЗначение("Перечисление.КонтурМаркировка_ТипыШтрихкодов.SSCC"));
	НужныеТипыШтрихкодов.Добавить(ПредопределенноеЗначение("Перечисление.КонтурМаркировка_ТипыШтрихкодов.GS1_128"));
	НужныеТипыШтрихкодов.Добавить(ПредопределенноеЗначение("Перечисление.КонтурМаркировка_ТипыШтрихкодов.Code128"));
	
	Для каждого ТипШтрихкода Из НужныеТипыШтрихкодов Цикл
		
		РазмерыКартинки = НастройкиШаблона.РазмерыКартинок.Агрегат;
		ПараметрыШтрихкода = НастройкиШаблона.ПараметрыШтрихкодов.Агрегат;
		
		Если РазмерыКартинки.Ширина = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый Структура;
		Отбор.Вставить("ТипШтрихкода", ТипШтрихкода);
		Отбор.Вставить("ШаблонЭтикетки", ШаблонЭтикетки);
		СтрокиЭтикеток = МассивСтруктур_НайтиСтроки(ОписанияЭтикеток, Отбор);
		
		Если Не ЗначениеЗаполнено(СтрокиЭтикеток) Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыКартинки = Плагин_ПараметрыКартинкиШтрихкода(ТипШтрихкода);
		ЗаполнитьПоляСтруктуры(ПараметрыКартинки, ПараметрыШтрихкода);
		ЗаполнитьПоляСтруктуры(ПараметрыКартинки, РазмерыКартинки);
		ПараметрыКартинки.ПодогнатьРазмер = Истина;
		
		МассивШтрихкодов = Новый Массив;
		Для Каждого Стр Из СтрокиЭтикеток Цикл
			МассивШтрихкодов.Добавить(ВосстановитьРазделительGS1(Стр.Агрегат_Штрихкод));
		КонецЦикла;
		
		КартинкиШтрихкодов = Плагин_КартинкиШтрихкодов(МассивШтрихкодов, ПараметрыКартинки);
		
		Для Индекс = 0 По СтрокиЭтикеток.ВГраница() Цикл
			СтрокиЭтикеток[Индекс].Агрегат_Картинка = КартинкиШтрихкодов[Индекс];
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Этикетки_СформироватьКартинкиDataMatrix(ОписанияЭтикеток, ШаблонЭтикетки, НастройкиШаблона)
	
	ТипШтрихкода = ПредопределенноеЗначение("Перечисление.КонтурМаркировка_ТипыШтрихкодов.GS1_DataMatrix");
	
	РазмерыКартинки = НастройкиШаблона.РазмерыКартинок.DataMatrix;
	ПараметрыШтрихкода = НастройкиШаблона.ПараметрыШтрихкодов.DataMatrix;
	
	Если РазмерыКартинки.Ширина = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ТипШтрихкода", ТипШтрихкода);
	Отбор.Вставить("ШаблонЭтикетки", ШаблонЭтикетки);
	СтрокиЭтикеток = МассивСтруктур_НайтиСтроки(ОписанияЭтикеток, Отбор);
	
	Если Не ЗначениеЗаполнено(СтрокиЭтикеток) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыКартинки = Плагин_ПараметрыКартинкиШтрихкода(ТипШтрихкода);
	ЗаполнитьПоляСтруктуры(ПараметрыКартинки, ПараметрыШтрихкода);
	ЗаполнитьПоляСтруктуры(ПараметрыКартинки, РазмерыКартинки);
	ПараметрыКартинки.ПодогнатьРазмер = Истина;
	
	МассивШтрихкодов = Новый Массив;
	Для Каждого Стр Из СтрокиЭтикеток Цикл
		МассивШтрихкодов.Добавить(ВосстановитьРазделительGS1(Стр.DataMatrix_Штрихкод));
	КонецЦикла;
	
	КартинкиШтрихкодов = Плагин_КартинкиШтрихкодов(МассивШтрихкодов, ПараметрыКартинки);
	
	Для Индекс = 0 По СтрокиЭтикеток.ВГраница() Цикл
		СтрокиЭтикеток[Индекс].DataMatrix_Картинка = КартинкиШтрихкодов[Индекс];
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Этикетки_ЗаполнитьКартинкиШтрихкодовВТабличномДокументе(ТабличныйДокумент, ПараметрыЗаполнения)
	
	ИменаКартинок = Перечисление_ИменаКартинокШтрихкодов();
	ОписанияЭтикеток = ПараметрыЗаполнения.ОписанияЭтикеток;
	
	ЭтикеткиПоНомерам = Новый Соответствие;
	Для Каждого ОписаниеЭтикетки Из ОписанияЭтикеток Цикл
		ЭтикеткиПоНомерам.Вставить(ОписаниеЭтикетки.НомерЭтикетки, ОписаниеЭтикетки);
	КонецЦикла;
	
	ПрефиксНомера = "_Этикетка";
	ДлинаПрефикса = СтрДлина(ПрефиксНомера);
	
	Для Каждого Рисунок Из ТабличныйДокумент.Рисунки Цикл
		Для каждого Элемент Из ИменаКартинок Цикл
			ИмяКартинки = Элемент.Значение;
			Если Найти(Рисунок.Имя, ИмяКартинки) = 1 Тогда
				НачалоНомера = Найти(Рисунок.Имя, ПрефиксНомера);
				НомерЭтикетки = Число(Сред(Рисунок.Имя, НачалоНомера + ДлинаПрефикса));
				Рисунок.Картинка = Новый Картинка(ЭтикеткиПоНомерам[НомерЭтикетки][ИмяКартинки]);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция Новый_ПараметрыСортировкиЭтикеток() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("ПолеСортировкиЭтикеток1");
	Результат.Вставить("ПолеСортировкиЭтикеток2");
	Результат.Вставить("ПолеСортировкиЭтикеток3");
	Результат.Вставить("НаправлениеСортировкиЭтикеток1");
	Результат.Вставить("НаправлениеСортировкиЭтикеток2");
	Результат.Вставить("НаправлениеСортировкиЭтикеток3");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция КоличествоПараметровСортировкиЭтикеток() Экспорт
	
	КлючКэш = "КоличествоПараметровСортировкиЭтикеток";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = КоличествоПараметровСортировкиЭтикетокНаСервере();
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция КоличествоПараметровСортировкиЭтикетокНаСервере()
	
	Возврат МодульОбъекта().КоличествоПараметровСортировкиЭтикеток();
	
КонецФункции

// Организации, склады, сервис-провайдеры

&НаКлиенте
Функция ВсеОрганизацииСАвторизацией(ВызывающаяФорма)
	
	Результат = Новый Массив;
	
	Для каждого КонтекстОбмена Из ВсеКонтекстыДляОбмена(ВызывающаяФорма) Цикл
		Результат.Добавить(КонтекстОбмена.Организация);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Организация_ПерваяСАвторизацией()
	
	Для каждого КонтекстОбмена Из ВсеКонтекстыОбменаНаСервере() Цикл
		
		Если Авторизация_Выполнить(КонтекстОбмена) Тогда
			Возврат КонтекстОбмена.Организация;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Функция Организация_ИдентификаторИзСервиса(Организация, ВызывающаяФорма) Экспорт
	
	Если Не ВыполнитьАвторизацию(Организация, ВызывающаяФорма, Ложь) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Организация_ИдентификаторИзСервисаНаСервере(Организация);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция Организация_ИдентификаторИзСервисаНаСервере(Организация) Экспорт
	
	Возврат МодульОбъекта().Организация_ИдентификаторИзСервиса(Организация);
	
КонецФункции

&НаКлиенте
Функция Организация_ИдентификаторGS1ИзСервиса(Организация, ВызывающаяФорма) Экспорт
	
	Если Не ВыполнитьАвторизацию(Организация, ВызывающаяФорма, Истина) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Организация_ИдентификаторGS1ИзСервисаНаСервере(Организация);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция Организация_ИдентификаторGS1ИзСервисаНаСервере(ОрганизацияСсылка) Экспорт
	
	Возврат МодульОбъекта().Организация_ИдентификаторGS1ИзСервиса(ОрганизацияСсылка);
	
КонецФункции

&НаСервере
Процедура Склады_Сохранить(ОргID,МассивСкладов)
	
	Для Каждого Склад Из МассивСкладов Цикл
		
		НайденныйСклад = Справочники.КонтурМаркировка_Склады.НайтиПоРеквизиту("Идентификатор",Склад.ID);
		
		Если ЗначениеЗаполнено(НайденныйСклад) Тогда
			СкладОбъект = НайденныйСклад.ПолучитьОбъект();
		Иначе
			СкладОбъект = Справочники.КонтурМаркировка_Склады.СоздатьЭлемент();
			
		КонецЕсли;
		СкладОбъект.Организация = Справочники.КонтурМаркировка_Организации.НайтиПоРеквизиту("Идентификатор", ОргID);
		СкладОбъект.Наименование = Склад.name;
		СкладОбъект.Адрес = Склад.address;
		СкладОбъект.GLN = Склад.gln;
		СкладОбъект.Идентификатор = Склад.ID;
		СкладОбъект.Записать();
		
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьСклады(ВызывающаяФорма) Экспорт
	
	Для Каждого Организация Из ВсеОрганизацииСАвторизацией(ВызывающаяФорма) Цикл
		СинхронизироватьСкладыНаСервере(Организация);
	КонецЦикла;
	
