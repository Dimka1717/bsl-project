	Если ДоступныАсинхронныеФормы() Тогда
		Выполнить("ПоказатьЗначение( , СсылкаНаОбъект)");
	Иначе
		ОткрытьЗначение(СсылкаНаОбъект);
	КонецЕсли;
	
КонецПроцедуры

// Открывает форму списка выбора объекта 1С
//
// Параметры:
//  ОписаниеОбъектаДляВыбора - Структура - см. Новый_ОписаниеВидаДокументаДляВыбора();
//  Владелец - ФормаКлиентскогоПриложения - владелец формы выбора;
//  ОписаниеОбработчика - Структура - см ОписаниеОбработчикаОповещения();
//
&НаКлиенте
Процедура ОткрытьФормуВыбораОбъектаИС(ОписаниеОбъектаДляВыбора, Владелец, ОписаниеОбработчика) Экспорт
	
	ПолноеИмя = ОписаниеОбъектаДляВыбора.ПолноеИмяОбъекта;
	ИмяФормыВыбора = ОписаниеОбъектаДляВыбора.ИмяФормыВыбора;
	ПараметрыФормы = ОписаниеОбъектаДляВыбора.ПараметрыФормы;
	
	Если ЗначениеЗаполнено(ИмяФормыВыбора) Тогда
		ПутьКФормеВыбора = ПолноеИмя + ".Форма." + ИмяФормыВыбора;
	Иначе
		ПутьКФормеВыбора = ПолноеИмя + ".ФормаВыбора";
	КонецЕсли;
	
	Если ПараметрыФормы = Неопределено Тогда
		ПараметрыФормы = Новый Структура;
	КонецЕсли;
	
	Если ЭтоФорма(Владелец)
		И Владелец.Открыта() Тогда
		ПараметрыФормы.Вставить("ЗакрыватьПриЗакрытииВладельца", Истина);
	КонецЕсли;
	
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	
	Если ДоступныАсинхронныеФормы() И ЭтоУправляемаяФормаВыбора(ПутьКФормеВыбора) Тогда
		ОповещениеОЗакрытии = НовоеОписаниеОповещения(ОписаниеОбработчика);
		РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		Выполнить("ОткрытьФорму(ПутьКФормеВыбора, ПараметрыФормы, Владелец, , , , ОповещениеОЗакрытии, РежимОткрытияОкна)");
	Иначе
		Результат = ОткрытьФормуМодально(ПутьКФормеВыбора, ПараметрыФормы, Владелец);
		ВызватьОбработчикОповещения(ОписаниеОбработчика, Результат);
	КонецЕсли;
	
КонецПроцедуры


