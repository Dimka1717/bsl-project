	Если Не ЗначениеЗаполнено(КлючКодаИлиКодМаркировки) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(КлючКодаИлиКодМаркировки) = Тип("УникальныйИдентификатор") Тогда
		КлючКода = КлючКодаИлиКодМаркировки;
	Иначе
		КлючКода = КодМаркировки_НайтиКлюч(КлючКодаИлиКодМаркировки);
		Если Не ЗначениеЗаполнено(КлючКода) Тогда
			ТекстОшибки = НСтр("ru = 'Код маркировки не найден в базе: %1'");
			ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, КлючКодаИлиКодМаркировки);
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КлючКода", КлючКода);
	ПараметрыФормы.Вставить("Организация", Организация);
	ОткрытьФормуОбработки("Форма_КодМаркировки", Владелец, ПараметрыФормы);
	
