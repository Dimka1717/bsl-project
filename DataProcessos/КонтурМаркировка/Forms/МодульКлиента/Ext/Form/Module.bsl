Процедура Метрика_Операции_ПереходВСервис(ТипОперации)
	
	ДопСведения = Новый Структура;
	ДопСведения.Вставить("ТипОперации", ТипОперации);
	
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Категория = Перечисление_КатегорииМетрики().Операции;
	Действие = Перечисление_ДействияМетрики().ПереходВСервис;
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения);
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

&НаКлиенте
Процедура Метрики_ПечатьЭтикетокСЗаполненнымиПараметрами(ПараметрыПечатиДляМетрики, Организация) Экспорт
	
	Если Не ПараметрыПечатиДляМетрики.ЗаполненТовар
		И Не ПараметрыПечатиДляМетрики.ЗаполненаНоменклатура1С
		И Не ЗначениеЗаполнено(ПараметрыПечатиДляМетрики.КоличествоКодовТребуется) Тогда
		Возврат;
	КонецЕсли;
	
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Категория = Перечисление_КатегорииМетрики().ПараметрыПечати;
	Действие = Перечисление_ДействияМетрики().ПечатьЭтикетокСЗаполненнымиПараметрами;
	Идентификатор = ЗначениеРеквизитаОбъекта_Марк(Организация, "Идентификатор");
	
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ПараметрыПечатиДляМетрики, Идентификатор);
	ОписаниеМетрики.Организация = Организация;
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

