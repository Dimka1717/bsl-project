// Документы в сервисе

&НаКлиенте
Процедура ОткрытьОперациюВСервисе(ТипОперации, ИдентификаторДокумента) Экспорт
	
	Если Не ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКДокументу = ПутьКДокументуВСервисе(ТипОперации);
	Если Не ЗначениеЗаполнено(ПутьКДокументу) Тогда
		Возврат; // На сайте нет такой операции или переход пока не поддерживается
	КонецЕсли;
	
	АдресСайта = АдресСайтаКонтурМаркировки();
	АдресСтраницы = АдресСайта + ПутьКДокументу + ИдентификаторДокумента;
	
	ОткрытьИнтернетСтраницу(АдресСтраницы);
	
	Метрика_Операции_ПереходВСервис(ТипОперации);
	
КонецПроцедуры

&НаКлиенте
Функция ПутьКДокументуВСервисе(ТипОперации)
	
	КлючКэш = "ПутьКДокументуВСервисе: " + ТипОперации;
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ПутьКДокументуВСервисеНаСервере(ТипОперации);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПутьКДокументуВСервисеНаСервере(ТипОперации)
	
	Возврат МодульОбъекта().ПутьКДокументуВСервисе(ТипОперации);
	
