// Возвращает структуру параметров диалога выбора файла
// 
// Возвращаемое значение:
//  Структура - параметры диалога выбора файла:
//   * Заголовок - Строка - Содержит текст заголовка окна диалога выбора файла (файлов);
//   * Каталог - Строка - Содержит значение текущего каталога;
//   * МножественныйВыбор - Булево - Содержит признак множественного выбора файлов;
//   * Фильтр - Строка - Содержит строку с набором файловых фильтров;
//
&НаКлиенте
Функция Новый_ПараметрыДиалогаВыбораФайла() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Заголовок", "");
	Результат.Вставить("Каталог", "");
	Результат.Вставить("МножественныйВыбор", Истина);
	Результат.Вставить("Фильтр", "");
	
	Возврат Результат;
	
КонецФункции

// Показывает диалог выбора файла
//
// Параметры:
//  ОписаниеОбработчика - Структура - см. функцию ОписаниеОбработчикаОповещения();
//  ПараметрыВыбора - Структура - см. функцию Новый_ПараметрыДиалогаВыбораФайла();
//
&НаКлиенте
Процедура ПоказатьДиалогВыбораФайла(ОписаниеОбработчика, ПараметрыВыбора) Экспорт
	
	ЗаголовокДиалога = ПараметрыВыбора.Заголовок;
	
	Если Не ЗначениеЗаполнено(ЗаголовокДиалога) Тогда
		ЗаголовокДиалога = НаименованиеМодуля();
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = ПараметрыВыбора.Фильтр;
	Диалог.Заголовок = ЗаголовокДиалога;
	Диалог.МножественныйВыбор = ПараметрыВыбора.МножественныйВыбор;
	Диалог.Каталог = ПараметрыВыбора.Каталог;
	
	Если ДоступныАсинхронныеФормы() Тогда
		ОповещениеОЗакрытии = НовоеОписаниеОповещения(ОписаниеОбработчика);
		Диалог.Показать(ОповещениеОЗакрытии);
	Иначе
		Если Диалог.Выбрать() Тогда
			Результат = Диалог.ВыбранныеФайлы;
		Иначе
			Результат = Неопределено;
		КонецЕсли;
		ВызватьОбработчикОповещения(ОписаниеОбработчика, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДиалогВыбораКаталога(ОписаниеОбработчика
	, ЗаголовокДиалога = Неопределено
	, ТекКаталог = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ЗаголовокДиалога) Тогда
		ЗаголовокДиалога = НаименованиеМодуля();
