&НаСервере
Процедура ЗаписатьНаСервере()
	
	ЗаписатьНастройкиДокументаУчета();
	ЗаписатьНастройкиЗаполненияОпераций();
	
	Модифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиДокументаУчета()
	
	ОписаниеНастройки = МодульОбъекта().Новый_НастройкиДокументаУчета();
	ЗаполнитьЗначенияСвойств(ОписаниеНастройки, ЭтаФорма);
	
	ОписаниеНастройки.ТипДокумента = ТипДокумента;
	ОписаниеНастройки.ПоказатьВСпискеЕслиТоварыНеЗаполнены = Не ПоказатьВСпискеЕслиТоварыЗаполнены;
	ОписаниеНастройки.ПоказатьВСпискеЕслиТоварыНеПодлежатМаркировке = Не ПоказатьВСпискеЕслиТоварыПодлежатМаркировке;
	ОписаниеНастройки.ПоказатьВСпискеЕслиНеПроведен = Не ПоказатьВСпискеЕслиПроведен;
	
	ЗаполнитьРолиДокумента(ОписаниеНастройки.РолиДокумента);
	
	ЗаполнитьОтключенныеКомандыДокумента(ОписаниеНастройки.ОтключенныеКоманды);
	
	МодульОбъекта().НастройкиДокументаУчета_Записать(ОписаниеНастройки);
	
	Действие = МодульОбъекта().Перечисление_ДействияМетрики().ЗаписьВБазу;
	МодульОбъекта().Метрика_НастройкиДокумента(Действие, Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиЗаполненияОпераций()
	
	ОписаниеНастройки = ОписаниеНастроекЗаполненияОперацийИзКонтекста();
	
	МодульОбъекта().НастройкиЗаполненияОпераций_Записать(ОписаниеНастройки);
	
	Действие = МодульОбъекта().Перечисление_ДействияМетрики().ЗаписьВБазу;
	МодульОбъекта().Метрика_НастройкиЗаполненияОпераций(Действие, ОписаниеНастройки);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРолиДокумента(РолиДокумента)
	
	МассивРолей = Новый Массив;
	Для Каждого Элемент Из СписокРолейДокумента Цикл
		Если Элемент.Пометка Тогда
			МассивРолей.Добавить(Элемент.Представление);
		КонецЕсли;
	КонецЦикла;
	
	РолиДокумента = МассивРолей;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтключенныеКомандыДокумента(ОтключенныеКоманды, СтрокиДерева = Неопределено)
	
	Если СтрокиДерева = Неопределено Тогда
		СтрокиДерева = РеквизитФормыВЗначение("ДеревоНастройкиКомандДокумента").Строки;
	КонецЕсли;
	
	Для Каждого Строка Из СтрокиДерева Цикл
		Если ЗначениеЗаполнено(Строка.Строки) Тогда
			ЗаполнитьОтключенныеКомандыДокумента(ОтключенныеКоманды, Строка.Строки);
		Иначе
			Если Не Строка.Пометка Тогда
				ОтключенныеКоманды.Добавить(Строка.ИмяКоманды);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормы()
	
	Заголовок = "Настройки документа: " + Наименование;
	
	Элементы.ПоказатьВСпискеЕслиТоварыЗаполнены.Доступность = Не ПоказатьВСпискеЕслиТоварыПодлежатМаркировке;
	
	Если ДокументМожноПровести() Тогда
		Элементы.ПоказатьВСпискеЕслиПроведен.Доступность = Истина;
		Элементы.ПоказатьВСпискеЕслиПроведен.Заголовок = НСтр("ru = 'Только если документ проведен'");
	Иначе
		Элементы.ПоказатьВСпискеЕслиПроведен.Доступность = Ложь;
		Элементы.ПоказатьВСпискеЕслиПроведен.Заголовок = НСтр(
		"ru = 'Только если документ проведен (у документа нет функции проведения)'");
	КонецЕсли;
	
	Элементы.СтраницаПоляДокумента.Доступность = Не ЭтоДополнительныйТипДокумента;
	Элементы.ТипДокумента.РежимВыбораИзСписка = Не ЭтоДополнительныйТипДокумента;
	Элементы.ПоказатьВСпискеЕслиТоварыПодлежатМаркировке.Видимость = Не ЭтоДополнительныйТипДокумента;
	Элементы.ПоказатьВСпискеЕслиТоварыЗаполнены.Видимость = Не ЭтоДополнительныйТипДокумента;
	
КонецПроцедуры

&НаСервере
Функция ВсеРеквизитыШапкиДокумента(ВключаяСтандартные = Ложь)
	
	РеквизитыШапки = Новый СписокЗначений;
	
	Если ЗначениеЗаполнено(ТипДокумента)
		И Не ЭтоДополнительныйТипДокумента Тогда
		
		МетаданныеДокумента = Метаданные.Документы.Найти(ТипДокумента);
		
		Если МетаданныеДокумента <> Неопределено Тогда
			
			Для Каждого РеквизитШапки Из МетаданныеДокумента.Реквизиты Цикл
				РеквизитыШапки.Добавить(РеквизитШапки.Имя);
			КонецЦикла;
			
			Для Каждого ОбщийРеквизит Из Метаданные.ОбщиеРеквизиты Цикл
				Если ОбщийРеквизит.Состав.Содержит(МетаданныеДокумента) Тогда
					РеквизитыШапки.Добавить(ОбщийРеквизит.Имя);
				КонецЕсли;
			КонецЦикла;
			
			Если ВключаяСтандартные Тогда
				Для Каждого РеквизитШапки Из МетаданныеДокумента.СтандартныеРеквизиты Цикл
					РеквизитыШапки.Добавить(РеквизитШапки.Имя);
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	РеквизитыШапки.СортироватьПоЗначению();
	
	Возврат РеквизитыШапки.ВыгрузитьЗначения();
	
КонецФункции

&НаСервере
Функция ВсеТабличныеЧастиДокумента()
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(ТипДокумента)
		И Не ЭтоДополнительныйТипДокумента Тогда
		МетаданныеДокумента = Метаданные.Документы.Найти(ТипДокумента);
		Если МетаданныеДокумента <> Неопределено Тогда
			Для Каждого ТабЧасть Из МетаданныеДокумента.ТабличныеЧасти Цикл
				Результат.Добавить(ТабЧасть.Имя);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ВсеРеквизитыТабличнойЧастиДокумента()
	
	Если ТабличнаяЧасть = "<Реквизиты шапки>" Тогда
		Возврат ВсеРеквизитыШапкиДокумента();
	КонецЕсли;
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(ТипДокумента)
		И ЗначениеЗаполнено(ТабличнаяЧасть) Тогда
		МетаданныеДокумента = Метаданные.Документы.Найти(ТипДокумента);
		Если МетаданныеДокумента <> Неопределено Тогда
			РеквизитыТЧ = МетаданныеДокумента.ТабличныеЧасти[ТабличнаяЧасть].Реквизиты;
			Для Каждого РеквизитТЧ Из РеквизитыТЧ Цикл
				Результат.Добавить(РеквизитТЧ.Имя);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ДокументМожноПровести()
	
	Если ЭтоДополнительныйТипДокумента Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат = Истина;
	
	МетаданныеДокумента = Метаданные.Документы.Найти(ТипДокумента);
	Если МетаданныеДокумента <> Неопределено
		И МетаданныеДокумента.Проведение <> Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПроверитьЗаполнениеРеквизитов()
	
	ЕстьОшибки = Ложь;
	
	ПроверитьТипДокумента(ЕстьОшибки);
	ПроверитьФормулыДопКолонокИУсловийОтбора(ЕстьОшибки);
	ПроверитьНастройкиЗаполненияОпераций(ЕстьОшибки);
	ПроверитьРолиДокумента(ЕстьОшибки);
	
	Возврат Не ЕстьОшибки;
	
КонецФункции

&НаСервере
Процедура ПроверитьТипДокумента(ЕстьОшибки)
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		
		СтарыйТипДокумента = МодульОбъекта().НастройкиДокументаУчета_Прочитать(Ссылка).ТипДокумента;
		
		Если ТипДокумента <> СтарыйТипДокумента Тогда
			ПроверитьНаличиеДокументовПоСтаромуТипу(СтарыйТипДокумента, ЕстьОшибки);
		КонецЕсли;
		
	КонецЕсли;
	
	ПроверитьНаличиеДубликатаНастройки(ЕстьОшибки);
	
	Если ЭтоДополнительныйТипДокумента Тогда
		ПроверитьДопустимостьДополнительногоТипаДокумента(ЕстьОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьНаличиеДокументовПоСтаромуТипу(СтарыйТипДокумента, ЕстьОшибки)
	
	Если МодульОбъекта().НастройкиДокументовУчета_ЕстьДокументыПоТипу(СтарыйТипДокумента) Тогда
		ТекстОшибки = НСтр("ru = 'Невозможно изменить тип документа, уже есть документы по типу: %1'");
		ТекстОшибки = МодульОбъекта().ПараметрыВСтроку(ТекстОшибки, СтарыйТипДокумента);
		МодульОбъекта().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "ТипДокумента");
		ЕстьОшибки = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьНаличиеДубликатаНастройки(ЕстьОшибки)
	
	ВызыватьИсключение = Ложь;
	НастройкаИБ = МодульОбъекта().НастройкиДокументовУчета_НайтиПоТипуДокумента(ТипДокумента, ВызыватьИсключение);
	
	Если ЗначениеЗаполнено(НастройкаИБ) И НастройкаИБ <> Ссылка Тогда
		ТекстОшибки = НСтр("ru = 'Уже существует настройка по типу документа 1С: %1'");
		ТекстОшибки = МодульОбъекта().ПараметрыВСтроку(ТекстОшибки, ТипДокумента);
		МодульОбъекта().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "ТипДокумента");
		ЕстьОшибки = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьДопустимостьДополнительногоТипаДокумента(ЕстьОшибки)
	
	ЗарезервированныйТипДляПроизводства = "КонтурМаркировка_ЗаданиеНаПроизводство";
	
	Если НРег(ТипДокумента) = НРег(ЗарезервированныйТипДляПроизводства) Тогда
		ТекстОшибки = НСтр("ru = 'Тип ""%1"" зарезервирован в модуле, поэтому не может быть дополнительным'");
		ТекстОшибки = МодульОбъекта().ПараметрыВСтроку(ТекстОшибки, ТипДокумента);
		МодульОбъекта().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "ТипДокумента");
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	ДопустимыйПрефиксТиповДопДокументов = "КонтурМаркировка_";
	
	Если Не МодульОбъекта().СтрокаНачинаетсяС(ТипДокумента, ДопустимыйПрефиксТиповДопДокументов) Тогда
		ТекстОшибки = НСтр("ru = 'Тип дополнительного документа должен начинаться с префикса: %1'");
		ТекстОшибки = МодульОбъекта().ПараметрыВСтроку(ТекстОшибки, ДопустимыйПрефиксТиповДопДокументов);
		МодульОбъекта().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "ТипДокумента");
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если Метаданные.Документы.Найти(ТипДокумента) <> Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Тип ""%1"" есть в документах 1С, поэтому не может быть дополнительным'");
		ТекстОшибки = МодульОбъекта().ПараметрыВСтроку(ТекстОшибки, ТипДокумента);
		МодульОбъекта().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "ТипДокумента");
		ЕстьОшибки = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьФормулыДопКолонокИУсловийОтбора(ЕстьОшибки)
	
	Если ЭтоДополнительныйТипДокумента Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонОшибки = НСтр("ru = 'Неверная формула: %1'");
	
	Если ЗначениеЗаполнено(ДопКолонка1_Формула)
		И Не ПроверитьФормулу(ДопКолонка1_Формула) Тогда
		ТекстОшибки = МодульОбъекта().ПараметрыВСтроку(ШаблонОшибки, ДопКолонка1_Формула);
		МодульОбъекта().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "ДопКолонка1_Формула");
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДопКолонка2_Формула)
		И Не ПроверитьФормулу(ДопКолонка2_Формула) Тогда
		ТекстОшибки = МодульОбъекта().ПараметрыВСтроку(ШаблонОшибки, ДопКолонка2_Формула);
		МодульОбъекта().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "ДопКолонка2_Формула");
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДопКолонка3_Формула)
		И Не ПроверитьФормулу(ДопКолонка3_Формула) Тогда
		ТекстОшибки = МодульОбъекта().ПараметрыВСтроку(ШаблонОшибки, ДопКолонка3_Формула);
		МодульОбъекта().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "ДопКолонка3_Формула");
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительноеУсловиеОтбора)
		И Не ПроверитьФормулу(ДополнительноеУсловиеОтбора) Тогда
		ТекстОшибки = МодульОбъекта().ПараметрыВСтроку(ШаблонОшибки, ДополнительноеУсловиеОтбора);
		МодульОбъекта().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "ДополнительноеУсловиеОтбора");
		ЕстьОшибки = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьФормулу(Формула)
	
	Если ЭтоДополнительныйТипДокумента
		И Найти(Формула, "Документ1С.Склад") > 0 Тогда
		Возврат Истина; // В документе учета не получиться проверить склад 1С
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	&ДопКолонка КАК ДопКолонка
	|ИЗ
	|	ТаблицаДокумента КАК Документ1С";
	
	Если ЭтоДополнительныйТипДокумента Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаДокумента", "Справочник.КонтурМаркировка_ДокументыУчета");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаДокумента", "Документ." + ТипДокумента);
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДопКолонка", Формула);
	
	Попытка
		Запрос = Новый Запрос(ТекстЗапроса);
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ПроверитьНастройкиЗаполненияОпераций(ЕстьОшибки)
	
	ТаблицаФормы = Элементы.ТаблицаРеквизитовОпераций;
	
	Для Каждого Стр Из ТаблицаРеквизитовОпераций Цикл
		ИндексСтроки = ТаблицаРеквизитовОпераций.Индекс(Стр);
		Если Не МодульОбъекта().ПроверитьЗначениеНастройкиЗаполненияРеквизита(
			Стр, ТипДокумента, УникальныйИдентификатор, ТаблицаФормы, ИндексСтроки) Тогда
			ЕстьОшибки = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьРолиДокумента(ЕстьОшибки)
	
	РолиДокументов = МодульОбъекта().Перечисление_РолиДокументовУчета();
	ЕстьРольОтгрузка = Ложь;
	ЕстьРольКорректировка = Ложь;
	
	Для Каждого Элемент Из СписокРолейДокумента Цикл
		Если Не Элемент.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Если Элемент.Представление = РолиДокументов.Отгрузка Тогда
			ЕстьРольОтгрузка = Истина;
		КонецЕсли;
		Если Элемент.Представление = РолиДокументов.КорректировкаОтгрузки Тогда
			ЕстьРольКорректировка = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьРольОтгрузка И ЕстьРольКорректировка Тогда
		ТекстОшибки = НСтр("ru = """
		+ "Выбрано недопустимое сочетание ролей документа. "
		+ "Уточните выбор и укажите только одно значение: Отгрузка или Корректировка отгрузки.""");
		МодульОбъекта().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "ПредставлениеРолейДокумента");
		ЕстьОшибки = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеРолейДокументаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Обработчик = МодульКлиента().ОписаниеОбработчикаОповещения("СписокРолейДокументаПослеРедактирования", ЭтаФорма);
	
	КонтекстФормы = МодульКлиента().Новый_ПараметрыФормыРедактированияСписка();
	
	КонтекстФормы.РазрешитьРедактирование = Истина;
	КонтекстФормы.Заголовок               = НСтр("ru = 'Роли документа учета'");
	КонтекстФормы.Список                  = СписокРолейДокумента;
	КонтекстФормы.ИспользоватьПометки     = Истина;
	
	МодульКлиента().ОткрытьФормуПросмотраСписка(ЭтаФорма, КонтекстФормы, Обработчик);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокРолейДокументаПослеРедактирования(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокРолейДокумента = Результат;
	СформироватьПредставлениеРолейДокумента();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьПредставлениеРолейДокумента()
	
	ТекстПредставленияРолей = "";
	Для Каждого Элемент Из СписокРолейДокумента Цикл
		Если Не Элемент.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекстПредставленияРолей) Тогда
			ТекстПредставленияРолей = ТекстПредставленияРолей + ", " + Элемент.Представление;
		Иначе
			ТекстПредставленияРолей = Элемент.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ТекстПредставленияРолей) Тогда
		ТекстПредставленияРолей = НСтр("ru = '<Роль документа>'");
	КонецЕсли;
	
	ПредставлениеРолейДокумента = ТекстПредставленияРолей;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовОперацийУстановитьОтбор()
	
	ТипОперации = Элементы.СписокТиповОпераций.ТекущиеДанные.Значение;
	ЗначениеОтбора = Новый ФиксированнаяСтруктура("ТипОперации", ТипОперации);
	Элементы.ТаблицаРеквизитовОпераций.ОтборСтрок = ЗначениеОтбора;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Таблица = Элементы.ТаблицаРеквизитовОпераций;
	ПравилаЗаполнения = МодульОбъекта().Перечисление_ПравилаЗаполненияРеквизитов();
	Реквизиты = МодульОбъекта().Перечисление_РеквизитыОперацийДляАвтозаполнения();
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ПолеУО = ЭлементУО.Поля.Элементы.Добавить();
	ПолеУО.Поле = Новый ПолеКомпоновкиДанных(Таблица.ПутьКДанным + "Значение");
	ЭлементОтбора = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Таблица.Имя + ".ПравилоЗаполнения");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = ПравилаЗаполнения.НеЗаполнять;
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	Для Каждого Страна Из МодульОбъекта().СписокСтранЕАЭС() Цикл
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ПолеУО = ЭлементУО.Поля.Элементы.Добавить();
		ПолеУО.Поле = Новый ПолеКомпоновкиДанных(Таблица.ПутьКДанным + "Значение");
		
		ЭлементОтбора = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Таблица.Имя + ".ИмяРеквизита");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Реквизиты.КодСтраныПолучателя;
		
		ЭлементОтбора = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Таблица.Имя + ".Значение");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Страна.Значение;
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", Страна.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ОписаниеНастроекЗаполненияОперацийИзКонтекста()
	
	Результат = МодульОбъекта().Новый_НастройкиЗаполненияОпераций();
	ЗаполнитьЗначенияСвойств(Результат, ЭтаФорма);
	
	Для Каждого Элемент Из СписокТиповОпераций Цикл
		Если Элемент.Пометка Тогда
			Результат.ТипыОпераций.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаИБ Из Результат.ТаблицаРеквизитов Цикл
		Для Каждого СтрокаФормы Из ТаблицаРеквизитовОпераций Цикл
			Если СтрокаИБ.ТипОперации = СтрокаФормы.ТипОперации
				И СтрокаИБ.ИмяРеквизита = СтрокаФормы.ИмяРеквизита Тогда
				ЗаполнитьЗначенияСвойств(СтрокаИБ, СтрокаФормы);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

