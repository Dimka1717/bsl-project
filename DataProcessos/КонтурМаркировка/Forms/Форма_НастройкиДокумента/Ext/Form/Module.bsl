
// Описание переменных

&НаКлиенте
Перем КэшМодуляКлиента;

// Методы получения модулей

&НаСервере
Функция МодульОбъекта()
	
	Возврат ВзаимодействиеКонтурМаркировка.МодульКонтурМаркировка();
	
КонецФункции

&НаКлиенте
Функция МодульКлиента() Экспорт
	
	Если КэшМодуляКлиента <> Неопределено Тогда
		Возврат КэшМодуляКлиента;
	КонецЕсли;
	
	Если ТипЗнч(ВладелецФормы) = ТипЗнч(ЭтаФорма) Тогда
		Результат = ВладелецФормы.МодульКлиента();
	Иначе
		ПутьКФорме = ПутьКФормеМодуляКлиента();
		Результат = ОткрытьФорму(ПутьКФорме);
	КонецЕсли;
	
	КэшМодуляКлиента = Результат;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПутьКФормеМодуляКлиента()
	
	Возврат МодульОбъекта().ПутьКФормеМодуляКлиента();
	
КонецФункции

// Обработчики событий формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Ссылка = Параметры.Ссылка;
	
	ЗаполнитьКонтекст();
	ЗаполнитьСпискиВыбора();
	НастроитьЭлементыФормы();
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		ЭтаФорма.ТекущийЭлемент = Элементы.ДеревоНастройкиКомандДокументаЗначение;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	МодульКлиента().СохранитьИзмененияНаФорме("ЗаписатьИЗакрыть", ЭтаФорма, Отказ, ЗавершениеРаботы);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ПроверяемыеРеквизиты.Очистить();
	ПроверяемыеРеквизиты.Добавить("ТипДокумента");
	ПроверяемыеРеквизиты.Добавить("Наименование");
	
	Если Не ЭтоДополнительныйТипДокумента Тогда
		ПроверяемыеРеквизиты.Добавить("ПолеОрганизация");
		ПроверяемыеРеквизиты.Добавить("ТабличнаяЧасть");
		ПроверяемыеРеквизиты.Добавить("ПолеНоменклатура");
		ПроверяемыеРеквизиты.Добавить("ПолеКоличество");
	КонецЕсли;
	
КонецПроцедуры

// Обработчики событий элементов формы

&НаКлиенте
Процедура ЭтоДополнительныйТипДокументаПриИзменении(Элемент)
	
	ТипДокумента = "КонтурМаркировка_";
	Наименование = "";
	
	ЭтоДополнительныйТипДокументаПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЭтоДополнительныйТипДокументаПриИзмененииНаСервере()
	
	ЗаполнитьЗначениямиПоУмолчанию();
	ЗаполнитьСпискиВыбора();
	НастроитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипДокументаПриИзменении(Элемент)
	
	Если ЭтоДополнительныйТипДокумента Тогда
		ТипДокумента = СтрЗаменить(ТипДокумента, " ", "");
	Иначе
		Наименование = Элементы.ТипДокумента.ТекстРедактирования;
	КонецЕсли;
	
	ТипДокументаПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ТипДокументаПриИзмененииНаСервере()
	
	ЗаполнитьЗначениямиПоУмолчанию();
	ЗаполнитьСпискиВыбора();
	НастроитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличнаяЧастьПриИзменении(Элемент)
	
	ТабличнаяЧастьПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ТабличнаяЧастьПриИзмененииНаСервере()
	
	ЗаполнитьСпискиВыбораПолейТабличнойЧасти();
	ЗаполнитьПоУмолчаниюПоляТабличнойЧасти();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВСпискеЕслиТоварыПодлежатМаркировкеПриИзменении(Элемент)
	
	Если ПоказатьВСпискеЕслиТоварыПодлежатМаркировке Тогда
		ПоказатьВСпискеЕслиТоварыЗаполнены = Истина;
	КонецЕсли;
	
	НастроитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокТиповОперацийПриАктивизацииСтроки(Элемент)
	
	ТаблицаРеквизитовОперацийУстановитьОтбор();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовОперацийПриАктивизацииЯчейки(Элемент)
	
	Если Элемент.ТекущийЭлемент.Имя = "ТаблицаРеквизитовОперацийЗначение" Тогда
		ТекущиеДанные = Элементы.ТаблицаРеквизитовОпераций.ТекущиеДанные;
		МодульКлиента().НастроитьЭлементЗначенияЗаполненияРеквизита(
		Элемент.ТекущийЭлемент, ТекущиеДанные, Не ЭтоДополнительныйТипДокумента);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовОперацийПравилоЗаполненияПриИзменении(Элемент)
	
	ТаблицаРеквизитовОперацийПравилоЗаполненияПриИзмененииНаСервере(Элементы.ТаблицаРеквизитовОпераций.ТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура ТаблицаРеквизитовОперацийПравилоЗаполненияПриИзмененииНаСервере(ТекущаяСтрока)
	
	ПравилаЗаполнения = МодульОбъекта().Перечисление_ПравилаЗаполненияРеквизитов();
	
	ТекущиеДанные = ТаблицаРеквизитовОпераций.НайтиПоИдентификатору(ТекущаяСтрока);
	Если ТекущиеДанные.ПравилоЗаполнения = ПравилаЗаполнения.ФиксированноеЗначение Тогда
		ТекущиеДанные.Значение = МодульОбъекта().ПустоеЗначениеТипаЛок(ТекущиеДанные.ТипЗначения);
	Иначе
		ТекущиеДанные.Значение = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовОперацийЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ТаблицаРеквизитовОпераций.ТекущиеДанные;
	ПравилаЗаполнения = МодульКлиента().Перечисление_ПравилаЗаполненияРеквизитов();
	
	Если МодульКлиента().ВыборЗначенияИзСправочника(Элемент, ТекущиеДанные, СтандартнаяОбработка) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ПравилоЗаполнения = ПравилаЗаполнения.РеквизитДокумента1С Тогда
		ЗначенияВыбора = ВсеРеквизитыШапкиДокумента(Истина);
	Иначе
		ЗначенияВыбора = МодульКлиента().ДанныеВыбораЗначенияЗаполненияРеквизита(ТекущиеДанные);
	КонецЕсли;
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
	"ТаблицаРеквизитовОперацийЗначениеПослеВыбора", ЭтаФорма);
	
	Если ЗначениеЗаполнено(ЗначенияВыбора) Тогда
		МодульКлиента().ПоказатьДиалогВыбораИзСписка(ОписаниеОбработчика
		, ЗначенияВыбора
		, Элемент
		, ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовОперацийЗначениеПослеВыбора(ВыбранноеЗначение, ДопПараметры = Неопределено) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ТаблицаРеквизитовОпераций.ТекущиеДанные.Значение = ВыбранноеЗначение.Значение;
	Элементы.ТаблицаРеквизитовОпераций.ЗакончитьРедактированиеСтроки(Ложь);
	
	Модифицированность = Истина;
	
КонецПроцедуры

// Обработчики команд

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда = Неопределено, ДопПараметры = Неопределено) Экспорт
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполнениеРеквизитов() Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьНаСервере();
	
	МодульКлиента().СброситьКэш();
	
	Оповестить("КонтурМаркировка_НастройкаДокументаУчета_Изменен", Ссылка);
	
	Закрыть();
	
КонецПроцедуры

// Процедуры заполнения списков выбора

&НаСервере
Процедура ЗаполнитьСпискиВыбора()
	
	ЗаполнитьСписокВыбораТипДокумента();
	ЗаполнитьСписокВыбораТабличнаяЧасть();
	ЗаполнитьСпискиВыбораПолейШапки();
	ЗаполнитьСпискиВыбораПолейТабличнойЧасти();
	ЗаполнитьСписокВыбораПравилоЗаполнения();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораТипДокумента()
	
	Если ЭтоДополнительныйТипДокумента Тогда
		Элементы.ТипДокумента.СписокВыбора.Очистить();
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Элементы.ТипДокумента.СписокВыбора) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Док Из Метаданные.Документы Цикл
		Элементы.ТипДокумента.СписокВыбора.Добавить(Док.Имя, Док.Синоним);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораТабличнаяЧасть()
	
	Если ЭтоДополнительныйТипДокумента Тогда
		Возврат;
	КонецЕсли;
	
	МассивРеквизитов = ВсеТабличныеЧастиДокумента();
	МассивРеквизитов.Добавить("<Реквизиты шапки>");
	Элементы.ТабличнаяЧасть.СписокВыбора.ЗагрузитьЗначения(МассивРеквизитов);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиВыбораПолейШапки()
	
	Если ЭтоДополнительныйТипДокумента Тогда
		Возврат;
	КонецЕсли;
	
	МассивРеквизитов = ВсеРеквизитыШапкиДокумента();
	Элементы.ПолеОрганизация.СписокВыбора.ЗагрузитьЗначения(МассивРеквизитов);
	Элементы.ПолеСклад.СписокВыбора.ЗагрузитьЗначения(МассивРеквизитов);
	Элементы.ПолеКонтрагент.СписокВыбора.ЗагрузитьЗначения(МассивРеквизитов);
	Элементы.ПолеСумма.СписокВыбора.ЗагрузитьЗначения(МассивРеквизитов);
	Элементы.ПолеДокументОснование.СписокВыбора.ЗагрузитьЗначения(МассивРеквизитов);
	Элементы.ПолеКомментарий.СписокВыбора.ЗагрузитьЗначения(МассивРеквизитов);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиВыбораПолейТабличнойЧасти()
	
	Если ЭтоДополнительныйТипДокумента Тогда
		Возврат;
	КонецЕсли;
	
	МассивРеквизитов = ВсеРеквизитыТабличнойЧастиДокумента();
	Элементы.ПолеНоменклатура.СписокВыбора.ЗагрузитьЗначения(МассивРеквизитов);
	Элементы.ПолеХарактеристика.СписокВыбора.ЗагрузитьЗначения(МассивРеквизитов);
	Элементы.ПолеУпаковка.СписокВыбора.ЗагрузитьЗначения(МассивРеквизитов);
	Элементы.ПолеСерия.СписокВыбора.ЗагрузитьЗначения(МассивРеквизитов);
	Элементы.ПолеКоличество.СписокВыбора.ЗагрузитьЗначения(МассивРеквизитов);
	Элементы.ПолеЦена.СписокВыбора.ЗагрузитьЗначения(МассивРеквизитов);
	Элементы.ПолеКоличествоУпаковок.СписокВыбора.ЗагрузитьЗначения(МассивРеквизитов);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораПравилоЗаполнения()
	
	ПравилаЗаполнения = МодульОбъекта().Перечисление_ПравилаЗаполненияРеквизитов();
	СписокВыбора = Элементы.ТаблицаРеквизитовОперацийПравилоЗаполнения.СписокВыбора;
	
	ЗначенияСписка = Новый Массив;
	Для Каждого Элемент Из ПравилаЗаполнения Цикл
		Если ЭтоДополнительныйТипДокумента
			И Элемент.Значение = ПравилаЗаполнения.РеквизитДокумента1С Тогда
			Продолжить;
		КонецЕсли;
		ЗначенияСписка.Добавить(Элемент.Значение);
	КонецЦикла;
	
	МодульОбъекта().ЗаполнитьСписокВыбора(СписокВыбора, ЗначенияСписка);
	
КонецПроцедуры

// Процедуры заполнения значений по умолчанию

&НаСервере
Процедура ЗаполнитьЗначениямиПоУмолчанию()
	
	ЗаполнитьПоУмолчаниюПоляШапки();
	ЗаполнитьПоУмолчаниюИмяТабличнойЧасти();
	ЗаполнитьПоУмолчаниюПоляТабличнойЧасти();
	ЗаполнитьПоУмолчаниюПризнакПоказатьВСпискеЕслиПроведен();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоУмолчаниюПоляШапки()
	
	МассивРеквизитов = ВсеРеквизитыШапкиДокумента();
	
	Если МассивРеквизитов.Найти("Организация") <> Неопределено Тогда
		ПолеОрганизация = "Организация";
	Иначе
		ПолеОрганизация = "";
	КонецЕсли;
	
	Если МассивРеквизитов.Найти("Склад") <> Неопределено Тогда
		ПолеСклад = "Склад";
	ИначеЕсли МассивРеквизитов.Найти("СкладГруппа") <> Неопределено Тогда
		ПолеСклад = "СкладГруппа";
	Иначе
		ПолеСклад = "";
	КонецЕсли;
	
	Если МассивРеквизитов.Найти("Контрагент") <> Неопределено Тогда
		ПолеКонтрагент = "Контрагент";
	Иначе
		ПолеКонтрагент = "";
	КонецЕсли;
	
	Если МассивРеквизитов.Найти("СуммаДокумента") <> Неопределено Тогда
		ПолеСумма = "СуммаДокумента";
	Иначе
		ПолеСумма = "";
	КонецЕсли;
	
	Если МассивРеквизитов.Найти("ЗаказКлиента") <> Неопределено Тогда
		ПолеДокументОснование = "ЗаказКлиента";
	ИначеЕсли МассивРеквизитов.Найти("ДокументОснование") <> Неопределено Тогда
		ПолеДокументОснование = "ДокументОснование";
	ИначеЕсли МассивРеквизитов.Найти("ИсправляемыйДокументРеализации") <> Неопределено Тогда
		ПолеДокументОснование = "ИсправляемыйДокументРеализации";
	Иначе
		ПолеДокументОснование = "";
	КонецЕсли;
	
	Если МассивРеквизитов.Найти("Комментарий") <> Неопределено Тогда
		ПолеКомментарий = "Комментарий";
	Иначе
		ПолеКомментарий = "";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоУмолчаниюИмяТабличнойЧасти()
	
	МассивРеквизитов = ВсеТабличныеЧастиДокумента();
	
	Если МассивРеквизитов.Найти("Товары") <> Неопределено Тогда
		ТабличнаяЧасть = "Товары";
	Иначе
		ТабличнаяЧасть = "";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоУмолчаниюПоляТабличнойЧасти()
	
	МассивРеквизитов = ВсеРеквизитыТабличнойЧастиДокумента();
	
	Если МассивРеквизитов.Найти("Номенклатура") <> Неопределено Тогда
		ПолеНоменклатура = "Номенклатура";
	Иначе
		ПолеНоменклатура = "";
	КонецЕсли;
	
	Если МассивРеквизитов.Найти("Характеристика") <> Неопределено Тогда
		ПолеХарактеристика = "Характеристика";
	Иначе
		ПолеХарактеристика = "";
	КонецЕсли;
	
	Если МассивРеквизитов.Найти("Упаковка") <> Неопределено Тогда
		ПолеУпаковка = "Упаковка";
	Иначе
		ПолеУпаковка = "";
	КонецЕсли;
	
	Если МассивРеквизитов.Найти("Серия") <> Неопределено Тогда
		ПолеСерия = "Серия";
	Иначе
		ПолеСерия = "";
	КонецЕсли;
	
	Если МассивРеквизитов.Найти("Цена") <> Неопределено Тогда
		ПолеЦена = "Цена";
	Иначе
		ПолеЦена = "";
	КонецЕсли;
	
	Если МассивРеквизитов.Найти("КоличествоУпаковок") <> Неопределено Тогда
		ПолеКоличество = "КоличествоУпаковок";
	ИначеЕсли МассивРеквизитов.Найти("Количество") <> Неопределено Тогда
		ПолеКоличество = "Количество";
	Иначе
		ПолеКоличество = "";
	КонецЕсли;
	
	Если МассивРеквизитов.Найти("КоличествоПотребительскихУпаковок") <> Неопределено Тогда
		ПолеКоличествоУпаковок = "КоличествоПотребительскихУпаковок";
	Иначе
		ПолеКоличествоУпаковок = "";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоУмолчаниюПризнакПоказатьВСпискеЕслиПроведен()
	
	ПоказатьВСпискеЕслиПроведен = ДокументМожноПровести();
	
КонецПроцедуры

// Служебные процедуры и функции

&НаСервере
Процедура ЗаполнитьКонтекст()
	
	ОписаниеНастройки = МодульОбъекта().НастройкиДокументаУчета_Прочитать(Ссылка);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ОписаниеНастройки);
	
	Если ЗначениеЗаполнено(ОписаниеНастройки.ТипДокумента) Тогда
		ТипДокумента = ОписаниеНастройки.ТипДокумента;
	КонецЕсли;
	
	ПоказатьВСпискеЕслиПроведен = Не ОписаниеНастройки.ПоказатьВСпискеЕслиНеПроведен;
	ПоказатьВСпискеЕслиТоварыЗаполнены = Не ОписаниеНастройки.ПоказатьВСпискеЕслиТоварыНеЗаполнены;
	ПоказатьВСпискеЕслиТоварыПодлежатМаркировке = Не ОписаниеНастройки.ПоказатьВСпискеЕслиТоварыНеПодлежатМаркировке;
	
	ЗаполнитьНастройкиКомандДокумента(ОписаниеНастройки.ОтключенныеКоманды);
	ЗаполнитьНастройкиРолейДокумента(ОписаниеНастройки.РолиДокумента);
	
	ЗаполнитьНастройкиЗаполненияОпераций();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиЗаполненияОпераций()
	
	ОписаниеНастройки = МодульОбъекта().НастройкиЗаполненияОпераций_ПрочитатьПоТипуДокумента(ТипДокумента);
	
	Для Каждого Стр Из ОписаниеНастройки.ТаблицаРеквизитов Цикл
		НоваяСтрока = ТаблицаРеквизитовОпераций.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		Если СписокТиповОпераций.НайтиПоЗначению(Стр.ТипОперации) = Неопределено Тогда
			Элемент = СписокТиповОпераций.Добавить(Стр.ТипОперации);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Элемент Из СписокТиповОпераций Цикл
		Если ОписаниеНастройки.ТипыОпераций.Найти(Элемент.Значение) <> Неопределено Тогда
			Элемент.Пометка = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуРеквизитовОпераций(ПараметрыЗаполнения)
	
	ТипыОпераций = ПараметрыЗаполнения.ТипыОпераций;
	НастройкиЗаполнения = ПараметрыЗаполнения.НастройкиЗаполнения;
	
	Для Каждого Стр Из НастройкиЗаполнения Цикл
		НоваяСтрока = ТаблицаРеквизитовОпераций.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		Если СписокТиповОпераций.НайтиПоЗначению(Стр.ТипОперации) = Неопределено Тогда
			Элемент = СписокТиповОпераций.Добавить(Стр.ТипОперации);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Элемент Из СписокТиповОпераций Цикл
		Если ТипыОпераций.Найти(Элемент.Значение) <> Неопределено Тогда
			Элемент.Пометка = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиРолейДокумента(РолиДокумента)
	
	РолиДокументовУчета = МодульОбъекта().Перечисление_РолиДокументовУчета();
	Для каждого РольДокумента Из РолиДокументовУчета Цикл
		Пометка = РолиДокумента.Найти(РольДокумента.Значение) <> Неопределено;
		СписокРолейДокумента.Добавить(РольДокумента.Ключ, РольДокумента.Значение, Пометка);
	КонецЦикла;
	
	СформироватьПредставлениеРолейДокумента();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиКомандДокумента(ОтключенныеКоманды, СтрокиДерева = Неопределено, КомандыДерева = Неопределено)
	
	Если СтрокиДерева = Неопределено Тогда
		СтрокиДерева = ДеревоНастройкиКомандДокумента.ПолучитьЭлементы();
	КонецЕсли;
	
	Если КомандыДерева = Неопределено Тогда
		КомандыДерева = СтруктураКомандДокумента();
	КонецЕсли;
	
	ПредставленияКоманд = ПредставленияКомандДокумента();
	
	Для каждого Элемент Из КомандыДерева Цикл
		
		Если ТипЗнч(Элемент) = Тип("Строка") Тогда
			// Это команда
			Пометка = ОтключенныеКоманды.Найти(Элемент) = Неопределено;
			СтрокаКоманды = СтрокиДерева.Добавить();
			СтрокаКоманды.Пометка = Пометка;
			СтрокаКоманды.ИмяКоманды = Элемент;
			СтрокаКоманды.Представление = ПредставленияКоманд[Элемент];
		Иначе
			// Это раздел
			ГруппаКоманд = СтрокиДерева.Добавить();
			ГруппаКоманд.Представление = Элемент.Заголовок;
			ЗаполнитьНастройкиКомандДокумента(ОтключенныеКоманды, ГруппаКоманд.ПолучитьЭлементы(), Элемент.Команды);
			ДеревоНастройкиКомандДокумента_ОбновитьПометкиРодительскихСтрок(ГруппаКоманд);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоНастройкиКомандДокументаПометкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоНастройкиКомандДокумента.ТекущиеДанные;
	
	Если ТекущиеДанные.Пометка = 2 Тогда
		ТекущиеДанные.Пометка = Ложь;
	КонецЕсли;
	
	ДеревоНастройкиКомандДокумента_ОбновитьПометкиВложенныхСтрок(ТекущиеДанные);
	ДеревоНастройкиКомандДокумента_ОбновитьПометкиРодительскихСтрок(ТекущиеДанные.ПолучитьРодителя());
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоНастройкиКомандДокумента_ОбновитьПометкиВложенныхСтрок(СтрокаРодителя)
	
	ВложенныеСтроки = СтрокаРодителя.ПолучитьЭлементы();
	Для каждого Строка Из ВложенныеСтроки Цикл
		
		Строка.Пометка = СтрокаРодителя.Пометка;
		ДеревоНастройкиКомандДокумента_ОбновитьПометкиВложенныхСтрок(Строка);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДеревоНастройкиКомандДокумента_ОбновитьПометкиРодительскихСтрок(СтрокаРодителя)
	
	Если СтрокаРодителя = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Есть0 = Ложь;
	Есть1 = Ложь;
	Есть2 = Ложь;
	Для каждого Строка Из СтрокаРодителя.ПолучитьЭлементы() Цикл
		Есть0 = (Есть0 Или Строка.Пометка = 0);
		Есть1 = (Есть1 Или Строка.Пометка = 1);
		Есть2 = (Есть2 Или Строка.Пометка = 2);
	КонецЦикла;
	
	Если Есть2 Тогда
		Пометка = 2;
	ИначеЕсли Есть1 И Не Есть0 Тогда
		Пометка = 1;
	ИначеЕсли Есть0 И Не Есть1 Тогда
		Пометка = 0;
	Иначе
		Пометка = 2;
	КонецЕсли;
	
	СтрокаРодителя.Пометка = Пометка;
	
	ДеревоНастройкиКомандДокумента_ОбновитьПометкиРодительскихСтрок(СтрокаРодителя.ПолучитьРодителя());
	
КонецПроцедуры

&НаСервере
