	<Attributes>
		<Attribute name="Объект" id="1">
			<Type>
				<v8:Type>cfg:DataProcessorObject.КонтурМаркировка</v8:Type>
			</Type>
		</Attribute>
		<Attribute name="Список" id="2">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>~Список.ТипОперации</Field>
				<Field>Список.Ссылка</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<AutoFillAvailableFields>false</AutoFillAvailableFields>
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	Спр.Ссылка КАК Ссылка,
	Спр.Организация КАК Организация,
	Статусы.Статус КАК Статус,
	НомераДокументов.Значение КАК НомерДокумента,
	НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(ДатыДокументов.Значение КАК ДАТА), ДЕНЬ) КАК ДатаДокумента,
	НаименованиеКонтрагентов.Значение КАК НаименованиеКонтрагента,
	ИННКонтрагентов.Значение КАК КонтрагентИНН,
	ВЫБОР
		КОГДА СодержитОшибки.Значение = ИСТИНА
			ТОГДА 2
		ИНАЧЕ 5
	КОНЕЦ КАК НомерКартинки
{ВЫБРАТЬ
	Ссылка.*,
	Организация.*,
	Статус,
	НомерДокумента,
	ДатаДокумента,
	НаименованиеКонтрагента,
	КонтрагентИНН,
	НомерКартинки}
ИЗ
	Справочник.КонтурМаркировка_Операции КАК Спр
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК Статусы
		ПО Спр.Ссылка = Статусы.Операция
			И (Статусы.ТипСтатуса = "ОсновнойСтатус")
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК НомераДокументов
		ПО Спр.Ссылка = НомераДокументов.Объект
			И (НомераДокументов.ИмяРеквизита = "НомерДокумента")
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ДатыДокументов
		ПО Спр.Ссылка = ДатыДокументов.Объект
			И (ДатыДокументов.ИмяРеквизита = "ДатаДокумента")
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК НаименованиеКонтрагентов
		ПО Спр.Ссылка = НаименованиеКонтрагентов.Объект
			И (НаименованиеКонтрагентов.ИмяРеквизита = "КонтрагентНаименование")
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ИННКонтрагентов
		ПО Спр.Ссылка = ИННКонтрагентов.Объект
			И (ИННКонтрагентов.ИмяРеквизита = "КонтрагентИНН")
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК СодержитОшибки
		ПО Спр.Ссылка = СодержитОшибки.Объект
			И (СодержитОшибки.ИмяРеквизита = "СодержитОшибки")
ГДЕ
	Спр.ТипОперации = "Входящий УПД"
	И ВЫРАЗИТЬ(ДатыДокументов.Значение КАК ДАТА) МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
{ГДЕ
	Спр.Ссылка.*,
	Спр.Организация.*,
	Статусы.Статус,
	НомераДокументов.Значение КАК НомерДокумента,
	(НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(ДатыДокументов.Значение КАК ДАТА), ДЕНЬ)) КАК ДатаДокумента,
	НаименованиеКонтрагентов.Значение КАК НаименованиеКонтрагента,
	ИННКонтрагентов.Значение КАК КонтрагентИНН}</QueryText>
				<MainTable>InformationRegister.КонтурМаркировка_ДопРеквизиты</MainTable>
				<GetInvisibleFieldPresentations>false</GetInvisibleFieldPresentations>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>ДатаДокумента</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
				</ListSettings>
			</Settings>
		</Attribute>
