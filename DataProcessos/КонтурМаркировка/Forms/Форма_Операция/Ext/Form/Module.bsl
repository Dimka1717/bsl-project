&НаСервере
Процедура ЗаполнитьКодСтраныПолучателя()
	
	Если ТипОтгрузки = МодульОбъекта().Перечисление_ТипыОтгрузок().ТрансграничнаяТорговля Тогда
		ДопустимыеСтраны = МодульОбъекта().ДопустимыеСтраныДляСообщенияОбОтгрузке(ВидПродукции);
		Если ДопустимыеСтраны.Количество() = 1 Тогда
			КодСтраныПолучателя = ДопустимыеСтраны[0].Значение;
			Модифицированность = Истина;
		КонецЕсли;
	Иначе
		КодСтраныПолучателя = "";
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

