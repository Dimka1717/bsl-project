	КоличествоСтрокТовары = Товары.Количество();
	КоличествоСтрокКодыВходящегоУПД = КодыВходящегоУПД.ПолучитьЭлементы().Количество();
	КоличествоСтрокЛишниеКодыВходящегоУПД = ЛишниеКодыВходящегоУПД.Количество();
	КоличествоКодов = МодульОбъекта().КодыОпераций_ОбщееКоличествоКодов(Ссылка);
	
