// Отчет о нанесении

// Ввод в оборот

&НаСервере
Функция ДопускаетсяУказаниеДатыПроизводстваВоВводеВОборот()
	
	Если Не МодульОбъекта().ВидПродукцииДопускаетДатуПроизводстваПриВводеВОборот(ВидПродукции) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВидыПродукции = МодульОбъекта().Перечисление_ВидыПродукции();
	СпособыВвода = МодульОбъекта().Перечисление_СпособыВводаВОборот();
	
	Если СпособВводаВОборот = СпособыВвода.ПроизводствоРФ Тогда
		Результат = Истина;
	ИначеЕсли СпособВводаВОборот = СпособыВвода.ИмпортФТС Тогда
		Результат = (ВидПродукции = ВидыПродукции.Молоко);
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ВидПродукцииДопускаетУказаниеПлощадкиПоТипуОперации()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	ВидыПродукции = МодульОбъекта().Перечисление_ВидыПродукции();
	
	ПодходящиеВидыПродукции = Новый Массив;
	
	Если ТипОперации = ТипыОпераций.ВводВОборот Тогда
		ПодходящиеВидыПродукции.Добавить(ВидыПродукции.Пиво);
	ИначеЕсли МодульОбъекта().ЭтоОтчетОНанесении(ТипОперации) Тогда
		ПодходящиеВидыПродукции.Добавить(ВидыПродукции.Пиво);
		ПодходящиеВидыПродукции.Добавить(ВидыПродукции.Бады);
		ПодходящиеВидыПродукции.Добавить(ВидыПродукции.БезалкогольныеНапитки);
		ПодходящиеВидыПродукции.Добавить(ВидыПродукции.БезалкогольноеПиво);
		ПодходящиеВидыПродукции.Добавить(ВидыПродукции.СтроительныеМатериалы);
	ИначеЕсли ТипОперации = ТипыОпераций.ВыводИзОборота Тогда
		
		Для каждого ВидПродукцииСПлощадкой Из МодульОбъекта().ДопустимыеВидыПродукцииДляПлощадок() Цикл
			
			Если ВидПродукцииСПлощадкой = ВидыПродукции.Пиво Тогда
				Если ПричинаВыводаИзОборотаДляПиваДопускаетПлощадку() Тогда
					ПодходящиеВидыПродукции.Добавить(ВидПродукцииСПлощадкой);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			
			ПодходящиеВидыПродукции.Добавить(ВидПродукцииСПлощадкой);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Результат = Ложь;
	Если ПодходящиеВидыПродукции.Найти(ВидПродукции) <> Неопределено Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПричинаВыводаИзОборотаДляПиваДопускаетПлощадку()
	
	ПричиныВыводаИзОборота = МодульОбъекта().Перечисление_ПричиныВыводаИзОборота();
	
	НеПодходящиеПричины = Новый Массив;
	НеПодходящиеПричины.Добавить(ПричиныВыводаИзОборота.ПродажаПоГосКонтракту);
	
	Возврат Не МодульОбъекта().МассивСодержитЗначение(НеПодходящиеПричины, ПричинаВыводаИзОборота);
	
КонецФункции

