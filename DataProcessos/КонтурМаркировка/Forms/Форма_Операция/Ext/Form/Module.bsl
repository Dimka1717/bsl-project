&НаКлиенте
Процедура АгрегатыПередНачаломИзменения(Элемент, Отказ)
	
	ТекДанные = Элемент.ТекущиеДанные;
	ТекЭлемент = Элемент.ТекущийЭлемент;
	ЭтоАгрегат = ЗначениеЗаполнено(ТекДанные.ВидАгрегата);
	
	Если ЭтоАгрегат Тогда
		Если ТекЭлемент = Элементы.АгрегатыКоличествоКодов Тогда
			Отказ = Истина; // Нельзя изменять количество упаковок на уровне агрегатов
		КонецЕсли;
	Иначе
		Если ТекЭлемент = Элементы.АгрегатыКоличествоАгрегатов Тогда
			Отказ = Истина; // Нельзя изменять количество агрегатов на уровне товаров
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

