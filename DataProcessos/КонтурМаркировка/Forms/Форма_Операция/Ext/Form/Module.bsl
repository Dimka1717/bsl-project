&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Стр = Элемент.ДанныеСтроки(ВыбраннаяСтрока);
	
	ВидыПродукции = МодульКлиента().Перечисление_ВидыПродукции();
	
	Если Поле = Элементы.ТоварыОперация Тогда
		ОткрытьФормуПодчиненнойОперацииНаУровнеСтроки(Элемент, ВыбраннаяСтрока);
	КонецЕсли;
	
	Если Поле = Элементы.ТоварыКоличество И Стр.ЭтоКег И Не ТолькоПросмотр Тогда
		Если МодульКлиента().ЭтоОтчетОНанесении(ТипОперации)
			И МодульКлиента().ВидПродукцииТребуетУказатьОбъемВОтчетеОНанесении(ВидПродукции) Тогда
			СтандартнаяОбработка = Ложь;
			ОткрытьРедакторОбъемаКодов(Стр);
		КонецЕсли;
	КонецЕсли;
	
	Если Поле = Элементы.ТоварыКоличествоЗСН И Не ТолькоПросмотр Тогда
		СтандартнаяОбработка = Ложь;
		Если Стр.ТребуетсяЗСН Тогда
			ОткрытьРедакторЗаводскихСерийныхНомеров(Стр);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Не ТолькоПросмотр Тогда
		ЭтоАльтСрок = (Поле = Элементы.ТоварыАльтернативныйСрокГодности
		Или Поле = Элементы.ТоварыКорректировкаВариативныйСрокГодности);
		Если ЭтоАльтСрок Тогда
			СтандартнаяОбработка = Ложь;
			ОткрытьРедакторАльтСроковГодности(Стр);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ТолькоПросмотр Или Поле.ТолькоПросмотр Тогда
		ЭтоТовар = (Поле = Элементы.ТоварыТовар И ЗначениеЗаполнено(Стр.Товар));
		Если ЭтоТовар Тогда
			МодульКлиента().ОткрытьФормуТовара(Стр.Товар, ЭтаФорма);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

