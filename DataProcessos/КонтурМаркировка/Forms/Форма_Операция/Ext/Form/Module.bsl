	СохранитьОперацию();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Операция", Ссылка);
	ПараметрыФормы.Вставить("ТипОперации", ТипОперации);
	
	МодульКлиента().ОткрытьФормуОбработкиМодально("Форма_РедакторКодов", ЭтаФорма, ПараметрыФормы);
	
КонецПроцедуры

