КонецПроцедуры

&НаКлиенте
Процедура ВидАгрегатаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(ВидАгрегата) Тогда
		МодульКлиента().ОткрытьФормуВидаАгрегата(ВидАгрегата, ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьАгрегаты(Команда)
	
	Если Модифицированность Тогда
		СохранитьОперацию();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		ТекстОшибки = НСтр("ru = 'Необходимо выбрать вид продукции'");
		МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "ВидПродукции");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ВидАгрегата) Тогда
		ТекстОшибки = НСтр("ru = 'Необходимо выбрать вид агрегата'");
		МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "ВидАгрегата");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(КоличествоАгрегатов) Тогда
		ТекстОшибки = НСтр("ru = 'Необходимо указать количество агрегатов'");
		МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "КоличествоАгрегатов");
		Возврат;
	КонецЕсли;
	
	СтрокиДерева = Агрегаты.ПолучитьЭлементы();
	СтрокиДерева.Очистить();
	Стр = СтрокиДерева.Добавить();
	Стр.КоличествоАгрегатов = КоличествоАгрегатов;
	Стр.ВидАгрегата = ВидАгрегата;
	
	СоздатьТранспортныеУпаковки();
	
КонецПроцедуры

&НаКлиенте
Процедура Агрегаты_Создать(Команда)
	
	СоздатьАгрегаты();
	
КонецПроцедуры

&НаКлиенте
Функция СоздатьАгрегаты()
	
	Если Не АгрегатыСозданы() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		Оповестить("КонтурМаркировка_КодыВДокументах_Изменен", ДокументУчета);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция АгрегатыСозданы()
	
	Если Товары.Итог("КоличествоКодов") = 0 Тогда
		ПодобратьКодыДляАгрегации();
	КонецЕсли;
	
	Результат = Ложь;
	
	Если Не СозданиеАгрегатов_ЕстьОшибки() Тогда
		СоздатьТранспортныеУпаковки();
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура СоздатьТранспортныеУпаковки()
	
	Если Не ПроверитьНаличиеСерийныхНомеровДляНовыхАгрегатов() Тогда
		Возврат;
	КонецЕсли;
	
	ДеревоУпаковок = РеквизитФормыВЗначение("Агрегаты");
	
	НачатьТранзакцию(МодульОбъекта().РежимУправленияБлокировкой());
	Попытка
		МодульОбъекта().Операция_СоздатьИЗаполнитьТранспортныеУпаковки(ДеревоУпаковок, Ссылка);
		ОсновнойСтатус = МодульОбъекта().Перечисление_СтатусыОпераций().СозданыАгрегаты;
		МодульОбъекта().СтатусыОперации_ЗаписатьОсновнойСтатус(Ссылка, ОсновнойСтатус);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	ПосчитатьКоличествоСтрокТаблицФормы();
	
	НастроитьЭлементыФормы();
	
КонецПроцедуры

&НаСервере
Процедура НаполнитьКИГу()
	
	НачатьТранзакцию(МодульОбъекта().РежимУправленияБлокировкой());
	Попытка
		МодульОбъекта().Операция_ЗаполнитьГрупповыеУпаковки(Ссылка, ДокументУчета);
		ОсновнойСтатус = МодульОбъекта().Перечисление_СтатусыОпераций().КИГУНаполнены;
		МодульОбъекта().СтатусыОперации_ЗаписатьОсновнойСтатус(Ссылка, ОсновнойСтатус);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	МодульОбъекта().Метрика_Функциональность_НаполнениеКИГу(Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипУчастникаВводящегоВОборотПриИзменении(Элемент)
	
	ПроизводительИНН = "";
	СобственникТовараИНН = "";
	
	ЗаполнитьИННПроизводителяИСобственникаТовара();
	
КонецПроцедуры

&НаСервере
Функция Упаковки_ПолучитьСписокВидовАгрегатов()
	
	ВсеВидыАгрегатов = МодульОбъекта().ВидыАгрегатов_ВсеСсылки(Организация);
	
	Результат = Новый СписокЗначений;
	Результат.ЗагрузитьЗначения(ВсеВидыАгрегатов);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьАгрегат(Команда)
	
	СписокВидовАгрегатов = Упаковки_ПолучитьСписокВидовАгрегатов();
	Если Не ЗначениеЗаполнено(СписокВидовАгрегатов) Тогда
		ТекстПредупреждения = НСтр("ru = 'Необходимо заполнить справочник ""Виды агрегатов""'");
		МодульКлиента().ПоказатьДиалогПредупреждения(ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
	"ДобавитьАгрегатПослеВыбораВидаАгрегата", ЭтаФорма);
	
	МодульКлиента().ПоказатьДиалогВыбораИзСписка(ОписаниеОбработчика
	, СписокВидовАгрегатов
	, Элементы.Кнопка_ДобавитьАгрегат
	, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте 
Процедура ДобавитьАгрегатПослеВыбораВидаАгрегата(РезультатВыбора, ДопПараметр = Неопределено) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.Агрегаты.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Стр = Агрегаты.ПолучитьЭлементы().Добавить();
	Иначе
		Стр = ТекущиеДанные.ПолучитьЭлементы().Добавить();
		Элементы.Агрегаты.Развернуть(ТекущиеДанные.ПолучитьИдентификатор());
	КонецЕсли;
	
	Стр.НомерКартинки = 1;
	Стр.КоличествоАгрегатов = 1;
	Стр.ВидАгрегата = РезультатВыбора.Значение;
	
КонецПроцедуры

