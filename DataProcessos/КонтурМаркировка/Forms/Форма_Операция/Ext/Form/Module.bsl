	Если Не МодульКлиента().ВыполнитьАвторизацию(Организация, ЭтаФорма) Тогда
		Возврат;
	КонецЕсли;
	
	ЗапуститьОбновлениеСтатусовКодов();
	
	ОбновитьСтатусыКодов();
	
КонецПроцедуры

&НаСервере
Процедура ЗапуститьОбновлениеСтатусовКодов()
	
	МодульОбъекта().ЗапуститьОбновлениеСтатусовКодовОперации(Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусыКодов() Экспорт
	
	ОбновитьСписокКодовМаркировки();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокКодовМаркировки()
	
	Элементы.КодыМаркировки.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументУчетаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	МодульКлиента().ОткрытьФормуДокументаУчета(ДокументУчета, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеталиОшибкиНажатие(Элемент)
	
	Элементы.ПанельЗакладок.ТекущаяСтраница = Элементы.ЗакладкаОсновная;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПодсказкуФормы()
	
	Подсказки = Новый Массив;
	Подсказки.Добавить(ПодсказкаПередачиКодовСервисПровайдеру());
	Подсказки.Добавить(ПодсказкаРегистрацииОтчетаОНанесенииВГИС());
	Подсказки.Добавить(ПодсказкаРегистрацииОтчетаОВыбытииВГИС());
	Подсказки.Добавить(ПодсказкаРегистрацииФормированияНаборовВГИС());
	Подсказки.Добавить(ПодсказкаПечати());
	Подсказки.Добавить(ПодсказкаВыполняетсяОбновлениеДанных());
	Подсказки.Добавить(ПодсказкаЗаказКодовНаборовНаОстатки());
	Подсказки.Добавить(ПодсказкаВыводИЗОборотаОСУВес());
	Подсказки.Добавить(ПодсказкаКорректировкаСведенийОКодах());
	Подсказки.Добавить(ПодсказкаПартионныйУчет());
	Подсказки.Добавить(ПодсказкаАвтоподборПозицииНаТСД());
	Подсказки.Добавить(ПодсказкаУведомлениеОСостоянииКодов());
	
	Разделитель = "";
	ОбщийТекстПодсказки = "";
	Для Каждого ТекстПодсказки Из Подсказки Цикл
		Если ЗначениеЗаполнено(ТекстПодсказки) Тогда
			ОбщийТекстПодсказки = ОбщийТекстПодсказки + Разделитель + ТекстПодсказки;
			Разделитель = Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.ТекстПодсказки.Заголовок = ОбщийТекстПодсказки;
	Элементы.ГруппаПодсказки.Видимость = ЗначениеЗаполнено(ОбщийТекстПодсказки);
	Элементы.СсылкаПодсказки.Видимость = ЗначениеЗаполнено(ПодсказкаАвтоподборПозицииНаТСД());
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПодсказкуЭлементаФормы(Элемент, ТекстПодсказки, ВариантОтображения = Неопределено)
	
	Элемент.Подсказка = ТекстПодсказки;
	Если Не МодульОбъекта().ВерсияПлатформыНиже("8.3") И ЗначениеЗаполнено(ВариантОтображения) Тогда
		Выполнить("Элемент.ОтображениеПодсказки = ОтображениеПодсказки[ВариантОтображения]");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПодсказкаПечати()
	
	Результат = "";
	
	Если ТипОперации = МодульКлиента().Перечисление_ТипыОпераций().ПечатьКодов Тогда
		Результат = НСтр("ru = 'Напечатанные коды нельзя подобрать в документ учета со свободного остатка'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПодсказкаПередачиКодовСервисПровайдеру()
	
	Результат = "";
	ТипыОпераций = МодульКлиента().Перечисление_ТипыОпераций();
	
	Если ТипОперации = ТипыОпераций.ЗаказКодов И ЗаказКодовДляСервисПровайдера Тогда
		
		Результат = НСтр("ru = 'Коды маркировки будут переданы сервис-провайдеру.'");
		
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			Результат = Результат + Символы.ПС + НСтр(
			"ru = 'Чтобы добавить коды в документ, необходимо сканировать их с этикеток в ""Отчет о нанесении"".'");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПодсказкаРегистрацииОтчетаОНанесенииВГИС()
	
	Результат = "";
	ТипыОпераций = МодульКлиента().Перечисление_ТипыОпераций();
	СтатусыОпераций = МодульКлиента().Перечисление_СтатусыОпераций();
	
	Если ТипОперации = ТипыОпераций.ОтчетОНанесенииНаТСД Тогда
		Результат = НСтр("ru = 'После наполнения на ТСД, отчет автоматически отправляется на регистрацию в ГИС МТ.'");
		Если ОсновнойСтатус = СтатусыОпераций.ОжиданиеЗавершенияИзменений Тогда
			Результат = НСтр(
			"ru = 'Задание на ТСД можно продолжить наполнять, но для отправки отчета в ГИС МТ необходимо завершить редактирование.'");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПодсказкаЧастичноПринятогоОтчетаОНанесении()
	
	Результат = "";
	ТипыОпераций    = МодульОбъекта().Перечисление_ТипыОпераций();
	СтатусыОпераций = МодульОбъекта().Перечисление_СтатусыОпераций();
	
	Если ОсновнойСтатус = СтатусыОпераций.ПринятЧастично Тогда
		
		Если ТипОперации = ТипыОпераций.ОтчетОНанесении Тогда
			Результат = НСтр("ru = 'Для регистрации непринятых кодов создайте новый отчет о нанесении.'");
		КонецЕсли;
		
		Если ТипОперации = ТипыОпераций.ОтчетОНанесенииНаТСД Тогда
			Результат = НСтр("ru = 'Для регистрации непринятых кодов создайте новый отчет о нанесении без отправки на ТСД.'");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

