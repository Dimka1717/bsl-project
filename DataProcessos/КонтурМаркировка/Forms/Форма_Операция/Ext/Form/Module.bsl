
&НаКлиенте
Перем КэшМодуляКлиента;

&НаКлиенте
Перем КэшТоваров;

&НаСервере
Функция МодульОбъекта() Экспорт
	
	Возврат ВзаимодействиеКонтурМаркировка.МодульКонтурМаркировка();
	
КонецФункции

&НаКлиенте
Функция МодульКлиента() Экспорт
	
	Если КэшМодуляКлиента <> Неопределено Тогда
		Возврат КэшМодуляКлиента;
	КонецЕсли;
	
	Если ТипЗнч(ВладелецФормы) = ТипЗнч(ЭтаФорма) Тогда
		Результат = ВладелецФормы.МодульКлиента();
	Иначе
		ПутьКФорме = ПутьКФормеМодуляКлиента();
		Результат = ОткрытьФорму(ПутьКФорме);
	КонецЕсли;
	
	КэшМодуляКлиента = Результат;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПутьКФормеМодуляКлиента()
	
	Возврат МодульОбъекта().ПутьКФормеМодуляКлиента();
	
КонецФункции

// #Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Ссылка", Ссылка);
	Параметры.Свойство("ТипОперации", ТипОперации);
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение НСтр("ru = 'Не указана ссылка на операцию!'");
	КонецЕсли;
	
	ЗаполнитьКонтекстФормы();
	ЗаполнитьПараметрыПечатиЭтикетокПоШаблону();
	НастроитьКнопки();
	УстановитьУсловноеОформление();
	ЗаполнитьСпискиВыбора();
	НастроитьСписокКодыМаркировки();
	
	ОбновитьПризнакОперацияОграниченаТарифом();
	НастроитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьПодсказкуФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	МодульКлиента().СохранитьИзмененияНаФорме("ЗаписатьИЗакрыть", ЭтаФорма, Отказ, ЗавершениеРаботы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурМаркировка_ОбработаныКодыВРедакторе" Тогда
		
		ЗаполнитьКонтекстФормыИУстановитьВидимость();
		СохранитьОперацию();
		Оповестить("КонтурМаркировка_Операция_Изменен", ДокументУчета);
		
		Если ТребуетсяЗакрытьОперациюПослеРедактированияКодов(Параметр) Тогда
			Закрыть();
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИмяСобытия = "КонтурМаркировка_Товар_Изменен" Тогда
		Если ТипОперации = МодульКлиента().Перечисление_ТипыОпераций().УведомлениеОПриемке Тогда
			СведенияОТоварах_ДополнитьДаннымиТоваров();
			Модифицированность = Истина;
		КонецЕсли
	КонецЕсли;
	
	Если ИмяСобытия = "КонтурМаркировка_КодыВыгружены" Тогда
		Если Параметр = Ссылка Тогда
			УстановитьСтатусКодыВыгружены();
			НастроитьЭлементыФормы();
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяСобытия = "КонтурМаркировка_ШаблонЭтикетки_Изменен" Тогда
		Если Параметр = ШаблонТоварнойЭтикетки
			Или Параметр = ШаблонГрупповойЭтикетки
			Или Параметр = ШаблонТранспортнойЭтикетки Тогда
			ЗаполнитьПараметрыПечатиЭтикетокПоШаблону();
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяСобытия = "КонтурМаркировка_ИзмененРежимТехническогоСпециалиста" Тогда
		НастроитьЭлементыФормы_РежимТехническогоСпециалиста(Параметр);
	КонецЕсли;
	
	Если ИмяСобытия = "КонтурМаркировка_СменитьВладельца" И Источник = ВладелецФормы Тогда
		ВладелецФормы = Параметр;
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти

&НаСервере
Процедура НастроитьКнопки()
	
	СформироватьДополнительныеКнопки();
	ПоказатьКнопкиПоискаДля82();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКонтекстФормы(Знач ОписаниеОперации = Неопределено)
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	ДопСвойства = МодульОбъекта().Перечисление_ДопСвойства();
	
	Если ОписаниеОперации = Неопределено Тогда
		ОписаниеОперации = МодульОбъекта().Операция_ПрочитатьОперацию(Ссылка);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ОписаниеОперации, , "Товары");
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ОписаниеОперации.ДопРеквизиты);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, МодульОбъекта().Операция_СтатусыОперации(Ссылка));
	
	ЗаполнитьТовары(ОписаниеОперации);
	
	Если ТипОперации = ТипыОпераций.ВходящийУПД Тогда
		ЗаполнитьКодыВходящегоУПД(ОписаниеОперации);
	КонецЕсли;
	
	Если ТипОперации = ТипыОпераций.УведомлениеОПриемке Тогда
		ЗаполнитьСведенияОТоварах(ОписаниеОперации);
	КонецЕсли;
	
	Если ТипОперации = ТипыОпераций.ПодборКодовНаТСД
		Или ТипОперации = ТипыОпераций.ПодборТоваровИКодовНаТСД Тогда
		Элементы.СсылкаКонтрагентИННКПП.Заголовок = Заголовок_ИННКПП();
		Если ПодборСПомощьюМобильногоУстройства Тогда
			Элементы.СсылкаИнформацияОДоставке.Заголовок = Заголовок_ИнформацияОДоставке();
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КлючКода)
		И Не ЗначениеЗаполнено(КодМаркировки) Тогда
		КодМаркировки = МодульОбъекта().КодМаркировки_НайтиПоКлючу(КлючКода);
	КонецЕсли;
	
	ОписаниеОшибки = "";
	ОписаниеЗадачи = МодульОбъекта().Задача_Прочитать(Ссылка);
	Если ЗначениеЗаполнено(ОписаниеЗадачи) Тогда
		
		ОписаниеОшибки = ОписаниеЗадачи.ДопРеквизиты.КраткоеОписаниеОшибки;
		Если Не ЗначениеЗаполнено(ОписаниеОшибки) Тогда
			ОписаниеОшибки = ОписаниеЗадачи.ОписаниеОшибки;
		КонецЕсли;
		
		ПодсказкаЧастичноПринятогоОтчетаОНанесении = ПодсказкаЧастичноПринятогоОтчетаОНанесении();
		Если ЗначениеЗаполнено(ПодсказкаЧастичноПринятогоОтчетаОНанесении) Тогда
			ОписаниеОшибки = ПодсказкаЧастичноПринятогоОтчетаОНанесении + Символы.ПС + Символы.ПС + ОписаниеОшибки;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОписаниеЗадачи.ИдентификаторДокумента) Тогда
			ИдентификаторДокумента = ОписаниеЗадачи.ИдентификаторДокумента;
		КонецЕсли;
		
	КонецЕсли;
	
	ПечатьИзСвободногоОстатка = МодульОбъекта().Операция_ЭтоПечатьИзСвободногоОстатка(ОписаниеОперации);
	ВыполняетсяОбновлениеДанных = МодульОбъекта().ОбъектВПроцессеОбновления(Ссылка);
	
	Если ЗначениеЗаполнено(СервисПровайдер) Тогда
		ЗаказКодовДляСервисПровайдера = 1;
	КонецЕсли;
	
	Подписант = МодульОбъекта().ДопСвойство_Прочитать(Ссылка, ДопСвойства.Подписант);
	Сертификат = МодульОбъекта().ДопСвойство_Прочитать(Ссылка, ДопСвойства.Сертификат);
	
	ПосчитатьКоличествоСтрокТаблицФормы();
	ЗаполнитьКоличествоКодовВТоварах();
	
	Модифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКонтекстФормыИУстановитьВидимость()
	
	ЗаполнитьКонтекстФормы();
	НастроитьЭлементыФормы();
	
КонецПроцедуры

&НаСервере
Функция ОписаниеОперацииПоКонтекстуФормы()
	
	Результат = МодульОбъекта().Новый_Операция();
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	
	ЗаполнитьЗначенияСвойств(Результат, ЭтаФорма, , "Товары");
	ЗаполнитьЗначенияСвойств(Результат.ДопРеквизиты, ЭтаФорма);
	ЗаполнитьЗначенияСвойств(Результат.Статусы, ЭтаФорма);
	
	Если ТипОперации = ТипыОпераций.ПечатьКодов Тогда
		
		Стр = Результат.Товары.Добавить();
		Стр.НомерСтроки = 1;
		Стр.Товар = Товар;
		Стр.КлючНоменклатуры1С = КлючНоменклатуры1С;
		Стр.КоличествоУпаковок = КоличествоКодовТребуется;
		
	ИначеЕсли МодульОбъекта().ЭтоОтчетОНанесении(ТипОперации) Или ЭтоКорректировкаВариативногоСрокаГодности() Тогда
		
		Для Каждого СтрТов Из Товары Цикл
			Стр = Результат.Товары.Добавить();
			Стр.НомерСтроки = Товары.Индекс(СтрТов) + 1;
			ЗаполнитьЗначенияСвойств(Стр, СтрТов);
			Стр.АльтернативныеСрокиГодности = АльтСрокиГодностиТовара(ЭтаФорма, СтрТов.КлючСтрокиОперации);
		КонецЦикла;
		
	Иначе
		
		Для Каждого СтрТов Из Товары Цикл
			Стр = Результат.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(Стр, СтрТов);
			Стр.НомерСтроки = Товары.Индекс(СтрТов) + 1;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЭтоКорректировкаВариативногоСрокаГодности()
	
	Результат = Ложь;
	
	Если ТипОперации = МодульОбъекта().Перечисление_ТипыОпераций().КорректировкаСведенийОКодах
		И ВидКорректируемыхСведений = МодульОбъекта().Перечисление_ВидыКорректируемыхСведений().ВариативныйСрокГодности Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТовары(ОписаниеОперации)
	
	Товары.Очистить();
	АльтернативныеСрокиГодности.Очистить();
	
	ТипыСрокаГодности = МодульОбъекта().Перечисление_ТипыСроковГодности();
	ВидыСведений = МодульОбъекта().Перечисление_ВидыКорректируемыхСведений();
	
	Если ТипОперации = МодульОбъекта().Перечисление_ТипыОпераций().ПечатьКодов Тогда
		Если ЗначениеЗаполнено(ОписаниеОперации.Товары) Тогда
			СтрТовара = ОписаниеОперации.Товары[0];
			Товар = СтрТовара.Товар;
			КлючНоменклатуры1С = СтрТовара.КлючНоменклатуры1С;
			КоличествоКодовТребуется = СтрТовара.КоличествоУпаковок;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Для каждого СтрТовара Из ОписаниеОперации.Товары Цикл
		
		Стр = Товары.Добавить();
		Стр.Товар = СтрТовара.Товар;
		ЗаполнитьСтрокуТоваровДаннымиИБ(Стр);
		ЗаполнитьЗначенияСвойств(Стр, СтрТовара);
		ЗаполнитьПризнакПодлежитВетеринарномуКонтролю(Стр);
		
		УказатьСрокГодностиВариативно = (ЗначениеЗаполнено(СтрТовара.АльтернативныеСрокиГодности)
		И (ТипСрокаГодности = ТипыСрокаГодности.СрокГодностиБольше72СУсловием
		Или ВидКорректируемыхСведений = ВидыСведений.ВариативныйСрокГодности));
		
		Если УказатьСрокГодностиВариативно Тогда
			
			Стр.АльтернативныйСрокГодности = НСтр("ru = 'Вариативно'");
			
			Для Каждого АльтСрок Из СтрТовара.АльтернативныеСрокиГодности Цикл
				НоваяСтрока = АльтернативныеСрокиГодности.Добавить();
				НоваяСтрока.Тип = АльтСрок.Ключ;
				НоваяСтрока.ДатаСрокаГодности = АльтСрок.Значение;
				НоваяСтрока.КлючСтрокиОперации = Стр.КлючСтрокиОперации;
			КонецЦикла;
			
			ОбновитьПризнакЗаполненияАльтернативныхСроковГодности(ЭтаФорма, Стр);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьПодчиненныеОперации();
	ЗаполнитьКоличествоЗаводскихСерийныхНомеров();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПризнакПодлежитВетеринарномуКонтролю(Стр)
	
	Стр.ПодлежитВетеринарномуКонтролю = Неопределено;
	
	Если ЗначениеЗаполнено(Стр.Товар) Тогда
		ОписаниеТовара = МодульОбъекта().Товар_Прочитать(Стр.Товар);
		Стр.ПодлежитВетеринарномуКонтролю = ОписаниеТовара.ПодлежитВетеринарномуКонтролю;
		Возврат;
	КонецЕсли;
	
	Если МодульОбъекта().Операция_ТоварыВАгрегатахТребуютВСД(Ссылка, Стр.КлючСтрокиОперации) Тогда
		Стр.ПодлежитВетеринарномуКонтролю = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодчиненныеОперации()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	ТипыСтатусов = МодульОбъекта().Перечисление_ТипыСтатусов();
	
	ПодходящиеОперации = Новый Массив;
	ПодходящиеОперации.Добавить(ТипыОпераций.ОтчетОНанесении);
	ПодходящиеОперации.Добавить(ТипыОпераций.ОтчетОНанесенииНаТСД);
	ПодходящиеОперации.Добавить(ТипыОпераций.ВводВОборот);
	ПодходящиеОперации.Добавить(ТипыОпераций.ЗаказКодов);
	ПодходящиеОперации.Добавить(ТипыОпераций.РегистрацияНаборов);
	ПодходящиеОперации.Добавить(ТипыОпераций.КорректировкаСведенийОКодах);
	ПодходящиеОперации.Добавить(ТипыОпераций.Перемаркировка);
	ПодходящиеОперации.Добавить(ТипыОпераций.РегистрацияКИГУ);
	ПодходящиеОперации.Добавить(ТипыОпераций.УведомлениеОСостоянииКодов);
	
	Если Не МодульОбъекта().МассивСодержитЗначение(ПодходящиеОперации, ТипОперации) Тогда
		Возврат;
	КонецЕсли;
	
	КлючиСтрокОперации = Товары.Выгрузить(,"КлючСтрокиОперации").ВыгрузитьКолонку("КлючСтрокиОперации");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ПодчиненныеОперации.Ссылка КАК Операция,
	|	ПодчиненныеОперации.КлючСтрокиОперацииОснования КАК КлючСтрокиОперации,
	|	СтатусыОпераций.Статус КАК Статус
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК ПодчиненныеОперации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК СтатусыОпераций
	|		ПО (ПодчиненныеОперации.Ссылка = СтатусыОпераций.Операция)
	|			И (СтатусыОпераций.ТипСтатуса = &ОсновнойСтатус)
	|ГДЕ
	|	ПодчиненныеОперации.ОперацияОснование = &Ссылка
	|	И ПодчиненныеОперации.КлючСтрокиОперацииОснования В(&КлючиСтрокОперации)");
	Запрос.УстановитьПараметр("КлючиСтрокОперации", КлючиСтрокОперации);
	Запрос.УстановитьПараметр("ОсновнойСтатус", ТипыСтатусов.ОсновнойСтатус);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	СтатусыПодчиненныхОпераций = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрТовара Из Товары Цикл
		СтрОперации = СтатусыПодчиненныхОпераций.Найти(СтрТовара.КлючСтрокиОперации, "КлючСтрокиОперации");
		Если СтрОперации <> Неопределено Тогда
			СтрТовара.Операция = СтрОперации.Операция;
			СтрТовара.ОперацияСтатус = СтрОперации.Статус;
			СтрТовара.ОперацияИндексКартинки = ИндексКартинкиСтатусаПодчиненнойОперации(СтрОперации.Статус);
		Иначе
			СтрТовара.ОперацияИндексКартинки = -1;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКоличествоЗаводскихСерийныхНомеров()
	
	Если ТипОперации <> МодульОбъекта().Перечисление_ТипыОпераций().ОтчетОНанесении Тогда
		Возврат;
	КонецЕсли;
	Если Не Товары_ТребуютсяЗаводскиеСерийныеНомера() Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрДок Из Товары Цикл
		СтрДок.КоличествоЗСН = 0;
	КонецЦикла;
	
	Отбор = Новый Структура("КлючСтрокиОперации");
	Для каждого СтрЗСН Из МодульОбъекта().КодыОпераций_КоличествоЗаводскихСерийныхНомеров(Ссылка) Цикл
		Отбор.КлючСтрокиОперации = СтрЗСН.КлючСтрокиОперации;
		Для каждого СтрТовара Из Товары.НайтиСтроки(Отбор) Цикл
			СтрТовара.КоличествоЗСН = СтрЗСН.КоличествоЗСН;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ИндексКартинкиСтатусаПодчиненнойОперации(Статус)
	
	СтатусыОпераций = МодульОбъекта().Перечисление_СтатусыОпераций();
	
	Если Не ЗначениеЗаполнено(Статус) Тогда
		ИндексКартинки = -1;
	ИначеЕсли Статус = СтатусыОпераций.Новый Тогда
		ИндексКартинки = 0;
	ИначеЕсли Статус = СтатусыОпераций.ОперацияЗавершена
		Или Статус = СтатусыОпераций.ПринятЧастично Тогда
		ИндексКартинки = 4;
	ИначеЕсли Статус = СтатусыОпераций.ОшибкаОбработки Тогда
		ИндексКартинки = 2;
	ИначеЕсли Статус = СтатусыОпераций.НеУдалосьРаспознатьКоды Тогда
		ИндексКартинки = 3;
	Иначе
		ИндексКартинки = 3;
	КонецЕсли;
	
	Возврат ИндексКартинки;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьКодыВходящегоУПД(Операция)
	
	РезультатСверки = МодульОбъекта().Операция_ВходящийУПД_РезультатСверки(Операция);
	КоллекцияСтрок = КодыВходящегоУПД.ПолучитьЭлементы();
	
	Для каждого Стр Из РезультатСверки.КодыДокумента Цикл
		
		НоваяСтрока = КоллекцияСтрок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		
		СтрокиКодов = НоваяСтрока.ПолучитьЭлементы();
		
		Если ЗначениеЗаполнено(Стр.КодОСУ) Тогда
			СтрОСУ = СтрокиКодов.Добавить();
			СтрОСУ.КодМаркировки = Стр.КодОСУ;
			ЗаполнитьКодыВходящегоУПД_ЗаполнитьСтрокиКодов(СтрОСУ.ПолучитьЭлементы(), Стр.КодыМаркировкиПоОСУ);
			ЗаполнитьКодыВходящегоУПД_ЗаполнитьКартинки(СтрОСУ);
		КонецЕсли;
		
		ЗаполнитьКодыВходящегоУПД_ЗаполнитьСтрокиКодов(СтрокиКодов, Стр.КодыМаркировки);
		ЗаполнитьКодыВходящегоУПД_ЗаполнитьКартинки(НоваяСтрока);
		
	КонецЦикла;
	
	Для каждого ЛишнийКод Из РезультатСверки.ЛишниеКоды Цикл
		НоваяСтрока = ЛишниеКодыВходящегоУПД.Добавить();
		НоваяСтрока.КодМаркировки = ЛишнийКод;
	КонецЦикла;
	
	УстановитьВидимостьОбщихИтоговВходящегоУПД(РезультатСверки);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКодыВходящегоУПД_ЗаполнитьСтрокиКодов(СтрокиКодов, КодыМаркировки)
	
	Для каждого Стр Из КодыМаркировки Цикл
		
		СтрКода = СтрокиКодов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрКода, Стр);
		ЗаполнитьКодыВходящегоУПД_ЗаполнитьКартинки(СтрКода);
		
		Если ЗначениеЗаполнено(Стр.ВложенныеКоды) Тогда
			ЗаполнитьКодыВходящегоУПД_ЗаполнитьСтрокиКодов(СтрКода.ПолучитьЭлементы(), Стр.ВложенныеКоды);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКодыВходящегоУПД_ЗаполнитьКартинки(СтрокаУПД)
	
	ЭтоСтрокаТовара = Не ЗначениеЗаполнено(СтрокаУПД.КодМаркировки);
	
	СтрокаУПД.КартинкаПринадлежитОтправителю = ЗаполнитьКодыВходящегоУПД_КартинкаПроверки(СтрокаУПД.ПринадлежитОтправителю);
	СтрокаУПД.КартинкаВведенВОборот = ЗаполнитьКодыВходящегоУПД_КартинкаПроверки(СтрокаУПД.ВведенВОборот);
	СтрокаУПД.КартинкаОтсканирован = ЗаполнитьКодыВходящегоУПД_КартинкаПроверки(СтрокаУПД.Отсканирован);
	СтрокаУПД.КартинкаЕстьДействующийРД = ЗаполнитьКодыВходящегоУПД_КартинкаПроверки(СтрокаУПД.ЕстьДействующийРД);
	
	Если ЭтоСтрокаТовара Тогда
		СтрокаУПД.КартинкаЕстьОшибкиВСтроке = ЗаполнитьКодыВходящегоУПД_КартинкаИтогов(СтрокаУПД);
		СтрокаУПД.КартинкаКорректныйФорматКода = -1;
	Иначе
		СтрокаУПД.КартинкаКорректныйФорматКода = ЗаполнитьКодыВходящегоУПД_КартинкаОшибки(СтрокаУПД.КорректныйФорматКода);
		СтрокаУПД.КартинкаЕстьОшибкиВСтроке = -1;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьКодыВходящегоУПД_КартинкаПроверки(Значение)
	
	Если Значение = Истина Тогда
		Результат = 4;
	ИначеЕсли Значение = Ложь Тогда
		Результат = 2;
	Иначе
		Результат = -1;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЗаполнитьКодыВходящегоУПД_КартинкаОшибки(Значение)
	
	Если Значение = Ложь Тогда
		Результат = 2;
	Иначе
		Результат = -1;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЗаполнитьКодыВходящегоУПД_КартинкаИтогов(СтрокаТоваров)
	
	Результат = -1;
	
	Если СтрокаТоваров.КодОСУВалидный = Ложь
		Или СтрокаТоваров.ЗарегистрированВГИСМТ = Ложь
		Или СтрокаТоваров.РазрешенаОтгрузкаПоОСУ = Ложь Тогда
		Результат = 2;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТоваров.КодовСОшибками) Тогда
		Результат = 2;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

