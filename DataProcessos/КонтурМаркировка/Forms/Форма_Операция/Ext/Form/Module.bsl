&НаСервере
Процедура НастроитьЭлементыФормы_УведомлениеОПриемке()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	Если ТипОперации <> ТипыОпераций.УведомлениеОПриемке Тогда
		Возврат;
	КонецЕсли;

	ТипыИсходныхОтгрузок = МодульОбъекта().Перечисление_ТипыИсходныхОтгрузок();
	СтатусыСверкиНаТСД = МодульОбъекта().Перечисление_СтатусыСверкиНаТСД();
	
	Элементы.Склад.Видимость = Ложь;
	Элементы.УведомлениеОПриемке.Видимость = Истина;
	Элементы.КонтрагентНаименованиеУведомлениеОПриемке.Видимость = ЗначениеЗаполнено(КонтрагентНаименование);
	Элементы.ЗакладкаСведенияОТоварах.Видимость = Истина;
	
	Если СтатусСверкиНаТСД = СтатусыСверкиНаТСД.СверкаНеПроизведена
		Или ТипИсходнойОтгрузки = ТипыИсходныхОтгрузок.ТрансграничнаяОтгрузкаОСУ Тогда
		Элементы.Кнопка_ПринятьЧастично.Доступность = Ложь;
	Иначе
		Элементы.Кнопка_ПринятьЧастично.Доступность = Истина;
	КонецЕсли;
	
	Если ТипИсходнойОтгрузки = ТипыИсходныхОтгрузок.ТрансграничнаяОтгрузкаОСУ Тогда
		Элементы.СведенияОТоварахКоличество.Видимость = Истина;
		Элементы.СведенияОТоварахКоличествоКИ.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормы_ВозвратВОборот()

	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	Если ТипОперации <> ТипыОпераций.ВозвратВОборот
		И ТипОперации <> ТипыОпераций.ВозвратВОборотНаТСД Тогда
		Возврат;
	КонецЕсли;
	
	СтатусыОпераций = МодульОбъекта().Перечисление_СтатусыОпераций();
	ПоказатьДокументСертификации = МодульОбъекта().ВидПродукцииДопускаетДокументСертификации(ВидПродукции);
	
	Элементы.ВозвратВОборот.Видимость = Истина;
	Элементы.ЗакладкаТовары.Видимость = Истина;
	
	Если ТипОперации = ТипыОпераций.ВозвратВОборотНаТСД
		И Не ЗначениеЗаполнено(ДокументУчета)
		И ОсновнойСтатус = СтатусыОпераций.Новый Тогда
		Элементы.Кнопка_ДобавитьТовар.Видимость = Истина;
	КонецЕсли;
	
	Если ТипОперации = ТипыОпераций.ВозвратВОборотНаТСД Тогда
		Элементы.ТоварыКоличествоУпаковок.Видимость = Истина;
	Иначе
		Элементы.ТоварыКоличествоКодов.Видимость = Истина;
	КонецЕсли;
	
	Элементы.ТоварыВозвратВОборот.Видимость = ПоказатьДокументСертификации;
	
	Элементы.ЗакладкаКодыМаркировки.Видимость = Истина;

КонецПроцедуры

