	ОбновитьРаспределенноеКоличествоУпаковок();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТоварВАгрегат(Команда)
	
	Поле = ЭтаФорма.Элементы.Агрегаты.ТекущийЭлемент;
	СтрокаПриемник = ЭтаФорма.Элементы.Агрегаты.ТекущаяСтрока;
	СтрокаИсточник = ЭтаФорма.Элементы.ТоварыАгрегатов.ТекущиеДанные;
	
	Если СтрокаПриемник = Неопределено
		Или СтрокаИсточник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Истина;
	Элемент = ЭтаФорма.Элементы.Агрегаты;
	
	ПараметрыПеретаскивания = Новый Структура;
	ПараметрыПеретаскивания.Вставить("Действие");
	ПараметрыПеретаскивания.Вставить("Значение", Новый Массив);
	ПараметрыПеретаскивания.Значение.Добавить(СтрокаИсточник);
	
	АгрегатыПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, СтрокаПриемник, Поле);
	
	Если ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	АгрегатыПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, СтрокаПриемник, Поле)
	
КонецПроцедуры

&НаКлиенте
Процедура АгрегатыПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыПеремещения = ПараметрыПеретаскиванияВУпаковку(ПараметрыПеретаскивания, Строка, Поле);
	
	Если Не ПараметрыПеремещения.ИсточникИзТоваров
		И Не ПараметрыПеремещения.ИсточникИзУпаковок Тогда
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
		// Источник должен быть из товаров или упаковок
		Возврат;
	КонецЕсли;
	
	Если ПараметрыПеремещения.ПриемникЭтоТовар Тогда
		// Нельзя перетаскивать строки в товар
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
		Возврат;
	КонецЕсли;
	
	Если ПараметрыПеремещения.ИсточникЭтоТовар
		И Не ПараметрыПеремещения.ЕстьПриемник Тогда
		// Товар можно перетаскивать только в агрегат
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
		Возврат;
	КонецЕсли;
	
	Если ПараметрыПеремещения.ИсточникЭтоАгрегат
		И ПараметрыПеремещения.ИсточникЭтоТоварАгрегата Тогда
		// Перемещать одновременно агрегат и товар нельзя
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
		Возврат;
	КонецЕсли;
	
	Если ПараметрыПеремещения.ПриемникСодержитИсточник Тогда
		// Агрегат не может быть перенесен сам в себя
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
		Возврат;
	КонецЕсли;
	
	Если ПараметрыПеремещения.ИсточникЭтоТовар
		И ПараметрыПеремещения.ПриемникСодержитАгрегаты Тогда
		// Товар можно перетаскивать только в агрегат самого нижнего уровня
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
		Возврат;
	КонецЕсли;
	
	Если ПараметрыПеремещения.ПриемникЭтоРодительИсточника Тогда
		// Нет смысла перетаскивать строку в тот же агрегат
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
		Возврат;
	КонецЕсли;
	
	Если ПараметрыПеремещения.ИсточникЭтоАгрегат
		И ПараметрыПеремещения.ПриемникСодержитТовары Тогда
		// Нельзя добавлять агрегат в коробку с товарами
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АгрегатыПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыПеремещения = ПараметрыПеретаскиванияВУпаковку(ПараметрыПеретаскивания, Строка, Поле);
	Приемник = ПараметрыПеремещения.Приемник;
	
	Если ПараметрыПеремещения.ИсточникИзТоваров Тогда
		Для Каждого Источник Из ПараметрыПеремещения.Источники Цикл
			ДобавитьСтрокуТовараВАгрегат(Источник, Приемник);
		КонецЦикла;
	КонецЕсли;
	
	Если ПараметрыПеремещения.ИсточникИзУпаковок Тогда
		Для Каждого Стр Из ПараметрыПеремещения.Источники Цикл
			Источник = Агрегаты.НайтиПоИдентификатору(Стр);
			НоваяСтрока = ПереместитьСтрокуДерева(Агрегаты, Источник, Приемник);
			Элементы.Агрегаты.Развернуть(НоваяСтрока.ПолучитьИдентификатор(), Истина);
		КонецЦикла;
	КонецЕсли;
	
	Если Строка <> Неопределено Тогда
		Элементы.Агрегаты.Развернуть(Строка, Истина);
	КонецЕсли;
	
	ОбновитьРаспределенноеКоличествоУпаковок();
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыПеретаскиванияВУпаковку(ПараметрыПеретаскивания, СтрокаПриемник, Поле)
	
	ИсточникЭтоТовар = Ложь;
	ИсточникИзТоваров = Ложь;
	ИсточникИзУпаковок = Ложь;
	ИсточникЭтоАгрегат = Ложь;
	ИсточникЭтоТоварАгрегата = Ложь;
	ПриемникЭтоТовар = Ложь;
	ПриемникЭтоРодительИсточника = Ложь;
	ПриемникСодержитТовары = Ложь;
	ПриемникСодержитАгрегаты = Ложь;
	ПриемникСодержитИсточник = Ложь;
	ЕстьПриемник = Ложь;
	Приемник = Неопределено;
	
	Источники = МодульКлиента().ЗначениеВМассиве(ПараметрыПеретаскивания.Значение);
	ПерваяСтрока = Источники[0];
	ТипИсточника = ТипЗнч(ПерваяСтрока);
	
	Если ТипИсточника = Тип("ДанныеФормыЭлементКоллекции") Тогда
		ИсточникИзТоваров = Товары.Индекс(ПерваяСтрока) > -1;
	КонецЕсли;
	Если ТипИсточника = Тип("Число") Тогда
		ИсточникИзУпаковок = Агрегаты.НайтиПоИдентификатору(ПерваяСтрока) <> Неопределено;
	КонецЕсли;
	
	Если ИсточникИзУпаковок Тогда
		Для Каждого Стр Из Источники Цикл
			Источник = Агрегаты.НайтиПоИдентификатору(Стр);
			Если ЗначениеЗаполнено(Источник.ВидАгрегата) Тогда
				ИсточникЭтоАгрегат = Истина;
			Иначе
				ИсточникЭтоТоварАгрегата = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если СтрокаПриемник <> Неопределено Тогда
		
		ЕстьПриемник = Истина;
		Приемник = Агрегаты.НайтиПоИдентификатору(СтрокаПриемник);
		ПриемникЭтоТовар = Не ЗначениеЗаполнено(Приемник.ВидАгрегата);
		
		ВложенныеСтроки = Приемник.ПолучитьЭлементы();
		Если ЗначениеЗаполнено(ВложенныеСтроки) Тогда
			Для каждого Стр Из ВложенныеСтроки Цикл
				Если ЗначениеЗаполнено(Стр.ВидАгрегата) Тогда
					ПриемникСодержитАгрегаты = Истина;
				Иначе
					ПриемникСодержитТовары = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если ИсточникИзУпаковок Тогда
			
			Для каждого Стр Из Источники Цикл
				Источник = Агрегаты.НайтиПоИдентификатору(Стр);
				РодительИсточника = Источник.ПолучитьРодителя();
				Если Приемник = РодительИсточника Тогда
					ПриемникЭтоРодительИсточника = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Для каждого Стр Из Источники Цикл
				Источник = Агрегаты.НайтиПоИдентификатору(Стр);
				Если СтрокаДереваСодержитСтроку(Источник, Приемник) Тогда
					ПриемникСодержитИсточник = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ИсточникЭтоТовар = ИсточникИзТоваров Или (ИсточникИзУпаковок И ИсточникЭтоТоварАгрегата);
	
	Результат = Новый Структура;
	Результат.Вставить("Источники", Источники);
	Результат.Вставить("ИсточникЭтоТовар", ИсточникЭтоТовар);
	Результат.Вставить("ИсточникИзТоваров", ИсточникИзТоваров);
	Результат.Вставить("ИсточникИзУпаковок", ИсточникИзУпаковок);
	Результат.Вставить("ИсточникЭтоАгрегат", ИсточникЭтоАгрегат);
	Результат.Вставить("ИсточникЭтоТоварАгрегата", ИсточникЭтоТоварАгрегата);
	Результат.Вставить("ЕстьПриемник", ЕстьПриемник);
	Результат.Вставить("Приемник", Приемник);
	Результат.Вставить("ПриемникЭтоТовар", ПриемникЭтоТовар);
	Результат.Вставить("ПриемникСодержитТовары", ПриемникСодержитТовары);
	Результат.Вставить("ПриемникСодержитАгрегаты", ПриемникСодержитАгрегаты);
	Результат.Вставить("ПриемникСодержитИсточник", ПриемникСодержитИсточник);
	Результат.Вставить("ПриемникЭтоРодительИсточника", ПриемникЭтоРодительИсточника);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьСтрокуТовараВАгрегат(СтрокаТовара, СтрокаАгрегата)
	
	ДоступноеКоличествоКодов = (СтрокаТовара.КоличествоУпаковок - СтрокаТовара.КоличествоКодовРаспределено);
	ОбщееКоличествоАгрегатов = ОбщееКоличествоАгрегатовПоСтрокеАгрегата(СтрокаАгрегата);
	
	Стр = СтрокаАгрегата.ПолучитьЭлементы().Добавить();
	Стр.Товар = СтрокаТовара.Товар;
	Стр.КлючНоменклатуры1С = СтрокаТовара.КлючНоменклатуры1С;
	Стр.КлючСтрокиДокумента = СтрокаТовара.КлючСтрокиДокумента;
	
	Если ДоступноеКоличествоКодов > 0 И ОбщееКоличествоАгрегатов > 0 Тогда
		Стр.КоличествоКодов = Цел(ДоступноеКоличествоКодов / ОбщееКоличествоАгрегатов);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПереместитьСтрокуДерева(Дерево, СтрокаИсточник, СтрокаПриемник)
	
	Если СтрокаПриемник = Неопределено Тогда
		НоваяСтрока = Дерево.ПолучитьЭлементы().Добавить();
	Иначе
		НоваяСтрока = СтрокаПриемник.ПолучитьЭлементы().Добавить();
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточник);
	
	ПодчиненныеСтроки = СтрокаИсточник.ПолучитьЭлементы();
	Для Сч = -(ПодчиненныеСтроки.Количество()-1) По 0 Цикл
		ПереместитьСтрокуДерева(Дерево, ПодчиненныеСтроки[-Сч], НоваяСтрока);
	КонецЦикла;
	
	Родитель = СтрокаИсточник.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда
		Дерево.ПолучитьЭлементы().Удалить(СтрокаИсточник);
	Иначе
		Родитель.ПолучитьЭлементы().Удалить(СтрокаИсточник);
	КонецЕсли;
	
	Возврат НоваяСтрока;
	
КонецФункции

&НаКлиенте
Функция ОбщееКоличествоАгрегатовПоСтрокеАгрегата(СтрокаАгрегата)
	
	Результат = СтрокаАгрегата.КоличествоАгрегатов;
	Родитель = СтрокаАгрегата.ПолучитьРодителя();
	
	Пока Родитель <> Неопределено Цикл
		Результат = Результат * Родитель.КоличествоАгрегатов;
		Родитель = Родитель.ПолучитьРодителя();
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СтрокаДереваСодержитСтроку(СтрокаДерева1, Знач СтрокаДерева2)
	
	Пока СтрокаДерева2 <> Неопределено Цикл
		Если СтрокаДерева1 = СтрокаДерева2 Тогда
			Возврат Истина;
		КонецЕсли;
		СтрокаДерева2 = СтрокаДерева2.ПолучитьРодителя();
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура ОбновитьРаспределенноеКоличествоУпаковок()
	
	РаспределеноКодов = КоличествоКодовВАгрегатах();
	
	Для Каждого Стр Из Товары Цикл
		Стр.КоличествоКодовРаспределено = МодульОбъекта().ЗначениеСоответствия(РаспределеноКодов, КлючТовара(Стр), 0);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция КоличествоКодовВАгрегатах(Мультипликатор = 1, СтрокиДерева = Неопределено, Результат = Неопределено)
	
	Если СтрокиДерева = Неопределено Тогда
		СтрокиДерева = Агрегаты.ПолучитьЭлементы();
	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		Результат = Новый Соответствие;
	КонецЕсли;
	
	Для Каждого Стр Из СтрокиДерева Цикл
		ВложенныеСтроки = Стр.ПолучитьЭлементы();
		Если ЗначениеЗаполнено(ВложенныеСтроки) Тогда
			КоличествоКодовВАгрегатах(Мультипликатор * Стр.КоличествоАгрегатов, ВложенныеСтроки, Результат);
		Иначе
			КлючТоваров = КлючТовара(Стр);
			Результат[КлючТоваров] = Стр.КоличествоКодов * Мультипликатор
			+ МодульОбъекта().ЗначениеСоответствия(Результат, КлючТоваров, 0);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ТребуетсяКодовДляНовыхТранспортныхУпаковок(Результат = Неопределено, СтрокиДерева = Неопределено)
	
	Если СтрокиДерева = Неопределено Тогда
		СтрокиДерева = Агрегаты.ПолучитьЭлементы();
	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		Результат = Новый Соответствие;
	КонецЕсли;
	
	Для Каждого Стр Из СтрокиДерева Цикл
		Если ЗначениеЗаполнено(Стр.ВидАгрегата) Тогда
			ТребуетсяКодов = МодульОбъекта().ЗначениеСоответствия(Результат, Стр.ВидАгрегата, 0) + Стр.КоличествоАгрегатов;
			Результат.Вставить(Стр.ВидАгрегата, ТребуетсяКодов);
		КонецЕсли;
		ТребуетсяКодовДляНовыхТранспортныхУпаковок(Результат, Стр.ПолучитьЭлементы());
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция КлючТовара(Стр)
	
	Возврат Строка(Стр.КлючСтрокиДокумента) + Строка(Стр.КлючНоменклатуры1С.УникальныйИдентификатор()) + ", " + Строка(Стр.Товар.УникальныйИдентификатор());
	
КонецФункции

&НаКлиенте
Процедура АгрегатыКоличествоКодовПриИзменении(Элемент)
	
	ОбновитьРаспределенноеКоличествоУпаковок();
	
КонецПроцедуры

&НаКлиенте
Процедура АгрегатыКоличествоАгрегатовПриИзменении(Элемент)
	
	ОбновитьРаспределенноеКоличествоУпаковок();
	
КонецПроцедуры

&НаСервере
Функция ПроверитьНаличиеСерийныхНомеровДляНовыхАгрегатов()
	
	ШаблонОшибки = НСтр("ru = 'Для агрегата ""%1"" недостаточно новых серийных номеров, требуется %2, доступно %3'");
	
	Результат = Истина;
	
	Для каждого Эл Из ТребуетсяКодовДляНовыхТранспортныхУпаковок() Цикл
		
		ТекВидАгрегата = Эл.Ключ;
		ТекКоличествоКодовТребуется = Эл.Значение;
		ТекКоличествоКодовДоступно = МодульОбъекта().КоличествоДоступныхСерийныхНомеров(ТекВидАгрегата);
		
		Если ТекКоличествоКодовТребуется > ТекКоличествоКодовДоступно Тогда
			
			ТекстОшибки = МодульОбъекта().ПараметрыВСтроку(ШаблонОшибки
			, ТекВидАгрегата
			, ТекКоличествоКодовТребуется
			, ТекКоличествоКодовДоступно);
			
			МодульОбъекта().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор);
			
			Результат = Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СозданиеАгрегатов_ЕстьОшибки()
	
	ЕстьОшибки = Ложь;
	
	Для каждого Стр Из Товары Цикл
		
		Если ЗначениеЗаполнено(Стр.КоличествоКодовРаспределено) Тогда
			Если Не ЗначениеЗаполнено(Стр.КоличествоКодов) Тогда
				МодульОбъекта().СообщитьОбОшибкеВСтрокеТабЧасти(
				НСтр("ru = 'Нет доступных кодов для распределения'")
				, УникальныйИдентификатор, Элементы.Товары
				, "КоличествоКодов", Товары.Индекс(Стр));
				ЕстьОшибки = Истина;
			ИначеЕсли Стр.КоличествоКодов < Стр.КоличествоКодовРаспределено Тогда
				МодульОбъекта().СообщитьОбОшибкеВСтрокеТабЧасти(
				НСтр("ru = 'Распределено кодов больше чем доступно'")
				, УникальныйИдентификатор, Элементы.Товары
				, "КоличествоКодовРаспределено", Товары.Индекс(Стр));
				ЕстьОшибки = Истина;
			Иначе
				// Распределено достаточное количество кодов
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.КоличествоКодов)
			И Не ЗначениеЗаполнено(Стр.КоличествоКодовРаспределено) Тогда
			МодульОбъекта().СообщитьОбОшибкеВСтрокеТабЧасти(
			НСтр("ru = 'Не распределено ни одного кода'")
			, УникальныйИдентификатор, Элементы.Товары
			, "КоличествоКодовРаспределено", Товары.Индекс(Стр));
			ЕстьОшибки = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ПроверитьКоличествоКодовВиртуальныхАгрегатов(Агрегаты.ПолучитьЭлементы()) Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Возврат ЕстьОшибки;
	
КонецФункции

&НаКлиенте
Процедура Операция_Удалить(Команда)
	
	УдалитьОперациюНаСервере();
	
	Модифицированность = Ложь;
	
	Закрыть();
	
	Оповестить("КонтурМаркировка_Операция_Изменен", ДокументУчета);
	
КонецПроцедуры

&НаКлиенте
Процедура Операция_ОткрытьВСервисе(Команда)
	
	МодульКлиента().ОткрытьОперациюВСервисе(ТипОперации, ИдентификаторДокумента);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьОперациюНаСервере()
	
	НачатьТранзакцию(МодульОбъекта().РежимУправленияБлокировкой());
	
	Попытка
		
		ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
		ТребуемыеДействия = МодульОбъекта().Перечисление_ТребуемыеДействияДокументовУчета();
		СтатусыДокументовУчета = МодульОбъекта().Перечисление_СтатусыДокументовУчета();
		
		МодульОбъекта().Операции_Удалить(Ссылка);
		
		Если ТипОперации = ТипыОпераций.ПодборТоваровИКодовНаТСД Тогда
			СтатусыДокумента = МодульОбъекта().ДокументУчета_Статусы(ДокументУчета);
			СтатусыДокумента.ОсновнойСтатус = СтатусыДокументовУчета.Новый;
			СтатусыДокумента.ТребуемоеДействие = ТребуемыеДействия.НачатьРаботу;
			МодульОбъекта().СтатусыДокументаУчета_Записать(ДокументУчета, СтатусыДокумента);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура Коды_Напечатать(Команда)
	
	ТипыОпераций = МодульКлиента().Перечисление_ТипыОпераций();
	СтатусыОпераций = МодульКлиента().Перечисление_СтатусыОпераций();
	
	Если ТипОперации = ТипыОпераций.АгрегацияКодов
		И ОсновнойСтатус = СтатусыОпераций.Новый Тогда
		Если Не СоздатьАгрегаты() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипОперации = ТипыОпераций.АгрегацияКодов Тогда
		ОперацияПечати = МодульКлиента().Операция_СоздатьИЗаполнитьОперациюПечати(ДокументУчета, Ссылка);
	Иначе
		ОперацияПечати = МодульКлиента().Операция_Создать(ТипыОпераций.ПечатьКодов, ДокументУчета, Ссылка);
	КонецЕсли;
	
	Если ТипОперации = ТипыОпераций.АгрегацияКодов Тогда
		ЗавершитьОперацию();
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			Оповестить("КонтурМаркировка_КодыВДокументах_Изменен", ДокументУчета);
		КонецЕсли;
		Оповестить("КонтурМаркировка_Операция_Изменен", ДокументУчета);
	КонецЕсли;
	
	МодульКлиента().ОткрытьФормуОперации(ОперацияПечати, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЭтикетки(Команда)
	
	Если Не ПроверитьЗаполнениеРеквизитов()
		Или Не ПроверитьКоличествоКодов() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыКартинок = СформироватьВсеЭтикетки(МодульКлиента().ДоступнаПечатьШтрихкодовНаКлиенте());
	МодульКлиента().Этикетки_ЗаполнитьКартинкиШтрихкодов(Этикетки, ПараметрыКартинок);
	
	ЭтаФорма.ТекущийЭлемент = Элементы.Этикетки;
	
	Если ОсновнойСтатус = МодульКлиента().Перечисление_СтатусыОпераций().Новый Тогда
		
		ПараметрыПечатиДляМетрики = ОписаниеПараметровПечатиДляМетрики();
		МодульКлиента().Метрики_ПечатьЭтикетокСЗаполненнымиПараметрами(ПараметрыПечатиДляМетрики, Организация);
		Если ПечатьИзСвободногоОстатка Тогда
			МодульКлиента().Метрика_Функциональность_ПечатьКодовИзСвободногоОстатка(Организация);
		КонецЕсли;
		
		УстановитьСтатусКодыНапечатаны();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПервуюПорциюЭтикеток(Команда)
	
	Если Не ПроверитьЗаполнениеРеквизитов()
		Или Не ПроверитьКоличествоКодов() Тогда
		Возврат;
	КонецЕсли;
	
	ТолькоПервуюПорцию = Истина;
	ПараметрыПечати = ПараметрыПечатиЭтикетокПорциями(МодульКлиента().ДоступнаПечатьШтрихкодовНаКлиенте(), ТолькоПервуюПорцию);
	ПараметрыКартинок = СформироватьПервуюПорциюЭтикеток(ПараметрыПечати.АдресПараметровПечати);
	МодульКлиента().Этикетки_ЗаполнитьКартинкиШтрихкодов(Этикетки, ПараметрыКартинок);
	
	ЭтаФорма.ТекущийЭлемент = Элементы.Этикетки;
	
КонецПроцедуры

&НаКлиенте
Процедура НапечататьЭтикеткиПорциями(Команда)
	
	Если Не ПроверитьЗаполнениеРеквизитов()
		Или Не ПроверитьКоличествоКодов() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПечати = ПараметрыПечатиЭтикетокПорциями(МодульКлиента().ДоступнаПечатьШтрихкодовНаКлиенте());
	
	НомерПорции = 0;
	ЕстьЭтикетки = Истина;
	
	Пока ЕстьЭтикетки Цикл
		
		НомерПорции = НомерПорции + 1;
		ПараметрыЗаполненияКартинок = СформироватьПорциюЭтикеток(ПараметрыПечати.АдресПараметровПечати, НомерПорции);
		МодульКлиента().Этикетки_ЗаполнитьКартинкиШтрихкодов(Этикетки, ПараметрыЗаполненияКартинок);
		
		ЕстьЭтикетки = (Этикетки.ВысотаТаблицы > 0);
		
		Если ЕстьЭтикетки Тогда
			Этикетки.Напечатать();
		КонецЕсли;
		
	КонецЦикла;
	
	ЭтаФорма.ТекущийЭлемент = Элементы.Этикетки;
	
	Если ОсновнойСтатус = МодульКлиента().Перечисление_СтатусыОпераций().Новый Тогда
		
		ПараметрыПечатиДляМетрики = ОписаниеПараметровПечатиДляМетрики();
		МодульКлиента().Метрики_ПечатьЭтикетокСЗаполненнымиПараметрами(ПараметрыПечатиДляМетрики, Организация);
		Если ПечатьИзСвободногоОстатка Тогда
			МодульКлиента().Метрика_Функциональность_ПечатьКодовИзСвободногоОстатка(Организация);
		КонецЕсли;
		
		УстановитьСтатусКодыНапечатаны();
		
	КонецЕсли;
	
	МодульКлиента().СообщитьПользователюЛок(НСтр("ru = 'Этикетки успешно напечатаны'"), УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьЭтикеткиПорциямиPDF(Команда)
	
	Если Не ПроверитьЗаполнениеРеквизитов()
		Или Не ПроверитьКоличествоКодов() Тогда
		Возврат;
	КонецЕсли;
	
	ЗаголовокДиалога = НСтр("ru = 'Выберите каталог для сохранения файлов PDF'");
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("СохранитьЭтикеткиPDFПослеВыбораКаталога", ЭтаФорма);
	МодульКлиента().ПоказатьДиалогВыбораКаталога(ОписаниеОбработчика, ЗаголовокДиалога);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьЭтикеткиPDFПослеВыбораКаталога(РезультатВыбора, ДопПараметры = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(РезультатВыбора) Тогда
		Возврат;
	КонецЕсли;
	
	Действие = МодульКлиента().Перечисление_ДействияМетрики().Замер_СохранениеЭтикетокПорциямиВPDF;
	МодульКлиента().НачатьЗамерПроизводительности(Действие);
	
	КаталогДляСохранения = РезультатВыбора[0];
	ИмяФайлаДляСохранения = ИмяФайлаДляСохраненияЭтикеток();
	
	ПараметрыПечати = ПараметрыПечатиЭтикетокПорциями(МодульКлиента().ДоступнаПечатьШтрихкодовНаКлиенте());
	
	НомерПорции = 0;
	ЕстьЭтикетки = Истина;
	
	Пока ЕстьЭтикетки Цикл
		
		НомерПорции = НомерПорции + 1;
		ПараметрыКартинок = СформироватьПорциюЭтикеток(ПараметрыПечати.АдресПараметровПечати, НомерПорции);
		МодульКлиента().Этикетки_ЗаполнитьКартинкиШтрихкодов(Этикетки, ПараметрыКартинок);
		
		ЕстьЭтикетки = (Этикетки.ВысотаТаблицы > 0);
		
		Если ЕстьЭтикетки Тогда
			ИмяФайла = ИмяФайлаДляСохранения + "_" + Формат(НомерПорции, "ЧГ=" ) + ".pdf";
			ПутьКФайлу = МодульКлиента().ОбъединитьПути(КаталогДляСохранения, ИмяФайла);
			Этикетки.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.PDF);
		КонецЕсли;
		
	КонецЦикла;
	
	ЭтаФорма.ТекущийЭлемент = Элементы.Этикетки;
	
	Если ОсновнойСтатус = МодульКлиента().Перечисление_СтатусыОпераций().Новый Тогда
		
		ПараметрыПечатиДляМетрики = ОписаниеПараметровПечатиДляМетрики();
		МодульКлиента().Метрики_ПечатьЭтикетокСЗаполненнымиПараметрами(ПараметрыПечатиДляМетрики, Организация);
		Если ПечатьИзСвободногоОстатка Тогда
			МодульКлиента().Метрика_Функциональность_ПечатьКодовИзСвободногоОстатка(Организация);
		КонецЕсли;
		
		УстановитьСтатусКодыНапечатаны();
		
	КонецЕсли;
	
	ТекстСообщения = МодульКлиента().ПараметрыВСтроку(
	НСтр("ru = 'Этикетки успешно выгружены в каталог %1'"), КаталогДляСохранения);
	МодульКлиента().СообщитьПользователюЛок(ТекстСообщения, УникальныйИдентификатор);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("РазмерПорции", ПараметрыПечати.РазмерПорции);
	ДопПараметры.Вставить("КоличествоЭтикеток", ПараметрыПечати.КоличествоЭтикеток);
	МодульКлиента().ЗавершитьЗамерПроизводительности(Действие, ДопПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкиСортировкиЭтикеток(Команда)
	
	Обработчик = МодульКлиента().ОписаниеОбработчикаОповещения(
	"НастройкиСортировкиЭтикетокПослеРедактирования", ЭтаФорма);
	
	НастройкиСортировкиЭтикеток = МодульКлиента().Новый_ПараметрыСортировкиЭтикеток();
	ЗаполнитьЗначенияСвойств(НастройкиСортировкиЭтикеток, ЭтаФорма);
	
	МодульКлиента().ОткрытьНастройкиСортировкиЭтикеток(ЭтаФорма, НастройкиСортировкиЭтикеток, Обработчик);
	
КонецПроцедуры

