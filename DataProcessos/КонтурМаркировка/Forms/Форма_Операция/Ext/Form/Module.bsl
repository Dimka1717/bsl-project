&НаСервере
Процедура ЗаполнитьТоварПоКлючуНоменклатуры1С(ИдентификаторСтроки)
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	
	Стр = Товары.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если Не ЗначениеЗаполнено(Стр.КлючНоменклатуры1С)
		И (ТипОперации = ТипыОпераций.ОтчетОНанесении
		Или ТипОперации = ТипыОпераций.ВводВОборот) Тогда
		Возврат;
	КонецЕсли;
	
	МассивТоваров = МодульОбъекта().ПодходящиеТоварыМаркировки(Стр.КлючНоменклатуры1С, Организация);
	
	Стр.Товар = Неопределено;
	Если МассивТоваров.Количество() = 1 Тогда
		Стр.Товар = МассивТоваров[0];
	КонецЕсли;
	
	ЗаполнитьСтрокуТоваровДаннымиИБ(Стр);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокуТоваровДаннымиИБ(Стр)
	
	ЗаполнитьВСтрокеТоваровКодТНВЭД(Стр);
	ЗаполнитьВСтрокеТоваровВложенныйТовар(Стр);
	
	Стр.ЭтоКег = Неопределено;
	Стр.ТребуетсяЗСН = Неопределено;
	Стр.ПеременныйВес = Неопределено;
	Стр.НоминальныйОбъем = Неопределено;
	Стр.ТипКодаМаркировки = Неопределено;
	Стр.СрокГодностиМеньше72Часов = Неопределено;
	Стр.ПодлежитВетеринарномуКонтролю = Неопределено;
	
	Если Не ЗначениеЗаполнено(Стр.Товар) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеТовара = МодульОбъекта().Товар_Прочитать(Стр.Товар);
	ТипыСроковГодности = МодульОбъекта().Перечисление_ТипыСроковГодности();
	
	ТоварСоСрокомГодностиМеньше72 = (ОписаниеТовара.ТипСрокаГодности = ТипыСроковГодности.СрокГодностиМеньше72);
	
	Стр.ЭтоКег = ОписаниеТовара.ДопРеквизиты.ЭтоКег;
	Стр.ТребуетсяЗСН = ОписаниеТовара.ДопРеквизиты.ИспользоватьЗаводскойСН;
	Стр.ПеременныйВес = ОписаниеТовара.ПеременныйВес;
	Стр.НоминальныйОбъем = ОписаниеТовара.ДопРеквизиты.НоминальныйОбъем;
	Стр.СрокГодностиМеньше72Часов = ТоварСоСрокомГодностиМеньше72;
	Стр.ТипКодаМаркировки = ОписаниеТовара.ТипКодаМаркировки;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВСтрокеТоваровКодТНВЭД(Стр)
	
	Стр.КодТНВЭД = Неопределено;
	
	Если Не ЗначениеЗаполнено(Стр.Товар) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	СпособыВыпуска = МодульОбъекта().Перечисление_СпособыВыпускаТоваров();
	
	Если ТипОперации = ТипыОпераций.ФормированиеАТК
		Или (ТипОперации = ТипыОпераций.ЗаказКодов И СпособВыпускаТоваров = СпособыВыпуска.Перемаркировка)
		Или (ТипОперации = ТипыОпераций.ВводВОборот И СпособВводаВОборотТребуетУказатьТНВЭД()) Тогда
		Стр.КодТНВЭД = Стр.Товар.КодТНВЭД;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварыВложеннымиТоварами()
	
	Для Каждого Стр Из Товары Цикл
		ЗаполнитьВСтрокеТоваровВложенныйТовар(Стр);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВСтрокеТоваровВложенныйТовар(Стр)
	
	Стр.ВложенныйТовар = Неопределено;
	Стр.КоличествоКодовВложенногоТовара = Неопределено;
	
	Если Не ЗаказатьКодыДляВложенныхТоваров
		Или Не ЗначениеЗаполнено(Стр.Товар) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Стр.Товар.ВложенныйТовар) Тогда
		Возврат;
	КонецЕсли;
	
	Стр.ВложенныйТовар = Стр.Товар.ВложенныйТовар;
	Стр.КоличествоУпаковокВложенногоТовара = Стр.КоличествоУпаковок * Стр.Товар.КоличествоВложений;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура КарточкиТоваровПринадлежатДругойОрганизацииПриИзменении(Элемент)
	
	НастроитьЭлементыФормы();
	ОчиститьСобственникТовараИНН();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСобственникТовараИНН()
	
	Если Не КарточкиТоваровПринадлежатДругойОрганизации Тогда
		СобственникТовараИНН_Последний = СобственникТовараИНН;
		СобственникТовараИНН = "";
	Иначе
		СобственникТовараИНН = СобственникТовараИНН_Последний;
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИННПроизводителяИСобственникаТовара()
	
	ОписаниеОперации = ОписаниеОперацииПоКонтекстуФормы();
	
	МодульОбъекта().Операция_ЗаполнитьПроизводительИСобственникТовараИНН(ОписаниеОперации);
	
	ПроизводительИНН = ОписаниеОперации.ДопРеквизиты.ПроизводительИНН;
	СобственникТовараИНН = ОписаниеОперации.ДопРеквизиты.СобственникТовараИНН;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТекстОформленияНеТребуется(ЭлементОформления)
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Серый);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<не требуется>'"));
	
КонецПроцедуры

&НаКлиенте
Процедура Операция_Записать(Команда)
	
	Если Не МодульКлиента().ПроверитьУстановленнуюВерсиюМодуля() Тогда
		Возврат;
	КонецЕсли;
	
	СохранитьОперацию();
	
	ОповеститьОбИзменении(Ссылка);
	Оповестить("КонтурМаркировка_Операция_Изменен", ДокументУчета);
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьАльтСрокиГодностиПоДатеПроизводстваВШапке()
	
	Для каждого Стр Из Товары Цикл
		Если Не ЗначениеЗаполнено(Стр.ДатаПроизводства) Тогда
			ПересчитатьАльтСрокиГодностиТовара(Стр, ДатаПроизводства);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьАльтСрокиГодностиТовара(СтрокаТовара, ПарамДатаПроизводства)
	
	Если ТипЗнч(СтрокаТовара) = Тип("Число") Тогда
		Стр = Товары.НайтиПоИдентификатору(СтрокаТовара);
	Иначе
		Стр = СтрокаТовара;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Стр.Товар)
		Или Не ЗначениеЗаполнено(ПарамДатаПроизводства) Тогда
		Возврат;
	КонецЕсли;
	
	УсловияХранения = Стр.Товар.УсловияХранения;
	Отбор = Новый Структура("КлючСтрокиОперации", Стр.КлючСтрокиОперации);
	Для Каждого АльтСрок Из АльтернативныеСрокиГодности.НайтиСтроки(Отбор) Цикл
		Условие = УсловияХранения.Найти(АльтСрок.Тип, "Тип");
		Если Условие <> Неопределено Тогда
			АльтСрок.ДатаСрокаГодности = ПарамДатаПроизводства + Условие.СрокХранения * МодульОбъекта().СекундВСутках();
		КонецЕсли;
	КонецЦикла;
	
	ОбновитьПризнакЗаполненияАльтернативныхСроковГодности(ЭтаФорма, Стр);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПризнакЗаполненияАльтернативныхСроковГодности(Форма, СтрТовара)
	
	АльтСроки = АльтСрокиГодностиТовара(Форма, СтрТовара.КлючСтрокиОперации);
	
	Если Не ЗначениеЗаполнено(АльтСроки) Тогда
		СтрТовара.АльтернативныйСрокГодностиЗаполнен = Ложь;
		Возврат;
	КонецЕсли;
	
	СтрТовара.АльтернативныйСрокГодностиЗаполнен = Истина;
	Для каждого Элемент Из АльтСроки Цикл
		Если Не ЗначениеЗаполнено(Элемент.Значение) Тогда
			СтрТовара.АльтернативныйСрокГодностиЗаполнен = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СписокТиповКодовМаркировкиКИНКИГУ()
	
	Результат = Новый СписокЗначений;
	Результат.Добавить(Перечисления.КонтурМаркировка_ТипыКодовМаркировки.ГрупповаяУпаковка);
	Результат.Добавить(Перечисления.КонтурМаркировка_ТипыКодовМаркировки.Набор);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЕстьОграничениеЗаказаКодов(ОписаниеТарифа)
	
	Результат = Ложь;
	
	Если ТипОперации <> МодульОбъекта().Перечисление_ТипыОпераций().ЗаказКодов Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если СпособВыпускаТоваров = МодульОбъекта().Перечисление_СпособыВыпускаТоваров().Перемаркировка Тогда
		Сервис = МодульОбъекта().Перечисление_СервисыПодписок().ЗаказКодовПеремаркировка;
		Если Не МодульОбъекта().СервисДоступенПоТарифу(Сервис, ОписаниеТарифа) Тогда
			Результат = Истина;
		КонецЕсли;
	Иначе
		Если Не МодульОбъекта().ОперацияДоступнаПоТарифу(ТипОперации, ОписаниеТарифа) Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЕстьОграничениеОтчетаОНанесении(ОписаниеТарифа)
	
	Результат = Ложь;
	
	Если ТипОперации <> МодульОбъекта().Перечисление_ТипыОпераций().ОтчетОнанесении Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ЕстьКодыСоСпособомВыпускаПеремаркировка() Тогда
		Сервис = МодульОбъекта().Перечисление_СервисыПодписок().Перемаркировка;
		Если Не МодульОбъекта().СервисДоступенПоТарифу(Сервис, ОписаниеТарифа) Тогда
			Результат = Истина;
		КонецЕсли;
	Иначе
		Если Не МодульОбъекта().ОперацияДоступнаПоТарифу(ТипОперации, ОписаниеТарифа) Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ОписаниеПараметровПечатиДляМетрики()
	
	Результат = Новый Структура;
	Результат.Вставить("ЗаполненТовар", ЗначениеЗаполнено(Товар));
	Результат.Вставить("ЗаполненаНоменклатура1С", ЗначениеЗаполнено(КлючНоменклатуры1С));
	Результат.Вставить("КоличествоКодовТребуется", КоличествоКодовТребуется);
	Результат.Вставить("КоличествоКодовПодобрано", КоличествоКодов);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОчиститьПлощадкуДляНеподходящихПричинВыводаИзОборота()
	
	ВидыПродукции = МодульОбъекта().Перечисление_ВидыПродукции();
	
	Если ВидПродукции = ВидыПродукции.Пиво
		И Не ПричинаВыводаИзОборотаДляПиваДопускаетПлощадку() Тогда
		Площадка = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЕстьКодыСоСтатусомВыпущен()
	
	СтатусВыпущен = МодульОбъекта().Перечисление_СтатусыКодов().Выпущен;
	
	Возврат МодульОбъекта().КодыОпераций_ЕстьКодыВСтатусе(Ссылка, СтатусВыпущен);
	
КонецФункции

&НаСервере
Функция ЕстьКодыСоСпособомВыпускаПеремаркировка()
	
	СпособВыпускаПеремаркировка = МодульОбъекта().Перечисление_СпособыВыпускаТоваров().Перемаркировка;
	
	Возврат МодульОбъекта().КодыОпераций_ЕстьКодыСоСпособамиВыпуска(Ссылка, СпособВыпускаПеремаркировка);
	
КонецФункции

&НаСервере
Функция Новый_ПараметрыСортировкиЭтикеток()
	
	Возврат МодульОбъекта().Новый_ПараметрыСортировкиЭтикеток();
	
КонецФункции

// #Область РедактированиеОперации

&НаКлиенте
Процедура НачатьРедактированиеОперации(Команда)
	
	НачатьРедактированиеОперацииНаСервере();
	УстановитьПодсказкуФормы();
	
КонецПроцедуры

&НаСервере
Процедура НачатьРедактированиеОперацииНаСервере()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	
	Если ТипОперации = ТипыОпераций.ОтчетОНанесенииНаТСД Тогда
		МодульОбъекта().ОчередьОбмена_ОтчетОНанесенииНаТСД_НачатьРедактирование(Ссылка);
	КонецЕсли;
	
	ЗаполнитьКонтекстФормы();
	УстановитьВидимостьПоСтатусу();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРедактированиеОперации(Команда)
	
	ЗавершитьРедактированиеОперацииНаСервере();
	УстановитьПодсказкуФормы();
	
КонецПроцедуры

&НаСервере
Процедура ЗавершитьРедактированиеОперацииНаСервере()
	
	СохранитьОперацию();
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	
	Если ТипОперации = ТипыОпераций.ОтчетОНанесенииНаТСД Тогда
		МодульОбъекта().ОчередьОбмена_ОтчетОНанесенииНаТСД_ЗавершитьРедактирование(Ссылка);
	КонецЕсли;
	
	ЗаполнитьКонтекстФормы();
	УстановитьВидимостьПоСтатусу();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПризнакОперацияОграниченаТарифом()
	
	ОперацияОграниченаТарифом = Ложь;
	
	Если Не ПроверитьДоступностьОперацииПоТарифу() Тогда
		ОперацияОграниченаТарифом = Истина;
	КонецЕсли;
	
КонецПроцедуры

