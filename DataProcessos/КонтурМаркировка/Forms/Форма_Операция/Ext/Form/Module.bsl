&НаСервере
Процедура ПодобратьКодыДляАгрегации()
	
	ОписаниеОперации = ОписаниеОперацииПоКонтекстуФормы();
	
	Если Модифицированность Тогда
		СохранитьОперацию(ОписаниеОперации);
	КонецЕсли;
	
	МодульОбъекта().Операция_ЗаполнитьКодами(ОписаниеОперации);
	
	ПосчитатьКоличествоСтрокТаблицФормы();
	ЗаполнитьКоличествоКодовВТоварах();
	
	ОбновитьРаспределенноеКоличествоУпаковок();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКоличествоКодовВТоварах()
	
	ТаблицаКоличества = МодульОбъекта().КодыОпераций_КоличествоКодов(Ссылка);
	
	Отбор = Новый Структура("КлючСтрокиОперации");
	
	Для каждого СтрКоличества Из ТаблицаКоличества Цикл
		
		Отбор.КлючСтрокиОперации = СтрКоличества.КлючСтрокиОперации;
		
		СтрокиТоваров = Товары.НайтиСтроки(Отбор);
		Если Не ЗначениеЗаполнено(СтрокиТоваров) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрТовара = СтрокиТоваров[0];
		
		Если ЗначениеЗаполнено(СтрТовара.ВложенныйТовар)
			И СтрТовара.ВложенныйТовар = СтрКоличества.Товар Тогда
			СтрТовара.КоличествоКодовВложенногоТовара = СтрКоличества.КоличествоКодов;
		Иначе
			СтрТовара.КоличествоКодов = СтрКоличества.КоличествоКодов;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КодыОперацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Поле = Элементы.КодыМаркировкиОперация Тогда
		ОткрытьФормуПодчиненнойОперацииНаУровнеСтроки(Элемент, ВыбраннаяСтрока);
	КонецЕсли;
	
	Если Поле = Элементы.КодыМаркировкиКодМаркировки Тогда
		ДанныеСтроки = Элемент.ДанныеСтроки(ВыбраннаяСтрока);
		Если ЗначениеЗаполнено(ДанныеСтроки.КлючКода) Тогда
			МодульКлиента().ОткрытьФормуКодаМаркировки(ДанныеСтроки.КлючКода, Организация, ЭтаФорма);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

