&НаСервере
Процедура НастроитьЭлементыФормы_КорректировкаСведенийОКодах()

	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	Если ТипОперации <> ТипыОпераций.КорректировкаСведенийОКодах Тогда
		Возврат;
	КонецЕсли;

	ВидыСведений = МодульОбъекта().Перечисление_ВидыКорректируемыхСведений();
	
	Элементы.КорректировкаСведенийОКодах.Видимость = Истина;
	
	Элементы.ЗакладкаТовары.Видимость = Истина;
	Элементы.ЗакладкаКодыМаркировки.Видимость = Истина;
	Элементы.ТоварыКоличествоКодов.Видимость = Истина;
	Элементы.ТоварыПодчиненнаяОперация.Видимость = Истина;
	Элементы.ТоварыКорректировкаСведенийОКодах.Видимость = Истина;
	Элементы.КодыМаркировкиОбщийТипУпаковки.Видимость = Истина;
	Элементы.ТоварыТовар.ТолькоПросмотр = Истина;
	
	КорректировкаДатыПроизводства = (ВидКорректируемыхСведений = ВидыСведений.ДатаПроизводства);
	Элементы.ТоварыКорректировкаДатаПроизводства.Видимость = КорректировкаДатыПроизводства;
	Элементы.КодыМаркировкиДатаПроизводства.Видимость = КорректировкаДатыПроизводства;
	
	КорректировкаСрокаГодности = (ВидКорректируемыхСведений = ВидыСведений.СрокГодности);
	Элементы.ТоварыКорректировкаДатаСрокаГодности.Видимость = КорректировкаСрокаГодности;
	Элементы.КодыМаркировкиДатаСрокаГодности.Видимость = КорректировкаСрокаГодности;
	
	КорректировкаИдентификатораВСД = (ВидКорректируемыхСведений = ВидыСведений.ИдентификаторВСД);
	Элементы.ТоварыКорректировкаИдентификаторВСД.Видимость = КорректировкаИдентификатораВСД;
	Элементы.КодыМаркировкиИдентификаторВСД.Видимость = КорректировкаИдентификатораВСД;
	
	КорректировкаКодаТНВЭД = (ВидКорректируемыхСведений = ВидыСведений.КодТНВЭД);
	Элементы.ТоварыКорректировкаКодТНВЭД.Видимость = КорректировкаКодаТНВЭД;
	Элементы.КодыМаркировкиТоварКодТНВЭД.Видимость = Ложь; // т.к. информация из товара может быть не актуальна
	
	КорректировкаФактическогоВеса = (ВидКорректируемыхСведений = ВидыСведений.ФактическийВес);
	Элементы.ТоварыКорректировкаФактическийВес.Видимость = КорректировкаФактическогоВеса;
	Элементы.КодыМаркировкиФактическийВес.Видимость = КорректировкаФактическогоВеса;
	
	КорректировкаСпособаВыпускаТоваров = (ВидКорректируемыхСведений = ВидыСведений.СпособВыпускаТоваров);
	Элементы.ТоварыКорректировкаСпособВыпускаТоваров.Видимость = КорректировкаСпособаВыпускаТоваров;
	
	КорректировкаВариативногоСрокаГодности = (ВидКорректируемыхСведений = ВидыСведений.ВариативныйСрокГодности);
	Элементы.ТоварыКорректировкаВариативныйСрокГодности.Видимость = КорректировкаВариативногоСрокаГодности;
	
	КорректировкаРазрешительногоДокумента = (ВидКорректируемыхСведений = ВидыСведений.РазрешительныйДокумент);
	Элементы.ТоварыКорректировкаРазрешительныйДокумент.Видимость = КорректировкаРазрешительногоДокумента;
	
	КорректировкаЛицензииНаНедра = (ВидКорректируемыхСведений = ВидыСведений.ЛицензияНаНедра);
	Элементы.ТоварыКорректировкаЛицензияНаНедра.Видимость = КорректировкаЛицензииНаНедра;
	
	КорректировкаНомераПартии = (ВидКорректируемыхСведений = ВидыСведений.НомерПартии);
	Элементы.ТоварыКорректировкаНомерПартии.Видимость = КорректировкаНомераПартии;
	
	ПоказатьКнопкуЗагрузкиКодов = (Не ЗначениеЗаполнено(ДокументУчета) И Не ЗначениеЗаполнено(ОперацияОснование));
	Элементы.Кнопка_ЗагрузитьКодыИзТабличногоДокумента.Видимость = ПоказатьКнопкуЗагрузкиКодов;
	
	Если ПоказатьКнопкуЗагрузкиКодов И Не ЗначениеЗаполнено(Товары) Тогда
		Элементы.ПанельЗакладок.ТекущаяСтраница = Элементы.ЗакладкаКодыМаркировки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормы_УведомлениеОСостоянииКодов()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	Если ТипОперации <> ТипыОпераций.УведомлениеОСостоянииКодов Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.УведомлениеОСостоянииКодов.Видимость = Истина;
	Элементы.ЗакладкаТовары.Видимость = Истина;
	Элементы.ЗакладкаКодыМаркировки.Видимость = Истина;
	Элементы.ТоварыКоличествоКодов.Видимость = Истина;
	Элементы.ТоварыПодчиненнаяОперация.Видимость = Истина;
	Элементы.ТоварыТовар.Видимость = Истина;
	Элементы.ТоварыТовар.ТолькоПросмотр = Истина;
	Элементы.ТоварыКлючНоменклатуры1С.Видимость = Истина;
	Элементы.ТоварыКлючНоменклатуры1С.ТолькоПросмотр = Истина;
	
	ВидыТранспортныхДокументов = МодульОбъекта().Перечисление_ВидыТранспортныхДокументов();
	Элементы.ГруппаТТН.Видимость = (ВидТранспортногоДокумента = ВидыТранспортныхДокументов.ТТН);
	Элементы.ИдентификаторЭПД.Видимость = (ВидТранспортногоДокумента = ВидыТранспортныхДокументов.ЭПД);
	
	ПоказатьКнопкуЗагрузкиКодов = (Не ЗначениеЗаполнено(ДокументУчета) И Не ЗначениеЗаполнено(ОперацияОснование));
	Элементы.Кнопка_ЗагрузитьКодыИзТабличногоДокумента.Видимость = ПоказатьКнопкуЗагрузкиКодов;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормы_ПечатьКодов()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	Если ТипОперации <> ТипыОпераций.ПечатьКодов Тогда
		Возврат;
	КонецЕсли;
	
	СтатусыОпераций = МодульОбъекта().Перечисление_СтатусыОпераций();
	
	Элементы.Кнопка_ВыполнитьОперацию.Заголовок = НСтр("ru = 'Завершить операцию'");
	
	Элементы.ПечатьЭтикеток.Видимость = Истина;
	Элементы.ПечатьКодов.Видимость = Истина;
	Элементы.ПоляТиповОпераций.ТекущаяСтраница = Элементы.ПечатьКодов;
	Элементы.КодыМаркировкиНапечатан.Видимость = Истина;
	
	Элементы.ЗакладкаКодыМаркировки.Видимость = Истина;
	Элементы.ЗакладкаКодыМаркировки.Заголовок = НСтр("ru = 'Коды для печати'");
	
	Элементы.ТоварыПредставлениеСтрокиДокумента.Видимость = Истина;
	Элементы.ТоварыТовар.ТолькоПросмотр = Истина;
	
	Элементы.ГруппаПараметрыПечати.Видимость = Истина;
	
	Элементы.ГруппаШаблонТоварнойЭтикетки.Видимость = ЕстьТоварныеЭтикетки;
	Элементы.ГруппаШаблонГрупповойЭтикетки.Видимость = ЕстьГрупповыеЭтикетки;
	Элементы.ГруппаШаблонТранспортнойЭтикетки.Видимость = ЕстьТранспортныеЭтикетки;
	Элементы.ГруппаРазмерЭтикетки.Видимость = ЗначениеЗаполнено(РазмерЭтикетки);
	
	Элементы.ДекорацияРазмерЭтикеткиНеПоШаблону.Видимость =
	(ЗначениеЗаполнено(ШиринаЭтикеткиПоШаблону) И ШиринаЭтикетки <> ШиринаЭтикеткиПоШаблону)
	Или (ЗначениеЗаполнено(ВысотаЭтикеткиПоШаблону) И ВысотаЭтикетки <> ВысотаЭтикеткиПоШаблону);
	
	Элементы.ШаблонТоварнойЭтикетки.ОтметкаНезаполненного = ПечататьТоварныеЭтикетки И Не ЗначениеЗаполнено(ШаблонТоварнойЭтикетки);
	Элементы.ШаблонГрупповойЭтикетки.ОтметкаНезаполненного = ПечататьГрупповыеЭтикетки И Не ЗначениеЗаполнено(ШаблонГрупповойЭтикетки);
	Элементы.ШаблонТранспортнойЭтикетки.ОтметкаНезаполненного = ПечататьТранспортныеЭтикетки И Не ЗначениеЗаполнено(ШаблонТранспортнойЭтикетки);
	
	Элементы.ШаблонТоварнойЭтикетки.Доступность = ПечататьТоварныеЭтикетки;
	Элементы.ШаблонГрупповойЭтикетки.Доступность = ПечататьГрупповыеЭтикетки;
	Элементы.ШаблонТранспортнойЭтикетки.Доступность = ПечататьТранспортныеЭтикетки;
	
	РазмерПорции = МодульОбъекта().НастройкиМодуля().КоличествоЭтикетокВОднойПорцииПоУмолчанию;
	ТекстЗаголовка = НСтр("ru = 'Показать первые %1 шт'");
	ТекстЗаголовка = МодульОбъекта().ПараметрыВСтроку(ТекстЗаголовка, Формат(РазмерПорции, "ЧГ=0"));
	Элементы.Кнопка_ПоказатьПервуюПорциюЭтикеток.Заголовок = ТекстЗаголовка;
	
	Если ОсновнойСтатус = СтатусыОпераций.Новый Тогда
		Элементы.Кнопка_СформироватьЭтикетки.КнопкаПоУмолчанию = Истина;
	Иначе
		
		Элементы.Кнопка_ВыполнитьОперацию.КнопкаПоУмолчанию = Истина;
		Элементы.ПараметрыПечати_Лево.Доступность = Ложь;
		Элементы.ПараметрыПечати_Право.Доступность = Ложь;
		
		Если Не МодульОбъекта().ВерсияПлатформыНиже("8.3.12") Тогда
			Элементы.ГруппаПараметрыПечати.Скрыть();
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОперацияОснование) Тогда
		
		ТипОперацииОснования = МодульОбъекта().ЗначениеРеквизитаОбъекта_Марк(ОперацияОснование, "ТипОперации");
		
		Если ТипОперацииОснования = ТипыОпераций.НаполнениеАгрегатовНаТСД Тогда
			Элементы.ПараметрыПечати_Лево.Видимость = Ложь;
		КонецЕсли;
		Если ТипОперацииОснования = ТипыОпераций.АгрегацияКодов Тогда
			Элементы.ГруппаПараметрыПечати.Видимость = Ложь;
		КонецЕсли;
		
	Иначе
		Если ПечатьИзСвободногоОстатка Тогда
			Элементы.КоличествоКодовТребуется.ФорматРедактирования = "";
		КонецЕсли;
	КонецЕсли;
	
	Если КоличествоКодовТребуется = 0 Тогда
		Элементы.КоличествоКодовТребуется.ЦветТекста = WebЦвета.ТемноСерый;
	Иначе
		Элементы.КоличествоКодовТребуется.ЦветТекста = Новый Цвет();
	КонецЕсли;
	
	НастройкиМодуля = МодульОбъекта().НастройкиМодуля();
	Для Сч = 1 По МодульОбъекта().КоличествоПараметровСортировкиЭтикеток() Цикл
		ИмяПараметра = НастройкиМодуля["ДопПараметрПечатиИмя" + Сч];
		Элемент = Элементы["ДопПараметрПечати" + Сч];
		Элемент.Заголовок = ИмяПараметра;
		Элемент.Видимость = ЗначениеЗаполнено(ИмяПараметра);
	КонецЦикла;
	
	ОбновитьНадписьНастройкиСортировкиЭтикеток();
	
КонецПроцедуры

// #КонецОбласти //УстановкаВидимости

&НаСервере
Процедура УстановитьПодсказкуДатаПервичногоДокумента()
	
	Если Не Элементы.ГруппаОтчетОНанесенииНомерДата.Видимость Тогда
		Возврат;
	КонецЕсли;
	
	ТекстПодсказки = НСтр("ru = 'Указывается номер и дата первичного учетного документа,
		|подтверждающего факт производства продукции (для произведенной в РФ продукции)'");
	ВариантОтображенияПодсказки = "Кнопка";
	
	УстановитьПодсказкуЭлементаФормы(Элементы.ДатаДокументаОтчетОНанесении,
		ТекстПодсказки, ВариантОтображенияПодсказки);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПодсказкуМод()
	
	Если Не Элементы.ПлощадкаВводВОборот.Видимость
		И Не Элементы.ПлощадкаОтчетОНанесении.Видимость Тогда
		Возврат;
	КонецЕсли;
	
	ВидыПродукции = МодульОбъекта().Перечисление_ВидыПродукции();
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	
	ТекстПодсказкиПиво = НСтр("ru = 'Место осуществления деятельности из ЕГАИС'");
	ТекстПодсказкиБады = НСтр("ru = 'Производственная площадка из ФГИС ""ВетИС"", если товары подлежат ветеринарному контролю'");
	ВариантОтображенияПодсказки = "Кнопка";
	
	Если ВидПродукции = ВидыПродукции.Бады Тогда
		
		УстановитьПодсказкуЭлементаФормы(Элементы.ПлощадкаОтчетОНанесении
		, ТекстПодсказкиБады, ВариантОтображенияПодсказки);
		
	ИначеЕсли ВидПродукции = ВидыПродукции.Пиво
		Или ВидПродукции = ВидыПродукции.БезалкогольноеПиво Тогда
		
		Если МодульОбъекта().ЭтоОтчетОНанесении(ТипОперации) Тогда
			
			УстановитьПодсказкуЭлементаФормы(Элементы.ПлощадкаОтчетОНанесении
			, ТекстПодсказкиПиво, ВариантОтображенияПодсказки);
			
		ИначеЕсли ТипОперации = ТипыОпераций.ВводВОборот Тогда
			
			УстановитьПодсказкуЭлементаФормы(Элементы.ПлощадкаВводВОборот
			, ТекстПодсказкиПиво, ВариантОтображенияПодсказки);
			
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура УстановитьПодсказкуНомераПартииИНомераСерии()
	
	Если Не Элементы.НомерПартииОтчетОНанесении.Видимость
		И Не Элементы.НомерСерииОтчетОНанесении.Видимость Тогда
		Возврат;
	КонецЕсли;
	
	ТекстПодсказки = НСтр("ru = 'Допустимые символы:
	|- Буквы
	|- Цифры
	|- Пробел
	|- Символы / . , -'");
	ВариантОтображенияПодсказки = "Всплывающая";
	
	УстановитьПодсказкуЭлементаФормы(Элементы.НомерПартииОтчетОНанесении
	, ТекстПодсказки, ВариантОтображенияПодсказки);
	
	УстановитьПодсказкуЭлементаФормы(Элементы.НомерСерииОтчетОНанесении
	, ТекстПодсказки, ВариантОтображенияПодсказки);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПодсказкуИдентификатораГосКонтракта()
	
	Если Не Элементы.ИдентификаторГосКонтрактаВыводИзОборота.Видимость Тогда
		Возврат;
	КонецЕсли;
	
	ТекстПодсказки = НСтр("ru = 'Допустимые символы:
	|- Буквы
	|- Цифры
	|- Символы % & '' "" ( ) * + , - _ ./ : ; < = > ? !'");
	ВариантОтображенияПодсказки = "Всплывающая";
	
	УстановитьПодсказкуЭлементаФормы(Элементы.ИдентификаторГосКонтрактаВыводИзОборота
	, ТекстПодсказки, ВариантОтображенияПодсказки);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПодсказкуНомерПартииВыводаИзОборота()
	
	Если Не Элементы.НомерПартииВыводИзОборота.Видимость Тогда
