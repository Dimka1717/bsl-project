// #Область ОтменаВыводаИзОборота

&НаКлиенте
Процедура ОтменитьВыводИзОборота(Команда)
	
	Если ОперацияОграниченаТарифом Тогда
		МодульКлиента().ОткрытьФормуОграниченияПоТарифу(ЭтаФорма, Организация, ТипОперации);
		Возврат;
	КонецЕсли;
	
	ЗаголовокВопроса = НСтр("ru = 'Подписание и отправка в ГИС МТ'");
	ТекстВопроса = НСтр("ru = 'Документ на отмену вывода из оборота будет отправлен в ГИС МТ, продолжить?'");
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да, "Подписать и отправить");
	Кнопки.Добавить(КодВозвратаДиалога.Нет, "Отмена");
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("ОтменитьВыводИзОборота_ПослеСогласия", ЭтаФорма);
	
	МодульКлиента().ПоказатьДиалогВопроса(ОписаниеОбработчика, ТекстВопроса, Кнопки, ЗаголовокВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВыводИзОборота_ПослеСогласия(Ответ, ДопПараметры = Неопределено) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	СоздатьОперациюОтменыВыводаИзОборота();
	
	МодульКлиента().ВыполнитьОбменПоОрганизации(ЭтаФорма, Организация, ДокументУчета);
	
	ОтменитьВыводИзОборота_ПослеСогласияНаСервере();
	
	Оповестить("КонтурМаркировка_Операция_Изменен", ДокументУчета);
	
КонецПроцедуры

&НаСервере
Процедура ОтменитьВыводИзОборота_ПослеСогласияНаСервере()
	
	ЗаполнитьКонтекстФормы();
	УстановитьВидимостьПоСтатусу();
	
КонецПроцедуры

&НаСервере
Процедура СоздатьОперациюОтменыВыводаИзОборота()
	
	ТипОперации = МодульОбъекта().Перечисление_ТипыОпераций().ОтменаВыводаИзОборота;
	ОперацияОтмены = МодульОбъекта().Операция_Создать(ТипОперации, ДокументУчета,Ссылка);
	
	МодульОбъекта().Задача_Создать(ОперацияОтмены);
	
КонецПроцедуры

// #КонецОбласти

// #Область ПараметрыОперацииПечати

&НаКлиенте
Процедура Коды_ЗаполнитьОперациюПечати(Команда)
	
	Если Не ПроверитьВозможностьПечати() Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьОперациюПечати();
	
	Если КоличествоКодов = 0 Тогда
		МодульКлиента().СообщитьПользователюЛок(НСтр("ru = 'Не удалось подобрать коды для печати'"), УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьВозможностьПечати()
	
	Если Не ПечатьИзСвободногоОстатка
		Или ЗначениеЗаполнено(ОперацияОснование) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТекстСообщения = НСтр("ru = 'Укажите параметры заполнения печати кодами'");
	
	ЕстьОтборПоТовару = (ЗначениеЗаполнено(Товар) И ЗначениеЗаполнено(КоличествоКодовТребуется));
	ЕстьОтборПоНоменклатуре1С = (ЗначениеЗаполнено(КлючНоменклатуры1С) И ЗначениеЗаполнено(КоличествоКодовТребуется));
	
	Если Не ЗначениеЗаполнено(Товар)
		И Не ЗначениеЗаполнено(КлючНоменклатуры1С)
		И Не ЗначениеЗаполнено(КоличествоКодовТребуется) Тогда
		МодульКлиента().СообщитьПользователюЛок(ТекстСообщения, УникальныйИдентификатор, "Товар");
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КоличествоКодовТребуется) Тогда
		МодульКлиента().СообщитьПользователюЛок(ТекстСообщения, УникальныйИдентификатор, "КоличествоКодовТребуется");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьОперациюПечати()
	
	ОписаниеОперации = ОписаниеОперацииПоКонтекстуФормы();
	
	Если Модифицированность Тогда
		СохранитьОперацию(ОписаниеОперации);
	КонецЕсли;
	
	МодульОбъекта().Операция_ЗаполнитьКодами(ОписаниеОперации);
	
	ЗаполнитьШаблоныЭтикеток();
	ПосчитатьКоличествоСтрокТаблицФормы();
	ЗаполнитьПараметрыПечатиЭтикетокПоШаблону();
	НастроитьЭлементыФормы_ПечатьКодов();
	
	Элементы.КодыМаркировки.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьШаблоныЭтикеток()
	
	ОписаниеОперации = ОписаниеОперацииПоКонтекстуФормы();
	МодульОбъекта().Операция_ПечатьКодов_ЗаполнитьШаблоныЭтикеток(ОписаниеОперации);
	ЗаполнитьКонтекстФормы(ОписаниеОперации);
	СохранитьОперацию(ОписаниеОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура КоличествоКодовТребуетсяПриИзменении(Элемент)
	
	НастроитьЭлементыФормы_ПечатьКодов();
	
КонецПроцедуры

&НаКлиенте
Процедура КоличествоКодовТребуетсяИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	Элементы.КоличествоКодовТребуется.ЦветТекста = Новый Цвет();
КонецПроцедуры

&НаСервере
Процедура ОбновитьНадписьНастройкиСортировкиЭтикеток(ПараметрыСортировки = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(ПараметрыСортировки) Тогда
		ПараметрыСортировки = Новый_ПараметрыСортировкиЭтикеток();
		ЗаполнитьЗначенияСвойств(ПараметрыСортировки, ЭтаФорма);
	КонецЕсли;
	
	ЕстьНастройкиСортировки = ЗначениеЗаполнено(ПараметрыСортировки.ПолеСортировкиЭтикеток1);
	
	Элементы.НастройкиСортировкиЭтикеток.Видимость = ЕстьНастройкиСортировки;
	Если НЕ ЕстьНастройкиСортировки Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонОписанияСортировки = НСтр("ru='Сортировка: %1'");
	ПредставлениеНастроек = МодульОбъекта().ПредставлениеСортировкиЭтикеток(ПараметрыСортировки);
	
	Элементы.НастройкиСортировкиЭтикеток.Заголовок = МодульОбъекта().ПараметрыВСтроку(ШаблонОписанияСортировки, ПредставлениеНастроек);
	
КонецПроцедуры

// #КонецОбласти

// #Область ТрансформацияАгрегатов

&НаКлиенте
Процедура КодАгрегатаПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(КодМаркировки) Тогда
		КлючКода = Неопределено;
		СохранитьОперацию();
		Возврат;
	КонецЕсли;
	
	КодМаркировки = СокрЛП(КодМаркировки);
	
	КлючКода = МодульКлиента().КодМаркировки_НайтиКлюч(КодМаркировки);
	
	Если Не ЗначениеЗаполнено(КлючКода) Тогда
		Если МодульКлиента().ВыполнитьАвторизацию(Организация, ЭтаФорма) Тогда
			СоздатьАгрегатНаСервере();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КодАгрегатаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	МодульКлиента().ОткрытьФормуКодаМаркировки(КлючКода, Организация, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьАгрегатНаСервере()
	
	ТаблицаКодов = МодульОбъекта().Новый_ТаблицаКодов();
	Стр = ТаблицаКодов.Добавить();
	Стр.КодМаркировки = КодМаркировки;
	Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка;
	МодульОбъекта().ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация);
	МодульОбъекта().ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
	
	КлючКода = МодульОбъекта().КодМаркировки_НайтиКлюч(КодМаркировки);
	
	СохранитьОперацию();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПродукцииТрансофрмацияАгрегатаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ЗначенияСписка = МодульКлиента().ДопустимыеВидыПродукцииДляТрансформацииАгрегата();
	МодульКлиента().ЗаполнитьСписокВыбора(Элемент.СписокВыбора, ЗначенияСписка);
	
КонецПроцедуры

// #КонецОбласти

// #Область АТК

&НаКлиенте
Процедура КодАТКПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(КодМаркировки) Тогда
		КлючКода = Неопределено;
		СохранитьОперацию();
		Возврат;
	КонецЕсли;
	
	КодМаркировки = СокрЛП(КодМаркировки);
	
	КлючКода = МодульКлиента().КодМаркировки_НайтиКлюч(КодМаркировки);
	
	Если ЗначениеЗаполнено(КлючКода) Тогда
		ВидПродукции = МодульКлиента().КодМаркировки_ВидПродукции(КлючКода);
	Иначе
		Если МодульКлиента().ВыполнитьАвторизацию(Организация, ЭтаФорма) Тогда
			СоздатьАТКНаСервере();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПродукцииАТКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ЗначенияСписка = МодульКлиента().ДопустимыеВидыПродукцииДляФормированияАТК();
	МодульКлиента().ЗаполнитьСписокВыбора(Элемент.СписокВыбора, ЗначенияСписка);
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаТНВЭДПриИзменении(Элемент)
	
	ПерезаполнитьТаблицыОперации();
	
КонецПроцедуры

&НаКлиенте
Процедура АТКОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	МодульКлиента().ОткрытьФормуКодаМаркировки(КлючКода, Организация, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьАТКНаСервере()
	
	ТаблицаКодов = МодульОбъекта().Новый_ТаблицаКодов();
	Стр = ТаблицаКодов.Добавить();
	Стр.КодМаркировки = КодМаркировки;
	Стр.ВидПродукции = ВидПродукции;
	Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.АТК;
	МодульОбъекта().ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация);
	МодульОбъекта().ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
	
	КлючКода = МодульОбъекта().КодМаркировки_НайтиКлюч(КодМаркировки);
	
	СохранитьОперацию();
	
КонецПроцедуры

// #КонецОбласти

// #Область КорректировкаСведенийОКодах

&НаКлиенте
Процедура ВидПродукцииКорректировкаСведенийОКодахНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ЗначенияСписка = МодульКлиента().ДопустимыеВидыПродукцииДляКорректировкиСведенийОКодах();
	МодульКлиента().ЗаполнитьСписокВыбора(Элемент.СписокВыбора, ЗначенияСписка);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПродукцииКорректировкаСведенийПриИзменении(Элемент)
	
	ДопустимыеВидыСведений = МодульКлиента().ДопустимыеВидыКорректируемыхСведенийОКодах(ВидПродукции);
	Если ДопустимыеВидыСведений.Найти(ВидКорректируемыхСведений) = Неопределено Тогда
		ВидКорректируемыхСведений = Неопределено;
	КонецЕсли;
	
	ВидПродукцииКорректировкаСведенийПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ВидПродукцииКорректировкаСведенийПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(ДокументУчета) Или ЗначениеЗаполнено(ОперацияОснование) Тогда
		ПерезаполнитьТаблицыОперации();
	КонецЕсли;
	
	НастроитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПродукцииКорректировкаСведенийОКодахПослеВыбора(ВыбранноеЗначение, ДопРеквизит = Неопределено) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВидПродукции = ВыбранноеЗначение.Значение;
	
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидКорректируемыхСведенийНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ЗначенияСписка = МодульКлиента().ДопустимыеВидыКорректируемыхСведенийОКодах(ВидПродукции);
	МодульКлиента().ЗаполнитьСписокВыбора(Элемент.СписокВыбора, ЗначенияСписка);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидКорректируемыхСведенийПриИзменении(Элемент)
	
	ВидКорректируемыхСведенийПриИзмененииНаСервере();
	
	УстановитьПодсказкуФормы();
	
КонецПроцедуры

&НаСервере
Процедура ВидКорректируемыхСведенийПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(ДокументУчета)
		Или ЗначениеЗаполнено(ОперацияОснование) Тогда
		ПерезаполнитьТаблицыОперации();
	КонецЕсли;
	
	НастроитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьКодыИзОперации(Команда)
	
	Если Не ЗначениеЗаполнено(Элементы.КодыМаркировки.ВыделенныеСтроки) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'Выбранные коды будут удалены из операции, продолжить?'");
	Кнопки = РежимДиалогаВопрос.ДаНет;
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("УдалитьКодыИзОперацииПослеСогласия", ЭтаФорма);
	МодульКлиента().ПоказатьДиалогВопроса(ОписаниеОбработчика, ТекстВопроса, Кнопки);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьКодыИзОперацииПослеСогласия(Ответ, ДопПараметры = Неопределено) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		УдалитьКодыИзОперацииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьКодыИзОперацииНаСервере()
	
	КлючиКодов = Новый Массив;
	Для каждого Стр Из Элементы.КодыМаркировки.ВыделенныеСтроки Цикл
		КлючиКодов.Добавить(Стр.КлючКода);
	КонецЦикла;
	
	МодульОбъекта().КодыОпераций_УдалитьКоды(Ссылка, КлючиКодов);
	
	Элементы.КодыМаркировки.Обновить();
	ЗаполнитьКонтекстФормы();
	
КонецПроцедуры

// #КонецОбласти

// #Область ОпросыПользователей

&НаКлиенте
Процедура ПровестиОпросПользователяИЗакрыть()
	
	КлючСценария = КлючСценарияПоТипуОперации(ТипОперации);
	ОписаниеОпроса = ОпросПользователяПоСценарию(КлючСценария);
	
	Если ЗначениеЗаполнено(ОписаниеОпроса) Тогда
		ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("ПослеОпросаПользователя", ЭтаФорма);
		МодульКлиента().ОткрытьФормуОпросаПользователя(ОписаниеОпроса, ЭтаФорма, ОписаниеОбработчика);
		Возврат;
	КонецЕсли;
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОпросаПользователя(РезультатВыбора, ДопПараметры = Неопределено) Экспорт
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Функция КлючСценарияПоТипуОперации(ТипОперации)
	
	ТипыОпераций = МодульКлиента().Перечисление_ТипыОпераций();
	КлючиСценариев = МодульКлиента().Перечисление_КлючиСценариевДляОпросов();
	
	СценарийПоТипуОперации = Новый Соответствие;
	СценарийПоТипуОперации.Вставить(ТипыОпераций.ЗаказКодов,               КлючиСценариев.ЗаказКодов);
	СценарийПоТипуОперации.Вставить(ТипыОпераций.ОтчетОНанесении,          КлючиСценариев.ОтчетОНанесении);
	СценарийПоТипуОперации.Вставить(ТипыОпераций.ВводВОборот,              КлючиСценариев.ВводВОборот);
	СценарийПоТипуОперации.Вставить(ТипыОпераций.АгрегацияКодов,           КлючиСценариев.ДобавлениеКИТУ);
	СценарийПоТипуОперации.Вставить(ТипыОпераций.РегистрацияАгрегатов,     КлючиСценариев.ДобавлениеКИТУ);
	СценарийПоТипуОперации.Вставить(ТипыОпераций.РасформированиеАгрегатов, КлючиСценариев.РасформированиеКИТУ);
	СценарийПоТипуОперации.Вставить(ТипыОпераций.ДобавлениеВАгрегат,       КлючиСценариев.ТрансформацияКИТУ);
	СценарийПоТипуОперации.Вставить(ТипыОпераций.ИзъятиеИзАгрегата,        КлючиСценариев.ТрансформацияКИТУ);
	СценарийПоТипуОперации.Вставить(ТипыОпераций.РегистрацияКИГУ,          КлючиСценариев.РегистрацияКИГУ);
	СценарийПоТипуОперации.Вставить(ТипыОпераций.ОтчетОВыбытии,            КлючиСценариев.ОтчетОВыбытии);
	СценарийПоТипуОперации.Вставить(ТипыОпераций.ВыводИзОборота,           КлючиСценариев.ВыводИзОборота);
	СценарийПоТипуОперации.Вставить(ТипыОпераций.ВозвратВОборот,           КлючиСценариев.ВозвратВОборот);
	СценарийПоТипуОперации.Вставить(ТипыОпераций.Перемаркировка,           КлючиСценариев.Перемаркировка);
	СценарийПоТипуОперации.Вставить(ТипыОпераций.ПечатьКодов,              КлючиСценариев.Печать);
	СценарийПоТипуОперации.Вставить(ТипыОпераций.ФормированиеАТК,          КлючиСценариев.ФормированиеАТК);
	СценарийПоТипуОперации.Вставить(ТипыОпераций.РасформированиеАТК,       КлючиСценариев.РасформированиеАТК);
	СценарийПоТипуОперации.Вставить(ТипыОпераций.ДобавлениеВАТК,           КлючиСценариев.ТрансформацияАТК);
	СценарийПоТипуОперации.Вставить(ТипыОпераций.ИзъятиеИзАТК,             КлючиСценариев.ТрансформацияАТК);
	СценарийПоТипуОперации.Вставить(ТипыОпераций.СообщениеОбОтгрузке,      КлючиСценариев.СообщениеОбОтгрузке);
	СценарийПоТипуОперации.Вставить(ТипыОпераций.РегистрацияНаборов,       КлючиСценариев.РегистрацияНаборов);
	
	Результат = СценарийПоТипуОперации.Получить(ТипОперации);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ОпросПользователяПоСценарию(КлючСценария)
	
	Результат = МодульКлиента().ОпросПользователяПоСценарию(КлючСценария);
	
	Если Не ЗначениеЗаполнено(Результат)
		Или Не МодульКлиента().ОпросПодходитПоВидуПродукции(Результат, ВидПродукции) Тогда
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти

// #Область МобильныеУстройства

&НаКлиенте
Процедура ПодборСПомощьюМобильногоУстройстваПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(МобильноеУстройство)
		И Не ПодборСПомощьюМобильногоУстройства Тогда
		СтароеМобильноеУстройство = МобильноеУстройство;
		МобильноеУстройство = Неопределено;
	КонецЕсли;
	
	Если ПодборСПомощьюМобильногоУстройства Тогда
		МобильноеУстройство = СтароеМобильноеУстройство;
	КонецЕсли;
	
	НастроитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВернутьНаТекущееУстройство(Команда)
	
	Действие = НСтр("ru = 'Вернуть на текущее устройство'");
	Если Не МодульКлиента().ДоступенPATCHЗапрос(Действие) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не МодульКлиента().ВыполнитьАвторизацию(Организация, ЭтаФорма) Тогда
		Возврат;
	КонецЕсли;
	
	Подсказка = НСтр("ru = 'Комментарий для сотрудника'");
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("Коды_ВозвратНаТСДПослеВводаКомментария", ЭтаФорма);
	МодульКлиента().ПоказатьДиалогВводаСтроки(ОписаниеОбработчика, , Подсказка, , Истина);
	
КонецПроцедуры

&НаСервере
Процедура ВернутьНаДругоеУстройствоНаСервере()
	
	СохранитьОперацию();
	
	МодульОбъекта().Операция_ВернутьКодыНаТСД(Ссылка, КомментарийВозвратаНаТСД);
	
	ЗаполнитьКонтекстФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВернутьНаДругоеУстройство(Команда)
	
	Действие = НСтр("ru = 'Вернуть на другое устройство'");
	Если Не МодульКлиента().ДоступенPATCHЗапрос(Действие) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не МодульКлиента().ВыполнитьАвторизацию(Организация, ЭтаФорма) Тогда
		Возврат;
	КонецЕсли;
	
	ВернутьНаДругоеУстройство_РедактироватьДанныеПередОтправкой();
	
КонецПроцедуры

&НаКлиенте
Процедура ВернутьНаДругоеУстройство_РедактироватьДанныеПередОтправкой()
	
	КонтекстФормы = Новый Структура;
	КонтекстФормы.Вставить("КомментарийВозвратаНаТСД", КомментарийВозвратаНаТСД);
	КонтекстФормы.Вставить("МобильноеУстройство", МобильноеУстройство);
	КонтекстФормы.Вставить("ВернутьНаДругоеУстройство", Ложь);
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("ОбработатьВозвратНаДругоеУстройство", ЭтаФорма);
	МодульКлиента().ОткрытьФормуРеквизитовДоставки(ЭтаФорма, КонтекстФормы, ОписаниеОбработчика);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВозвратНаДругоеУстройство(НовыеЗначения, ДопПараметры = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(НовыеЗначения) Тогда
		Возврат;
	КонецЕсли;
	
	Если НовыеЗначения.МобильноеУстройство = МобильноеУстройство Тогда
		Возврат;
	КонецЕсли;
	
	Если Не НовыеЗначения.ВернутьНаДругоеУстройство Тогда
		Возврат;
	КонецЕсли;
	
	СтароеМобильноеУстройство = МобильноеУстройство;
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, НовыеЗначения);
	
	Коды_ВозвратНаТСДНаСервере(КомментарийВозвратаНаТСД);
	
	Оповестить("КонтурМаркировка_Операция_Изменен", ДокументУчета);
	
	Если ОсновнойСтатус <> МодульКлиента().Перечисление_СтатусыОпераций().ОшибкаОбработки Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НазначитьДругойТСДНаСервере()
	
	СохранитьОперацию();
	МодульОбъекта().Операция_НазначитьНаДругоеУстройство(Ссылка);
	ЗаполнитьКонтекстФормыИУстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура НазначитьДругойТСД(Команда)
	
	Действие = НСтр("ru = 'Назначить на другое устройство'");
	Если Не МодульКлиента().ДоступенPATCHЗапрос(Действие) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не МодульКлиента().ВыполнитьАвторизацию(Организация, ЭтаФорма) Тогда
		Возврат;
	КонецЕсли;
	
	НазначитьДругойТСД_РедактироватьДанныеПередОтправкой();
	
КонецПроцедуры

&НаКлиенте
Процедура НазначитьДругойТСД_РедактироватьДанныеПередОтправкой()
	
	КонтекстФормы = Новый Структура;
	КонтекстФормы.Вставить("АдресДоставки", АдресДоставки);
	КонтекстФормы.Вставить("КонтрагентНаименование", КонтрагентНаименование);
	КонтекстФормы.Вставить("КонтактныйТелефон", КонтактныйТелефон);
	КонтекстФормы.Вставить("МобильноеУстройство", МобильноеУстройство);
	КонтекстФормы.Вставить("НазначитьНаДругоеУстройство", Ложь);
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("ОбработатьНазначениеНаДругойТСД", ЭтаФорма);
	МодульКлиента().ОткрытьФормуРеквизитовДоставки(ЭтаФорма, КонтекстФормы, ОписаниеОбработчика);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНазначениеНаДругойТСД(НовыеЗначения, ДопПараметры = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(НовыеЗначения) Тогда
		Возврат;
	КонецЕсли;
	
	Если НовыеЗначения.МобильноеУстройство = МобильноеУстройство Тогда
		Возврат;
	КонецЕсли;
	
	Если Не НовыеЗначения.НазначитьНаДругоеУстройство Тогда
		Возврат;
	КонецЕсли;
	
	СтароеМобильноеУстройство = МобильноеУстройство;
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, НовыеЗначения);
	
	Элементы.СсылкаИнформацияОДоставке.Заголовок = Заголовок_ИнформацияОДоставке();
	
	НазначитьДругойТСДНаСервере();
	
	Оповестить("КонтурМаркировка_Операция_Изменен", ДокументУчета);
	
	Если ОсновнойСтатус <> МодульКлиента().Перечисление_СтатусыОпераций().ОшибкаОбработки Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

