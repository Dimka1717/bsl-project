// Информация по товару

&НаКлиенте
Процедура КодыВходящегоУПДПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.КодыВходящегоУПД.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Стр = КорневаяСтрокаДерева(ТекущиеДанные);
	
	// Реквизиты формы
	Если ЗначениеЗаполнено(ТекущиеДанные.GTIN) Тогда
		GTIN = ТекущиеДанные.GTIN;
	Иначе
		GTIN = Стр.GTIN;
	КонецЕсли;
	КодОСУ = Стр.КодОСУ;
	ТоварВходящегоУПД = НайтиТоварПоGTIN(GTIN);
	КоличествоПоТовару = Стр.КоличествоКодов;
	НаименованиеТовараВходящегоУПД = Стр.НаименованиеТовара;
	
	КодОСУВалидный = Стр.КодОСУВалидный;
	РазрешенаОтгрузкаПоОСУ = Стр.РазрешенаОтгрузкаПоОСУ;
	ЗарегистрированВГИСМТ = Стр.ЗарегистрированВГИСМТ;
	ВсегоКодов = Стр.КоличествоКодов;
	КодовСОшибками = Стр.КодовСОшибками;
	Отсканировано = Стр.Отсканировано;
	КорректныйФорматКода = ТекущиеДанные.КорректныйФорматКода <> Ложь;
	
	ЕстьGTIN = ЗначениеЗаполнено(GTIN);
	ЕстьОСУ = ЗначениеЗаполнено(КодОСУ);
	ЕстьКоды = ЗначениеЗаполнено(ВсегоКодов);
	ЕстьТовар = ЗначениеЗаполнено(ТоварВходящегоУПД);
	ЕстьКодыСОшибками = ЗначениеЗаполнено(КодовСОшибками);
	
	Если ЕстьКоды Тогда
		ПроцентОтсканировано = Цел(Отсканировано * 100 / ВсегоКодов);
		ОтсканированоПоТовару = МодульКлиента().ПараметрыВСтроку("%1/%2 (%3%)"
		, Отсканировано, ВсегоКодов, ПроцентОтсканировано);
	КонецЕсли;
	
	Если ЕстьТовар Тогда
		СтрокаЗаголовка = НСтр("ru = 'Товар в системе %1'");
		СтрокаЗаголовка = МодульКлиента().ПараметрыВСтроку(СтрокаЗаголовка, GTIN);
		Элементы.СсылкаНаТоварПоGTIN.Заголовок = СтрокаЗаголовка;
	КонецЕсли;
	
	Если ЕстьКодыСОшибками Тогда
		СтрокаЗаголовка = НСтр("ru = 'Недопустимых кодов маркировки: %1'");
		СтрокаЗаголовка = МодульКлиента().ПараметрыВСтроку(СтрокаЗаголовка, КодовСОшибками);
		Элементы.ДекорацияНедопустимыхКодовПоТовару.Заголовок = СтрокаЗаголовка;
	КонецЕсли;
	
	Элементы.ГруппаGTIN.Видимость = ЕстьGTIN;
	Элементы.ГруппаКодОСУ.Видимость = ЕстьОСУ;
	Элементы.ГруппаКоличество.Видимость = ЕстьКоды;
	Элементы.ГруппаОтсканировано.Видимость = ЕстьКоды;
	Элементы.СсылкаНаТоварПоGTIN.Видимость = ЕстьТовар;
	Элементы.ГруппаВидПродукции.Видимость = ЕстьТовар;
	Элементы.ДекорацияНедопустимыхКодовПоТовару.Видимость = ЕстьКодыСОшибками;
	Элементы.ДекорацияКодПоОСУНеверный.Видимость = ЕстьОСУ И Не КодОСУВалидный;
	Элементы.ДекорацияЗапрещенаПередачаПоОСУ.Видимость = ЕстьОСУ И Не РазрешенаОтгрузкаПоОСУ;
	Элементы.ДекорацияGTINНеЗарегистрирован.Видимость = ЕстьОСУ И Не ЗарегистрированВГИСМТ;
	Элементы.ДекорацияНеКорректныйФорматКода.Видимость = Не КорректныйФорматКода;
	
	ЭтаФорма.ТекущийЭлемент = Элементы.КодыВходящегоУПД;
	
КонецПроцедуры

&НаКлиенте
Функция КорневаяСтрокаДерева(СтрокаДерева)
	
	Родитель = СтрокаДерева.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда
		Возврат СтрокаДерева;
	Иначе
		Возврат КорневаяСтрокаДерева(Родитель);
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция НайтиТоварПоGTIN(GTIN)
	
	Если Не ЗначениеЗаполнено(GTIN) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если КэшТоваров = Неопределено Тогда
		КэшТоваров = Новый Соответствие;
	КонецЕсли;
	
	Результат = Неопределено;
	
	Если Не КэшТоваров[GTIN] = Неопределено Тогда
		Результат = КэшТоваров[GTIN];
	Иначе
		
		Товар = НайтиТоварПоGTINНаСервере(GTIN);
		Если ЗначениеЗаполнено(Товар) Тогда
			Результат = Товар;
			КэшТоваров.Вставить(GTIN, Товар);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция НайтиТоварПоGTINНаСервере(GTIN)
	
	Возврат МодульОбъекта().НайтиТоварПоGTIN(GTIN);
	
КонецФункции

