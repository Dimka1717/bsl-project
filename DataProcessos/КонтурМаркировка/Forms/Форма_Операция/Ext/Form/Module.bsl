&НаКлиенте
Процедура УведомлениеОПриемке_ПринятьЧастично_ПослеСогласия(Ответ, ДопПараметры = Неопределено) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если Не МодульКлиента().ВыполнитьАвторизацию(Организация, ЭтаФорма) Тогда
		Возврат;
	КонецЕсли;
	
	УведомлениеОПриемке_ПринятьЧастичноНаСервере();
	
	МодульКлиента().ВыполнитьОбменПоОрганизации(ЭтаФорма, Организация);
	
	ЗаполнитьКонтекстФормыИУстановитьВидимость();
	
	Оповестить("КонтурМаркировка_Операция_Изменен");
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура УведомлениеОПриемке_ПринятьЧастично(Команда)
	
	Если ОперацияОграниченаТарифом Тогда
		МодульКлиента().ОткрытьФормуОграниченияПоТарифу(ЭтаФорма, Организация, ТипОперации);
		Возврат;
	КонецЕсли;
	
	ЭтоЧастичнаяПриемка = Истина;
	Если Не ПроверитьОбязательныеРеквизитыУведомленияОПриемке(ЭтоЧастичнаяПриемка) Тогда
		Возврат;
	КонецЕсли;
	
	Действие = НСтр("ru = 'Принять частично'");
	Если Не МодульКлиента().ДоступенPATCHЗапрос(Действие) Тогда
		Возврат;
	КонецЕсли;
	
	СтатусыСверкиНаТСД = МодульКлиента().Перечисление_СтатусыСверкиНаТСД();
	
	Если СтатусСверкиНаТСД = СтатусыСверкиНаТСД.СверкаПроизведенаНетКодов
		Или СтатусСверкиНаТСД = СтатусыСверкиНаТСД.СверкаПроизведенаЧастично Тогда
		
		ЗаголовокВопроса = НСтр("ru = 'Подписание и отправка в ГИС МТ'");
		ТекстВопроса = НСтр("ru = 'Сверка кодов на ТСД произведена не полностью. Приняты
		|будут коды отсканированные и найденные в документе. Продолжить?'");
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, "Подписать и отправить");
		Кнопки.Добавить(КодВозвратаДиалога.Нет, "Отмена");
		
		ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("УведомлениеОПриемке_ПринятьЧастично_ПослеСогласия", ЭтаФорма);
		
		МодульКлиента().ПоказатьДиалогВопроса(ОписаниеОбработчика, ТекстВопроса, Кнопки, ЗаголовокВопроса);
		
	Иначе
		
		УведомлениеОПриемке_ПринятьЧастично_ПослеСогласия(КодВозвратаДиалога.Да);
		
	КонецЕсли;
		
		
КонецПроцедуры

&НаСервере
Процедура СведенияОТоварах_ЗаполнитьСтатусПриемки(СтрокиДерева)
	
	СтатусыПриемки = МодульОбъекта().Перечисление_СтатусыПриемки();
	СтатусыТовараНаСверке = МодульОбъекта().Перечисление_СтатусыТовараНаСверке();
	
	Для каждого СтрокаДЗ Из СтрокиДерева Цикл
		
		СведенияОТоварах_ЗаполнитьСтатусПриемки(СтрокаДЗ.Строки);
		
		Если Не ЗначениеЗаполнено(СтрокаДЗ.СтатусТовараНаСверке) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтатусПриемки = СтатусыПриемки.ПринятоЧастично Тогда
			СтрокаДЗ.Принято = (СтрокаДЗ.СтатусТовараНаСверке = СтатусыТовараНаСверке.НайденВДокументе);
		Иначе
			СтрокаДЗ.Принято = (СтрокаДЗ.СтатусТовараНаСверке = СтатусыТовараНаСверке.НайденВДокументе
			ИЛИ СтрокаДЗ.СтатусТовараНаСверке = СтатусыТовараНаСверке.НеОтсканированНаСкладе);
		КонецЕсли;
		
		Если СтрокаДЗ.Принято = Истина Тогда
			СтрокаДЗ.КартинкаПринято = 5;
		ИначеЕсли СтрокаДЗ.Принято = Ложь Тогда
			СтрокаДЗ.КартинкаПринято = 3;
		Иначе
			СтрокаДЗ.КартинкаПринято = 0;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СведенияОТоварах_ДополнитьДаннымиТоваров(Знач СтрокиДерева = Неопределено)
	
	Если СтрокиДерева = Неопределено Тогда
		СтрокиДерева = СведенияОТоварах.ПолучитьЭлементы();
	КонецЕсли;
	
	Для каждого СтрокаДЗ Из СтрокиДерева Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаДЗ.Товар) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаДЗ.КодТНВЭД) Тогда
			СтрокаДЗ.КодТНВЭД = СтрокаДЗ.Товар.КодТНВЭД;
		КонецЕсли;
		
		СтрокаДЗ.ПеременныйВес = СтрокаДЗ.Товар.ПеременныйВес;
		
		СведенияОТоварах_ДополнитьДаннымиТоваров(СтрокаДЗ.ПолучитьЭлементы());
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСведенияОТоварах(ОписаниеОперации)
	
	ДеревоСведенийОТоварах = МодульОбъекта().Операция_УведомлениеОПриемке_СведенияОТоварах(ОписаниеОперации);
	
	Если ДеревоСведенийОТоварах.Колонки.Найти("ПеременныйВес") = Неопределено Тогда
		ДеревоСведенийОТоварах.Колонки.Добавить("ПеременныйВес", Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ДеревоСведенийОТоварах, "СведенияОТоварах");
	
	СведенияОТоварах_ДополнитьДаннымиТоваров();
	
КонецПроцедуры

&НаКлиенте
Процедура СведенияОТоварахВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТоварСсылка = Элемент.ТекущиеДанные.Товар;
	
	Если Поле.Имя = "СведенияОТоварахТовар" И ЗначениеЗаполнено(ТоварСсылка) Тогда
		МодульКлиента().ОткрытьФормуТовара(ТоварСсылка, ЭтаФорма);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СведенияОТоварахПередНачаломИзменения(Элемент, Отказ)
	
	ИмяЭлемента = Элемент.ТекущийЭлемент.Имя;
	ЭтоСтрокаКода = ЗначениеЗаполнено(Элемент.ТекущиеДанные.КодМаркировки);
	РодительСтроки = Элемент.ТекущиеДанные.ПолучитьРодителя();
	
	РедактированиеРазрешено = ЗначениеЗаполнено(Элемент.ТекущиеДанные.Товар)
	ИЛИ (ЭтоСтрокаКода И ИмяЭлемента = "СведенияОТоварахЦена")
	ИЛИ (ЭтоСтрокаКода И ИмяЭлемента = "СведенияОТоварахСуммаНДС")
	ИЛИ (РодительСтроки = Неопределено И ИмяЭлемента = "СведенияОТоварахКодТНВЭД");
	
	Если Не РедактированиеРазрешено Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

