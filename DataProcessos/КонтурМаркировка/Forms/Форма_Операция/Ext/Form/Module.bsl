Функция ПодсказкаВыполняетсяОбновлениеДанных()
	
	Результат = "";
	
	Если ВыполняетсяОбновлениеДанных Тогда
		Результат = НСтр("ru = 'Работа с объектом заблокирована. Выполняется обновление данных.'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПодсказкаЗаказКодовНаборовНаОстатки()
	
	Результат = "";
	ВидыПродукции = МодульКлиента().Перечисление_ВидыПродукции();
	ТипыОпераций = МодульКлиента().Перечисление_ТипыОпераций();
	СпособыВыпуска = МодульКлиента().Перечисление_СпособыВыпускаТоваров();
	ТипыКодовМаркировки = МодульКлиента().Перечисление_ТипыКодовМаркировки();
	
	Если ТипОперации = ТипыОпераций.ЗаказКодов
		И ВидПродукции = ВидыПродукции.Легпром
		И СпособВыпускаТоваров = СпособыВыпуска.Остатки
		И ТипКодаМаркировки = ТипыКодовМаркировки.Набор Тогда
		Результат = НСтр("ru = 'Для кодов маркировки со способом выпуска “Маркировка остатков” будет доступен ввод в оборот только по товарам из списка расширения.
		|Возврат денежных средств по заказанным КМ на товары, которые подлежат маркировке с 01.01.2021 года, со способом выпуска “Маркировка остатков” произведены не будут.'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПодсказкаВыводИзОборотаОСУВес()
	
	ТипыОпераций = МодульКлиента().Перечисление_ТипыОпераций();
	ВидыПродукции = МодульКлиента().Перечисление_ВидыПродукции();
	ФичаФлаги = МодульКлиента().Перечисление_ФичаФлаги();
	
	Если ТипОперации <> ТипыОпераций.ВыводИзОборота Тогда
		Возврат "";
	КонецЕсли;

	Если Не ОбъемноСортовойУчет
		Или ВидПродукции <> ВидыПродукции.Молоко
		Или Не Товары_ЕстьПеременныйВес() Тогда
		Возврат "";
	КонецЕсли;
	
	Если МодульКлиента().ФичаФлагВключен(ФичаФлаги.КонтрольВесВыводИзОборотаМолокоОСУ) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат НСтр(
	"ru = 'Если в строке товара с переменным весом не указано значение веса, то на склад ГИС МТ
	|будет передано среднее арифметическое значений атрибутов ""Диапазон веса, от"" и ""Диапазон веса, до"",
	|указанных в карточке товара в НКМТ.'");
	
КонецФункции

&НаКлиенте
Функция ПодсказкаКорректировкаСведенийОКодах()
	
	Результат = "";
	ТипыОпераций = МодульКлиента().Перечисление_ТипыОпераций();
	
	Если ТипОперации <> ТипыОпераций.КорректировкаСведенийоКодах
		Или Не ЗначениеЗаполнено(ВидКорректируемыхСведений) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидыСведений = МодульКлиента().Перечисление_ВидыКорректируемыхСведений();
	Если ВидКорректируемыхСведений = ВидыСведений.ИдентификаторВСД Тогда
		Результат = НСтр("ru = 'Изменение ВСД доступно только для единиц товара в статусах"
		+ " «В обороте», «Выведен из оборота», «Списан». Коды не должны входить в состав групповой упаковки.'");
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.ДатаПроизводства Тогда
		Результат = НСтр("ru = 'Изменение даты производства доступно для единиц товара и комплектов в статусах"
		+ " «Нанесен» и «В обороте».'");
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.СрокГодности Тогда
		Результат = НСтр("ru = 'Изменение срока годности доступно только для единиц товара в статусах"
		+ " «Нанесен» и «В обороте».'");
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.ВариативныйСрокГодности Тогда
		Результат = НСтр("ru = 'Изменение вариативного срока годности доступно только для единиц товара в статусах"
		+ " «Нанесен» и «В обороте».'");
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.КодТНВЭД Тогда
		Результат = НСтр("ru = 'Изменение кода ТН ВЭД доступно только для единиц товара в статусе «В обороте»"
		+ " с любым типом эмиссии, кроме «Ввезен в РФ». Коды не должны входить в состав групповой упаковки.'");
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.ФактическийВес Тогда
		Результат = НСтр("ru = 'Изменение фактического веса доступно только для единиц товара в статусах"
		+ " «Нанесен» и «В обороте».'");
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.РазрешительныйДокумент Тогда
		Результат = НСтр("ru = 'Изменение данных о разрешительных документах доступно"
		+ " для единиц товара и комплектов в статусах «Нанесен» и «В обороте».'");
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.ЛицензияНаНедра Тогда
		Результат = НСтр("ru = 'Изменение данных о лицензии на пользование недрами доступно только"
		+ " для единиц товара в статусах «Нанесен» и «В обороте».'");
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.СпособВыпускаТоваров Тогда
		Результат = НСтр("ru = 'Изменение способа выпуска товаров доступно только для единиц товара в статусах"
		+ " «Эмитирован» или «Нанесен» с ранее указанным способом выпуска «Импорт в РФ» или «Производство в РФ»."
		+ " Коды не должны входить в состав комплектов, наборов, групповых и транспортных упаковок.'");
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.НомерПартии Тогда
		Результат = НСтр("ru = 'Изменение номера партии доступно только для единиц товара.'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПодсказкаПартионныйУчет()
	
	Результат = "";
	ТипыОпераций = МодульКлиента().Перечисление_ТипыОпераций();
	
	Если МодульКлиента().ЭтоОтчетОНанесении(ТипОперации)
		И МодульКлиента().НастройкиМодуля().ИспользоватьПартионныйУчет
		И МодульКлиента().ВидПродукцииПоддерживаетПартионныйУчет(ВидПродукции) Тогда
		Результат = НСтр("ru = 'Номер партии указывается в рамках эксперимента по партионному учету.'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПодсказкаАвтоподборПозицииНаТСД()
	
	ТипыОпераций = МодульКлиента().Перечисление_ТипыОпераций();
	ФичаФлаги = МодульКлиента().Перечисление_ФичаФлаги();
	
	Если ТипОперации <> ТипыОпераций.ПодборКодовНаТСД
		И ТипОперации <> ТипыОпераций.ОтчетОНанесенииНаТСД Тогда
		Возврат "";
	КонецЕсли;
	
	Если Не МодульКлиента().ФичаФлагВключен(ФичаФлаги.АвтоподборПозицииНаТСД) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат НСтр("ru = 'При сканировании на ТСД возможно наполнение документа с автоподбором позиции по GTIN.'");
	
КонецФункции

&НаКлиенте
Функция ПодсказкаУведомлениеОСостоянииКодов()
	
	Результат = "";
	ТипыОпераций = МодульКлиента().Перечисление_ТипыОпераций();
	СостоянияКодов = МодульКлиента().Перечисление_СостоянияКодов();
	СтатусыОпераций = МодульКлиента().Перечисление_СтатусыОпераций();
	
	Если ТипОперации = ТипыОпераций.УведомлениеОСостоянииКодов
		И ОсновнойСтатус = СтатусыОпераций.ОперацияЗавершена
		И СостояниеКодов = СостоянияКодов.ОтгрузкаНаЭкспорт Тогда
		Результат = 
		НСтр("ru = 'Подача сведений о выводе из оборота осуществляется в течение одного рабочего дня со дня помещения товара под таможенную процедуру.'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ОперацияПопадаетНаТСД()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	
	ПодходящиеОперации = Новый Массив;
	ПодходящиеОперации.Добавить(ТипыОпераций.ПодборКодовНаТСД);
	ПодходящиеОперации.Добавить(ТипыОпераций.ПодборТоваровИКодовНаТСД);
	ПодходящиеОперации.Добавить(ТипыОпераций.ОтчетОНанесенииНаТСД);
	ПодходящиеОперации.Добавить(ТипыОпераций.НаполнениеАгрегатовНаТСД);
	ПодходящиеОперации.Добавить(ТипыОпераций.НаполнениеНаборовНаТСД);
	
	Результат = (ПодходящиеОперации.Найти(ТипОперации) <> Неопределено);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УстановитьОформлениеТоварыКоличествоКодовВводВОборот();
	УстановитьОформлениеТоварыИдентификаторВСД();
	УстановитьОформлениеТоварыКоличество();
	УстановитьОформлениеТоварыВес();
	УстановитьОформлениеТоварыСуммаНДС();
