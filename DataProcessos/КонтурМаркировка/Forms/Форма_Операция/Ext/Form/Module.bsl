&НаКлиенте
Процедура ЗаказКодов_ВыполнитьЗаказ(Команда)
	
	Если Модифицированность Тогда
		СохранитьОперацию();
	КонецЕсли;
	
	МодульКлиента().ЗаказКодов_Отправить(Ссылка);
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПроизводстваОтчетОНанесенииПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(ДатаПроизводства) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыСрокаГодности = МодульКлиента().Перечисление_ТипыСроковГодности();
	
	Если ТипСрокаГодности <> ТипыСрокаГодности.СрокГодностиБольше72СУсловием Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'Пересчитать сроки годности товаров?'");
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("ПересчитатьАльтСрокиГодностиПоДатеПроизводстваВШапкеПослеСогласия", ЭтаФорма);
	МодульКлиента().ПоказатьДиалогВопроса(ОписаниеОбработчика, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьАльтСрокиГодностиПоДатеПроизводстваВШапкеПослеСогласия(Ответ, ДопПараметры = Неопределено) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПересчитатьАльтСрокиГодностиПоДатеПроизводстваВШапке();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыДатаПроизводстваОтчетОНанесенииПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ДатаПроизводства) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипСрокаГодности <> МодульКлиента().Перечисление_ТипыСроковГодности().СрокГодностиБольше72СУсловием Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'Пересчитать сроки годности товаров?'");
	Обработчик = МодульКлиента().ОписаниеОбработчикаОповещения("ПересчитатьАльтСрокиГодностиТовараПослеСогласия", ЭтаФорма);
	МодульКлиента().ПоказатьДиалогВопроса(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНомерДокументаСертификацииПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	
	ТекущиеДанные.НомерДокументаСертификации = СокрЛП(ТекущиеДанные.НомерДокументаСертификации);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьАльтСрокиГодностиТовараПослеСогласия(Ответ, ДопПараметры = Неопределено) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	ТекущаяСтрока = Элементы.Товары.ТекущаяСтрока;
	
	ПересчитатьАльтСрокиГодностиТовара(ТекущаяСтрока, ТекущиеДанные.ДатаПроизводства);
	
КонецПроцедуры

&НаКлиенте
Процедура ОплаченоПриИзменении(Элемент)
	
	УстановитьВидимостьПолей_ВозвратВОборот();
	
КонецПроцедуры

&НаКлиенте
Процедура СсылкаПодсказкиНажатие(Элемент)
	
	МодульКлиента().ОткрытьСправкуАвтоподбораПозицииНаТСД();
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеРеквизитов()
	
	ОчиститьСообщения();
	
	Возврат ПроверитьЗаполнениеРеквизитовНаСервере();
	
КонецФункции

&НаСервере
Функция ПроверитьЗаполнениеРеквизитовНаСервере()
	
	ОписаниеОперации = ОписаниеОперацииПоКонтекстуФормы();
	
	ОшибкиЗаполнения = МодульОбъекта().ПроверитьЗаполнениеОперации(ОписаниеОперации);
	
	МодульОбъекта().СообщитьОбОшибкахЗаполнения(ЭтаФорма, ОшибкиЗаполнения);
	
	Возврат Не ЗначениеЗаполнено(ОшибкиЗаполнения);
	
КонецФункции

&НаКлиенте
Функция ПроверитьКоличествоКодов()
	
	ЕстьОшибки = Ложь;
	
	Если КоличествоКодов = 0 Тогда
		МодульКлиента().СообщитьПользователюЛок(НСтр("ru = 'Необходимо заполнить операцию кодами.'"), УникальныйИдентификатор);
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Возврат Не ЕстьОшибки;
	
КонецФункции

&НаКлиенте
Функция ПроверитьОбязательныеРеквизитыУведомленияОПриемке(ЭтоЧастичнаяПриемка = Ложь)
	
	ТипыИсходныхОтгрузок = МодульКлиента().Перечисление_ТипыИсходныхОтгрузок();
	
	Если ТипИсходнойОтгрузки = ТипыИсходныхОтгрузок.ТрансграничнаяОтгрузкаОСУ Тогда
		Результат = ПроверитьОбязательныеРеквизитыУведомленияОПриемкеОСУ(ЭтоЧастичнаяПриемка);
	Иначе
		Результат = ПроверитьОбязательныеРеквизитыУведомленияОПриемкеПУ(ЭтоЧастичнаяПриемка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПроверитьОбязательныеРеквизитыУведомленияОПриемкеПУ(ЭтоЧастичнаяПриемка = Ложь, СтрокиДерева = Неопределено)
	
	Если СтрокиДерева = Неопределено Тогда
		СтрокиДерева = СведенияОТоварах.ПолучитьЭлементы();
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	
	Для Каждого Стр Из СтрокиДерева Цикл
		
		Если Не ЗначениеЗаполнено(Стр.Товар) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтатусТовараНаСверкеТребуетУказатьЦенуКодТНВЭД(Стр, ЭтоЧастичнаяПриемка) Тогда
			Если Не ЗначениеЗаполнено(Стр.КодТНВЭД) Тогда
				ШаблонОшибки = НСтр("ru = 'Необходимо указать код ТНВЭД для товара: %1'");
				ТекстОшибки = МодульКлиента().ПараметрыВСтроку(ШаблонОшибки, Стр.Товар);
				МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "СведенияОТоварах");
				ЕстьОшибки = Истина;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Стр.Цена) Тогда
				ШаблонОшибки = НСтр("ru = 'Необходимо указать цену для товара: %1'");
				ТекстОшибки = МодульКлиента().ПараметрыВСтроку(ШаблонОшибки, Стр.Товар);
				МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "СведенияОТоварах");
				ЕстьОшибки = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ПроверитьОбязательныеРеквизитыУведомленияОПриемкеПУ(ЭтоЧастичнаяПриемка, Стр.ПолучитьЭлементы()) Тогда
			ЕстьОшибки = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Не ЕстьОшибки;
	
КонецФункции

&НаКлиенте
Функция ПроверитьОбязательныеРеквизитыУведомленияОПриемкеОСУ(ЭтоЧастичнаяПриемка = Ложь)
	
	СтатусыТовараНаСверке = МодульКлиента().Перечисление_СтатусыТовараНаСверке();
	
	ЕстьОшибки = Ложь;
	
	Для Каждого Стр Из СведенияОТоварах.ПолучитьЭлементы() Цикл
		
		Если Не ЗначениеЗаполнено(Стр.КодТНВЭД) Тогда
			ШаблонОшибки = НСтр("ru = 'Необходимо указать код ТНВЭД для товара: %1'");
			ТекстОшибки = МодульКлиента().ПараметрыВСтроку(ШаблонОшибки, Стр.Товар);
			МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор);
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.Цена) Тогда
			ШаблонОшибки = НСтр("ru = 'Необходимо указать цену для товара: %1'");
			ТекстОшибки = МодульКлиента().ПараметрыВСтроку(ШаблонОшибки, Стр.Товар);
			МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор);
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если Стр.ПеременныйВес И Не ЗначениеЗаполнено(Стр.Количество) Тогда
			ШаблонОшибки = НСтр("ru = 'Необходимо указать вес для товара: %1'");
			ТекстОшибки = МодульКлиента().ПараметрыВСтроку(ШаблонОшибки, Стр.Товар);
			МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор);
			ЕстьОшибки = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Не ЕстьОшибки;
	
КонецФункции

&НаСервере
Функция ПроверитьКоличествоКодовВиртуальныхАгрегатов(СтрокиАгрегатов)
	
	ДопустимоеКоличествоКодов = МодульОбъекта().ДопустимоеКоличествоКодовВКИТУ();
	
	Для Каждого Стр Из СтрокиАгрегатов Цикл
		
		ВложенныеСтроки = Стр.ПолучитьЭлементы();
		Если Не ЗначениеЗаполнено(ВложенныеСтроки) Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоКодовВАгрегате = 0;
		Для каждого СтрВлож Из ВложенныеСтроки Цикл
			КоличествоКодовВАгрегате = КоличествоКодовВАгрегате + СтрВлож.КоличествоКодов;
		КонецЦикла;
		
		Если КоличествоКодовВАгрегате > ДопустимоеКоличествоКодов Тогда
			ТекстСообщения = НСтр("ru = 'В одном агрегате не может быть больше %1 кодов'");
			ТекстСообщения = МодульОбъекта().ПараметрыВСтроку(ТекстСообщения, ДопустимоеКоличествоКодов);
			МодульОбъекта().СообщитьПользователюЛок(ТекстСообщения, УникальныйИдентификатор);
			Возврат Ложь;
		КонецЕсли;
		
		Если Не ПроверитьКоличествоКодовВиртуальныхАгрегатов(ВложенныеСтроки) Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ПроверитьДоступностьОперацииПоТарифу()
	
	Результат = Истина;
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОписаниеТарифа = МодульОбъекта().Тариф(Организация);
	
	Если ТипОперации = МодульОбъекта().Перечисление_ТипыОпераций().ЗаказКодов Тогда
		Результат = Не ЕстьОграничениеЗаказаКодов(ОписаниеТарифа);
	ИначеЕсли ТипОперации = МодульОбъекта().Перечисление_ТипыОпераций().ОтчетОНанесении Тогда
		Результат = Не ЕстьОграничениеОтчетаОНанесении(ОписаниеТарифа);
	Иначе
		Результат = МодульОбъекта().ОперацияДоступнаПоТарифу(ТипОперации, ОписаниеТарифа);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СпособВводаВОборотНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ЗначенияСписка = МодульКлиента().ДопустимыеСпособыВводаВОборот(ВидПродукции);
	МодульКлиента().ЗаполнитьСписокВыбора(Элемент.СписокВыбора, ЗначенияСписка);
	
КонецПроцедуры

&НаКлиенте
Процедура СпособВводаВОборотПриИзменении(Элемент)
	
	СпособВводаВОборотПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СпособВводаВОборотПриИзмененииНаСервере()
	
	ПерезаполнитьТаблицыОперации();
	УстановитьВидимостьПолей_ВводВОборот();
	
КонецПроцедуры

&НаКлиенте
Процедура Операция_Выполнить(Команда)
	
	Если Не МодульКлиента().ПроверитьУстановленнуюВерсиюМодуля() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьДоступностьОперацииПоТарифу() Тогда
		МодульКлиента().ОткрытьФормуОграниченияПоТарифу(ЭтаФорма, Организация, ТипОперации);
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполнениеРеквизитов() Тогда
		Возврат;
	КонецЕсли;
	
	ТипыОпераций = МодульКлиента().Перечисление_ТипыОпераций();
	СтатусыОпераций = МодульКлиента().Перечисление_СтатусыОпераций();
	
	Если ТипОперации = ТипыОпераций.АгрегацияКодов Тогда
		
		Если ОсновнойСтатус <> СтатусыОпераций.СозданыАгрегаты Тогда
			Если Не СоздатьАгрегаты() Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		ЗавершитьОперацию();
		
	ИначеЕсли ТипОперации = ТипыОпераций.ПечатьКодов Тогда
		
		ТекстВопроса = НСтр("ru = 'Операция печати будет удалена, напечатать этикетки повторно будет невозможно, продолжить?'");
		ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("УдалитьОперациюПечати_ПослеСогласия", ЭтаФорма);
		МодульКлиента().ПоказатьДиалогВопроса(ОписаниеОбработчика, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
		
	ИначеЕсли ТипОперации = ТипыОпераций.НаполнениеКИГУ Тогда
		
		Если ОсновнойСтатус <> СтатусыОпераций.КИГУНаполнены Тогда
			НаполнитьКИГу();
		КонецЕсли;
		
		ЗавершитьОперацию();
		
	Иначе
		
		СохранитьИСоздатьЗадачу();
		
		МодульКлиента().ВыполнитьОбменПоОрганизации(ЭтаФорма, Организация, ДокументУчета);
		
		ЗаполнитьКонтекстФормыИУстановитьВидимость();
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		Оповестить("КонтурМаркировка_КодыВДокументах_Изменен", ДокументУчета);
	КонецЕсли;
	
	Оповестить("КонтурМаркировка_Операция_Изменен", ДокументУчета);
	
	Если ОсновнойСтатус <> СтатусыОпераций.Новый
		И ОсновнойСтатус <> СтатусыОпераций.ОшибкаОбработки Тогда
		ПровестиОпросПользователяИЗакрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОперациюПечати_ПослеСогласия(Ответ, ДопПараметры = Неопределено) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Ложь;
	
	УдалитьОперациюНаСервере();
	
	Оповестить("КонтурМаркировка_Операция_Изменен", ДокументУчета);
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		Оповестить("КонтурМаркировка_КодыВДокументах_Изменен", ДокументУчета);
	КонецЕсли;
	
	ПровестиОпросПользователяИЗакрыть();
	
КонецПроцедуры

&НаСервере
Функция СформироватьВсеЭтикетки(ДоступнаПечатьШтрихкодовНаКлиенте)
	
	Этикетки.Очистить();
	
	Если Модифицированность Тогда
		СохранитьОперацию();
	КонецЕсли;
	
	ПараметрыПечати = МодульОбъекта().Этикетки_ПараметрыПечатиЭтикетокПоОперации(Ссылка);
	ПараметрыПечати.ЗаполнитьКартинкиШтрихкодовНаСервере = Не ДоступнаПечатьШтрихкодовНаКлиенте;
	ПараметрыПечати.ИспользоватьКодыОперации = Истина;
	ПараметрыПечати.ПечататьВложенныеКоды = Истина;
	ПараметрыПечати.ТабличныйДокумент = Этикетки;
	
	МодульОбъекта().Этикетки_СформироватьТаблицуЭтикеток(ПараметрыПечати);
	МодульОбъекта().Операция_ПечатьКодов_СформироватьЭтикетки(Ссылка, ПараметрыПечати);
	
	ЗаполнитьРазмерЭтикетки(); // Если шаблоны этикеток заполнили в ПМ
	
	ПараметрыКартинок = Неопределено;
	Если Не ПараметрыПечати.ЗаполнитьКартинкиШтрихкодовНаСервере Тогда
		ПараметрыКартинок = МодульОбъекта().Этикетки_ПараметрыЗаполненияКартинокШтрихкодовНаКлиенте(ПараметрыПечати);
	КонецЕсли;
	
	Возврат ПараметрыКартинок;
	
КонецФункции

&НаСервере
Функция СформироватьПорциюЭтикеток(АдресПараметровПечати, НомерПорции)
	
	Этикетки.Очистить();
	
	ПараметрыПечати = ПолучитьИзВременногоХранилища(АдресПараметровПечати);
	ТаблицаЭтикеток = ПолучитьИзВременногоХранилища(ПараметрыПечати.ТаблицаЭтикеток);
	
	ПараметрыПечатиПорции = МодульОбъекта().Новый_ПараметрыПечатиЭтикеток();
	ПараметрыПечатиПорции.ТабличныйДокумент = Этикетки;
	ЗаполнитьЗначенияСвойств(ПараметрыПечатиПорции, ПараметрыПечати, , "ТаблицаЭтикеток, ТабличныйДокумент");
	ЗаполнитьВПорцииТаблицуЭтикеток(ПараметрыПечатиПорции, НомерПорции, ТаблицаЭтикеток);
	
	Если Не ЗначениеЗаполнено(ПараметрыПечатиПорции.ТаблицаЭтикеток) Тогда
		УдалитьИзВременногоХранилища(АдресПараметровПечати);
		УдалитьИзВременногоХранилища(ПараметрыПечати.ТаблицаЭтикеток);
		Возврат Неопределено;
	КонецЕсли;
	
	МодульОбъекта().Операция_ПечатьКодов_СформироватьЭтикетки(Ссылка, ПараметрыПечатиПорции);
	
	ЗаполнитьЗначенияСвойств(ПараметрыПечати, ПараметрыПечатиПорции, , "ТаблицаЭтикеток, ТабличныйДокумент");
	ПоместитьВоВременноеХранилище(ПараметрыПечати, АдресПараметровПечати);
	
	ЗаполнитьРазмерЭтикетки(); // Если шаблоны этикеток заполнили в ПМ
	
	ПараметрыКартинок = Неопределено;
	Если Не ПараметрыПечати.ЗаполнитьКартинкиШтрихкодовНаСервере Тогда
		ПараметрыКартинок = МодульОбъекта().Этикетки_ПараметрыЗаполненияКартинокШтрихкодовНаКлиенте(ПараметрыПечатиПорции);
	КонецЕсли;
	
	Возврат ПараметрыКартинок;
	
КонецФункции

&НаСервере
Функция СформироватьПервуюПорциюЭтикеток(АдресПараметровПечати)
	
	НомерПорции = 1;
	
	Этикетки.Очистить();
	
	ПараметрыПечати = ПолучитьИзВременногоХранилища(АдресПараметровПечати);
	ТаблицаЭтикеток = ПолучитьИзВременногоХранилища(ПараметрыПечати.ТаблицаЭтикеток);
	
	УдалитьИзВременногоХранилища(АдресПараметровПечати);
	УдалитьИзВременногоХранилища(ПараметрыПечати.ТаблицаЭтикеток);
	
	ПараметрыПечати.ТабличныйДокумент = Этикетки;
	ПараметрыПечати.ТаблицаЭтикеток = ТаблицаЭтикеток;
	
	МодульОбъекта().Операция_ПечатьКодов_СформироватьЭтикетки(Ссылка, ПараметрыПечати);
	
	ЗаполнитьРазмерЭтикетки(); // Если шаблоны этикеток заполнили в ПМ
	
	ПараметрыКартинок = Неопределено;
	Если Не ПараметрыПечати.ЗаполнитьКартинкиШтрихкодовНаСервере Тогда
		ПараметрыКартинок = МодульОбъекта().Этикетки_ПараметрыЗаполненияКартинокШтрихкодовНаКлиенте(ПараметрыПечати);
	КонецЕсли;
	
	Возврат ПараметрыКартинок;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьВПорцииТаблицуЭтикеток(ПараметрыПечатиПорции, НомерПорции, ОбщаяТаблицаЭтикеток)
	
	РазмерПорции = ПараметрыПечатиПорции.РазмерПорции;
	НомерПоследЭтикетки = ПараметрыПечатиПорции.НомерПоследнейНапечатаннойЭтикетки;
	ВсегоЭтикеток = ОбщаяТаблицаЭтикеток.Количество();
	
	ИндексПоследЭтикетки = -1;
	Если ЗначениеЗаполнено(НомерПоследЭтикетки) Тогда
		ИндексПоследЭтикетки = ОбщаяТаблицаЭтикеток.Индекс(ОбщаяТаблицаЭтикеток.Найти(НомерПоследЭтикетки, "НомерЭтикеткиПоПорядку"));
	КонецЕсли;
	
	ВыбраноЭтикеток = 0;
	Для Сч = ИндексПоследЭтикетки + 1 По ВсегоЭтикеток - 1 Цикл
		
		Стр = ОбщаяТаблицаЭтикеток[Сч];
		
		ЗаполнитьЗначенияСвойств(ПараметрыПечатиПорции.ТаблицаЭтикеток.Добавить(), Стр);
		
		ПараметрыПечатиПорции.НомерПоследнейНапечатаннойЭтикетки = Стр.НомерЭтикеткиПоПорядку;
		
		ВыбраноЭтикеток = ВыбраноЭтикеток + 1;
		Если ВыбраноЭтикеток = РазмерПорции Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПараметрыПечатиЭтикетокПорциями(ДоступнаПечатьШтрихкодовНаКлиенте, ТолькоПервуюПорцию = Ложь)
	
	Если Модифицированность Тогда
		СохранитьОперацию();
	КонецЕсли;
	
	РазмерПорции = МодульОбъекта().НастройкиМодуля().КоличествоЭтикетокВОднойПорцииПоУмолчанию;
	
	ПараметрыПечати = МодульОбъекта().Этикетки_ПараметрыПечатиЭтикетокПоОперации(Ссылка);
	ПараметрыПечати.ЗаполнитьКартинкиШтрихкодовНаСервере = Не ДоступнаПечатьШтрихкодовНаКлиенте;
	ПараметрыПечати.РазмерПорции = РазмерПорции;
	ПараметрыПечати.ПечататьВложенныеКоды = Истина;
	ПараметрыПечати.ИспользоватьКодыОперации = Истина;
	
	Если ТолькоПервуюПорцию Тогда
		ПараметрыПечати.КоличествоЭтикеток = РазмерПорции;
	КонецЕсли;
	
	МодульОбъекта().Этикетки_СформироватьТаблицуЭтикеток(ПараметрыПечати);
	КоличествоЭтикеток = ПараметрыПечати.ТаблицаЭтикеток.Количество();
	
	ПараметрыПечати.ТаблицаЭтикеток = ПоместитьВоВременноеХранилище(ПараметрыПечати.ТаблицаЭтикеток, УникальныйИдентификатор);
	
	Результат = Новый Структура;
	Результат.Вставить("РазмерПорции", РазмерПорции);
	Результат.Вставить("КоличествоЭтикеток", КоличествоЭтикеток);
	Результат.Вставить("АдресПараметровПечати", ПоместитьВоВременноеХранилище(ПараметрыПечати, УникальныйИдентификатор));
	
	Возврат Результат;
	
КонецФункции

