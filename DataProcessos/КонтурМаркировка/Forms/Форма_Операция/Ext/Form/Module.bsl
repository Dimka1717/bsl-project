	, ТекстПодсказки, ВариантОтображенияПодсказки);
	
КонецПроцедуры

&НаСервере
Процедура ЭтаФормаУстановитьТолькоПросмотр(Значение)
	
	ЭтаФорма.ТолькоПросмотр = Значение;
	Элементы.ЗаказКодовДляСервисПровайдера.ТолькоПросмотр = Значение;
	Элементы.КодАгрегата.ТолькоПросмотр = Значение;
	Элементы.ЗакладкаОсновная.ТолькоПросмотр = Значение;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьСписокКодыМаркировки()
	
	СтатусыОпераций = МодульОбъекта().Перечисление_СтатусыОпераций();
	ТипыСтатусов = МодульОбъекта().Перечисление_ТипыСтатусов();
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	
	ПустаяОперация = Справочники.КонтурМаркировка_Операции.ПустаяСсылка();
	ПустойИдентификатор = МодульОбъекта().ПустойУникальныйИдентификатор();
	
	КодыМаркировки.ТекстЗапроса = ТекстЗапросаКодыМаркировки();
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("ПустойИдентификатор", ПустойИдентификатор);
	
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("Операция", Ссылка);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("ПустаяДата", '00010101');
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("ПустаяОперация", ПустаяОперация);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("ТипСтатуса_ОсновнойСтатус", ТипыСтатусов.ОсновнойСтатус);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("СтатусОперации_Новый", СтатусыОпераций.Новый);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("СтатусОперации_ОперацияЗавершена", СтатусыОпераций.ОперацияЗавершена);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("СтатусОперации_ПринятЧастично", СтатусыОпераций.ПринятЧастично);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("СтатусОперации_ОшибкаОбработки", СтатусыОпераций.ОшибкаОбработки);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("СтатусОперации_НеУдалосьРаспознатьКоды", СтатусыОпераций.НеУдалосьРаспознатьКоды);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("СтатусОперации_ОбнаруженоДублированиеВАгрегатах", СтатусыОпераций.ОбнаруженоДублированиеВАгрегатах);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиВыбора()
	
	ЗаполнитьСпискиВыбораЗаказаКодов();
	ЗаполнитьСпискиВыбораОтчетаОНанесении();
	ЗаполнитьСпискиВыбораВводаВОборот();
	ЗаполнитьСпискиВыбораВыводаИзОборота();
	ЗаполнитьСпискиВыбораСообщенияОбОтгрузке();
	ЗаполнитьСпискиВыбораВозвратаВОборот();
	ЗаполнитьСпискиВыбораПараметрыПечати();
	ЗаполнитьСпискиВыбораФорматКодов();
	ЗаполнитьСпискиВыбораФормированияАТК();
	ЗаполнитьСпискиВыбораПеремаркировка();
	ЗаполнитьСпискиВыбораКорректировкиСведенийОКодах();
	ЗаполнитьСпискиВыбораУведомлениеОСостоянииКодов();
	ЗаполнитьСпискиВыбораПодборКодовНаТСД();
	
	ЗаполнитьПустыеСпискиВыбораТекущимиЗначениями();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПустыеСпискиВыбораТекущимиЗначениями()
	
	СвойствоРежимВыбораИзСписка = Новый Структура("РежимВыбораИзСписка");
	
	Для Каждого Элемент Из Элементы Цикл
		
		СвойствоРежимВыбораИзСписка.РежимВыбораИзСписка = Неопределено;
		ЗаполнитьЗначенияСвойств(СвойствоРежимВыбораИзСписка, Элемент);
		
		Если СвойствоРежимВыбораИзСписка.РежимВыбораИзСписка <> Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Элемент.СписокВыбора) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Найти(Элемент.ПутьКДанным, ".") > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Значение = ЭтаФорма[Элемент.ПутьКДанным];
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		МодульОбъекта().ЗаполнитьСписокВыбора(Элемент.СписокВыбора, Значение);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиВыбораПараметрыПечати()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	Если ТипОперации <> ТипыОпераций.ПечатьКодов Тогда
		Возврат;
	КонецЕсли;
	
	МассивТоваров = Новый Массив;
	МассивНоменклатуры = Новый Массив;
	
	Если ЗначениеЗаполнено(ОперацияОснование) Тогда
		
		Для Каждого СтрокаТовары Из ОперацияОснование.Товары Цикл
			МассивТоваров.Добавить(СтрокаТовары.Товар);
			МассивНоменклатуры.Добавить(СтрокаТовары.КлючНоменклатуры1С);
		КонецЦикла;
		
	ИначеЕсли ЗначениеЗаполнено(ДокументУчета) Тогда
		
		Для Каждого СтрокаТовары Из ДокументУчета.ТоварыМаркировки Цикл
			МассивТоваров.Добавить(СтрокаТовары.Товар);
		КонецЦикла;
		
		Для Каждого СтрокаТоварыДокумента Из ДокументУчета.ТоварыДокумента Цикл
			МассивНоменклатуры.Добавить(СтрокаТоварыДокумента.КлючНоменклатуры1С);
		КонецЦикла;
		
	Иначе
		Возврат;
	КонецЕсли;
	
	СписокВыбораТовар = Элементы.Товар.СписокВыбора;
	МодульОбъекта().ЗаполнитьСписокВыбора(СписокВыбораТовар, МассивТоваров);
	
	СписокВыбораНоменклатура = Элементы.КлючНоменклатуры1С.СписокВыбора;
	МодульОбъекта().ЗаполнитьСписокВыбора(СписокВыбораНоменклатура, МассивНоменклатуры);
	
КонецПроцедуры

